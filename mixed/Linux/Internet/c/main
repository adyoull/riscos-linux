static int socket_server = -1;
static bool stats_ticking, stats_pending;

typedef union {
  volatile uint32_t word;
  struct {
    volatile char data, timeout;
  } s;
} pollword_t;

static struct socket {
  pollword_t pollword[4];
  bool async;
  bool nonblocking;
  bool sleeptw;
  int sndbuf, rcvbuf;   // sizes a program set on a TCP socket (see buffer_option)
  // a raw ICMP socket (SOCK_RAW, IPPROTO_ICMP): see "ICMP" below
  bool icmp, icmp_bound;
  uint16_t icmp_id_prog, icmp_id_kern;  // ident as the program sends it, as Linux does
  uint32_t icmp_bind_addr;
  unsigned icmp_cursor;                 // next packet in icmp_ring for this socket
} sockets[512];

#define NSOCKETS ((int)(sizeof(sockets) / sizeof(sockets[0])))

// SO_SNDBUF and SO_RCVBUF on a TCP socket are kept here, not given to
// Linux. RISC OS programs commonly set them (16 or 32 KB suits RISC OS's
// own stack), and a size set on a Linux socket turns off its automatic
// sizing for good: with 32 KB a download ran at 14 Mbit/s instead of
// 85-160 (Iris, 11 Mbit/s over Ethernet; measured on a Pi 4). Linux sizes
// TCP buffers to the connection by itself. Getsockopt gives back the size
// that was set; UDP sockets pass both straight on.
static int *buffer_option(int fd, int level, int optname) {
  if (fd < 0 || fd >= (int)(sizeof(sockets) / sizeof(sockets[0])) || level != SOL_SOCKET
      || (optname != SO_SNDBUF && optname != SO_RCVBUF))
    return NULL;
  int type = 0;
  ix_socklen_t len = sizeof(type);
  if (ix_getsockopt(fd, ix_SOL_SOCKET, ix_SO_TYPE, &type, &len) < 0 || type != SOCK_STREAM)
    return NULL;
  return optname == SO_SNDBUF ? &sockets[fd].sndbuf : &sockets[fd].rcvbuf;
}

static void eprintf(const char *fmt, ...) {
  static char s[1000];
  va_list ap;

  va_start(ap, fmt);
  int c = vsprintf(s, fmt, ap);
  va_end(ap);

  ix_write(2, s, c);
}

struct ix_sockaddr_in {
  uint16_t sin_family;
  uint16_t sin_port;
  struct in_addr sin_addr;
  char sin_zero[8];
};

typedef unsigned (__kuser_cmpxchg_t)(unsigned oldval, unsigned newval, volatile unsigned *ptr);
#define __kuser_cmpxchg (*(__kuser_cmpxchg_t *)0xffff0fc0)

static void pollword_sleep(bool tw, const pollword_t *pollword);

// ICMP. RISC OS programs (Ping, from FreeBSD) use raw ICMP sockets, which
// on Linux need privileges RISC OS doesn't have. Linux's unprivileged
// "ping sockets" (SOCK_DGRAM, IPPROTO_ICMP; allowed for the groups in
// net.ipv4.ping_group_range, which init sets) send echo requests and get
// the replies back, so each raw ICMP socket is one of those, made to
// behave as a raw socket:
//  - Linux gives a reply only to the socket that sent the request, while
//    on a raw socket every ICMP socket sees every packet (Ping sends on
//    one socket and reads on another). So the replies from all of them
//    are gathered here (icmp_ring), and each socket reads every packet
//    that came after it was made.
//  - Linux gives the ICMP message alone; a raw socket gives the IP header
//    too: one is made up (with the real TTL, IP_RECVTTL, and the sender).
//  - Linux puts its own ident in the request (the socket's "port"): the
//    socket is bound to the program's ident when it first sends, and if
//    that is taken the replies get the program's ident back.
// Only echo requests can be sent (Linux's rule); anything else that isn't
// TCP or UDP is still refused.
#define ICMP_SLOTS 32
#define ICMP_KEEP 1480
static struct icmp_packet {
  unsigned seq;              // 0: empty
  int len;                   // the ICMP message's whole length
  uint32_t src;
  uint8_t ttl;
  uint8_t data[ICMP_KEEP];   // (at most this much of it)
} icmp_ring[ICMP_SLOTS];
static unsigned icmp_seq = 1;

static bool is_icmp(int fd) {
  return fd >= 0 && fd < NSOCKETS && sockets[fd].icmp;
}

// The ident in an ICMP message changed, its checksum kept right (RFC 1624)
static void icmp_set_id(uint8_t *d, int n, uint16_t from, uint16_t to) {
  uint16_t id, hc;
  if (n < 8) return;
  memcpy(&id, d + 4, 2);
  if (id != from) return;
  memcpy(d + 4, &to, 2);
  memcpy(&hc, d + 2, 2);
  uint32_t sum = (uint16_t)~hc + (uint16_t)~from + (uint32_t)to;
  sum = (sum & 0xFFFF) + (sum >> 16);
  sum = (sum & 0xFFFF) + (sum >> 16);
  hc = (uint16_t)~sum;
  memcpy(d + 2, &hc, 2);
}

// Everything Linux has for any of the ICMP sockets, into icmp_ring
static void icmp_drain(void) {
  for (int fd = 0; fd < NSOCKETS; ++fd) {
    if (!sockets[fd].icmp) continue;
    for (int k = 0; k < ICMP_SLOTS; ++k) {
      struct icmp_packet *p = &icmp_ring[icmp_seq % ICMP_SLOTS];
      struct ix_sockaddr_in from;
      uint32_t cm[16];
      struct ix_iovec iov = {p->data, ICMP_KEEP};
      struct ix_msghdr m = {
        .msg_name = &from, .msg_namelen = sizeof(from),
        .msg_iov = &iov, .msg_iovlen = 1,
        .msg_control = cm, .msg_controllen = sizeof(cm)
      };
      memset(&from, 0, sizeof(from));
      int n = ix_recvmsg(fd, &m, ix_MSG_DONTWAIT | ix_MSG_TRUNC);
      if (n < 0) break;
      p->seq = icmp_seq++;
      if (!icmp_seq) icmp_seq = 1;
      p->len = n;
      p->src = from.sin_addr.s_addr;
      p->ttl = 64;
      // control messages: (length, level, type, data), 4-byte aligned
      for (unsigned off = 0; off + 12 <= m.msg_controllen;) {
        uint32_t *c = (uint32_t *)((char *)cm + off);
        if (c[0] < 12) break;
        if (c[1] == 0 /* IPPROTO_IP */ && c[2] == 2 /* IP_TTL */ && c[0] >= 16)
          p->ttl = (uint8_t)c[3];
        off += (c[0] + 3) & ~3u;
      }
      if (sockets[fd].icmp_id_kern != sockets[fd].icmp_id_prog)
        icmp_set_id(p->data, n < ICMP_KEEP ? n : ICMP_KEEP,
                    sockets[fd].icmp_id_kern, sockets[fd].icmp_id_prog);
    }
  }
}

// The oldest packet this socket hasn't read
static struct icmp_packet *icmp_next(int fd) {
  struct icmp_packet *best = NULL;
  for (int i = 0; i < ICMP_SLOTS; ++i) {
    struct icmp_packet *p = &icmp_ring[i];
    if (p->seq && (int)(p->seq - sockets[fd].icmp_cursor) >= 0
        && (!best || (int)(p->seq - best->seq) < 0))
      best = p;
  }
  return best;
}

static uint16_t ip_checksum(const uint8_t *d, int n) {
  uint32_t sum = 0;
  for (int i = 0; i + 1 < n; i += 2) sum += (d[i] << 8) | d[i + 1];
  if (n & 1) sum += d[n - 1] << 8;
  while (sum >> 16) sum = (sum & 0xFFFF) + (sum >> 16);
  return (uint16_t)~sum;
}

// Reading a raw ICMP socket: the next packet, with an IP header before it
static ssize_t icmp_recv(int fd, struct ix_msghdr *m, int flags) {
  pollword_t *pollword = &sockets[fd].pollword[__NR_recvmsg & 1];
  while (true) {
    pollword->s.data = 0;
    icmp_drain();
    struct icmp_packet *p = icmp_next(fd);
    if (p) {
      int kept = p->len < ICMP_KEEP ? p->len : ICMP_KEEP;
      int whole = 20 + p->len;
      uint8_t h[20] = {0x45, 0, (uint8_t)(whole >> 8), (uint8_t)whole, 0, 0, 0, 0,
                       p->ttl, 1 /* ICMP */, 0, 0};
      memcpy(h + 12, &p->src, 4);
      uint16_t sum = ip_checksum(h, 20);
      h[10] = (uint8_t)(sum >> 8); h[11] = (uint8_t)sum;
      // copied into the program's buffers: the header, then the message
      int done = 0;
      for (size_t i = 0; i < m->msg_iovlen; ++i) {
        uint8_t *b = m->msg_iov[i].iov_base;
        int room = (int)m->msg_iov[i].iov_len;
        while (room > 0 && done < 20 + kept) {
          int c;
          if (done < 20) {
            c = 20 - done; if (c > room) c = room;
            memcpy(b, h + done, c);
          } else {
            c = 20 + kept - done; if (c > room) c = room;
            memcpy(b, p->data + (done - 20), c);
          }
          b += c; room -= c; done += c;
        }
      }
      m->msg_flags = done < whole ? ix_MSG_TRUNC : 0;
      if (m->msg_name && m->msg_namelen >= sizeof(struct ix_sockaddr_in)) {
        struct ix_sockaddr_in a = {AF_INET, 0};
        a.sin_addr.s_addr = p->src;
        memcpy(m->msg_name, &a, sizeof(a));
        m->msg_namelen = sizeof(a);
      } else {
        m->msg_namelen = 0;
      }
      m->msg_controllen = 0;
      if (!(flags & ix_MSG_PEEK)) sockets[fd].icmp_cursor = p->seq + 1;
      if (icmp_next(fd)) pollword->s.data = 1;
      return done;
    }
    if (sockets[fd].nonblocking || (flags & ix_MSG_DONTWAIT)) return -ix_EAGAIN;
    pollword_sleep(sockets[fd].sleeptw, pollword);
  }
}

// Before an ICMP socket's first send: bound to the program's ident
static void icmp_prepare(int fd, const struct msghdr *m) {
  struct socket *s = &sockets[fd];
  if (m->msg_iovlen < 1 || m->msg_iov[0].iov_len < 8) return;
  uint16_t id;
  memcpy(&id, (const uint8_t *)m->msg_iov[0].iov_base + 4, 2);
  s->icmp_id_prog = id;
  if (s->icmp_bound) return;
  s->icmp_bound = true;
  struct ix_sockaddr_in a = {AF_INET, id};
  a.sin_addr.s_addr = s->icmp_bind_addr;
  if (ix_bind(fd, &a, sizeof(a)) < 0) {
    a.sin_port = 0;                    // (that ident is taken: Linux picks one)
    ix_bind(fd, &a, sizeof(a));
  }
  struct ix_sockaddr_in b;
  ix_socklen_t bl = sizeof(b);
  s->icmp_id_kern = ix_getsockname(fd, &b, &bl) == 0 ? b.sin_port : id;
}

static void pollword_sleep(bool tw, const pollword_t *pollword) {
  if (tw) {
    int r;
    _swix(OS_UpCall, _INR(0, 1) | _OUT(0), UpCall_Sleep, pollword, &r);
    if (!r) return;
  }
  _kernel_irqs_off();
  if (!pollword->word) __PVirt_WFI();
  _kernel_irqs_on();
}

static void socket_sleep(int fd, unsigned p) {
  pollword_sleep(sockets[fd].sleeptw, &sockets[fd].pollword[p]);
}

static int convert_sockopt(int level, int optname) {
  switch(level) {
    case IPPROTO_TCP:
      switch(optname) {
        case TCP_NODELAY: return ix_TCP_NODELAY;
        case TCP_MAXSEG:  return ix_TCP_MAXSEG;
        case TCP_NOPUSH:  return ix_TCP_CORK;
      }
      break;  // an option not listed is unhandled, not the SOL_SOCKET one with its number
    case SOL_SOCKET:
      switch(optname) {
    //  case SO_DEBUG:       return ix_SO_DEBUG;
        case SO_REUSEADDR:   return ix_SO_REUSEADDR;
        case SO_TYPE:        return ix_SO_TYPE;   // SOCK_STREAM etc. are the same numbers on Linux (GLib needs this)
        case SO_ERROR:       return ix_SO_ERROR;
        case SO_DONTROUTE:   return ix_SO_DONTROUTE;
        case SO_BROADCAST:   return ix_SO_BROADCAST;
        case SO_SNDBUF:      return ix_SO_SNDBUF;
        case SO_RCVBUF:      return ix_SO_RCVBUF;
        case SO_KEEPALIVE:   return ix_SO_KEEPALIVE;
        case SO_OOBINLINE:   return ix_SO_OOBINLINE;
        case SO_LINGER:      return ix_SO_LINGER;
        case SO_REUSEPORT:   return ix_SO_REUSEPORT;
        case SO_RCVLOWAT:    return ix_SO_RCVLOWAT;
        case SO_SNDLOWAT:    return ix_SO_SNDLOWAT;
    //  case SO_RCVTIMEO:    return ix_SO_RCVTIMEO;
    //  case SO_SNDTIMEO:    return ix_SO_SNDTIMEO;
      }
  }
  eprintf("Unhandled Internet Socket Option: level 0x%X option 0x%X\n", level, optname);
  return -ix_ENOPROTOOPT;
}

static int convert_msg_flags(int ro) {
  int l = 0;
  if (ro & MSG_OOB       ) l |= ix_MSG_OOB       ;
  if (ro & MSG_PEEK      ) l |= ix_MSG_PEEK      ;
  if (ro & MSG_DONTROUTE ) l |= ix_MSG_DONTROUTE ;
  if (ro & MSG_EOR       ) l |= ix_MSG_EOR       ;
  if (ro & MSG_TRUNC     ) l |= ix_MSG_TRUNC     ;
  if (ro & MSG_CTRUNC    ) l |= ix_MSG_CTRUNC    ;
  if (ro & MSG_WAITALL   ) l |= ix_MSG_WAITALL   ;
  if (ro & MSG_DONTWAIT  ) l |= ix_MSG_DONTWAIT  ;
  if (ro & MSG_EOF       ) eprintf("Not handling MSG_EOF\n");
  if (ro & MSG_COMPAT    ) eprintf("Not handling MSG_COMPAT\n");
  return l;
}

// A Linux sockaddr (16-bit family) made a RISC OS one (length, family)
static void sockaddr2riscos(void *sa) {
  uint8_t *b = sa;
  uint16_t family;
  memcpy(&family, b, 2);
  b[0] = 16;
  b[1] = (uint8_t)family;
}

static inline void addr2riscos(void *a, unsigned len) {
  struct sockaddr_in *ar = a;
  if (ar) {
    ar->sin_family = ar->sin_len;
    ar->sin_len = len;
  }
}

#define GET_ADDRESS_1(ADDR, LEN, CALL) {    \
  struct sockaddr_in *addr = (void*)(ADDR); \
  ix_socklen_t *len = (ix_socklen_t *)(LEN);\
  result = (CALL);                          \
  if (result >= 0) addr2riscos(addr, *len); \
}

static ssize_t do_msg(int fd, struct ix_msghdr *m, int flags, int syscall) {
  pollword_t *pollword = &sockets[fd].pollword[syscall & 1];
  while(true) {
    pollword->s.data = 0;
    int result;
    __asm {
        MOV     R0, fd
        MOV     R1, m
        MOV     R2, flags | ix_MSG_DONTWAIT
        MOV     R7, syscall
        ix_SYSCALL(R7, R0, R1, R2)
        MOV     result, R0
    }
    if (result != -ix_EAGAIN) {
      char c;
      // Still readable if more data is waiting, and also at end of file
      // (the other end closed: recv gives 0) or on an error: select must
      // report those too, or a program waiting for the close never sees
      // it (ClawsMail's HTTP fetches waited out their 60 s timeout).
      if (syscall == __NR_sendmsg || ix_recv(fd, &c, 1, ix_MSG_DONTWAIT | ix_MSG_PEEK) != -ix_EAGAIN)
        pollword->s.data = 1;
      return result;
    }
    if (sockets[fd].nonblocking || (flags & ix_MSG_DONTWAIT)) return result;
    pollword_sleep(sockets[fd].sleeptw, pollword);
  }
}

static inline ssize_t do_recvmsg(int fd, struct ix_msghdr *m, int flags) {
  if (is_icmp(fd)) return icmp_recv(fd, m, flags);
  return do_msg(fd, m, flags, __NR_recvmsg);
}

#define SET_ADDRESS(ADDR, CALL) {                                                       \
  const struct sockaddr_in *addr_ro = (const struct sockaddr_in *)(ADDR);               \
  if (addr_ro->sin_family == AF_INET || addr_ro->sin_len == AF_INET) {                  \
    struct ix_sockaddr_in addr_linux = {AF_INET, addr_ro->sin_port, addr_ro->sin_addr}; \
    result = (CALL);                                                                    \
  } else {                                                                              \
    result = -ix_EAFNOSUPPORT;                                                          \
  }                                                                                     \
}

static ssize_t do_sendmsg(int fd, const struct msghdr *m, int flags) {
  struct ix_msghdr msg = {
    .msg_iov = m->msg_iov,
    .msg_iovlen = m->msg_iovlen
  };
  struct ix_sockaddr_in al;
  if (m->msg_name) {
    struct sockaddr_in *ar = (void *)m->msg_name;
    if (ar->sin_family != AF_INET && ar->sin_len != AF_INET)
      return -ix_EAFNOSUPPORT;
    al.sin_family = AF_INET;
    al.sin_port = ar->sin_port;
    al.sin_addr = ar->sin_addr;
    msg.msg_name = &al;
    msg.msg_namelen = sizeof(al);
  }
  // FIXME: Control message data

  if (is_icmp(fd)) icmp_prepare(fd, m);
  return do_msg(fd, &msg, flags, __NR_sendmsg);
}

static inline ssize_t do_sendto(int fd, const void *buf, size_t len, int flags, void *addr_ro) {
  struct iovec iov = {(void *)buf, len};
  struct msghdr msg = {
    .msg_name = addr_ro,
    .msg_iov = &iov,
    .msg_iovlen = 1
  };
  return do_sendmsg(fd, &msg, flags);
}

static int do_accept(int fd, void *addr, ix_socklen_t *addrlen, void *pw) {
  int result;
  while (true) {
    eprintf(" Accepting...\n");
    result = ix_accept4(fd, addr, addrlen, ix_SOCK_NONBLOCK | ix_SOCK_CLOEXEC);
    if (result != -ix_EAGAIN || sockets[fd].nonblocking)
      break;
    socket_sleep(result, __NR_recvmsg & 1);
  }

  sockets[fd].pollword[__NR_recvmsg & 1].s.data = 0;
  struct ix_pollfd pollfd = {fd, ix_POLLIN, 0};
  ix_poll(&pollfd, 1, 0);
  if (pollfd.revents & ix_POLLIN)
    sockets[fd].pollword[__NR_recvmsg & 1].s.data = 1;

  if (result >= 0) {
    memset(&sockets[result], 0, sizeof(sockets[result]));
    _swix(OS_ClaimDeviceVector, _INR(0, 2), result, sigio, pw);
    _swix(OS_Hardware, _IN(0) | _INR(8, 9), result, 0, EntryNo_HAL_IRQEnable);
    // Linux signals only new events, so data that came before the signal
    // was set up (an RDP or TLS client's first packet, sent straight after
    // connecting) would never be seen by select, and "can write" is only
    // signalled after the send buffer has been full: ask now.
    struct ix_pollfd pfd = {result, ix_POLLIN | ix_POLLOUT, 0};
    ix_poll(&pfd, 1, 0);
    if (pfd.revents & (ix_POLLIN | ix_POLLERR | ix_POLLHUP))
      sockets[result].pollword[__NR_recvmsg & 1].s.data = 1;
    if (pfd.revents & ix_POLLOUT)
      sockets[result].pollword[__NR_sendmsg & 1].s.data = 1;
  }
  return result;
}

static pollword_t select_pollwords[256];

static int do_select(int *restrict r) {

  // Allocate pollword from array;
  static bool used[256];
  int pwi = 255;
  while (used[pwi] && pwi) --pwi;
  used[pwi] = true;
  if (pwi) select_pollwords[pwi].word = 0;

  // Handle timeout
  extern void select_timeout(void);
  struct timeval *timeout1 = (void*)r[4];
  long timeout = -1;
  if (timeout1) {
    // In centiseconds, rounded up, so that a timeout under 1cs still waits
    timeout = timeout1->tv_sec * 100 + (timeout1->tv_usec + 9999) / 10000;
    if (timeout) _swix(OS_CallAfter, _INR(0, 2), timeout, select_timeout, &select_pollwords[pwi].s.timeout);
  }

  if (timeout) while(true) {
    if (pwi) select_pollwords[pwi].s.data = 0;

    // Check if ready.
    bool sleeptw = false;
    char ready = 0;
    for(int fd = 0; fd < r[0]; ++fd) {
      for(int dir = 1; dir != 4; ++dir) {
        if (r[dir] && FD_ISSET(fd, (fd_set *)r[dir])) {
          ready |= sockets[fd].pollword[(dir - 1) ^ 1].s.data;
          sleeptw |= sockets[fd].sleeptw;
        }
      }
    }

    if (ready) break;
    // The timeout's ticker event (select_timeout) has set .s.timeout: return
    // 0. Without this the loop never ended: the pollword stays non-zero, so
    // pollword_sleep returns at once and the loop spun at full speed until
    // some socket became ready (TubeSearch/!REEL hung the machine).
    if (timeout > 0 && select_pollwords[pwi].s.timeout) break;
    pollword_sleep(sleeptw, &select_pollwords[pwi]);
  }
  if (timeout > 0) _swix(OS_RemoveTickerEvent, _INR(0, 1) , select_timeout, &select_pollwords[pwi].s.timeout);
  used[pwi] = false;

  int nfds = 0;
  for(int fd = 0; fd < r[0]; ++fd) {
    for(int dir = 1; dir != 4; ++dir) {
      if (r[dir] && FD_ISSET(fd, (fd_set *)r[dir])) {
        if (sockets[fd].pollword[(dir - 1) ^ 1].s.data) {
          ++nfds;
        } else {
          FD_CLR(fd, (fd_set *)r[dir]);
        }
      }
    }
  }
  return nfds;
}


_kernel_oserror *swi_handler(int swi_no, _kernel_swi_regs *r, void *pw) {
  (void)pw;
  int result = -ix_EPROTONOSUPPORT;
  switch (swi_no) {
    case Socket_Creat - Socket_00: {
      // a raw ICMP socket is a Linux ping socket (see "ICMP" above)
      bool icmp = r->r[0] == AF_INET && r->r[1] == SOCK_RAW && r->r[2] == IPPROTO_ICMP;
      int type = icmp ? SOCK_DGRAM : r->r[1];
      if (r->r[0] == AF_INET && (type == SOCK_DGRAM || type == SOCK_STREAM)) {
        if (socket_server != -1) {
          int so[3] = {r->r[0], type | ix_SOCK_NONBLOCK , r->r[2]};
          ix_write(socket_server, so, sizeof(so));
          struct ix_iovec iov = {&result, sizeof(result)};
          struct ix_cmsghdr_fd cmsg;
          struct ix_msghdr msg = {
            .msg_iov = &iov,
            .msg_iovlen = 1,
            .msg_control = &cmsg,
            .msg_controllen = sizeof(cmsg),
          };
          ix_recvmsg(socket_server, &msg, ix_MSG_CMSG_CLOEXEC);
          if (cmsg.cmsg_level == 1 && cmsg.cmsg_type == 1) {
            result = cmsg.fd;
          }
        } else {
          result = ix_socket(r->r[0], type | ix_SOCK_NONBLOCK | ix_SOCK_CLOEXEC , r->r[2]);
        }
        if (result >= NSOCKETS) {
          ix_close(result);
          result = -ix_EMFILE;
        }
        if (result >= 0) {
          memset(&sockets[result], 0, sizeof(sockets[result]));
          if (icmp) {
            int on = 1;
            ix_setsockopt(result, 0 /* IPPROTO_IP */, 12 /* IP_RECVTTL */, &on, sizeof(on));
            sockets[result].icmp = true;
            sockets[result].icmp_cursor = icmp_seq;
          }
          _swix(OS_ClaimDeviceVector, _INR(0, 2), result, sigio, pw);
          _swix(OS_Hardware, _IN(0) | _INR(8, 9), result, 0, EntryNo_HAL_IRQEnable);
        }
      }
      break;
    }
    case Socket_Read - Socket_00: {
      struct ix_iovec iov = {(void*)r->r[1], r->r[2]};
      struct ix_msghdr msg = {
        .msg_iov = &iov,
        .msg_iovlen = 1
      };
      result = do_recvmsg(r->r[0], &msg, 0);
      break;
    }
    case Socket_Write - Socket_00:
      result = do_sendto(r->r[0], (void*)r->r[1], r->r[2], 0, 0);
      break;
    case Socket_Recv - Socket_00: {
      struct ix_iovec iov = {(void*)r->r[1], r->r[2]};
      struct ix_msghdr msg = {
        .msg_iov = &iov,
        .msg_iovlen = 1
      };
      result = do_recvmsg(r->r[0], &msg, convert_msg_flags(r->r[3]));
      break;
    }
    case Socket_Send - Socket_00:
      result = do_sendto(r->r[0], (void*)r->r[1], r->r[2], convert_msg_flags(r->r[3]), 0);
      break;
    case Socket_Sendto - Socket_00:
      result = do_sendto(r->r[0], (void*)r->r[1], r->r[2], convert_msg_flags(r->r[3]), (void *)r->r[4]);
      break;
    // Socket_Sendmsg (4.3BSD message and address) and Socket_Sendmsg_1
    // (4.4BSD, UnixLib's and TCPIPLibs' sendmsg()): the first four words
    // of the message are the same, and do_sendmsg takes both address forms
    case Socket_Sendmsg - Socket_00:
    case Socket_Sendmsg_1 - Socket_00:
      result = do_sendmsg(r->r[0], (void*)r->r[1], convert_msg_flags(r->r[2]));
      break;
    case Socket_Recvfrom - Socket_00: {
      struct ix_iovec iov = {(void*)r->r[1], r->r[2]};
      struct ix_msghdr msg = {
        .msg_iov = &iov,
        .msg_iovlen = 1,
        .msg_name = (void *)r->r[4]
      };
      int *namelen = (int *)r->r[5];
      if (namelen) msg.msg_namelen = *namelen;
      result = do_recvmsg(r->r[0], &msg, convert_msg_flags(r->r[3]));
      if (namelen) *namelen = msg.msg_namelen;
      break;
    }
    case Socket_Recvfrom_1 - Socket_00: {
      struct ix_iovec iov = {(void*)r->r[1], r->r[2]};
      struct ix_msghdr msg = {
        .msg_iov = &iov,
        .msg_iovlen = 1,
        .msg_name = (void *)r->r[4]
      };
      int *namelen = (int *)r->r[5];
      if (namelen) msg.msg_namelen = *namelen;
      result = do_recvmsg(r->r[0], &msg, convert_msg_flags(r->r[3]));
      addr2riscos(msg.msg_name, msg.msg_namelen);
      if (namelen) *namelen = msg.msg_namelen;
      break;
    }
    case Socket_Recvmsg - Socket_00: {
      struct msghdr *m = (void *)r->r[1];
      struct ix_msghdr msg = {
        .msg_iov = m->msg_iov,
        .msg_iovlen = m->msg_iovlen,
        .msg_name = (void *)m->msg_name,
        .msg_namelen = m->msg_namelen
      };
      result = do_recvmsg(r->r[0], &msg, convert_msg_flags(r->r[2]));
      m->msg_namelen = msg.msg_namelen;
      break;
    }
    case Socket_Recvmsg_1 - Socket_00: {
      struct msghdr *m = (void *)r->r[1];
      result = do_recvmsg(r->r[0], (void *)m, convert_msg_flags(r->r[2]));
      if (result >= 0) {
        addr2riscos(m->msg_name, m->msg_namelen);
        int f1 = m->msg_flags, f2 = 0;
        if (f1 & ix_MSG_OOB) f2 |= MSG_OOB;
        if (f1 & ix_MSG_EOR) f2 |= MSG_EOR;
        if (f1 & ix_MSG_TRUNC) f2 |= MSG_TRUNC;
        m->msg_flags = f2;
        // FIXME: Control message data
      }
      break;
    }
    case Socket_Listen - Socket_00:
      result = ix_listen(r->r[0], r->r[1]);
      break;

    case Socket_Connect - Socket_00:
      sockets[r->r[0]].pollword[__NR_sendmsg & 1].s.data = 0;
      SET_ADDRESS(r->r[1], ix_connect(r->r[0], &addr_linux, sizeof(addr_linux)))
      if (result == -ix_EINPROGRESS) {
        socket_sleep(r->r[0], __NR_sendmsg & 1);
        ix_socklen_t optlen = sizeof(result);
        ix_getsockopt(r->r[0], ix_SOL_SOCKET, ix_SO_ERROR, &result, &optlen);
        result = 0;
      }
      break;
    case Socket_Bind - Socket_00:
      if (is_icmp(r->r[0])) {
        // kept until the first send, which binds it with the ident too
        const struct sockaddr_in *a = (const struct sockaddr_in *)r->r[1];
        sockets[r->r[0]].icmp_bind_addr = a->sin_addr.s_addr;
        result = 0;
        break;
      }
      SET_ADDRESS(r->r[1], ix_bind(r->r[0], &addr_linux, sizeof(addr_linux)))
      break;
    case Socket_Accept - Socket_00:
      result = do_accept(r->r[0], (void*)r->r[1], (ix_socklen_t *)r->r[2], pw);
      break;
    case Socket_Accept_1 - Socket_00:
      GET_ADDRESS_1(r->r[1], r->r[2], do_accept(r->r[0], addr, len, pw))
      break;
    case Socket_Getpeername - Socket_00:
      result = ix_getpeername(r->r[0], (void*)r->r[1], (ix_socklen_t *)r->r[2]);
      break;
    case Socket_Getpeername_1 - Socket_00:
      GET_ADDRESS_1(r->r[1], r->r[2], ix_getpeername(r->r[0], addr, len))
      break;
    case Socket_Getsockname - Socket_00:
      result = ix_getsockname(r->r[0], (void*)r->r[1], (ix_socklen_t *)r->r[2]);
      break;
    case Socket_Getsockname_1 - Socket_00:
      GET_ADDRESS_1(r->r[1], r->r[2], ix_getsockname(r->r[0], addr, len))
      break;
    case Socket_Select - Socket_00: {
      result = do_select(r->r);
      break;
    }
    case Socket_Shutdown - Socket_00:
      result = ix_shutdown(r->r[0], r->r[1]);
      break;
    case Socket_Close - Socket_00:
      _swix(OS_Hardware, _IN(0) | _INR(8, 9), r->r[0], 0, EntryNo_HAL_IRQDisable);
      _swix(OS_ReleaseDeviceVector, _INR(0, 2), r->r[0], sigio, pw);
      if (r->r[0] >= 0 && r->r[0] < NSOCKETS) sockets[r->r[0]].icmp = false;
      result = ix_close(r->r[0]);
      break;
    case Socket_Setsockopt - Socket_00: {
      int *kept = buffer_option(r->r[0], r->r[1], r->r[2]);
      if (kept) {
        if (r->r[4] < (int)sizeof(int) || !r->r[3]) { result = -ix_EINVAL; break; }
        *kept = *(int *)r->r[3];
        result = 0;
        break;
      }
      result = convert_sockopt(r->r[1], r->r[2]);
      int level = r->r[1] == SOL_SOCKET ? ix_SOL_SOCKET : r->r[1];
      if (result >= 0) result = ix_setsockopt(r->r[0], level, result, (void*)r->r[3], r->r[4]);
      break;
    }
    case Socket_Getsockopt - Socket_00: {
      int *kept = buffer_option(r->r[0], r->r[1], r->r[2]);
      if (kept && *kept > 0 && r->r[3] && r->r[4] && *(int *)r->r[4] >= (int)sizeof(int)) {
        *(int *)r->r[3] = *kept;
        *(int *)r->r[4] = sizeof(int);
        result = 0;
        break;
      }
      result = convert_sockopt(r->r[1], r->r[2]);
      int level = r->r[1] == SOL_SOCKET ? ix_SOL_SOCKET : r->r[1];
      if (result >= 0) result = ix_getsockopt(r->r[0], level, result, (void*)r->r[3], (void*)r->r[4]);
      if (result >= 0 && level == ix_SOL_SOCKET) {
        switch (r->r[2]) {
          case SO_TYPE:
            if (is_icmp(r->r[0])) *(int*)r->r[3] = SOCK_RAW;
            break;
          case SO_ERROR:
            // FIXME What is optlen is too small?
            if (*(int*)r->r[3]) *(int*)r->r[3] = _swix(IXSupport_ConvertError, _IN(0), *(int*)r->r[3])->errnum - 0x20E00;
            break;
        }
      }
      break;
    }
    case Socket_InternalLookup - Socket_00:
      // kvm_nlist: Internet 5's counters (_tcpstat, _udpstat, _ipstat), kept
      // up to date once a second from now on
      result = rol_lookup((void *)r->r[1]);
      if (!stats_ticking) {
        if (!_swix(OS_CallEvery, _INR(0, 2), 99, stats_tick, pw))
          stats_ticking = true;
      }
      break;
    case Socket_Version - Socket_00:
      // The Internet 5 interface (RISC OS Open's TCPIPLibs layouts, which
      // c.sysctl gives): reported as Internet 5.73, as RISC OS 5.31's own
      result = 573;
      break;
    case Socket_Sysctl - Socket_00:
      // The network status calls (interfaces, routes, ARP, TCP/UDP/IP
      // counters) from Linux, in the ROD stack's layout: c.sysctl
      result = rol_sysctl((const int *)r->r[0], r->r[1], (void *)r->r[2],
                          (size_t *)r->r[3], (const void *)r->r[4], r->r[5]);
      break;
    case Socket_Ioctl - Socket_00:
      switch ((uint32_t)r->r[1]) {
        case FIOASYNC:
          sockets[r->r[0]].async = !!*(int *)r->r[2];
          ix_MESSAGE(2, "Handling FIOASYNC\n");
          result = 0;
          break;
        case FIONBIO:
          sockets[r->r[0]].nonblocking = !!*(int *)r->r[2];
          result = 0;
          break;
        case FIOSLEEPTW:
          sockets[r->r[0]].sleeptw = !!*(int *)r->r[2];
          result = 0;
          break;
        case FIONREAD:
          result = ix_ioctl(r->r[0], ix_FIONREAD, (int *)r->r[2]);
          break;

        // The interfaces (Freeway: ShareFS's and Access's discovery), from
        // Linux. struct ifreq is 32 bytes in both, the name then the
        // union; addresses come in Linux's sockaddr (a 16-bit family),
        // given in RISC OS's (a length byte, then the family byte).
        case SIOCGIFCONF: {
          struct ifconf *c = (struct ifconf *)r->r[2];
          result = ix_ioctl(r->r[0], 0x8912, c);
          if (result >= 0)
            for (int off = 0; off + (int)sizeof(struct ifreq) <= c->ifc_len; off += sizeof(struct ifreq))
              sockaddr2riscos(c->ifc_buf + off + IFNAMSIZ);
          break;
        }
        case SIOCGIFFLAGS: {
          struct ifreq *f = (struct ifreq *)r->r[2];
          result = ix_ioctl(r->r[0], 0x8913, f);
          if (result >= 0) {
            unsigned l = (uint16_t)f->ifr_flags;
            // the same bits up to ALLMULTI, but for Linux's NOTRAILERS
            // (RISC OS's SMART); Linux's MASTER and SLAVE aren't RISC OS's
            unsigned ro = l & 0x3DF;
            if (l & 0x1000) ro |= IFF_MULTICAST;
            f->ifr_flags = (short)ro;
            f->ifr_flagshigh = 0;
          }
          break;
        }
        case SIOCGIFADDR:
        case SIOCGIFDSTADDR:
        case SIOCGIFBRDADDR:
        case SIOCGIFNETMASK: {
          uint32_t req = (uint32_t)r->r[1];
          int linux_req = req == SIOCGIFADDR ? 0x8915 : req == SIOCGIFDSTADDR ? 0x8917
                        : req == SIOCGIFBRDADDR ? 0x8919 : 0x891B;
          struct ifreq *f = (struct ifreq *)r->r[2];
          result = ix_ioctl(r->r[0], linux_req, f);
          if (result >= 0) sockaddr2riscos((char *)f + IFNAMSIZ);
          break;
        }
        // Linux's network is set up by Linux (rol-netd), not by RISC OS
        case SIOCSIFADDR:
        case SIOCSIFFLAGS:
        case SIOCSIFBRDADDR:
        case SIOCSIFNETMASK:
        case SIOCSIFDSTADDR:
          result = -ix_EPERM;
          break;

        default:
          eprintf("Unhandled Internet Ioctl: 0x%08X\n", r->r[1]);
          return error_BAD_SWI;
      }
      break;
    default:
      eprintf("Unhandled Internet SWI: %i\n", swi_no);
      return error_BAD_SWI;
  }
  if (result < 0) {
    return _swix(IXSupport_ConvertError, _IN(0), result);
  }
  r->r[0] = result;
  return 0;
}

extern void raise_event(void);

// Socket_InternalLookup's counters: a ticker once a second, which only
// asks for a callback (the work, reading Linux's files, is done there)

// (cmhg's generic veneers: the handlers return an error or NULL)
_kernel_oserror *stats_tick_handler(_kernel_swi_regs *r, void *pw) {
  (void)r;
  if (!stats_pending && !_swix(OS_AddCallBack, _INR(0, 1), stats_callback, pw))
    stats_pending = true;
  return NULL;
}

_kernel_oserror *stats_callback_handler(_kernel_swi_regs *r, void *pw) {
  (void)r; (void)pw;
  stats_pending = false;
  rol_stats_refresh();
  return NULL;
}

_kernel_oserror *final(int fatal, int podule, void *pw) {
  (void)fatal; (void)podule;
  if (stats_ticking) _swix(OS_RemoveTickerEvent, _INR(0, 1), stats_tick, pw);
  if (stats_pending) _swix(OS_RemoveCallBack, _INR(0, 1), stats_callback, pw);
  return 0;
}

int sigio_handler(_kernel_swi_regs *regs, void *pw) {
  int s = regs->r[0];
  // No "sigio N" line here: this runs for every socket signal, and writing
  // it to stderr cost a system call each time (thousands a minute while
  // streaming video) and filled riscos-log.txt.
  ix_siginfo_t *info = (void *)regs->r[1];
  int band = info->u.sigpoll.band;

  if (band & (ix_POLLIN | ix_POLLERR | ix_POLLHUP))
    sockets[s].pollword[__NR_recvmsg & 1].s.data = 1;

  // every raw ICMP socket sees every ICMP packet (see "ICMP" above)
  if (sockets[s].icmp && (band & ix_POLLIN))
    for (int i = 0; i < NSOCKETS; ++i)
      if (sockets[i].icmp) sockets[i].pollword[__NR_recvmsg & 1].s.data = 1;

  if (band & (ix_POLLOUT))
    sockets[s].pollword[__NR_sendmsg & 1].s.data = 1;

  // (a close or an error is news for an async socket's owner too, as on
  // RISC OS's own stack, where the close wakes its readers)
  if (sockets[s].async && (band & (ix_POLLIN | ix_POLLERR | ix_POLLHUP))) {
    eprintf("Sending Internet Event for socket %i\n", s);
    _swix(OS_AddCallBack, _INR(0, 1), raise_event, s);
  }

  for(int i = 0; i != sizeof(select_pollwords) / sizeof(select_pollwords[0]); ++i)
    select_pollwords[i].s.data = 1;

  _swi(OS_Hardware, _IN(0) | _INR(8, 9), s, 0, EntryNo_HAL_IRQClear);
  return 0;
}

 _kernel_oserror *init(const char *cmd_tail, int podule_base, void *pw) {
  const char *s = getenv("Internet$SocketServer");
  if (s) socket_server = atoi(s);
  return 0;
}
