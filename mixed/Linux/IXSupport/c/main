_kernel_oserror *init(const char *cmd_tail, int podule_base, void *pw) {

  // Copy Linux environment variables to RISC OS system variables.
  for(char **i = __HAL_get_env(); *i; ++i) {
    char *const limit = pd1.name + sizeof(pd1.name) - 1;
    char *s = *i, *d = pd1.name;
    if (memcmp(s, "RISC_OS_", 8) == 0 && s[8] != '_') {
      s += 8;
      while(*s && *s != '=' && d < limit) {
        char c = *s++;
        if (c == '_' || c == '$') c= c ^ ('_' ^ '$');
        *d++ = c;
      }
    } else {
      *d++ = 'i';
      *d++ = 'x';
      *d++ = '$';
      while(*s && *s != '=' && d < limit) *d++ = *s++;
    }
    *d = 0;
    if (*s == '=') ++s;
    _swix(OS_SetVarVal, _INR(0, 4), pd1.name, s, strlen(s), 0, 4);
  }

  module_pw = pw;
  pd1.fd = -1;
  pd2.fd = -1;
  pd1.dir_fd = -1;
  pd2.dir_fd = -1;

  _kernel_oserror *e = 0;

  e = _swix(OS_FSControl, _INR(0, 3), 12, __module_header, (uintptr_t)fsinfo - (uintptr_t)__module_header, pw);
  return e;
}

_kernel_oserror *final(int fatal, int podule, void *pw) {
  (void)pw;
  _kernel_oserror *e = 0;
  e = _swix(OS_FSControl, _INR(0, 1), 16, "IXFS");
  if (!e) mime_final();
  return e;
}

_kernel_oserror *convert_error(int r) {
  static _kernel_oserror unknown_error = {0, "Unknown Error"};
  r = -r;
  _kernel_oserror *e = 0;
  if (r > 0 && r < 4096) e = error_table[r];
  if (!e) {
    e = &unknown_error;
    eprintf("Untranslated Linux Error: %i\n", r);
    sprintf(unknown_error.errmess, "Untranslated Linux Error %i", r);
  }
  return e;
}

_kernel_oserror *swi_handler(int swi_no, _kernel_swi_regs *r, void *pw) {
  (void)pw;
  switch (swi_no) {
    case IXSupport_LinuxSyscall - IXSupport_00:
#ifdef __GNUC__
      asm volatile ("LDMIA %0, {r0-r7}\n BL __PVirt_LinuxSyscall\n STR r0, [%0]" : : "r"(r) : "r0", "r1", "r2", "r3", "r4", "r5", "r6", "r7", "lr", "memory");
#else
      __asm {
        MOV     r0, r->r[0]
        MOV     r1, r->r[1]
        MOV     r2, r->r[2]
        MOV     r3, r->r[3]
        MOV     r4, r->r[4]
        MOV     r5, r->r[5]
        MOV     r6, r->r[6]
        MOV     r7, r->r[7]
        BL      __PVirt_LinuxSyscall, {r0-r7}, {r0}, {}
        MOV     r->r[0], r0
      }
#endif
      return 0;
    case IXSupport_ConvertError - IXSupport_00:
      return convert_error(r->r[0]);
  }
  return error_BAD_SWI;
}

/*
 * *IXRun through rol-cmd (RISC OS on Linux images): RISC OS is one Linux
 * process, and protected RISC OS's view of the files has no Linux
 * programs or terminals (no /dev/ptmx), so the image's rol-cmd daemon runs
 * the command for it as RISC OS's own Linux user (its "@user" request, as
 * LinuxShell's *LinuxUser: no password, no privileges, through /bin/sh -c
 * so the path is searched), and the output is printed as it comes. This
 * needs nothing loaded at start-up. Without rol-cmd (no /riscos/cmd, or
 * nobody takes the request) *IXRun works as before, through a terminal.
 */
#define CMD_DIR "/riscos/cmd/"
#ifndef ix_O_WRONLY
#define ix_O_WRONLY 0x1
#endif

static _kernel_oserror err_cmd_failed = {0x81A73, "The Linux command failed"};
static _kernel_oserror err_cmd_too_long = {0x81A72, "*IXRun: the command is too long"};
static _kernel_oserror err_escape = {17, "Escape"};

static unsigned ixrun_count;

static unsigned ixrun_now(void) {
  unsigned t = 0;
  _swix(OS_ReadMonotonicTime, _OUT(0), &t);
  return t;
}

static void ixrun_name(char *d, const char *name, const char *ext) {
  strcpy(d, CMD_DIR);
  strcat(d, name);
  strcat(d, ext);
}

// Prints what's new in the output file from *pos on (newlines as CR LF).
static _kernel_oserror *ixrun_drain(const char *out, unsigned *pos) {
  int f = ix_open(out, ix_O_RDONLY | ix_O_CLOEXEC, 0);
  if (f < 0) return 0;
  _kernel_oserror *error = 0;
  if (ix_lseek(f, *pos, 0) >= 0) {
    char buf[256];
    int n;
    while (!error && (n = ix_read(f, buf, sizeof(buf))) > 0) {
      *pos += n;
      for (int i = 0; i < n && !error; ++i) {
        int c = (unsigned char)buf[i];
        if (c == 27) continue; // TERM=dumb asks for no escape sequences
        if (c == '\n') error = _swix(OS_NewLine, 0);
        else error = _swix(OS_WriteC, _IN(0), c);
      }
    }
  }
  ix_close(f);
  return error;
}

static int ixrun_rc(const char *rc) {
  char b[16];
  int f = ix_open(rc, ix_O_RDONLY | ix_O_CLOEXEC, 0);
  if (f < 0) return -1;
  int n = ix_read(f, b, sizeof(b) - 1);
  ix_close(f);
  if (n <= 0) return -1;
  int v = 0;
  for (int i = 0; i < n && b[i] >= '0' && b[i] <= '9'; ++i) v = v * 10 + (b[i] - '0');
  return v;
}

static bool ixrun_escape(void) {
  int flags = 0;
  _swix(OS_ReadEscapeState, _OUT(_FLAGS), &flags);
  return (flags & _C) != 0;
}

// 0: done (*error set if it failed); 1: no rol-cmd here, use the terminal
static int ixrun_rolcmd(const char *arg_string, _kernel_oserror **error) {
  *error = 0;
  if (ix_access(CMD_DIR, 2) != 0) return 1;

  static char body[1100];
  int n = 0;
  memcpy(body, "@user\n", 6);
  n = 6;
  while (arg_string[n - 6] >= ' ' || arg_string[n - 6] == '\t') {
    if (n >= (int)sizeof(body) - 2) {
      *error = &err_cmd_too_long;
      return 0;
    }
    body[n] = arg_string[n - 6];
    ++n;
  }
  body[n++] = '\n';

  char name[20], tmp[48], req[48], out[48], rc[48], kill[48];
  sprintf(name, "x%08x%04x", ixrun_now(), ++ixrun_count & 0xFFFF);
  ixrun_name(tmp, name, ".new");
  ixrun_name(req, name, ".req");
  ixrun_name(out, name, ".out");
  ixrun_name(rc, name, ".rc");
  ixrun_name(kill, name, ".kill");

  int f = ix_open(tmp, ix_O_WRONLY | ix_O_CREAT | ix_O_TRUNC | ix_O_CLOEXEC, 0600);
  if (f < 0) return 1;
  ix_write(f, body, n);
  ix_close(f);
  if (ix_rename(tmp, req) != 0) {
    ix_unlink(tmp);
    return 1;
  }

  unsigned pos = 0, t0 = ixrun_now();
  bool escaped = false;
  int code;
  static volatile int pollword = 1; // non-zero: a TaskWindow resumes us at its next poll
  for (;;) {
    _kernel_oserror *e = ixrun_drain(out, &pos);
    if (e && !*error) *error = e;
    if ((code = ixrun_rc(rc)) >= 0) break;
    if (!escaped && ixrun_escape()) {
      _kernel_osbyte(OsByte_AcknowledgeEscape, 0, 0);
      int k = ix_open(kill, ix_O_WRONLY | ix_O_CREAT | ix_O_TRUNC | ix_O_CLOEXEC, 0644);
      if (k >= 0) ix_close(k);
      escaped = true;
    }
    // Nobody took it in 5 seconds: no rol-cmd running, use the terminal
    if (pos == 0 && ixrun_now() - t0 > 500 && ix_access(req, 0) == 0) {
      if (ix_unlink(req) == 0) return 1;
    }
    _swix(OS_UpCall, _INR(0, 1), UpCall_Sleep, &pollword);
    struct ix_timespec ts = {0, 20 * 1000 * 1000};
    ix_nanosleep(&ts, 0);
  }
  _kernel_oserror *e = ixrun_drain(out, &pos);
  if (e && !*error) *error = e;
  ix_unlink(out);
  ix_unlink(rc);
  if (*error) return 0;
  if (escaped) {
    *error = &err_escape;
  } else if (code != 0) {
    char msg[32];
    sprintf(msg, "(exit status %i)", code);
    _swix(OS_Write0, _IN(0), msg);
    _swix(OS_NewLine, 0);
    *error = &err_cmd_failed;
  }
  return 0;
}

static _kernel_oserror *ixrun_terminal(const char *arg_string, int argc);

static _kernel_oserror *do_IXRun(const char *arg_string, int argc) {
  _kernel_oserror *error;
  if (ixrun_rolcmd(arg_string, &error) == 0) return error;
  return ixrun_terminal(arg_string, argc);
}

static _kernel_oserror *ixrun_terminal(const char *arg_string, int argc) {

  // TODO list:
  // Handle non-zero return codes.
  // Provide translation from RISC OS to Linux paths.
  // Do something sensible with environment variables.
  // Better handling of terminal / VDU codes.
  // Better handling of Escape / SIGTERM?
  // Deal with file descriptor leaks.
  // Provide access to RISC OS filing systems.

  char *cmd[argc + 1];
  char *env[] = {0};
  int pipe[2];
  int e;
  _kernel_oserror *error = 0;


  // Allocate memory for
  struct data {
    volatile int pollword;
    char buffer[1024];
  } *data = malloc(sizeof(struct data));

  if (!data) return _kernel_last_oserror();

  // Open pseudo-terminal master
  e = ix_open("/dev/ptmx", ix_O_RDWR | ix_O_CLOEXEC | ix_O_NONBLOCK, 0);
  if (e < 0) goto free_error;
  int ptmx = e;

  e = __PVirt_Poll_ctl(ptmx, ix_EPOLL_CTL_ADD, ix_EPOLLET | ix_EPOLLIN | ix_EPOLLOUT | ix_EPOLLHUP, &data->pollword);
  if (e) goto close_error;

  // Open a pipe communicate with child process
  e = ix_pipe2(pipe, ix_O_CLOEXEC);
  if (e) {
    __PVirt_Poll_remove(ptmx);
close_error:
    ix_close(ptmx);
free_error:
    free(data);
    return convert_error(e);
  }

  // Do the fork, possibly on another thread to avoid seccomp
  int pid = __PVirt_fork(pipe);

  if (pid == 0) {
    // In child, create new session
    ix_setsid();

    // Parse command line, overwriting copy of input.
    char *out = (char *)arg_string;
    char **arg = cmd;
    char c = *arg_string;
    while(c >= ' ') {
      while(c == ' ') c = *++arg_string; // Skip spaces
      *arg++ = out;
      while(c > ' ') {
        if (c== '"' || c == '\'') {
          char q = *++arg_string;
          while(q != c && q  >= ' ') {
            *out++ = q;
            q = *++arg_string;
          }
          c = *++arg_string;
        } else {
          *out++ = c;
          c = *++arg_string;
        }
      }
      *out++ = 0;
    }
    *arg = 0;

    // Unlock pseudo-terminal
    int zero = 0;
    e = ix_ioctl(ptmx, ix_TIOCSPTLCK, &zero);
    if (e) goto error;

    // Get pseudo-terminal number
    int pts_no;
    e = ix_ioctl(ptmx, ix_TIOCGPTN, &pts_no);
    if (e) goto error;

    // Open slave end
    char ptsname[20];
    sprintf(ptsname, "/dev/pts/%i", pts_no);
    int pts = ix_open(ptsname, ix_O_RDWR | ix_O_CLOEXEC, 0);
    if (pts < 0) {
      e = pts;
      goto error;
    }

    // Duplicate file descriptor to stdin, stdout, and stderr
    e = ix_dup2(pts, 0);
    if (e < 0) goto error;
    e = ix_dup2(pts, 1);
    if (e < 0) goto error;
    e = ix_dup2(pts, 2);
    if (e < 0) goto error;

    // Execute command: a name without a '/' is looked for in the path
    if (strchr(cmd[0], '/')) {
      e = ix_execve(cmd[0], cmd, 0);
    } else {
      static const char *const dirs[] = {"/usr/local/bin/", "/usr/bin/", "/bin/", "/usr/sbin/", "/sbin/"};
      char path[256];
      e = -ix_ENOENT;
      for (unsigned i = 0; i < sizeof(dirs) / sizeof(dirs[0]); ++i) {
        if (strlen(dirs[i]) + strlen(cmd[0]) >= sizeof(path)) break;
        strcpy(path, dirs[i]);
        strcat(path, cmd[0]);
        int r = ix_execve(path, cmd, 0);
        if (r != -ix_ENOENT) e = r;
        if (r != -ix_ENOENT && r != -ix_EACCES) break;
      }
    }
error:
    ix_write(pipe[1], &e, sizeof(e));
    ix_exit(1);
    *(int *)0 = 0;

  } else if (pid != 0) {

    // Close write end of pipe
    ix_close(pipe[1]);

    ix_read(pipe[0], &e, sizeof(e));

    // Close read end of pipe
    ix_close(pipe[0]);

    int c;
    int in = -1;
    if (e) {
      error = convert_error(e);
    } else while (true) {
      data->pollword = 0;

      // Copy from pseudo-terminal master to RISC OS output stream.
      c = ix_read(ptmx, data->buffer, sizeof(data->buffer));
      if (c > 0) {
        data->pollword = 1;
        error = _swix(OS_WriteN, _INR(0, 1), data->buffer, c);
        if (error) break;
      } else {
        if (c != -ix_EAGAIN)
          break;
      }

      // Copy character RISC OS output stream from to pseudo-terminal
      // using "in" as a 1 byte buffer.
      _kernel_irqs_off();
      if (in < 0) {
        int flag;
        error = _swix(OS_Byte, _INR(0, 2) | _OUTR(1, 2), OsByte_INKEY, 0, 0, &in, &flag);
        if (error) break;
        switch(flag) {
          case 255:
            in = -1;
            break;
          case 27:
            in = 3; // Escape becomes CTRL C
            ix_MESSAGE(2,"Escape in IXRun\n");
            _kernel_osbyte(OsByte_AcknowledgeEscape, 0, 0);
          default:
            data->pollword = 1;
        }
      }
      if (in >= 0) {
        c = ix_write(ptmx, &in, 1);
        if (c == 1) in = -1;
      }

      if (!data->pollword) {
        int r;
        error = _swix(OS_UpCall, _INR(0, 1) | _OUT(0), UpCall_Sleep, &data->pollword, &r);
        if (error) break;
        if (r && !data->pollword) __PVirt_WFI();
      }
      _kernel_irqs_on();
    }
    __PVirt_Poll_remove(ptmx);
    ix_close(ptmx);
    _kernel_irqs_on();
    int wstatus;
    ix_waitpid(pid, &wstatus, 0);
  } else {
    // Fork failed
    ix_close(pipe[0]);
    ix_close(pipe[1]);
    __PVirt_Poll_remove(ptmx);
    ix_close(ptmx);
    error = convert_error(pid);
  }
  free(data);
  return error;
}

_kernel_oserror *command_handler(const char *arg_string, int argc, int cmd_no, void *pw) {
  (void)arg_string;
  (void)argc;
  (void)pw;
  switch(cmd_no) {
    case CMD_IXFS:
      return _swix(OS_FSControl, _INR(0, 1), 14, 70);
    case CMD_IXFSBoot:
      break;
    case CMD_IXDup2: {
      int a, b;
      sscanf(arg_string, "%i %i", &a, &b);
      ix_dup2(a, b);
      break;
    }
    case CMD_IXRun:
      return do_IXRun(arg_string, argc);
  }
  return 0;
}
