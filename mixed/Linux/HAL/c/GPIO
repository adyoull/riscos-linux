/* the register for 32 pins: this device's (the next word for device 1) */
static uint32_t bank_reg(struct gpio_device *d, unsigned off, bool write, uint32_t bits) {
  volatile uint32_t *r = &d->address[off / 4 + d->number];
  uint32_t v = *r & (d->number ? 0x003FFFFFu : 0xFFFFFFFFu);
  if (write) *r = bits & d->usable;
  return v;
}

static uint32_t gpio_set(struct gpio_device *d, uint32_t bits) { return bank_reg(d, GPSET, true, bits); }
static uint32_t gpio_clear(struct gpio_device *d, uint32_t bits) { return bank_reg(d, GPCLR, true, bits); }
static uint32_t gpio_read(struct gpio_device *d) { return bank_reg(d, GPLEV, false, 0); }
static uint32_t gpio_edgepoll(struct gpio_device *d, uint32_t collect) { return bank_reg(d, GPEDS, true, collect); }

static void gpio_toggle(struct gpio_device *d, uint32_t bits) {
  if (!bits) return;
  uint32_t now = gpio_read(d);
  if (bits & now) gpio_clear(d, bits & now);
  if (bits & ~now) gpio_set(d, bits & ~now);
}

/* A pin's function (GPFSEL, 3 bits: 0 input, 1 output, 4-7 and 3, 2 its
   alternatives): returns it, -1 for a pin that can't be used; sets it
   unless mode is -1 */
static int pin_mode(struct gpio_device *d, int pin, int mode) {
  if (pin < 0 || pin > 31 || !(d->usable & (1u << pin))) return -1;
  unsigned n = d->number * 32 + pin;
  volatile uint32_t *r = &d->address[GPFSEL / 4 + n / 10];
  unsigned shift = (n % 10) * 3;
  uint32_t v = *r;
  if (mode != -1) *r = (v & ~(7u << shift)) | ((uint32_t)(mode & 7) << shift);
  return (v >> shift) & 7;
}

static int gpio_readmode(struct gpio_device *d, int pin) { return pin_mode(d, pin, -1); }
static int gpio_writemode(struct gpio_device *d, int pin, int mode) { return pin_mode(d, pin, mode); }

/* pins: those to change; dir: 1 input, 0 output. Returns the pins that
   were inputs. */
static uint32_t gpio_datadirection(struct gpio_device *d, uint32_t pins, uint32_t dir) {
  uint32_t was = 0;
  for (int pin = 0; pin < 32; pin++) {
    int mode = (pins >> pin) & 1 ? ((dir >> pin) & 1 ? 0 : 1) : -1;
    if (pin_mode(d, pin, mode) == 0) was |= 1u << pin;
  }
  return was;
}

/* Pulls: on (pull_on) pins pull up (pull_up) or down; off, none */
static void pulls_2835(struct gpio_device *d, uint32_t pins, unsigned what) {
  REG(d, GPPUD) = what;
  HAL_CounterDelay(50);
  d->address[GPPUDCLK / 4 + d->number] = pins;
  HAL_CounterDelay(50);
}

/* Only the usable pins are changed: Linux sets the others (the SD card's,
   Wi-Fi's) */
static void set_pulls(struct gpio_device *d, uint32_t on, uint32_t up) {
  uint32_t u = d->usable;
  if (!u) return;
  if (!bcm2711) {
    if (~on & u) pulls_2835(d, ~on & u, 0);
    if (on & ~up & u) pulls_2835(d, on & ~up & u, 1);
    if (on & up & u) pulls_2835(d, on & up & u, 2);
    REG(d, GPPUD) = 0;
    d->address[GPPUDCLK / 4 + d->number] = 0;
    return;
  }
  /* BCM2711: 2 bits a pin, 16 pins a word: 0 none, 1 up, 2 down */
  for (int w = 0; w < 2; w++) {
    volatile uint32_t *r = &d->address[GPPUPPDN / 4 + d->number * 2 + w];
    uint32_t v = *r;
    for (int i = 0; i < 16; i++) {
      uint32_t bit = 1u << (w * 16 + i);
      if (!(u & bit)) continue;
      unsigned p = 0;
      if (on & bit) p = up & bit ? 1 : 2;
      v = (v & ~(3u << (i * 2))) | (p << (i * 2));
    }
    *r = v;
  }
}

static uint32_t gpio_pullcontrol(struct gpio_device *d, uint32_t pins, uint32_t enable) {
  uint32_t old = d->pull_on, now = (old & ~pins) | (enable & pins);
  d->pull_on = now;
  if (now != old) set_pulls(d, now, d->pull_up);
  return old;
}

static uint32_t gpio_pulldirection(struct gpio_device *d, uint32_t pins, uint32_t up) {
  uint32_t old = d->pull_up, now = (old & ~pins) | (up & pins);
  d->pull_up = now;
  if ((now & d->pull_on) != (old & d->pull_on)) set_pulls(d, d->pull_on, now);
  return old;
}

/* Edge and level detection: enable, edge (1 edge, 0 level) and risehigh
   (1 rising or high, 0 falling or low) for pins; each returns the setting
   before */
static void gpio_edgecontrol(struct gpio_device *d, uint32_t pins, uint32_t *enable, uint32_t *edge, uint32_t *risehigh) {
  volatile uint32_t *a = d->address + d->number;
  uint32_t en = *enable, ed = *edge, rh = *risehigh;
  uint32_t ren = a[GPREN / 4], fen = a[GPFEN / 4], hen = a[GPHEN / 4], len = a[GPLEN / 4];
  *enable = ren | fen | hen | len;
  *edge = ren | fen;
  *risehigh = ren | hen;
  if (!pins) return;
  pins &= d->usable;
  a[GPREN / 4] = (ren & ~pins) | (pins & en & ed & rh);
  a[GPFEN / 4] = (fen & ~pins) | (pins & en & ed & ~rh);
  a[GPHEN / 4] = (hen & ~pins) | (pins & en & ~ed & rh);
  a[GPLEN / 4] = (len & ~pins) | (pins & en & ~ed & ~rh);
}

/* The description of pin *carryon (0: the first usable one), and the next
   usable one in *carryon (-1 after the last) */
static const uint32_t *gpio_enumerate(struct gpio_device *d, int *carryon) {
  uint32_t usable = d->usable;
  int pin = *carryon;
  if (pin < 0 || pin > 31) goto none;
  if (pin == 0) {
    if (!usable) goto none;
    while (!(usable & (1u << pin))) pin++;
  }
  if (!(usable & (1u << pin))) goto none;
  const uint32_t *p = d->pins;
  for (int i = 0; ; i++) {
    if (p[0] == 0xFFFFFFFFu) goto none;
    if (i == pin) break;
    p += 4 + p[0];
  }
  int next = pin + 1;
  while (next < 32 && !(usable & (1u << next))) next++;
  *carryon = next < 32 ? next : -1;
  return p + 1;
none:
  *carryon = -1;
  return 0;
}

static int dev_activate(struct gpio_device *d) { (void)d; return 1; }
static void dev_nothing(struct gpio_device *d) { (void)d; }
static int dev_sleep(struct gpio_device *d, int state) { (void)d; (void)state; return 0; }

static struct gpio_device gpio[2];

/* /proc/cpuinfo: the board's revision code ("Revision"), 0 if none, and
   whether the processor is a Cortex-A72 (a Pi 4's BCM2711) */
static char cpuinfo[4096];

static unsigned hexval(const char *s) {
  unsigned v = 0;
  while (*s == ' ' || *s == '\t' || *s == ':') s++;
  if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) s += 2;
  for (;;) {
    char c = *s++;
    if (c >= '0' && c <= '9') v = v * 16 + (c - '0');
    else if (c >= 'a' && c <= 'f') v = v * 16 + (c - 'a' + 10);
    else if (c >= 'A' && c <= 'F') v = v * 16 + (c - 'A' + 10);
    else return v;
  }
}

static const char *field(const char *name) {
  const char *s = cpuinfo;
  while (*s) {
    const char *n = name, *t = s;
    while (*n && *t == *n) n++, t++;
    if (!*n && (*t == ' ' || *t == '\t' || *t == ':')) return t;
    while (*s && *s != '\n') s++;
    if (*s) s++;
  }
  return 0;
}

static int gpio_init(void) {
  int fd = ix_open("/dev/gpiomem", ix_O_RDWR | ix_O_SYNC | ix_O_CLOEXEC, 0);
  if (fd < 0) return 0;
  volatile uint32_t *regs = ix_mmap(0, 4096, ix_PROT_READ | ix_PROT_WRITE, ix_MAP_SHARED, fd, 0);
  ix_close(fd);
  if ((intptr_t)regs < 0 && (intptr_t)regs > -4096) return 0;

  unsigned revision = 0, part = 0;
  fd = ix_open("/proc/cpuinfo", ix_O_RDONLY | ix_O_CLOEXEC, 0);
  if (fd >= 0) {
    int got = 0, r;
    while (got < (int)sizeof cpuinfo - 1 && (r = ix_read(fd, cpuinfo + got, sizeof cpuinfo - 1 - got)) > 0) got += r;
    cpuinfo[got > 0 ? got : 0] = 0;
    ix_close(fd);
    const char *f = field("Revision");
    if (f) revision = hexval(f);
    f = field("CPU part");
    if (f) part = hexval(f);
  }
  bcm2711 = part == 0xD08;

  /* the pins the board brings out (BCM2835 HAL's table, new-style codes):
     the 40-pin header's GPIO 0-27; a Compute Module 3 or 3+ all of them;
     a Compute Module 4 GPIO 2-27 */
  uint32_t usable0 = 0x0FFFFFFFu, usable1 = 0;
  if (revision & (1u << 23)) {
    unsigned type = (revision >> 4) & 0xFF;
    if (type == 0x0A || type == 0x10) usable0 = 0xFFFFFFFFu, usable1 = 0x3FFFu;
    else if (type == 0x14) usable0 = 0x0FFFFFFCu;
  }

  for (int i = 0; i < 2; i++) {
    struct gpio_device *d = &gpio[i];
    d->type = 0x0403;                 /* HALDeviceType_Comms | HALDeviceComms_GPIO */
    d->id = 2;                        /* HALDeviceID_GPIO_BCM2835 */
    d->location = 0x10000000;
    d->version = 0x10000;             /* API 1.0 */
    d->description = i ? "Raspberry Pi GPIO interface pins 32-63" : "Raspberry Pi GPIO interface pins 0-31";
    d->address = regs;
    d->activate = dev_activate;
    d->deactivate = dev_nothing;
    d->reset = dev_nothing;
    d->sleep = dev_sleep;
    d->devicenumber = -1;
    d->ports = 2;
    d->number = i;
    d->enumerate = gpio_enumerate;
    d->setdatabits = gpio_set;
    d->cleardatabits = gpio_clear;
    d->toggledatabits = gpio_toggle;
    d->readdatabits = gpio_read;
    d->datadirection = gpio_datadirection;
    d->readmode = gpio_readmode;
    d->writemode = gpio_writemode;
    d->pullcontrol = gpio_pullcontrol;
    d->pulldirection = gpio_pulldirection;
    d->edgecontrol = gpio_edgecontrol;
    d->edgepollstatus = gpio_edgepoll;
    d->usable = i ? usable1 : usable0;
    /* the pulls at reset (BCM2835 HAL's: they can't be read back) */
    d->pull_on = i ? 0x03FFCFFFu : (bcm2711 ? 0xFFFFFFFFu : 0xCFFFFFFFu);
    d->pull_up = i ? 0x03FFC01Cu : (bcm2711 ? 0x100001FFu : 0x000001FFu);
    d->pins = i ? pins_1 : (bcm2711 ? pins_bcm2711_0 : pins_bcm2837_0);
  }
  return 2;
}

/* HAL_InitDevices adds GPIO_Device(0), GPIO_Device(1), ... up to the first
   0: the GPIO devices, none where there's no /dev/gpiomem */
struct gpio_device *GPIO_Device(int i) {
  static int n = -1;
  if (n < 0) n = gpio_init();
  return i >= 0 && i < n ? &gpio[i] : 0;
}
