/*
 * The GPIO HAL devices (HALDeviceComms_GPIO, HALDeviceID_GPIO_BCM2835, API
 * 1.0) on a Raspberry Pi 3 or 4, as RISC OS's own BCM2835 HAL has them:
 * Linux's /dev/gpiomem maps the board's GPIO registers, and each device's
 * Address is that mapping, so programs that use the registers or the
 * device's functions work as on RISC OS on the Pi. Two devices, pins 0-31
 * and 32-53. Only the pins the board brings out (the 40-pin header; all of
 * them on a Compute Module) can be changed. Elsewhere (no /dev/gpiomem:
 * other machines, QEMU, a Pi 5) there are no GPIO devices.
 *
 * The functions, the per-board pins and the pin descriptions (Enumerate's
 * tables) follow the BCM2835 HAL of RISC OS 5.30 (RISC OS Open, Apache
 * licence).
 */

#define ix_SYSCALL_branch 1
#include "ix/syscalls.h"

#include <stdbool.h>

extern void HAL_CounterDelay(unsigned int microseconds);

struct gpio_device {
  /* struct device */
  uint16_t type, id;
  uint32_t location, version;
  const char *description;
  volatile uint32_t *address;
  uint32_t reserved1[3];
  int (*activate)(struct gpio_device *);
  void (*deactivate)(struct gpio_device *);
  void (*reset)(struct gpio_device *);
  int (*sleep)(struct gpio_device *, int);
  int devicenumber;
  int (*testirq)(struct gpio_device *);
  void (*clearirq)(struct gpio_device *);
  uint32_t reserved2;
  /* API 1 */
  int ports, number;
  const uint32_t *(*enumerate)(struct gpio_device *, int *);
  uint32_t (*setdatabits)(struct gpio_device *, uint32_t);
  uint32_t (*cleardatabits)(struct gpio_device *, uint32_t);
  void (*toggledatabits)(struct gpio_device *, uint32_t);
  uint32_t (*readdatabits)(struct gpio_device *);
  uint32_t (*datadirection)(struct gpio_device *, uint32_t, uint32_t);
  int (*readmode)(struct gpio_device *, int);
  int (*writemode)(struct gpio_device *, int, int);
  uint32_t (*pullcontrol)(struct gpio_device *, uint32_t, uint32_t);
  uint32_t (*pulldirection)(struct gpio_device *, uint32_t, uint32_t);
  void (*edgecontrol)(struct gpio_device *, uint32_t, uint32_t *, uint32_t *, uint32_t *);
  uint32_t (*edgepollstatus)(struct gpio_device *, uint32_t);
  /* private: the pins that can be changed, the pulls (which can't be read
     back), the pin descriptions */
  uint32_t usable, pull_on, pull_up;
  const uint32_t *pins;
};

#define GPFSEL   0x00
#define GPSET    0x1C
#define GPCLR    0x28
#define GPLEV    0x34
#define GPEDS    0x40
#define GPREN    0x4C
#define GPFEN    0x58
#define GPHEN    0x64
#define GPLEN    0x70
#define GPPUD    0x94      /* BCM2835-7 */
#define GPPUDCLK 0x98
#define GPPUPPDN 0xE4      /* BCM2711 */

#define REG(d, off) ((d)->address[(off) / 4])

