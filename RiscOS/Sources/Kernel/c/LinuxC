#define mmap(a, b, c, d, e, f) ((ix_mmap)((void *)(a), b, c, d, e, f))
#define munmap(a, b) ((ix_munmap)((void *)(a), b))

struct DANode {
  struct DANode *Link;    // points to next node
  uint32_t Number;        // number of this area
  char    *Base;          // base address of area (points in middle of doubly-mapped areas)
  uint32_t Flags;         // various flags
  uint32_t Size;          // current size of area (not counting holes, if Sparse area)
  uint32_t MaxSize;       // maximum size of area
  uint32_t Workspace;     // workspace pointer when calling handlers
  void (*Handler)();      // pointer to handler routine for area
  char    *Title;         // pointer to area title
  uint32_t SubLink;       // next node in any disjoint sublist (currently used for Shrinkables only)
  uint32_t SparseHWM;     // high water mark, if Sparse area (highest base+size claimed for area)
  struct DANode *SortLink;// next node in alphabetically sorted list
  uint32_t PMP;           // pointer to physical memory pool - zero if not PMP or has been resized to zero
  uint32_t PMPSize;       // number of pages currently in phys pool
  uint32_t PMPMaxSize;    // size of phys memory pool, in pages

  int File;
};

#define AplWorkSize (AppSpaceDANode.Size)
#define AplWorkMaxSize (AppSpaceDANode.MaxSize)

#define PageSize 0x1000

// Non APCS routines called by inline assembler.
extern void CheckAppSpace(void);
extern void VariformInternal(void);

#define MY_PROT (ix_PROT_READ | ix_PROT_WRITE | ix_PROT_EXEC)
#define MY_MAP (ix_MAP_PRIVATE | ix_MAP_ANONYMOUS | ix_MAP_FIXED)
#define PID_LENGTH 12

// The free pool: memory comes from Linux as it's used, so there is no real
// pool of pages. It starts as RISC OS's RAM size (RAMLIMIT, which the HAL
// has from Linux) and is a count, in pages, of what isn't in use: growing
// application space, a dynamic area or a Wimp slot takes from it (as much
// as it has), shrinking or freeing gives back. The Task Manager's "Free"
// shows it.
static uint32_t free_take(uint32_t pages) {
  uint32_t have = FreePoolDANode.PMPSize;
  if (pages > have) pages = have;
  FreePoolDANode.PMPSize = have - pages;
  return pages;
}

static void free_give(uint32_t pages) {
  FreePoolDANode.PMPSize += pages;
  if (FreePoolDANode.PMPSize > FreePoolDANode.PMPMaxSize)
    FreePoolDANode.PMPSize = FreePoolDANode.PMPMaxSize;
}

static inline uint32_t get_file_size(int fd) {
  struct ix_stat s;
  ix_fstat(fd, &s);
  return s.st_size;
}

int MakeTempFile(const char *mem_name) {

  // First try the new in Linux 3.17 system call memfd_create()
  int fd = ix_memfd_create(mem_name ? mem_name : "RISC OS", ix_MFD_CLOEXEC);
  if (fd != -ix_ENOSYS) return fd;

  // If that doesn't exist use the traditional way...
  static const char prefix[] = "/dev/shm/RISC OS #";
  char name[sizeof(prefix) + PID_LENGTH];
  char *n = name;

  // Copy prefix
  const char *p = prefix;
  while (*p) *n++ = *p++;

  // Use PID as suffix.
  unsigned pid = ix_getpid();

  __asm {
        MOV     r0, &pid          // Input
        MOV     r1, n             // Output buffer
        MOV     r2, #PID_LENGTH   // Buffer size
        MOV     r3, #4            // Input size in bytes
        MOV     r4, #1            // Convert as cardinal
        BL      VariformInternal, {r0-r4}, {}, {r0-r2, r10-r12, lr, psr}
  }

  fd = ix_open(name, ix_O_RDWR | ix_O_CLOEXEC | ix_O_CREAT | ix_O_EXCL | ix_O_NOFOLLOW, 0700);
  if (fd >= 0) ix_unlink(name);

  return fd;
}

#define CALL_HANDLER(...)           \
        MOV     r2, pages;          \
        MOV     r3, amount;         \
        MOV     r4, da->Size;       \
        MOV     r5, PageSize;      \
        MOV     r12, da->Workspace; \
        BLX     da->Handler, {r0, r2, r3, r4, r5, r12}, {__VA_ARGS__}

struct MMresult {
  uint32_t error;
  int amount;
};

__value_in_regs struct MMresult do_MoveMemory(uint32_t number, int amount, struct DANode* restrict da1) {
  struct MMresult result;
  struct DANode *da = da1;

  result.error = 0;
  int fudge = 0;

  if (da1 == &FreePoolDANode) {
    // Requests to adjust the free pool actually mean the application space
    da = &AppSpaceDANode;
    amount = -amount;
  }

  if (da == &AppSpaceDANode) {

    fudge = 0x8000;

    // Check if the app approves
    __asm {
        MOV     r0, number
        MOV     r10, amount
        BL      CheckAppSpace, {r0, r10}, {r0, psr}
        MOVVS   result.error, r0
        BVS     error
    }
  }

  // PMP areas change size with OS_DynamicArea 21-23 only
  if (da->Flags & DynAreaFlags_PMP) goto error;

  uint32_t Size = da->Size - fudge;

  if (amount > 0) {

    // Clamp amount to maxinum area size.
    if (amount > da->MaxSize - da->Size) amount = da->MaxSize - da->Size;

    // and to the memory there is (the free pool)
    if ((uint32_t) amount / PageSize > FreePoolDANode.PMPSize) amount = FreePoolDANode.PMPSize * PageSize;
    if (amount <= 0) goto error;

    // Call the handler
    int pages = amount / PageSize;
    if (da->Handler) {
      __asm {
        MOV     r0, #DAHandler_PreGrow
        CALL_HANDLER(r0, psr)
        MOVVS   result.error, r0
        BVS     error
      }
    }

    // Work out new area size.
    uint32_t newSize = da->Size + amount;

    // Is it backed by a Linux file?
    if (da->File >= 0) {

      // Grow the file.
      if (ix_ftruncate(da->File, newSize - fudge)) goto error;

      // Is it doublely mapped?
      if (da->Flags & DynAreaFlags_DoublyMapped) {

        // If so move and extend bottom mapping.
        if (mmap(da->Base - newSize, newSize, MY_PROT, ix_MAP_SHARED | ix_MAP_FIXED, da->File, 0) != da->Base - newSize) goto error;
      }

    } else {

      // Extend the mapping.
      if (mmap(da->Base + da->Size, amount, MY_PROT, MY_MAP, -1, 0) != da->Base + da->Size) goto error;
    }

    // Store new size
    da->Size = newSize;
    free_take(amount / PageSize);

    // Reentry permitted.
    CDASemaphore = 0;

    // Call the handler
    if (da->Handler) __asm {
        MOV     r0, #DAHandler_PostGrow
        CALL_HANDLER(psr)
    }

  } else {

    // Make amount positive.
    amount = -amount;

    // Clamp amount to area size.
    if (amount > da->Size - fudge) amount = da->Size - fudge;

    // Out if nothing to move.
    if (amount == 0) goto error;

    // Call the handler
    if (da->Handler) {
      int pages = amount / PageSize;
      __asm {
        MOV     r0, #DAHandler_PreShrink
        CALL_HANDLER(r0, r3, psr)
        MOV     amount, r3
        MOVVS   result.error, r0
        BVS     error
      }
    }

    // Page align amount again.
    amount = (amount + (PageSize - 1)) & ~(PageSize - 1);

    // Out if nothing to move.
    if (amount <= 0) goto error;

    uint32_t newSize = da->Size - amount;

    // Is it doublely mapped?
    if (da->Flags & DynAreaFlags_DoublyMapped) {

      // Move the bottom mapping up
      if (mmap(da->Base - newSize, newSize, MY_PROT, ix_MAP_SHARED | ix_MAP_FIXED, da->File, 0) != da->Base - newSize) goto error;

      // Remove the start of the bottom mapping.
      mmap(da->Base - da->Size, amount, ix_PROT_NONE, MY_MAP | ix_MAP_NORESERVE, -1, 0);
    }

    // Is it backed by a Linux file?
    if (da->File >= 0) {

      // Truncate file
      ix_ftruncate(da->File, newSize - fudge);

    } else {

      // remove the end of the area
      mmap(da->Base + newSize, amount, ix_PROT_NONE, MY_MAP | ix_MAP_NORESERVE, -1, 0);

    }

    // Store new size
    da->Size = newSize;
    free_give(amount / PageSize);

    // Reentry permitted.
    CDASemaphore = 0;


    // Call the handler
    int pages = amount / PageSize;
    if (da->Handler) __asm {
        MOV     r0, #DAHandler_PostShrink
        CALL_HANDLER(psr)
    }

    // Renegate the amount for Service_MemoryMoved
    amount = -amount;

  }

  // If application space changed record it.
  if (da == &AppSpaceDANode) {
    MemLimit = da->Size;
    if (da->File >= 0) AMBControl_ws[da->File] = (da->Size - 0x8000) / PageSize;
  }

  // If free pool requested reinvert amount.
  if (da1 == &FreePoolDANode) amount = -amount;

  result.amount = amount;
  return result;

error:
  CDASemaphore = 0;
  result.amount = 0;
  return result;
}

struct result {
  int r0, r1, r2, r3;
};

__value_in_regs struct result do_DynArea_AlterFile(int r0, int r1, int fd, struct DANode* restrict da) {
  struct result r = {r0, r1, fd, da->File};

  if (fd >= 0) {
    da->Size =  get_file_size(fd); // FIXME Check with handler?

    if (mmap(da->Base, da->MaxSize, MY_PROT, ix_MAP_SHARED | ix_MAP_FIXED, fd, 0) == da->Base) {
      da->File = fd;
      if (da->Flags & DynAreaFlags_DoublyMapped) {
        mmap(da->Base - da->Size, da->Size, MY_PROT, ix_MAP_SHARED | ix_MAP_FIXED, fd, 0);
        mmap(da->Base - da->MaxSize, da->MaxSize -da->Size, ix_PROT_NONE, MY_MAP | ix_MAP_NORESERVE, -1, 0);
      }
    } else {
      // FIXME Error
    }
  }
  return r;
}

void Init_MapInRAM_Linux(void* addr, int permissions, unsigned length) {
  if (mmap(addr, length, MY_PROT, ix_MAP_FIXED | ix_MAP_PRIVATE | ix_MAP_ANONYMOUS, -1, 0) != addr) {
    ix_MESSAGE(2, "Memory mapping failed, try running \"sudo sysctl vm.mmap_min_addr=12288\"\n");
    ix_exit(101);
  }
}

static void do_IMB_part(void *start, void *end, char *start2, uint32_t size2) {
  if (start2 > start) start = start2;
  if ((start2 + size2) < end) end = start2 + size2;
  if (start < end) ix_cacheflush(start, end, 0);
}

void do_IMB(unsigned unused, void *start, void *end) {
  (void)unused;
  do_IMB_part(start, end, (void *)ZeroPage, 0x4000);
  do_IMB_part(start, end, (void *)ScratchSpace, ScratchSpaceSize);
  do_IMB_part(start, end, (void *)0x8000, AplWorkSize - 0x8000);
  do_IMB_part(start, end, (void *)CursorChunkAddress, TopOfDMAWorkSpace - CursorChunkAddress);

  struct DANode* i = DAList;
  while(i) {
    do_IMB_part(start, end, i->Base, i->Size);
    i = i->Link;
  }
}

__value_in_regs struct result do_AMBControlSWI(int reason, int r1, int handle, int r3, int r4) {
  uintptr_t max = AplWorkMaxSize - 0x8000;

  switch (reason) {
    case 0: {
      handle = MakeTempFile("Wimp Slot");
      uintptr_t size = r1 * PageSize;
      if (size > max) {
        size = max;
        r1 = max / PageSize;
      }
      r1 = free_take(r1);
      size = r1 * PageSize;
      AMBControl_ws[handle] = r1;
      ix_ftruncate(handle, size);
      mmap(0x8000, max, MY_PROT, ix_MAP_SHARED | ix_MAP_FIXED, handle, 0);
      AppSpaceDANode.File = handle;
      MemLimit = AplWorkSize = size + 0x8000;
      break;
    }
    case 1:
      free_give(AMBControl_ws[handle]);
      ix_ftruncate(handle, 0);
      ix_close(handle);
      AMBControl_ws[handle] = 0;
      if (AppSpaceDANode.File == handle) {
        mmap(0x8000, max, ix_PROT_NONE, MY_MAP | ix_MAP_NORESERVE, -1, 0);
        MemLimit = AplWorkSize = 0x8000;
        AppSpaceDANode.File = -1;
      }
      break;
    case 2: {
      r3 = AMBControl_ws[handle];
      uintptr_t size = r1 * PageSize;
      if (size > max) {
        size = max;
        r1 = max / PageSize;
      }
      if ((uint32_t) r1 > (uint32_t) r3)
        r1 = r3 + free_take(r1 - r3);
      else
        free_give(r3 - r1);
      size = r1 * PageSize;
      AMBControl_ws[handle] = r1;
      ix_ftruncate(handle, size);
      if (AppSpaceDANode.File == handle) {
        MemLimit = AplWorkSize = size + 0x8000;
      }
      break;
    }
    case 3:
      if (r1 == -1) {
        mmap(0x8000, max, ix_PROT_NONE, MY_MAP | ix_MAP_NORESERVE, -1, 0);
        MemLimit = AplWorkSize = 0x8000;
        AppSpaceDANode.File = -1;
      } else {
        uintptr_t size = get_file_size(handle);
        mmap(0x8000, max, MY_PROT, ix_MAP_SHARED | ix_MAP_FIXED, handle, 0);
        AppSpaceDANode.File = handle;
        MemLimit = AplWorkSize = 0x8000 + size;
      }
      break;
    case 0x103:
      if (r1 != -1) mmap((r1 ? r1 : 0x8000), r4 * PageSize, MY_PROT, ix_MAP_SHARED | ix_MAP_FIXED, handle, r3 * PageSize);
      break;
    case 4:
      ix_MESSAGE(2, "AMBControl_SWI 4\n");
      r1 = AppSpaceDANode.File == handle ? 0x8000 : -1;
      r3 = AMBControl_ws[handle];
      break;
    default:
      ix_MESSAGE(2, "Bad AMBControl_SWI\n");
      ix_exit(2);
      break;
  }
  struct result r = {reason, r1, handle, r3};
  return r;
}

struct AplSpaceLimit_result {
  const void *error;
  uintptr_t limit;
};

extern const char ErrorBlock_BadParameters[];
extern const char ErrorBlock_OverlappingAreas[];

__value_in_regs struct AplSpaceLimit_result do_DynArea_AplSpaceLimit(const void *r0, uintptr_t limit) {
  struct AplSpaceLimit_result result;
  result.error = r0;
  result.limit = AplWorkMaxSize;
  if (limit && limit != result.limit) {
    if ((limit << (sizeof(limit) * 8 - 12)) || limit < 0x8000 + PageSize) {
      result.error = ErrorBlock_BadParameters;
      return result;
    }
    if (limit > result.limit) {
      uintptr_t new = (uintptr_t)mmap(result.limit, limit - result.limit, MY_PROT, ix_MAP_SHARED | ix_MAP_FIXED_NOREPLACE, AppSpaceDANode.File, result.limit - 0x8000);
      if (new != result.limit) {
        munmap(new, limit - result.limit);
        result.error = ErrorBlock_OverlappingAreas;
        return result;
      }
    } else {
      for(int i = MaxInterrupts - 1; i > 0; --i) {
        if ((limit - 0x8000) / PageSize < AMBControl_ws[i]) {
          result.error = ErrorBlock_OverlappingAreas;
          return result;
        }
      }
      munmap(limit, result.limit - limit);
    }
  }
  AplWorkMaxSize = limit;
  return result;
}

/*
 * Physical memory pool (PMP) dynamic areas (OS_DynamicArea 21-25).
 *
 * RISC OS on Linux has no physical pages, so a PMP area's pool is a Linux
 * memory file (memfd, kept in DANode_File): pool page n is file page n,
 * and "mapping" pool page n at area page l maps that file page there. The
 * kernel's array (DANode_PMP: a word per pool page, its physical page
 * number or -1) holds made-up physical page numbers (PMP_PHYS_BASE + n,
 * or the one asked for), and one more word after the last points to this
 * file's records for the area (struct pmp_rec, in memory from Linux):
 * which area page each pool page is at and the reverse. Claimed pages
 * come from the free pool (free_take), so the Task Manager's free memory
 * stays right. The area's size is reported as its whole logical size
 * (the port checks addresses against base + size; there are no sparse
 * areas), and SparseHWM covers the highest page mapped, for removal.
 */

#define PMP_PHYS_BASE 0x00400000u
#define PMP_NONE      0xFFFFFFFFu
#define FALLOC_PUNCH_HOLE_KEEP_SIZE 3

struct pmp_rec {
  uint32_t bytes;       // size of this record (Linux memory)
  uint32_t pcap;        // pool pages log[] has room for
  uint32_t lpages;      // area pages
  int32_t *log;         // per pool page: area page, or -1
  int32_t *pool;        // per area page: pool page, or -1
};

struct pmp_entry { uint32_t a, b, c; };

extern void *pmp_heap_claim(uint32_t bytes);
extern void pmp_heap_free(void *block);

static struct pmp_rec *pmp_rec_alloc(uint32_t pcap, uint32_t lpages) {
  uint32_t bytes = (sizeof(struct pmp_rec) + 4 * (pcap + lpages) + PageSize - 1) & ~(PageSize - 1);
  struct pmp_rec *p = mmap(0, bytes, ix_PROT_READ | ix_PROT_WRITE, ix_MAP_PRIVATE | ix_MAP_ANONYMOUS, -1, 0);
  uint32_t i;
  if ((uint32_t)p >= (uint32_t)-4096) return 0;
  p->bytes = bytes;
  p->pcap = pcap;
  p->lpages = lpages;
  p->log = (int32_t *)(p + 1);
  p->pool = p->log + pcap;
  for (i = 0; i < pcap + lpages; ++i) p->log[i] = -1;
  return p;
}

// The area's records (made the first time, with its memory file), or 0.
static struct pmp_rec *pmp_get(struct DANode *da) {
  uint32_t *phys = (uint32_t *)da->PMP;
  struct pmp_rec *p;
  if (!phys) return 0;
  if (phys[da->PMPMaxSize] != PMP_NONE) return (struct pmp_rec *)phys[da->PMPMaxSize];
  if (da->File < 0) {
    int fd = MakeTempFile("RISC OS PMP");
    if (fd < 0) return 0;
    if (ix_ftruncate(fd, 0)) { ix_close(fd); return 0; }
    da->File = fd;
  }
  p = pmp_rec_alloc(da->PMPMaxSize, da->MaxSize / PageSize);
  if (!p) return 0;
  phys[da->PMPMaxSize] = (uint32_t)p;
  return p;
}

// The file holds the pool's pages: as many as there are pool pages.
static int pmp_file_size(struct DANode *da, uint32_t pages) {
  if (pages >= 0x80000) pages = 0x7FFFF;     // ix_off_t is 32-bit signed
  return ix_ftruncate(da->File, pages * PageSize);
}

static void pmp_unmap(struct DANode *da, struct pmp_rec *p, uint32_t l) {
  int32_t q = p->pool[l];
  if (q < 0) return;
  mmap(da->Base + l * PageSize, PageSize, ix_PROT_NONE, MY_MAP | ix_MAP_NORESERVE, -1, 0);
  p->pool[l] = -1;
  p->log[q] = -1;
}

static void pmp_sync(struct DANode *da) {
  da->Size = da->MaxSize;
}

// PhysOp (21): r2 -> {pool page, phys page (-1 release, -2 any), flags}
const void *do_PMP_PhysOp(struct DANode *da, uint32_t *r2r3) {
  struct pmp_entry *e = (struct pmp_entry *)r2r3[0];
  uint32_t *phys = (uint32_t *)da->PMP;
  struct pmp_rec *p = pmp_get(da);
  const void *err = 0;
  if (!p) return r2r3[1] ? ErrorBlock_BadParameters : 0;
  if (pmp_file_size(da, da->PMPMaxSize)) return ErrorBlock_BadParameters;
  for (; r2r3[1]; --r2r3[1], ++e) {
    uint32_t q = e->a;
    if (q >= da->PMPMaxSize) { err = ErrorBlock_BadParameters; break; }
    if (e->b == PMP_NONE) {
      if (phys[q] != PMP_NONE) {
        if (p->log[q] >= 0) pmp_unmap(da, p, p->log[q]);
        ix_fallocate(da->File, FALLOC_PUNCH_HOLE_KEEP_SIZE, q * PageSize, PageSize);
        phys[q] = PMP_NONE;
        da->PMPSize--;
        free_give(1);
      }
    } else if (phys[q] == PMP_NONE) {
      if (!free_take(1)) { err = ErrorBlock_BadParameters; break; }
      phys[q] = e->b == 0xFFFFFFFEu ? PMP_PHYS_BASE + q : e->b;
      da->PMPSize++;
    }
  }
  r2r3[0] = (uint32_t)e;
  pmp_sync(da);
  return err;
}

// LogOp (22): r2 -> {area page, pool page (-1 unmap), flags}
const void *do_PMP_LogOp(struct DANode *da, uint32_t *r2r3) {
  struct pmp_entry *e = (struct pmp_entry *)r2r3[0];
  uint32_t *phys = (uint32_t *)da->PMP;
  struct pmp_rec *p = pmp_get(da);
  const void *err = 0;
  if (!p) {
    // nothing in the pool, so nothing mapped: unmapping is all there is
    for (; r2r3[1]; --r2r3[1], ++e) if (e->b != PMP_NONE) { err = ErrorBlock_BadParameters; break; }
    r2r3[0] = (uint32_t)e;
    return err;
  }
  for (; r2r3[1]; --r2r3[1], ++e) {
    uint32_t l = e->a, q = e->b;
    char *a;
    if (l >= p->lpages) { err = ErrorBlock_BadParameters; break; }
    if (q == PMP_NONE) { pmp_unmap(da, p, l); continue; }
    if (q >= da->PMPMaxSize || phys[q] == PMP_NONE) { err = ErrorBlock_BadParameters; break; }
    if (p->log[q] >= 0 && p->log[q] != (int32_t)l) pmp_unmap(da, p, p->log[q]);
    a = da->Base + l * PageSize;
    // bit 15 (PageFlags_Unavailable): mapped but not accessible
    if (ix_mmap2(a, PageSize, (e->c & (1u << 15)) ? ix_PROT_NONE : MY_PROT,
                 ix_MAP_SHARED | ix_MAP_FIXED, da->File, q) != a) {
      err = ErrorBlock_BadParameters;
      break;
    }
    if (p->pool[l] >= 0 && p->pool[l] != (int32_t)q) p->log[p->pool[l]] = -1;
    p->pool[l] = q;
    p->log[q] = l;
    if ((uint32_t)a + PageSize > da->SparseHWM) da->SparseHWM = (uint32_t)a + PageSize;
  }
  r2r3[0] = (uint32_t)e;
  pmp_sync(da);
  return err;
}

// OS_Memory 24 (s.MemInfo CheckMemoryAccess, which has no page tables to
// check here): the first run of mapped pages of PMP area da at or after
// address from. Returns its start, or 0 if there is none; *end = its end.
uint32_t pmp_next_run(struct DANode *da, uint32_t from, uint32_t *end) {
  uint32_t *phys = (uint32_t *)da->PMP;
  struct pmp_rec *p;
  uint32_t base = (uint32_t)da->Base, l, start;
  if (!phys || phys[da->PMPMaxSize] == PMP_NONE) return 0;
  p = (struct pmp_rec *)phys[da->PMPMaxSize];
  l = from <= base ? 0 : (from - base) / PageSize;
  while (l < p->lpages && p->pool[l] < 0) ++l;
  if (l >= p->lpages) return 0;
  start = l;
  while (l < p->lpages && p->pool[l] >= 0) ++l;
  *end = base + l * PageSize;
  return base + start * PageSize;
}

// Resize (23): r2 = change in pool pages -> r2 = pages changed by
const void *do_PMP_Resize(struct DANode *da, uint32_t *r2) {
  uint32_t old = da->PMPMaxSize, want, i;
  int32_t change = (int32_t)r2[0];
  uint32_t *phys = (uint32_t *)da->PMP;
  struct pmp_rec *p = phys ? pmp_get(da) : 0;
  if (phys && !p) return ErrorBlock_BadParameters;
  if (change < 0) {
    // only unclaimed pages at the top can go
    want = (uint32_t)-change > old ? 0 : old + change;
    while (old > want && phys[old - 1] == PMP_NONE) {
      phys[old - 1] = p ? (uint32_t)p : PMP_NONE;   // the records move down a word
      phys[old] = PMP_NONE;
      --old;
    }
    r2[0] = da->PMPMaxSize - old;
    da->PMPMaxSize = old;
    if (p) pmp_file_size(da, old);
    return 0;
  }
  if (change == 0) { r2[0] = 0; return 0; }
  want = old + change;
  {
    uint32_t *nphys = pmp_heap_claim((want + 1) * 4);
    struct pmp_rec *np;
    if (!nphys) return ErrorBlock_BadParameters;
    for (i = 0; i < old; ++i) nphys[i] = phys[i];
    for (; i <= want; ++i) nphys[i] = PMP_NONE;
    if (!p) {
      // the first pool pages: make the records now
      da->PMP = (uint32_t)nphys;
      da->PMPMaxSize = want;
      if (phys) pmp_heap_free(phys);
      np = pmp_get(da);
      if (!np) return ErrorBlock_BadParameters;
    } else {
      if (want > p->pcap) {
        np = pmp_rec_alloc(want + want / 4, p->lpages);
        if (!np) { pmp_heap_free(nphys); return ErrorBlock_BadParameters; }
        for (i = 0; i < old; ++i) np->log[i] = p->log[i];
        for (i = 0; i < p->lpages; ++i) np->pool[i] = p->pool[i];
        munmap(p, p->bytes);
      } else {
        np = p;
      }
      nphys[want] = (uint32_t)np;
      da->PMP = (uint32_t)nphys;
      da->PMPMaxSize = want;
      pmp_heap_free(phys);
    }
  }
  r2[0] = want - old;
  return 0;
}

// GetPages (25): r2 -> {pool page, phys page, area page, flags}, one of
// the first three given, the others -1
void do_PMP_GetPages(struct DANode *da, uint32_t *e, uint32_t n) {
  uint32_t *phys = (uint32_t *)da->PMP;
  struct pmp_rec *p = phys ? pmp_get(da) : 0;
  for (; n; --n, e += 4) {
    int32_t q = -1;
    if (e[0] != PMP_NONE) {
      q = e[0] < da->PMPMaxSize ? (int32_t)e[0] : -1;
    } else if (e[2] != PMP_NONE) {
      q = p && e[2] < p->lpages ? p->pool[e[2]] : -1;
    } else if (e[1] != PMP_NONE && phys) {
      uint32_t i;
      for (i = 0; i < da->PMPMaxSize; ++i) if (phys[i] == e[1]) { q = i; break; }
    }
    if (q < 0 || !phys || phys[q] == PMP_NONE) {
      if (q >= 0) { e[0] = q; e[1] = PMP_NONE; e[2] = PMP_NONE; }
      e[3] = 0;
      continue;
    }
    e[0] = q;
    e[1] = phys[q];
    e[2] = p ? (uint32_t)p->log[q] : PMP_NONE;
    e[3] = (da->Flags & 0xFF) | DynAreaFlags_PMP;
  }
}

// When the area goes (DAR_delink): its records' memory
void do_PMP_Free(struct DANode *da) {
  uint32_t *phys = (uint32_t *)da->PMP;
  if ((da->Flags & DynAreaFlags_PMP) && phys && phys[da->PMPMaxSize] != PMP_NONE) {
    struct pmp_rec *p = (struct pmp_rec *)phys[da->PMPMaxSize];
    phys[da->PMPMaxSize] = PMP_NONE;
    munmap(p, p->bytes);
  }
}
