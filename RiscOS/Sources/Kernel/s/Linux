LinuxReadTime
        Push    "r1, r3, r7, lr"
        SUB     sp, sp, #8
        MOV     r7, #__NR_gettimeofday
        MOV     r0, sp
        MOV     r1, #0
        BL      __PVirt_LinuxSyscall

        LDR     r3, =-776530087
        LDR     r0, [sp, #4]
        MOV     r2, #0
        UMULL   r1, r0, r3, r0
        MOV     r3, #100
        LDR     r7, [sp], #8
        MOV     r0, r0, lsr #13
        UMLAL   r0, r2, r3, r7
        LDR     r1, =&6E996A00
        ADDS    r0, r0, r1
        ADC     r2, r2, #&33
        Pull    "r1, r3, r7, pc"

