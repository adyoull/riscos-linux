;**************************************************************************
;
; Physical memory pool (PMP) areas, OS_DynamicArea 21-25: done in c.LinuxC
; (do_PMP_*), with a Linux memory file for each area's pool. In: r0 reason,
; r1 area number, r2/r3 as the reason code says; out as RISC OS's kernel:
; r2, r3 updated (PhysOp, LogOp), r2 = pages changed by (Resize), r10-r12
; may be corrupted; V set and r0 -> error if not all done.

DynArea_PMP_PhysOp
        Push    "r0-r3, r11, lr"
        BL      PMP_Node
        BVS     PMP_Error
        MOV     r0, r10
        ADD     r1, sp, #2*4                    ; the saved r2, r3
        BL      do_PMP_PhysOp
        B       PMP_Exit

DynArea_PMP_LogOp
        Push    "r0-r3, r11, lr"
        BL      PMP_Node
        BVS     PMP_Error
        MOV     r0, r10
        ADD     r1, sp, #2*4
        BL      do_PMP_LogOp
        B       PMP_Exit

DynArea_PMP_Resize
        Push    "r0-r3, r11, lr"
        BL      PMP_Node
        BVS     PMP_Error
        MOV     r0, r10
        ADD     r1, sp, #2*4                    ; the saved r2
        BL      do_PMP_Resize
        B       PMP_Exit

DynArea_PMP_GetPages
        Push    "r0-r3, r11, lr"
        BL      PMP_Node
        BVS     PMP_Error
        MOV     r0, r10
        LDR     r1, [sp, #2*4]
        LDR     r2, [sp, #3*4]
        BL      do_PMP_GetPages
        MOV     r0, #0

PMP_Exit
        TEQ     r0, #0
        BNE     PMP_Error
        Pull    "r0-r3, r11, lr"
        CLRV
        MOV     pc, lr

PMP_Error
 [ International
        BL      TranslateError
 ]
        STR     r0, [sp]
        Pull    "r0-r3, r11, lr"
        SETV
        MOV     pc, lr

; In: r1 = area number. Out: r10 -> its node, or V set and r0 -> error (no
; such area, or not a PMP area)
PMP_Node
        Push    "lr"
        BL      QCheckAreaNumber
        LDRCC   r0, =ErrorBlock_BadDynamicArea
        BCC     %FT90
        LDR     lr, [r10, #DANode_Flags]
        TST     lr, #DynAreaFlags_PMP
        LDREQ   r0, =ErrorBlock_BadParameters
        BEQ     %FT90
        CLRV
        Pull    "pc"
90      SETV
        Pull    "pc"

