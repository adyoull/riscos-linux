REM > PS2Test3
REM This program tests the mapping from PS/2 code to KeyV code
REM ...to be continued
lr=14
DIM buffer 1023, MC%1000, L%-1
FOR I%=8 TO 10 STEP 2
P%=MC%
[OPTI%
.mykeyv
          CMP       r0, #11
          ADDCC     pc, pc, r0, LSL #2
          MOV       pc, lr                        ; unknown reason - pass it on
          MOV       pc, lr                        ; reason 0 - keyboard present - pass it on
          B         keyup                         ; reason 1 - key up
          B         keydown                       ; reason 2 - key down
          B         setleds                       ; reason 3 - set LEDs
          MOV       pc, lr                        ; reason 4 - enable keyboard driver
          B         pseudo_enable                 ; reason 5 - pseudo enable
          B         pseudo_disable                ; reason 6 - pseudo disable
          B         pseudo_intmask                ; reason 7 - set pseudo interrupt mask
          MOV       pc, lr                        ; reason 8 - pseudo RXint
          MOV       pc, lr                        ; reason 9 - pseudo TXint
          MOV       pc, lr                        ; reason 10 - port info

.keyup
.keydown
          STMFD     r13!, {r2}
          MOV       r2, r0
          BL        insert
          MOV       r2, r1
          BL        insert
          LDMFD     r13!, {r2, pc}

.insert
          STMFD     r13!, {r0, lr}
          LDR       r0, insptr
          ADR       lr, buffer
          STR       r2, [lr, r0, LSL #2]
          ADD       r0, r0, #1
          AND       r0, r0, #255
          LDR       lr, remptr
          TEQ       r0, lr
          STRNE     r0, insptr
          LDMFD     r13!, {r0, pc}

.getword
          LDR       r0, insptr
          LDR       r2, remptr
          CMP       r0, r2
          MOVEQ     pc, lr                        ; exit CS if nothing in buffer
          ADR       r1, buffer
          LDR       r0, [r1, r2, LSL #2]
          ADDS      r2, r2, #1                    ; (clears C)
          AND       r2, r2, #255
          STR       r2, remptr
          MOV       pc, r14

.insptr   EQUD      0
.remptr   EQUD      0
]:NEXT
ON ERROR ON ERROR OFF:SYS"XOS_Release",6,bytev,0:REPORT:PRINT " at line ";ERL:END
SYS"OS_Claim",6,bytev,0
REPEAT
 B%=USRgetbyte
 IF B%<>-1 THEN PRINT " ";~FNH(B%);
UNTIL 0
END

DEF FNH(X%)=RIGHT$("0"+STR$~X%,2)
