REM > PS2Test1
REM This program is for use with the version of the PS2Driver module with the CaptureInput flag set to TRUE.
REM That version issues OS_Byte(163,255,byte) for each byte received from the PS/2 keyboard interface
REM This program prints out the values received
DIM buffer 255, MC%1000, L%-1
FOR I%=8 TO 10 STEP 2
P%=MC%
[OPTI%
.bytev
          TEQ       r0, #163
          TEQEQ     r1, #255
          MOVNE     pc, r14
          STMFD     r13!, {r0,r1}
          LDR       r0, insptr
          ADR       r1, buffer
          STRB      r2, [r1, r0]
          ADD       r0, r0, #1
          AND       r0, r0, #255
          LDR       r1, remptr
          TEQ       r0, r1
          STRNE     r0, insptr
          LDMFD     r13!, {r0,r1,pc}

.getbyte
          LDR       r0, insptr
          LDR       r2, remptr
          TEQ       r0, r2
          MVNEQ     r0, #0
          MOVEQ     pc, r14
          ADR       r1, buffer
          LDRB      r0, [r1, r2]
          ADD       r2, r2, #1
          AND       r2, r2, #255
          STR       r2, remptr
          MOV       pc, r14

.insptr   EQUD      0
.remptr   EQUD      0
]:NEXT
ON ERROR ON ERROR OFF:SYS"XOS_Release",6,bytev,0:REPORT:PRINT " at line ";ERL:END
SYS"OS_Claim",6,bytev,0
REPEAT
 B%=USRgetbyte
 IF B%<>-1 THEN PRINT " ";~FNH(B%);
UNTIL 0
END

DEF FNH(X%)=RIGHT$("0"+STR$~X%,2)
