/*
 * Name        : gnstate.c
 * Purpose     : Veneer for method TreeView_GetNodeState
 * Description : Returns a bitfield describing the state of the current node
 */


#include "kernel.h"
#include "toolbox.h"
#include "gadgets.h"
#include "treeview.h"




/*
 * Name        : treeview_get_node_state
 * Description : Returns a bitfield describing the state of the current node
 * In          : unsigned int flags
 *               ObjectId window
 *               ComponentId gadget
 * Out         : unsigned int *state
 * Returns     : pointer to error block
 */

extern _kernel_oserror *treeview_get_node_state ( unsigned int flags,
                                                  ObjectId window,
                                                  ComponentId gadget,
                                                  unsigned int *state
                                                )
{
_kernel_swi_regs r;
_kernel_oserror *e;

  r.r[0] = flags;
  r.r[1] = (int) window;
  r.r[2] = TreeView_GetNodeState;
  r.r[3] = (int) gadget;
  if((e = _kernel_swi(Toolbox_ObjectMiscOp,&r,&r)) == NULL)
  {
    if(state != NULL) *state = (unsigned int) r.r[0];
  }

  return(e);
}

