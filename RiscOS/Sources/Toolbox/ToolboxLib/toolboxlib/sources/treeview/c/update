/*
 * Name        : update.c
 * Purpose     : Veneer for method TreeView_UpdateDisplay
 * Description : Ensures the gadget's display is up to date
 */


#include "kernel.h"
#include "toolbox.h"
#include "gadgets.h"
#include "treeview.h"




/*
 * Name        : treeview_update_display
 * Description : Ensures the gadget's display is up to date
 * In          : unsigned int flags
 *               ObjectId window
 *               ComponentId gadget
 * Out         : None
 * Returns     : pointer to error block
 */

extern _kernel_oserror *treeview_update_display ( unsigned int flags,
                                                  ObjectId window,
                                                  ComponentId gadget
                                                )
{
_kernel_swi_regs r;

  r.r[0] = flags;
  r.r[1] = (int) window;
  r.r[2] = TreeView_UpdateDisplay;
  r.r[3] = (int) gadget;
  return(_kernel_swi(Toolbox_ObjectMiscOp,&r,&r));
}

