#define MODE_RD   0x20 /* Read, deny write to others */
#define MODE_WR   0x11 /* Write, deny read/write to others */
#define MODE_RDWR 0x12 /* Read/Write, deny read/write to others */

/* Note.
 *
 * As per the June 19 1990 document (doc vsn 1.11, prot vsn 3.0), the maximum value for this needs to be 4 + (maximum route name
 * length + 2)/2 for the TRANSACT2_FSCTL call (6.0.1.1.10, page 41).  However, TRANSACT2_IOCTL needs this to be 4 too, so it is
 * left at four for the moment.  You will get a debug output message if you try to add too many setup words.
 */
#define MAX_SETUPWORDS (4)

struct TransactParms {
  int parms_in_len;
  uint8_t *parms_in;
  int data_in_len;
  uint8_t *data_in;

  int parms_out_maxlen;
  uint8_t *parms_out_buf;
  int parms_out_len;

  int data_out_maxlen;
  uint8_t *data_out_buf;
  int data_out_len;
  /* WARNING:  These fields MUST lie at the end because LanManFS provides
   *           a SWI call which takes a pointer to one of these structures.
   *           The user structure is now copied to a local variable, the
   *           size of which is given by the #define just below.
   */
  int setup_in_len;
  uint16_t setup_in[MAX_SETUPWORDS];
  int setup_out_len;
  int setup_out_maxlen;
  uint16_t setup_out[MAX_SETUPWORDS];
};

#define sizeof_TransactParms_external (offsetof(struct TransactParms, setup_in_len))

/* Directory functions.  Every path is a DOS path whose "X:" prefix names the share by its drive letter. */

/* Create a directory.
 *
 * On an SMB2 mount a directory that already exists counts as success, so created reports whether the
 * directory is new and therefore empty.
 *
 * Parameters:
 *   path     DOS path of the directory
 *   created  receives true only if this call made the directory
 *
 * Returns: OK, or the error from the server or the share lookup.
 */
extern err_t SMB_MkDir(char *path, bool *created);

/* Delete an empty directory.
 *
 * Parameters:
 *   path  DOS path of the directory
 *
 * Returns: OK, or the error from the server or the share lookup.
 */
extern err_t SMB_RmDir(char *path);

/* Delete a file.
 *
 * On an SMB1 mount, hidden and system files are deleted only when LM_Vars.namemode includes NM_HIDDEN.  On an SMB2 mount
 * any file is deleted, so a caller wanting the same protection checks the file's attributes first, as CoreFn's DeleteObject does.
 *
 * Parameters:
 *   path         DOS path of the file
 *   link_itself  true to delete a symbolic link at the end of the path, false to delete the file it points to; an SMB1
 *                server follows links itself, so this matters only on an SMB2 mount
 *
 * Returns: OK, or the error from the server or the share lookup.
 */
extern err_t SMB_Delete(char *path, bool link_itself);

/* Rename a file or directory within one share.
 *
 * Renaming an object to its own name sends nothing and succeeds.  A hidden or system object is renamed only when
 * LM_Vars.namemode includes NM_HIDDEN, and is otherwise reported as not found.
 *
 * Parameters:
 *   oldpath  DOS path of the existing object
 *   newpath  DOS path it is to have, on the same drive letter
 *
 * Returns: OK, EBADRENAME if the paths name different shares, or the error from the server or the share lookup.
 */
extern err_t SMB_Rename(char *oldpath, char *newpath);

/* Read the attribute byte, length and modification time of a file or directory. */
extern err_t SMB_GetAttribs(char *filename, DOS_ATTRIBS *pAttr);

/* Read a symbolic link's own attribute byte, length and modification time, as SMB_GetAttribs does for its target.
 *
 * A link whose target is missing, absolute or outside the share can be read this way, so that it can be deleted or
 * renamed.  On an SMB2 mount, a path that does not end in a link gives the same result as SMB_GetAttribs.
 *
 * Parameters:
 *   filename  DOS path of the link
 *   pAttr     receives the attribute byte, length and modification time
 *
 * Returns: OK, EFILENOTFOUND if nothing matches (always on an SMB1 mount, whose server follows links itself and offers
 * no way to read one), or the error from the server or the share lookup.
 */
extern err_t SMB_GetLinkAttribs(char *filename, DOS_ATTRIBS *pAttr);

/* Set a file's attributes and modification time. */
extern err_t SMB_SetAttribs(char *filename, DOS_ATTRIBS *pAttr);

/* Read the entries of a directory, passing each one to a callback. */
extern err_t SMB_ReadDirEntries(char *path, int max_count, ENUM_DIR_FN dirfn, void *private, void *context);

/* Read the size and free space of a share. */
extern err_t SMB_GetFreeSpace(char lettr, struct disk_size_response *pDSR);

/* File functions */

/* Create a file, opening it for writing. */
extern err_t SMB_Create(char *filename, DOS_ATTRIBS *pInAttr, int *pOutFH);

/* Open a file, returning its handle, attributes and the access mode granted. */
extern err_t SMB_Open(int mode, char *filename, DOS_ATTRIBS *pOutAttr, int *pOutFH, int *pOutMode);

/* Return the length of an open file. */
extern err_t SMB_GetLength(int fh, uint *pOutLen);

/* Read data from an open file, using raw reads for large transfers if the server supports them. */
extern err_t SMB_Read(int fh, uint offset, uint len, uint8_t *where, uint *pOutLen);

/* Write data to an open file, using raw writes for large transfers if the server supports them. */
extern err_t SMB_Write(int fh, uint offset, uint len, uint8_t *where, uint *pOutLen);

/* Set the length of an open file, discarding its tail or extending it. */
extern err_t SMB_Truncate(int fh, uint length);

/* Flush an open file's buffered data to the server. */
extern err_t SMB_Flush(int fh);

/* Close an open file, setting its modification time. */
extern err_t SMB_Close(int fh, DOS_ATTRIBS *pAttr);

/* Printer functions */

/* Open a print job on a printer share, returning its handle. */
extern err_t SMB_OpenPrinter(char drvlettr, char *printid, int *ph_out);

/* Send data to a print job. */
extern err_t SMB_WritePrinter(int PH, uint8_t *data, int datalen);

/* Close a print job, letting the server print it. */
extern err_t SMB_ClosePrinter(int PH);

/* Transaction (RPC) functions */

/* Run a transaction on a named pipe of a connected share, such as IPC$ for the RAP calls. */
extern err_t SMB_Transact(char drvlettr, char *trans_name, struct TransactParms *pT);

/* Connect/disconnect functions */

/*
 * Connect a share, connecting to its server and logging on first if need be.
 *
 * A new server is logged on to with the names given, or with the *LMLogon names when both are blank.  On a server already connected,
 * CREATE_NEW_USER with a user name logs on again as that user, unless the server is logged on with that user name and password already;
 * logging on again disconnects the server and the server's other shares with it, which lose their open files.  In a build with the
 * cache, a disk share gets a cache of its own, its root dated now; one on an SMB1 mount or a server that is not Windows runs with the
 * aggressive-refresh quirk, which clamps its lifetimes, since change notification cannot be relied on there to report what other
 * clients do.
 *
 * Parameters:
 *   service_type     SHR_* kind of share
 *   style            CREATE_* flags
 *   serv_name        server name
 *   drv_name         share name
 *   user_name        user to log on as, or NULL
 *   passwd           password, or NULL
 *   share_lettr_out  returns the share's drive letter, also when ECONNEXISTS is returned
 *   mount_label      mount name for a disk share's cache, or NULL
 *
 * Returns: OK; ECONNEXISTS when CREATE_NEW_SHARE is given and the share is already connected; EBADPARAM for a missing name; EBADNAME
 * for a server or share name too long to hold; ECONNLIMIT when the server or share table is full; or the error from connecting.
 */
extern err_t SMB_CreateShare(int service_type, int style, char *serv_name, char *drv_name, char *user_name, char *passwd,
                             char *share_lettr_out, const char *mount_label);
#define SHR_DISK    0
#define SHR_PRINTER 1
#define SHR_COMM    2
#define SHR_IPC     3

#define CREATE_NORMAL    0
#define CREATE_NEW_SHARE 1
#define CREATE_NEW_USER  2

/* Disconnect a share, and its server too once no other share uses it. */
extern err_t SMB_DeleteShare(char share_lettr);

/* Count the shares disconnected since the module started.
 *
 * A mount name may name a different share once its share has gone, so a caller keeping anything keyed by a mount's path notes the count
 * and drops what it kept when the count has moved.
 *
 * Returns: the number of shares disconnected so far, wrapping at the top of its range.
 */
extern uint32_t SMB_DisconnectCount(void);

