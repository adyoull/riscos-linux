/* Timeouts */

/* Reply timeout, in cs: how long to wait for an SMB1 response frame before giving up.
 * A healthy SMB1 round trip takes well under a second, but a large write on a slow server can take several seconds, so the limit
 * is long enough for those and short enough that a dead server is noticed promptly.
 */
#define REPLY_TIMEOUT 1000

/* Timeout to put in 'Transact' params, in ms.  This is a hint sent on the wire to the server, not the local wait: it tells
 * the server how long the client allows the command to take.  It is set generously.
 */
#define TRANSACT_TIMEOUT  5000
#define TRANSACT2_TIMEOUT 10000

/* Startup/shutdown */

/* Mark every server and share slot free and prepare the fixed fields of the SMB1 request header.
 *
 * Returns: true always.
 */
extern bool SMB_Init(void);

/* Disconnect every share, and every server once its last share has gone.
 *
 * Returns: OK always.
 */
extern err_t SMB_Shutdown(void);

/* SMB_WorkBuf **** */

/* This is a temporary buffer, made public on the following strict conditions:
 *
 * (i) Its contents may become corrupted across any SMB_xxxx calls. The main exception is the SMB_Transact call: this buffer is
 * intended for use as the return parameter/data buffer.
 *
 * (ii) It must not be used by anything which may be called during an SMB call (transmit/receive processing functions, timer
 * callbacks, the directory-entry callbacks passed to SMB_ReadDirEntries and SMBFind_EnumDir). That means anything in NBIP and
 * NetBIOS.
 *
 * (iii) Any other C source file may use it freely. In general, it should be assumed corrupted across calls between modules.
 */
/* Need a much larger buffer */
#define SMBWORKBUF_SIZE 16384
#define SMBXMITMEM_SIZE SMBWORKBUF_SIZE
extern uint8_t SMB_WorkBuf[SMBWORKBUF_SIZE];

/* SMB2 protocol scratch buffer.
 *
 * Holds one in-flight SMB2 message; three of these live in the LanManFS module Dynamic Area: transmit, receive, and a
 * receive buffer reserved for directory listings.
 * READ, WRITE and QUERY_DIRECTORY size their payloads to fill the buffer and charge one credit per SMB2_CREDIT_UNIT of
 * it (MS-SMB2 section 3.2.4.1.5), shrinking the payload when fewer credits are in hand; see SMB2_Read and SMB2_Write.
 * SMB2_CREDIT_TARGET in h.SMB2Defs must be at least the 16 credits a full 1 MiB message charges, and preferably several
 * times that.
 *
 * The size is chosen at module init by Workspace_Init based on the machine's memory:
 *   - SMB2_WORKBUF_MAX (1 MiB) on machines with > 32 MiB of memory, for 16-credit READ/WRITE payloads and the fastest bulk
 *     transfer.
 *   - SMB2_WORKBUF_MIN (128 KiB) on machines with <= 32 MiB of memory, for 2-credit payloads, a modest bulk-transfer benefit
 *     while reclaiming 2.6 MiB of DA versus the maximum profile.
 *
 * Call sites read SMB2_WORKBUF_SIZE, which resolves to the runtime variable.  The variable defaults to SMB2_WORKBUF_MAX
 * so code that runs without Workspace_Init sees a usable size.
 */
#define SMB2_WORKBUF_MAX 1048576u
#define SMB2_WORKBUF_MIN 131072u

extern size_t smb2_workbuf_size;
#define SMB2_WORKBUF_SIZE smb2_workbuf_size

/* Credit unit: bytes per credit, fixed by the SMB2 specification.  Larger I/O charges proportionally more credits. */
#define SMB2_CREDIT_UNIT 65536

/* Report whether the share a DOS path names uses long filenames, so that Xlate can choose its name mapping.
 *
 * An SMB2 share always does; an SMB1 share does if the server negotiated long names.  The share is not connected.
 *
 * Parameters:
 *   path  DOS path whose "X:" prefix names the share
 *
 * Returns: true for a long-name share; false otherwise, including when no share has that drive letter.
 */
extern bool SMB_IsLongNameFS(const char *path);

/*
 * Report whether the share a DOS path names is connected over SMB2, so that Xlate keeps the "<xxxx" escapes only there.
 *
 * The call does not connect the share, so one that is not connected reports false.
 *
 * Parameters:
 *   path  DOS path whose first character is the share's drive letter
 *
 * Returns: true for a connected SMB2 share, otherwise false.
 */
extern bool SMB_IsSMB2FS(const char *path);

/*
 * Return the offset in seconds that turns the server's local time into UTC.
 *
 * Parameters:
 *   hS  share whose server is asked; NULL gives 0
 *
 * Returns: the offset in seconds, or 0 when there is no share.
 */
int SMB_GetCurrentServerTimeZone(hSHARE hS);

/* Return the share an open file handle belongs to, or NULL if the handle is not valid. */
hSHARE SMB_GetShareFileHandle(uint SMB_FH);

/* Return the share a DOS path names, connecting it if need be, or NULL if it cannot. */
hSHARE SMB_GetShareFileName(const char *dos_filename);

struct LMCache;

/* Return the per-mount cache associated with a share.
 *
 * A connected disk share has a cache whichever protocol it uses, because the cache substrate is allocated at mount time
 * regardless of protocol.  Other share types have none, and a share whose server is marked dead reports none, so that
 * nothing is served from a cache that may be stale.
 *
 * Parameters:
 *   hS  share handle; may be NULL
 *
 * Returns: the share's LMCache, or NULL if hS is NULL, the share has no cache or its server is marked dead.
 */
struct LMCache *SMB_GetCache(hSHARE hS);

/* Return the per-mount cache for a drive letter.
 *
 * For callers that hold only a drive letter, such as *LMNameMode's flush.  Unlike SMB_GetCache it returns the cache even while the
 * server is marked dead.
 *
 * Parameters:
 *   drvletter  letter in 'A'..'Z'
 *
 * Returns: pointer to the share's LMCache, or NULL if no share is allocated for that letter.
 */
struct LMCache *SMB_GetCacheFromDrv(char drvletter);

/* Retry resolving an inert symlink, for the FSEntry access guards.
 *
 * If the cache holds an inert-symlink cnode at cache_key, attempts a fresh resolution via SMB2_RetryInertSymlink.
 * It returns one of three values:
 *
 * OK: no inert symlink is cached at the path, or it stopped being one while its target was resolved; the caller carries on.
 * EOBJECTCHANGED: an inert symlink was found and resolved; the cache and the Filer viewers are refreshed (UpCall 3 fired), and the
 * object's kind, type and size may differ from the inert form the caller saw.  A call that loads or changes the object reports this to
 * the user as "try again"; one that only reads details carries on with the fresh cache state.
 * ESYMLINKFAILED: an inert symlink was found and still cannot be resolved; reported to the user.
 *
 * Parameters:
 *   hS         share handle
 *   cache_key  share-relative DOS path ("\\"-separated); a leading separator is ignored
 *
 * Returns: OK, EOBJECTCHANGED or ESYMLINKFAILED, as listed above.
 */
err_t SMB_CheckInertSymlink(hSHARE hS, const char *cache_key);

struct LMCacheNode;
struct SMB2_ListingStart;

/* List a directory of an SMB2 mount through SMB2_EnumerateDirectory.
 *
 * Unlike the path-based calls, the share is not reconnected here: the caller has already resolved it.
 *
 * Parameters:
 *   hS        share holding the directory
 *   dir_path  share-relative DOS path of the directory
 *   from      first entry wanted, and the tag a part-read listing can be resumed under
 *   visitor   called with each entry in turn; returning false stops the listing
 *   user      passed to the visitor
 *   err_out   receives the result of the listing
 *
 * Returns: true if the share is an SMB2 one and the listing was run; false, with *err_out untouched, for any other share.
 */
bool SMB_EnumerateSMB2Directory(hSHARE hS, const char *dir_path, const struct SMB2_ListingStart *from,
                                bool (*visitor)(struct LMCacheNode *node, void *user), void *user, err_t *err_out);

/* Find one leafname in a directory on an SMB2 mount, letting the server narrow the search.
 *
 * A front for SMB2_FindLeaf that first brings the share's connection up, as any path-based operation does; see
 * that function for the search pattern and for what the lookup leaves behind for the request that follows it.
 *
 * Parameters:
 *   dir_path    DOS path of the directory, with its "X:" drive prefix
 *   sought      leafname being looked for, passed to equivalent with each candidate
 *   pattern     search pattern admitting every spelling equivalent could accept
 *   equivalent  the caller's rule for whether a server leafname answers to the sought one
 *   leaf_out    receives the server's spelling of the entry found; DOS_NAME_LEN bytes
 *   err_out     receives the search result when the return value is true: OK, EFILENOTFOUND, or a failure
 *
 * Returns: true if the drive is a connected SMB2 mount and the search was attempted; false (with *err_out
 * untouched) if it is not, leaving the caller to search by other means.
 */
bool SMB_FindLeafSMB2(const char *dir_path, const char *sought, const char *pattern,
                      bool (*equivalent)(const char *server_leaf, const char *sought_leaf), char *leaf_out, err_t *err_out);

/* Return the DOS path of an open SMB file handle, for diagnostic use only.
 *
 * The FSEntry tracker in c.CoreFn uses it to put a path on traces of handlers that receive a FileSwitch handle rather than a
 * path.  Walks the SMB2 file-handle table to find the dos_path stored at open time.  An SMB1 handle, for which
 * no path is kept, and an unknown or freed slot return NULL.  The pointer is into the file-table entry and is valid only until the
 * handle is closed, so callers copy or print it at once.
 *
 * Parameters:
 *   FH  the SMB file handle (combined SMB1/SMB2 form as used by FileTbl)
 *
 * Returns: pointer to the path string, or NULL if it cannot be resolved.
 */
extern const char *SMB_GetPathFromFH(int FH);

/* Return the share handle for a given drive letter.
 *
 * Parameters:
 *   drvletter  letter in 'A'..'Z'
 *
 * Returns: share handle, or NULL if no share is allocated for that letter.
 */
hSHARE SMB_GetShareFromDrv(char drvletter);

#endif
