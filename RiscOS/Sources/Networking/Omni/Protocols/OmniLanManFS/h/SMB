extern void SMB_AntiIdle(void);

struct SMB2_Server;

/*
 * Mark the connection that owns an SMB2 server record as dead, for the SMB2 send and receive paths.
 *
 * Parameters:
 *   srv2    SMB2 server record whose connection has failed; NULL is ignored
 *   reason  short text for the debug log saying why the connection is judged dead
 */
extern void SMB_MarkServerDeadBySMB2(struct SMB2_Server *srv2, const char *reason);

/*
 * Give the cache of every mount connected through an SMB2 server record the aggressive-refresh quirk, which clamps its lifetimes, for
 * a server found mid-session to deliver change notification unreliably.
 *
