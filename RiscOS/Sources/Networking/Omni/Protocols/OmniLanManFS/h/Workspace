/* h.Workspace - Module-global Dynamic Area for LanManFS large statics.
 *
 * The SMB2 protocol buffers and file, server and share tables, together with CoreFn's path scratch, would pin hundreds of KB
 * of RMA, and more than a megabyte on larger machines, for the module's whole lifetime.
 *
 *   - lifts that ZI out of the module's image (less RMA fragmentation),
 *   - exposes the module's memory usage as a named dynamic area in the Task Manager's display,
 *   - lets the kernel mark the pages APNone so user-mode code can never accidentally corrupt the module's state, and
 *   - hands every byte back to the system in one step at module unload.
 *
 * Layout is fixed at initialisation: the SMB2 work-buffer size is chosen to suit the machine's memory, each subsystem reports
 * its required size, the workspace claims the total, then hands a base pointer to each subsystem in turn.
 * No runtime resizing, no sub-allocator.
 */

#ifndef WORKSPACE_H
#define WORKSPACE_H

#include "stdtypes.h"
#include <stddef.h>

/*
 * Create the module-global Dynamic Area and hand each consumer its slice of it.
 *
 * Called once, early in module initialisation.  It first clears any area a previous incarnation leaked on an abnormal exit, then picks a
 * memory profile that scales the buffer sizes and the cache tier to the machine, and finally sizes the area to the sum of the consumers'
 * page-rounded byte needs.  The area is carved in a fixed order (the SMB2 layer's slice first, then CoreFn's path scratch), and each
 * subsystem is told its base at once.  Registering the cache substrate allocator last lets per-mount caches draw their own areas rather
 * than share this one.  A second call while the area already exists is a harmless no-op.
 *
 * Returns: NULL on success, or the OS error from the area creation, in which case nothing has been carved.
 */
extern _kernel_oserror *Workspace_Init(void);

/*
 * Release the module-global Dynamic Area.
 *
 * Called at module finalisation, and only after the filing system has been undeclared, so that no consumer can still be holding a base
 * pointer into the area being freed.  Safe to call when the area was never created.
 */
extern void Workspace_Shutdown(void);

/*
 * Report the number of bytes the SMB2 layer needs carved from the module workspace.
 *
 * Covers the three work buffers plus the open-file, server and share tables.  Paired with SMB2_SetWorkspace: the workspace
 * manager sums each consumer's request, rounds it up to a page, and later hands back a base spanning at least this many bytes.
 * The figure depends on the memory profile already chosen, so query it only after profile selection.
 *
 * Returns: the SMB2 layer's byte requirement.
 */
extern size_t SMB2_WorkspaceBytes(void);
/*
 * Give the SMB2 layer the base of its workspace slice.
 *
 * Called once during workspace initialisation, before any SMB2 operation runs.  The slice spans at least SMB2_WorkspaceBytes();
 * the three work buffers then the open-file, server and share tables are laid out end to end in the order SMB2_WorkspaceBytes
 * sizes them, and the tables are zeroed.
 *
 * Parameters:
 *   base  start of the slice reserved for the SMB2 layer
 */
extern void SMB2_SetWorkspace(void *base);

/*
 * Report the number of bytes CoreFn needs carved from the module workspace for its path scratch.
 *
 * Paired with CoreFn_SetWorkspace.
 *
 * Returns: CoreFn's byte requirement.
 */
extern size_t CoreFn_WorkspaceBytes(void);
/*
 * Give CoreFn the base of its path-scratch slice within the module workspace.
 *
 * Called once during workspace initialisation, before any FileSwitch entry point runs.  The slice spans at least CoreFn_WorkspaceBytes().
 *
 * Parameters:
 *   base  start of the slice reserved for CoreFn's path scratch
 */
extern void CoreFn_SetWorkspace(void *base);

#endif
