/*
*
*  NameCache.h - Long filename cacheing using circular buffer
*
*/

typedef enum { ncf_REINIT, ncf_FSOPEN_EXIT, ncf_FSFILE_EXIT, ncf_FSFUNC_EXIT } ncf_reason;

/* Find the directory entry last seen for a file, so that its details need not be asked of the server again.
 *
 * Parameters:
 *   filename  full DOS path of the file, such as "A:\dir\file"
 *
 * Returns: the cached TRANS2 directory entry, or NULL if there is none.
 */
extern uint8_t *NameCache_Locate(const char *filename);

/* Add a directory entry to the name cache, discarding the oldest entries to make room.
 *
 * Parameters:
 *   dirname  DOS path of the directory, ending in a backslash, such as "A:\dir\"
 *   b        TRANS2 directory entry: 23 bytes of details followed by the leaf name
 */
extern void NameCache_Add(const char *dirname, uint8_t *b);

/* Empty the name cache.  The argument gives the reason; ncf_REINIT also resets the count of cache hits. */
extern void NameCache_Flush(ncf_reason);

/* Allocate the name cache's buffer and empty it, arranging for the buffer to be freed when the module exits.
 *
 * If the buffer cannot be allocated, the other calls do nothing.
 */
extern void NameCache_Init(void);
