#ifndef AUTH_H
#define AUTH_H

/* Compute the NTOWFv2 (NT One-Way Function v2) key, which is the same 16-byte value as LMOWFv2.
 *
 * Defined as HMAC-MD5(NTOWFv1(password), UTF-16LE(UPPERCASE(username) + domain)); the domain keeps its case.  The result keys
 * the HMAC-MD5 that produces both the LMv2 and the NTLMv2 challenge responses.
 *
 * Parameters:
 *   password    plaintext password (Latin-1)
 *   pass_size   length of password in characters
 *   username    user name (Latin-1, uppercased internally)
 *   user_size   length of username in characters
 *   userdomain  domain name (Latin-1)
 *   dom_size    length of domain in characters
 *   digestout   receives the 16-byte NTOWFv2 key
 */
void Auth_LMOWFv2(const char *password, size_t pass_size, const char *username, size_t user_size, const char *userdomain, size_t dom_size,
                  unsigned char digestout[16]);

/* Compute the LMv2 challenge response sent in the LmChallengeResponse field of NTLM AUTHENTICATE.
 *
 * Generates a fresh random 8-byte client challenge and computes HMAC-MD5(NTOWFv2, server_challenge + client_challenge).  The
 * client challenge follows the HMAC in the output so the server can recompute it.
 *
 * Parameters:
 *   lmowfv2digest    16-byte NTOWFv2 key (from Auth_LMOWFv2)
 *   serverchallenge  8-byte server challenge from the Type 2 message
 *   responseout      receives 24 bytes: 16-byte HMAC then 8-byte client challenge
 */
void Auth_LMv2ChallengeResponse(const unsigned char lmowfv2digest[16], const unsigned char serverchallenge[8],
                                unsigned char responseout[24]);

/* Compute the NTLMv2 challenge response, echoing the server's target info as modern Windows requires for SMB2.
 *
 * The server's Type 2 message carries a TargetInfo AV_PAIR list that the client echoes back, with any pairs it adds per
 * MS-NLMP 3.1.5.1.2.  If server_timestamp is non-zero, that FILETIME is embedded in the NTLMv2 blob in place of the local
 * wall-clock.  MS-NLMP 3.1.5.1.2 says the client SHOULD use MsvAvTimestamp from the server's Type 2 target info when present;
 * macOS in particular rejects SessionSetup if the client supplies a fresh timestamp when the server offered one.
 *
 * Parameters:
 *   ntowfv2digest     16-byte NTOWFv2 hash
 *   serverchallenge   8-byte server challenge from the Type 2 message
 *   target_info       target info AV_PAIRs from the Type 2 message (raw bytes), or NULL
 *   target_info_len   length of target_info
 *   server_timestamp  MsvAvTimestamp from the server, or 0 to use local time
 *   responseout       receives NTProofStr followed by the client blob
 *   responseout_max   size of output buffer
 *   responseoutsize   receives actual response size, or 0 on overflow
 */
void Auth_NTv2ChallengeResponseEx(const unsigned char ntowfv2digest[16], const unsigned char serverchallenge[8],
                                  const unsigned char *target_info, unsigned short target_info_len, unsigned long long server_timestamp,
                                  unsigned char *responseout, int responseout_max, unsigned short *responseoutsize);

#endif
