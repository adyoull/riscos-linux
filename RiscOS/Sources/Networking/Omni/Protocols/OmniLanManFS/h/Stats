/*
*  Lan Manager client
*
*  h.Stats - Header for c.Stats functions
*
*/

/* Dump every counter whose class is currently enabled in Stat_ClassMask.
 *
 * Class-masked: by default only SCLASS_GENERAL (internal-error counts) is shown; the IP transport
 * adds SCLASS_IP to the mask when it starts, which surfaces its event and datagram counts.
 */
extern void Stat_Show(void);

/* Zero every counter and set the visible-class mask to the bare-minimum default.
 *
 * Called once at module init.  Stat_Show shows only the internal-error count unless the class
 * mask is widened.
 *
 * Returns: true always (no failure path).
 */
extern bool Stat_Init(void);

extern int Stat_ClassMask;
#define SCLASS_GENERAL 1
#define SCLASS_IP      2

enum {
  STA_NETTX_PKTS = 0,
  STA_NETRX_EVTS,
  STA_NETRX_PKTS,
  STA_NETRX_OWNTX,
  STA_SERIOUS_BARF,
  STA_IP_EVENTS,
  STA_IP_RXDGRAM,

  STA_MAXSTATS
};

extern int Stat_StatTable[STA_MAXSTATS];

#define STAT(a)          (Stat_StatTable[(a)]++)
#define Stat_IncBy(a, n) (Stat_StatTable[(a)] += (n))
