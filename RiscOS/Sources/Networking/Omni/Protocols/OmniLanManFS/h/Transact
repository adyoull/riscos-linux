/*
*
*  Transact.h - SMB Transact and Transact2 related support routines
*
*/

typedef struct ActiveShare *hSHARE;

#define SEARCH_ST_SIZE 21
typedef struct {
  /* Common state */
  hSHARE search_drive;
  struct TransactParms tp;
  char dir_path[DOS_NAME_LEN];
  uint32_t resume_key;
  uint32_t resume_fake;
  bool resume_key_stuck;
  bool resume_key_encountered;
  uint16_t dir_handle;
  bool dir_handle_valid;
  uint32_t actual_resume_key;
  char resume_file_name[DOS_NAME_LEN];
  /* Cached state for short names */
  uint8_t resume_state[SEARCH_ST_SIZE];
} Transact_SearchContext;

/* Append a 16-bit little-endian value to the parameter buffer.
 *
 * Parameters:
 *   TP     transact context (parms_in_len is advanced by 2)
 *   value  value to append (low 16 bits used)
 */
extern void Transact_addword(struct TransactParms *TP, int value);

/* Append a 32-bit little-endian value to the parameter buffer.
 *
 * Parameters:
 *   TP     transact context (parms_in_len is advanced by 4)
 *   value  value to append
 */
extern void Transact_addlong(struct TransactParms *TP, long value);

/* Append a NUL-terminated string to the parameter buffer (NUL included).
 *
 * Parameters:
 *   TP   transact context (parms_in_len is advanced by strlen(str)+1)
 *   str  source string
 */
extern void Transact_addstring(struct TransactParms *TP, const char *str);

/* Read a 16-bit little-endian value from a transact response buffer.
 *
 * Parameters:
 *   p  byte pointer to the start of the value (caller guarantees 2 bytes are readable)
 *
 * Returns: the decoded 16-bit value.
 */
extern uint16_t Transact_getword(uint8_t *p);

/* Read a 32-bit little-endian value from a transact response buffer.
 *
 * Parameters:
 *   p  byte pointer to the start of the value (caller guarantees 4 bytes are readable)
 *
 * Returns: the decoded 32-bit value.
 */
extern uint32_t Transact_getlong(uint8_t *p);

/* Append a setup word to a transaction's setup words.
 *
 * A word beyond MAX_SETUPWORDS is dropped, with a message in a debug build, because no caller should need more.
 *
 * Parameters:
 *   TP     transact context (setup_in_len is advanced by 1 on success)
 *   value  setup word to append
 */
extern void Transact_addsetupword(struct TransactParms *TP, int value);

/* Prepare a transaction parameter block for a new SMB1 transaction, with SMB_WorkBuf holding both what is sent and the
 * reply.
 *
 * Parameters:
 *   TP             parameter block to prepare
 *   ret_param_len  space for the reply's parameters, in bytes; the rest of SMB_WorkBuf takes the reply's data
 */
extern void Transact_init(struct TransactParms *TP, int ret_param_len);
