/* Variadic debug macros. The C99 __VA_ARGS__ form forwards an arbitrary number of arguments to dprintf in a single call,
 * which has two practical wins: printf-style format checking on dprintf catches mismatches (no separate compile-time
 * arg-count discipline to get off-by-one on), and a many-argument line still goes through a single Reporter SWI: one
 * atomic line in the log, no risk of an interleaved debug print from a transient callback fragmenting a buffered partial
 * line.
 */
#define debug(...) dprintf((__FILE__, __VA_ARGS__))

/* Verbose-debug variant: real call when SMB2_DEBUG_VERBOSE and DEBUG are both set, no-op otherwise. Used for per-call
 * chatter (per-wire-message traces, per-entry directory logging, name-resolution steps, connection-path step timings,
 * etc.) and gated in one place.
 * The no-op arm does not evaluate its arguments - some arguments (e.g. NBIP's `debug_name()` helper) expand to
 * nothing when DEBUG is off, so we can't rely on them being valid expressions.
 */
#if defined(SMB2_DEBUG_VERBOSE) && defined(DEBUG)
#define vdebug(...) debug(__VA_ARGS__)
#else
#define vdebug(...) ((void)0)
#endif

