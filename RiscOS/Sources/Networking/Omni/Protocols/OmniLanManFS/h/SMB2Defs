#define SMB2_HMAC_SHA256_SIZE 32
#define SMB2_AES128_KEY_BITS  128

/* Saturation limits for squeezing 64-bit wire quantities through the 32-bit FileSwitch API: anything above QWORD_OVERFLOW_32 is
 * clamped to the unsigned 32-bit maximum.
 */
#define UINT32_CLAMP      0xFFFFFFFFu
#define QWORD_OVERFLOW_32 0xFFFFFFFFULL

/* NTLMSSP fixed digest and response lengths per MS-NLMP, plus local ceilings for the variable-length authentication messages
 * and their SPNEGO wrapping.  The NT response carries the server's target info, which a domain member with long DNS names
 * makes large, so the ceilings leave room for the target info real servers send.
 */
#define NTLMSSP_NTOWFV2_SIZE       16
#define NTLMSSP_NTPROOFSTR_SIZE    16
#define NTLMSSP_LMV2_RESPONSE_SIZE 24
#define NTLMSSP_MAX_NT_RESPONSE    2048
#define NTLMSSP_MAX_MSG_SIZE       2560
#define NTLMSSP_MAX_SPNEGO_SIZE    3072

/* Credit charge stamped on ordinary requests; READ, WRITE and QUERY_DIRECTORY override it with ceil(payload / SMB2_CREDIT_UNIT). */
#define SMB2_CREDIT_CHARGE_NORMAL 1

/* Balance the client keeps topped up: each request's CreditRequest asks for the shortfall below this, giving multi-credit I/O
 * headroom under the additive accounting of MS-SMB2 3.2.4.1.5.
 */
#define SMB2_CREDIT_TARGET 128

/* MS-SMB2 counts the first byte of a trailing variable-length buffer in a request's StructureSize (which is why those sizes are
 * odd); add this to the fixed body size when writing StructureSize for a command that carries a variable part.
 */
#define SMB2_VARIABLE_TRAILER 1

/* Per-command body layouts.  Each group below gives the byte offsets of one request or response body's fields, counted from the
 * end of the packet header, mirroring the corresponding MS-SMB2 section 2.2 structure.  For requests, _SIZE is the fixed body
 * length (senders add SMB2_VARIABLE_TRAILER to it when writing StructureSize for a command with a variable buffer).  For
 * responses, _SIZE is the StructureSize value the server is expected to quote and _MIN is the smallest body accepted when
 * validating a reply.
 */

