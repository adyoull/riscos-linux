/* An NT status carries its severity in the top two bits; only both-set is an error, so warnings (0x8...) and informational
 * codes such as STATUS_PENDING pass the error test.
 */
#define NT_STATUS_IS_ERROR(s)   (((s)&0xC0000000) == 0xC0000000)
#define NT_STATUS_IS_SUCCESS(s) ((s) == STATUS_SUCCESS)

