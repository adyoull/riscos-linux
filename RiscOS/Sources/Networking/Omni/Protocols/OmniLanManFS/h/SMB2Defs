/* ProtocolId bytes of the SMB2 packet header (MS-SMB2 2.2.1); an SMB1 frame instead leads with SMB1_MAGIC_0, which is how
 * received frames are told apart during multi-protocol negotiation.
 */
#define SMB2_MAGIC_0 0xFE
#define SMB2_MAGIC_1 'S'
#define SMB2_MAGIC_2 'M'
#define SMB2_MAGIC_3 'B'

#define SMB1_MAGIC_0 0xFF

/* Fixed length of the packet header that precedes every command body (MS-SMB2 2.2.1). */
#define SMB2_HEADER_SIZE 64

/* Dialect revision numbers (MS-SMB2 2.2.3).  WILD is the "SMB 2.???" wildcard a server answers with when the client offered
 * SMB2 from an SMB1 multi-protocol negotiate.
 */
#define SMB2_DIALECT_0202 0x0202
#define SMB2_DIALECT_0210 0x0210
#define SMB2_DIALECT_0300 0x0300
#define SMB2_DIALECT_0302 0x0302
#define SMB2_DIALECT_0311 0x0311
#define SMB2_DIALECT_WILD 0x02FF

