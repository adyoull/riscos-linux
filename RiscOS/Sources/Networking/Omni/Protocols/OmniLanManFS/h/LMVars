/* Central module state shared across LanManFS translation units. */

struct LMvars {
  char machinename[NAME_LIMIT];  // Local NetBIOS machine name
  char drivername[NAME_LIMIT];   // Name of DCI4 driver to which attached
  char workgroup[NAME_LIMIT];    // Workgroup to browse
  char username[USERNAME_LIMIT]; // Default user e.g. 'guest'
  int namemode;                  // Filename case-folding mode (NM_*)
  bool cache_off;                // Mounts made from now on run without a cache (*LMCache Off)
  bool logged_on;                // Whether a default credential is currently held
  char *password_ptr;            // Default password, jumbled; points at Logon's buffer, which holds "" when none
  int initialised;               // LMInitState_* progress through module bring-up
  int default_type;              // Filetype for which no ",xxx" suffix is added on the wire
  int untyped_address;           // Base of the OS ROM, used as load/exec address for untyped files
};

extern struct LMvars LM_Vars;
