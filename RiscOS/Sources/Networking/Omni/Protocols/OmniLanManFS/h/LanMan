/* c.LanMan exports -------------
 *
 * Most of these are referenced from the cmhg-generated veneer header.
 */

extern int LM_pw; // Module workspace pointer (R12-style), supplied by RISC OS at init.

/* Attempt the deferred boot-time mount.
 *
 * Called from the filing-system boot entry (FSEntry_Func) in any state, and from
 * LM_init_phase_2 to replay a deferred boot.  If LanManFS has not reached
 * LMInitState_FullyInited the request is recorded (LMInitState_Boot) and
 * retried when the transport finally comes up.  Reads the configured server
 * name from Inet$ServerName or CMOS, preferring a domain controller RPC finds
 * for it, and falls back through Inet$ServerName2, Inet$ServerName3, ... for
 * as long as the mount fails before a share is created.  Mounts the share as
 * "BOOT" with the fixed "ARMBOOT" / "" credentials.
 */
extern void LM_Boot(void);

/* Read one byte from non-volatile CMOS storage.
 *
 * Parameters:
 *   addr  CMOS address (0-255)
 *
 * Returns: the byte at `addr`, in the low 8 bits.
 */
extern int RdCMOS(int addr);

/* Look up a MessageTrans token in the module's local message file.
 *
 * Parameters:
 *   token  message token name (NUL-terminated), e.g. "Free", "BootBad", "NMMode0"
 *
 * Returns: pointer to the looked-up message string, or "" on failure.  The
 * returned pointer is into a per-module static buffer and is overwritten by
 * the next call.
 */
extern const char *MsgLookup(const char *token);

/* Remember the last externally-produced OS error so MsgError can return it later.
 *
 * Lets a low-level path that already has an OS error block return an err_t
 * through the normal error-passing chain without losing the block.  The
 * translation maps `err` to the sentinel EUSELASTSETOSERR, which a later
 * MsgError(EUSELASTSETOSERR) translates back to the captured error block.
 *
 * Parameters:
 *   err  the OS error to remember, or NULL to clear
 *
 * Returns: OK if `err` is NULL, EUSELASTSETOSERR otherwise.
 */
extern err_t MsgSetOSError(_kernel_oserror *err);

/* Translate an internal LanManFS error number into a RISC OS error block.
 *
 * EUSELASTSETOSERR returns the block saved by MsgSetOSError (EHOWDTHATHAPPEN
 * if none is saved).  Everything else is looked up via MessageTrans_ErrorLookup
 * as token "E%02u", numbered from Our_Error_Base; EDIRNOTEMPTY and ENOACCESS
 * take the number for ErrorNumber_DirNotEmpty instead, because Filer_Action
 * requires that number for "directory not empty".
 *
 * Parameters:
 *   which  internal error number, or OK for no error
 *
 * Returns: NULL when `which` is OK, otherwise a pointer to the error block.
 */
extern _kernel_oserror *MsgError(int which);

/* S.Interface exports --------------- */

extern void Free_ServiceRoutine(void);

#define UNUSED(x) (void)(x)

/* Module-wide re-entrancy interlock.
 *
 * LanManFS holds several pieces of static state (smb2_txbuf / smb2_rxbuf protocol buffers, c.CoreFn's path scratch buffer
 * and directory-read state, the open-file table, the name cache) that would silently corrupt under re-entrant entry.
 * RISC OS can re-enter the module through transient callbacks fired during blocking SWIs, through the UpCall handlers it invokes,
 * and through error and event dispatch, none of which the module controls.
 *
 * The model: every top-level handler (FSEntry_*, star command) marks its entry with FSEnter() and clean exit via FSExit().
 * FSEnter() refuses re-entry by returning ELANMANFSINUSE as a _kernel_oserror *; nested internal functions don't check the
 * flag and run unguarded inside the enclosing handler's ownership window.
 *
 * Convention: every handler uses the goto-exit pattern to guarantee FSExit() is called on every return path:
 *
 *     _kernel_oserror *handler(...) {
 *       _kernel_oserror *ret = NULL;
 *       FSEnter();
 *       ...
 *       if (err) { ret = MsgError(err); goto exit; }
 *       ...
 *     exit:
 *       FSExit();
 *       return ret;
 *     }
 *
 * FSEnter's early return happens before setting the flag, so it doesn't need a matching FSExit.
 */
extern bool lanmanfs_in_use;
extern const char *lanmanfs_owner; // function name of the current FSEnter holder; for diagnosing a flag left set

/* FSEnter records the holder's function name (via __func__) so a subsequent FSEnter that bounces with
 * ELANMANFSINUSE can tell the operator which handler is stuck.  An abort or longjmp inside an FSEntry handler
 * leaves the flag set without ever calling FSExit, and the stuck owner is then named in the bounce's debug print.
 *
 * Change notifications already waiting on the sockets are taken in first, at most once a centisecond, so the handler's cache
 * lookups see what other clients have changed.  A call that bounces does not take them in, since it cannot use the cache anyway.
 *
 * Two things the SMB2 layer keeps for the benefit of the call in hand must not leak into the next one.  What the
 * last name lookup found is discarded on every entry.  A directory listing left open part-way is closed too,
 * except by FSEnterKeepingListing, for the handlers a continuing directory read passes through (the read itself, and
 * the catalogue read FileSwitch makes ahead of it), which make that choice.  A file using these macros includes h/SMB2,
 * which declares the functions they call.
 */
#define FSEnterKeepingListing()                                                        \
  do {                                                                                 \
    if (lanmanfs_in_use) {                                                             \
      debug("FSEnter: already held by '%s'\n", lanmanfs_owner ? lanmanfs_owner : "?"); \
      return MsgError(ELANMANFSINUSE);                                                 \
    }                                                                                  \
    SMB2_PollNotifications();                                                          \
    SMB2_ForgetLookup();                                                               \
    lanmanfs_in_use = true;                                                            \
    lanmanfs_owner = __func__;                                                         \
  } while (0)

#define FSEnter()            \
  do {                       \
    FSEnterKeepingListing(); \
    SMB2_EndListing();       \
  } while (0)

#define FSExit()             \
  do {                       \
    lanmanfs_in_use = false; \
    lanmanfs_owner = NULL;   \
  } while (0)
