/* Module-wide definitions for the LanMan filing system: constants, info-word
 * flags, FileSwitch number, and the re-entrancy interlock used by every
 * top-level FSEntry / star-command handler.
 */

/* Constants ------------- */

#define FilingSystemName "LanMan"
#define Our_FS_Number    102
#define Our_Error_Base   ((0x10000) | (Our_FS_Number << 8))
#define MAX_DRIVES       8 /* Maximum number of connections */
#define NAME_LIMIT       16
#define USERNAME_LIMIT   64  /* Longest userID */
#define PASSWORD_LIMIT   64  /* Longest password */
#define DOS_NAME_LEN     256 /* Path plus leaf limit */

/* CallEvery period for background work, in the form OS_CallEvery takes it: the period in centiseconds less one.
 *
 * SMB2_PollNotifications takes in any change notifications waiting on the sockets, so on an otherwise idle mount the period
 * bounds how soon the Filer is told of a change on the server.  SMB_AntiIdle offers every dead server a recovery probe, which
 * it rate-limits itself, and checks one share per tick, so a share due a keep-alive gets it within one pass of the share
 * table.  A tick with nothing to send costs a non-blocking poll of each live server's socket, walks of the server and share
 * tables, and a clock read.
 */
#define LM_CALLEVERY_TICKS   (100 - 1) /* 1Hz */

/* Background ticks between clearings of the file types remembered from MimeMap, so an edited MimeMap file is seen within that many
 * periods of LM_CALLEVERY_TICKS.
 */
#define LM_MIME_CACHE_TTL (5)

