/* h.Tick - centisecond monotonic clock.
 *
 * Single inline wrapper around OS_ReadMonotonicTime, so that every part of the module that times an interval
 * or needs a changing seed reads the same clock.
 */

#ifndef LANMANFS_TICK_H
#define LANMANFS_TICK_H

#include <stdint.h>
#include "kernel.h"
#include "swis.h"

/* Read the OS monotonic timer (centiseconds since boot). */
static inline uint32_t LM_Tick(void) {
  uint32_t t = 0u;
  (void)_swix(OS_ReadMonotonicTime, _OUT(0), &t);

  return t;
}

#endif
