err_t Omni_GetDefaultType(char *name, int *pType_out) {
  char tmpbuf[NAME_LIMIT];
  char tmpbuf2[NAME_LIMIT];
  int filetype;

  if (!Omni_Registered) {
    return ENOTPRESENT;
  }

  /* tmpbuf gets the converted name (we discard it); tmpbuf2 gets the flags string. */
  if (_swix(SWI_Omni_ConvertClientToAcorn, _INR(0, 3) | _OUT(0), LanMan_OmniOp, name, tmpbuf, tmpbuf2, &filetype) != NULL) {
