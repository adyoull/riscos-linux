/* Omni_GetNewMountInfo() */
/*-------------------------*/

/* Decide which credentials OmniClient needs to collect for a new mount on a known server.
 *
 * Called when the user double-clicks on an icon in the available-mounts window: we already know
 * the server (it's in our list, with a credential established), so we can skip the user/password
 * prompt and ask only for the share path.  If we're logged on we can do the same even for a brand
 * new server; otherwise we need every credential field.
 *
 * Parameters:
 *   server_id   server-list handle (S_VALID_TAG)
 *   MountPath   unused
 *   pFlags_out  on success, receives the RC_NEEDS_* mask
 *
 * Returns: OK on success, EBADPARAM if server_id doesn't validate.
 */
static err_t Omni_GetNewMountInfo(int server_id, char *MountPath, int *pFlags_out) {
  const char *flags;
  NAMELIST *pSrv, *pNL;

  UNUSED(MountPath);

  pSrv = Validate(server_id, S_VALID_TAG);

  if (pSrv == NULL) {
    return EBADPARAM;
  }

  for (pNL = MountsList; pNL != NULL; pNL = pNL->next) {
    if (pNL->u.mount.servername == pSrv) {
      /* This server is connected somewhere */
      flags = SMB_GetConnInfo(pNL->u.mount.smb_lettr, GCI_LOGONTYPE);

      if (flags == NULL) { // Never heard of it
        return EBADPARAM;
      }

      /* Always user-level - no per-share password needed */
      *pFlags_out = RC_NEEDS_MOUNTPATH | RC_DOES_FILES;

      return OK;
    }
  }

  /* No, we're not connected. Are we logged on ? */
  if (LM_Vars.logged_on) {
    *pFlags_out = RC_NEEDS_MOUNTPATH | RC_DOES_FILES;
  } else {
    *pFlags_out = RC_NEEDS_USERID | RC_NEEDS_PASSWD | RC_NEEDS_MOUNTPATH | RC_DOES_FILES;
  }
  return OK;
}

err_t Omni_GetMountInfo(int mount_id, const char **pServName, const char **pUserName, const char **pMountName, const char **pMountPath,
                        int *pServerID) {
  char smbletter;
  NAMELIST *pNL = Validate(mount_id, M_VALID_TAG);

  if (pNL == NULL) {
    return EBADPARAM;
  }

  *pMountName = pNL->name;
  *pServerID = (int)(pNL->u.mount.servername);

  smbletter = pNL->u.mount.smb_lettr;

  *pServName = SMB_GetConnInfo(smbletter, GCI_SERVER);
  *pUserName = SMB_GetConnInfo(smbletter, GCI_USER);
  *pMountPath = SMB_GetConnInfo(smbletter, GCI_SHARE);

  return OK;
}

