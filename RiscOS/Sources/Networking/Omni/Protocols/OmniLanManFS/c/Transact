/* Transact.c - SMB1 SMB_Transact / SMB_Transact2 marshalling helpers.
 *
 * Tiny little-endian append/read routines for the SMB1 transact parameter and data buffers.  Only
 * the SMB1 wire path uses these; SMB2 builds its messages directly via the c/SMB2 helpers.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include "kernel.h"

#include "stdtypes.h"
#include "LanMan.h"
#include "SMB.h"
#include "Transact.h"

void Transact_addword(struct TransactParms *TP, int value) {
  uint8_t *p = TP->parms_in + TP->parms_in_len;
  p[0] = (value & 0xFF);
  p[1] = (value >> 8);
  TP->parms_in_len += 2;
}

/* ---------- */

void Transact_addlong(struct TransactParms *TP, long value) {
  uint8_t *p = TP->parms_in + TP->parms_in_len;
  p[0] = (uint8_t)(value & 0xFF);
  p[1] = (uint8_t)(value >> 8);
  p[2] = (uint8_t)(value >> 16);
  p[3] = (uint8_t)(value >> 24);
  TP->parms_in_len += 4;
}

/* ---------- */

void Transact_addstring(struct TransactParms *TP, const char *str) {
  uint8_t *p = TP->parms_in + TP->parms_in_len;
  int l = strlen(str) + 1;
  memcpy(p, str, l);
  TP->parms_in_len += l;
}

uint16_t Transact_getword(uint8_t *p) {
  return (p[0] + (p[1] << 8));
}

uint32_t Transact_getlong(uint8_t *p) {
  return (p[0] + (p[1] << 8) + (p[2] << 16) + (p[3] << 24));
}

void Transact_addsetupword(struct TransactParms *TP, int value) {
  if (TP->setup_in_len < MAX_SETUPWORDS) {
    TP->setup_in[TP->setup_in_len++] = value;
  } else {
    debug("**** Transact_addsetupword = TOO MANY SETUP WORDS\n");
  }
}

void Transact_init(struct TransactParms *TP, int ret_param_len) {
  TP->parms_in = SMB_WorkBuf;
  TP->parms_in_len = 0;
  TP->data_in = NULL;
  TP->data_in_len = 0;
  TP->parms_out_buf = SMB_WorkBuf;
  TP->parms_out_maxlen = min(ret_param_len, SMBWORKBUF_SIZE);
  TP->data_out_maxlen = SMBWORKBUF_SIZE - TP->parms_out_maxlen;
  TP->data_out_buf = SMB_WorkBuf + TP->parms_out_maxlen;
  TP->setup_out_maxlen = MAX_SETUPWORDS;
  TP->setup_in_len = 0;
}
