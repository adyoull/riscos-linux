/* c.SMB2Unicode - Latin-1 / UTF-16LE conversion for SMB2
 *
 * Converts between the RISC OS Latin-1 alphabet (alphabet 101) and the UTF-16LE encoding used on the SMB2 wire.
 *
 * RISC OS Latin-1 differs from Unicode in the 0x80-0x9F range: those positions hold printable characters (Euro sign, curly quotes,
 * ligatures, Welsh characters, etc.) rather than the Unicode C1 control characters.  A lookup table handles this mapping in both
 * directions.
 *
 * On init, the table is loaded dynamically via Service_International 8.  If that fails (older RISC OS), a static
 * compile-time table is used, derived from the RISC OS 5 International module.
 *
 * Code points that can't be mapped to Latin-1, the C1 controls among them, are encoded reversibly as "<xxxx" (opening angle bracket + 4
 * lowercase hex digits, no closing bracket).  This avoids FileSwitch system variable expansion (which requires "<...>") and is fully
 * reversible.  Surrogate pairs are encoded as two separate "<xxxx" sequences.  A file name may also have '&', '@', '^', '%', '<' and
 * '>' encoded this way, since a RISC OS path gives them meanings of their own, and a '$' that four hex digits follow.
 *
 */

#include <ctype.h>

#include "Global/Services.h"
#include "Global/Countries.h"
#include "Global/OsBytes.h"
#include "Interface/Internatio.h"
#include "kernel.h"
#include "swis.h"

#include "stdtypes.h"
#include "SMB2.h"

/* Geometry of the reversible "<xxxx" escape: an opening angle bracket plus four hex digits, and deliberately nothing after them. */
#define HEX_ESCAPE_LEN        5
#define HEX_ESCAPE_HEX_DIGITS 4

/* UTF-16 surrogate bands: units in these ranges are halves of a pair, not code points in their own right. */
#define UTF16_HIGH_SURROGATE_MIN 0xD800
#define UTF16_HIGH_SURROGATE_MAX 0xDBFF
#define UTF16_LOW_SURROGATE_MIN  0xDC00
#define UTF16_LOW_SURROGATE_MAX  0xDFFF

/* The C1 control band, whose bytes alphabet 101 gives to other characters (0x80 is the Euro sign). */
#define UNICODE_C1_MIN 0x0080
#define UNICODE_C1_MAX 0x009F

/*
 * Latin-1 byte to UCS code point, one entry per byte value.  The compile-time contents are the RISC OS 5 International module's
 * alphabet 101, whose 0x80-0x9F block holds printable characters (Euro, curly quotes, ligatures, Welsh circumflexes) rather than the
 * ISO 8859-1 C1 controls; everywhere else the mapping is identity.  smb2_unicode_init rewrites the whole table from the live alphabet
 * when Service_International 8 is available, so this initialiser is only the fallback for older systems.  0xFFFD marks bytes the
 * alphabet leaves unmapped.
 */
