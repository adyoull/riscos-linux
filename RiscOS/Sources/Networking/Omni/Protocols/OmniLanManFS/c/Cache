/*
 * Content-capture allow-list, indexed by the low byte of the filetype; capture is confined to the 0xFxx band, so the byte never aliases.
 * Listed are the types a build loads again and again: TaskObey (FD7), Obey (FEB), Absolute (FF8), BASIC (FFB), Utility (FFC), Data (FFD)
 * and Text (FFF), which C source and headers carry.
 */
static const bool lm_cacheable_filetype_lut[256] = {
    [0xD7] = true, [0xEB] = true, [0xF8] = true, [0xFB] = true, [0xFC] = true, [0xFD] = true, [0xFF] = true,
};

/*
 * Report whether a RISC OS load address carries a filetype on the content-capture allow-list.
 *
 * Parameters:
 *   load_addr  the file's RISC OS load address
 *
 * Returns: true if the filetype is on the allow-list; false for an untyped file or any other type.
 */
static inline bool is_cacheable_filetype(uint32_t load_addr) {
  uint32_t type;
  uint32_t lsb;

  /* A typed file's load address has its top 12 bits set, so the arithmetic shift yields -1; anything else carries a raw load address. */
  if (((int32_t)load_addr) >> 20 != -1) {
    return false;
  }

  /* The filetype is the 12 bits below them. */
  type = (load_addr << 12) >> 20;

  /* Only the 0xFxx band is listed, which is what lets the low byte alone index the table. */
  if ((type & 0xF00u) != 0xF00u) {
    return false;
  }

  lsb = type & 0xFFu;

  return lm_cacheable_filetype_lut[lsb];
}

/*
 * Fold an ASCII upper-case letter to lower case, leaving every other byte untouched, so paths compare and hash case-insensitively.
 */
static inline uint8_t cache_fold_ascii(uint8_t c) {
  return (c >= 'A' && c <= 'Z') ? (uint8_t)(c + 32) : c;
}

/*
 * Compute an FNV-1a hash of a whole path, case-folded so paths differing only in letter case hash equal.
 *
 * Parameters:
 *   path  NUL-terminated path to hash
 *
 * Returns: the 32-bit hash.
 */
static inline uint32_t cache_hash_full(const char *path) {
  uint32_t h = FNV1A_OFFSET;
  const uint8_t *p;

  /* Case-fold each byte before mixing it in, so paths differing only in case land on the same hash. */
  for (p = (const uint8_t *)path; *p != '\0'; p++) {
    h = (h ^ (uint32_t)cache_fold_ascii(*p)) * FNV1A_PRIME;
  }

  return h;
}

/*
 * Skip a single leading backslash so a path matches whether or not it carries its leading separator; NULL-safe.
 */
static inline const char *skip_leading_sep(const char *path) {
  if (path != NULL && path[0] == '\\') {
    return path + 1;
  }

  return path;
}

/*
 * Round `n` up to the next power of two, returning `n` unchanged when it is already one (and 1 for an input of 0 or 1).
 *
 * Bucket counts and other slab dimensions are sized to a power of two so a hash can select its slot by masking off the low bits rather than
 * taking a modulus.
 *
 * Parameters:
 *   n  lower bound the result must reach or exceed
 *
 * Returns: the smallest power of two that is at least `n`.
 */
static uint32_t next_pow2_ge(uint32_t n) {
  uint32_t p = 1u;

  /* Keep doubling until `p` first covers `n`; an input of 0 or 1 leaves the floor value of 1. */
  while (p < n) {
    p <<= 1;
  }

  return p;
}

/*
 * Take a cnode off its parent's list of children and clear its parent.
 *
 * Parameters:
 *   node  cnode to detach; a no-op if it has no parent
 */
static void child_detach(LMCacheNode_t *node) {
  LMCacheNode_t *parent = node->parent;

  if (parent == NULL) {
    return;
  }

  /* Bridge the neighbours past the node; the newest child is reached from the parent rather than a neighbour. */
  if (node->sibling_prev != NULL) {
    node->sibling_prev->sibling_next = node->sibling_next;
  } else {
    parent->first_child = node->sibling_next;
  }

  if (node->sibling_next != NULL) {
    node->sibling_next->sibling_prev = node->sibling_prev;
  }

  node->parent = NULL;
  node->sibling_prev = NULL;
  node->sibling_next = NULL;
}

/*
 * Give a cnode a new parent, moving it onto that directory's list of children.
 *
 * Every write of a cnode's parent goes through here or child_detach, so a cnode is on a directory's list exactly when its parent names
 * that directory.  That is what lets a directory's children be visited without a sweep of the whole slab.
 *
 * Parameters:
 *   node    cnode to move; it must already be on the list its current parent names, or have no parent
 *   parent  new parent directory, or NULL for none
 */
static void child_set_parent(LMCacheNode_t *node, LMCacheNode_t *parent) {
  if (node->parent == parent) {
    return;
  }

  child_detach(node);

  if (parent == NULL) {
    return;
  }

  /* Newest first: the order of a directory's children carries no meaning, and the head is the cheapest place to add. */
  node->parent = parent;
  node->sibling_next = parent->first_child;

  if (parent->first_child != NULL) {
    parent->first_child->sibling_prev = node;
  }

  parent->first_child = node;
}

/*
 * Clear the parent and child links of a cnode that is about to be filled in, whatever a previous occupant of its slot left there.
 *
 * Parameters:
 *   node  freshly claimed or reinitialised cnode
 */
static void child_links_init(LMCacheNode_t *node) {
  node->parent = NULL;
  node->first_child = NULL;
  node->sibling_prev = NULL;
  node->sibling_next = NULL;
}

/*
 * Take a directory off the mount's directory recency list.
 *
 * Parameters:
 *   cache  per-mount cache
 *   dir    directory cnode on the list
 */
static void dir_lru_unlink(LMCache_t *cache, LMCacheNode_t *dir) {
  if (dir->u.dir.older != NULL) {
    dir->u.dir.older->u.dir.newer = dir->u.dir.newer;
  } else {
    cache->dir_oldest = dir->u.dir.newer;
  }

  if (dir->u.dir.newer != NULL) {
    dir->u.dir.newer->u.dir.older = dir->u.dir.older;
  } else {
    cache->dir_newest = dir->u.dir.older;
  }

  dir->u.dir.older = NULL;
  dir->u.dir.newer = NULL;
}

/*
 * Put a directory that is on no list at the newest end of the directory recency list.
 *
 * Parameters:
 *   cache  per-mount cache
 *   dir    directory cnode to add
 */
static void dir_lru_push_newest(LMCache_t *cache, LMCacheNode_t *dir) {
  dir->u.dir.older = cache->dir_newest;
  dir->u.dir.newer = NULL;

  if (cache->dir_newest != NULL) {
    cache->dir_newest->u.dir.newer = dir;
  } else {
    cache->dir_oldest = dir;
  }

  cache->dir_newest = dir;
}

/*
 * Mark a directory as just used, moving it to the newest end of the directory recency list.  The root is on no list, so it is left alone.
 *
 * Parameters:
 *   cache  per-mount cache
 *   dir    directory cnode, or the root
 */
static void dir_lru_touch(LMCache_t *cache, LMCacheNode_t *dir) {
  /* cppcheck-suppress ctunullpointer */
  if (dir == cache->root_node || dir == cache->dir_newest) {
    return;
  }

  dir_lru_unlink(cache, dir);
  dir_lru_push_newest(cache, dir);
}

/*
 * Initialise an LRU list sentinel to the empty state, its forward and back links pointing at itself.
 *
 * The sentinel overlays a cnode's `u.file` link union, so it stands in as both ends of an otherwise-empty circular list.
 */
static void lru_sentinel_init(LMSentinel_t *s) {
  s->u.file.prev = (LMCacheNode_t *)s;
  s->u.file.next = (LMCacheNode_t *)s;
}

#ifdef SMB2_DEBUG
static void cache_lru_corruption_report(LMCacheNode_t *node, const char *site);
#endif

/*
 * Splice `node` into a file LRU list immediately after `before`.
 *
 * Callers choose `before`, a sentinel or an interior node, to place the node at a specific point in the hot or cold ordering.
 *
 * Parameters:
 *   before  existing list member the node is inserted after
 *   node    detached node to link in
 */
static inline void lru_link_after(LMCacheNode_t *before, LMCacheNode_t *node) {
  /* Read the old successor before rewriting any link, otherwise `before->next` is clobbered before `node` can inherit it. */
  LMCacheNode_t *after = before->u.file.next;
  node->u.file.prev = before;
  node->u.file.next = after;
  before->u.file.next = node;
  after->u.file.prev = node;
}

/*
 * Detach a file or negative cnode from whichever LRU list it is on.
 *
 * A no-op for directory cnodes (never on the hot or cold list) and for a node that is already unlinked, so it is safe to call
 * unconditionally; on return the node's links are cleared.
 *
 * Parameters:
 *   node  cnode to remove from its list
 */
static inline void lru_unlink(LMCacheNode_t *node) {
  LMCacheNode_t *prev;
  LMCacheNode_t *next;

  /* Directories are never on a file list (their children hold parent pointers into them), so there is nothing to unlink. */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY) {
    return;
  }

  prev = node->u.file.prev;

  /* A NULL back-link means the node is already off the list, so a repeat unlink is harmless. */
  if (prev == NULL) {
    return;
  }

  /* Bridge the neighbours past `node`, then clear its own links so any later unlink stays a safe no-op. */
  next = node->u.file.next;
  prev->u.file.next = next;
  next->u.file.prev = prev;
  node->u.file.prev = NULL;
  node->u.file.next = NULL;
}

/*
 * Insert a file or negative cnode at the cold list's MRU end and mark it cold.
 *
 * This is where freshly cached files and negatives enter, and where nodes demoted out of the hot list re-land for a second chance before
 * eviction.
 *
 * Parameters:
 *   cache  the mount's cache holding the cold sentinel
 *   node   cnode to admit at the cold MRU end
 */
static inline void lru_push_cold_head(LMCache_t *cache, LMCacheNode_t *node) {
  /* A directory reaching a file list would corrupt it; report under debug and refuse rather than link it in. */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY) {
#ifdef SMB2_DEBUG
    cache_lru_corruption_report(node, "lru_push_cold_head/DIR-rejected");
#endif
    return;
  }

  /* The cold sentinel's successor is the MRU end; clear the hot marker so the node's flag matches the list it now sits on. */
  lru_link_after((LMCacheNode_t *)&cache->cold_sentinel, node);
  node->flags &= (uint8_t)~LMCACHE_FLAG_HOT;
}

/*
 * Admit a cnode to the hot list at its LRU end, mark it hot, and grow the hot count.
 *
 * A node crossing up from cold enters at the hot list's LRU end and moves one place toward the MRU end on each hit; the
 * caller demotes the existing hot tail first if the list is at its cap.
 *
 * Parameters:
 *   cache  the mount's cache holding the hot sentinel and count
 *   node   cnode being promoted into the hot list
 */
static inline void lru_push_hot_tail(LMCache_t *cache, LMCacheNode_t *node) {
  LMCacheNode_t *sentinel;

  /* A directory reaching a file list would corrupt it; report under debug and refuse rather than link it in. */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY) {
#ifdef SMB2_DEBUG
    cache_lru_corruption_report(node, "lru_push_hot_tail/DIR-rejected");
#endif
    return;
  }

  /* Link just before the hot sentinel, at the LRU end, so a newly promoted node starts as the first demotion candidate. */
  sentinel = (LMCacheNode_t *)&cache->hot_sentinel;
  lru_link_after(sentinel->u.file.prev, node);
  node->flags |= LMCACHE_FLAG_HOT;

  /* cppcheck-suppress nullPointerRedundantCheck */
  cache->hot_len++;
}

#ifdef SMB2_DEBUG
/*
 * Log the state around a corrupted LRU list without disturbing it.
 *
 * Called when a file-list insert meets a directory, and when lru_swap_with_prev finds its neighbours' links inconsistent; the caller then
 * gives up rather than follow a broken pointer, so nothing here mutates the list. It logs the offending node and its predecessor, and notes
 * when that predecessor has lost its own back link, which is the usual locus of the break.
 *
 * Parameters:
 *   node  cnode whose LRU links failed validation; may be NULL
 *   site  short label naming the call site, for the log
 */
static void cache_lru_corruption_report(LMCacheNode_t *node, const char *site) {
  LMCacheNode_t *prev;

  debug("LRU CORRUPTION at %s - giving up without LRU mutation.\n", site != NULL ? site : "?");

  if (node == NULL) {
    debug("  node=NULL\n");
    return;
  }

  /* The cold-list LRU links live in the file arm of the cnode union, so read prev and next there whatever the object type. */
  prev = node->u.file.prev;
  debug("  node=%p name=\"%s\" prev=%p next=%p obj_type=%u flags=%02X\n", (void *)node, node->name != NULL ? node->name : "(no-name)",
        (void *)prev, (void *)node->u.file.next, (unsigned)node->obj_type, (unsigned)node->flags);

  /* Report the predecessor too: the break is almost always in the prev/next pair spanning these two nodes. */
  if (prev != NULL) {
    debug("  prev=%p prev->u.file.prev=%p prev->u.file.next=%p prev->obj_type=%u prev->flags=%02X\n", (void *)prev,
          (void *)prev->u.file.prev, (void *)prev->u.file.next, (unsigned)prev->obj_type, (unsigned)prev->flags);

    /* A NULL prev-of-prev is the usual trigger: a predecessor that has fallen out of the list. */
    if (prev->u.file.prev == NULL) {
      debug("  -> prev->u.file.prev=NULL is the violation that was found\n");
    }
  }
}
#endif

/*
 * Promote a node one position toward the MRU end of its list by exchanging it with its predecessor.
 *
 * This is the incremental per-hit promotion step; bounding a hit to a single neighbour swap keeps promotion cheap. It returns without
 * effect if the node sits against a sentinel edge.
 *
 * Parameters:
 *   node  cnode to move one step nearer the MRU end
 */
static inline void lru_swap_with_prev(LMCacheNode_t *node) {
  LMCacheNode_t *prev = node->u.file.prev;
  LMCacheNode_t *prev_prev;
  LMCacheNode_t *next;

  /* Bail if the node abuts a sentinel or the links look inconsistent, because swapping there would reach past the ends of the list. */
  if (prev == NULL || prev->u.file.prev == NULL || node->u.file.next == NULL) {
#ifdef SMB2_DEBUG
    cache_lru_corruption_report(node, "lru_swap_with_prev");
#endif
    return;
  }

  /* Exchange `node` with its predecessor, re-stitching all four surrounding links so the list ordering stays intact. */
  prev_prev = prev->u.file.prev;
  next = node->u.file.next;
  prev_prev->u.file.next = node;
  node->u.file.prev = prev_prev;
  node->u.file.next = prev;
  prev->u.file.prev = node;
  prev->u.file.next = next;
  next->u.file.prev = prev;
}

/*
 * Move the hot list's LRU tail down to the cold list to keep hot within its capacity cap.
 *
 * Called when a node is about to cross into the hot list and hot is already full.
 *
 * Parameters:
 *   cache  the mount's cache holding the hot list and its count
 */
static void demote_hot_tail(LMCache_t *cache) {
  /* The victim is the node at the hot list's LRU end, immediately before the sentinel. */
  LMCacheNode_t *sentinel = (LMCacheNode_t *)&cache->hot_sentinel;
  LMCacheNode_t *victim = sentinel->u.file.prev;

  /* Unlink from hot, then re-admit at the cold MRU end so a demoted node keeps a second chance before it can be evicted. */
  lru_unlink(victim);

  /* cppcheck-suppress nullPointerRedundantCheck */
  cache->hot_len--;
  lru_push_cold_head(cache, victim);
}

/*
 * Advance a just-hit file or negative cnode one step toward the most-recently-used end of its recency list, crossing from the cold list to
 * the hot list when it is hit while already at the cold MRU end. Directories and the root never reach here, because
 * promote filters them out. The work is bounded to a single neighbour swap on the common path.
 *
 * Parameters:
 *   cache  per-mount cache
 *   node   the file or negative cnode that was just accessed
 */
static void promote_slow(LMCache_t *cache, LMCacheNode_t *node) {
  /* prev is the neighbour one step toward MRU; a sentinel node occupies the MRU end of each list. */
  LMCacheNode_t *prev = node->u.file.prev;

  /* Already on the hot list: if it is at the MRU end there is nothing to do. */
  if (node->flags & LMCACHE_FLAG_HOT) {
    if (prev == (LMCacheNode_t *)&cache->hot_sentinel) {
      return;
    }

    /* Otherwise walk one place toward the hot MRU end. */
    lru_swap_with_prev(node);

    return;
  }

  /* On the cold list and hit while already at its MRU end: unlink to cross over to the hot list. */
  if (prev == (LMCacheNode_t *)&cache->cold_sentinel) {
    lru_unlink(node);

    /* Hot is at its cap, so push its LRU tail back down to cold to make room. */
    if (cache->hot_len == cache->hot_max) {
      demote_hot_tail(cache);
    }

    /* Enter the hot list at its LRU end; a cold node not yet at the MRU end walks one step up. */
    lru_push_hot_tail(cache, node);
  } else {
    lru_swap_with_prev(node);
  }
}

/*
 * Record a use of a cnode on its recency list.  A directory moves to the newest end of the directory list; a file or negative is nudged
 * one step up its own list, and its parent counts as used too, so a directory whose entries are still being looked at is not the next
 * to go.
 *
 * Parameters:
 *   cache  per-mount cache
 *   node   the cnode that was just accessed
 */
static inline void promote(LMCache_t *cache, LMCacheNode_t *node) {
  /* cppcheck-suppress nullPointerRedundantCheck */
  /* cppcheck-suppress ctunullpointer */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY) {
    dir_lru_touch(cache, node);

    return;
  }

  promote_slow(cache, node);

  if (node->parent != NULL) {
    dir_lru_touch(cache, node->parent);
  }
}

/*
 * Thread every non-root slab slot onto a fresh single-linked free list and mark each vacant. Slot 0 is the pinned share-root cnode and is
 * deliberately never placed on the free list.
 *
 * Parameters:
 *   cache  per-mount cache whose slab is being (re)initialised
 */
static void slab_build_free_list(LMCache_t *cache) {
  uint16_t i;
  uint16_t cap = cache->slab_capacity;

  cache->slab_used = 0;

  /* Only slot 0 (or none) exists: the pinned root leaves no float slots to free. */
  if (cap <= 1u) {
    cache->free_head = NULL;
    return;
  }

  /* The list starts at slot 1; slot 0 is the pinned share-root cnode. */
  cache->free_head = cache->root_node + 1;

  /* Chain each slot to its successor; a NULL mount marks the slot vacant. */
  for (i = 1; i + 1u < cap; i++) {
    cache->root_node[i].next.free_next = &cache->root_node[i + 1];
    cache->root_node[i].mount = NULL;
  }

  cache->root_node[cap - 1u].next.free_next = NULL;
  cache->root_node[cap - 1u].mount = NULL;
}

/*
 * Pop the next vacant slab slot off the free list.
 *
 * Parameters:
 *   cache  per-mount cache
 *
 * Returns: a fresh cnode slot, or NULL when the slab is full.
 */
static inline LMCacheNode_t *slab_alloc_slot(LMCache_t *cache) {
  LMCacheNode_t *node = cache->free_head;

  if (node == NULL) {
    return NULL;
  }

  /* Unlink the head and count the slot as occupied. */
  cache->free_head = node->next.free_next;
  cache->slab_used++;

  return node;
}

/*
 * Return a slab slot to the free list. The caller must already have unhooked the slot from its hash bucket and from any recency list.
 *
 * Parameters:
 *   cache  per-mount cache
 *   node   the slot to free
 */
static inline void slab_release_slot(LMCache_t *cache, LMCacheNode_t *node) {
  /* Push the slot back onto the free list through the same union field the hash chain uses; the slot is never on both at once. */
  node->next.free_next = cache->free_head;
  cache->free_head = node;
  cache->slab_used--;
}

/*
 * Compare n bytes of two strings under ASCII case folding. Only A-Z fold; high-bit Latin-1 bytes are left as-is, which is what SMB path
 * matching wants.
 *
 * Parameters:
 *   a  first string
 *   b  second string
 *   n  number of bytes to compare
 *
 * Returns: zero when the folded bytes are equal, otherwise the signed difference of the first folded mismatch.
 */
static inline int cache_strncasecmp_n(const char *a, const char *b, size_t n) {
  size_t i;

  for (i = 0; i < n; i++) {
    uint8_t ca = cache_fold_ascii((uint8_t)a[i]);
    uint8_t cb = cache_fold_ascii((uint8_t)b[i]);

    if (ca != cb) {
      return (int)ca - (int)cb;
    }
  }

  return 0;
}

/*
 * Test whether a canonical DOS path names this cnode. Directory cnodes hold their whole path in name and are matched against the whole
 * input; files and negatives store only their leaf, so the path is split at its final backslash: the leaf is compared against name and the
 * remaining prefix against the parent directory's stored path. This split is what lets the string heap store one short leaf per file rather
 * than a full path.
 *
 * Parameters:
 *   cache     per-mount cache (supplies the root-node identity)
 *   node      candidate cnode
 *   path      canonical DOS path to test
 *   path_len  length of path in bytes
 *
 * Returns: true iff path names this cnode.
 */
static bool path_matches_node(const LMCacheNode_t *node, const char *path, size_t path_len, LMCache_t *cache) {
  size_t leaf_len;
  size_t parent_path_len;

  /* Directory cnodes hold the whole DOS path, so the lengths and the full strings must match. */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY) {
    if ((size_t)node->name_len != path_len) {
      return false;
    }

    /* The share root directory has no stored name; it matches only the empty path. */
    if (node->name == NULL) {
      return path_len == 0u;
    }

    return cache_strncasecmp_n(node->name, path, path_len) == 0;
  }

  /* Files and negatives store only their leaf name, so the path has to be split around it. */
  leaf_len = (size_t)node->name_len;

  /* Child of the share root, given as a bare leaf with no leading separator. */
  if (node->parent == cache->root_node) {
    if (path_len == leaf_len) {
      if (leaf_len == 0u) {
        return true;
      }

      return cache_strncasecmp_n(node->name, path, leaf_len) == 0;
    }

    /* Accept the same child written with a leading backslash. */
    if (path_len == leaf_len + 1u && path[0] == '\\') {
      return cache_strncasecmp_n(node->name, path + 1u, leaf_len) == 0;
    }

    /* Neither the bare nor the rooted leaf form matched. */
    return false;
  }

  /* Deeper file: the path is too short even to hold a separator plus the leaf. */
  if (path_len < leaf_len + 1u) {
    return false;
  }

  /* The byte immediately before the leaf must be the path separator. */
  if (path[path_len - leaf_len - 1u] != '\\') {
    return false;
  }

  /* The trailing bytes must be the leaf itself. */
  if (cache_strncasecmp_n(path + path_len - leaf_len, node->name, leaf_len) != 0) {
    return false;
  }

  /* Everything ahead of the separator is the parent's path. */
  parent_path_len = path_len - leaf_len - 1u;

  /* A parented file must have a directory cnode with a stored path to compare against. */
  if (node->parent == NULL || node->parent->name == NULL) {
    return false;
  }

  /* The parent's stored path length must equal the prefix. */
  if ((size_t)node->parent->name_len != parent_path_len) {
    return false;
  }

  /* Finally the prefix must equal the parent directory's full stored path. */
  return cache_strncasecmp_n(node->parent->name, path, parent_path_len) == 0;
}

/*
 * Check the spelling of the path components that sit directly beneath a directory holding case twins.
 *
 * Paths match ignoring letter case, except beneath a CASE_TWINS directory, where the server holds names differing only in case and each
 * belongs to a different object.  Called once the path has matched the cnode ignoring case, so every component lies at the same offset
 * in both.
 *
 * Parameters:
 *   cache     per-mount cache
 *   node      cnode that path matched ignoring case
 *   path      canonical DOS path being looked up
 *   path_len  length of path in bytes
 *
 * Returns: true unless a component beneath a CASE_TWINS directory is spelt differently.
 */
static bool twin_components_exact(const LMCache_t *cache, const LMCacheNode_t *node, const char *path, size_t path_len) {
  const LMCacheNode_t *x;

  /* Check each name whose parent holds names differing only in case: only those can be a case twin of what the path spells. */
  for (x = node; x != cache->root_node && x->parent != NULL; x = x->parent) {
    size_t start;

    if ((x->parent->flags & LMCACHE_FLAG_CASE_TWINS) == 0u) {
      continue;
    }

    /* A file or negative stores only its leaf, which ends the path; a directory stores its whole path, so its leaf follows its parent's. */
    if (x->obj_type != LMCACHE_OBJECT_DIRECTORY) {
      if (memcmp(path + path_len - x->name_len, x->name, x->name_len) != 0) {
        return false;
      }

      continue;
    }

    start = (x->parent == cache->root_node) ? 0u : (size_t)x->parent->name_len + 1u;

    if (memcmp(path + start, x->name + start, (size_t)x->name_len - start) != 0) {
      return false;
    }
  }

  return true;
}

/*
 * Find the cnode for a canonical DOS path, or NULL if the path is not cached. Returns any bucket match regardless of object type or
 * freshness; callers wanting only live positive entries filter afterwards.
 *
 * Parameters:
 *   cache  per-mount cache
 *   path   canonical DOS path to look up
 *
 * Returns: the matching cnode, or NULL if none is cached.
 */
static LMCacheNode_t *find_path_any(LMCache_t *cache, const char *path) {
  /* FNV-1a hash the path; its low bits pick the bucket, and the length is precomputed for the compares below. */
  uint32_t hash = cache_hash_full(path);
  uint16_t bucket = (uint16_t)(hash & cache->hash_mask);
  LMCacheNode_t *node = cache->hash_table[bucket];
  size_t path_len = strlen(path);

  /* Gate on the full hash first (cheap) before the case-folding path compare. */
  while (node != NULL) {
    if (node->hash == hash) {
      if (path_matches_node(node, path, path_len, cache) && twin_components_exact(cache, node, path, path_len)) {
        return node;
      }
    }

    node = node->next.hash_next;
  }

  return NULL;
}

/*
 * Find a direct child of a directory that this scan has already listed under the same name in a different letter case.
 *
 * The server listing two such names means they are distinct objects, as a case-sensitive server allows.  A cached child spelt differently
 * but not refreshed by this scan proves nothing: the server may have renamed it to a new case.  Ignores CASE_TWINS spelling rules,
 * since a directory already flagged is searched for its twins again on every scan.
 *
 * Parameters:
 *   cache       per-mount cache
 *   dir_node    directory being listed
 *   child_path  path of the entry just listed, composed from dir_node's stored path
 *   threshold   expiry at or beyond which a child counts as refreshed by this scan
 *
 * Returns: the twin cnode, or NULL if there is none.
 */
static LMCacheNode_t *find_listed_twin(LMCache_t *cache, const LMCacheNode_t *dir_node, const char *child_path, LMCacheTime_t threshold) {
  uint32_t hash = cache_hash_full(child_path);
  LMCacheNode_t *node = cache->hash_table[hash & cache->hash_mask];
  size_t path_len = strlen(child_path);

  for (; node != NULL; node = node->next.hash_next) {
    const char *spelt;

    if (node->hash != hash || node->parent != dir_node || node->obj_type == LMCACHE_OBJECT_NOTHING || node->expires_at < threshold ||
        !path_matches_node(node, child_path, path_len, cache)) {
      continue;
    }

    /* A directory stores its whole path and a file only its leaf; either way the bytes compared end the path. */
    spelt = child_path + path_len - node->name_len;

    if (memcmp(spelt, node->name, node->name_len) != 0) {
      return node;
    }
  }

  return NULL;
}

/*
 * Link `node` into the front of its hash-table bucket, chaining ahead of any existing occupant.
 */
static inline void hash_link(LMCache_t *cache, LMCacheNode_t *node) {
  uint16_t bucket = (uint16_t)(node->hash & cache->hash_mask);
  node->next.hash_next = cache->hash_table[bucket];
  cache->hash_table[bucket] = node;
}

/*
 * Remove `node` from its hash bucket's chain if it is present.
 *
 * A pointer-to-pointer walk collapses the bucket-head and interior cases into one splice. Safe when the node is not on the chain: the chain
 * is left untouched and only the node's own forward link is cleared.
 *
 * Parameters:
 *   cache  per-mount cache owning the hash table
 *   node   cnode to unlink
 */
static void hash_unlink(LMCache_t *cache, LMCacheNode_t *node) {
  /* Walk with a pointer-to-pointer so the head and interior removals share one code path. */
  uint16_t bucket = (uint16_t)(node->hash & cache->hash_mask);
  LMCacheNode_t **pp = &cache->hash_table[bucket];

  /* On a match, patch the predecessor's link straight past the node. */
  while (*pp != NULL) {
    if (*pp == node) {
      *pp = node->next.hash_next;
      node->next.hash_next = NULL;

      return;
    }

    pp = &(*pp)->next.hash_next;
  }

  /* Reached only when the node was not on this chain; clear its stale forward link so the union field is never left dangling. */
  node->next.hash_next = NULL;
}

/*
 * Select which substring of `path` a cnode should store as its name: directories keep the full DOS path, while files and negatives keep
 * only the trailing leaf.
 *
 * Storing the whole path for a directory lets it be matched by path, whereas a file is only ever resolved as a leaf within its
 * already-located parent.
 *
 * Parameters:
 *   path      backslash-separated DOS path
 *   obj_type  LMCACHE_OBJECT_* class of the entry being named
 *   out_src   receives a pointer into `path` at the start of the stored portion
 *   out_len   receives the length of that portion
 */
static void compute_stored_name(const char *path, uint8_t obj_type, const char **out_src, size_t *out_len) {
  size_t i;
  size_t len = strlen(path);

  /* Default to the whole path: the answer for a directory, and the fallback for a leaf with no separator. */
  *out_src = path;
  *out_len = len;

  if (obj_type == LMCACHE_OBJECT_DIRECTORY) {
    return;
  }

  /* For a file or negative, scan back to the last backslash and keep only the leaf after it. */
  for (i = len; i > 0u; i--) {
    if (path[i - 1u] == '\\') {
      *out_src = path + i;
      *out_len = len - i;

      return;
    }
  }
}

/*
 * Allocate a string-heap block for `node`'s name and copy the stored portion of `path` into it.
 *
 * The block is prefixed with a header naming the owning node.  On success `node->name` and `name_len` are published; on failure the node
 * is left unnamed and the caller must evict it.
 *
 * Parameters:
 *   cache     per-mount cache owning the string heap
 *   node      cnode to name
 *   path      DOS path to derive the stored name from
 *   obj_type  object class deciding full-path versus leaf storage
 *
 * Returns: true on success; false if the name exceeds 65535 bytes or the string heap has no room.
 */
static bool store_name(LMCache_t *cache, LMCacheNode_t *node, const char *path, uint8_t obj_type) {
  const char *src;
  size_t src_len;
  char *dst;

  /* Decide full-path (directory) versus leaf (file or negative) text to store. */
  compute_stored_name(path, obj_type, &src, &src_len);

  /* name_len is a 16-bit field, so refuse anything that would not round-trip through it. */
  if (src_len > 0xFFFFu) {
    return false;
  }

  dst = (char *)srheap_claim(&cache->str_heap, src_len + 1u);

  /* String heap exhausted: report failure to the caller. */
  if (dst == NULL) {
    return false;
  }

  /* Guard the copy: memcpy with a NULL source is undefined even for zero length, which a leaf-less path can produce. */
  if (src_len > 0u) {
    memcpy(dst, src, src_len);
  }

  dst[src_len] = '\0';

  node->name = dst;
  node->name_len = (uint16_t)src_len;

  return true;
}

/*
 * Rewrite `node`'s stored name in place, reusing its existing string-heap block.
 *
 * Succeeds only when the new name is no longer than the current one, so it never reallocates and never churns the string heap; the caller
 * falls back to release_name plus store_name when this returns false. This keeps a same-directory rename cheap.
 *
 * Parameters:
 *   node      cnode whose name is changing
 *   path      DOS path to derive the new stored name from
 *   obj_type  object class deciding full-path versus leaf storage
 * Returns: true if the name was updated in place; false if the node is unnamed or the new name would not fit the existing block.
 */
static bool try_inplace_rename(LMCacheNode_t *node, const char *path, uint8_t obj_type) {
  const char *src;
  size_t src_len;

  /* No block to overwrite yet; the caller must allocate one instead. */
  if (node->name == NULL) {
    return false;
  }

  compute_stored_name(path, obj_type, &src, &src_len);

  /* Reuse the block only when the new name fits; anything longer needs a fresh allocation. */
  if (src_len > (size_t)node->name_len) {
    return false;
  }

  /* Guard against a NULL-source zero-length copy. */
  if (src_len > 0u) {
    memcpy((char *)node->name, src, src_len);
  }

  /* Re-terminate and shrink the recorded length; the block keeps its original capacity. */
  ((char *)node->name)[src_len] = '\0';
  node->name_len = (uint16_t)src_len;

  return true;
}

/*
 * Give a listed entry's cnode the spelling the server listed it under, where the two differ only in letter case.
 *
 * Another client can rename an entry to a new letter case.  The scan finds its cnode ignoring case and refreshes it, so without this the
 * old spelling would go on being shown.  The names are the same length, so the new one always fits the old block.  A case twin never gets
 * here: the scan has already looked for one.
 *
 * Parameters:
 *   node        cnode the listed entry matched
 *   child_path  path of the entry as the server listed it
 */
static void respell_listed_child(LMCacheNode_t *node, const char *child_path) {
  const char *src;
  size_t src_len;

  compute_stored_name(child_path, node->obj_type, &src, &src_len);

  if (node->name != NULL && src_len == (size_t)node->name_len && memcmp(node->name, src, src_len) != 0) {
    (void)try_inplace_rename(node, child_path, node->obj_type);
  }
}

/*
 * Free `node`'s string-heap name block and clear its name fields. Safe to call on an already-unnamed node.
 *
 * Parameters:
 *   cache  per-mount cache owning the string heap
 *   node   cnode whose name is to be released
 */
static void release_name(LMCache_t *cache, LMCacheNode_t *node) {
  if (node->name == NULL) {
    return;
  }

  srheap_free(&cache->str_heap, node->name);
  node->name = NULL;
  node->name_len = 0u;
}

/*
 * Clear one handle-table slot.
 *
 * A file open on several handles names only one of them in u.file.handle, so when that is the slot going, another slot still bound to the
 * file takes its place.
 *
 * Parameters:
 *   i  zero-based slot index
 */
static void handle_unbind(size_t i) {
  LMCacheNode_t *node = lm_handle_table[i].node;
  size_t j;

  lm_handle_table[i].cache = NULL;
  lm_handle_table[i].node = NULL;

  if (node == NULL || node->obj_type != LMCACHE_OBJECT_FILE || node->u.file.handle != i + 1u) {
    return;
  }

  node->u.file.handle = 0u;

  for (j = 0; j < LMCACHE_HANDLE_TABLE_SIZE; j++) {
    if (lm_handle_table[j].node == node) {
      node->u.file.handle = (uint8_t)(j + 1u);
      break;
    }
  }
}

/*
 * Tear a cnode down completely and return its slab slot to the free list.
 *
 * The name, any captured file content and any listing go back to their heaps, every handle-table slot naming the cnode is unbound, and the
 * cnode leaves its hash chain, its parent's children and, for a directory, the directory recency list.  A child still left under a
 * directory loses its parent rather than keep pointing at the reused slot.  The caller has already taken a file or negative off its own
 * recency list.  mutation_gen moves, so code holding a cnode pointer across this can tell it may have gone.
 *
 * Parameters:
 *   cache  per-mount cache owning the node
 *   node   cnode to evict; never the pinned root
 */
static void evict_node(LMCache_t *cache, LMCacheNode_t *node) {
  /*
   * Directory evictions trace at the always-on tier because each ends a subtree and its listing; files and negatives only under verbose.
   */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY) {
    debug("EVICT dir node=%p path=\"%s\" parent=%p definitive=%u\n", (void *)node, node->name != NULL ? node->name : "(no-name)",
          (void *)node->parent, (unsigned)((node->flags & LMCACHE_FLAG_DEFINITIVE) != 0u));
  } else {
    vdebug("EVICT %s node=%p name=\"%s\" parent=%p\n", node->obj_type == LMCACHE_OBJECT_FILE ? "file" : "neg", (void *)node,
           node->name != NULL ? node->name : "(no-name)", (void *)node->parent);
  }

  release_name(cache, node);

  /* Return any captured file content to the content heap. */
  if (node->obj_type == LMCACHE_OBJECT_FILE && node->u.file.data != NULL) {
    srheap_free(&cache->content_heap, node->u.file.data);
    node->u.file.data = NULL;
  }

  /* Drop the directory's leafnames blob, finished or still being built. */
  cache_leafnames_release(cache, node);

  /* Take a directory off the mount's directory recency list; the pinned root is never on it. */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY && node != cache->root_node) {
    dir_lru_unlink(cache, node);
  }

  /* A file open on any handle is bound in the process-wide handle table, possibly more than once; unbind every slot naming it. */
  if (node->obj_type == LMCACHE_OBJECT_FILE && node->u.file.handle != 0u) {
    size_t i;

    for (i = 0; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
      if (lm_handle_table[i].node == node) {
        lm_handle_table[i].cache = NULL;
        lm_handle_table[i].node = NULL;
      }
    }

    node->u.file.handle = 0u;
  }

  /* Unlink from the hash chain before the identity fields are blanked and the slot goes back on the free list. */
  hash_unlink(cache, node);

  /*
   * Callers evict children before their directory.  Should any be left, they lose their parent rather than keep pointing at a slot about to
   * be reused.
   */
  while (node->first_child != NULL) {
    debug("EVICT orphaned child=%p name=\"%s\" of dir=%p\n", (void *)node->first_child,
          node->first_child->name != NULL ? node->first_child->name : "(no-name)", (void *)node);
    child_detach(node->first_child);
  }

  child_detach(node);
  node->mount = NULL;
  node->hash = 0u;

  node->next.free_next = cache->free_head;
  cache->free_head = node;
  cache->slab_used--;

  /* Move the generation, so a cnode pointer held across this eviction re-resolves as stale. */
  cache->mutation_gen++;
}

/*
 * Choose a file or negative cnode to evict, walking the cold recency list and then the hot one, each from its least recently used end.
 *
 * The least recently used closed entry goes; a file open on a handle goes only when no closed entry is left.  Directories are not on these
 * lists; pick_dir_victim chooses among them.
 *
 * An open file passed over moves to the most recently used end of its list, so a run of evictions does not walk past the same entries
 * every time and each choice costs about the same however full the cache is.
 *
 * Parameters:
 *   cache  per-mount cache
 *
 * Returns: the chosen victim, or NULL if neither list holds anything.
 */
static LMCacheNode_t *pick_file_victim(LMCache_t *cache) {
  /* An open file is taken only when no closed entry is left. */
  LMCacheNode_t *first_open = NULL;
  int phase;

  /* Two passes: the cold list first, then the hot one, each walked inward from its LRU end. */
  for (phase = 0; phase < 2; phase++) {
    LMCacheNode_t *sentinel = (phase == 0) ? (LMCacheNode_t *)&cache->cold_sentinel : (LMCacheNode_t *)&cache->hot_sentinel;
    LMCacheNode_t *node = sentinel->u.file.prev;
    LMCacheNode_t *first_moved = NULL;

    /* Entries passed over land at the far end of the walk, so meeting the first of them again means the whole list has been seen. */
    while (node != sentinel && node != first_moved) {
      LMCacheNode_t *newer = node->u.file.prev;

      /* The least recently used closed entry goes first; a negative has no handle, so it counts as closed. */
      if (node->u.file.handle == 0u) {
        return node;
      }

      if (first_open == NULL) {
        first_open = node;
      }

      /* An open file is not taken now, so move it out of the way of the next search. */
      lru_unlink(node);
      lru_link_after(sentinel, node);

      if (first_moved == NULL) {
        first_moved = node;
      }

      node = newer;
    }
  }

  return first_open;
}

/*
 * Report whether a directory is the path being installed or one of its ancestors.  Recovery must leave those alone: the install is about
 * to hang its new entry beneath them, and its caller may be holding a pointer to them.
 *
 * Parameters:
 *   dir          directory cnode, named by its full path
 *   target_path  DOS path being installed
 *
 * Returns: true if target_path is dir's own path or lies beneath it.
 */
static bool dir_is_on_path(const LMCacheNode_t *dir, const char *target_path) {
  if (strlen(target_path) == (size_t)dir->name_len && cache_strncasecmp_n(dir->name, target_path, dir->name_len) == 0) {
    return true;
  }

  return path_is_descendant_of(target_path, dir->name);
}

/*
 * Report whether a directory has a sub-directory in the cache.  Such a directory cannot be evicted on its own, since the sub-directory's
 * parent pointer would be left with nothing to point at.
 *
 * Parameters:
 *   dir  directory cnode
 *
 * Returns: true if any of its children is a directory.
 */
static bool dir_has_subdir(const LMCacheNode_t *dir) {
  const LMCacheNode_t *c;

  for (c = dir->first_child; c != NULL; c = c->sibling_next) {
    if (c->obj_type == LMCACHE_OBJECT_DIRECTORY) {
      return true;
    }
  }

  return false;
}

/*
 * Choose a directory to evict, looking from the least recently used end of the directory recency list.
 *
 * Only a directory with no sub-directory left in the cache can go, and never one on the path being installed.  A directory passed over is
 * moved to the newest end, as pick_file_victim does with open files, so a run of evictions does not keep walking past the same ones: a
 * directory on target_path is in use anyway, and a directory with sub-directories becomes a candidate again once they have gone.
 *
 * Parameters:
 *   cache        per-mount cache
 *   target_path  DOS path being installed; it and its ancestors are never chosen
 *
 * Returns: the chosen directory, or NULL if every directory is on the path or has a sub-directory.
 */
static LMCacheNode_t *pick_dir_victim(LMCache_t *cache, const char *target_path) {
  LMCacheNode_t *dir = cache->dir_oldest;
  LMCacheNode_t *first_moved = NULL;

  while (dir != NULL && dir != first_moved) {
    LMCacheNode_t *newer = dir->u.dir.newer;

    if (!dir_is_on_path(dir, target_path) && !dir_has_subdir(dir)) {
      return dir;
    }

    dir_lru_touch(cache, dir);

    if (first_moved == NULL) {
      first_moved = dir;
    }

    dir = newer;
  }

  return NULL;
}

/*
 * Evict every file and negative child of a directory recovery is evicting, and return how many were removed.
 *
 * pick_dir_victim only chooses a directory with no sub-directory, so every child is a file or a negative.
 *
 * Parameters:
 *   cache   per-mount cache
 *   victim  directory whose files and negatives are swept
 *
 * Returns: the number of cnodes evicted.
 */
static uint32_t sweep_file_children_of(LMCache_t *cache, const LMCacheNode_t *victim) {
  LMCacheNode_t *c;
  LMCacheNode_t *older;
  uint32_t evicted = 0u;

  /* Read each child's neighbour before evicting it, since eviction takes it off the list. */
  for (c = victim->first_child; c != NULL; c = older) {
    older = c->sibling_next;

    vdebug("RECOVERY sweep_child type=%u name=\"%s\" handle=%u\n", (unsigned)c->obj_type, c->name != NULL ? c->name : "(no-name)",
           (unsigned)(c->obj_type == LMCACHE_OBJECT_FILE ? c->u.file.handle : 0u));

    /* Keep the hot-list population count straight before unlinking. */
    if ((c->flags & LMCACHE_FLAG_HOT) != 0u) {
      cache->hot_len--;
    }

    /* Unlink from its LRU list, then release the cnode and all its substrate allocations. */
    lru_unlink(c);
    evict_node(cache, c);
    evicted++;
  }

  return evicted;
}

/*
 * Release the listing of the least recently used directory that has one, keeping the directory itself.
 *
 * Recovery calls this when content-heap space is the only shortfall and no file's content is left to drop; a later enumeration of that
 * directory reads it from the server again.  Listings of the directories above the path being installed are spared, as recovery spares
 * those directories themselves (dir_is_on_path); the path's own directory holds no listing by then, since the build claiming the space
 * has released it.
 *
 * Parameters:
 *   cache        per-mount cache
 *   target_path  DOS path being installed
 *
 * Returns: true if a listing was released, false if none could be.
 */
static bool release_oldest_listing(LMCache_t *cache, const char *target_path) {
  LMCacheNode_t *dir;

  for (dir = cache->dir_oldest; dir != NULL; dir = dir->u.dir.newer) {
    if (dir->u.dir.leafnames_blob == NULL || dir_is_on_path(dir, target_path)) {
      continue;
    }

    debug("RECOVERY blob_sweep release dir=\"%s\"\n", dir->name);
    cache_leafnames_release(cache, dir);

    return true;
  }

  return false;
}

/*
 * Evict one file or negative chosen by recovery.
 *
 * For a file, the parent's listing keeps the name, since the file is still on the server: a lookup by name can still be served from the
 * listing, and a later read of the listing's details finds the entry missing and goes to the server.
 *
 * Parameters:
 *   cache   per-mount cache
 *   victim  file or negative cnode to evict
 */
static void recovery_evict_file(LMCache_t *cache, LMCacheNode_t *victim) {
  debug("RECOVERY evict file type=%u name=\"%s\" handle=%u\n", (unsigned)victim->obj_type,
        victim->name != NULL ? victim->name : "(no-name)",
        (unsigned)(victim->obj_type == LMCACHE_OBJECT_FILE ? victim->u.file.handle : 0u));

  if ((victim->flags & LMCACHE_FLAG_HOT) != 0u) {
    cache->hot_len--;
  }

  lru_unlink(victim);
  evict_node(cache, victim);
}

/*
 * Evict a directory chosen by recovery, with its files and negatives.  As for a file, the parent's listing keeps the directory's name.
 *
 * Parameters:
 *   cache   per-mount cache
 *   victim  directory with no sub-directory in the cache
 */
static void recovery_evict_dir(LMCache_t *cache, LMCacheNode_t *victim) {
  uint32_t swept;

  /* Its children go first: evict_node expects a directory to have none left. */
  swept = sweep_file_children_of(cache, victim);
  debug("RECOVERY sweep victim=\"%s\" evicted=%u file children\n", victim->name != NULL ? victim->name : "(no-name)", (unsigned)swept);
  (void)swept; // read only by the debug line, which a release build compiles away

  debug("RECOVERY evict leaf-dir name=\"%s\"\n", victim->name != NULL ? victim->name : "(no-name)");
  evict_node(cache, victim);
}

/*
 * Evict one entry to make room for a claim: a file or negative, or failing that a directory with its files, or the other way round when
 * dir_first is set.  Never target_path or a directory above it.
 *
 * Parameters:
 *   cache        per-mount cache
 *   target_path  DOS path being installed
 *   dir_first    look for a directory before a file
 *
 * Returns: true if something was evicted, false if nothing could be.
 */
static bool recovery_evict_one(LMCache_t *cache, const char *target_path, bool dir_first) {
  LMCacheNode_t *victim;

  /* Choose a victim of the kind the caller prefers, falling back to the other kind when there is none. */
  if (dir_first) {
    victim = pick_dir_victim(cache, target_path);

    if (victim == NULL) {
      victim = pick_file_victim(cache);
    }
  } else {
    victim = pick_file_victim(cache);

    if (victim == NULL) {
      victim = pick_dir_victim(cache, target_path);
    }
  }

  /* No victim of either kind: nothing more can be given back. */
  if (victim == NULL) {
    return false;
  }

  if (victim->obj_type == LMCACHE_OBJECT_DIRECTORY) {
    recovery_evict_dir(cache, victim);
  } else {
    recovery_evict_file(cache, victim);
  }

  return true;
}

/*
 * Drop a directory's cached listing after one of its children could not be inserted.
 *
 * Called when a child of parent cannot be inserted, for want of room or because its name is too long to store. The parent's cached listing
 * can no longer be trusted to be complete, so its leafnames blob and DEFINITIVE status are dropped and the next enumeration goes to the
 * wire.  One failed insert says nothing about the directory's size, so the oversized flag is left to the enumeration, which can see the
 * whole listing.  A no-op unless parent is a directory.
 *
 * Parameters:
 *   cache       per-mount cache
 *   parent      the directory whose child could not be installed
 *   child_path  path of the child that failed, for diagnostics only
 *   cause       short reason string, for diagnostics only
 */
static void degrade_parent_on_insert_fail(LMCache_t *cache, LMCacheNode_t *parent, const char *child_path, const char *cause) {
  /* Only a directory carries a cached listing to invalidate. */
  if (parent == NULL || parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    return;
  }

  /* If the parent claimed a complete listing, that claim is now false, because one of its children won't fit. */
  if ((parent->flags & LMCACHE_FLAG_DEFINITIVE) != 0u || parent->u.dir.leafnames_blob != NULL) {
    cache_leafnames_release(cache, parent);
  }

  debug("LISTING_DROPPED path=\"%s\" cause=%s child=\"%s\"\n", parent->name != NULL ? parent->name : "(root)", cause, child_path);

  /* Referenced only by the debug line; keep the compiler quiet in non-debug builds. */
  (void)child_path;
  (void)cause;
}

/*
 * Choose a file whose captured content recovery can drop.
 *
 * Content past its own lifetime is taken first, since it can no longer be served; failing that, the least recently used holder.  Most files
 * hold no content, so the oldest entries on the recency lists are seldom holders and only a search finds one: both lists are walked from
 * their least recently used ends, stopping at the first expired holder.  Recovery runs only once a claim has failed, so the walk is not on
 * any common path.
 *
 * Parameters:
 *   cache  per-mount cache
 *
 * Returns: the file whose content should go, or NULL if no file holds any.
 */
static LMCacheNode_t *pick_content_victim(LMCache_t *cache) {
  LMCacheNode_t *oldest = NULL;
  LMCacheTime_t now = (lm_clock_fn != NULL) ? cache_now() : 0u;
  int phase;

  /* Search the cold list before the hot one, each from its oldest end. */
  for (phase = 0; phase < 2; phase++) {
    LMCacheNode_t *sentinel = (phase == 0) ? (LMCacheNode_t *)&cache->cold_sentinel : (LMCacheNode_t *)&cache->hot_sentinel;
    LMCacheNode_t *node;

    for (node = sentinel->u.file.prev; node != sentinel; node = node->u.file.prev) {
      if (node->obj_type != LMCACHE_OBJECT_FILE || node->u.file.data == NULL) {
        continue;
      }

      /* Content past its lifetime is the best victim, because nothing worth keeping is lost with it. */
      if (lm_clock_fn != NULL && now >= node->u.file.data_expires_at) {
        return node;
      }

      /* Otherwise fall back to the oldest entry met. */
      if (oldest == NULL) {
        oldest = node;
      }
    }
  }

  return oldest;
}

/*
 * Drop the captured content of the file pick_content_victim chooses, to make room in the content heap.  The file's entry stays, so its
 * details still answer lookups.
 *
 * Parameters:
 *   cache  per-mount cache
 *
 * Returns: true if some content was dropped, false if no file holds any.
 */
static bool release_content_for_room(LMCache_t *cache) {
  LMCacheNode_t *victim = pick_content_victim(cache);

  if (victim == NULL) {
    return false;
  }

  debug("RECOVERY release content name=\"%s\" length=%u\n", victim->name != NULL ? victim->name : "(no-name)", (unsigned)victim->length);
  release_file_content(cache, victim);

  return true;
}

/*
 * Free content-heap space for a claim whose only shortfall is content space.
 *
 * Only something holding content helps: a file's captured content (expired first, then least recently used), then the least recently
 * used directory's listing.  A file loses only its content, not its entry.  Evicting a directory would not help: by then no file holds
 * content and no directory off target_path holds a listing, so it would free nothing in the content heap.
 *
 * Parameters:
 *   cache        per-mount cache
 *   target_path  DOS path being installed; it and the directories above it keep their listings
 *
 * Returns: true if something was freed, false if nothing could be.
 */
static bool recovery_free_content(LMCache_t *cache, const char *target_path) {
  if (release_content_for_room(cache)) {
    return true;
  }

  return release_oldest_listing(cache, target_path);
}

/*
 * Claim a slab slot and name block for a new entry, or a content-heap block for a listing, evicting others to make room when the first
 * attempt fails.
 *
 * A claim can fail because its region is full, or too fragmented for one run of the size wanted, so recovery frees one thing at a time and
 * tries again, up to LMCACHE_RECOVERY_ROUNDS times, never touching target_path or a directory above it.  Each eviction takes the least
 * recently used file or negative, or once those have run out the least recently used directory with no sub-directory, files and all; a
 * directory install short of name space looks for a directory first, since its full-path name needs a run of the string heap that one
 * short leaf name seldom frees.  When content space is the only shortfall, recovery_free_content frees only what holds content.  A caller
 * passes NULL for any claim it does not want.
 *
 * Parameters:
 *   cache             per-mount cache
 *   target_path       DOS path being installed
 *   dir_install       true when a directory is being installed, which may look for a directory to evict first
 *   name_payload_len  name length in bytes, excluding the terminator
 *   slot_pp           receives a slab slot, or NULL if not wanted
 *   content_pp        receives a build-sized listing block from the content heap, or NULL if not wanted
 *   name_pp           receives a string-heap block, or NULL if not wanted
 *
 * Returns: true with every requested claim made; false with none left claimed, every output NULL.
 */
static bool cache_claim_with_recovery(LMCache_t *cache, const char *target_path, bool dir_install, size_t name_payload_len,
                                      LMCacheNode_t **slot_pp, LMLeafnamesBlobHdr_t **content_pp, char **name_pp) {
  size_t content_bytes;
  size_t name_bytes;
  uint32_t round;

  /* Clear every requested output up front: callers must read NULL for anything not ultimately claimed. */
  if (slot_pp != NULL) {
    *slot_pp = NULL;
  }

  if (content_pp != NULL) {
    *content_pp = NULL;
  }

  if (name_pp != NULL) {
    *name_pp = NULL;
  }

  /* Size the claims: a leafnames blob is always the fixed build size; a name adds its terminator. */
  content_bytes = sizeof(LMLeafnamesBlobHdr_t) + (size_t)LMCACHE_LEAFNAMES_BUILD_BYTES;
  name_bytes = name_payload_len + 1u;

  for (round = 0u;; round++) {
    bool only_content_short;
    bool dir_first;

    /* Claim whatever is still missing; the first time round this is the common case, where everything fits without evicting anything. */
    if (slot_pp != NULL && *slot_pp == NULL) {
      *slot_pp = slab_alloc_slot(cache);
    }

    if (content_pp != NULL && *content_pp == NULL) {
      *content_pp = (LMLeafnamesBlobHdr_t *)srheap_claim(&cache->content_heap, content_bytes);
    }

    if (name_pp != NULL && *name_pp == NULL) {
      *name_pp = (char *)srheap_claim(&cache->str_heap, name_bytes);
    }

    if ((slot_pp == NULL || *slot_pp != NULL) && (content_pp == NULL || *content_pp != NULL) && (name_pp == NULL || *name_pp != NULL)) {
      return true;
    }

    /* A directory install short of name space evicts a directory first: its full-path name needs more than a leafname frees. */
    dir_first = (dir_install && name_pp != NULL && *name_pp == NULL);

    if (round == 0u) {
      debug("RECOVERY enter target=\"%s\" want_slot=%u want_content=%u want_name=%u"
            " missing_slot=%u missing_content=%u missing_name=%u\n",
            target_path[0] != '\0' ? target_path : "(root)", (unsigned)(slot_pp != NULL), (unsigned)(content_pp != NULL),
            (unsigned)(name_pp != NULL), (unsigned)(slot_pp != NULL && *slot_pp == NULL),
            (unsigned)(content_pp != NULL && *content_pp == NULL), (unsigned)(name_pp != NULL && *name_pp == NULL));
    }

    if (round == LMCACHE_RECOVERY_ROUNDS) {
      break;
    }

    only_content_short = (content_pp != NULL && *content_pp == NULL) && (slot_pp == NULL || *slot_pp != NULL) &&
                         (name_pp == NULL || *name_pp != NULL);

    /* Evicting a file or negative with no content would not help: free only what holds content. */
    if (only_content_short) {
      if (!recovery_free_content(cache, target_path)) {
        break;
      }

      continue;
    }

    if (!recovery_evict_one(cache, target_path, dir_first)) {
      break;
    }
  }

  /* Give up: unwind every claim that did succeed so the caller sees all-or-nothing. */
  debug("RECOVERY failed - rolling back partial claims\n");

  if (slot_pp != NULL && *slot_pp != NULL) {
    slab_release_slot(cache, *slot_pp);
    *slot_pp = NULL;
  }

  if (content_pp != NULL && *content_pp != NULL) {
    srheap_free(&cache->content_heap, *content_pp);
    *content_pp = NULL;
  }

  if (name_pp != NULL && *name_pp != NULL) {
    srheap_free(&cache->str_heap, *name_pp);
    *name_pp = NULL;
  }

  return false;
}

/*
 * Stamp a cnode's FileSwitch metadata in one shot.
 */
static inline void copy_metadata(LMCacheNode_t *node, uint32_t load_addr, uint32_t exec_addr, uint64_t length, uint32_t attrs) {
  node->load_addr = load_addr;
  node->exec_addr = exec_addr;
  node->length = length;
  node->attrs = attrs;
}

/*
 * Insert a new cnode for path, or refresh the existing one in place.
 *
 * An existing cnode of the same type has its details overwritten, its lifetime restarted and its parent updated, and is promoted; a file's
 * captured content is dropped first if the length or the load or exec address changed.  One whose type changed is evicted with its subtree
 * and made afresh, except the share root, whose type never changes.  A new file or negative must hang under a directory and is named by its
 * leaf; a directory is named by its full path and joins the directory recency list.  Making room may evict other entries
 * (cache_claim_with_recovery), and a new entry that finds no room drops the parent's listing, which could otherwise leave out a name the
 * server holds.
 *
 * Parameters:
 *   cache      per-mount cache
 *   parent     directory the entry hangs under; may be NULL for a directory
 *   path       DOS path; a leading backslash is skipped
 *   obj_type   LMCACHE_OBJECT_FILE, LMCACHE_OBJECT_DIRECTORY or LMCACHE_OBJECT_NOTHING
 *   load_addr  RISC OS load address
 *   exec_addr  RISC OS exec address
 *   length     length in bytes
 *   attrs      RISC OS attributes
 *
 * Returns: the inserted or refreshed cnode, or NULL on failure (bad arguments, a type change on the root, no directory parent, a name too
 * long to store, or no room).
 */
static LMCacheNode_t *cache_insert_or_refresh(LMCache_t *cache, LMCacheNode_t *parent, const char *path, uint8_t obj_type,
                                              uint32_t load_addr, uint32_t exec_addr, uint64_t length, uint32_t attrs) {
  LMCacheNode_t *node;
  LMCacheTime_t now;
  uint32_t hash;

  /* Need a path and a clock: the expiry stamps below are meaningless without the latter. */
  if (path == NULL || lm_clock_fn == NULL) {
    debug("INSERT_FAIL path=%p clock=%p reason=null_args\n", (void *)path, (void *)(uintptr_t)lm_clock_fn);
    return NULL;
  }

  vdebug("INSERT/REFRESH parent=%p path=\"%s\" type=%u length=%u attrs=%08X\n", (void *)parent, path, (unsigned)obj_type, (unsigned)length,
         (unsigned)attrs);

  /* Strip a leading backslash so keys hash the same whether or not the caller included one. */
  if (path[0] == '\\') {
    path++;
  }

  /* Look up any existing cnode for this path (file, directory or negative) and read the clock once. */
  node = find_path_any(cache, path);
  now = cache_now();

  /* An existing entry whose type changed can't be refreshed in place. */
  if (node != NULL) {
    if (node->obj_type != obj_type) {
      if (node == cache->root_node) {
        /* The share root's type is fixed; never let a wire result flip it. */
        debug("INSERT_FAIL path=\"%s\" type=%u reason=type_change_on_root old_type=%u\n", path, (unsigned)obj_type,
              (unsigned)node->obj_type);
        return NULL;
      }

      /*
       * Type mismatch and not the root: tear the stale cnode out (with everything under it, if it was a directory, since its children
       * would otherwise keep pointing at a slot about to be reused) and fall through to a fresh insert.
       */
      evict_node_and_subtree(cache, node);
      node = NULL;
    } else {
      release_content_if_changed(cache, node, load_addr, exec_addr, length);

      /* Same type: refresh metadata and restamp the lifetime without disturbing the slot. */
      copy_metadata(node, load_addr, exec_addr, length, attrs);
      node->expires_at = now + cache->metadata_ttl;

      /* Adopt a new parent if the caller supplied a different one: the path may have been reparented since this client last saw it. */
      if (parent != NULL && node->parent != parent) {
        child_set_parent(node, parent);
      }

      /* A refresh counts as use, so promote it up the LRU. */
      promote(cache, node);

      return node;
    }
  }

  /* A new file must hang under a real directory parent. */
  if (obj_type != LMCACHE_OBJECT_DIRECTORY) {
    if (parent == NULL || parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
      debug("INSERT_FAIL path=\"%s\" type=%u reason=parent_not_dir parent=%p parent_type=%u\n", path, (unsigned)obj_type, (void *)parent,
            (unsigned)(parent != NULL ? parent->obj_type : 0xFFu));
      return NULL;
    }
  }

  {
    char *dst;
    const char *name_src;
    size_t name_src_len;

    /* Directories are named by full path; files store only their leafname, the parent chain supplying the rest. */
    if (obj_type == LMCACHE_OBJECT_DIRECTORY) {
      name_src = path;
      name_src_len = strlen(path);
    } else {
      const char *last_bs = strrchr(path, '\\');
      name_src = (last_bs != NULL) ? last_bs + 1 : path;
      name_src_len = strlen(name_src);
    }

    /* The name-length field is 16-bit; refuse anything that wouldn't round-trip through it. */
    if (name_src_len > 0xFFFFu) {
      debug("INSERT_FAIL path=\"%s\" type=%u reason=name_len_overflow len=%u\n", path, (unsigned)obj_type, (unsigned)name_src_len);
      degrade_parent_on_insert_fail(cache, parent, path, "name_len_overflow");

      return NULL;
    }

    /* Reserve a slab slot and a name block, evicting other entries if the substrate is full. */
    if (!cache_claim_with_recovery(cache, path, obj_type == LMCACHE_OBJECT_DIRECTORY, name_src_len, &node, NULL, &dst)) {
      debug("INSERT_FAIL path=\"%s\" type=%u reason=substrate_exhausted\n", path, (unsigned)obj_type);
      degrade_parent_on_insert_fail(cache, parent, path, "substrate_exhausted");

      return NULL;
    }

    /* Copy the name payload, guarding the zero-length root case. */
    if (name_src_len > 0u) {
      memcpy(dst, name_src, name_src_len);
    }

    dst[name_src_len] = '\0';
    node->name = dst;

    /* Initialise the fresh cnode's common fields; the union is left in file shape here and re-specialised below for directories. */
    node->name_len = (uint16_t)name_src_len;

    node->mount = cache;
    child_links_init(node);
    child_set_parent(node, parent);
    node->obj_type = obj_type;
    node->flags = 0u;
    node->expires_at = now + cache->metadata_ttl;
    node->suppress_until = 0u;
    node->u.file.prev = NULL;
    node->u.file.next = NULL;
    node->next.hash_next = NULL;
  }

  copy_metadata(node, load_addr, exec_addr, length, attrs);

  /*
   * Type-specific union setup: a file starts with no handle and no captured content; a directory with no listing, as the newest on the
   * directory recency list.
   */
  if (obj_type == LMCACHE_OBJECT_FILE) {
    node->u.file.handle = 0u;
    node->u.file.data = NULL;
    node->u.file.data_expires_at = 0u;
  } else if (obj_type == LMCACHE_OBJECT_DIRECTORY) {
    node->u.dir.leafnames_blob = NULL;
    node->u.dir.leafnames_size = 0u;
    node->u.dir.leafnames_capacity = 0u;
    dir_lru_push_newest(cache, node);
  }

  /* Index the cnode by its full-path hash so find_path_any can reach it. */
  hash = cache_hash_full(path);
  node->hash = hash;
  hash_link(cache, node);

  /* A new file joins the cold list, and adding to a directory counts as using it. */
  if (obj_type != LMCACHE_OBJECT_DIRECTORY) {
    lru_push_cold_head(cache, node);
    dir_lru_touch(cache, parent);
  }

  return node;
}

/*
 * Free a directory's packed leafnames blob and mark its enumeration no longer authoritative.
 *
 * The DEFINITIVE flag is cleared with the blob, because without it the cache cannot tell whether a leaf is present, so a later lookup goes
 * to the wire. EXCEEDS_CACHE is left alone: whether the directory is too big to list in the cache does
 * not change because one of its listings was dropped, and only a listing that fits clears it. A no-op for NULL or non-directory cnodes.
 *
 * Parameters:
 *   cache  per-mount cache owning the content heap
 *   dir    directory cnode whose leafnames blob is released
 */
static void cache_leafnames_release(LMCache_t *cache, LMCacheNode_t *dir) {
  /* Safe on any cnode; only directories own a blob to release. */
  if (dir == NULL || dir->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    return;
  }

  if (dir->u.dir.leafnames_blob != NULL) {
    if (dir->u.dir.leafnames_blob->index != NULL) {
      srheap_free(&cache->content_heap, dir->u.dir.leafnames_blob->index);
    }

    srheap_free(&cache->content_heap, dir->u.dir.leafnames_blob);
    dir->u.dir.leafnames_blob = NULL;
  }

  /* With no blob the directory can no longer be the authoritative child list, so drop definitiveness. */
  dir->u.dir.leafnames_size = 0u;
  dir->u.dir.leafnames_capacity = 0u;
  dir->flags &= (uint8_t) ~(LMCACHE_FLAG_DEFINITIVE | LMCACHE_FLAG_UNLISTED_ENTRIES);
}

/*
 * Start a directory's listing as an empty blob of the build size, for a scan to append names to.
 *
 * Any listing the directory already holds is released first.  The directory stays non-definitive until cache_leafnames_finish_build, so
 * nothing trusts the listing while it is incomplete.  Making room for the blob frees content-heap space held elsewhere, never the listing
 * of the directory or of one above it.
 *
 * Parameters:
 *   cache  per-mount cache
 *   dir    directory whose listing is started
 *
 * Returns: true with an empty listing in place; false for a cnode that is not a directory, or when no room could be found.
 */
static bool cache_leafnames_begin_build(LMCache_t *cache, LMCacheNode_t *dir) {
  const uint16_t cap = (uint16_t)LMCACHE_LEAFNAMES_BUILD_BYTES;
  LMLeafnamesBlobHdr_t *hdr;
  uint8_t *body;
  const char *target_path;

  if (cache == NULL || dir == NULL || dir->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    return false;
  }

  /* Drop any blob the directory already holds so the claim replaces it rather than leaking it. */
  cache_leafnames_release(cache, dir);

  target_path = (dir->name != NULL) ? dir->name : "";

  /*
   * Claim a build-sized blob, giving up other directories' listings if need be; give up (dir stays non-definitive) when even that cannot
   * free the space.
   */
  if (!cache_claim_with_recovery(cache, target_path, false, 0u, NULL, &hdr, NULL)) {
    debug("BUILD_BLOB_NOMEM dir=\"%s\" requested=%u\n", (dir->name != NULL) ? dir->name : "(root)",
          (unsigned)(sizeof(LMLeafnamesBlobHdr_t) + (size_t)cap));

    return false;
  }

  /*
   * Seed the header with the owner backpointer and lifetime, then an empty body: the lone NUL is the empty-list terminator that
   * leafnames_size=1 accounts for.
   */
  hdr->owner = dir;
  hdr->expires_at = cache_now() + cache->metadata_ttl;
  hdr->index = NULL;
  hdr->index_mask = 0u;
  hdr->index_filled = 0u;
  hdr->gone_bytes = 0u;

  body = (uint8_t *)(hdr + 1);
  body[0] = '\0';

  dir->u.dir.leafnames_blob = hdr;
  dir->u.dir.leafnames_size = 1u;
  dir->u.dir.leafnames_capacity = cap;

  return true;
}

/*
 * Finalise an incrementally-built leafnames blob: trim surplus capacity and mark the directory definitive.
 *
 * Marking the directory definitive turns the blob into a complete child list that an enumeration's cache-read step and the fast-miss
 * probe trust, so this must run only once the build is complete.
 *
 * Parameters:
 *   cache  per-mount cache
 *   dir    directory cnode whose blob has just been built
 */
static void cache_leafnames_finish_build(LMCache_t *cache, LMCacheNode_t *dir) {
  size_t shrink_to;

  if (cache == NULL || dir == NULL || dir->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    return;
  }

  if (dir->u.dir.leafnames_blob == NULL) {
    return;
  }

  /* Keep a little headroom above the used bytes so a later append need not immediately reallocate. */
  shrink_to = (size_t)dir->u.dir.leafnames_size + (size_t)LMCACHE_LEAFNAMES_HEADROOM;

  /* Only shrink when the build over-allocated; the realloc hands the surplus bytes back to the content heap. */
  if (shrink_to < (size_t)dir->u.dir.leafnames_capacity) {
    void *shrunk = srheap_realloc(&cache->content_heap, dir->u.dir.leafnames_blob, sizeof(LMLeafnamesBlobHdr_t) + shrink_to);

    /* On realloc failure keep the oversize blob untouched: shrinking is best-effort and the larger blob is still valid. */
    if (shrunk != NULL) {
      dir->u.dir.leafnames_blob = (LMLeafnamesBlobHdr_t *)shrunk;
      dir->u.dir.leafnames_capacity = (uint16_t)shrink_to;
    }
  }

  /* Setting the definitive flag lets the blob answer PRESENT or ABSENT without a wire round trip. */
  dir->flags |= LMCACHE_FLAG_DEFINITIVE;
  debug("BUILD_BLOB dir=\"%s\" size=%u capacity=%u\n", (dir->name != NULL) ? dir->name : "(root)", (unsigned)dir->u.dir.leafnames_size,
        (unsigned)dir->u.dir.leafnames_capacity);
}

void Cache_SetLeafFold(uint32_t (*fold)(const char *leaf)) {
  lm_leaf_fold_fn = fold;
}

/*
 * Fold a leaf name to the hash a listing's index files it under: the installed fold, or FNV-1a over the case-folded bytes.
 */
static uint32_t leaf_fold(const char *leaf) {
  uint32_t h = FNV1A_OFFSET;
  const uint8_t *p;

  if (lm_leaf_fold_fn != NULL) {
    return lm_leaf_fold_fn(leaf);
  }

  for (p = (const uint8_t *)leaf; *p != '\0'; p++) {
    h = (h ^ (uint32_t)cache_fold_ascii(*p)) * FNV1A_PRIME;
  }

  return h;
}

/*
 * Test whether two leaf names are the same by the cache's own rule: whole-name equality, ignoring letter case.
 */
static bool leaf_same(const char *listed, const char *sought) {
  size_t n = strlen(listed);

  return strlen(sought) == n && cache_strncasecmp_n(listed, sought, n) == 0;
}

/*
 * Match a listed name spelt exactly as the one sought.
 */
static bool leaf_exact(const char *listed, const char *sought) {
  return strcmp(listed, sought) == 0;
}

/*
 * Match a listed name that differs from the one sought only in letter case.
 */
static bool leaf_case_twin(const char *listed, const char *sought) {
  return leaf_same(listed, sought) && strcmp(listed, sought) != 0;
}

/*
 * Return a pointer to the packed name bytes just past a directory's leafnames blob header, or NULL if it has no blob.
 */
static inline uint8_t *leafnames_body(const LMCacheNode_t *dir) {
  if (dir->u.dir.leafnames_blob == NULL) {
    return NULL;
  }

  return (uint8_t *)(dir->u.dir.leafnames_blob + 1);
}

/*
 * Find the index slot of a listed name that a matching rule accepts for the one sought.
 *
 * Only the names filed under the sought name's fold are tried, so this costs the same however long the listing is.  When a loose rule
 * accepts more than one name, the one listed first wins, as it would for a walk of the listing in order.
 *
 * Parameters:
 *   dir     directory whose listing is searched
 *   sought  name looked for
 *   match   returns true when a listed name answers for the sought one
 *
 * Returns: the slot, or -1 if no listed name is accepted.
 */
static int32_t leafidx_find_slot(const LMCacheNode_t *dir, const char *sought, bool (*match)(const char *listed, const char *sought)) {
  const LMLeafnamesBlobHdr_t *hdr = dir->u.dir.leafnames_blob;
  const char *body;
  uint32_t i;
  uint32_t probes;
  int32_t found = -1;

  if (hdr == NULL || hdr->index == NULL) {
    return -1;
  }

  body = (const char *)(hdr + 1);
  i = leaf_fold(sought) & hdr->index_mask;

  /* Linear probing: an empty slot ends the run of names that may be filed here; a removed one is stepped over. */
  for (probes = 0u; probes <= hdr->index_mask; probes++) {
    uint16_t v = hdr->index[i];

    if (v == LEAFIDX_EMPTY) {
      break;
    }

    /* Among the names the matcher accepts, keep the one listed first, so the answer does not depend on where probing started. */
    if (v != LEAFIDX_GONE && (found < 0 || v < hdr->index[found]) && match(body + v - 1u, sought)) {
      found = (int32_t)i;
    }

    i = (i + 1u) & hdr->index_mask;
  }

  return found;
}

/*
 * File a name at its body offset in an index with room to spare.
 */
static void leafidx_place(uint16_t *index, uint16_t mask, const char *name, size_t offset) {
  uint32_t i = leaf_fold(name) & mask;

  while (index[i] != LEAFIDX_EMPTY) {
    i = (i + 1u) & mask;
  }

  index[i] = (uint16_t)(offset + 1u);
}

/*
 * Build a fresh index over a listing's body, sized so that it is at most half full with one more name added.
 *
 * This is also how the marks of removed names are cleared from the index.  On failure the old index is left in place, still valid.
 *
 * Parameters:
 *   cache  per-mount cache
 *   dir    directory whose listing is indexed
 *
 * Returns: false if the content heap had no room for the index.
 */
static bool leafidx_rebuild(LMCache_t *cache, LMCacheNode_t *dir) {
  LMLeafnamesBlobHdr_t *hdr = dir->u.dir.leafnames_blob;
  const uint8_t *body = leafnames_body(dir);
  const uint8_t *p;
  const uint8_t *end = body + dir->u.dir.leafnames_size;
  uint32_t live = 0u;
  uint32_t slots = LEAFIDX_FIRST_SLOTS;
  uint16_t *index;

  for (p = body; p < end && *p != '\0'; p += strlen((const char *)p) + 1u) {
    if (*p != LEAFNAME_GONE) {
      live++;
    }
  }

  /* Keep the index at most half full, so that probing stays short. */
  while (slots < 2u * (live + 1u)) {
    slots <<= 1;
  }

  index = (uint16_t *)srheap_claim(&cache->content_heap, slots * sizeof(uint16_t));

  if (index == NULL) {
    return false;
  }

  memset(index, 0, slots * sizeof(uint16_t));

  /* File each name still listed under its hash. */
  for (p = body; p < end && *p != '\0'; p += strlen((const char *)p) + 1u) {
    if (*p != LEAFNAME_GONE) {
      leafidx_place(index, (uint16_t)(slots - 1u), (const char *)p, (size_t)(p - body));
    }
  }

  /* Swap the new index in only once it is complete, so a failed claim above leaves the old one in use. */
  if (hdr->index != NULL) {
    srheap_free(&cache->content_heap, hdr->index);
  }

  hdr->index = index;
  hdr->index_mask = (uint16_t)(slots - 1u);
  hdr->index_filled = (uint16_t)live;

  return true;
}

/*
 * Squeeze removed names out of a listing's body, so their bytes can take new ones, and re-index what remains.
 *
 * Moving names moves their offsets, so on failure to re-index the listing is dropped rather than left with an index that is wrong.
 *
 * Parameters:
 *   cache  per-mount cache
 *   dir    directory whose listing is compacted
 *
 * Returns: false if the listing had to be dropped.
 */
static bool leafnames_compact(LMCache_t *cache, LMCacheNode_t *dir) {
  uint8_t *body = leafnames_body(dir);
  uint8_t *end = body + dir->u.dir.leafnames_size;
  uint8_t *from;
  uint8_t *to = body;

  /* Slide the names still listed down over the removed ones, keeping their order. */
  for (from = body; from < end && *from != '\0';) {
    size_t entry = strlen((const char *)from) + 1u;

    if (*from != LEAFNAME_GONE) {
      memmove(to, from, entry);
      to += entry;
    }

    from += entry;
  }

  /* A reader walks the body to its closing empty name, so the compacted list must end with one. */
  *to++ = '\0';
  dir->u.dir.leafnames_size = (uint16_t)(to - body);
  dir->u.dir.leafnames_blob->gone_bytes = 0u;

  if (!leafidx_rebuild(cache, dir)) {
    cache_leafnames_release(cache, dir);
    return false;
  }

  return true;
}

/*
 * Add a child leaf name to a directory's packed leafnames blob.
 *
 * The fast-miss path depends on a definitive directory's blob being the complete child list, so a name created or learned since the listing
 * was built is spliced in here rather than forcing a re-enumeration. Idempotent: a leaf already present counts as success. Fails when
 * there is no blob to extend, the cnode is not a directory, the name will not fit the current capacity even with removed names squeezed
 * out, or the index cannot grow; the caller then drops definitiveness rather than keep an incomplete list.
 *
 * Parameters:
 *   cache  per-mount cache owning the blob
 *   dir    directory cnode to extend
 *   leaf   NUL-terminated child leaf name to add
 *
 * Returns: true if the leaf is present after the call (already listed or newly appended), false if it could not be added.
 */
static bool cache_leafnames_append(LMCache_t *cache, LMCacheNode_t *dir, const char *leaf) {
  LMLeafnamesBlobHdr_t *hdr;
  size_t leaf_len;
  size_t offset;
  uint8_t *insert;

  if (cache == NULL || dir == NULL || dir->obj_type != LMCACHE_OBJECT_DIRECTORY || dir->u.dir.leafnames_blob == NULL) {
    return false;
  }

  if (leaf == NULL || leaf[0] == '\0') {
    return false;
  }

  /* Already listed: a server on a case-sensitive file system can list two names this cache counts as one. */
  if (leafidx_find_slot(dir, leaf, leaf_same) >= 0) {
    return true;
  }

  /* One extra byte for the new name's terminator; the blob's existing final NUL becomes the separator before it. */
  leaf_len = strlen(leaf);

  /* Short of room: names removed earlier may be holding enough of it. */
  if ((size_t)dir->u.dir.leafnames_size + leaf_len + 1u > (size_t)dir->u.dir.leafnames_capacity &&
      dir->u.dir.leafnames_blob->gone_bytes != 0u && !leafnames_compact(cache, dir)) {
    return false;
  }

  /* Refuse rather than grow the blob; the caller drops definitiveness when the list would overflow capacity. */
  if ((size_t)dir->u.dir.leafnames_size + leaf_len + 1u > (size_t)dir->u.dir.leafnames_capacity) {
    return false;
  }

  /* Make room in the index before touching the body, so a failure leaves the listing as it was. */
  hdr = dir->u.dir.leafnames_blob;

  if ((hdr->index == NULL || ((uint32_t)hdr->index_filled + 1u) * 4u > ((uint32_t)hdr->index_mask + 1u) * 3u) &&
      !leafidx_rebuild(cache, dir)) {
    return false;
  }

  /* Overwrite the blob's terminating NUL with the new name, then re-lay the name-separator NUL and the double-NUL end marker. */
  offset = (size_t)dir->u.dir.leafnames_size - 1u;
  insert = leafnames_body(dir) + offset;
  memcpy(insert, leaf, leaf_len);
  insert[leaf_len] = '\0';
  insert[leaf_len + 1u] = '\0';
  dir->u.dir.leafnames_size = (uint16_t)((size_t)dir->u.dir.leafnames_size + leaf_len + 1u);

  leafidx_place(hdr->index, hdr->index_mask, (const char *)insert, offset);
  hdr->index_filled++;

  return true;
}

/*
 * Take a single leaf out of a directory's leafnames blob.
 *
 * Used when a delete or same-directory rename removes a child: keeps the fast-miss list consistent without rebuilding the whole blob.
 * The name is marked removed where it lies rather than closed up, so no other name moves and the index stays true.  A listing a scan is
 * still building is kept true too, since the scan may already have passed the name.  A no-op for a directory with no listing.
 *
 * Parameters:
 *   dir   directory cnode owning the blob
 *   leaf  leaf name to remove
 */
static void cache_leafnames_remove(LMCacheNode_t *dir, const char *leaf) {
  LMLeafnamesBlobHdr_t *hdr;
  int32_t slot;
  uint8_t *name;

  if (dir == NULL || dir->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    return;
  }

  /* An empty name is never stored, so no listing holds it. */
  if (leaf == NULL || leaf[0] == '\0' || dir->u.dir.leafnames_blob == NULL) {
    return;
  }

  slot = leafidx_find_slot(dir, leaf, leaf_same);

  if (slot < 0) {
    return;
  }

  /* The name is marked gone in place rather than removed, so no other offset moves; leafnames_compact reclaims the bytes later. */
  hdr = dir->u.dir.leafnames_blob;
  name = leafnames_body(dir) + hdr->index[slot] - 1u;
  hdr->gone_bytes = (uint16_t)(hdr->gone_bytes + strlen((const char *)name) + 1u);
  hdr->index[slot] = LEAFIDX_GONE;
  name[0] = LEAFNAME_GONE;
}

const char *Cache_ListingFind(const LMCacheNode_t *listing, const char *sought,
                              bool (*equivalent)(const char *listed, const char *sought)) {
  int32_t slot;

  if (listing == NULL || sought == NULL || equivalent == NULL || listing->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    return NULL;
  }

  slot = leafidx_find_slot(listing, sought, equivalent);

  if (slot < 0) {
    return NULL;
  }

  return (const char *)leafnames_body(listing) + listing->u.dir.leafnames_blob->index[slot] - 1u;
}

/*
 * Report whether a directory's leafnames blob is its complete, unexpired list of children.
 *
 * The blob carries its own expiry, separate from the directory cnode's own details, so this is the test for anything that answers
 * presence or absence from the blob.
 *
 * Parameters:
 *   dir  cnode to test; NULL, or anything but a directory, yields false
 *
 * Returns: true if the blob may be trusted.
 */
static bool listing_usable(const LMCacheNode_t *dir) {
  if (dir == NULL || dir->obj_type != LMCACHE_OBJECT_DIRECTORY || (dir->flags & LMCACHE_FLAG_DEFINITIVE) == 0u ||
      dir->u.dir.leafnames_blob == NULL || lm_clock_fn == NULL) {
    return false;
  }

  return dir->u.dir.leafnames_blob->expires_at > cache_now();
}

bool Cache_PathRuledOut(LMCache_t *cache, const char *dir_path, bool (*equivalent)(const char *listed, const char *sought)) {
  char path[LMCACHE_PATH_BUF_BYTES];
  size_t len;

  if (cache == NULL || dir_path == NULL || equivalent == NULL) {
    return false;
  }

  dir_path = skip_leading_sep(dir_path);
  len = strlen(dir_path);

  if (len >= sizeof path) {
    return false;
  }

  /* Work on a copy, because the walk shortens the path one name at a time. */
  memcpy(path, dir_path, len + 1u);

  /* Climb one directory at a time until a directory on the way is cached as absent or has a current listing. */
  while (path[0] != '\0') {
    const LMCacheNode_t *node = Cache_Lookup(cache, path);
    const LMCacheNode_t *listing;
    char *sep;
    const char *name;

    if (node != NULL && node->obj_type == LMCACHE_OBJECT_NOTHING) {
      vdebug("PATH_RULED_OUT path=\"%s\" absent=\"%s\"\n", dir_path, path);
      return true;
    }

    /* Split off the last name; the share root is the empty path. */
    sep = strrchr(path, '\\');

    if (sep != NULL) {
      *sep = '\0';
      name = sep + 1;
    } else {
      name = path;
    }

    listing = Cache_LookupListing(cache, (sep != NULL) ? path : "");

    /* A listing that leaves some of the server's entries out cannot rule on a name it lacks. */
    if (listing != NULL) {
      bool missing = (listing->flags & LMCACHE_FLAG_UNLISTED_ENTRIES) == 0u && Cache_ListingFind(listing, name, equivalent) == NULL;

      if (missing) {
        vdebug("PATH_RULED_OUT path=\"%s\" by_listing=\"%s\" lacks=\"%s\"\n", dir_path, (sep != NULL) ? path : "(root)", name);
      }

      return missing;
    }

    if (sep == NULL) {
      break;
    }
  }

  return false;
}

bool Cache_DirNotCacheable(LMCache_t *cache, const char *dir_path) {
  const LMCacheNode_t *dir;

  if (cache == NULL || dir_path == NULL) {
    return false;
  }

  dir = find_path_any(cache, skip_leading_sep(dir_path));

  return dir != NULL && dir->obj_type == LMCACHE_OBJECT_DIRECTORY &&
         (dir->flags & (LMCACHE_FLAG_EXCEEDS_CACHE | LMCACHE_FLAG_CASE_TWINS)) != 0u;
}

LMCacheNode_t *Cache_LookupListing(LMCache_t *cache, const char *dir_path) {
  LMCacheNode_t *dir;

  if (cache == NULL || dir_path == NULL) {
    return NULL;
  }

  dir = find_path_any(cache, skip_leading_sep(dir_path));

  return listing_usable(dir) ? dir : NULL;
}

LMLeafStatus_t Cache_DirHasLeaf(const LMCacheNode_t *dir, const char *leaf) {
  /* No usable inputs, including an empty leaf name; leave the answer to the wire. */
  if (dir == NULL || leaf == NULL || leaf[0] == '\0') {
    return LM_LEAF_UNKNOWN;
  }

  /* Only a complete listing that has not expired can answer authoritatively; anything else is unknown. */
  if (!listing_usable(dir)) {
    return LM_LEAF_UNKNOWN;
  }

  if (leafidx_find_slot(dir, leaf, leaf_same) >= 0) {
    return LM_LEAF_PRESENT;
  }

  /* A listing that leaves some of the server's entries out cannot show that a name is absent. */
  if ((dir->flags & LMCACHE_FLAG_UNLISTED_ENTRIES) != 0u) {
    return LM_LEAF_UNKNOWN;
  }

  /* Absence from a definitive blob is authoritative, not unknown, so the caller can skip the wire entirely. */
  return LM_LEAF_ABSENT;
}

/*
 * Evict a cnode and, if it is a directory, its entire subtree, children before parents.
 *
 * Directory eviction must cascade: a delete or a rename tears down a whole subtree, and every file or negative child carries a parent
 * pointer that would dangle if its directory were freed first. The walk follows the child lists down to a cnode with no children left,
 * evicts it and steps back up, so each cnode in the subtree is visited once and nothing outside it is looked at. The mount root is pinned,
 * so evicting it drops the subtree and clears the root's blob but keeps the root slot itself.
 *
 * Parameters:
 *   cache         per-mount cache
 *   subtree_root  cnode at the top of the subtree to evict
 */
static void cache_evict_subtree(LMCache_t *cache, LMCacheNode_t *subtree_root) {
  LMCacheNode_t *node;

  if (subtree_root == NULL) {
    return;
  }

  /* A file or negative has no subtree: detach it from the LRU (fixing the hot count) and evict it directly. */
  if (subtree_root->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    if (subtree_root->u.file.prev != NULL) {
      if ((subtree_root->flags & LMCACHE_FLAG_HOT) != 0u) {
        cache->hot_len--;
      }

      lru_unlink(subtree_root);
    }

    evict_node(cache, subtree_root);

    return;
  }

  node = subtree_root;

  for (;;) {
    LMCacheNode_t *up;

    /* Go down to a cnode with no children left; back at the top means the whole subtree beneath it is gone. */
    while (node->first_child != NULL) {
      node = node->first_child;
    }

    if (node == subtree_root) {
      break;
    }

    /* Detach a file from the LRU (adjusting the hot count); evict_node frees a directory's leafnames blob. */
    if (node->obj_type != LMCACHE_OBJECT_DIRECTORY) {
      if ((node->flags & LMCACHE_FLAG_HOT) != 0u) {
        cache->hot_len--;
      }

      lru_unlink(node);
    }

    up = node->parent;
    evict_node(cache, node);
    node = up;
  }

  /* The mount root keeps its slot and loses only its blob, so the next enumeration rebuilds the listing there. */
  if (subtree_root == cache->root_node) {
    cache_leafnames_release(cache, subtree_root);
  } else {
    evict_node(cache, subtree_root);
  }
}

/*
 * Make sure every directory on a path has a cnode, so that entries beneath it can be hung from the tree.
 *
 * A missing directory is added as an expired placeholder, so a lookup of the directory itself still asks the server.
 *
 * Parameters:
 *   cache     per-mount cache
 *   dir_path  share-relative path of the directory; empty for the share root
 *
 * Returns: the directory's cnode, or NULL if the path is too long, a component is cached as something other than a directory, or there
 * is no room for a placeholder.
 */
static LMCacheNode_t *cache_ensure_dir_chain_cached(LMCache_t *cache, const char *dir_path) {
  size_t i;
  size_t total_len;
  LMCacheNode_t *parent;
  LMCacheNode_t *node;
  char scratch[LMCACHE_PATH_BUF_BYTES];

  if (dir_path == NULL) {
    return NULL;
  }

  if (dir_path[0] == '\0') {
    return cache->root_node;
  }

  total_len = strlen(dir_path);

  /* Refuse paths too long for the component scratch buffer. */
  if (total_len + 1u > sizeof(scratch)) {
    debug("ENSURE_CHAIN_FAIL path=\"%s\" reason=path_too_long len=%u limit=%u\n", dir_path, (unsigned)total_len, (unsigned)sizeof(scratch));
    return NULL;
  }

  /* Start at the root and walk the components, building each cumulative prefix in turn. */
  parent = cache->root_node;

  i = 0u;

  /* Consume one path component per iteration. */
  while (i < total_len) {
    size_t j = i;
    size_t prefix_len;

    /* Scan to the next backslash to find the end of this component. */
    while (j < total_len && dir_path[j] != '\\') {
      j++;
    }

    /* prefix_len runs from the path start, so scratch holds the full prefix: directories are keyed by their whole DOS path. */
    prefix_len = j;

    /* Skip empty components from a leading or doubled backslash. */
    if (prefix_len == 0u || j == i) {
      i = j + 1u;
      continue;
    }

    /* Materialise the prefix string and look for an existing cnode. */
    memcpy(scratch, dir_path, prefix_len);
    scratch[prefix_len] = '\0';

    node = find_path_any(cache, scratch);

    /* Missing, so insert a directory cnode for this component. */
    if (node == NULL) {
      node = cache_insert_or_refresh(cache, parent, scratch, LMCACHE_OBJECT_DIRECTORY, 0u, 0u, 0u, 0u);

      /* No room for the component: the chain cannot be built. */
      if (node == NULL) {
        debug("ENSURE_CHAIN_FAIL path=\"%s\" reason=substrate_exhausted at_component=\"%s\"\n", dir_path, scratch);
        return NULL;
      }

      /* Mark it a placeholder (immediately stale) so a lookup still asks the server; it exists only to hang children off. */
      node->expires_at = 0u;
    } else if (node->obj_type != LMCACHE_OBJECT_DIRECTORY) {
      /* A file sits where a directory was expected, so the path is invalid. */
      debug("ENSURE_CHAIN_FAIL path=\"%s\" reason=non_directory_on_path at_component=\"%s\" type=%u\n", dir_path, scratch,
            (unsigned)node->obj_type);
      return NULL;
    }

    /* Descend into the component and step past the separator. */
    parent = node;
    i = j + 1u;
  }

  return parent;
}

/*
 * Report whether every child a directory's listing names is cached with details that are still current.
 *
 * A serve from the listing hands out each child's cnode as it stands, so it is safe only while none of them has expired or been evicted
 * to make room.  A file the server reports modified, or one listed with a size the server may not have caught up with, is expired or
 * given a short life on its own: the names in the listing still stand, so lookups by name go on using it, and only a serve of the
 * details goes back to the server.
 *
 * Parameters:
 *   cache  per-mount cache
 *   dir    directory with a usable listing
 *
 * Returns: true if the listing can be served as it stands.
 */
static bool listing_details_current(LMCache_t *cache, const LMCacheNode_t *dir) {
  const uint8_t *p = (const uint8_t *)(dir->u.dir.leafnames_blob + 1);
  const uint8_t *end = p + dir->u.dir.leafnames_size;
  const char *parent_path = (dir == cache->root_node) ? "" : (dir->name != NULL ? dir->name : "");
  char child_path[LMCACHE_PATH_BUF_BYTES];
  LMCacheTime_t now = cache_now();

  for (; p < end && *p != '\0'; p += strlen((const char *)p) + 1u) {
    const LMCacheNode_t *child;

    /* A removed name is no longer listed. */
    if (*p == LEAFNAME_GONE) {
      continue;
    }

    /* A name the cache cannot hold a path for, or holds no current details for, has to come from the server. */
    if (!path_compose_child(child_path, sizeof(child_path), parent_path, (const char *)p, strlen((const char *)p))) {
      return false;
    }

    child = find_path_any(cache, child_path);

    if (child == NULL || child->obj_type == LMCACHE_OBJECT_NOTHING || child->expires_at <= now) {
      return false;
    }
  }

  return true;
}

/*
 * Serve a directory's children to the visitor from its listing, with no wire traffic.
 *
 * Each name in the listing is looked up as a cnode and handed to the visitor.  The caller has already checked that the listing is
 * definitive and current and that its children's details are current.  A name with no live cnode behind it (none, or a negative) is
 * skipped and counted as a miss, the sign that the listing and the slab have drifted apart.  The directory is promoted on every exit.
 *
 * Parameters:
 *   cache     per-mount cache
 *   dir_node  the directory being listed
 *   visitor   called once per child, or NULL; returning false halts the walk
 *   user      passed through to the visitor
 *
 * Returns: the number of children offered to the visitor, or that would have been with no visitor.
 */
static uint32_t cache_serve_from_blob(LMCache_t *cache, LMCacheNode_t *dir_node, Cache_EnumVisitor_t visitor, void *user) {
  /*
   * Counters separate leaves walked, live children found and leaves whose cnode is missing; the miss tally flags drift between a
   * definitive blob and an evicted child.
   */
  uint32_t count = 0u;
  uint32_t walked = 0u;
  uint32_t missed = 0u;
  const uint8_t *p;
  const uint8_t *end;
  const char *parent_path;
  char child_path[LMCACHE_PATH_BUF_BYTES];

  /* No packed blob means there is nothing to serve from cache. */
  if (dir_node->u.dir.leafnames_blob == NULL) {
    /* Route even the empty-blob exit through promote so recency handling stays on one path. */
    promote(cache, dir_node);
    return 0u;
  }

  /* The root enumerates under an empty prefix; the names start just past the blob's header and run for leafnames_size bytes. */
  parent_path = (dir_node == cache->root_node) ? "" : (dir_node->name != NULL ? dir_node->name : "");
  p = (const uint8_t *)(dir_node->u.dir.leafnames_blob + 1);
  end = p + dir_node->u.dir.leafnames_size;

  debug("SERVE_BLOB dir=\"%s\" size=%u capacity=%u\n", parent_path, (unsigned)dir_node->u.dir.leafnames_size,
        (unsigned)dir_node->u.dir.leafnames_capacity);

  /* Walk each NUL-terminated leaf up to the blob's double-NUL terminator, composing its full DOS path for the lookup. */
  while (p < end && *p != '\0') {
    size_t leaf_len = strlen((const char *)p);

    /* A removed name keeps its place in the body until the listing is compacted, but is no longer listed. */
    if (*p == LEAFNAME_GONE) {
      p += leaf_len + 1u;
      continue;
    }

    walked++;

    /* Skip a leaf whose composed path would overflow the buffer rather than deliver it truncated. */
    if (path_compose_child(child_path, sizeof(child_path), parent_path, (const char *)p, leaf_len)) {
      LMCacheNode_t *child = find_path_any(cache, child_path);

      /* Deliver only names whose cnode is still cached as present: a negative records absence and must never appear in a listing. */
      if (child != NULL && child->obj_type != LMCACHE_OBJECT_NOTHING) {
        count++;

        /*
         * Honour an early halt from the visitor: promote and return the partial count so a caller that stops reading doesn't force a
         * full walk.
         */
        if (visitor != NULL) {
          if (!visitor(child, user)) {
            debug("SERVE_BLOB dir=\"%s\" early-exit walked=%u found=%u missed=%u (visitor halted)\n", parent_path, (unsigned)walked,
                  (unsigned)count, (unsigned)missed);
            promote(cache, dir_node);

            return count;
          }
        }
      } else {
        /* The blob names a leaf no cnode backs: the drift signal between the definitive blob and the slab. */
        missed++;
        debug("SERVE_BLOB miss leaf=\"%s\" composed=\"%s\"\n", (const char *)p, child_path);
      }
    }

    p += leaf_len + 1u;
  }

  /*
   * The walked and missed tallies feed only the debug line, so void them for release builds; promote before the normal return keeps
   * recency on one path.
   */
  debug("SERVE_BLOB dir=\"%s\" walked=%u found=%u missed=%u\n", parent_path, (unsigned)walked, (unsigned)count, (unsigned)missed);
  (void)walked;
  (void)missed;

  promote(cache, dir_node);

  return count;
}

/*
 * Join a parent directory path and a leaf into a full canonical DOS path.
 *
 * The inverse of path_split_parent: a NULL or empty parent denotes the share root, so the child is the leaf alone with no leading
 * separator.  The leaf is passed with an explicit length rather than being taken as a C string, so it may be a non-terminated slice out
 * of a packed leafnames blob.
 *
 * Parameters:
 *   out_buf   buffer to receive the composed path, null-terminated on success
 *   out_size  size of out_buf in bytes
 *   parent    parent path, or NULL/empty for the share root
 *   leaf      final component; need not be null-terminated
 *   leaf_len  length of leaf in bytes
 *
 * Returns: true on success, false if out_buf is too small to hold the result and its terminator.
 */
static bool path_compose_child(char *out_buf, size_t out_size, const char *parent, const char *leaf, size_t leaf_len) {
  /* Treat a NULL parent as the empty root path. */
  size_t parent_len = (parent == NULL) ? 0u : strlen(parent);
  size_t needed;

  /* Root case: the child path is the leaf alone with no separator. */
  if (parent_len == 0u) {
    needed = leaf_len + 1u;

    if (needed > out_size) {
      return false;
    }

    memcpy(out_buf, leaf, leaf_len);
    out_buf[leaf_len] = '\0';

    return true;
  }

  /* Parent, one separator, leaf, and the terminator. */
  needed = parent_len + 1u + leaf_len + 1u;

  if (needed > out_size) {
    return false;
  }

  /* Backslash is the DOS/SMB wire separator between path components. */
  memcpy(out_buf, parent, parent_len);
  out_buf[parent_len] = '\\';
  memcpy(out_buf + parent_len + 1u, leaf, leaf_len);
  out_buf[parent_len + 1u + leaf_len] = '\0';

  return true;
}

/* Fill a throwaway stack cnode from a wire record, named by its full path; it is handed to a visitor but never linked into the cache. */
static void synth_from_record(LMCacheNode_t *synth, const LMCacheWireRecord_t *rec, char *path) {
  memset(synth, 0, sizeof *synth);
  synth->obj_type = rec->obj_type;
  synth->load_addr = rec->load_addr;
  synth->exec_addr = rec->exec_addr;
  synth->length = rec->length;
  synth->attrs = rec->attrs;
  synth->name = path;
  synth->name_len = (uint16_t)strlen(path);
}

/*
 * Deliver the rest of a scan straight to the visitor through a throwaway stack cnode, caching nothing, for when the directory cannot be
 * cached.
 *
 * Every remaining reply is read, even after the visitor halts, and each record is counted.
 *
 * Parameters:
 *   cache     per-mount cache, for its wire hooks
 *   state     the scan in progress
 *   dir_path  path of the directory being listed
 *   visitor   called with each entry while it returns true, or NULL
 *   user      passed to the visitor
 *   p_total   incremented for each entry read
 *   p_halt    set when the visitor returns false; once set, no further entries are visited
 *
 * Returns: the result that ended the scan; LMCACHE_WIRE_NO_MORE_ENTRIES only if it ran to the end.
 */
static LMCacheWireResult_t wire_drain_deliver(LMCache_t *cache, LMCacheWireState_t *state, const char *dir_path,
                                              Cache_EnumVisitor_t visitor, void *user, uint32_t *p_total, bool *p_halt) {
  LMCacheWireRecord_t rec;
  LMCacheWireResult_t wire_rc = LMCACHE_WIRE_OK;
  char child_path[LMCACHE_PATH_BUF_BYTES];

  /* Outer loop pulls each QUERY_DIRECTORY chunk; inner loop walks the records within it, until the wire signals no more. */
  while (wire_rc == LMCACHE_WIRE_OK) {
    while (cache->wire.iter(cache->wire.ctx, state, &rec)) {
      LMCacheNode_t synth;

      /* Skip records the wire could not name. */
      if (rec.name == NULL || rec.name_len == 0u) {
        continue;
      }

      /* Skip an entry whose full path won't fit rather than deliver it truncated. */
      if (!path_compose_child(child_path, sizeof(child_path), dir_path, rec.name, rec.name_len)) {
        continue;
      }

      synth_from_record(&synth, &rec, child_path);

      /* Only deliver while the visitor is still accepting; once it has halted, keep draining the wire but stop calling it. */
      if (visitor != NULL && !*p_halt) {
        vdebug("VISITOR_DELIVER (degraded) path=\"%s\" leaf=\"%s\"\n", dir_path, rec.name);

        /* A false return latches the halt flag for the rest of the drain. */
        if (!visitor(&synth, user)) {
          *p_halt = true;
        }
      }

      (*p_total)++;
    }

    /* Advance to the next chunk; a non-OK result ends the drain. */
    wire_rc = cache->wire.next(cache->wire.ctx, state);
  }

  return wire_rc;
}

/*
 * Report whether a directory's leafnames blob names one of its child cnodes.
 *
 * Directory cnodes are named by full path and files by leaf, so the leaf is taken from after the last separator either way.
 *
 * Parameters:
 *   dir    directory whose blob is searched; must hold one
 *   child  cnode whose leaf is sought
 *
 * Returns: true if the blob lists the child's leaf.
 */
static bool blob_names_child(LMCacheNode_t *dir, const LMCacheNode_t *child) {
  const char *leaf;

  if (child->name == NULL || dir->u.dir.leafnames_blob == NULL) {
    return false;
  }

  leaf = strrchr(child->name, '\\');
  leaf = (leaf != NULL) ? leaf + 1 : child->name;

  /* Beneath a directory that held case twins, a child left over in another spelling is a different object the listing does not name. */
  return leafidx_find_slot(dir, leaf, ((dir->flags & LMCACHE_FLAG_CASE_TWINS) != 0u) ? leaf_exact : leaf_same) >= 0;
}

/*
 * Stop building a directory's listing once it has proved too big for the cache.
 *
 * Drops the part-built blob, so the rest of the scan neither fills the cache with entries that can never form a complete listing nor
 * forces other directories out to make room for them.
 *
 * Parameters:
 *   cache       per-mount cache
 *   dir_node    directory being enumerated
 *   built_for   the enumeration's record of which node its blob belongs to; cleared
 *   oversized   the enumeration's too-big flag; set
 */
static void cache_enum_give_up_listing(LMCache_t *cache, LMCacheNode_t *dir_node, LMCacheNode_t **built_for, bool *oversized) {
  if (*built_for == dir_node) {
    cache_leafnames_release(cache, dir_node);
  }

  *built_for = NULL;
  *oversized = true;
}

/* Cap a lifetime deadline at one metadata lifetime from now, since a server quirk recognised during a scan can shorten that lifetime. */
static inline LMCacheTime_t cap_at_metadata_ttl(const LMCache_t *cache, LMCacheTime_t deadline, LMCacheTime_t now) {
  return (deadline > now + cache->metadata_ttl) ? now + cache->metadata_ttl : deadline;
}

/*
 * Clamp the lifetime of each file listed with a size that may lag its data to the short grace lifetime, so its length is soon read again.
 *
 * Called on each exit taken with the directory cnode in hand, after the scan may have cached such a file.  The normal exit calls it after
 * the cache-update sweep, because the sweep takes a child with a short lifetime for one the scan did not list.  An exit that has lost the
 * directory cnode needs no call, since its children went with it.  A file evicted or moved since it was listed is skipped.
 *
 * Parameters:
 *   cache     per-mount cache
 *   dir_node  directory the files were listed in
 *   suspects  files listed with a size that may lag their data
 *   count     number of entries in suspects
 */
static void cache_enum_shorten_suspects(const LMCache_t *cache, const LMCacheNode_t *dir_node, LMCacheNode_t *const *suspects,
                                        size_t count) {
  size_t s;
  LMCacheTime_t suspect_expiry;

  if (count == 0u) {
    return;
  }

  suspect_expiry = cache_now() + LMCACHE_DEFAULT_OVERFLOW_GRACE_TTL;

  for (s = 0u; s < count; s++) {
    LMCacheNode_t *slot = suspects[s];

    /* Re-validate that each suspect still belongs to this directory; it may have been evicted or moved since. */
    if (slot->mount != cache || slot->parent != dir_node) {
      continue;
    }

    /* Only ever shorten the expiry, never extend it. */
    if (slot->expires_at > suspect_expiry) {
      slot->expires_at = suspect_expiry;
    }
  }
}

LMCacheEnumResult_t Cache_EnumerateDirectory(LMCache_t *cache, const char *dir_path, Cache_EnumVisitor_t visitor, void *user) {
  /* Locals, plus the single-return ENUM_EXIT macro every exit funnels through so the trace always records why the enumeration ended. */
  LMCacheEnumResult_t result;
  LMCacheNode_t *dir_node;
  LMCacheWireState_t state;
  LMCacheWireRecord_t rec;
  LMCacheWireResult_t wire_rc;
  bool is_first;
  LMCacheTime_t now;
  uint32_t total_count;
  uint32_t gen_seen;
  LMCacheTime_t spec_touch_threshold;
  LMCacheNode_t *slot;
  LMCacheNode_t *older;
  char child_path[LMCACHE_PATH_BUF_BYTES];
  LMCacheNode_t *suspect_children[ENUM_SUSPECT_MAX];
  size_t suspect_count = 0u;
  LMCacheNode_t *built_for;
  bool wire_path_failed;
  bool oversized;
  bool case_twins;
  bool visitor_halt;
  const char *wire_failure_cause;

#define ENUM_EXIT(_reason)                                                                                                              \
  do {                                                                                                                                  \
    debug("ENUM_EXIT path=\"%s\" reason=%s dir_node=%p type=%u definitive=%u inserted=%u gen_start=%u gen_now=%u authoritative=%u "     \
          "served_from_cache=%u\n",                                                                                                     \
          dir_path != NULL ? dir_path : "(null)", _reason, (void *)dir_node, (unsigned)(dir_node != NULL ? dir_node->obj_type : 0xFFu), \
          (unsigned)(dir_node != NULL && dir_node->obj_type == LMCACHE_OBJECT_DIRECTORY                                                 \
                         ? ((dir_node->flags & LMCACHE_FLAG_DEFINITIVE) != 0u)                                                          \
                         : 0u),                                                                                                         \
          (unsigned)total_count, (unsigned)gen_seen, (unsigned)cache->mutation_gen, (unsigned)result.is_authoritative,                  \
          (unsigned)result.served_from_cache);                                                                                          \
    return result;                                                                                                                      \
  } while (0)

  /* Seed the result to the failure default (empty and non-authoritative) so any early return is safe. */
  result.child_count = 0u;
  result.is_authoritative = false;
  result.served_from_cache = false;
  result.not_found = false;
  result.wire_error = 0;

  dir_node = NULL;
  total_count = 0u;
  gen_seen = 0u;
  built_for = NULL;
  wire_path_failed = false;
  oversized = false;
  case_twins = false;
  visitor_halt = false;
  wire_failure_cause = NULL;
  (void)wire_failure_cause; // read only by debug lines, so unused in a release build

  if (cache == NULL || dir_path == NULL || lm_clock_fn == NULL) {
    /* Bad arguments yield the empty non-authoritative result already seeded. */
    debug("ENUM_EXIT path=\"%s\" reason=bad_args cache=%p clock_set=%d\n", dir_path != NULL ? dir_path : "(null)", (void *)cache,
          lm_clock_fn != NULL);
    return result;
  }

  /* Normalise away any leading separator so lookups key on the same form the cache stores. */
  dir_path = skip_leading_sep(dir_path);

  /* Cache-read step: note mutation_gen before touching the wire, then look up the directory cnode. */
  gen_seen = cache->mutation_gen;
  dir_node = find_path_any(cache, dir_path);
  now = cache_now();

  spec_touch_threshold = now + cache->metadata_ttl;

  /*
   * Served from the cache: a definitive, unexpired, non-oversized directory whose children's details are all current is served entirely
   * from its leafnames blob with no wire I/O.
   */
  if (listing_usable(dir_node) && (dir_node->flags & LMCACHE_FLAG_EXCEEDS_CACHE) == 0u && listing_details_current(cache, dir_node)) {
    result.child_count = cache_serve_from_blob(cache, dir_node, visitor, user);
    result.is_authoritative = true;
    result.served_from_cache = true;
    ENUM_EXIT("p1_blob_serve");
  }

  /* A fresh negative entry records that the directory does not exist, so the cache can report that on its own. */
  if (dir_node != NULL && dir_node->obj_type == LMCACHE_OBJECT_NOTHING && now < dir_node->expires_at) {
    result.served_from_cache = true;
    result.not_found = true;
    ENUM_EXIT("p1_negative_serve");
  }

  /* No wire vtable, so the server cannot be asked. */
  if (cache->wire.first == NULL || cache->wire.next == NULL || cache->wire.iter == NULL) {
    ENUM_EXIT("no_wire_vtable");
  }

  /*
   * An entry for this path that is not a directory (an expired negative, or a file the server may since have replaced) cannot hold the
   * listing: children would be keyed off its leaf name rather than the full path.  Drop it so the scan builds a proper directory entry.
   */
  if (dir_node != NULL && dir_node->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    evict_node_and_subtree(cache, dir_node);
    dir_node = NULL;
  }

  /* Wire-read step: reset the running count and wire state for the QUERY_DIRECTORY loop. */
  total_count = 0u;
  is_first = true;
  state.dir_path = dir_path;
  state.error = 0;
  state.unlisted = 0u;

  /* Drive the wire directly; freshness of what it returns comes from CHANGE_NOTIFY and the lifetimes. */
  for (;;) {
    if (is_first) {
      wire_rc = cache->wire.first(cache->wire.ctx, dir_path, &state);
      is_first = false;
    } else {
      wire_rc = cache->wire.next(cache->wire.ctx, &state);
    }

    if (wire_rc == LMCACHE_WIRE_NO_MORE_ENTRIES) {
      break;
    }

    /*
     * The server reports the directory gone: drop what is cached of it, with the parent's listing that names it, record it as absent so a
     * repeat lookup need not ask again, and stop.
     */
    if (wire_rc == LMCACHE_WIRE_OBJECT_NOT_FOUND) {
      if (dir_node != NULL && dir_node != cache->root_node) {
        invalidate_parent_enum_by_path(cache, dir_path);
        cache_evict_subtree(cache, dir_node);
        dir_node = NULL;
      }

      /* The negative hangs under the parent directory, which is made as a placeholder if it is not cached. */
      {
        char parent_buf[LMCACHE_PATH_BUF_BYTES];
        const char *leaf = NULL;
        LMCacheNode_t *parent_for_neg = resolve_parent_for_child(cache, dir_path, parent_buf, sizeof(parent_buf), &leaf);

        if (parent_for_neg == NULL && leaf != NULL) {
          parent_for_neg = cache_ensure_dir_chain_cached(cache, parent_buf);
        }

        if (parent_for_neg != NULL && parent_for_neg->obj_type == LMCACHE_OBJECT_DIRECTORY) {
          (void)cache_insert_nothing(cache, parent_for_neg, dir_path);
        }
      }

      cache->wire.discard_state(cache->wire.ctx, &state);
      result.not_found = true;
      ENUM_EXIT("server_not_found");
    }

    /* Transient wire error; give up without a definitive answer. */
    if (wire_rc != LMCACHE_WIRE_OK) {
      if (built_for != NULL && built_for == dir_node) {
        cache_leafnames_release(cache, dir_node);
      }

      cache->wire.discard_state(cache->wire.ctx, &state);
      result.wire_error = state.error;
      cache_enum_shorten_suspects(cache, dir_node, suspect_children, suspect_count);
      ENUM_EXIT("wire_transient");
    }

    /*
     * Core rule: anything that freed or re-keyed a cnode since the last look moved the generation, so re-resolve the directory when it
     * has moved.
     */
    /* cppcheck-suppress nullPointerRedundantCheck */
    if (cache->mutation_gen != gen_seen || dir_node == NULL) {
      dir_node = cache_ensure_dir_chain_cached(cache, dir_path);

      /* Cannot cache the directory; degrade to delivering records straight from the wire. */
      if (dir_node == NULL) {
        if (!wire_path_failed) {
          debug("WIRE_PATH_FAILED path=\"%s\" reason=ensure_chain_fail_first - degrading to wire-only delivery\n", dir_path);
          wire_failure_cause = "ensure_chain_fail_first";
          wire_path_failed = true;
        }

        /* Deliver whatever the wire still holds directly to the visitor; only a scan that ran to the end lists the whole directory. */
        if (wire_drain_deliver(cache, &state, dir_path, visitor, user, &total_count, &visitor_halt) == LMCACHE_WIRE_NO_MORE_ENTRIES) {
          result.is_authoritative = true;
        } else {
          result.wire_error = state.error;
        }

        result.child_count = total_count;
        ENUM_EXIT("ensure_chain_fail_first");
      }

      /* The directory cnode moved: the entries already read went into the old node's blob, so this scan can no longer list it fully. */
      if (built_for != NULL && built_for != dir_node) {
        if (!wire_path_failed) {
          debug("WIRE_PATH_FAILED path=\"%s\" reason=dir_moved\n", dir_path);
          wire_failure_cause = "dir_moved";
          wire_path_failed = true;
        }

        built_for = NULL;
      }

      /* Take the generation the re-resolved directory is good for. */
      gen_seen = cache->mutation_gen;
    }

    while (cache->wire.iter(cache->wire.ctx, &state, &rec)) {
      LMCacheNode_t *child;

      /* The cache moved mid-chunk: re-resolve the directory again before touching it. */
      if (cache->mutation_gen != gen_seen) {
        LMCacheNode_t *fresh_dir = cache_ensure_dir_chain_cached(cache, dir_path);

        /* Re-resolution failed; degrade this record and the remainder to wire-only delivery. */
        if (fresh_dir == NULL) {
          LMCacheNode_t synth;
          char child_path_local[LMCACHE_PATH_BUF_BYTES];

          /* Record the degradation cause once. */
          if (!wire_path_failed) {
            debug("WIRE_PATH_FAILED path=\"%s\" reason=ensure_chain_fail_iter - degrading to wire-only delivery\n", dir_path);
            wire_failure_cause = "ensure_chain_fail_iter";
            wire_path_failed = true;
          }

          /* Hand the current record to the visitor via a throwaway synth node. */
          if (rec.name != NULL && rec.name_len > 0u &&
              path_compose_child(child_path_local, sizeof(child_path_local), dir_path, rec.name, rec.name_len)) {
            synth_from_record(&synth, &rec, child_path_local);

            if (visitor != NULL && !visitor_halt) {
              vdebug("VISITOR_DELIVER (degraded) path=\"%s\" leaf=\"%s\"\n", dir_path, rec.name);

              if (!visitor(&synth, user)) {
                visitor_halt = true;
              }
            }

            total_count++;
          }

          /* Deliver whatever the wire still holds directly to the visitor; only a scan that ran to the end lists the whole directory. */
          if (wire_drain_deliver(cache, &state, dir_path, visitor, user, &total_count, &visitor_halt) == LMCACHE_WIRE_NO_MORE_ENTRIES) {
            result.is_authoritative = true;
          } else {
            result.wire_error = state.error;
          }

          cache->wire.discard_state(cache->wire.ctx, &state);
          result.child_count = total_count;
          ENUM_EXIT("ensure_chain_fail_iter");
        }

        /* The directory cnode moved: the entries already read went into the old node's blob, so this scan can no longer list it fully. */
        if (fresh_dir != dir_node) {
          if (!wire_path_failed) {
            debug("WIRE_PATH_FAILED path=\"%s\" reason=dir_moved\n", dir_path);
            wire_failure_cause = "dir_moved";
            wire_path_failed = true;
          }

          dir_node = fresh_dir;
          built_for = NULL;
        }

        /* Take the generation the re-resolved directory is good for. */
        gen_seen = cache->mutation_gen;
      }

      /* Begin packing this directory's leafnames blob, unless the listing is already known to be incomplete. */
      if (built_for != dir_node && !wire_path_failed) {
        if (cache_leafnames_begin_build(cache, dir_node)) {
          built_for = dir_node;
        } else {
          debug("WIRE_PATH_FAILED path=\"%s\" reason=blob_init\n", dir_path);
          wire_failure_cause = "blob_init";
          wire_path_failed = true;
        }
      }

      if (rec.name == NULL || rec.name_len == 0u) {
        continue;
      }

      /* Compose the child path, skipping an entry whose path would not fit. */
      if (!path_compose_child(child_path, sizeof(child_path), dir_node->name, rec.name, rec.name_len)) {
        continue;
      }

      /*
       * Two names differing only in case are two objects, which one cnode cannot stand for.  Drop the cnode the first twin was cached as,
       * then pass the rest of the listing on uncached, as for a directory too big to hold.
       */
      if (!oversized) {
        LMCacheTime_t refreshed_from = cap_at_metadata_ttl(cache, spec_touch_threshold, now);
        LMCacheNode_t *twin;

        twin = find_listed_twin(cache, dir_node, child_path, refreshed_from);

        if (twin != NULL) {
          debug("CASE_TWINS_SET path=\"%s\" leaf=\"%s\"\n", dir_path, rec.name);

          if (twin->obj_type == LMCACHE_OBJECT_DIRECTORY) {
            evict_node_and_subtree(cache, twin);
          } else {
            evict_node_only(cache, twin);
          }

          dir_node->flags |= LMCACHE_FLAG_CASE_TWINS;
          wire_failure_cause = "case_twins";
          wire_path_failed = true;
          case_twins = true;
          cache_enum_give_up_listing(cache, dir_node, &built_for, &oversized);
        }
      }

      /* A directory holding more than its share of the slab would push the rest of the cache out every time it was read. */
      if (!oversized && total_count >= cache->slab_capacity / LMCACHE_LISTING_SLAB_SHARE) {
        debug("WIRE_PATH_FAILED path=\"%s\" reason=too_many_entries count=%u\n", dir_path, (unsigned)total_count);
        wire_failure_cause = "too_many_entries";
        wire_path_failed = true;
        cache_enum_give_up_listing(cache, dir_node, &built_for, &oversized);
      }

      /* Once the directory is known to be too big for the cache, the rest of its entries are only passed on, not cached. */
      child = NULL;

      /* Insert or refresh the entry's cnode, the fields hoisted into locals to sidestep the Norcroft uint64 argument miscompile. */
      if (!oversized) {
        uint8_t loc_obj_type = rec.obj_type;
        uint32_t loc_load_addr = rec.load_addr;
        uint32_t loc_exec_addr = rec.exec_addr;
        uint64_t loc_length = rec.length;
        uint32_t loc_attrs = rec.attrs;
        child = cache_insert_or_refresh(cache, dir_node, child_path, loc_obj_type, loc_load_addr, loc_exec_addr, loc_length, loc_attrs);
      }

      /* Show the server's spelling of a name another client has changed only in letter case. */
      if (child != NULL) {
        respell_listed_child(child, child_path);
      }

      /* Stamp the resolved-symlink flag to match the wire record. */
      if (child != NULL && child->obj_type == LMCACHE_OBJECT_FILE) {
        if (rec.is_resolved_symlink) {
          child->flags |= LMCACHE_FLAG_RESOLVED_SYMLINK;
        } else {
          child->flags &= (uint8_t)~LMCACHE_FLAG_RESOLVED_SYMLINK;
        }

        /* Stamp the inert-symlink flag to match the wire record. */
        if (rec.is_inert_symlink) {
          child->flags |= LMCACHE_FLAG_INERT_SYMLINK;
        } else {
          child->flags &= (uint8_t)~LMCACHE_FLAG_INERT_SYMLINK;
        }
      }

      /* Remember files whose listed size may lag the data being written to them, so their lifetimes can be clamped later. */
      if (child != NULL && rec.size_suspect && child->obj_type == LMCACHE_OBJECT_FILE) {
        if (suspect_count < ENUM_SUSPECT_MAX) {
          suspect_children[suspect_count++] = child;
        }
      }

      /*
       * A change notification handled during the last wire call can have dropped the listing being built.  The scan can then no longer
       * list the directory fully, though that says nothing about its size.
       */
      if (built_for == dir_node && dir_node->u.dir.leafnames_blob == NULL) {
        debug("WIRE_PATH_FAILED path=\"%s\" reason=listing_dropped\n", dir_path);
        wire_failure_cause = "listing_dropped";
        wire_path_failed = true;
        built_for = NULL;
      }

      /* Append the leaf to the blob under construction; running out of room means the listing is too big to hold. */
      if (child != NULL && built_for == dir_node && !cache_leafnames_append(cache, dir_node, rec.name)) {
        debug("WIRE_PATH_FAILED path=\"%s\" reason=blob_append leaf=\"%s\"\n", dir_path, rec.name);
        wire_failure_cause = "blob_append";
        wire_path_failed = true;
        cache_enum_give_up_listing(cache, dir_node, &built_for, &oversized);
      }

      /* Hand the entry to the visitor. */
      {
        LMCacheNode_t synth;
        LMCacheNode_t *deliver = child;

        /* No cnode, because the insert found no room or the directory is already known to be too big: deliver a throwaway copy. */
        if (deliver == NULL) {
          if (!oversized) {
            debug("WIRE_PATH_FAILED path=\"%s\" reason=insert_substrate_full leaf=\"%s\"\n", dir_path, rec.name);
            wire_failure_cause = "insert_substrate_full";
            wire_path_failed = true;
            cache_enum_give_up_listing(cache, dir_node, &built_for, &oversized);
          }

          synth_from_record(&synth, &rec, child_path);
          deliver = &synth;
        }

        if (visitor != NULL && !visitor_halt) {
          vdebug("VISITOR_DELIVER path=\"%s\" leaf=\"%s\" cnode_ok=%u blob_ok=%u\n", dir_path, rec.name, (unsigned)(child != NULL),
                 (unsigned)!wire_path_failed);

          if (!visitor(deliver, user)) {
            visitor_halt = true;
          }
        }
      }

      total_count++;

      /* Too big to cache, and no more entries are wanted: reading the rest of the directory would gain nothing. */
      if (oversized && (visitor == NULL || visitor_halt)) {
        cache->wire.discard_state(cache->wire.ctx, &state);

        if (!case_twins) {
          dir_node->flags |= LMCACHE_FLAG_EXCEEDS_CACHE;
        }

        debug("EXCEEDS_CACHE_SET path=\"%s\" cause=%s entries_at_failure=%u (scan abandoned)\n", dir_path,
              (wire_failure_cause != NULL) ? wire_failure_cause : "unknown", (unsigned)total_count);
        result.child_count = total_count;
        result.is_authoritative = true;
        cache_enum_shorten_suspects(cache, dir_node, suspect_children, suspect_count);
        ENUM_EXIT("oversized");
      }
    }

    /* The directory pointer is good for the generation as it stands now. */
    gen_seen = cache->mutation_gen;
  }

  /* Something since the last look may have freed or moved the directory cnode: re-resolve it before the cache-update step touches it. */
  if (dir_node != NULL && cache->mutation_gen != gen_seen) {
    LMCacheNode_t *fresh = cache_ensure_dir_chain_cached(cache, dir_path);
    debug("ENUM_RERESOLVE path=\"%s\" gen_was=%u gen_now=%u dir_node_was=%p fresh=%p\n", dir_path, (unsigned)gen_seen,
          (unsigned)cache->mutation_gen, (void *)dir_node, (void *)fresh);

    /* The directory moved, so whatever was read before the move went into the old node: this scan cannot list it fully. */
    if (fresh != dir_node) {
      if (!wire_path_failed) {
        wire_failure_cause = "dir_moved";
        wire_path_failed = true;
      }

      built_for = NULL;
    }

    dir_node = fresh;
  }

  if (dir_node == NULL) {
    dir_node = cache_ensure_dir_chain_cached(cache, dir_path);

    /* Cannot cache the directory; degrade to delivering records straight from the wire. */
    if (dir_node == NULL) {
      if (!wire_path_failed) {
        debug("WIRE_PATH_FAILED path=\"%s\" reason=ensure_chain_fail_post - empty dir, no cnode\n", dir_path);
        wire_failure_cause = "ensure_chain_fail_post";
        wire_path_failed = true;
      }

      cache->wire.discard_state(cache->wire.ctx, &state);
      result.child_count = total_count;
      result.is_authoritative = true;
      ENUM_EXIT("ensure_chain_fail_post");
    }
  }

  /*
   * Cache-update step: restart the directory's own lifetime, unless it is a placeholder made only to hang children from, whose zero
   * details were never learned and must not be served as if they had been.
   */
  if (dir_node->expires_at != 0u) {
    dir_node->expires_at = cache_now() + cache->metadata_ttl;
  }

  /* A server quirk recognised during the scan can have shortened the lifetime, so children refreshed after that carry the shorter one. */
  spec_touch_threshold = cap_at_metadata_ttl(cache, spec_touch_threshold, now);

  /*
   * Sweep this directory's direct children, evicting speculative entries that the enumeration did not refresh.  Skipped for a directory
   * too big to cache, whose later entries were deliberately not refreshed.
   */
  for (slot = oversized ? NULL : dir_node->first_child; slot != NULL; slot = older) {
    /* Read the neighbour first: eviction takes this child off the list. */
    older = slot->sibling_next;

    /* Keep children whose expiry the fresh enumeration pushed at or beyond one metadata lifetime from now. */
    if (slot->expires_at >= spec_touch_threshold) {
      continue;
    }

    /* A child this scan listed but a notification has since marked stale: the new listing would name a child with no entry. */
    if (!wire_path_failed && built_for == dir_node && blob_names_child(dir_node, slot)) {
      debug("WIRE_PATH_FAILED path=\"%s\" reason=child_invalidated\n", dir_path);
      wire_failure_cause = "child_invalidated";
      wire_path_failed = true;
    }

    /* Evict the stale child; a directory takes its whole subtree with it. */
    if (slot->obj_type == LMCACHE_OBJECT_DIRECTORY) {
      evict_node_and_subtree(cache, slot);
    } else {
      evict_node_only(cache, slot);
    }
  }

  /* Ensure the blob build was started for the final directory. */
  if (!wire_path_failed && built_for != dir_node) {
    if (cache_leafnames_begin_build(cache, dir_node)) {
      built_for = dir_node;
    } else {
      wire_path_failed = true;
    }
  }

  /* The whole listing went into the blob: finish it, which makes the directory definitive. */
  if (!wire_path_failed) {
    cache_leafnames_finish_build(cache, dir_node);

    /* Blob complete, so the directory is now definitive: clear any too-big or case-twin flag it carried, as the listing fit this time. */
    if ((dir_node->flags & (LMCACHE_FLAG_EXCEEDS_CACHE | LMCACHE_FLAG_CASE_TWINS)) != 0u) {
      dir_node->flags &= (uint8_t) ~(LMCACHE_FLAG_EXCEEDS_CACHE | LMCACHE_FLAG_CASE_TWINS);
      debug("EXCEEDS_CACHE_CLEAR path=\"%s\" reason=self_heal\n", dir_path);
    }

    /* Entries the scan passed over are not in the listing, so it cannot show that a name is absent. */
    if (state.unlisted != 0u) {
      dir_node->flags |= LMCACHE_FLAG_UNLISTED_ENTRIES;
    }

    debug("WIRE_PATH_OK path=\"%s\" entries=%u\n", dir_path, (unsigned)total_count);
  } else {
    /* The build failed: release the partial blob so the next enumeration asks the server again. */
    cache_leafnames_release(cache, dir_node);

    /* Only a listing that ran out of room shows the directory is too big; twins have their own flag; any other failure is worth a retry. */
    if (oversized && !case_twins) {
      dir_node->flags |= LMCACHE_FLAG_EXCEEDS_CACHE;
      debug("EXCEEDS_CACHE_SET path=\"%s\" cause=%s entries_at_failure=%u\n", dir_path,
            (wire_failure_cause != NULL) ? wire_failure_cause : "unknown", (unsigned)total_count);
    }

    debug("WIRE_PATH_FAILED path=\"%s\" entries=%u (final - dir left non-definitive)\n", dir_path, (unsigned)total_count);
  }

  /* Shorten the size-suspect files' lifetimes only now the sweep is done, so the sweep does not evict them as unlisted. */
  cache_enum_shorten_suspects(cache, dir_node, suspect_children, suspect_count);

  /* The whole directory was listed, from the server rather than the cache. */
  result.child_count = total_count;
  result.is_authoritative = true;
  result.served_from_cache = false;
  ENUM_EXIT("ok");
#undef ENUM_EXIT
}

/*
 * Round v up to the next multiple of the power-of-two alignment a.
 */
static size_t align_up(size_t v, size_t a) {
  return (v + (a - 1u)) & ~(a - 1u);
}

/*
 * Compute the total substrate size needed to pack the cache header, slab, hash table and both heaps.
 *
 * Each region is padded up to pointer alignment so the next one starts aligned; the summation order here must match the carving order in
 * cache_mount_create_sized or the two will disagree.
 *
 * Parameters:
 *   slab_capacity  number of cnode slab slots
 *   hash_M         number of hash buckets (a power of two)
 *   str_bytes      size of the string heap
 *   file_bytes     size of the content heap
 *
 * Returns: the byte count for one contiguous substrate allocation.
 */
static size_t substrate_total_bytes(uint32_t slab_capacity, uint32_t hash_M, uint32_t str_bytes, uint32_t file_bytes) {
  /* Sum each region's pointer-aligned size in the same order the substrate is later carved, so the two stay in lockstep. */
  size_t off = 0u;
  off += align_up(sizeof(LMCache_t), sizeof(void *));
  off += align_up((size_t)slab_capacity * sizeof(LMCacheNode_t), sizeof(void *));
  off += align_up((size_t)hash_M * sizeof(LMCacheNode_t *), sizeof(void *));
  off += align_up((size_t)str_bytes, sizeof(void *));
  off += align_up((size_t)file_bytes, sizeof(void *));

  return off;
}

void Cache_Init(uint32_t (*clock_fn)(void)) {
  size_t i;

  /* Idempotent re-init only refreshes the clock, so live handle bindings survive. */
  if (lm_initialised) {
    lm_clock_fn = clock_fn;
    return;
  }

  lm_clock_fn = clock_fn;

  /* Clear the handle-to-cnode table so no slot resolves before a mount populates it. */
  for (i = 0; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
    lm_handle_table[i].cache = NULL;
    lm_handle_table[i].node = NULL;
    lm_handle_table[i].stream_cache = NULL;
    lm_handle_table[i].stream = NULL;
  }

  lm_initialised = true;
}

void Cache_Shutdown(void) {
  size_t i;

  /* Guard against a shutdown that has no matching init, and against a double shutdown. */
  if (!lm_initialised) {
    return;
  }

  /* Drop every external handle binding so no stale cache or node pointer survives into a later module incarnation. */
  for (i = 0; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
    lm_handle_table[i].cache = NULL;
    lm_handle_table[i].node = NULL;
    lm_handle_table[i].stream_cache = NULL;
    lm_handle_table[i].stream = NULL;
  }

  /* Forget the injected clock and mark the module uninitialised so a subsequent re-init starts from clean state. */
  lm_clock_fn = NULL;
  lm_clock_last = 0u;
  lm_clock_wraps = 0u;
  lm_initialised = false;
}

/*
 * Allocate a per-mount substrate sized for slab_cap cnodes and the tier's heaps, and carve it into a ready cache.
 *
 * One contiguous block comes from the installed substrate allocator (a Dynamic Area on RISC OS, the heap in a Linux test build) and is
 * carved into the cache header, the slab, the hash table, and the string and content heaps.  The tunables are stamped from the defaults and
 * the current tier: the largest file whose content is cached is the content heap's size divided by LMCACHE_CONTENT_HEAP_SHARE, up to
 * LMCACHE_MAX_CONTENT_CAP.  The share root is hand-built in slot 0 and the other slots are threaded onto the free list.  Handle-table
 * slots an earlier mount at the same address left behind, and captures recorded against it, are cleared.
 *
 * Parameters:
 *   label     mount name, for the Dynamic Area name and diagnostics; NULL for none
 *   slab_cap  number of cnode slab slots
 *
 * Returns: the ready cache, or NULL if the subsystem is not initialised, slab_cap is too small, the substrate cannot be allocated, or the
 * root's name cannot be claimed.
 */
static LMCache_t *cache_mount_create_sized(const char *label, uint32_t slab_cap) {
  /* Pick the installed substrate allocator, falling back to the built-in malloc-backed one a Linux test build relies on. */
  uint32_t hash_M;
  size_t total_bytes;
  size_t off;
  uint8_t *base;
  int substrate_handle = 0;
  LMCache_t *cache;
  LMCacheNode_t *root;
  Cache_SubstrateAllocFn alloc_fn = (lm_substrate_alloc_fn != NULL) ? lm_substrate_alloc_fn : default_substrate_alloc;

  /* Refuse until Cache_Init has installed the clock and cleared the handle table. */
  if (!lm_initialised) {
    return NULL;
  }

  /* Reject a capacity too small to hold the reserved root slot on top of a full hot list. */
  if (slab_cap <= LMCACHE_DEFAULT_HOT_MAX + 1u) {
    return NULL;
  }

  /* Size the hash table to a power of two at least the slab capacity so the mask-based bucket index stays cheap. */
  hash_M = next_pow2_ge(slab_cap);
  total_bytes = substrate_total_bytes(slab_cap, hash_M, lm_tier_str_bytes, lm_tier_file_bytes);

  base = (uint8_t *)alloc_fn(total_bytes, label, &substrate_handle);

  /* One contiguous allocation backs the whole cache; return NULL if the substrate cannot be obtained. */
  if (base == NULL) {
    return NULL;
  }

  /*
   * Carve the substrate into header, slab, hash table and the two heaps at pointer alignment (order and padding must match
   * substrate_total_bytes), then stamp the tunables, lifetimes and generation counter.
   */
  off = 0;
  cache = (LMCache_t *)(void *)(base + off);
  off += align_up(sizeof(LMCache_t), sizeof(void *));

  cache->root_node = (LMCacheNode_t *)(void *)(base + off);
  off += align_up((size_t)slab_cap * sizeof(LMCacheNode_t), sizeof(void *));

  cache->hash_table = (LMCacheNode_t **)(void *)(base + off);

  memset(cache->hash_table, 0, (size_t)hash_M * sizeof(LMCacheNode_t *));
  off += align_up((size_t)hash_M * sizeof(LMCacheNode_t *), sizeof(void *));

  srheap_init(&cache->str_heap, base + off, lm_tier_str_bytes);
  off += align_up((size_t)lm_tier_str_bytes, sizeof(void *));
  srheap_init(&cache->content_heap, base + off, lm_tier_file_bytes);

  cache->substrate_base = base;
  cache->substrate_size = total_bytes;
  cache->substrate_handle = substrate_handle;

  cache->slab_capacity = (uint16_t)slab_cap;
  cache->hash_mask = (uint16_t)(hash_M - 1u);
  cache->hot_max = (uint16_t)LMCACHE_DEFAULT_HOT_MAX;
  cache->hot_len = 0;
  cache->mutation_gen = 0;

  cache->metadata_ttl = LMCACHE_DEFAULT_METADATA_TTL;
  cache->negative_ttl = LMCACHE_DEFAULT_METADATA_TTL;
  cache->content_ttl = LMCACHE_DEFAULT_CONTENT_TTL;
  cache->last_local_mutation_at = 0u;
  cache->quirks = 0u;

  /* No one file may take more than its share of the content heap, nor more than the absolute ceiling. */
  cache->max_cacheable_file_bytes = lm_tier_file_bytes / LMCACHE_CONTENT_HEAP_SHARE;

  if (cache->max_cacheable_file_bytes > LMCACHE_MAX_CONTENT_CAP) {
    cache->max_cacheable_file_bytes = LMCACHE_MAX_CONTENT_CAP;
  }

  cache->content_caching_disabled = lm_tier_content_caching_disabled;

  /* Start with the wire vtable empty; the production wiring installs its function pointers after the mount is built. */
  cache->wire.first = NULL;
  cache->wire.next = NULL;
  cache->wire.iter = NULL;
  cache->wire.discard_state = NULL;
  cache->wire.ctx = NULL;

  /* Store the mount label, truncated to fit the inline field; an absent label becomes empty. */
  if (label == NULL) {
    cache->label[0] = '\0';
  } else {
    size_t n = strlen(label);

    if (n >= sizeof(cache->label)) {
      n = sizeof(cache->label) - 1u;
    }

    memcpy(cache->label, label, n);
    cache->label[n] = '\0';
  }

  /*
   * Initialise the recency sentinels and hand-build the root directory cnode in reserved slot 0: no parent, and an expiry left at zero,
   * since lookups special-case the root rather than letting it time out, and no listing yet.  The root is never on the directory recency
   * list.
   */
  lru_sentinel_init(&cache->hot_sentinel);
  lru_sentinel_init(&cache->cold_sentinel);
  cache->dir_oldest = NULL;
  cache->dir_newest = NULL;

  root = cache->root_node;
  root->u.file.prev = NULL;
  root->u.file.next = NULL;
  child_links_init(root);
  root->next.hash_next = NULL;
  root->mount = cache;
  root->hash = cache_hash_full("");
  root->load_addr = 0;
  root->exec_addr = 0;
  root->length = LMCACHE_DIR_LENGTH;
  root->attrs = 0;
  root->expires_at = 0u;
  root->suppress_until = 0u;
  root->obj_type = LMCACHE_OBJECT_DIRECTORY;
  root->flags = 0;
  root->name_len = 0;
  root->name = NULL;
  root->u.dir.leafnames_blob = NULL;
  root->u.dir.leafnames_size = 0u;
  root->u.dir.leafnames_capacity = 0u;
  root->u.dir.older = NULL;
  root->u.dir.newer = NULL;

  /* Claim a one-byte string-heap slot for the root's empty name so it carries a name like any other cnode. */
  {
    char *dst = (char *)srheap_claim(&cache->str_heap, 1u);

    /* A name claim that fails this early is unrecoverable: free the substrate through the matching hook and fail the mount. */
    if (dst == NULL) {
      Cache_SubstrateFreeFn free_fn = (lm_substrate_free_fn != NULL) ? lm_substrate_free_fn : default_substrate_free;
      free_fn(base, total_bytes, substrate_handle);

      return NULL;
    }

    /* The name is the empty string. */
    dst[0] = '\0';
    root->name = dst;
    root->name_len = 0u;
  }

  /* Link the root into its hash bucket, then thread every remaining slab slot onto the free list. */
  hash_link(cache, root);

  slab_build_free_list(cache);

  /* Clear any handle-table slot an earlier mount at this address left behind. */
  {
    uint8_t *substrate_start = (uint8_t *)base;
    uint8_t *substrate_end = substrate_start + total_bytes;
    size_t i;

    /* A slot is stale if it still names this cache or points at a node inside the freshly reused substrate. */
    for (i = 0; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
      LMCacheNode_t *n = lm_handle_table[i].node;
      bool node_in_range = (n != NULL && (uint8_t *)n >= substrate_start && (uint8_t *)n < substrate_end);

      /* Clear the dangling slot so a recycled handle can't resolve to a foreign cnode. */
      if (lm_handle_table[i].cache == cache || node_in_range) {
        debug("CACHE[%s]: stale handle %u cleared at mount-create (cache=%p node=%p)\n", cache->label, (unsigned)(i + 1u),
              (void *)lm_handle_table[i].cache, (void *)n);
        lm_handle_table[i].cache = NULL;
        lm_handle_table[i].node = NULL;
      }

      /* A capture recorded against this address belonged to an earlier mount whose heap is gone. */
      if (lm_handle_table[i].stream_cache == cache) {
        lm_handle_table[i].stream_cache = NULL;
        lm_handle_table[i].stream = NULL;
      }
    }
  }

  return cache;
}

LMCache_t *Cache_MountCreate(const char *label, uint32_t root_load, uint32_t root_exec) {
  /* Build the mount's cache with the node-slab count chosen for this machine's memory tier. */
  LMCache_t *cache = cache_mount_create_sized(label, lm_tier_slab_nodes);

  /* The root never expires, so a catalogue read of it is answered from here: give it a date like any other directory. */
  if (cache != NULL) {
    cache->root_node->load_addr = root_load;
    cache->root_node->exec_addr = root_exec;
  }

  return cache;
}

void Cache_MountDestroy(LMCache_t *cache) {
  Cache_SubstrateFreeFn free_fn;
  void *base;
  size_t bytes;
  int handle;
  size_t i;

  /* Safe with NULL: dismounting a mount that never built a cache. */
  if (cache == NULL) {
    return;
  }

  /* Sever any external handles still bound to this cache before its memory is freed, so a later op can't deref released nodes. */
  for (i = 0; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
    if (lm_handle_table[i].cache == cache) {
      lm_handle_table[i].cache = NULL;
      lm_handle_table[i].node = NULL;
    }

    /* Captures in progress go with the content heap; the open files carry on without them. */
    if (lm_handle_table[i].stream_cache == cache) {
      lm_handle_table[i].stream_cache = NULL;
      lm_handle_table[i].stream = NULL;
    }
  }

  /*
   * Return the substrate through the injected free hook (real Dynamic Area, or malloc in a Linux test build), defaulting when none is
   * set.
   */
  base = cache->substrate_base;
  bytes = cache->substrate_size;
  handle = cache->substrate_handle;
  free_fn = (lm_substrate_free_fn != NULL) ? lm_substrate_free_fn : default_substrate_free;
  free_fn(base, bytes, handle);
}

/*
 * Clamp every lifetime on a mount that runs past a deadline to it: each cnode's details, each name cached as absent, each file's captured
 * content and each directory's listing.
 *
 * Parameters:
 *   cache            per-mount cache
 *   latest           deadline no details or listing may run past
 *   latest_negative  deadline no name cached as absent may run past
 *   latest_content   deadline no captured content may run past
 */
static void cache_clamp_lifetimes(LMCache_t *cache, LMCacheTime_t latest, LMCacheTime_t latest_negative, LMCacheTime_t latest_content) {
  uint32_t i;

  for (i = 0u; i < cache->slab_capacity; i++) {
    LMCacheNode_t *n = &cache->root_node[i];
    LMCacheTime_t deadline;

    if (n->mount == NULL) {
      continue;
    }

    deadline = (n->obj_type == LMCACHE_OBJECT_NOTHING) ? latest_negative : latest;

    if (n->expires_at > deadline) {
      n->expires_at = deadline;
    }

    if (n->obj_type == LMCACHE_OBJECT_FILE && n->u.file.data != NULL && n->u.file.data_expires_at > latest_content) {
      n->u.file.data_expires_at = latest_content;
    }

    if (n->obj_type == LMCACHE_OBJECT_DIRECTORY && n->u.dir.leafnames_blob != NULL && n->u.dir.leafnames_blob->expires_at > latest) {
      n->u.dir.leafnames_blob->expires_at = latest;
    }
  }
}

void Cache_SetQuirks(LMCache_t *cache, LMCacheQuirks_t bits) {
  bool newly_aggressive;

  if (cache == NULL) {
    return;
  }

  /* Quirks only accumulate; bits are added, never cleared here. */
  newly_aggressive = (bits & LMCACHE_QUIRK_AGGRESSIVE_REFRESH) != 0u && (cache->quirks & LMCACHE_QUIRK_AGGRESSIVE_REFRESH) == 0u;
  cache->quirks |= bits;

  /* Aggressive refresh clamps both lifetimes to the short quirk lifetimes, the only freshness signal when the server will not notify. */
  if (bits & LMCACHE_QUIRK_AGGRESSIVE_REFRESH) {
    cache->metadata_ttl = LMCACHE_QUIRK_METADATA_TTL;
    cache->negative_ttl = LMCACHE_QUIRK_NEGATIVE_TTL;
    cache->content_ttl = LMCACHE_QUIRK_CONTENT_TTL;
    debug("CACHE_QUIRKS \"%s\" AGGRESSIVE_REFRESH set: meta_ttl=%ucs neg_ttl=%ucs content_ttl=%ucs\n", cache->label,
          (unsigned)cache->metadata_ttl, (unsigned)cache->negative_ttl, (unsigned)cache->content_ttl);
  }

  /* Lifetimes handed out before the quirk, including the listing a scan is building now, are clamped to the short ones too. */
  if (newly_aggressive) {
    cache_clamp_lifetimes(cache, cache_now() + cache->metadata_ttl, cache_now() + cache->negative_ttl, cache_now() + cache->content_ttl);
  }
}

LMCacheNode_t *Cache_Lookup(LMCache_t *cache, const char *path) {
  LMCacheNode_t *node;
  LMCacheTime_t now;

  /* Treat an unusable cache as a miss, so the caller falls through to the wire. */
  if (cache == NULL || path == NULL || lm_clock_fn == NULL) {
    return NULL;
  }

  /* Strip the leading separator so both path spellings resolve to one key, then search for a positive or negative entry. */
  path = skip_leading_sep(path);

  node = find_path_any(cache, path);

  if (node == NULL) {
    /* A genuine miss with no entry, distinct from the expired case handled below. */
    return NULL;
  }

  now = cache_now();

  /* Expired entries read as absent, except the root, which is pinned and never ages out. */
  if (now >= node->expires_at && node != cache->root_node) {
    /*
     * Report stale as a miss but leave the node linked; the next report of the path's details from the server refreshes it in place rather
     * than it being unlinked here.
     */
    return NULL;
  }

  /* A hit's content may be served straight from here, so content past its own lifetime goes now. */
  release_content_if_expired(cache, node);

  /* Mark most-recently-used so the entry survives slab pressure longer. */
  promote(cache, node);

  return node;
}

/*
 * Split a canonical DOS path into its parent directory and final leaf at the last backslash.
 *
 * A top-level path with no separator yields an empty parent string and a leaf that is the whole path; the empty parent is the cache's
 * spelling of the share root. The returned leaf pointer aliases into the caller's path buffer, so it stays valid only as long as that
 * buffer does; the parent, by contrast, is copied out into parent_buf.
 *
 * Parameters:
 *   path         canonical DOS path, backslash-separated
 *   parent_buf   buffer to receive the parent portion, null-terminated
 *   parent_size  size of parent_buf in bytes
 *
 * Returns: a pointer to the leaf within path, or NULL if parent_buf is too small to hold the parent.
 */
static const char *path_split_parent(const char *path, char *parent_buf, size_t parent_size) {
  size_t i;
  size_t len = strlen(path);
  size_t sep = len;
  bool found = false;

  /* Scan from the end for the final backslash, which is where parent ends and leaf begins. */
  for (i = len; i > 0u; i--) {
    if (path[i - 1u] == '\\') {
      sep = i - 1u;
      found = true;
      break;
    }
  }

  /* No separator: the whole path is a leaf sitting directly under an empty parent. */
  if (!found) {
    if (parent_size < 1u) {
      return NULL;
    }

    parent_buf[0] = '\0';

    return path;
  }

  /* The parent plus its terminator must fit the caller's buffer, otherwise fail before writing anything. */
  if (sep + 1u > parent_size) {
    return NULL;
  }

  /* Copy the parent component, skipped when the separator sits at position zero (a root-level child, empty parent). */
  if (sep > 0u) {
    memcpy(parent_buf, path, sep);
  }

  parent_buf[sep] = '\0';

  /* Return a pointer into the original path at the leaf, just past the separator. */
  return path + sep + 1u;
}

/*
 * Return a file cnode's captured content to the content heap, keeping the cnode, its name and its details.
 *
 * Safe on any cnode: directories, negatives and files holding no content are left alone.
 *
 * Parameters:
 *   cache  per-mount cache owning the content heap
 *   node   cnode whose content is to be released
 */
static inline void release_file_content(LMCache_t *cache, LMCacheNode_t *node) {
  if (node->obj_type != LMCACHE_OBJECT_FILE) {
    return;
  }

  if (node->u.file.data != NULL) {
    srheap_free(&cache->content_heap, node->u.file.data);
    node->u.file.data = NULL;
    node->u.file.data_expires_at = 0u;
  }
}

/*
 * Drop a file's captured content when the details the server now reports differ from those it was captured with.
 *
 * A change of length is not the only sign of new bytes: an edit that keeps the size still moves the datestamp, which RISC OS carries in the
 * load and exec addresses.  Must run before the new details are copied over the old.
 *
 * Parameters:
 *   cache      per-mount cache owning the content heap
 *   node       cnode about to be refreshed; anything but a file holding content is left alone
 *   load_addr  load address now reported
 *   exec_addr  exec address now reported
 *   length     length now reported
 */
static void release_content_if_changed(LMCache_t *cache, LMCacheNode_t *node, uint32_t load_addr, uint32_t exec_addr, uint64_t length) {
  if (node->obj_type != LMCACHE_OBJECT_FILE || node->u.file.data == NULL) {
    return;
  }

  if (node->length != length || node->load_addr != load_addr || node->exec_addr != exec_addr) {
    release_file_content(cache, node);
  }
}

/*
 * Drop a file's captured content once its own lifetime has run out, so the next read goes to the server.
 *
 * Content carries a lifetime of its own because the details being refreshed cannot catch every change: a server that sends no change
 * notifications, or a lost notification, leaves only the clock.  It is checked wherever the bytes are about to be served.
 *
 * Parameters:
 *   cache  per-mount cache owning the content heap
 *   node   cnode about to be served; anything but a file holding content is left alone
 */
static void release_content_if_expired(LMCache_t *cache, LMCacheNode_t *node) {
  if (node->obj_type != LMCACHE_OBJECT_FILE || node->u.file.data == NULL || lm_clock_fn == NULL) {
    return;
  }

  if (cache_now() >= node->u.file.data_expires_at) {
    release_file_content(cache, node);
  }
}

/*
 * Evict a cnode and everything beneath it.
 *
 * NULL and the pinned root are no-ops.  Every pointer into the subtree is invalid afterwards.
 *
 * Parameters:
 *   cache  per-mount cache
 *   node   top of the subtree to evict
 */
static void evict_node_and_subtree(LMCache_t *cache, LMCacheNode_t *node) {
  /* Never evict the root, which anchors the tree; null is a no-op. */
  if (node == NULL || node == cache->root_node) {
    return;
  }

  /* If it sat on the hot list, drop the hot count before unlinking. */
  if ((node->flags & LMCACHE_FLAG_HOT) != 0u) {
    cache->hot_len--;
  }

  /*
   * Unlink from the recency list, then free the node and its descendants together, since children hold parent pointers that would dangle
   * if the parent went first.
   */
  lru_unlink(node);
  cache_evict_subtree(cache, node);
}

/*
 * Evict a single file or negative cnode, with any captured content.
 *
 * A directory is left alone, since its children point back at it and need the subtree evictor; so are NULL and the pinned root.
 *
 * Parameters:
 *   cache  per-mount cache
 *   node   file or negative cnode to evict
 */
static void evict_node_only(LMCache_t *cache, LMCacheNode_t *node) {
  /* The root node is the slab base and permanent sentinel; it is never evicted. */
  if (node == NULL || node == cache->root_node) {
    return;
  }

  /* Directories anchor a subtree; dropping one needs the subtree evictor, not this. */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY) {
    return;
  }

  /* Keep the hot-list occupancy count in step before the node leaves its LRU list. */
  if ((node->flags & LMCACHE_FLAG_HOT) != 0u) {
    cache->hot_len--;
  }

  /* Detach from whichever LRU list holds it, then release the slot, its name and any content. */
  lru_unlink(node);
  evict_node(cache, node);
}

/*
 * Invalidate a directory's cached enumeration after one of its children changed.
 *
 * Forces the next enumeration back to the wire by expiring the directory and dropping its leafnames blob. A no-op for NULL or a
 * non-directory.
 *
 * Parameters:
 *   cache   per-mount cache
 *   parent  the directory whose listing is now suspect
 */
static inline void invalidate_parent_enum(LMCache_t *cache, LMCacheNode_t *parent) {
  /* Nothing to invalidate unless the parent is a cached directory. */
  if (parent == NULL || parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    return;
  }

  /* Expire the entry and drop its leafnames blob so the next enumerate rebuilds from the wire. */
  parent->expires_at = 0u;
  cache_leafnames_release(cache, parent);
}

/*
 * Look up the cached directory cnode that is the parent of child_path.
 *
 * The last path component is split off; the share root is the parent when the child sits directly at the root. The leaf pointer is
 * optionally returned for the caller's convenience.
 *
 * Parameters:
 *   cache        per-mount cache
 *   child_path   DOS path whose parent is wanted
 *   parent_buf   scratch buffer that receives the parent path
 *   parent_size  size of parent_buf
 *   leaf_out     optional; receives a pointer to the leaf within child_path
 *
 * Returns: the parent directory cnode, or NULL if the split fails or the parent is not cached.
 */
static inline LMCacheNode_t *resolve_parent_for_child(LMCache_t *cache, const char *child_path, char *parent_buf, size_t parent_size,
                                                      const char **leaf_out) {
  /* Split the trailing leaf off, leaving the parent path in the caller's buffer. */
  const char *leaf = path_split_parent(child_path, parent_buf, parent_size);

  /* A path with no separable leaf has no parent to resolve. */
  if (leaf == NULL) {
    return NULL;
  }

  if (leaf_out != NULL) {
    *leaf_out = leaf;
  }

  /* An empty parent path means the child sits at the share root; otherwise resolve the named parent. */
  return (parent_buf[0] == '\0') ? cache->root_node : find_path_any(cache, parent_buf);
}

/*
 * Invalidate the cached enumeration of the directory that contains child_path, so its listing is fetched afresh.
 *
 * Harmless if the parent is not cached.
 *
 * Parameters:
 *   cache       per-mount cache
 *   child_path  canonical DOS path of the child whose parent listing is now stale
 */
static void invalidate_parent_enum_by_path(LMCache_t *cache, const char *child_path) {
  /* Derive the parent directory node from the child's path; parent_buf is throwaway scratch for the split. */
  char parent_buf[LMCACHE_PATH_BUF_BYTES];
  LMCacheNode_t *parent = resolve_parent_for_child(cache, child_path, parent_buf, sizeof(parent_buf), NULL);

  /* Drop the parent's authoritative enumeration; a NULL (unresolved) parent is a safe no-op. */
  invalidate_parent_enum(cache, parent);
}

/*
 * Drop whatever the cache holds that denies a directory on a path, once the server has accepted an operation in it.
 *
 * The operation shows that every directory on the path exists.  One cached as absent loses that entry, and a current listing that lacks
 * the next name down is dropped rather than extended, so every listing left still names all of its directory's children and
 * Cache_PathRuledOut no longer rules the path out.
 *
 * Parameters:
 *   cache     per-mount cache
 *   dir_path  share-relative DOS path of the directory; the empty path (the share root) does nothing
 */
static void cache_admit_ancestors(LMCache_t *cache, const char *dir_path) {
  char path[LMCACHE_PATH_BUF_BYTES];
  size_t len = strlen(dir_path);

  if (len >= sizeof path) {
    return;
  }

  /* Work on a copy, because the walk shortens the path one name at a time. */
  memcpy(path, dir_path, len + 1u);

  /* Climb one directory at a time to the share root, which is always a directory and never absent. */
  while (path[0] != '\0') {
    LMCacheNode_t *node = find_path_any(cache, path);
    LMCacheNode_t *parent;
    char *sep = strrchr(path, '\\');
    const char *name;

    if (node != NULL && node->obj_type == LMCACHE_OBJECT_NOTHING) {
      evict_node_only(cache, node);
    }

    /* Split off the last name; the share root is the empty path. */
    if (sep != NULL) {
      *sep = '\0';
      name = sep + 1;
      parent = find_path_any(cache, path);
    } else {
      name = path;
      parent = cache->root_node;
    }

    if (listing_usable(parent) && Cache_DirHasLeaf(parent, name) != LM_LEAF_PRESENT) {
      cache_leafnames_release(cache, parent);
    }

    if (sep == NULL) {
      break;
    }
  }
}

/*
 * Add a new child's leaf to its parent's cached listing.
 *
 * Called when this client creates or learns of a child, and when the server reports one added.  A definitive listing gains the name so
 * that it stays complete for the fast-miss path.  So does a listing a scan is still building, since the scan may already have passed the
 * place where the server would list the new name.  If the name will not fit, the listing is dropped, so the next enumeration rebuilds it
 * at full size; running out of the room a finished listing keeps spare says nothing about whether the directory is too big to list.  A
 * directory with no listing is left untouched.
 *
 * Parameters:
 *   cache       per-mount cache
 *   child_path  DOS path of the new child
 *   obj_type    object type of the child, for diagnostics only
 */
static void notify_parent_added_child(LMCache_t *cache, const char *child_path, uint8_t obj_type) {
  /* Resolve the parent directory and the leaf name that was added beneath it. */
  char parent_buf[LMCACHE_PATH_BUF_BYTES];
  const char *leaf = NULL;
  LMCacheNode_t *parent = resolve_parent_for_child(cache, child_path, parent_buf, sizeof(parent_buf), &leaf);

  (void)obj_type; // read only by the debug lines, which a release build compiles away

  /* Only a cached directory can have its listing extended. */
  if (parent == NULL || parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    debug("PARENT_ADD_CHILD parent=\"%s\" leaf=\"%s\" obj_type=%u: parent not cached as dir - skipped\n", parent_buf, leaf,
          (unsigned)obj_type);
    return;
  }

  /* Append the leaf to a definitive blob, or one still being built; if it will not fit, drop the blob for a rebuild. */
  if (parent->u.dir.leafnames_blob != NULL) {
    if (cache_leafnames_append(cache, parent, leaf)) {
      debug("PARENT_ADD_CHILD parent=\"%s\" leaf=\"%s\" obj_type=%u: appended to definitive blob\n", parent_buf, leaf, (unsigned)obj_type);
    } else {
      cache_leafnames_release(cache, parent);
      debug("PARENT_ADD_CHILD parent=\"%s\" leaf=\"%s\" obj_type=%u: blob full - released for a rebuild\n", parent_buf, leaf,
            (unsigned)obj_type);
    }

    return;
  }

  /* An already-oversized directory has no blob to extend, so skip it. */
  if ((parent->flags & LMCACHE_FLAG_EXCEEDS_CACHE) != 0u) {
    debug("PARENT_ADD_CHILD parent=\"%s\" leaf=\"%s\" obj_type=%u: skipped (exceeds_cache)\n", parent_buf, leaf, (unsigned)obj_type);
    return;
  }

  debug("PARENT_ADD_CHILD parent=\"%s\" leaf=\"%s\" obj_type=%u: NO-OP (is_definitive=%d)\n", parent_buf, leaf, (unsigned)obj_type,
        ((parent->flags & LMCACHE_FLAG_DEFINITIVE) != 0u) ? 1 : 0);
}

/*
 * Keep both parents' cached child listings consistent after a rename.
 *
 * A rename within one directory whose listing is authoritative is handled as a cheap blob splice (the old leaf removed, the new one
 * appended), so the directory stays definitive and the next fast-miss probe still resolves without touching the wire. Any other case (a
 * cross-directory move, or a listing that is not authoritative) discards the affected directories' cached enumerations wholesale, forcing a
 * fresh listing next time.
 *
 * Parameters:
 *   cache       per-mount cache
 *   old_parent  directory the child was renamed from
 *   old_leaf    child's leaf name before the rename
 *   new_parent  directory the child was renamed to
 *   new_leaf    child's leaf name after the rename
 */
static void notify_parent_renamed_child(LMCache_t *cache, LMCacheNode_t *old_parent, const char *old_leaf, LMCacheNode_t *new_parent,
                                        const char *new_leaf) {
  /*
   * Same-directory rename with an authoritative listing: splice the leaf in the blob rather than discard the whole enumeration.  If the new
   * name will not fit, the listing would be missing a child it has, so drop it for a rebuild.
   */
  if (old_parent != NULL && old_parent == new_parent && old_parent->obj_type == LMCACHE_OBJECT_DIRECTORY &&
      ((old_parent->flags & LMCACHE_FLAG_DEFINITIVE) != 0u) && old_leaf != NULL && new_leaf != NULL) {
    cache_leafnames_remove(old_parent, old_leaf);

    if (!cache_leafnames_append(cache, old_parent, new_leaf)) {
      cache_leafnames_release(cache, old_parent);
    }

    return;
  }

  /* Otherwise (a cross-directory move or a non-authoritative listing), throw away the source directory's cached enumeration. */
  invalidate_parent_enum(cache, old_parent);

  /* Invalidate the destination as well, but only when it is a different directory from the one already dropped. */
  if (new_parent != old_parent) {
    invalidate_parent_enum(cache, new_parent);
  }
}

/*
 * Drop a deleted child's leaf from its parent directory's listing.
 *
 * The leaf is removed from a definitive listing, and from one a scan is still building, which may already have passed it; a parent with
 * no listing is left alone.  Keeping the listing in step means a later fast-miss probe correctly reports the child as absent.
 *
 * Parameters:
 *   cache       per-mount cache
 *   child_path  DOS path of the removed child
 */
static void notify_parent_removed_child(LMCache_t *cache, const char *child_path) {
  /* Resolve the parent directory cnode and the removed child's leaf name from the child path. */
  char parent_buf[LMCACHE_PATH_BUF_BYTES];
  const char *leaf = NULL;
  LMCacheNode_t *parent = resolve_parent_for_child(cache, child_path, parent_buf, sizeof(parent_buf), &leaf);

  /* A parent that is not cached, or not a directory, holds no listing to correct, and cache_leafnames_remove passes it over. */
  cache_leafnames_remove(parent, leaf);
}

/*
 * Replace a file cnode's captured content with a copy of the bytes given.
 *
 * A full content heap gives up captured content to make room (expired content first, then the least recently used, this file's included),
 * as Cache_StreamClaim does, but never a directory listing.  With no room even so, the file keeps whatever content it still holds, and a
 * read of anything not held goes to the server.  The new content's lifetime starts now.
 *
 * Parameters:
 *   cache   per-mount cache
 *   node    file cnode
 *   data    bytes to copy
 *   length  number of bytes at data; non-zero and within the mount's per-file cap
 */
static void set_file_content(LMCache_t *cache, LMCacheNode_t *node, const void *data, uint64_t length) {
  uint8_t *block = (uint8_t *)srheap_claim(&cache->content_heap, (size_t)length);
  uint32_t round;

  /* Make room from captured content only, a block at a time, for as many rounds as recovery allows itself. */
  for (round = 0u; block == NULL && round < LMCACHE_RECOVERY_ROUNDS && release_content_for_room(cache); round++) {
    block = (uint8_t *)srheap_claim(&cache->content_heap, (size_t)length);
  }

  if (block == NULL) {
    return;
  }

  memcpy(block, data, (size_t)length);
  release_file_content(cache, node);
  node->u.file.data = block;
  node->u.file.data_expires_at = cache_now() + cache->content_ttl;
}

/*
 * Abandon every capture in progress through a handle bound to a file whose bytes have changed, or may have.
 *
 * A capture holds what was read before the change.  The checks made when it is attached (the length, details current and unchanged since
 * the claim, no other handle open) cannot see a write through a handle closed in the meantime or a create over the file, nor another
 * client's change that keeps the length and lands within the resolution of the datestamp.
 *
 * Parameters:
 *   node  the changed file's cnode
 */
static void release_captures_of(const LMCacheNode_t *node) {
  size_t i;

  for (i = 0; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
    if (lm_handle_table[i].node == node && lm_handle_table[i].stream != NULL) {
      Cache_StreamRelease((uint8_t)(i + 1u));
    }
  }
}

/*
 * Reset the whole cache to empty, keeping only the pinned root directory.
 *
 * Every name, captured file content and listing goes with the heaps they live in, every handle bound into the cache is unbound and every
 * capture in progress dropped, and every slab slot but the root's returns to the free list.  The root is rebuilt in place as an empty
 * directory with no listing.  mutation_gen moves, so a cnode pointer held across the flush re-resolves as stale.
 *
 * Parameters:
 *   cache  per-mount cache to empty
 */
static void cache_flush_entire(LMCache_t *cache) {
  size_t i;
  uint32_t hash_size;
  LMCacheNode_t *root;
  char *dst;

  /* Discard every heap-held name, file content block and leafnames blob in one sweep. */
  srheap_reset(&cache->str_heap);
  srheap_reset(&cache->content_heap);

  /* Detach every open handle bound to this cache: the cnodes it references are about to disappear, as are captures in progress. */
  for (i = 0; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
    if (lm_handle_table[i].cache == cache) {
      lm_handle_table[i].node = NULL;
    }

    if (lm_handle_table[i].stream_cache == cache) {
      lm_handle_table[i].stream_cache = NULL;
      lm_handle_table[i].stream = NULL;
    }
  }

  hash_size = (uint32_t)cache->hash_mask + 1u;

  for (i = 0; i < (size_t)hash_size; i++) {
    cache->hash_table[i] = NULL;
  }

  lru_sentinel_init(&cache->hot_sentinel);
  lru_sentinel_init(&cache->cold_sentinel);
  cache->hot_len = 0u;
  cache->dir_oldest = NULL;
  cache->dir_newest = NULL;

  for (i = 1; i < (size_t)cache->slab_capacity; i++) {
    cache->root_node[i].mount = NULL;
  }

  /* Rebuild the free list and reinitialise the pinned root in place as an empty, non-definitive directory. */
  slab_build_free_list(cache);

  root = cache->root_node;
  root->u.file.prev = NULL;
  root->u.file.next = NULL;
  child_links_init(root);
  root->next.hash_next = NULL;
  root->mount = cache;
  root->hash = cache_hash_full("");
  root->length = LMCACHE_DIR_LENGTH; // the root keeps the date it was given when the mount was created
  root->attrs = 0u;
  root->expires_at = 0u;
  root->suppress_until = 0u;
  root->obj_type = LMCACHE_OBJECT_DIRECTORY;
  root->flags = 0u;
  root->name = NULL;
  root->name_len = 0u;
  root->u.dir.leafnames_blob = NULL;
  root->u.dir.leafnames_size = 0u;
  root->u.dir.leafnames_capacity = 0u;
  root->u.dir.older = NULL;
  root->u.dir.newer = NULL;

  dst = (char *)srheap_claim(&cache->str_heap, 1u);

  /* Give the root an empty-string name from the freshly reset string heap. */
  if (dst != NULL) {
    dst[0] = '\0';
    root->name = dst;
    root->name_len = 0u;
  }

  /* Re-link the root into its bucket and bump mutation_gen so any pointer held across the flush re-resolves as stale. */
  hash_link(cache, root);

  cache->mutation_gen++;
}

void Cache_Flush(LMCache_t *cache) {
  if (cache != NULL) {
    cache_flush_entire(cache);
  }
}

void Cache_KeepTime(void) {
  if (lm_clock_fn != NULL) {
    (void)cache_now();
  }
}

LMCacheNode_t *Cache_NotifyCreate(LMCache_t *cache, const char *path, uint8_t obj_type, uint32_t load_addr, uint32_t exec_addr,
                                  uint64_t length, uint32_t attrs) {
  char parent_buf[LMCACHE_PATH_BUF_BYTES];
  LMCacheNode_t *parent;
  LMCacheNode_t *existing;
  LMCacheNode_t *node;
  uint8_t prev_type;
  bool was_present;

  /* Bail on a missing cache or path, or if no clock is wired up, because every insert needs a timestamp. */
  if (cache == NULL || path == NULL || lm_clock_fn == NULL) {
    return NULL;
  }

  /* Normalise to a mount-relative path by dropping any leading separator. */
  path = skip_leading_sep(path);

  /* An empty path denotes the share root, which always exists and is never created here. */
  if (path[0] == '\0') {
    return NULL;
  }

  /* Note the time of this local change, so a CHANGE_NOTIFY overflow soon after is taken for the server reporting this client's changes. */
  cache->last_local_mutation_at = cache_now();

  parent = NULL;

  /* Split off the parent path; a path too long to split is unrepresentable, so give up. */
  if (path_split_parent(path, parent_buf, sizeof(parent_buf)) == NULL) {
    return NULL;
  }

  /* The server has made the object, so every directory above it exists. */
  cache_admit_ancestors(cache, parent_buf);

  /* A top-level entry: its parent is the share root. */
  if (parent_buf[0] == '\0') {
    parent = cache->root_node;
  } else {
    parent = find_path_any(cache, parent_buf);

    /* Parent not yet cached: materialise the whole ancestor chain so the new node has somewhere to hang. */
    if (parent == NULL) {
      parent = cache_ensure_dir_chain_cached(cache, parent_buf);
    }

    /* Refuse to attach if the ancestor chain could not be built or resolves to a non-directory. */
    if (parent == NULL || parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
      return NULL;
    }
  }

  /* Snapshot prior presence and type before the insert, so a genuine appearance can be told from a mere refresh. */
  existing = find_path_any(cache, path);
  was_present = (existing != NULL);
  prev_type = (existing != NULL) ? existing->obj_type : LMCACHE_OBJECT_NOTHING;

  node = cache_insert_or_refresh(cache, parent, path, obj_type, load_addr, exec_addr, length, attrs);

  /* The insert/refresh can fail under slab pressure with no room recoverable. */
  if (node == NULL) {
    return NULL;
  }

  /* The create replaced whatever bytes an existing file held, even at the same length and datestamp. */
  release_file_content(cache, node);
  release_captures_of(node);

  /* Only a newly-appeared entry, or one that changed type, needs adding to the parent's listing; a plain metadata refresh does not. */
  if (!was_present || prev_type != obj_type) {
    notify_parent_added_child(cache, path, obj_type);
  }

  return node;
}

LMCacheNode_t *Cache_NotifyMkdir(LMCache_t *cache, const char *path, uint32_t attrs) {
  LMCacheNode_t *node;
  unsigned orphans_swept = 0u;

  /* Create or refresh the directory node itself; its date is not known, so it carries none and is left expired below. */
  node = Cache_NotifyCreate(cache, path, (uint8_t)LMCACHE_OBJECT_DIRECTORY, 0u, 0u, LMCACHE_DIR_LENGTH, attrs);

  if (node == NULL) {
    /* Without a node the directory cannot be made definitive; log why the authoritative mkdir was abandoned. */
    debug("MKDIR_DEFINITIVE_FAILED path=\"%s\" reason=create_failed\n", path != NULL ? path : "(null)");
    return NULL;
  }

  /* Any cnode still parented to this directory is a stale leftover that must not survive into a freshly-made, known-empty directory. */
  while (node->first_child != NULL) {
    LMCacheNode_t *slot = node->first_child;

    /* A stale subdirectory drags its whole descendant subtree; a plain child needs only its own slot cleared. */
    if (slot->obj_type == LMCACHE_OBJECT_DIRECTORY) {
      evict_node_and_subtree(cache, slot);
    } else {
      evict_node_only(cache, slot);
    }

    orphans_swept++;
  }

  /* The server stamped the new directory's date, which the caller does not know, so its details are read afresh on first use. */
  node->expires_at = 0u;

  /* Give it an empty listing, complete from the start, so future lookups in it resolve in RAM without a wire enumeration. */
  if (!cache_leafnames_begin_build(cache, node)) {
    /* No room for a listing: the directory node is still good, so keep it but leave it non-definitive; lookups fall back to the wire. */
    debug("MKDIR_DEFINITIVE_FAILED path=\"%s\" reason=blob_build_failed orphans_swept=%u\n", path, orphans_swept);
    return node;
  }

  cache_leafnames_finish_build(cache, node);
  debug("MKDIR_DEFINITIVE path=\"%s\" cnode=%p orphans_swept=%u\n", path, (void *)node, orphans_swept);

  return node;
}

LMCacheNode_t *Cache_NotifyLearned(LMCache_t *cache, const char *path, uint8_t obj_type, uint32_t load_addr, uint32_t exec_addr,
                                   uint64_t length, uint32_t attrs) {
  char parent_buf[LMCACHE_PATH_BUF_BYTES];
  LMCacheNode_t *parent;

  /* Need a cache, a path, and a clock to timestamp the entry. */
  if (cache == NULL || path == NULL || lm_clock_fn == NULL) {
    return NULL;
  }

  path = skip_leading_sep(path);

  /* The share root is never learned as a child. */
  if (path[0] == '\0') {
    return NULL;
  }

  parent = NULL;

  /* Split off the parent path; unsplittable (over-long) paths are dropped. */
  if (path_split_parent(path, parent_buf, sizeof(parent_buf)) == NULL) {
    return NULL;
  }

  /* The server has reported the object, so every directory above it exists. */
  cache_admit_ancestors(cache, parent_buf);

  /* A top-level entry parents to the share root; otherwise look the parent up. */
  if (parent_buf[0] == '\0') {
    parent = cache->root_node;
  } else {
    parent = find_path_any(cache, parent_buf);

    /* Materialise missing ancestor directories so the learned node has a home. */
    if (parent == NULL) {
      parent = cache_ensure_dir_chain_cached(cache, parent_buf);
    }

    /* Give up if the ancestor chain is unbuildable or does not resolve to a directory. */
    if (parent == NULL || parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
      return NULL;
    }
  }

  /*
   * Note prior state, then insert or refresh.  The details come from the server, not from a change this client made, so no
   * local-change time is stamped.
   */
  {
    LMCacheNode_t *existing = find_path_any(cache, path);
    uint8_t prev_type = (existing != NULL) ? existing->obj_type : LMCACHE_OBJECT_NOTHING;
    LMCacheNode_t *node = cache_insert_or_refresh(cache, parent, path, obj_type, load_addr, exec_addr, length, attrs);

    /* Add the leaf to the parent's listing only when the entry genuinely appears or changes type. */
    if (node != NULL && (existing == NULL || prev_type != obj_type)) {
      notify_parent_added_child(cache, path, obj_type);
    }

    /* Content that survived the refresh has just been checked against the server, so it earns a fresh lifetime. */
    if (node != NULL && node->obj_type == LMCACHE_OBJECT_FILE && node->u.file.data != NULL && lm_clock_fn != NULL) {
      node->u.file.data_expires_at = cache_now() + cache->content_ttl;
    }

    return node;
  }
}

/*
 * Keep a copy of a file's whole content on the cnode just inserted or refreshed for it, where Cache_ShouldCacheContent allows and the file
 * has been read before.
 *
 * Running out of content heap is not an error: a read of anything not held goes to the server.
 *
 * Parameters:
 *   cache   per-mount cache
 *   node    the file's cnode, or NULL when recording its details failed
 *   length  length of data in bytes
 *   data    the whole file
 *
 * Returns: node, unchanged.
 */
static LMCacheNode_t *install_whole_content(LMCache_t *cache, LMCacheNode_t *node, uint64_t length, const void *data) {
  if (node != NULL && Cache_ShouldCacheContent(cache, node->load_addr, length) && Cache_ReadAgain(node)) {
    set_file_content(cache, node, data, length);
  }

  return node;
}

LMCacheNode_t *Cache_NotifyLearnedWithContent(LMCache_t *cache, const char *path, uint32_t load_addr, uint32_t exec_addr, uint64_t length,
                                              uint32_t attrs, const void *data) {
  LMCacheNode_t *node = Cache_NotifyLearned(cache, path, (uint8_t)LMCACHE_OBJECT_FILE, load_addr, exec_addr, length, attrs);

  return install_whole_content(cache, node, length, data);
}

bool Cache_ShouldCacheContent(const LMCache_t *cache, uint32_t load_addr, uint64_t length) {
  if (cache == NULL || cache->content_caching_disabled) {
    return false;
  }

  if (length == 0u || length > (uint64_t)cache->max_cacheable_file_bytes) {
    return false;
  }

  return is_cacheable_filetype(load_addr);
}

bool Cache_ReadAgain(LMCacheNode_t *node) {
  bool again = (node->flags & LMCACHE_FLAG_READ_BEFORE) != 0u;

  node->flags |= LMCACHE_FLAG_READ_BEFORE;
  vdebug("READ_AGAIN node=%p again=%d\n", (void *)node, again ? 1 : 0);

  return again;
}

/*
 * Install a fully captured content block as a file cnode's cached content, freeing any block it already held.
 *
 * The capture is refused unless the cnode still describes a file of exactly the captured length and its details are current: a change
 * notification handled while the file was open expires them, and means the bytes may not be the file's current content.  The content's
 * lifetime starts here.
 *
 * Parameters:
 *   cnode   file cnode belonging to a mount
 *   block   captured content, taken over by the cnode on success
 *   length  number of bytes captured in block
 *
 * Returns: true once installed; false, leaving block with the caller, if cnode is NULL, not a file, belongs to no mount, no clock is
 * installed, or the cnode no longer matches the capture.
 */
static bool Cache_AttachContent(LMCacheNode_t *cnode, uint8_t *block, uint64_t length) {
  LMCache_t *cache;
  uint8_t *old;

  if (cnode == NULL || block == NULL) {
    return false;
  }

  if (cnode->obj_type != LMCACHE_OBJECT_FILE) {
    return false;
  }

  cache = cnode->mount;

  /* A cnode with no mount is a vacant slot, and with no clock the content could not be given a lifetime. */
  if (cache == NULL || lm_clock_fn == NULL) {
    return false;
  }

  /* The file changed length, or its details were expired, while the handle was open: the captured bytes may be out of date. */
  if (cnode->length != length || cnode->expires_at <= cache_now()) {
    return false;
  }

  /* Point the cnode at the new block before freeing the old, so it never points at freed memory. */
  old = cnode->u.file.data;
  cnode->u.file.data = block;
  cnode->u.file.data_expires_at = cache_now() + cache->content_ttl;

  if (old != NULL) {
    srheap_free(&cache->content_heap, old);
  }

  return true;
}

/*
 * Forget a path that no longer exists on the server, with its subtree and its entry in the parent's listing.
 *
 * Parameters:
 *   cache  per-mount cache
 *   path   bare DOS path of the removed object; never the share root
 */
static void forget_removed_path(LMCache_t *cache, const char *path) {
  LMCacheNode_t *node;

  /* Resolve the doomed cnode, then tell the parent to forget the leaf: its cached listing must drop the entry whether or not the child is
   * still cached.
   */
  node = find_path_any(cache, path);

  notify_parent_removed_child(cache, path);

  /* Unknown path, or the pinned share root: the parent listing is already fixed, so stop here. */
  if (node == NULL || node == cache->root_node) {
    return;
  }

  /* A directory delete cascades: evict the whole subtree, children first, so no parent pointer is left dangling. */
  evict_node_and_subtree(cache, node);
}

void Cache_NotifyDelete(LMCache_t *cache, const char *path) {
  if (cache == NULL || path == NULL) {
    return;
  }

  /* Callers pass wire-format paths; strip any leading separator to the bare DOS path the tree is keyed on. */
  path = skip_leading_sep(path);

  /* An empty path is the share root, which is pinned and never evicted. */
  if (path[0] == '\0') {
    return;
  }

  /* Note the time of this local change, so a CHANGE_NOTIFY overflow soon after is taken for the server reporting this client's changes. */
  cache->last_local_mutation_at = cache_now();

  forget_removed_path(cache, path);
}

void Cache_NotifyRemoved(LMCache_t *cache, const char *path) {
  if (cache == NULL || path == NULL) {
    return;
  }

  path = skip_leading_sep(path);

  /* The share root is pinned and never evicted. */
  if (path[0] == '\0') {
    return;
  }

  forget_removed_path(cache, path);
}

void Cache_NotifyMutate(LMCache_t *cache, const char *path, uint32_t load_addr, uint32_t exec_addr, uint64_t length, uint32_t attrs,
                        bool content_changed) {
  LMCacheNode_t *node;

  /* A live clock is mandatory here (the metadata lifetime is stamped below), so return if it or the arguments are missing. */
  if (cache == NULL || path == NULL || lm_clock_fn == NULL) {
    return;
  }

  /* Normalise to the bare DOS path the tree is keyed on. */
  path = skip_leading_sep(path);

  /* An empty path is the share root, which carries no metadata of its own to refresh. */
  if (path[0] == '\0') {
    return;
  }

  /* Record the local mutation (records the change as this client's own, for the overflow check), then resolve the target cnode. */
  cache->last_local_mutation_at = cache_now();

  node = find_path_any(cache, path);

  /* The change touched a path that was never cached: nothing to refresh. */
  if (node == NULL) {
    return;
  }

  /*
   * The path was cached as absent, yet the server has just changed it: drop the stale negative and add the name to the parent's listing.
   * A later lookup asks the server for the details.
   */
  if (node->obj_type == LMCACHE_OBJECT_NOTHING) {
    evict_node_only(cache, node);
    notify_parent_added_child(cache, path, LMCACHE_OBJECT_FILE);

    return;
  }

  /* Existing cnode: overwrite the cached metadata in place and restart the lifetime. */
  debug("NOTIFY_MUTATE path=\"%s\" old_len=%u new_len=%u\n", path, (unsigned)node->length, (unsigned)length);

  /* A changed length or datestamp means the captured content is out of date. */
  release_content_if_changed(cache, node, load_addr, exec_addr, length);
  copy_metadata(node, load_addr, exec_addr, length, attrs);
  node->expires_at = cache_now() + cache->metadata_ttl;

  /* The caller has reported that the bytes changed even if the length and datestamp did not. */
  if (content_changed) {
    release_file_content(cache, node);
    release_captures_of(node);
  }
}

void Cache_NotifyMutateNode(LMCache_t *cache, LMCacheNode_t *node, uint32_t load_addr, uint32_t exec_addr, uint64_t length, uint32_t attrs,
                            bool content_changed) {
  /*
   * The caller passes the cnode directly, so no wire call may have come between resolving it and this call; a live clock is also required
   * for the lifetime below.
   */
  if (cache == NULL || node == NULL || lm_clock_fn == NULL) {
    return;
  }

  /* Record the local mutation for overflow accounting. */
  cache->last_local_mutation_at = cache_now();

  /* Skip the pinned share root and negative entries: neither carries file metadata to refresh. */
  if (node == cache->root_node || node->obj_type == LMCACHE_OBJECT_NOTHING) {
    return;
  }

  debug("NOTIFY_MUTATE_NODE node=%p name=\"%s\" old_len=%u new_len=%u\n", (void *)node, node->name != NULL ? node->name : "(no-name)",
        (unsigned)node->length, (unsigned)length);

  /* A changed length or datestamp means the captured content is out of date. */
  release_content_if_changed(cache, node, load_addr, exec_addr, length);

  /* Overwrite the cached metadata and restart the lifetime, unless the node was expired outright: its other details are not trusted. */
  copy_metadata(node, load_addr, exec_addr, length, attrs);

  if (node->expires_at != 0u) {
    node->expires_at = cache_now() + cache->metadata_ttl;
  }

  /* The caller has reported that the bytes changed even if the length and datestamp did not. */
  if (content_changed) {
    release_file_content(cache, node);
    release_captures_of(node);
  }
}

void Cache_NotifyChange(LMCache_t *cache, const char *path) {
  LMCacheNode_t *node;

  if (cache == NULL || path == NULL) {
    return;
  }

  path = skip_leading_sep(path);

  node = find_path_any(cache, path);

  if (node == NULL) {
    return;
  }

  /* Force-expire the metadata so the next access re-validates against the server. */
  node->expires_at = 0u;

  /*
   * A file's captured content is now suspect.  A directory's listing is not: a change to the directory itself (its datestamp moves whenever
   * a child is written) leaves its names as they were, and names that come or go are reported on their own.
   */
  if (node->obj_type == LMCACHE_OBJECT_FILE) {
    release_file_content(cache, node);
    release_captures_of(node);
  }
}

void Cache_NotifyDirExists(LMCache_t *cache, const char *path) {
  LMCacheNode_t *node;

  if (cache == NULL || path == NULL) {
    return;
  }

  path = skip_leading_sep(path);

  /* The share root always exists. */
  if (path[0] == '\0') {
    return;
  }

  cache_admit_ancestors(cache, path);

  /* Anything still cached there as other than a directory is wrong: expire it so the next lookup asks the server. */
  node = find_path_any(cache, path);

  if (node != NULL && node->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    Cache_NotifyChange(cache, path);
  }
}

void Cache_NotifyAdded(LMCache_t *cache, const char *path) {
  char parent_buf[LMCACHE_PATH_BUF_BYTES];
  LMCacheNode_t *node;
  LMCacheNode_t *parent;
  const char *leaf = NULL;

  if (cache == NULL || path == NULL) {
    return;
  }

  path = skip_leading_sep(path);

  /* The share root is never added. */
  if (path[0] == '\0') {
    return;
  }

  /* Whatever was held under the name is out of date; a directory there before may have held other contents. */
  node = find_path_any(cache, path);

  if (node != NULL) {
    Cache_NotifyChange(cache, path);

    if (node->obj_type == LMCACHE_OBJECT_DIRECTORY) {
      cache_leafnames_release(cache, node);
    }
  }

  /* The parent's own datestamp moved, and its listing gains the name. */
  if (path_split_parent(path, parent_buf, sizeof parent_buf) != NULL) {
    Cache_NotifyChange(cache, parent_buf);
  }

  /*
   * The server adding a name its listing, finished or still being built, already holds in another case means it keeps both, as a
   * case-sensitive server can.  Only the server's report counts: a local create in another case cannot be told from the server
   * overwriting the existing name.
   */
  parent = resolve_parent_for_child(cache, path, parent_buf, sizeof parent_buf, &leaf);

  if (parent != NULL && parent->obj_type == LMCACHE_OBJECT_DIRECTORY && parent->u.dir.leafnames_blob != NULL &&
      leafidx_find_slot(parent, leaf, leaf_case_twin) >= 0) {
    debug("CASE_TWINS_SET path=\"%s\" leaf=\"%s\" (notified)\n", parent_buf, leaf);
    cache_leafnames_release(cache, parent);
    parent->flags |= LMCACHE_FLAG_CASE_TWINS;

    return;
  }

  notify_parent_added_child(cache, path, LMCACHE_OBJECT_FILE);
}

/*
 * Expire the details a renamed symbolic link carries, which are its target's: a relative link moved to another directory points at
 * another object, so the server is asked again.
 *
 * Parameters:
 *   node              the cnode now at the new path, or NULL if it could not be recorded
 *   resolved_symlink  true if the object renamed was a symbolic link cached with its target's details
 */
static inline void expire_moved_symlink(LMCacheNode_t *node, bool resolved_symlink) {
  if (node != NULL && resolved_symlink) {
    node->expires_at = 0u;
  }
}

/*
 * Test whether one canonical DOS path lies strictly within another's subtree.
 *
 * Recovery uses it to keep away from the directories above a path being installed.  The match is strict (the ancestor is not its own
 * descendant) and requires a backslash immediately after the prefix so that "Foobar" is not mistaken for a child of "Foo".  Comparison is
 * case-insensitive to match SMB name semantics.
 *
 * Parameters:
 *   candidate_path  path being tested
 *   ancestor_path   prospective ancestor; never the share root's empty path
 *
 * Returns: true iff candidate_path names something strictly below ancestor_path.
 */
static bool path_is_descendant_of(const char *candidate_path, const char *ancestor_path) {
  size_t alen = strlen(ancestor_path);

  /* Reject unless the ancestor is a case-insensitive prefix of the candidate. */
  if (cache_strncasecmp_n(candidate_path, ancestor_path, alen) != 0) {
    return false;
  }

  /* Require a separator immediately after the prefix, so 'foobar' does not count as a child of 'foo'. */
  return candidate_path[alen] == '\\';
}

void Cache_NotifyRename(LMCache_t *cache, const char *old_path, const char *new_path) {
  /* The old_* locals snapshot the source node's identity up front, so it survives the eviction and re-insertion a move performs. */
  char new_parent_buf[LMCACHE_PATH_BUF_BYTES];
  const char *new_leaf;
  LMCacheNode_t *old_node;
  LMCacheNode_t *new_existing;
  LMCacheNode_t *new_parent;
  uint32_t old_load;
  uint32_t old_exec;
  uint64_t old_length;
  uint32_t old_attrs;
  uint8_t old_obj_type;
  bool old_resolved_symlink;
  LMCacheNode_t *moved;

  if (cache == NULL || old_path == NULL || new_path == NULL) {
    return;
  }

  /* Reduce both paths to the cache's separator-free key form before any lookup. */
  old_path = skip_leading_sep(old_path);
  new_path = skip_leading_sep(new_path);

  /* A path that collapses to empty is the share root, which has no leaf to move. */
  if (old_path[0] == '\0' || new_path[0] == '\0') {
    return;
  }

  /* Note the time of this local change, so a CHANGE_NOTIFY overflow soon after is taken for the server reporting this client's changes. */
  cache->last_local_mutation_at = cache_now();

  new_leaf = path_split_parent(new_path, new_parent_buf, sizeof(new_parent_buf));

  /* Split the destination into parent directory and leaf; return if it will not fit the scratch buffer. */
  if (new_leaf == NULL) {
    return;
  }

  /* The server has moved the object, so every directory above the destination exists. */
  cache_admit_ancestors(cache, new_parent_buf);

  /* An empty parent string means the destination lands at the share root. */
  if (new_parent_buf[0] == '\0') {
    new_parent = cache->root_node;
  } else {
    new_parent = find_path_any(cache, new_parent_buf);

    /* Materialise the destination parent in the cache if it is not already there, so the moved node has somewhere to hang. */
    if (new_parent == NULL) {
      new_parent = cache_ensure_dir_chain_cached(cache, new_parent_buf);
    }

    /* Give up unless the destination parent is established as a directory. */
    if (new_parent == NULL || new_parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
      return;
    }
  }

  old_node = find_path_any(cache, old_path);

  /* A negative at the source went stale when the server renamed the object: drop it, and treat the source as never cached. */
  if (old_node != NULL && old_node->obj_type == LMCACHE_OBJECT_NOTHING) {
    evict_node_only(cache, old_node);
    old_node = NULL;
  }

  /*
   * The source was never cached (or is the root itself): nothing to move, so stale both parents' listings and let the next
   * enumeration refetch.
   */
  if (old_node == NULL || old_node == cache->root_node) {
    new_existing = find_path_any(cache, new_path);

    /* Whatever was cached at the destination, including an entry recording it as absent, has been replaced. */
    if (new_existing != NULL && new_existing != cache->root_node) {
      evict_node_and_subtree(cache, new_existing);
    }

    invalidate_parent_enum(cache, new_parent);
    invalidate_parent_enum_by_path(cache, old_path);

    return;
  }

  /* Snapshot the source node's metadata now, before collision handling or eviction can free it. */
  old_load = old_node->load_addr;
  old_exec = old_node->exec_addr;
  old_length = old_node->length;
  old_attrs = old_node->attrs;
  old_obj_type = old_node->obj_type;
  old_resolved_symlink = (old_node->flags & LMCACHE_FLAG_RESOLVED_SYMLINK) != 0u;

  new_existing = find_path_any(cache, new_path);

  /*
   * A node already occupying the destination is being overwritten, so evict it and its subtree first; that may take the source with it,
   * so re-resolve the source pointer afterwards.
   */
  if (new_existing != NULL && new_existing != old_node) {
    evict_node_and_subtree(cache, new_existing);

    old_node = find_path_any(cache, old_path);

    /*
     * If the eviction also took the source node, insert the destination straight from the snapshot instead of moving a freed node, but
     * only while the destination parent still belongs to this mount.
     */
    if (old_node == NULL) {
      if (new_parent->mount != cache) {
        return;
      }

      moved = cache_insert_or_refresh(cache, new_parent, new_path, old_obj_type, old_load, old_exec, old_length, old_attrs);
      expire_moved_symlink(moved, old_resolved_symlink);
      invalidate_parent_enum_by_path(cache, old_path);

      return;
    }
  }

  /*
   * Directory rename: the whole subtree moves, so evict and re-insert rather than splice.  Capture the old leaf name first, for the
   * parent's listing.
   */
  if (old_obj_type == LMCACHE_OBJECT_DIRECTORY) {
    char old_dir_parent_buf[LMCACHE_PATH_BUF_BYTES];
    char old_dir_leaf[RENAME_LEAF_BUF_BYTES];
    const char *old_dir_leaf_ptr = path_split_parent(old_path, old_dir_parent_buf, sizeof(old_dir_parent_buf));
    size_t old_dir_leaf_len = (old_dir_leaf_ptr != NULL) ? strlen(old_dir_leaf_ptr) : 0u;

    /* Copy the old leaf into a fixed buffer, defaulting to empty when it is missing or oversized. */
    if (old_dir_leaf_ptr == NULL || old_dir_leaf_len >= sizeof old_dir_leaf) {
      old_dir_leaf[0] = '\0';
    } else {
      memcpy(old_dir_leaf, old_dir_leaf_ptr, old_dir_leaf_len);
      old_dir_leaf[old_dir_leaf_len] = '\0';
    }

    /* Drop the entire old subtree, because the move invalidates every child's path. */
    evict_node_and_subtree(cache, old_node);

    /* An empty parent string means the destination lands at the share root. */
    if (new_parent_buf[0] == '\0') {
      new_parent = cache->root_node;
    } else {
      new_parent = find_path_any(cache, new_parent_buf);

      /* Materialise the destination parent in the cache if it is not already there, so the moved node has somewhere to hang. */
      if (new_parent == NULL) {
        new_parent = cache_ensure_dir_chain_cached(cache, new_parent_buf);
      }

      /* Give up unless the destination parent is established as a directory. */
      if (new_parent == NULL || new_parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
        /*
         * If the parent cannot be re-established, at least stale the old parent's listing before giving up.  Re-resolve it by path
         * rather than reusing a captured pointer: the eviction and ensure-chain above can evict it.
         */
        LMCacheNode_t *src_parent = (old_dir_parent_buf[0] == '\0') ? cache->root_node : find_path_any(cache, old_dir_parent_buf);
        invalidate_parent_enum(cache, src_parent);
        return;
      }
    }

    moved = cache_insert_or_refresh(cache, new_parent, new_path, old_obj_type, old_load, old_exec, old_length, old_attrs);
    expire_moved_symlink(moved, old_resolved_symlink);

    /*
     * Re-resolve the source parent by path: the eviction above and the ensure-chain and insert either side can evict the cached node, so
     * a pointer captured before those calls could dangle.
     */
    {
      LMCacheNode_t *src_parent = (old_dir_parent_buf[0] == '\0') ? cache->root_node : find_path_any(cache, old_dir_parent_buf);
      notify_parent_renamed_child(cache, src_parent, old_dir_leaf, new_parent, new_leaf);
    }

    return;
  }

  /*
   * File rename: move the node in place, so any handle bound to it stays bound.  Capture the old parent and leaf first, for the
   * listings.
   */
  {
    LMCacheNode_t *old_parent = old_node->parent;

    char old_leaf[RENAME_LEAF_BUF_BYTES];
    size_t old_leaf_len = (size_t)old_node->name_len;

    /* Copy the current leaf, defaulting to empty when it is missing or oversized. */
    if (old_node->name == NULL || old_leaf_len >= sizeof old_leaf) {
      old_leaf[0] = '\0';
    } else {
      memcpy(old_leaf, old_node->name, old_leaf_len);
      old_leaf[old_leaf_len] = '\0';
    }

    /* Unlink from the hash chain: the key is about to change. */
    hash_unlink(cache, old_node);

    /* Try renaming within the existing name allocation; if the new name will not fit, free the old one to make room for a fresh store. */
    if (!try_inplace_rename(old_node, new_path, old_obj_type)) {
      release_name(cache, old_node);

      /*
       * If even a fresh store fails (string heap exhausted) the node can no longer be found by name, so pull it out of the hot-list
       * accounting on the way to eviction.
       */
      if (!store_name(cache, old_node, new_path, old_obj_type)) {
        if ((old_node->flags & LMCACHE_FLAG_HOT) != 0u) {
          cache->hot_len--;
        }

        /* Evict the now-nameless node and stale both parents' listings. */
        lru_unlink(old_node);
        evict_node(cache, old_node);
        invalidate_parent_enum(cache, old_parent);
        invalidate_parent_enum(cache, new_parent);

        return;
      }
    }

    /* Re-point the node at its new parent, recompute its hash key, and relink it under the new name. */
    child_set_parent(old_node, new_parent);
    old_node->hash = cache_hash_full(new_path);
    hash_link(cache, old_node);

    /* A renamed node loses hot status; drop it from the hot count before re-listing. */
    if ((old_node->flags & LMCACHE_FLAG_HOT) != 0u) {
      cache->hot_len--;
    }

    /* Re-list it at the cold list's MRU end, as a fresh entry. */
    lru_unlink(old_node);
    lru_push_cold_head(cache, old_node);
    expire_moved_symlink(old_node, old_resolved_symlink);

    notify_parent_renamed_child(cache, old_parent, old_leaf, new_parent, new_leaf);

    /* The node now answers to a different path: move the generation so a pointer held across the rename re-resolves. */
    cache->mutation_gen++;
  }
}

void Cache_NotifyRenameFailed(LMCache_t *cache, const char *old_path, const char *new_path) {
  if (cache == NULL || old_path == NULL || new_path == NULL) {
    return;
  }

  Cache_NotifyRename(cache, new_path, old_path);

  /* Putting the name back took new_path's leaf out of its directory's listing, though the object the server refused over is still there. */
  invalidate_parent_enum_by_path(cache, skip_leading_sep(new_path));
}

/*
 * Drop every listing and every capture in progress on a mount, and clamp every lifetime that runs past a deadline to it, after the
 * server may have failed to report changes.
 *
 * A listing may lack a name another client added, so it always goes; the details the listings named stay, under their own lifetimes.
 * Unless keep_details is set, every file's captured content goes too.  Content that stays has its lifetime clamped like the rest, since a
 * lost notification may have been another client's write.  Moves mutation_gen, so a cnode pointer held across the sweep is re-resolved.
 *
 * Parameters:
 *   cache          per-mount cache
 *   keep_details   true to leave the lifetimes of files' and directories' details alone and keep files' content, cutting only the
 *                  lifetimes of "not found" entries and of content
 *   latest         deadline no lifetime that is clamped may run past; 0 expires them outright
 */
static void cache_overflow_sweep(LMCache_t *cache, bool keep_details, LMCacheTime_t latest) {
  uint32_t i;

  /* Walk every live cnode, expiring what the lost notifications could have made stale and dropping the content and listings that cannot
   * be trusted.
   */
  for (i = 0u; i < cache->slab_capacity; i++) {
    LMCacheNode_t *n = &cache->root_node[i];

    if (n->mount == NULL) {
      continue;
    }

    /* A "not found" entry is as unsure as a listing: the name may have been made since. */
    if ((!keep_details || n->obj_type == LMCACHE_OBJECT_NOTHING) && n->expires_at > latest) {
      n->expires_at = latest;
    }

    if (n->obj_type == LMCACHE_OBJECT_FILE && n->u.file.data != NULL) {
      if (!keep_details) {
        release_file_content(cache, n);
      } else if (n->u.file.data_expires_at > latest) {
        n->u.file.data_expires_at = latest;
      }
    } else if (n->obj_type == LMCACHE_OBJECT_DIRECTORY) {
      cache_leafnames_release(cache, n);
    }
  }

  /* A capture attached later would start a full lifetime for bytes read before the lost notifications. */
  for (i = 0u; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
    if (lm_handle_table[i].stream != NULL && lm_handle_table[i].stream_cache == cache) {
      Cache_StreamRelease((uint8_t)(i + 1u));
    }
  }

  cache->mutation_gen++;
}

void Cache_NotifyOverflow(LMCache_t *cache) {
  LMCacheTime_t now;

  if (cache == NULL) {
    return;
  }

  now = cache_now();

  /*
   * An overflow soon after this client's own changes is most likely the server reporting a burst this client made, so the details keep
   * their lifetimes.  The listings still go, since another client's additions may have been lost with them.  A mount with the
   * aggressive-refresh quirk always clamps.
   */
  if ((cache->quirks & LMCACHE_QUIRK_AGGRESSIVE_REFRESH) == 0u && cache->last_local_mutation_at != 0u) {
    LMCacheTime_t since = now - cache->last_local_mutation_at;

    if (since <= LMCACHE_OVERFLOW_BUSY_THRESHOLD) {
      debug("CACHE_OVERFLOW[%s] SUPPRESSED self-busy since=%ucs (threshold=%ucs): listings dropped, details kept\n", cache->label,
            (unsigned)since, (unsigned)LMCACHE_OVERFLOW_BUSY_THRESHOLD);
      cache_overflow_sweep(cache, true, now + LMCACHE_DEFAULT_OVERFLOW_GRACE_TTL);

      return;
    }
  }

  /* Anything cached may be stale, so every entry is clamped to a short grace deadline rather than evicted outright. */
  cache_overflow_sweep(cache, false, now + LMCACHE_DEFAULT_OVERFLOW_GRACE_TTL);

  debug("CACHE_OVERFLOW[%s] SAFE-PATH ran: collapsed expires_at on all live cnodes, mutation_gen=%u\n", cache->label,
        (unsigned)cache->mutation_gen);
}

void Cache_NotifyConnectionLost(LMCache_t *cache) {
  if (cache == NULL) {
    return;
  }

  /* The outage may already be longer than any grace period, so nothing is trusted until the server is asked again. */
  cache_overflow_sweep(cache, false, 0u);

  debug("CACHE_OVERFLOW[%s] CONNECTION-LOST: expired every live cnode, mutation_gen=%u\n", cache->label, (unsigned)cache->mutation_gen);
}

/*
 * Report whether a cnode's own name ends in the path's leaf spelt exactly, not merely matching it ignoring case.
 *
 * Parameters:
 *   node  cnode found for the path
 *   path  DOS path, not the share root
 *
 * Returns: true if the leaves match byte for byte.
 */
static bool node_leaf_exact(const LMCacheNode_t *node, const char *path) {
  const char *leaf = strrchr(path, '\\');
  const char *stored = node->name;

  leaf = (leaf != NULL) ? leaf + 1 : path;

  /* A directory stores its whole path, so its leaf is the part after the last separator. */
  if (node->obj_type == LMCACHE_OBJECT_DIRECTORY && strrchr(stored, '\\') != NULL) {
    stored = strrchr(stored, '\\') + 1;
  }

  return strcmp(stored, leaf) == 0;
}

/*
 * Report whether a CHANGE_NOTIFY removal is the server echoing a removal this client made, for Cache_IsEcho.
 *
 * The cache must already hold nothing live at the path spelt exactly.  The window is the parent's, since a removal leaves no cnode to hold
 * one, and the parent's listing must not name the path spelt exactly either.  So another client's create and delete of a name beside this
 * client's is still applied, while the old name left by this client's change of letter case is skipped.
 *
 * Parameters:
 *   cache  per-mount cache
 *   path   DOS path the event names, not the share root
 *   now    current time
 *
 * Returns: true if the removal can be skipped as this client's echo.
 */
static bool removal_is_echo(LMCache_t *cache, const char *path, LMCacheTime_t now) {
  char parent_buf[LMCACHE_PATH_BUF_BYTES];
  const char *leaf = NULL;
  LMCacheNode_t *parent = resolve_parent_for_child(cache, path, parent_buf, sizeof parent_buf, &leaf);

  if (parent == NULL || parent->suppress_until <= now ||
      (parent->obj_type == LMCACHE_OBJECT_DIRECTORY && leafidx_find_slot(parent, leaf, leaf_exact) >= 0)) {
    return false;
  }

  debug("SUPPRESS_HIT path=\"%s\" remaining=%ucs\n", path, (unsigned)(parent->suppress_until - now));

  return true;
}

bool Cache_IsEcho(LMCache_t *cache, const char *path, bool removed) {
  LMCacheNode_t *node;
  LMCacheTime_t now;
  bool live;

  /* Treat any missing input as not an echo. */
  if (cache == NULL || path == NULL) {
    return false;
  }

  path = skip_leading_sep(path);

  /* Nothing changes the share root itself. */
  if (path[0] == '\0') {
    return false;
  }

  now = cache_now();
  node = find_path_any(cache, path);
  live = node != NULL && node->obj_type != LMCACHE_OBJECT_NOTHING;

  /* A removed name the cache holds only in another letter case is the old name of a change of case: that object lives on under the new. */
  if (removed) {
    return (!live || !node_leaf_exact(node, path)) && removal_is_echo(cache, path, now);
  }

  /* Anything else is this client's echo only for a file this client changed; another client's change beside it is applied. */
  if (!live || node->obj_type != LMCACHE_OBJECT_FILE || node->suppress_until <= now) {
    return false;
  }

  debug("SUPPRESS_HIT path=\"%s\" remaining=%ucs\n", path, (unsigned)(node->suppress_until - now));

  return true;
}

/*
 * Open, or extend, one cnode's echo window.
 *
 * Parameters:
 *   node  cnode whose window opens; NULL does nothing
 */
static void cache_open_echo_window(LMCacheNode_t *node) {
  if (node != NULL) {
    node->suppress_until = cache_now() + LMCACHE_DEFAULT_NOTIFY_BACKOFF;
  }
}

void Cache_BumpSuppress(LMCache_t *cache, const char *path) {
  char parent_buf[LMCACHE_PATH_BUF_BYTES];

  if (cache == NULL || path == NULL) {
    return;
  }

  path = skip_leading_sep(path);

  /* Nothing changes the share root itself. */
  if (path[0] == '\0') {
    return;
  }

  /* The object's own window covers the server reporting it added or modified, the parent's covers it reported removed. */
  cache_open_echo_window(find_path_any(cache, path));
  cache_open_echo_window(resolve_parent_for_child(cache, path, parent_buf, sizeof parent_buf, NULL));
}

void Cache_BumpSuppressNode(LMCacheNode_t *node) {
  if (node == NULL || node->mount == NULL || lm_clock_fn == NULL) {
    return;
  }

  cache_open_echo_window(node);
}

bool Cache_HandleAssign(uint8_t handle, LMCache_t *cache, LMCacheNode_t *node) {
  /* Handle zero is reserved to mean 'no handle'. */
  if (handle == 0u) {
    return false;
  }

  /* A handle number reused without being cleared first must not leave its previous file pointing at it. */
  if (lm_handle_table[handle - 1u].node != NULL && lm_handle_table[handle - 1u].node != node) {
    handle_unbind((size_t)handle - 1u);
  }

  /*
   * Record the handle on the node for the reverse mapping.  A file open on several handles keeps every binding, so writes through any of
   * them still reach its cached details.
   */
  if (node != NULL && node->obj_type == LMCACHE_OBJECT_FILE) {
    node->u.file.handle = handle;
  }

  /* Install the forward mapping; the handle minus one indexes the table. */
  lm_handle_table[handle - 1u].cache = cache;
  lm_handle_table[handle - 1u].node = node;

  return true;
}

void Cache_HandleClear(uint8_t handle) {
  if (handle == 0u) {
    return;
  }

  handle_unbind((size_t)handle - 1u);

  /* A capture the closing handle never attached would otherwise stay claimed until the heap is emptied. */
  Cache_StreamRelease(handle);
}

LMCacheNode_t *Cache_HandleLookup(uint8_t handle) {
  LMCacheNode_t *node;

  if (handle == 0u) {
    return NULL;
  }

  node = lm_handle_table[handle - 1u].node;

  /* Reads through the handle are served from the content, so this is where its lifetime is enforced. */
  if (node != NULL && node->mount != NULL) {
    release_content_if_expired(node->mount, node);
  }

  return node;
}

uint8_t *Cache_StreamClaim(uint8_t handle, LMCache_t *cache, size_t bytes) {
  LMHandleSlot_t *slot;
  uint32_t round;

  if (handle == 0u || cache == NULL) {
    return NULL;
  }

  Cache_StreamRelease(handle);

  slot = &lm_handle_table[handle - 1u];
  slot->stream = (uint8_t *)srheap_claim(&cache->content_heap, bytes);

  /* Make room from other files' content only, a block at a time, for as many rounds as recovery allows itself. */
  for (round = 0u; slot->stream == NULL && round < LMCACHE_RECOVERY_ROUNDS && release_content_for_room(cache); round++) {
    slot->stream = (uint8_t *)srheap_claim(&cache->content_heap, bytes);
  }

  slot->stream_cache = (slot->stream != NULL) ? cache : NULL;

  /*
   * Note the details the bytes will be read under, so an attach can tell whether the file has changed since.  A handle is bound only at
   * its open, so one bound to no file now never will be and its capture cannot attach; its details are cleared rather than left from an
   * earlier capture.
   */
  if (slot->node != NULL) {
    slot->stream_load_addr = slot->node->load_addr;
    slot->stream_exec_addr = slot->node->exec_addr;
    slot->stream_length = slot->node->length;
  } else {
    slot->stream_load_addr = 0u;
    slot->stream_exec_addr = 0u;
    slot->stream_length = 0u;
  }

  return slot->stream;
}

uint8_t *Cache_StreamBlock(uint8_t handle) {
  return (handle == 0u) ? NULL : lm_handle_table[handle - 1u].stream;
}

void Cache_StreamRelease(uint8_t handle) {
  LMHandleSlot_t *slot;

  if (handle == 0u) {
    return;
  }

  slot = &lm_handle_table[handle - 1u];

  if (slot->stream != NULL && slot->stream_cache != NULL) {
    srheap_free(&slot->stream_cache->content_heap, slot->stream);
  }

  slot->stream_cache = NULL;
  slot->stream = NULL;
}

bool Cache_StreamAttach(uint8_t handle, uint64_t length) {
  LMHandleSlot_t *slot;
  size_t i;

  if (handle == 0u) {
    return false;
  }

  slot = &lm_handle_table[handle - 1u];

  /* The block must land in the heap it came from, so the bound file must belong to the same mount. */
  if (slot->stream == NULL || slot->node == NULL || slot->node->mount != slot->stream_cache) {
    return false;
  }

  /* Details refreshed since the claim, even if current now, may describe bytes written after these were read. */
  if (slot->node->load_addr != slot->stream_load_addr || slot->node->exec_addr != slot->stream_exec_addr ||
      slot->node->length != slot->stream_length) {
    return false;
  }

  /* While the file is open on another handle too, it may have been written there since these bytes were captured. */
  for (i = 0; i < LMCACHE_HANDLE_TABLE_SIZE; i++) {
    if (i != (size_t)handle - 1u && lm_handle_table[i].node == slot->node) {
      return false;
    }
  }

  if (!Cache_AttachContent(slot->node, slot->stream, length)) {
    return false;
  }

  slot->stream_cache = NULL;
  slot->stream = NULL;

  return true;
}

/*
 * Record that a path does not exist on the server, as a negative entry under its cached parent directory.
 *
 * A lookup of the path then answers "not found" with no request until the entry expires, after the metadata lifetime.  Making room may
 * evict other entries, but never the parent or a directory above it.
 *
 * Parameters:
 *   cache   per-mount cache
 *   parent  the path's parent directory cnode
 *   path    DOS path known absent; a leading separator is skipped, and only the leaf is stored
 *
 * Returns: the negative cnode, or NULL if it could not be recorded (bad arguments, the path already cached, the parent not a directory, or
 * no room).
 */
static LMCacheNode_t *cache_insert_nothing(LMCache_t *cache, LMCacheNode_t *parent, const char *path) {
  LMCacheNode_t *node;
  char *dst;
  const char *leaf;
  const char *last_bs;
  size_t leaf_len;
  LMCacheTime_t now;
  uint32_t hash;

  if (cache == NULL || path == NULL || parent == NULL) {
    debug("INSERT_NEG_FAIL cache=%p parent=%p path=%p reason=null_args\n", (void *)cache, (void *)parent, (const void *)path);
    return NULL;
  }

  /* A negative must hang off a directory: its parent pointer is what anchors it in the tree. */
  if (parent->obj_type != LMCACHE_OBJECT_DIRECTORY) {
    debug("INSERT_NEG_FAIL path=\"%s\" reason=parent_not_dir parent_type=%u\n", path, (unsigned)parent->obj_type);
    return NULL;
  }

  /* Expiry is clock-relative, so refuse to insert a negative when no clock is installed. */
  if (lm_clock_fn == NULL) {
    debug("INSERT_NEG_FAIL path=\"%s\" reason=no_clock\n", path);
    return NULL;
  }

  /* Normalise to the stored, separator-free path form before hashing and lookup. */
  path = skip_leading_sep(path);

  /* Never shadow an existing entry with a negative: if anything is already cached for this path, leave it alone. */
  if (find_path_any(cache, path) != NULL) {
    debug("INSERT_NEG_FAIL path=\"%s\" reason=already_cached\n", path);
    return NULL;
  }

  /* Negatives store only the leaf name; the parent pointer supplies the rest of the path. */
  last_bs = strrchr(path, '\\');
  leaf = (last_bs != NULL) ? last_bs + 1 : path;
  leaf_len = strlen(leaf);

  /* name_len is a 16-bit field, so an over-long leaf cannot be represented. */
  if (leaf_len > 0xFFFFu) {
    debug("INSERT_NEG_FAIL path=\"%s\" reason=name_len_overflow len=%u\n", path, (unsigned)leaf_len);
    return NULL;
  }

  now = cache_now();

  /* Claim a slab slot and name storage, evicting other entries if the substrate is full. */
  if (!cache_claim_with_recovery(cache, path, false, leaf_len, &node, NULL, &dst)) {
    debug("INSERT_NEG_FAIL path=\"%s\" reason=substrate_exhausted\n", path);
    return NULL;
  }

  /* Populate the fresh cnode as a negative: negative-lifetime expiry, no content, no bound handle, and no echo window open. */
  node->mount = cache;
  child_links_init(node);
  child_set_parent(node, parent);
  node->obj_type = LMCACHE_OBJECT_NOTHING;
  node->flags = 0u;
  node->expires_at = now + cache->negative_ttl;
  node->suppress_until = 0u;
  node->u.file.prev = NULL;
  node->u.file.next = NULL;
  node->next.hash_next = NULL;
  node->load_addr = 0u;
  node->exec_addr = 0u;
  node->length = 0u;
  node->attrs = 0u;
  node->u.file.handle = 0u;
  node->u.file.data = NULL;
  node->u.file.data_expires_at = 0u;

  /* Store the leaf name, guarding against a null-source zero-length copy. */
  if (leaf_len > 0u) {
    memcpy(dst, leaf, leaf_len);
  }

  dst[leaf_len] = '\0';
  node->name = dst;

  /* Publish the negative: index it in the hash table and thread it onto the cold list so it ages and evicts like a file. */
  node->name_len = (uint16_t)leaf_len;

  hash = cache_hash_full(path);
  node->hash = hash;
  hash_link(cache, node);
  lru_push_cold_head(cache, node);
  dir_lru_touch(cache, parent);

  return node;
}

#endif // LM_CACHE
