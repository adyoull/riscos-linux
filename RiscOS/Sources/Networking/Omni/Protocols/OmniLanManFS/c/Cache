/*
 * Hand back a plain heap block as the default per-mount substrate allocator.
 *
 * Used only until a platform-specific allocator is registered via Cache_SetSubstrateAllocator; on RISC OS that replacement backs each
 * substrate with a named Dynamic Area, which is why the real allocator wants the label and returns a handle that this fallback has no use
 * for.
 *
 * Parameters:
 *   bytes       size of the substrate block to allocate
 *   label       mount label for naming the backing area; ignored by the heap fallback
 *   handle_out  optional out-param for the backing-store handle; set to 0 (no handle)
 *
 * Returns: pointer to the block, or NULL on allocation failure.
 */
static void *default_substrate_alloc(size_t bytes, const char *label, int *handle_out) {
  /* The label only matters to the Dynamic-Area allocator that names its area; the heap fallback has nothing to name. */
  (void)label;

  /* A heap block has no backing-store handle, so report 0 and the matching free ignores it. */
  if (handle_out != NULL) {
    *handle_out = 0;
  }

  return malloc(bytes);
}

/*
 * Release a substrate block obtained from default_substrate_alloc.
 *
 * Parameters:
 *   base    block to free
 *   bytes   original size; unused by the heap fallback
 *   handle  backing-store handle; unused by the heap fallback
 */
static void default_substrate_free(void *base, size_t bytes, int handle) {
  /* The heap free needs neither the original size nor the handle that a Dynamic-Area allocator's free would rely on. */
  (void)bytes;
  (void)handle;
  free(base);
}

