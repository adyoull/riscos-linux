/* 32-bit FNV-1a parameters for the path hash; bytes are case-folded as they are mixed in, so equal-modulo-case paths always collide. */
#define FNV1A_OFFSET          (0x811C9DC5U)
#define FNV1A_PRIME           (0x01000193U)

/* Index slot values: no name, or the mark of a removed one; anything else is a name's body offset plus one. */
#define LEAFIDX_EMPTY         (0u)
#define LEAFIDX_GONE          (0xFFFFu)

/* Slots in a listing's first index; the index doubles from there as names arrive. */
#define LEAFIDX_FIRST_SLOTS   (64u)

/*
 * First byte written over a removed name in the body, so walks of the body pass it over without the rest of the body having to move.
 * Never the first byte of a real name: DOS and NTFS names cannot contain control characters.
 */
#define LEAFNAME_GONE         ((uint8_t)0x01u)

/* Room for the old leaf name a rename captures for the parents' listings, terminator included; a longer one is captured as empty. */
#define RENAME_LEAF_BUF_BYTES (256u)

/* Files one scan can give a short life for a listed size that may lag; the rest keep the full lifetime, which costs only freshness. */
#define ENUM_SUSPECT_MAX      (64u)

/* Open-file handle table, shared by every mount: slot handle-1 gives the mount and cnode a one-based RISC OS file handle resolves to. */
static LMHandleSlot_t lm_handle_table[LMCACHE_HANDLE_TABLE_SIZE];

/* Injected time source: monotonic centiseconds on RISC OS, a deterministic counter in a Linux test build.  NULL until Cache_Init;
 * without a clock lifetimes cannot be stamped, so the read path treats every lookup as a miss.
 */
static uint32_t (*lm_clock_fn)(void) = NULL;

/* The clock's last raw reading, and its wraps so far in units of 2^32 centiseconds, from which cache_now builds a time that never wraps. */
static uint32_t lm_clock_last = 0u;
static LMCacheTime_t lm_clock_wraps = 0u;

/*
 * Read the injected clock as a cache timestamp.
 *
 * A raw reading below the previous one means the 32-bit clock has wrapped, so the count of wraps moves on.  That holds as long as the
 * clock is read at least once per wrap (about 497 days), which Cache_KeepTime sees to when the cache is otherwise idle.  Callers must
 * have checked that lm_clock_fn is set.
 *
 * Returns: centiseconds, counted on past every wrap.
 */
static LMCacheTime_t cache_now(void) {
  uint32_t raw = lm_clock_fn();

  if (raw < lm_clock_last) {
    lm_clock_wraps += (LMCacheTime_t)0x100000000u;
  }

  lm_clock_last = raw;

  return lm_clock_wraps + raw;
}

