char RPC_DebugMsg[100];
int RPC_ErrorCount = 0;

/* Debug routine */

typedef enum {
  DE_ENUMSHARESNOLOGON = 0,
  DE_ENUMSHARESCALLTO,
  DE_NOMASTERBROWSER,
  DE_ENUMSERVERSNOLOGON,
  DE_ENUMSERVERSCALLTO,
  DE_LOGONUSERNOCONN,
  DE_NETGETUSERINFO
} debug_errs_t;

/* Log an RPC error with context to RPC_DebugMsg, leaving non-error returns alone.
 *
 * RPC_ErrorCount is bumped per failure so *LMInfo can surface the running total.  The token
 * picks which "D%02d" message to look up; %s in the looked-up text receives the failing name
 * (server / share / user) and the OS error's errmess.
 *
 * Parameters:
 *   res    inbound error code (OK is a passthrough)
 *   token  debug_errs_t identifying which message to format
 *   name   target name for the %s slot
 *
 * Returns: `res` unchanged.
 */
static err_t debug_err(err_t res, debug_errs_t token, char *name) {
  char text[100];

  if (res != OK) {
    sprintf(text, "D%02d", token);
    strcpy(text, MsgLookup(text));
    strcat(text, ": %s"); // Append the error
    RPC_ErrorCount++;
    snprintf(RPC_DebugMsg, sizeof(RPC_DebugMsg), text, name, MsgError(res)->errmess); // The name comes from the user, unbounded
  }
  return res;
}

/* Parameter-assembly subroutines -------------------- */

static struct TransactParms TP;

/* Local convenience macros over the Transact_add* helpers in c.Transact: every callsite in RPC operates on
 * the static `TP` global, so the wrappers exist purely to elide the repeated `&TP` argument.
 */
#define addword(v)   Transact_addword(&TP, (v))
#define addlong(v)   Transact_addlong(&TP, (v))
#define addstring(s) Transact_addstring(&TP, (s))

/* ---------- */

/* Set up the static TransactParms block for a fresh MS-RAP call.
 *
 * The RAP wire format opens with (func_code, in_format, out_format) where the format strings are
 * little type-spec mnemonics ("WrLeh", "B13BWz" etc.) describing the parameter / return layouts.
 * Callers then append per-call arguments via the addword/addlong/addstring macros above.  Reuses
 * SMB_WorkBuf as both parameter-in and parameter-out backing.
 *
 * Parameters:
 *   func_code      RAP function code (NetShareEnum, NetUserGetInfo, ...)
 *   in_format      RAP parameter-format mnemonic
 *   out_format     RAP return-format mnemonic
 *   ret_param_len  expected return parameter length (caps parms_out_maxlen)
 */
static void StartParams(int func_code, char *in_format, char *out_format, int ret_param_len) {
  TP.parms_in = SMB_WorkBuf;
  TP.parms_in_len = 0;
  TP.data_in = NULL;
  TP.data_in_len = 0;

  TP.parms_out_buf = SMB_WorkBuf;
  TP.parms_out_maxlen = min(ret_param_len, SMBWORKBUF_SIZE);
  TP.data_out_buf = SMB_WorkBuf + TP.parms_out_maxlen;
  TP.data_out_maxlen = SMBWORKBUF_SIZE - TP.parms_out_maxlen;

  addword(func_code);
  addstring(in_format);
  addstring(out_format);
}

/* Parameter-return subroutines ====================== */

/* Resolve a 16-bit relative offset inside a returned RAP buffer into a real pointer.
 *
 * RAP returns strings indirectly: the parameter block carries a 16-bit offset into the data-out
 * area.  The offset is relative to the end of the data buffer, hence the +data_out_len adjustment.
 * Bounds-checked - silly offsets (zero, past the end) return NULL rather than dereference.
 *
 * Parameters:
 *   p  pointer to the 16-bit offset inside parms_out_buf
 *
 * Returns: real pointer into TP.data_out_buf, or NULL if the offset is out of range.
 */
static uint8_t *getpointer(uint8_t *p) {
  int ptrval;

  ptrval = Transact_getword(p) + TP.data_out_len - TP.data_out_maxlen;
  if (ptrval <= 0 || ptrval >= TP.data_out_len) {
    return NULL;
  }

  return TP.data_out_buf + ptrval;
}

/* Resolve a share or server record's comment offset into a string within the returned RAP data.
 *
 * Parameters:
 *   commoffset  comment offset from the record, 0 for no comment
 *   co          converter word from the reply parameters, subtracted from the offset
 *
 * Returns: the comment, or NULL if there is none, or it starts or ends outside the returned data.
 */
static char *getcomment(int commoffset, int co) {
  int off;

  if (commoffset == 0) {
    return NULL;
  }

  off = commoffset - co;
  if (off < 0 || off >= TP.data_out_len || memchr(TP.data_out_buf + off, 0, (size_t)(TP.data_out_len - off)) == NULL) {
    return NULL;
  }

  return (char *)TP.data_out_buf + off;
}

/* ============================================ */

/* Report whether a share is visible: true unless its name ends in '$' (the SMB hidden-share marker).
 *
 * Parameters:
 *   name  NUL-terminated share name
 *
 * Returns: false if hidden, true if user-visible.
 */
static bool check_hidden(char *name) {
  while (*name != 0) {
    if (name[0] == '$' && name[1] == 0) {
      return false;
    }
    name++;
  }
  return true;
}

/*---------------------------- */

/* Call NetShareEnum (RAP function 0) on an existing IPC$ connection and feed the results into
 * the OmniClient known-shares list.
 *
 * Records are 20 bytes each: 13-byte share name + flags + comment-offset.  Hidden $-suffixed
 * shares are filtered out unless they're the IPC$ share itself (which is by definition the one
 * we're connected over).  The mystical comment-offset adjustment in the parameter block matches
 * what Samba does and what Windows 98 requires.
 *
 * Parameters:
 *   drv     internal drive letter of an open IPC$ connection
 *   server  server name (for the Omni_AddInfo dispatch)
 *
 * Returns: OK, an SMB error from the underlying SMB_Transact, EDATALEN if the response is
 * truncated or implausibly large, or ERPCERROR for a non-zero RAP return code.
 */
static err_t RPC_EnumSharesOnConnection(char drv, char *server) {
  uint8_t *p;
  int i, co;
  err_t res;

  /* Assemble parameters for RPC call */

  StartParams(0x0000, "WrLeh", "B13BWz", 8); // NetShareEnum
  addword(0x0001);                           // Detail level
  addword(TP.data_out_maxlen);               // Return buf size

  /* Make call */

  res = SMB_Transact(drv, "\\PIPE\\LANMAN", &TP);
  if (res != OK) {
    return res;
  }

  if (TP.parms_out_len < 8) {
    return EDATALEN;
  }

  /* Decode returned params */
  p = TP.parms_out_buf;

  if (Transact_getword(p) != 0) { // API return code; 0 = success
    return ERPCERROR;             // Otherwise, call it 'generic' error
  }

  co = Transact_getword(p + 2); // converter word, subtracted from each comment offset

  i = Transact_getword(p + 4);    // Number of records returned
  if (i * 20 > TP.data_out_len) { // Silly values!
    return EDATALEN;
  }

  /* Process returned records */

  p = TP.data_out_buf;

  while (i-- > 0) {
    /* Each 20-byte record starts with the 13-byte share name and its terminator.  A name ending in '$' is hidden and is
     * not listed unless it is an IPC share.  The comments are kept for *LanMan:ListFS to display; Windows 98 needs the
     * converter word subtracted from their offsets, as Samba does.
     */
    int shrtype = Transact_getword(p + 14);
    char *comment = getcomment(Transact_getword(p + 16), co);

    if (shrtype == SHR_IPC || check_hidden((char *)p)) {
      if (shrtype == SHR_DISK) {
        Omni_AddInfo(OAI_DISK, server, (char *)p, comment);
      } else if (shrtype == SHR_PRINTER) {
        Omni_AddInfo(OAI_PRINTER, server, (char *)p, comment);
      } else if (shrtype == SHR_IPC) {
        Omni_AddInfo(OAI_IPC, server, (char *)p, comment);
      } else if (shrtype == SHR_COMM) {
        Omni_AddInfo(OAI_DEVICE, server, (char *)p, comment);
      }
    }
    p += 20;
  }

  return OK;
}

/*---------------------------- */

/* Call NetServerEnum2 (RAP function 0x68) on a master-browser IPC$ connection and feed servers
 * into the OmniClient known-servers list.
 *
 * 26-byte records.  Returns every server type (the 0xFFFFFFFF mask).  Same comment-offset
 * adjustment as RPC_EnumSharesOnConnection.
 *
 * Parameters:
 *   drv     internal drive letter of an open IPC$ connection
 *   domain  workgroup name (the master browser knows its members)
 *
 * Returns: OK, an SMB error, EDATALEN on truncation, or ERPCERROR on RAP failure.
 */
static err_t RPC_EnumServersOnConnection(char drv, char *domain) {
  err_t res;
  uint8_t *p;
  int co;
  int i;

  /* NetServerEnum2 */
  StartParams(0x0068, "WrLehDz", "B16BBDz", 8);
  addword(0x0001);             // Detail level
  addword(TP.data_out_maxlen); // Return buf size
  addlong((int)0xFFFFFFFF);    // Return all server types
  addstring(domain);           // Domain name

  /* Make call */

  res = SMB_Transact(drv, "\\PIPE\\LANMAN", &TP);
  if (res != OK) {
    return res;
  }

  if (TP.parms_out_len < 8) {
    return EDATALEN;
  }

  /* Decode returned params */
  p = TP.parms_out_buf;

  if (Transact_getword(p) != 0) { // API return code; 0 = success
    return ERPCERROR;
  }

  co = Transact_getword(p + 2);

  i = Transact_getword(p + 4);    // Number of records returned
  if (i * 26 > TP.data_out_len) { // Silly values!
    return EDATALEN;
  }

  /* Process returned records */

  p = TP.data_out_buf;

  while (i-- > 0) {
    /* p is the start of the record.
     *
     * The first 16 bytes are a server name + null termination.
     */
    char *comment = getcomment(Transact_getword(p + 22), co);

    Omni_AddInfo(OAI_SERVER, (char *)p, comment, NULL);
    p += 26;
  }

  return OK;
}

/*---------------------------- */

err_t RPC_EnumerateShares(char *server) {
  char drv;
  err_t res;

  res = SMB_CreateShare(SHR_IPC, CREATE_NORMAL, server, "IPC$", NULL, NULL, &drv, NULL);

  if (res != OK) {
    return debug_err(res, DE_ENUMSHARESNOLOGON, server);
  }

  Omni_AddInfo(OAI_SERVER, server, SMB_GetConnInfo(drv, GCI_SERVERINFO), NULL);

  res = RPC_EnumSharesOnConnection(drv, server);

  SMB_DeleteShare(drv);
  return debug_err(res, DE_ENUMSHARESCALLTO, server);
}

/*---------------------------------------- */

/* Locate the master browser for a workgroup via NetBIOS name service.
 *
 * Sends the special "Master Browser" name-suffix query (ntMBROWSER); the master is the host
 * that serves NetServerEnum2 for the workgroup.  1.5-second timeout is short by NetBIOS standards
 * - we'd rather fail fast and let the caller fall back than block the desktop on a vanished host.
 *
 * Parameters:
 *   wg_name  workgroup name
 *
 * Returns: pointer to a static 16-byte buffer holding the master's name (overwritten on next
 * call), or NULL if no master responded.
 */
static char *GetMasterBrowser(char *wg_name) {
  NETNAME MBname;
  struct FindName_res fnr;
  static char namebuf[16];

  NB_FormatName(ntMBROWSER, wg_name, &MBname);

  if (NB_FindNames(&MBname, ntSERVER, &fnr, 1, 150) == 0) {
    return NULL;
  }

  NB_DecodeName(&(fnr.name), namebuf);
  return namebuf;
}

/*---------------------------------------- */

char *RPC_GetDomainController(char *domain_name) {
  NETNAME DCname;
  struct FindName_res fnr;
  static char namebuf[16];

  NB_FormatName(ntPRIMARYDC, domain_name, &DCname);

  if (NB_FindNames(&DCname, ntSERVER, &fnr, 1, 150) == 0) {
    return NULL;
  }

  NB_DecodeName(&(fnr.name), namebuf);
  return namebuf;
}

/*---------------------------- */

err_t RPC_EnumerateServers(char *workgroup) {
  char drv;
  err_t res;
  char *server;

  /* Find a responder: master browser preferred (workgroup-elected), PDC as fallback. */
  server = GetMasterBrowser(workgroup);

  if (server == NULL) {
    server = RPC_GetDomainController(workgroup);
  }

  if (server == NULL) {
    return debug_err(ECANTFINDNAME, DE_NOMASTERBROWSER, workgroup);
  }

  /* Transient IPC$ binding to the responder so we can issue the NetServerEnum2 RAP call. */
  res = SMB_CreateShare(SHR_IPC, CREATE_NORMAL, server, "IPC$", NULL, NULL, &drv, NULL);

  if (res != OK) {
    return debug_err(res, DE_ENUMSERVERSNOLOGON, server);
  }

  /* Run the actual enumeration over the bound pipe, then drop the IPC$ connection. */
  res = RPC_EnumServersOnConnection(drv, workgroup);

  SMB_DeleteShare(drv);
  return debug_err(res, DE_ENUMSERVERSCALLTO, server);
}

