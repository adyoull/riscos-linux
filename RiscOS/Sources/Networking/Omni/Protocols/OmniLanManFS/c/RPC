err_t RPC_LogonUser(char *server, char *user, char *password, char **pHomeDir) {
  err_t res;
  char drv;

  /* Trying to connect to the IPC share is as good a method of password validation as any */

  res = SMB_CreateShare(SHR_IPC, CREATE_NEW_USER, server, "IPC$", user, password, &drv, NULL);

  if (res != OK) {
    return debug_err(res, DE_LOGONUSERNOCONN, user);
  }

  /* NetUserGetInfo: RAP function 0x0038, parameter descriptor "zWrLh", returning a level-11 user
   * info structure described by "B21B...".  We need at least 6 bytes back for the return-code word.
   */
  StartParams(0x0038, "zWrLh", "B21BzzzWDDzzDDWWzWzDWb21W", 6);

  addstring(user);
  addword(11);                 // Detail level
  addword(TP.data_out_maxlen); // Return buf size

  /* Make call */

  res = SMB_Transact(drv, "\\PIPE\\LANMAN", &TP);

  /* Decode the RAP return word and map to a LanMan error code; on success, pull the home-dir
   * pointer out of the level-11 record (offset 44 = the home_dir field).
   */
  if (res == OK) {
    if (TP.parms_out_len < 6) {
      res = EDATALEN;
    } else {
      switch (Transact_getword(TP.parms_out_buf)) // return code
      {
      case 0:
        *pHomeDir = (char *)getpointer(TP.data_out_buf + 44);
        res = OK;
        break;
      case 5:
      case 65: // Access denied
        res = ENOACCESS;
        break;
      case 2221: // User not found
        res = EUSERUNKNOWN;
        break;
      case 2239: // Account disabled
        res = EACCDISABLED;
        break;
      default:
        res = ERPCERROR;
        break;
      }
    }
  }

  SMB_DeleteShare(drv);

  return debug_err(res, DE_NETGETUSERINFO, user);
}

