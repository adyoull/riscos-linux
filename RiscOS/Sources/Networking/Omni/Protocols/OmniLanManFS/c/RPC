err_t RPC_NameOp(int reason, char *name_in, char *buf_out) {
  char *s;

  /* Local-state reasons short-circuit to LM_Vars; lookup reasons fall through to NetBIOS NS
   * queries.  In both lookup cases a NULL name_in defaults to the current workgroup so callers
   * can use a single SWI without explicitly threading the workgroup name through.
   */
  switch (reason) {
  case NAMEOP_GETLOCAL:
    s = LM_Vars.machinename;
    break;

  case NAMEOP_GETWG:
    s = LM_Vars.workgroup;
    break;

  case NAMEOP_GETBROWSER:
    if (name_in == NULL) {
      name_in = LM_Vars.workgroup;
    }

    s = GetMasterBrowser(name_in);
    if (s == NULL) {
      return ECANTFINDNAME;
    }
    break;

  case NAMEOP_GETDC:
    if (name_in == NULL) {
      name_in = LM_Vars.workgroup;
    }

    s = RPC_GetDomainController(name_in);
    if (s == NULL) {
      return ECANTFINDNAME;
    }
    break;

  default:
    return EBADPARAM;
  }

  /* Every source is a 16-byte buffer, so the caller's 16 bytes hold any name with its terminator. */
  strcpy(buf_out, s);
  return OK;
}

/*------------------------- */

err_t RPC_Transact(char *servername, char *pipename, void *pvParmBlk) {
  struct TransactParms *caller = pvParmBlk;
  char drv;
  err_t res;
  struct TransactParms t;

  /* Connect to IPC share using default user ID/password */

  res = SMB_CreateShare(SHR_IPC, CREATE_NORMAL, servername, "IPC$", NULL, NULL, &drv, NULL);

  if (res != OK) {
    return res;
  }

  /* Copy only the external portion of the caller's block; the internal layout extends it with
   * setup fields that are forced to zero here, because external callers do not know about them.
   */
  memcpy(&t, pvParmBlk, sizeof_TransactParms_external);
  t.setup_in_len = 0;
  t.setup_out_maxlen = 0;
  res = SMB_Transact(drv, pipename, &t);
  SMB_DeleteShare(drv);

  /* The SWI returns the lengths of the reply in the caller's block, so copy them back from the local copy. */
  caller->parms_out_len = t.parms_out_len;
  caller->data_out_len = t.data_out_len;
  return res;
}

/*------------------------- */

bool RPC_Init(void) {
  RPC_ErrorCount = 0;
  RPC_DebugMsg[0] = 0;
  return true;
}
