void Lgn_Register(void) {
  char titlebar[24];    // Title bar - 24 max
  char infobox[3 * 32]; // Info box - 3x32 max

  /* Build the info-box text first while titlebar still holds the version string. */
  strcpy(titlebar, MsgLookup("_Version")); // Temp copy
  sprintf(infobox,
          "%s\n"
          "\xA9 Acorn Computers Ltd, 1997\n"
          "%s",
          MsgLookup("WhoLogon"), titlebar);
  strncpy(titlebar, MsgLookup("DispName"), sizeof(titlebar));

  /* Hand the assembled UI strings to OmniClient; the trailing "+" makes the client ID distinct
   * from the main LanManFS one.
   */
  _swix(SWI_Omni_RegisterClient, _INR(0, 6), LanMan_LogonOp,                             // Client ID
        RC_LOGON_TYPE | RC_NEEDS_AUTHSERV | RC_NEEDS_USERID | RC_NEEDS_PASSWD, "lmlgni", // Sprite name - 12 max
        titlebar,                                                                        // Title bar - 24 max
        infobox,                                                                         // Info box - 3x32 max
        0,                                                                               // Site ID (ignored)
        FilingSystemName "+");                                                           // Only needs to be unique from LanManFS name
}

/* ---------------------------------------- */

/* OmniClient Op-3 back-end: enumerate the single "logon" server we surface.
 *
 * The logon client always advertises exactly one pseudo-server entry (this module's display name).
 * On the first call (token_in == 0) the record is written and pToken_out set to 0; subsequent
 * calls return "no more records".
 *
 * Parameters:
 *   buf_ptr        destination buffer
 *   buf_size       buffer capacity in bytes
 *   token_in       continuation token; 0 starts a fresh enumeration
 *   pNextByte_out  on return, points just past the last written byte
 *   pToken_out     on return, 0 means "list complete"
 *
 * Returns: OK always (overflow becomes "no records written").
 */
static err_t Lgn_ListServers(char *buf_ptr, int buf_size, int token_in, char **pNextByte_out, int *pToken_out) {
  int serverid = (int)"?"; // A unique memory address
  int tot_size;
  size_t name_size;

  /* Size up the single record: 4-byte ID + short name + long name + extra-details string, padded
   * to a dword boundary so the OmniClient consumer sees an aligned next-record offset.  Each lookup is
   * measured before the next, because MsgLookup returns the same buffer every time.
   */
  name_size = strlen(MsgLookup("DispName"));
  tot_size = sizeof(serverid) + (2 * (name_size + 1)) + strlen(MsgLookup("XtrLogon")) + 2 + 2 + 1;

  tot_size = (tot_size + 3) & ~3; // Round to dword boundary

  /* Continuation past the only record, or buffer too small to hold it - signal "list complete". */
  if (token_in != 0 || tot_size > buf_size) {
    *pNextByte_out = buf_ptr; /* No records written */
    *pToken_out = 0;          /* All done */
    return OK;
  }

  /* Advance the caller's cursor past the record we're about to write; token=0 signals end-of-list. */
  *pNextByte_out = buf_ptr + tot_size;
  *pToken_out = 0;

  /* Write the record: server-id, short name, long name, extra-details string. */
  memcpy(buf_ptr, &serverid, sizeof(serverid));
  buf_ptr += sizeof(serverid);

  const char *name = MsgLookup("DispName");
  int name_len = (int)strlen(name);
  strcpy(buf_ptr, name); // Short name
  buf_ptr += name_len + 1;
  strcpy(buf_ptr, name); // Long name (the same!)
  buf_ptr += name_len + 1;

  sprintf(buf_ptr, "%s\n \n ", MsgLookup("XtrLogon")); // Extra details

  return OK;
}

/* ---------------------------------------- */

_kernel_oserror *Lgn_LogonOp_SWI(_kernel_swi_regs *R) {
  err_t res;

  debug(" Logon Op(%d)\n", R->r[0]);

  /* Dispatch on the OmniClient reason code in R0; each case maps to a Lgn_* helper or a fixed
   * reply.  For Mount, EHOMEDIRCONN and EHOMEDIRNAME mean the credentials were stored but the home
   * directory did not mount, so R1 still carries a non-zero mount ID, though the error is returned too.
   */
  switch (R->r[0]) {
  case 0:                               // Mount
    res = Lgn_Logon((char *)(R->r[1]),  // "Server" => domain/workgroup
                    (char *)(R->r[2]),  // User ID
                    (char *)(R->r[3])); // Password
    if (res == OK || res == EHOMEDIRCONN || res == EHOMEDIRNAME) {
      R->r[1] = 1; // Keep the Smith happy
    } else {
      R->r[1] = 0; // return mount_id 0 on error
    }
    break;

  case 3: // Enumerate servers
    res = Lgn_ListServers((char *)(R->r[1]), R->r[2], R->r[3], (char **)&(R->r[1]), &(R->r[3]));
    break;

  case 9: // Get mount info - (mild bodge - say it's not there!)
    R->r[3] = 0;
    res = OK;
    break;

  case 17:              // Log out of domain
    res = Lgn_Logoff(); // Clear all user ID's & passwords
    break;

  default:
    res = ENOTPRESENT;
  }

  return MsgError(res);
}
