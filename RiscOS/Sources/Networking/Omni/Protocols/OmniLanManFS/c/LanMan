/* Locations in CMOS containing file server name.
 *
 * FSERVER_LEN is assumed to be less than NAME_LIMIT.  If it is not, set FSERVER_LEN to NAME_LIMIT-1, and the name will be
 * truncated.
 */
#define CMOS_FSSTAT   1
#define CMOS_FSERVER1 2
#define CMOS_FSERVER  158
#define FSERVER_LEN   (172 - 159 + 1)

/* Argument-parsing buffer for the *command handlers.  GetArgs tokenises the command tail into up
 * to MAX_ARGS pointers (*LMServer and *LMPrinters take a list of names and use that many at most,
 * ignoring the rest) and copies the tokens into Cmdbuf, which is sized to hold any plausible command line.
 */
#define MAX_ARGS   20
#define MAX_CMDLEN 256

static char Cmdbuf[MAX_CMDLEN];

