/* *LMNameMode - inspect or set the case of short names, whether hidden files are listed, and how SMB2 names show $ & @ ^. */
static _kernel_oserror *Cmd_LMNameMode(const char *args) {
  int i, mode, hidden, chars, listed, flags = 0;
  /* OS_ReadArgs output block: a word per switch, then the type byte and value of the evaluated mode number.
   * `spare` pads the packed block to a whole number of words.  cppcheck flags them individually as unused.
   */
  __packed struct {
    /* cppcheck-suppress unusedStructMember */
    int flags[8];
    /* cppcheck-suppress unusedStructMember */
    char type;
    /* cppcheck-suppress unusedStructMember */
    int mode;
    /* cppcheck-suppress unusedStructMember */
    char spare[3];
  } parsed;
  _kernel_oserror *e = NULL;

  FSEnter();

  e = _swix(OS_ReadArgs, _INR(0, 3),
            "/e,preservecase/s,lowercase/s,firstcaps/s,includehidden/s,excludehidden/s,"
            "smb2legacychars/s,smb2escapedchars/s",
            args, &parsed, sizeof(parsed));
  if (e != NULL) {
    /* Convert buffer overflow to bad parameters */
    e = e->errnum == ErrorNumber_BuffOverflow ? MsgError(EBADPARAM) : e;
    goto exit;
  }

  for (i = 0; i < (sizeof(parsed.flags) / sizeof(parsed.flags[0])); i++) {
    if (parsed.flags[i]) {
      flags |= (1 << i);
    }
  }

  if (flags == 0) {
    const char *token;

    /* No arguments given, show the current state */
    switch (LM_Vars.namemode & NM_MODE) {
    default: // Preserve case
      token = "NMMode0";
      break;
    case NM_LOWERCASE:
      token = "NMMode1";
      break;
    case NM_FIRSTCAPS:
      token = "NMMode2";
      break;
    }
    printf("%s: ", MsgLookup("NMMode"));
    printf("%s\n", MsgLookup(token));

    printf("%s: ", MsgLookup("NMHid"));
    printf("%s\n", MsgLookup((LM_Vars.namemode & NM_HIDDEN) ? "Inc" : "Exc"));

    printf("%s: ", MsgLookup("NMChr"));
    printf("%s\n", MsgLookup((LM_Vars.namemode & NM_LEGACYCHARS) ? "NMChr1" : "NMChr0"));

    goto exit;
  }

  mode = hidden = chars = -1;
  switch (flags & 0xf) {
  case 1: // Numeric mode
    if (parsed.type != 0 /* Integer */ || parsed.mode > 2 || parsed.mode < 0) {
      e = MsgError(EBADPARAM);
      goto exit;
    }
    mode = parsed.mode;
    break;
  case 2: // PreserveCase
  case 4: // Lowercase
  case 8: // FirstCaps
    mode = (flags >> 2) & NM_MODE;
    break;
  }

  switch (flags & 0x30) {
  case 0x10: // IncludeHidden
    hidden = NM_HIDDEN;
    break;
  case 0x20: // ExcludeHidden
    hidden = 0;
    break;
  case 0x30:
    e = MsgError(EBADPARAM);
    goto exit;
  }

  switch (flags & 0xc0) {
  case 0x40: // SMB2LegacyChars
    chars = NM_LEGACYCHARS;
    break;
  case 0x80: // SMB2EscapedChars
    chars = 0;
    break;
  case 0xc0:
    e = MsgError(EBADPARAM);
    goto exit;
  }

  if (mode == -1 && hidden == -1 && chars == -1) {
    e = MsgError(EBADPARAM);
    goto exit;
  }

  if (mode != -1) {
    LM_Vars.namemode &= ~NM_MODE;
    LM_Vars.namemode |= mode;
  }

  listed = LM_Vars.namemode;

  if (hidden != -1) {
    listed = (listed & ~NM_HIDDEN) | hidden;
  }

  if (chars != -1) {
    listed = (listed & ~NM_LEGACYCHARS) | chars;
  }

  /* Cached details, a remembered path and directory snapshots hold names as a listing gave them, so they must go when what it gives
   * changes.
   */
  if (listed != LM_Vars.namemode) {
    char drv;

    LM_Vars.namemode = listed;

    for (drv = 'A'; drv <= 'Z'; drv++) {
      Cache_Flush(SMB_GetCacheFromDrv(drv));
    }

    Xlt_ForgetTranslation();
    CoreFn_ForgetSnapshots();
  }

exit:
  FSExit();
  return e;
}

/* *LMCache [On | Off] - show, or set for mounts made from now on, whether a mount keeps a cache.
 *
 * A mount already made keeps what it has: its open files and any captured content are bound to its cache, so taking the cache away
 * would need the same care as a dismount.
 */
static _kernel_oserror *Cmd_LMCache(const char *args) {
  char *argv[MAX_ARGS];
  _kernel_oserror *e = NULL;

  FSEnter();

  if (GetArgs(args, argv, MAX_ARGS) < 1) {
    /* MsgLookup returns its text in one buffer, so each lookup is printed before the next. */
    printf("%s: ", MsgLookup("CchMode"));
#ifdef LM_CACHE
    printf("%s\n", MsgLookup(LM_Vars.cache_off ? "CchOff" : "CchOn"));
#else
    printf("%s\n", MsgLookup("CchNone"));
#endif
  } else if (stricmp(argv[0], "On") == 0) {
    LM_Vars.cache_off = false;
  } else if (stricmp(argv[0], "Off") == 0) {
    LM_Vars.cache_off = true;
  } else {
    e = MsgError(EBADPARAM);
  }

  FSExit();
  return e;
}

