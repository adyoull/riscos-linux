const char *MsgLookup(const char *token) {
  if (_swix(MessageTrans_Lookup, _INR(0, 7), msg_struct, token, &msg_buff, sizeof(msg_buff), 0, 0, 0, 0) != NULL) {
    return "";
  }
  return (const char *)&msg_buff;
}

err_t MsgSetOSError(_kernel_oserror *err) {
  msg_oserr = err;
  if (err == NULL) {
    return OK;
  }

  return EUSELASTSETOSERR;
}

_kernel_oserror *MsgError(int which) {
  struct {
    int errnum;
    char errmess[8];
  } token;

  if (which == OK) {
    return NULL;
  }

  if (which == EUSELASTSETOSERR) {
    /* Surface the most recent OS error captured by MsgSetOSError. */
    if (msg_oserr != NULL) {
      return msg_oserr;
    }
    which = EHOWDTHATHAPPEN;
  }

  sprintf(token.errmess, "E%02d", which);
  if ((which == EDIRNOTEMPTY) || (which == ENOACCESS)) {
    /* Filer_Action insists on the FileCore-style specific error number for "directory not empty". */
    which = ErrorNumber_DirNotEmpty;
  }
  token.errnum = Our_Error_Base + which;
  return _swix(MessageTrans_ErrorLookup, _INR(0, 3), &token, msg_struct, &msg_buff, sizeof(msg_buff));
}

int RdCMOS(int addr) {
  return (_kernel_osbyte(161, addr, 0) & 0xFF00) >> 8;
}

/* Write a single byte to non-volatile CMOS storage. */
static void WrCMOS(int addr, unsigned int data) {
  _kernel_osbyte(162, addr, data);
}

/* Save the file-server name to CMOS so it survives a reboot.
 *
 * The first byte is stored as given.  Each later byte that is not printable (<= 0x20 or > 0x7F) is
 * stored as NUL, which also ends the stored name early.  An empty name clears the entry.
 *
 * Parameters:
 *   buf_in  NUL-terminated server name to store
 */
static void SetFSName(const char *buf_in) {
  int i, t;

  WrCMOS(CMOS_FSSTAT, 0);
  WrCMOS(CMOS_FSERVER1, buf_in[0]);
  if (buf_in[0] == 0) {
    return;
  }

  for (i = 1; i < FSERVER_LEN; i++) {
    t = buf_in[i];
    if (t <= 0x20 || t > 0x7F) {
      t = 0;
    }
    WrCMOS(CMOS_FSERVER + i - 1, t);
    if (t == 0) {
      break;
    }
  }
}

/* Read the configured file-server / workgroup name into `buf_out`.
 *
 * `buf_out` MUST be at least FSERVER_LEN + 1 bytes long; the size argument to
 * _kernel_getenv must match, otherwise an oversized Inet$ServerName would
 * overrun the caller's stack and the later strcpy into LM_Vars.workgroup
 * would overrun too.
 *
 * Parameters:
 *   buf_out  buffer of at least FSERVER_LEN + 1 bytes
 */
static void GetFSName(char *buf_out) {
  int i;

  /* Prefer the live env var; _kernel_getenv returns 0 on success and leaves buf_out populated. */
  if (!_kernel_getenv("Inet$ServerName", buf_out, FSERVER_LEN + 1)) {
    return;
  }

  /* No env var: fall back to the CMOS-resident name (split across CMOS_FSERVER1 and CMOS_FSERVER+). */
  if (RdCMOS(CMOS_FSSTAT) == 0) {
    *buf_out++ = RdCMOS(CMOS_FSERVER1);
    for (i = 1; i < FSERVER_LEN; i++) {
      *buf_out++ = RdCMOS(CMOS_FSERVER + i - 1);
    }
  }

  *buf_out = 0;
}

/* Finalisation code ------------------------------------ */

/* Remove ourselves from FileSwitch's filing-system table. */
static void LM_Undeclare(void) {
  if (LM_Declared) {
    (void)_swix(OS_FSControl, _INR(0, 1), FSControl_RemoveFS, FilingSystemName);
    LM_Declared = false;
  }
}

/* Tear down all active state in dependency order.
 *
 * NBIP_ReleaseEventHandler must run before any socket close: socketclose
 * triggers Internet events that fire into our EventFn while it is still
 * claimed, queueing OS_AddCallBack entries that then dispatch to a freed
 * veneer.  NB_Shutdown releases the EventV handler itself but runs late,
 * after SMB_Shutdown has already closed the SMB2 sockets: so the release
 * is needed up front too.  NBIP_ReleaseEventHandler is idempotent via the
 * EventsClaimed flag, so the repeat call from NB_Shutdown is a safe no-op.
 */
static void LM_GracefulClosedown(void) {
  NBIP_ReleaseEventHandler();

  stopcallbacks();
  SMB_Shutdown();  // Dismounts all SMB mounts
  Omni_Shutdown(); // Zeros the Mounts lists
  Prn_Shutdown();  // Free print jobs
  NB_Shutdown();   // Closes the transport's sockets
  Buf_Shutdown();  // Tell MBufManager we're done
  LM_Vars.initialised = LMInitState_PreInit;
}

/* Finalise the module: tear everything down, undeclare the filing system, release the workspace and close the message and
 * resource files.
 */
_kernel_oserror *LM_Finalise(int fatal, int podule, void *pw) {
  debug("Finalise\n");
  UNUSED(fatal);
  UNUSED(podule);
  UNUSED(pw);

  LM_GracefulClosedown();
  /* Now mark this filing system as gone */
  LM_Undeclare();

  /* No FSEntry call can reach the directory snapshots now, so their memory can go. */
  CoreFn_ForgetSnapshots();

  /* No more FSEntry dispatch can reach us after LM_Undeclare returns; safe to release the workspace DA. */
  Workspace_Shutdown();

  /* Per-mount cache substrates were freed by Cache_MountDestroy via the SMB_DeleteShare cascade in the
   * closedown above.  Cache_Shutdown clears the global handle table and the module-static state.
   */
  Cache_Shutdown();

  _swix(MessageTrans_CloseFile, _IN(0), msg_struct);
  _swix(ResourceFS_DeregisterFiles, _IN(0), Resources());

  return NULL;
}

/* LM_declare ------------------------------------------ */

/* Register the filing system with FileSwitch.
 *
 * Builds the FSControl_AddFS information block referencing our FSEntry
 * veneers and the Information / Information2 capability words, and
 * latches LM_Declared so LM_Undeclare removes the filing system at finalise.
 *
 * Returns: NULL on success, or the OS error from FSControl_AddFS.
 */
static _kernel_oserror *LM_Declare(void) {
  _kernel_oserror *err;
  unsigned int InfoBlk[12];

  LM_Declared = false;

  /* Build the FSControl_AddFS info block.  Slots are PRM-defined: name, fsentry veneers, capability words.
   * Addresses are stored as image-relative offsets so FileSwitch can relocate them on RMA load.
   */
  InfoBlk[0] = (unsigned int)((unsigned long)FilingSystemName - Image_RO_Base);
  InfoBlk[1] = -1; // Self-ident - request call FSFunc_PrintStartupBanner
  InfoBlk[2] = (unsigned int)((unsigned long)fsentry_open - Image_RO_Base);
  InfoBlk[3] = (unsigned int)((unsigned long)fsentry_getbytes - Image_RO_Base);
  InfoBlk[4] = (unsigned int)((unsigned long)fsentry_putbytes - Image_RO_Base);
  InfoBlk[5] = (unsigned int)((unsigned long)fsentry_args - Image_RO_Base);
  InfoBlk[6] = (unsigned int)((unsigned long)fsentry_close - Image_RO_Base);
  InfoBlk[7] = (unsigned int)((unsigned long)fsentry_file - Image_RO_Base);
  InfoBlk[8] = Information_Word;
  InfoBlk[9] = (unsigned int)((unsigned long)fsentry_func - Image_RO_Base);
  InfoBlk[10] = (unsigned int)((unsigned long)fsentry_gbpb - Image_RO_Base);
  InfoBlk[11] = Information2_Word;

  /* Hand off to FileSwitch; latch LM_Declared so the finalise path calls RemoveFS. */
  err = _swix(OS_FSControl, _INR(0, 3), FSControl_AddFS, Image_RO_Base, (unsigned long)InfoBlk - Image_RO_Base, LM_pw);
  if (err == NULL) {
    LM_Declared = true;
  }

  return err;
}

/* *Command processor ------------------------------------ */

/* Split a space-separated argument string into tokens.
 *
 * Each token is copied into the module-static Cmdbuf so the pointers
 * returned in `argv_out` remain valid until the next GetArgs call.  Unused
 * `argv_out` slots are set to NULL.  Stops on any control character (RISC
 * OS terminator) or when `maxargs` tokens have been produced.
 *
 * Parameters:
 *   args      input string, terminated by a control character
 *   argv_out  array of `maxargs` pointers receiving the token starts
 *   maxargs   maximum number of tokens to extract
 *
 * Returns: the number of tokens actually extracted.
 */
static int GetArgs(const char *args, char *argv_out[], int maxargs) {
  int i, argc;

  /* NULL-fill the output slots so callers can test argv[N] for "not supplied". */
  for (i = 0; i < maxargs; i++) {
    argv_out[i] = NULL;
  }

  i = 0; // Index into Cmdbuf
  argc = 0;

  /* Each iteration extracts one token: skip leading spaces, capture the slot, copy until the next space or terminator. */
  do {
    while (*args == ' ') {
      args++;
    }

    if (*args < ' ') {
      break;
    }

    if (argc >= maxargs) {
      break;
    }

    argv_out[argc++] = Cmdbuf + i;

    while (i < MAX_CMDLEN - 1 && *args > ' ') {
      Cmdbuf[i++] = *args++;
    }

    Cmdbuf[i++] = 0;
  } while (i < MAX_CMDLEN - 1);

  return argc;
}

/* *LanMan - select LanManFS as the current filing system. */
static _kernel_oserror *Cmd_LanMan(const char *args) {
  _kernel_oserror *ret;

  FSEnter();
  UNUSED(args);

  ret = _swix(OS_FSControl, _INR(0, 1), FSControl_SelectFS, FilingSystemName);
  FSExit();
  return ret;
}

/* *Free [mount] - print the free-space report for a mount, by default the current directory's or else the only one. */
static _kernel_oserror *Cmd_Free(const char *args) {
  _kernel_swi_regs r;
  _kernel_oserror *e = NULL;
  int values[6];
  char *argv[1];

  FSEnter();

  /* No mount given: fall back to the current directory's mount, or to the sole mount if there is exactly one. */
  if (GetArgs(args, argv, sizeof(argv) / sizeof(*argv)) == 0) {
    argv[0] = getenv("FileSwitch$" FilingSystemName "$CSD");

    if (argv[0] == NULL) {
      argv[0] = (char *)Omni_GetSoleMountName();
    }
  }

  if (argv[0] == NULL) {
    e = MsgError(EBADDRV);
    goto exit;
  }

  r.r[0] = 4; // 64-bit free space
  r.r[1] = Our_FS_Number;
  r.r[2] = (int)values;
  r.r[3] = (int)argv[0];
  e = Omni_FreeOp_SWI(&r);

  /* Format the result: single-precision when both high halves are zero, double-precision otherwise.
   * values[4] == -1 means the server didn't report a "used" figure, so substitute the unknown-amount message.
   */
  if (e == NULL) {
    if (values[3] == 0 && values[5] == 0) {
      printf("%s &%08X\n", MsgLookup("Free"), values[2]);
      if (values[4] != -1) {
        printf("%s &%08X\n", MsgLookup("Used"), values[4]);
      } else {
        printf("%s\n", MsgLookup("UsedUK"));
      }
    } else {
      printf("%s &%08X%08X\n", MsgLookup("Free"), values[3], values[2]);
      if (values[4] != -1) {
        printf("%s &%08X%08X\n", MsgLookup("Used"), values[5], values[4]);
      } else {
        printf("%s\n", MsgLookup("UsedUK"));
      }
    }
  }

exit:
  FSExit();
  return e;
}

/* *ListFS [server] - dump the known servers, or the shares on one server. */
static _kernel_oserror *Cmd_ListFS(const char *args) {
  _kernel_oserror *ret;
  char *argv[1];

  FSEnter();

  if (GetArgs(args, argv, sizeof(argv) / sizeof(*argv)) == 0) {
    ret = Omni_DumpServers();
  } else {
    ret = Omni_DumpShares(argv[0]);
  }
  FSExit();
  return ret;
}

/* *LMConnect <mount> <server> <share> [<user>|- [<password>]] - mount a share.
 *
 * A literal "-" as the user name maps to NULL so the default credential
 * is used.  Refreshes Omni's mounts list once the mount has been attempted.
 */
static _kernel_oserror *Cmd_LMConnect(const char *args) {
  _kernel_oserror *ret;
  char *argv[5];
  err_t res;
  int tmp;

  FSEnter();

  if (GetArgs(args, argv, 5) < 3) {
    ret = MsgError(EBADPARAM);
    goto exit;
  }

  if (argv[3] != NULL && argv[3][0] == '-' && argv[3][1] == 0) {
    argv[3] = NULL;
  }

  res = Omni_MountServer(argv[1], // Server
                         argv[3], // User name or NULL
                         argv[4], // Password or NULL
                         argv[0], // Mountname
                         argv[2], // Drive name
                         &tmp);   // MountID_out

  Omni_RecheckInfo(RI_MOUNTS);
  ret = MsgError(res);

exit:
  FSExit();
  if (ret == NULL) {
    ret = MsgError(Omni_RunDeferredBoots()); // The new mount's boot file
  }
  return ret;
}

/* *LMDisconnect <mount> - dismount a share by mount name. */
static _kernel_oserror *Cmd_LMDisconnect(const char *args) {
  _kernel_oserror *ret;
  char *argv[1];
  int mountID;
  err_t res;

  FSEnter();

  if (GetArgs(args, argv, 1) < 1) {
    ret = MsgError(EBADPARAM);
    goto exit;
  }

  mountID = Omni_GetMountID(argv[0]);
  if (mountID == 0) {
    ret = MsgError(EBADDRV);
    goto exit;
  }

  res = Omni_DismountServer(mountID);
  Omni_RecheckInfo(RI_MOUNTS);
  ret = MsgError(res);

exit:
  FSExit();
  return ret;
}

/* Record and immediately invoke the chosen transport initialiser. */
static void LanMan_InitTransport(pfnTransportInit i) {
  NB_InitedTransport = i;
  (*i)();
}

/* Populate LM_Vars from environment variables and CMOS defaults.
 *
 * Selects the IP transport unconditionally.  Truncates Inet$HostName at
 * the first dot to recover a NetBIOS-style machine name from a fully-
 * qualified domain name.  The "ARM_NoName" sentinel (set by the STB OS)
 * is treated as an unset host name.
 */
static void SetDefaultVars(void) {
  char *name;
  char fs_name[FSERVER_LEN + 1];

  LM_Vars.initialised = LMInitState_Uninitialised;
  LM_Vars.namemode = NM_FIRSTCAPS;
  LM_Vars.cache_off = false;

  name = getenv("Inet$EtherType");
  strcpyn(LM_Vars.drivername, (name == NULL) ? DEFAULT_ETHER_TYPE : name, NAME_LIMIT);

  /* Derive a NetBIOS-style machine name: uppercase, then chop at the first dot so an FQDN works too. */
  name = getenv("Inet$HostName");
  if ((name == NULL) || (stricmp(name, "ARM_NoName") == 0)) {
    strcpy(LM_Vars.machinename, "");
  } else {
    strcpyn_upper(LM_Vars.machinename, name, NAME_LIMIT);
    name = strchr(LM_Vars.machinename, '.');
    if (name != NULL) {
      *name = 0;
    }
  }

  /* Optional override: LanMan$DefaultType lets the user pick the filetype assigned to wire entries
   * we can't otherwise classify.  FSControl 31 turns a name like "Text" into the numeric type ID.
   */
  name = getenv("LanMan$DefaultType");
  if (name != NULL) {
    _swix(OS_FSControl, _INR(0, 1) | _OUT(2), 31, name, &LM_Vars.default_type);
  } else {
    LM_Vars.default_type = CNV_DEFAULT_TYPE;
  }

  /* Base of the OS ROM, used as load/exec for untyped files so accidental execution traps. */
  _swix(OS_Module, _INR(0, 2) | _OUT(3), 12, 0, 0, &LM_Vars.untyped_address);
  LM_Vars.untyped_address = LM_Vars.untyped_address & ~((1 << 20) - 1);

  Lgn_Init();
  GetFSName(fs_name);
  if (fs_name[0] != '\0') {
    strcpy(LM_Vars.workgroup, fs_name);
  }

  LanMan_InitTransport(NB_NBIP_Setup);
}

/* *LMLogoff - drop the default credential. */
static _kernel_oserror *Cmd_LMLogoff(const char *args) {
