/* *LMLogon <workgroup> <user> [<password>] - set the default credential.
 *
 * The password is optional; passing NULL through to Lgn_Logon selects a
 * blank password.
 */
static _kernel_oserror *Cmd_LMLogon(const char *args) {
  _kernel_oserror *ret;
  char *argv[3];

  FSEnter();
  if (GetArgs(args, argv, 3) < 2) {
    ret = MsgError(EBADPARAM);
    goto exit;
  }

  ret = MsgError(Lgn_Logon(argv[0], argv[1], argv[2]));

exit:
  FSExit();
  if (ret == NULL) {
    ret = MsgError(Omni_RunDeferredBoots()); // The home directory's boot file
  }
  return ret;
}

