/* *Configure FS: get / set the boot file-server name in CMOS.
 *
 * RISC OS passes args = 0 to request the "Configure" syntax line and
 * args = 1 to request the "Status" line; anything else is treated as a
 * user-supplied command tail.
 */
static _kernel_oserror *Cmd_FS(const char *args) {
  _kernel_oserror *ret = NULL;
  char *argv[1];

  FSEnter();

  if ((int)args == 0) {
    printf("FS           %s\n", MsgLookup("ConfFS"));
    goto exit;
  } else if ((int)args == 1) {
    char buf[NAME_LIMIT];
    GetFSName(buf);
    printf("FS           %s\n", buf[0] ? buf : MsgLookup("NoHome"));
    goto exit;
  }

  if (GetArgs(args, argv, 1) < 1) {
    ret = MsgError(EBADPARAM);
    goto exit;
  }

  SetFSName(argv[0]);

exit:
  FSExit();
  return ret;
}

/* *Configure LMNameServer xx.xx.xx.xx: get / set the NetBIOS name-server address.
 *
 * Rejects loopback (127.x.x.x), multicast / reserved (>223.x.x.x), and
 * broadcast (x.x.x.255) addresses both when reading the stored value back
 * and when accepting a new value.
 */
static _kernel_oserror *Cmd_LMNameServer(const char *args) {
  _kernel_oserror *ret = MsgError(EBADPARAM);
  char *argv[1];
  struct in_addr address;
  int result;

  FSEnter();

  /* *Configure with no args: echo the syntax line and finish. */
  if (args == arg_CONFIGURE_SYNTAX) {
    printf("LMNameServer xx.xx.xx.xx\n");
    ret = NULL;
    goto exit;
  } else if (args == arg_STATUS) {
    /* Status query: read the stored quad from CMOS, validate it, and print either the address or NoHome. */
    int b0, b1, b2, b3;

    b0 = RdCMOS(NBNSIPCMOS0);
    b1 = RdCMOS(NBNSIPCMOS1);
    b2 = RdCMOS(NBNSIPCMOS2);
    b3 = RdCMOS(NBNSIPCMOS3);

    if (((b0 != 0) && (b0 != 127) && (b0 <= 223)) && ((b3 != 0) && (b3 != 255))) {
      printf("LMNameServer %d.%d.%d.%d\n", b0, b1, b2, b3);
    } else {
      printf("LMNameServer %s\n", MsgLookup("NoHome"));
    }
    ret = NULL;
    goto exit;
  } else if (GetArgs(args, argv, 1) == 1) {
    /* Set request: parse the dotted quad and validate before committing to CMOS. */
    result = inet_aton(argv[0], &address);
    if (result) {
      unsigned char b0, b1, b2, b3;

      /* network-byte-order address picked apart for the per-byte CMOS slots. */
      b0 = (unsigned char)(address.s_addr >> 0);
      b1 = (unsigned char)(address.s_addr >> 8);
      b2 = (unsigned char)(address.s_addr >> 16);
      b3 = (unsigned char)(address.s_addr >> 24);

      /* Reject loopback (127.x), multicast / reserved (>223.x), and broadcast (x.x.x.255). */
      if (((b0 != 127) && (b0 <= 223)) && ((b3 != 255))) {
        WrCMOS(NBNSIPCMOS0, (int)b0);
        WrCMOS(NBNSIPCMOS1, (int)b1);
        WrCMOS(NBNSIPCMOS2, (int)b2);
        WrCMOS(NBNSIPCMOS3, (int)b3);
        ret = NULL;
        goto exit;
      }
    }
  }

exit:
  FSExit();
  return ret;
}

typedef _kernel_oserror *(*CommandFnPtr)(const char *args);

#define CmdEntry(X) [CMD_##X] = Cmd_##X
static CommandFnPtr Cmd_Dispatch[] = {CmdEntry(LanMan),     CmdEntry(LMConnect),  CmdEntry(LMDisconnect), CmdEntry(LMLogon),
                                      CmdEntry(LMInfo),     CmdEntry(LMNameMode), CmdEntry(LMLogoff),     CmdEntry(LMServer),
                                      CmdEntry(LMPrinters), CmdEntry(FS),         CmdEntry(LMNameServer), CmdEntry(Free),
                                      CmdEntry(ListFS),     CmdEntry(LMCache)};

#define MAX_CMDS (sizeof Cmd_Dispatch / sizeof Cmd_Dispatch[0])

/* Star-command dispatch entry, called from the cmhg veneer.
 *
 * Parameters:
 *   args    command tail
 *   argc    argument count (unused; we tokenise ourselves)
 *   cmd_no  command index into Cmd_Dispatch
 *   pw      private word (unused)
 *
 * Returns: NULL on success, an error block for parameter / dispatch failures.
 */
_kernel_oserror *LM_Command(const char *args, int argc, int cmd_no, void *pw) {
  UNUSED(pw);
  UNUSED(argc);

  if (cmd_no < 0 || cmd_no >= MAX_CMDS) {
    return MsgError(ENOTPRESENT);
  }

  return Cmd_Dispatch[cmd_no](args);
}

/* Service call handler --------------------------------- */

typedef void (*resfs_reregister_fn)(void *, void *, void *, void *);

/* Module service-call entry, called from the cmhg veneer.
 *
 * The list of services handled here must match the cmhg input file.
 *
 * Parameters:
 *   service_number  Service_* code from h.Services
 *   r               register block (per-service argument layout)
 *   pw              private word
 */
void LM_Service(int service_number, _kernel_swi_regs *r, void *pw) {
  UNUSED(pw);

  switch (service_number) {
  case Service_FSRedeclare:
    LM_Declare();
    break;

  case Service_OmniAction:
    Omni_ServiceCall(r, pw);
    break;

  case Service_ResourceFSStarting:
    /* Reregister with ResourceFS */
    (*(void (*)(void *, void *, void *, void *))r->r[2])(Resources(), 0, 0, (void *)r->r[3]);
    break;

  case Service_DCIDriverStatus:
    LM_check_driver_status(r);
    break;

  case Service_DCIProtocolStatus:
    LM_check_protocol_status(r);
    break;

  case Service_InternetStatus:
    if (NB_InitedTransport == NB_NBIP_Setup) {
      LM_check_internet_status(r);
    }
    break;

  case Service_ModulePostInit: {
    /* A module just finished initialising.  R2 -> module title.  If it's the Free module or OmniClient, retry
     * Omni_StartUp - our LM_Initialise may have run before either of them was around, in which case the
     * registration failed silently then.  Idempotent (Omni_StartUp skips a registration already made), so the cost when the loaded
     * module isn't relevant to us is one strcmp per pair.
     */
    const char *title = (const char *)r->r[2];
    if (title != NULL && (strcmp(title, "Free") == 0 || strcmp(title, "OmniClient") == 0)) {
      Omni_StartUp();
    }
    break;
  }

  default:
    break;
  }
}

/* SWI handler ------------------------------------------ */

/* SWI dispatch entry called from the cmhg veneer.
 *
 * Parameters:
 *   swi_ofs  SWI number minus LanMan_00
 *   r        register block
 *   pw       private word (unused)
 *
 * Returns: NULL on success or an error block on failure.
 */
_kernel_oserror *LM_Swi(int swi_ofs, _kernel_swi_regs *r, void *pw) {
  UNUSED(pw);
  switch (swi_ofs) {
  case LanMan_OmniOp - LanMan_00:
    return OmniOp_SWI(r);

  case LanMan_LogonOp - LanMan_00:
    return Lgn_LogonOp_SWI(r);

  case LanMan_FreeOp - LanMan_00:
    return Omni_FreeOp_SWI(r);

  case LanMan_NameOp - LanMan_00:
    return MsgError(RPC_NameOp(r->r[0],           // reason code
                               (char *)(r->r[1]), // name in
                               (char *)(r->r[2])  // buffer out
                               ));
  case LanMan_Transact - LanMan_00:
    return MsgError(RPC_Transact((char *)(r->r[0]), // server
                                 (char *)(r->r[1]), // share name
                                 (void *)(r->r[2])  // params
                                 ));

  default:
    return MsgError(ENOTPRESENT);
  }

  return NULL;
}

/* Initialisation code ---------------------------------- */

/* Copy a space-delimited token from `src` into `dst`, NUL-terminating.
 *
 * Stops at any character <= ' ' in `src`; at most `maxlen - 1` bytes are written to `dst`, but
 * `src` always advances all the way to the delimiter so the caller can keep parsing.
 *
 * Parameters:
 *   dst     destination buffer
 *   src     source string
 *   maxlen  size of dst including NUL
 *
 * Returns: the updated `src` pointer (positioned at the delimiter).
 */
static char *copy_space(char *dst, char *src, int maxlen) {
  while (*src > ' ') {
    if (--maxlen > 0) {
      *dst++ = *src;
    }
    src++;
  }

  *dst = 0;
  return src;
}

/* ------------------------------- */

/* Parse the module's command-tail options (-d, -n, -m, -i).
 *
 * The RISC OS module command tail is terminated by a control character rather than NUL, so we
 * copy into a local buffer and terminate before scanning.  Repeating a flag is harmless.
 *
 * Parameters:
 *   _line  command tail from LM_Initialise (control-terminated, not NUL-terminated)
 *
 * Returns: OK on success, or ECMDLINE on an unrecognised switch.
 */
static err_t ProcessCmdLine(const char *_line) {
  char cli[256];
  char *end;
  char *line;

  /* Take a local copy and NUL-terminate at the first control character (the RISC OS command-tail terminator).
   * strncpy does not terminate when the tail is 255+ bytes, so plant a NUL at the end first to bound the scan.
   */
  strncpy(cli, _line, 255);
  cli[255] = '\0';
  line = end = cli;
  while (*end >= ' ') {
    end++;
  }
  *end = '\0';

  /* Walk option flags introduced by '-'; each handler advances `line` past its own argument. */
  while ((line = strchr(line, '-')) != NULL) {
    line++;
    switch (toupper(*line)) {
    case 'D': // -d<driver_name>: specify the driver name
      line = copy_space(LM_Vars.drivername, line + 1, NAME_LIMIT);
      break;

    case 'N': // -n: disable network browsing
      Lgn_Logoff();
      break;

    case 'M': // -m<name>: advertised NetBIOS name
      line = copy_space(LM_Vars.machinename, line + 1, NAME_LIMIT);
      strcpyn_upper(LM_Vars.machinename, LM_Vars.machinename, NAME_LIMIT);
      break;

    case 'I': // -i: use NetBIOS-over-IP
      LanMan_InitTransport(NB_NBIP_Setup);
      break;

    default:
      return ECMDLINE;
    }
  }

  return OK;
}

/* ------------------------------- */

void LM_Boot(void) {
  int tries = 1;
  int tmp;
  err_t res;
  char *serv_name;
  char fs_name[FSERVER_LEN + 1];

  /* Network not up yet: park the intent on LM_Vars so the deferred init path picks it up later. */
  if (LM_Vars.initialised < LMInitState_FullyInited) {
    debug("LM_Boot called, but cannot comply: %s\n", LM_Status());
    LM_Vars.initialised = LMInitState_Boot;
    return;
  }

  GetFSName(fs_name);

  if (strlen(fs_name) == 0) {
    debug("Auto-boot: server name has not been set...\n");
    return;
  }

  /* Walk the configured server list (Inet$ServerName, then Inet$ServerName2, 3 ...) trying each until one mounts. */
  for (;;) {
    /* Prefer the domain controller for `fs_name` if RPC can find one; fall back to the configured name. */
    serv_name = RPC_GetDomainController(fs_name);
    if (serv_name == NULL) {
      serv_name = fs_name;
    }

    debug("Server name \"%s\"\n", serv_name);

    res = Omni_MountServer(serv_name,     // Server
                           "ARMBOOT", "", // User name & password
                           "BOOT",        // Mountname
                           "ARMBOOT",     // Drive name
                           &tmp);         // MountID_out

    if (res != OK) {
      printf("%s '%s' - ", MsgLookup("BootBad"), serv_name);
      printf("%s", MsgError(res)->errmess);
      /* tmp is non-zero once the share was successfully created; if we got that far we don't bother trying
       * additional servers, the failure is post-mount.
       */
      if (tmp == 0) {
        char var_name[sizeof("Inet$ServerName12")];
        sprintf(var_name, "Inet$ServerName%d", ++tries);
        if (!_kernel_getenv(var_name, fs_name, FSERVER_LEN)) {
          continue;
        }
      }
    }
    break;
  }
}

/* ------------------------------- */

/* Initialise the module from the cmhg veneer, then run LM_init_phase_2 to bring up the network side if it can. */
_kernel_oserror *LM_Initialise(const char *cmd_tail, int pod_base, void *pw) {
  _kernel_oserror *err;
  uint32_t os_version = 0;

  /* DebugLib first so every subsequent failure path has tracing available; timestamp prefix helps interleave with kernel logs. */
  debug_initialise("LanManFS", "", "");
  debug_atexit();
  debug_set_options(0, 0, 0);
  debug_set_stamp_debug(true); // Prepend " HH:MM:SS" to every debug line via DebugLib's built-in timestamper.
#ifdef SMB2_DEBUG
  debug_set_device(REPORTER_OUTPUT);
#else
  debug_set_device(DEBUGIT_OUTPUT);
#endif
  LM_Vars.initialised = LMInitState_Uninitialised;

  debug("LanManFS: LM_Initialise starting\n");

  UNUSED(pod_base);
  if (pw != NULL) {
    LM_pw = (int)pw;
  }

  /* Resource and message-file registration before any user-visible output. */
  err = _swix(ResourceFS_RegisterFiles, _IN(0), Resources());
  if (err != NULL) {
    return err;
  }
  err = _swix(MessageTrans_OpenFile, _INR(0, 2), msg_struct, "Resources:$.ThirdParty.OmniClient.LanManFS.Messages", 0);
  if (err != NULL) {
    goto initdereg;
  }

  debug("LanManFS: resources opened, calling SetDefaultVars\n");
  SetDefaultVars();

  /* Refuse anything older than RISC OS 3.50; OS identifiers rise with each release. */
  (void)_swix(OS_Byte, _INR(0, 2) | _OUT(1), 129, 0, 255, &os_version);
  if (os_version < OS_IDENTIFIER_MINIMUM) {
    err = MsgError(ERISCOSVER);
    goto initclose;
  }

  /* Optional command-tail processing: parses *RMLoad-style options that override CMOS defaults. */
  if (cmd_tail != NULL) {
    err = MsgError(ProcessCmdLine(cmd_tail));
    if (err != NULL) {
      goto initclose;
    }
  }

  /* Reserve the module's Dynamic Area before the FS is declared.  Once LM_Declare runs, FSEntry handlers can be
   * dispatched into the module at any point, and they assume the workspace pointers (DOSnamebuf, smb2_files, etc.)
   * are already valid.
   */
  debug("LanManFS: claiming module workspace\n");
  err = Workspace_Init();
  if (err != NULL) {
    debug("LanManFS: Workspace_Init failed: %s\n", err->errmess);
    goto initclose;
  }

  /* Bring up module-global cache state before the FS goes live.  Per-mount substrates are claimed lazily by
   * SMB_CreateShare / Cache_MountCreate; only the clock function and the global handle table are initialised here.
   */
  Cache_Init(LM_Tick);
  Cache_SetLeafFold(Xlt_LeafFold);

  /* Declare the filing system.  After this point any FSEntry dispatch may land. */
  debug("LanManFS: calling LM_Declare\n");
  err = LM_Declare();
  if (err != NULL) {
    debug("LanManFS: LM_Declare failed: %s\n", err->errmess);
    goto initws;
  }

  /* SMB2 string conversion tables: prepared once at init so the wire path never builds them lazily. */
  smb2_unicode_init();

  LM_Vars.initialised = LMInitState_PreInit;

  debug("LanManFS: calling LM_init_phase_2\n");
  (void)LM_init_phase_2();

  /* Try to register with OmniClient and the Free module regardless of init_phase_2's outcome.  Neither registration
   * needs the network up; doing this here means the Free module gets us as a service handler even when the network
   * is unavailable at boot (init_phase_2 takes the abort path in that case, but Free / OmniClient are happy to
   * register without it).  Idempotent: safe to be re-fired by the Service_ModulePostInit handler above if Free or
   * OmniClient are themselves loaded later.
   */
  Omni_StartUp();

  return NULL;

initws:
  Workspace_Shutdown();
initclose:
  _swix(MessageTrans_CloseFile, _IN(0), msg_struct);
initdereg:
  _swix(ResourceFS_DeregisterFiles, _IN(0), Resources());
  return err;
}

/* Bring up the sub-modules and the network transport, or leave the module waiting for a service call if there is no network. */
static _kernel_oserror *LM_init_phase_2(void) {
  enum { MAXEXITS = 4 };
  pfnShutdown shutdowns[MAXEXITS];
  int ctr = 0;
  int want_boot;
  int oldstate = LM_Vars.initialised;
  _kernel_oserror *err;

  want_boot = (LM_Vars.initialised == LMInitState_Boot);

  debug("LanManFS: init_phase_2 starting\n");
  debug("Initialising...\n");

  /* Bring up subsystems in dependency order, pushing each shutdown hook onto the unwind stack as we go. */
  if (!FS_Init() || !SMB_Init()) {
    debug("LanManFS: FS_Init or SMB_Init failed\n");
    goto initfailed;
  }
  shutdowns[ctr++] = (pfnShutdown)SMB_Shutdown;
  if (!RPC_Init() || !Prn_Init()) {
    debug("LanManFS: RPC_Init or Prn_Init failed\n");
    goto initfailed;
  }
  shutdowns[ctr++] = (pfnShutdown)Prn_Shutdown;
  if (!Stat_Init()) {
    debug("LanManFS: Stat_Init failed\n");
    goto initfailed;
  }

  err = MsgError(Buf_Init());
  if (err != NULL) {
    debug("LanManFS: Buf_Init failed: %s\n", err->errmess);
    goto abort;
  }

  shutdowns[ctr++] = (pfnShutdown)Buf_Shutdown;

  debug("LanManFS: starting network transport (NB_Startup)\n");
  debug("Starting network transport...\n");

  /* NB_Startup is the most likely failure point: no network -> abort (not fail), waiting for InternetStatus to wake us. */
  err = MsgError(NB_Startup());
  if (err != NULL) {
    debug("LanManFS: NB_Startup failed: %d (%s)\n", err->errnum, err->errmess);
    debug("Error - NB_Startup() returned %d (%s)\n", err->errnum, err->errmess);
    goto abort;
  }
  debug("LanManFS: NB_Startup OK\n");

  startcallbacks();

  /* Everything we need is up: mark FullyInited so LM_Boot can proceed. */
  LM_Vars.initialised = LMInitState_FullyInited;

  _kernel_oscli("IconSprites Resources:$.ThirdParty.OmniClient.LanManFS.Sprites");

  Omni_StartUp();

  /* Replay any boot deferred from an earlier LM_Boot call that found us not yet ready. */
  if (want_boot) {
    debug("Booting...\n");
    LM_Boot();
  }

  debug("All done...\n");

  return NULL;

initfailed:
  /* Hard failure during sub-module init: report EINITFAILED to the caller and unwind. */
  err = MsgError(EINITFAILED);
  debug("LanManFS: %s (%s)\n", err->errmess, LM_Status());
  while (--ctr >= 0) {
    (shutdowns[ctr])();
  }
  return err;

abort:
  /* Soft abort (typically no network): restore the prior state so a service-call retry can pick up from here. */
  LM_Vars.initialised = oldstate;
  while (--ctr >= 0) {
    (shutdowns[ctr])();
  }
  debug("LanManFS: %s\n", LM_Status());
  return NULL;
}

/* Inspect a Service_DCIDriverStatus call: capture the first non-loopback driver to start as our default.
 *
 * Parameters:
 *   r  register block of the service call (R0 = Dib*, R2 = DCIDRIVER_* status)
 */
static void LM_check_driver_status(_kernel_swi_regs *r) {
  char if_name[16];
  Dib *dib = (Dib *)(r->r[0]);

  sprintf(if_name, "%-.8s%u", dib->dib_name, dib->dib_unit);

  if ((strcmp(LM_Vars.drivername, DEFAULT_ETHER_TYPE) == 0) && (r->r[2] == DCIDRIVER_STARTING) && (if_name[0] != 'l')) {
    /* Capture the first interface to start which isn't loopback */
    (void)strncpy(LM_Vars.drivername, if_name, NAME_LIMIT);
  }
}

/* Inspect a Service_DCIProtocolStatus call.
 *
 * If the Internet protocol comes or goes, inform our transport layer so it can drop or re-open its
 * sockets.  Other protocol modules are ignored.
 *
 * Parameters:
 *   r  register block (R2 = DCIPROTOCOL_* status, R4 = protocol name)
 */
static void LM_check_protocol_status(_kernel_swi_regs *r) {
  const char *proto = (char *)r->r[4];

  if (r->r[2] == DCIPROTOCOL_DYING && strcmp(proto, "Internet") == 0) {
    NB_InternetGone();
  } else if (r->r[2] == DCIPROTOCOL_STARTING && strcmp(proto, "Internet") == 0) {
    NB_InternetInit();
  }
}

/* Inspect a Service_InternetStatus call.
 *
 * Two paths complete a deferred boot: a fresh interface address (AddressChanged) when we know
 * which interface we want, or InterfaceUpDown reporting the named interface coming up.  In both
 * cases we only act when we are still in PreInit / Boot: once fully initialised this handler
 * does nothing.
 *
 * Parameters:
 *   r  register block (R0 = InternetStatus_* code, R2 = up/down flag, R3 = interface name)
 */
static void LM_check_internet_status(_kernel_swi_regs *r) {
  char *cp = (char *)r->r[3];

  /* AddressChanged path: any new address is interesting; only check we're still in a state that wants the wakeup. */
  if (r->r[0] == InternetStatus_AddressChanged) {
    if (LM_Vars.initialised != LMInitState_PreInit && LM_Vars.initialised != LMInitState_Boot) {
      return;
    }
  } else {
    /* Other status codes: only InterfaceUpDown for our chosen interface coming up counts. */
    if (LM_Vars.initialised != LMInitState_PreInit && LM_Vars.initialised != LMInitState_Boot) {
      return;
    }
    if (r->r[0] != InternetStatus_InterfaceUpDown) {
      return;
    }
    if (stricmp(LM_Vars.drivername, cp) != 0) {
      return;
    }
    if (r->r[2] != 1) {
      return;
    }
  }

  /* Defensive teardown: under normal sequencing init_phase_2 cannot reach this point with everything still up,
   * but re-entrancy through service calls is hard to reason about, so tear down anyway.
   */
  {
    /* Preserve a parked boot intent across the teardown: LM_GracefulClosedown resets the state to PreInit,
     * erasing the LMInitState_Boot marker that LM_init_phase_2 samples to replay a boot that was deferred
     * because the network was not yet up.
     */
    int boot_pending = (LM_Vars.initialised == LMInitState_Boot);

    LM_GracefulClosedown();

    if (boot_pending) {
      LM_Vars.initialised = LMInitState_Boot;
    }
  }

  LM_init_phase_2();
}

/* ========== Callback code ==========
 *
 * Periodic background work: keep idle connections alive, drain async
 * server-initiated traffic, and recover from dead servers.  The callevery
 * fires on the ticker and queues a transient callback, which then runs in
 * the safer "between SWIs" context.
 */

/*
 * Keep the cache clock, then collect change notifications, keep idle connections alive and probe dead servers.
 *
 * Runs as the transient callback callevery_handler queues.  The network work is skipped while a foreground call is using the connection,
 * since the callback can fire inside one that is waiting, and it runs to the short background deadline because it holds up the whole
 * desktop while it waits.
 *
 * Parameters:
 *   r   register block (unused)
 *   pw  private word (unused)
 *
 * Returns: NULL.
 */
_kernel_oserror *callback_handler(_kernel_swi_regs *r, void *pw) {
  static unsigned ticks_since_types_forgotten;

  UNUSED(r);
  UNUSED(pw);
  switch (callbackflag) {
  case 1:
    Cache_KeepTime();

    /* Drop the file types remembered from MimeMap now and then, so an edit to the MimeMap file is seen.  Nothing waits on the network. */
    if (++ticks_since_types_forgotten >= LM_MIME_CACHE_TTL) {
      ticks_since_types_forgotten = 0u;
      Xlt_ForgetTypes();
    }

    /* Leave the network alone while a foreground call is using it: the callback can fire inside one whenever it
     * waits.  A filing-system call in progress also shows the connection is not idle.
     */
    if (SMB2_IsBusy()) {
      callbackflag = 0;
      break;
    }

    /* Everything below holds up the whole desktop while it waits on the network, so it runs to the short background deadline. */
    SMB2_SetBackground(true);

    /* Drain server-initiated async messages (CHANGE_NOTIFY responses) and the deferred-close queue.  The callevery cadence sets the upper
     * bound on how quickly a server-side mutation reaches the cache and the Filer on an otherwise-idle mount.
     */
    SMB2_PollNotifications();

    /* Dead-server recovery probe and live-server keep-alive. */
    SMB_AntiIdle();
    SMB2_SetBackground(false);
    callbackflag = 0;
  }
  return 0;
}

/* Remove any pending transient callback. */
static void clearcallback(void) {
  if (callbackflag != 0) {
    (void)_swix(OS_RemoveCallBack, _INR(0, 1), callback_entry, LM_pw);
    callbackflag = 0;
  }
}

/* Ticker-event handler called from the cmhg veneer.
 *
 * Queues the transient callback if one is not already pending.  Kept minimal so the work runs in
 * a safer re-entrancy context.
 *
 * Parameters:
 *   r   register block (unused)
 *   pw  private word forwarded to OS_AddCallBack
 *
 * Returns: NULL.
 */
_kernel_oserror *callevery_handler(_kernel_swi_regs *r, void *pw) {
  UNUSED(r);
  if (callbackflag == 0 && _swix(OS_AddCallBack, _INR(0, 1), callback_entry, pw) == NULL) {
    callbackflag = 1;
  }
  return 0;
}

/* Start the periodic callevery timer.  See LM_CALLEVERY_TICKS in h/LanMan for the cadence rationale. */
static void startcallbacks(void) {
  (void)_swix(OS_CallEvery, _INR(0, 2), LM_CALLEVERY_TICKS, callevery_entry, LM_pw);
}

/* Stop the periodic callevery timer and drop any pending transient callback. */
static void stopcallbacks(void) {
  (void)_swix(OS_RemoveTickerEvent, _INR(0, 1), callevery_entry, LM_pw);
  clearcallback();
}
