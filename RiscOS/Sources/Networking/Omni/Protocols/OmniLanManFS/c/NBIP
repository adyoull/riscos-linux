/* Init & Shutdown routines ====================================== */

void NBIP_ReleaseEventHandler(void) {
  if (EventsClaimed) {
    EventsClaimed = false;
    _swix(OS_Release, _INR(0, 2), EventV, (int)EventFn, LM_pw);
    _swix(OS_Byte, _INR(0, 1), 13, Internet_Event); // Disable event
  }
}

/* Release the Internet event handler and the machine name, close the NBNS socket and every session, and remove the callbacks.
 *
 * Releasing the name broadcasts three release requests with a wait after each, so shutdown pauses while it is done.
 */
EXPORT void _NB_Shutdown(void) {
  int i;
  /* De-register the event handler first, because socketclose() invokes the internet event.  We don't want it
   * setting a callback, because we'll be dead by the time the callback fires.  This dispatch-table shutdown
   * runs late in LM_GracefulClosedown, so LM_GracefulClosedown also calls NBIP_ReleaseEventHandler directly
   * at the top, before SMB_Shutdown closes SMB2 sockets.  The call here is a no-op safety net: if some other
   * caller invokes NB_Shutdown without releasing the handler first, this still protects our socketclose
   * calls below.
   */
  NBIP_ReleaseEventHandler();

  /* Release the machine name while the socket is still there to send on, so other nodes stop holding it for us.
   * With the Internet module gone there is no socket, and the name lapses on the network by itself.
   */
  if (NBNS_Socket != INVALID_SOCKET && NB_MachineName != NULL) {
    (void)_NB_RemoveLocalName(NB_MachineName);
  }
  NB_MachineName = NULL;

  /* Close the NBNS broadcast/listen socket. */
  if (NBNS_Socket != INVALID_SOCKET) {
    socketclose(NBNS_Socket);
    NBNS_Socket = INVALID_SOCKET;
  }

  /* Tear down every active session and clear its slot. */
  for (i = 0; i < MAX_SESSIONS; i++) {
    if (NB_Sessions[i].status == SESS_CONNECTED) {
      socketclose(NB_Sessions[i].sid);
      NB_Sessions[i].status = SESS_FREE;
    }
  }

  RemoveCallbacks();
}

/* NB_Startup() -----------------------------------------------------
 *
 * On startup, we have to
 *
 * i) Set the NetBIOS scope ID ii)  create a socket for the NBNS daemon iii) install an Internet Event handler iv) register our
 * name on the net
 */

static int On = 1;

static struct sockaddr_in Broadcast_sin;

EXPORT err_t _NB_Startup(void) {
  err_t res;
  int i;
  struct sockaddr_in sa;
  struct ifreq IFR;

  debug("Starting TCP/IP transport\n");

  /* Clear out name table & session table */

  for (i = 0; i < MAX_NAMES; i++) {
    NB_NameTable[i].status = NAME_FREE;
  }
  NB_MachineName = NULL; // Its entry has just been cleared

  for (i = 0; i < MAX_SESSIONS; i++) {
    NB_Sessions[i].status = SESS_FREE;
  }

  NB_FirstFreeName = 0;
  NBNS_RequestCount = 0;

  Stat_ClassMask |= SCLASS_IP;

  SetScopeID(getenv("LanMan$ScopeID"));

  /* Set up broadcast addresses */

#ifndef COMPAT_INET4
  Broadcast_sin.sin_len = sizeof(Broadcast_sin);
#endif
  Broadcast_sin.sin_family = AF_INET;
  Broadcast_sin.sin_port = htons(NBNS_PORT);
  Broadcast_sin.sin_addr.s_addr = INADDR_BROADCAST;
  NBNS_Broadcast = (struct sockaddr *)&Broadcast_sin;

  /* Create a socket for the NBNS server (checks TCPIP works!) */

  NBNS_Socket = socket(PF_INET, SOCK_DGRAM, 0);
  if (NBNS_Socket == INVALID_SOCKET) {
    debug("Couldn't create socket\n");
    return ENOSOCKETS;
  }

  /* Get a network address */

  strcpy(IFR.ifr_name, LM_Vars.drivername);
  /* Will be Inet$EtherType unless overridden */

  if (socketioctl(NBNS_Socket, SIOCGIFADDR, (char *)&IFR) < 0) {
    debug("Couldn't find IP address for interface \"%s\"\n", LM_Vars.drivername);
    (void)socketclose(NBNS_Socket);
    NBNS_Socket = INVALID_SOCKET;
    return ENOIFADDR;
  }

  NB_IPAddress = ((struct sockaddr_in *)&IFR.ifr_addr)->sin_addr;

  /* Invent machine name from host address if needs be */

  if (LM_Vars.machinename[0] == 0) {
    union in_addr_byte iab;
    iab.ina = NB_IPAddress;

    sprintf(LM_Vars.machinename, "ARMIP%02X%02X%02X%02X", iab.nb[0], iab.nb[1], iab.nb[2], iab.nb[3]);
  }

#ifdef DEBUG
  show_scope(NB_ScopeID);
  debug("Machine name is \"%s\", IP address %s\n", LM_Vars.machinename, inet_ntoa(NB_IPAddress));
#endif

  /* Bind socket */
#ifndef COMPAT_INET4
  sa.sin_len = sizeof(sa);
#endif
  sa.sin_family = AF_INET;
  sa.sin_port = htons(NBNS_PORT);
  sa.sin_addr.s_addr = INADDR_ANY;

  if (bind(NBNS_Socket, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
    /* Socket will be closed on exit */
    debug("Couldn't bind socket\n");
    (void)socketclose(NBNS_Socket);
    NBNS_Socket = INVALID_SOCKET;
    return ENOSOCKETS;
  }

  /* Allow broadcasts */
  setsockopt(NBNS_Socket, SOL_SOCKET, SO_BROADCAST, &On, sizeof(int));

  /* Generate events */
  socketioctl(NBNS_Socket, FIOASYNC, &On);

  /* It's now ready for action - set up internet event handler */

  /*CallbackSet = false;*/
  if (!EventsClaimed) {
    _swix(OS_Claim, _INR(0, 2), EventV, (int)EventFn, LM_pw);
    _swix(OS_Byte, _INR(0, 1), 14, Internet_Event); // Enable event
    EventsClaimed = true;
    debug("Events claimed\n");
  }

  //  strcpy ( LM_Vars.drivername, "TCP/IP");

  /* Now try to register name... */

  debug("Setting our local name as \"%s\"\n", LM_Vars.machinename);
  res = _NB_AddLocalName(ntMACHINE, LM_Vars.machinename, &NB_MachineName);
  if (res != OK) {
    _NB_Shutdown();
  }

  return res;
}

/* NB_InternetGone() ---------------------------
 *
 * The Internet module has disappeared.  Mark all sessions as disconnected and pray that a new Internet module comes back before
 * anything tries to do anything with a session.
 */

static void _NB_InternetGone(void) {
  int i;

  for (i = 0; i < MAX_SESSIONS; ++i) {
    if (NB_Sessions[i].status == SESS_CONNECTED) {
      NB_Sessions[i].sid = INVALID_SOCKET;
      NB_Sessions[i].LinkOK = false;
    }
  }

  NBNS_Socket = INVALID_SOCKET;

  RemoveCallbacks();
}

/* NB_InternetInit() ---------------------------
 *
 * The Internet module has arrived.  Mark all sessions as disconnected and try to re-initialise things.  However, we must be
 * careful - only do this if we saw the old Internet module dying, because this might be the main ROM one sending the service
 * call on a callback.  We must only reinit if we saw a dying service call.
 */

static void _NB_InternetInit(void) {
  if (NBNS_Socket == INVALID_SOCKET) {

    int i;

    for (i = 0; i < MAX_SESSIONS; ++i) {
      if (NB_Sessions[i].status == SESS_CONNECTED) {
        NB_Sessions[i].sid = INVALID_SOCKET;
        NB_Sessions[i].LinkOK = false;
      }
    }

    _NB_Startup();
  }
}

/* Setup routine ------------------------------- */

static struct NETBIOS_TRANSPORT NBIP_Transport;

err_t NBIP_ResolveServerName(const char *servname, unsigned long *ip_out) {
  NETNAME nn;
  NAME_ENTRY *far_end;
  err_t res;

  /* Pack the C-string into the 16-byte NetBIOS name format with the SERVER suffix. */
  res = _NB_FormatName(ntSERVER, (char *)servname, &nn);
  if (res != OK) {
    debug("NBIP_Resolve: FormatName failed (%d)\n", res);
    return res;
  }

  far_end = FindRemoteName(&nn);
  if (far_end == NULL) {
    debug("NBIP_Resolve: %s not found\n", servname);
    return ECANTFINDNAME;
  }

  /* Hand the IP to the caller and demote the entry from RMT_FOUND to RMT_CACHED so
   * the periodic sweep can evict it once its TTL expires - we don't hold this name.
   */
  *ip_out = far_end->IPaddress.s_addr;
  far_end->status = RMT_CACHED;
  debug("NBIP_Resolve: %s -> %08X\n", servname, (unsigned int)*ip_out);
  return OK;
}

void NB_NBIP_Setup(void) {
  struct NETBIOS_TRANSPORT *p;

  /* Publish ourselves as the active transport and wire each pfn slot to the NBIP-side implementation.  The shim
   * lets NetBIOS callers stay transport-agnostic.
   */
  NB_ActiveTransport = p = &NBIP_Transport;
  p->pfnStartup = _NB_Startup;
  p->pfnShutdown = _NB_Shutdown;
  p->pfnFormatName = _NB_FormatName;
  p->pfnDecodeName = _NB_DecodeName;
  p->pfnMatchName = _NB_MatchName;
  p->pfnAddLocalName = _NB_AddLocalName;
  p->pfnRemoveLocalName = _NB_RemoveLocalName;
  p->pfnOpenSession = _NB_OpenSession;
  p->pfnSendData = _NB_SendData;
  p->pfnSendBlockData = _NB_SendBlockData;
  p->pfnClearRxQueue = _NB_ClearRxQueue;
  p->pfnGetData = _NB_GetData;
  p->pfnGetBlockData = _NB_GetBlockData;
  p->pfnLinkOK = _NB_LinkOK;
  p->pfnCloseSession = _NB_CloseSession;
  p->pfnFindNames = _NB_FindNames;
  p->pfnDescribeLink = _NB_DescribeLink;
  p->pfnInternetGone = _NB_InternetGone;
  p->pfnInternetInit = _NB_InternetInit;
}
