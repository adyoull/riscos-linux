/* NETNAME management ==================================== */

EXPORT bool _NB_MatchName(NETNAME *nn1, NETNAME *nn2) {
  return (bool)(nn1->c4[0] == nn2->c4[0] && nn1->c4[1] == nn2->c4[1] && nn1->c4[2] == nn2->c4[2] && nn1->c4[3] == nn2->c4[3]);
}

/* --------------------- */

EXPORT err_t _NB_FormatName(nametype_t nt, char *name, NETNAME *res) {
  int i;

  /* Copy up to 15 chars, upper-cased.  Stops at the first space or control
   * char so a short name is truncated cleanly rather than carrying trailing
   * garbage.  Non-breaking space (0xA0) folds to plain space - some name
   * sources use NBSP as a separator and we want it normalised on the wire.
   */
  for (i = 0; i < 15; i++) {
    if (name[i] <= 0x20) {
      break;
    }
    if (name[i] == '\xA0') {
      res->b[i] = ' ';
    } else {
      res->b[i] = toupper(name[i]);
    }
  }

  /* Pad the remainder with spaces - NetBIOS names are always exactly 16 bytes. */
  while (i < 15) {
    res->b[i++] = 0x20;
  }

  /* Final byte is the name-type discriminator (workstation, server, group, ...). */
  res->b[15] = nt;
  return OK;
}

/* --------------------- */

EXPORT nametype_t _NB_DecodeName(NETNAME *pnn, char *buf) {
  uint8_t *p = pnn->b;
  char *last_nonsp = buf;
  int i;

  /* Copy out the printable prefix - stop at the first control char. */
  for (i = 0; i < 15 && *p >= 0x20; ++i) {
    *buf++ = *p++;
  }

  *buf = 0;

  /* Walk back over trailing pad spaces and trim them, stopping at the
   * last character that is not a space so a space inside the name stays.
   * Stop short of last_nonsp so we never NUL out the input pointer itself
   * if the whole name was blank.
   */
  while (--buf > last_nonsp && *buf == ' ') {
    *buf = 0;
  }

  return (nametype_t)(pnn->b[15]);
}

/* NAME_ENTRY management ============================= */

static void FreeNameEntry(NAME_ENTRY *p) {
  int n;
  p->status = NAME_FREE;
  n = p - NB_NameTable;

  if (NB_FirstFreeName > n) {
    NB_FirstFreeName = n;
  }
}

/* ------------------ */

/* Free cached remote names whose time to live has run out. */
static void CheckExpiredNames(void) {
  int i;
  NAME_ENTRY *pNE;

  pNE = NB_NameTable;
  for (i = 0; i < MAX_NAMES; i++) {
    if (pNE->status == RMT_CACHED && (LM_Tick() - pNE->TTL_StartTime) > pNE->TTL_Interval) {
      FreeNameEntry(pNE);
    }
    pNE++;
  }
}

/* ------------------ */

static NAME_ENTRY *AllocNameEntry(int stat) {
  int i;

  CheckExpiredNames(); // Make some space if possible

  /* First-fit scan from the free hint.  FreeNameEntry lowers NB_FirstFreeName
   * whenever it frees an entry below it, so no free entry lies below the hint.
   */
  for (i = NB_FirstFreeName; i < MAX_NAMES; i++) {
    if (NB_NameTable[i].status == NAME_FREE) {
      NB_NameTable[i].status = stat;
      NB_FirstFreeName = i + 1;
      return &NB_NameTable[i];
    }
  }

  /* Table full.  Evict the first cached remote name (cached entries are
   * fair game - they're only IP/name resolutions we can re-query if needed).
   */
  for (i = 0; i < MAX_NAMES; i++) {
    if (NB_NameTable[i].status == RMT_CACHED) {
      NB_FirstFreeName = i + 1;
      NB_NameTable[i].status = stat;
      return &NB_NameTable[i];
    }
  }

  return NULL;
}

/* --------------- */

static NAME_ENTRY *FindNameEntry(NETNAME *pNN) {
  int i;
  NAME_ENTRY *pNE;
  pNE = NB_NameTable;

  for (i = 0; i < MAX_NAMES; i++) {
    if (pNE->status != NAME_FREE) {
      if (_NB_MatchName(pNN, &(pNE->nn))) {
        return pNE;
      }
    }
    pNE++;
  }

  return NULL;
}

/* NBNS Subroutines ================================= */

/* Struct in_addr's always contain addresses in network byte order, so the integer value of the s_addr field, as perceived by C,
 * will vary between big-endian and little-endian implementations.
 *
 * Hence, we have to phrase our routines in such a way that they are independent of the endian-ness (preferably by not treating
 * struct in_addr as an integer value at all). The union below helps
 */

union in_addr_byte {
  struct in_addr ina;
  uint8_t nb[4];
};

/* ------------------- */

static struct sockaddr_in NameServer_sin;

static void SetupNameServer(void) {
  if (NBNS_NameServer == NULL) {
    char *ns_addr = getenv("LanMan$NameServer");
    union in_addr_byte iab;
    int b0, b1, b2, b3;

    /* Source the NBNS address from the system variable if set; otherwise fall back to the four CMOS bytes. */
    if ((ns_addr == NULL) || (sscanf(ns_addr, "%d.%d.%d.%d", &b0, &b1, &b2, &b3) != 4)) {
      b0 = RdCMOS(NBNSIPCMOS0);
      b1 = RdCMOS(NBNSIPCMOS1);
      b2 = RdCMOS(NBNSIPCMOS2);
      b3 = RdCMOS(NBNSIPCMOS3);
    }

    /* Sanity-check the address: reject 0.x.x.x and 127.x.x.x (unusable), class D/E (>223), and any final
     * .0 or .255 octet (network / broadcast).  Anything outside that envelope populates the cached sockaddr.
     */
    if (((b0 != 0) && (b0 != 127) && (b0 <= 223)) && ((b3 != 0) && (b3 != 255))) {
      iab.nb[0] = b0, iab.nb[1] = b1, iab.nb[2] = b2, iab.nb[3] = b3;
#ifndef COMPAT_INET4
      NameServer_sin.sin_len = sizeof(NameServer_sin);
#endif
      NameServer_sin.sin_family = AF_INET;
      NameServer_sin.sin_port = htons(NBNS_PORT);
      NameServer_sin.sin_addr = iab.ina;
      NBNS_NameServer = (struct sockaddr *)&NameServer_sin;
    }
  }
}

/* ----------------- */

/* Given a scope ID (e.g. "netbios.ibm.com"), converts this to the NBNS compacted format. */

static void SetScopeID(char *src) {
  int i, l;
  char *p;

  if (src == NULL) {
    src = "";
  }

  NB_ScopeIDlen = 0;

  /* Encode "a.b.c" as <len><label><len><label>...<0> per RFC 1002.  Each
   * label is one length byte followed by the upper-cased name bytes, terminated
   * by a zero-length label.  Labels longer than 63 bytes are illegal per the
   * DNS specification, so the first oversized component is refused.
   */
  do {
    p = strchr(src, '.');
    if (p == NULL) {
      l = strlen(src);
    } else {
      l = p - src;
    }

    /* Bail on an empty label (run of dots or trailing dot), one that's too
     * long for the wire encoding, or one that won't fit in our scratch buffer.
     */
    if (l == 0 || l >= 64 || NB_ScopeIDlen + l + 1 >= SCOPE_ID_MAX) {
      break;
    }

    NB_ScopeID[NB_ScopeIDlen++] = l;
    for (i = 0; i < l; i++) {
      NB_ScopeID[NB_ScopeIDlen++] = toupper(*src++);
    }
    src++; // Skip 'dot' if present
  } while (p != NULL);

  /* Terminating zero-length label, and include it in the recorded length. */
  NB_ScopeID[NB_ScopeIDlen] = 0;
  NB_ScopeIDlen++;
}

/* ---------------------------------------- */

static uint GetLong(uint8_t *p) {
  return (p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
}

/* ---------- */

static uint8_t *PutLong(uint8_t *ptr, uint v) {
  *ptr++ = (v >> 24);
  *ptr++ = (v >> 16);
  *ptr++ = (v >> 8);
  *ptr++ = v;
  return ptr;
}

/* ---------- */

static struct in_addr GetIPAddr(uint8_t *p) {
  union in_addr_byte ib;
  ib.nb[0] = p[0];
  ib.nb[1] = p[1];
  ib.nb[2] = p[2];
  ib.nb[3] = p[3];
  return ib.ina;
}

/* ---------- */

static uint8_t *PutIPAddr(uint8_t *ptr, struct in_addr ia) {
  union in_addr_byte ib;
  ib.ina = ia;
  *ptr++ = ib.nb[0];
  *ptr++ = ib.nb[1];
  *ptr++ = ib.nb[2];
  *ptr++ = ib.nb[3];
  return ptr;
}

/* ------------- */

static uint GetShort(uint8_t *p) {
  return (p[0] << 8) | p[1];
}

/* ------------- */

static uint8_t *PutShort(uint8_t *ptr, uint v) {
  *ptr++ = (v >> 8);
  *ptr++ = v;
  return ptr;
}

/* --------------- */

static uint8_t *PutNetname(uint8_t *ptr, NETNAME *pNN) {
  /* Put NetBIOS name in a compressed ASCII-coded representation */
  int i, c;
  uint8_t *p;

  p = pNN->b; // Pointer to first part of name

  *ptr++ = 32; /* This is always 32 characters */

  for (i = 0; i < 16; i++) {
    c = *p++;
    *ptr++ = 'A' + ((c >> 4) & 0xF);
    *ptr++ = 'A' + (c & 0xF);
  }

  memcpy(ptr, NB_ScopeID, NB_ScopeIDlen);
  return ptr + NB_ScopeIDlen;
}

/* --------------- */

static uint8_t *PutNetnameIndirect(uint8_t *ptr, uint8_t *name, uint8_t *buf_start) {
  int c = name - buf_start;

  if (c > 0 && c <= 0x3FFF) {
    ptr = PutShort(ptr, c | 0xC000);
  } else {
    STAT(STA_SERIOUS_BARF);
    *ptr++ = 0;
  }

  return ptr;
}

/* -------------- */

static uint8_t *PutResourceInfo(uint8_t *p, NAME_ENTRY *pNE, uint ttl) {
  p = PutLong(p, ttl);
  p = PutShort(p, 0x0006); // 6 extra data bytes
  p = PutShort(p, pNE->nbflags);
  return PutIPAddr(p, pNE->IPaddress);
}

/* -------------- */

static uint8_t *CreateNBNSheader(uint8_t *ptr, int opcode, int trn_ID) {
  /* Creates an NBNS header */
  ptr = PutShort(ptr, trn_ID); // Create new request ID
  ptr = PutShort(ptr, opcode & 0xFFFF);
  ptr = PutShort(ptr, (opcode & HAS_QUERY) ? 1 : 0);
  ptr = PutShort(ptr, (opcode & HAS_ANSWER) ? 1 : 0);
  ptr = PutShort(ptr, (opcode & HAS_AUTHORITY) ? 1 : 0);
  return PutShort(ptr, (opcode & HAS_ADDITIONAL) ? 1 : 0);
}

/* Transmit routines ============================================ */

static void SendDatagram(struct sockaddr *pDst, uint8_t *start, uint8_t *end) {
  dprintf((__FILE__, "SendDatagram ID:&%04x to %s\n", GetShort(start), inet_ntoa(((struct sockaddr_in *)pDst)->sin_addr)));
  sendto(NBNS_Socket, start, end - start, 0, pDst, sizeof(struct sockaddr_in));
}

/* --------------------- */

static void SendRegisterRequest(struct sockaddr *pDst, NAME_ENTRY *pNE) {
  uint8_t *p, *name_p;

  p = CreateNBNSheader(DatagramBuf, NAME_REG_REQUEST, ++NBNS_RequestCount);
  name_p = p;
  p = PutNetname(p, &(pNE->nn)); // Query section
  p = PutLong(p, INET_NAME_TAG);
  /* Resource section, using a name pointer */
  p = PutNetnameIndirect(p, name_p, DatagramBuf);
  p = PutLong(p, INET_NAME_TAG);
  p = PutResourceInfo(p, pNE, REGISTER_TTL);

  SendDatagram(pDst, DatagramBuf, p);
}

/* --------------------- */

static void SendReleaseRequest(struct sockaddr *pDst, NAME_ENTRY *pNE) {
  uint8_t *p, *name_p;

  p = CreateNBNSheader(DatagramBuf, NAME_RLSE_REQUEST, ++NBNS_RequestCount);
  name_p = p;
  p = PutNetname(p, &(pNE->nn)); // Query section
  p = PutLong(p, INET_NAME_TAG);
  /* Resource section, using a name pointer */
  p = PutNetnameIndirect(p, name_p, DatagramBuf);
  p = PutLong(p, INET_NAME_TAG);
  p = PutResourceInfo(p, pNE, 0);

  SendDatagram(pDst, DatagramBuf, p);
}

/* --------------------- */

static void SendFindRequest(struct sockaddr *pDst, NAME_ENTRY *pNE) {
  uint8_t *p;

  p = CreateNBNSheader(DatagramBuf, NAME_FIND_REQUEST, ++NBNS_RequestCount);
  p = PutNetname(p, &(pNE->nn)); // Query section
  p = PutLong(p, INET_NAME_TAG);

#ifdef SMB2_DEBUG_VERBOSE
  {
    struct sockaddr_in *sin = (void *)pDst;
    vdebug("SendFindRequest (%s)-> [%s]\n", debug_name(&(pNE->nn)), inet_ntoa(sin->sin_addr));
  }
#endif
  SendDatagram(pDst, DatagramBuf, p);
}

/* --------------------- */

static void SendStatusRequest(struct sockaddr *pDst, NAME_ENTRY *pNE) {
  uint8_t *p;

  p = CreateNBNSheader(DatagramBuf, NAME_STATUS_REQUEST, ++NBNS_RequestCount);
  p = PutNetname(p, &(pNE->nn)); // Query section
  p = PutLong(p, INET_STATUS_TAG);

  dprintf((__FILE__, "SendStatusRequest (%s)\n", debug_name(&(pNE->nn))));

  SendDatagram(pDst, DatagramBuf, p);
}

/* Name Decoding subroutines ==================================== */

/* Read RFC-1001 for more info on the bizarre network name representation scheme. */

static bool ValidateName(uint8_t *src, uint8_t *buf_start, uint8_t *buf_end) {
  int c, loopy_count;

  /* loopy_count protects against a maliciously-crafted packet whose name
   * pointers form a cycle: each pointer chase counts as one iteration, so
   * 100 iterations is comfortably above any legitimate name (RFC 1002 names
   * are short) but capped well short of a denial-of-service hang.
   */
  loopy_count = 0;

  while (src >= buf_start && src < buf_end && loopy_count++ < 100) {
    c = *src;

    if (c == 0) { // Reached the end without incident
      return true;
    } else if (c < 0x40) { // Ordinary length-prefixed label
      src += (c + 1);
    } else if (c >= 0xC0) // Name-pointer (compressed reference back into the buffer)
    {
      if (src + 2 > buf_end) {
        return false;
      }
      src = buf_start + (GetShort(src) & 0x3FFF);
    } else {
      /* 0x40-0xBF is reserved per RFC 1002 - any such byte is a corruption signal. */
      debug("Invalid byte %Xh in name\n", c);
      return false;
    }
  }

  /* Walked off the buffer end, looped too long, or pointed below buf_start. */
  debug("Invalid name - exceeded length\n");
  return false;
}

/* -------------- */

static uint8_t *FindNameEnd(uint8_t *src) {
  int c;
  while (c = src[0], c != 0) {
    if (c >= 0xC0) { // Pointer
      return src + 2;
    }
    src += (c + 1);
  }
  return src + 1;
}

/* --------------------- */

/* ChasePointer is a subroutine for FindNBNSName.
 *
 * It keeps following a pointer in an encoded representation to find out where it starts.
 */

static uint8_t *ChasePointer(uint8_t *src, uint8_t *buf_start) {
  while (src[0] >= 0xC0) {
    src = buf_start + (GetShort(src) & 0x3FFF);
  }

  return src;
}

/* Decode the encoded NetBIOS name in an NBNS packet and search the name table for it.
 *
 * All names of interest are kept in the table, so this is the only place that name decoding needs to be done.
 *
 * It returns NULL if the name is not a 32-character encoded name, its scope differs from ours, or it is not in the table.
 *
 * It does no bounds checking of its own, so it should be called only with names which have passed ValidateName().
 */

static NAME_ENTRY *FindNBNSName(uint8_t *src, uint8_t *buf_start) {
  NETNAME netname;
  uint8_t *id;
  int i;

  /* Find first bit of name */

  src = ChasePointer(src, buf_start);

  if (src[0] != 32) { // Encoded NetBIOS name is always 32 characters
    return NULL;
  }

  /* src points to the encoded NetBIOS name - decode it now */

  src++;
  for (i = 0; i < 16; i++) {
    netname.b[i] = ((src[0] - 'A') << 4) + src[1] - 'A';
    src += 2;
  }

  vdebug("Name=%s", debug_name(&netname));
  debug_scope(src);
  vdebug("\n");

  /* Now check NetBIOS scope ID */

  id = NB_ScopeID;

  while (1) {
    src = ChasePointer(src, buf_start);
    i = src[0];       // Length of this segment
    if (i != id[0]) { // Length mismatch
      return NULL;
    }
    if (i == 0) { // The end
      break;
    }
    if (memcmp(src + 1, id + 1, i) != 0) {
      return NULL;
    }
    src += i + 1;
    id += i + 1;
  }

  /* Now check name table */
  return FindNameEntry(&netname);
}

/* ---------------- */

struct NBNS_packet {
  struct sockaddr from;
  int trn_id;          // Transaction ID
  int opcode;          // Opcode
  int n_query;         // No. of query records
  int n_answer;        // No. of answer records
  int n_auth;          // No. of authority records
  int n_add;           // No. of additional records
  uint8_t *buf_start;  // Start of raw data
  uint8_t *buf_end;    // Last byte of raw data plus one
  uint8_t *record_ptr; // Next record to decode, for GetNBNSRecord
};

struct NBNS_resource_record {
  NAME_ENTRY *pName;
  int name_tag;
  int time_to_live;
  int data_length;
  uint8_t *data_ptr;
};

/* ------------------------------- */

static bool GetNBNSRecord(struct NBNS_packet *pNBP, struct NBNS_resource_record *pDst, int flg) {
  uint8_t *src = pNBP->record_ptr;

  /* Name truncated or garbage? */
  if (!ValidateName(src, pNBP->buf_start, pNBP->buf_end)) {
    debug("Name truncated\n");
    return false;
  }

  /* Look the name up against our table.  Unknown names are not fatal here
   * (we still consume the record so the caller can advance to the next), the
   * caller decides whether to act on the result via pDst->pName.
   */
  pDst->pName = FindNBNSName(src, pNBP->buf_start);
  if (pDst->pName == NULL) {
    vdebug("Name unknown to us\n");
  }

  src = FindNameEnd(src);

  if (flg & GET_RESOURCE) {
    /* Resource record: <tag:4><ttl:4><rdlen:2><rdata...>.  10 bytes of fixed
     * header before the variable-length rdata.
     */
    if (src + 10 > pNBP->buf_end) {
      debug("Resource truncated\n");
      return false;
    }

    pDst->name_tag = GetLong(src);
    pDst->time_to_live = GetLong(src + 4);
    pDst->data_length = GetShort(src + 8);

    src += 10;
    pDst->data_ptr = src;

    if (src + pDst->data_length > pNBP->buf_end) {
      /* Benign truncation - we give all the data that's available */
      pDst->data_length = pNBP->buf_end - src;
    }

    src += pDst->data_length;
  } else {
    /* Query record: only the name-tag, no ttl or data block. */
    if (src + 4 > pNBP->buf_end) {
      debug("Query truncated\n");
      return false;
    }

    pDst->name_tag = GetLong(src);
    pDst->time_to_live = 0;
    pDst->data_length = 0;

    src += 4;
  }

  /* Advance the per-packet cursor so the next GetNBNSRecord() picks up at the next record. */
  pNBP->record_ptr = src;
  return true;
}

/* Receive processing routines ======================================= */

static void NameFindRequest(struct NBNS_packet *pNBP, struct NBNS_resource_record *pNBRR) {
  NAME_ENTRY *pNE = pNBRR->pName;
  uint8_t *p;

  if (pNE->status == LCL_NAME_OK) {
    p = CreateNBNSheader(DatagramBuf, NAME_FIND_REPLY, pNBP->trn_id);
    p = PutNetname(p, &(pNE->nn));
    p = PutLong(p, INET_NAME_TAG);
    p = PutResourceInfo(p, pNE, FIND_TTL);

    sendto(NBNS_Socket, DatagramBuf, p - DatagramBuf, 0, &(pNBP->from), sizeof(pNBP->from));
  }
}

/* ---------------- */

static void NameRegisterRequest(struct NBNS_packet *pNBP, struct NBNS_resource_record *pNBRR_query) {
  NAME_ENTRY *pNE;
  struct NBNS_resource_record NBR_add;
  uint8_t *p;

  pNE = pNBRR_query->pName;

  /* Get additional record, containing group status & IP address */

  if ( // Are all the parameters OK
      pNE->status != LCL_NAME_OK || pNBP->n_add < 1 || !GetNBNSRecord(pNBP, &NBR_add, GET_RESOURCE) || NBR_add.data_length < 6) {
    return;
  }

  /* Are they both group names? If so, don't worry */

  if ((GetShort(NBR_add.data_ptr) & NBFLG_GROUP) != 0 && (pNE->nbflags & NBFLG_GROUP) != 0) {
    return;
  }

  /* If the IP addresses match, panic not */
  if (GetIPAddr(NBR_add.data_ptr + 2).s_addr == pNE->IPaddress.s_addr) {
    return;
  }

  /* Send a negative name registration response with our details */

  p = CreateNBNSheader(DatagramBuf, NAME_REG_REPLY | ST_ACT_ERR, pNBP->trn_id);
  p = PutNetname(p, &(pNE->nn));
  p = PutLong(p, INET_NAME_TAG);
  p = PutResourceInfo(p, pNE, REGISTER_TTL);

  sendto(NBNS_Socket, DatagramBuf, p - DatagramBuf, 0, &(pNBP->from), sizeof(pNBP->from));
}

/* ---------------------------- */

/* Record the address and time to live from a positive reply to a name query we are waiting on. */
static void NameFindReply(struct NBNS_packet *pNBP, struct NBNS_resource_record *pNBRR) {
  NAME_ENTRY *pNE = pNBRR->pName;
  uint8_t *dp = pNBRR->data_ptr;

  /* Are we waiting for a reply? Is this the one? */

  if ((pNBP->opcode & OPC_STATUS_MASK) == ST_OK && pNE->status == RMT_AWAIT_FIND && pNBRR->data_length >= 6 // At least one entry in reply
  ) {
    vdebug("NameFindReply - found\n");
    pNE->status = RMT_FOUND;
    pNE->nbflags = GetShort(dp);
    pNE->IPaddress = GetIPAddr(dp + 2);

    /* The time to live is in seconds (RFC 1002).  Cap it, so a long one cannot keep a changed address in use. */
    pNE->TTL_StartTime = LM_Tick();

    if (pNBRR->time_to_live > 0) {
      pNE->TTL_Interval = (pNBRR->time_to_live > FIND_TTL_MAX_CS / 100) ? FIND_TTL_MAX_CS : (uint)pNBRR->time_to_live * 100;
    } else {
      pNE->TTL_Interval = FIND_TTL / 10;
    }
  }
}

/* ---------------------------- */

static void NameStatusReply(struct NBNS_packet *pNBP, struct NBNS_resource_record *pNBRR) {
  struct status_resp *pSR;
  uint8_t *dp;
  int n, flg;

  UNUSED(pNBP); // The record carries everything the reply needs

  /* Pick up the result-collector pointer that the original caller attached
   * to the name entry.  Drop the response if the name isn't in the awaiting
   * state or if the payload is too short to hold even the count byte - the
   * remote server may have sent a stray or stale reply.
   */
  dp = pNBRR->data_ptr;
  pSR = pNBRR->pName->pStatResp;

  if (pSR == NULL || pNBRR->pName->status != RMT_STATUS_Q || pNBRR->data_length < 1) {
    debug("Puzzling status response\n");
    return;
  }

  /* Payload is <count:1> followed by count * 18-byte entries (16-byte name
   * plus 2-byte flags).  Cap n against the actual payload length in case the
   * server claims more entries than fit.
   */
  n = *dp++;
  if (n * 18 >= pNBRR->data_length) {
    n = (pNBRR->data_length - 1) / 18;
  }

  vdebug("Status: %d names, type %Xh, %d spc\n", n, pSR->nt_search, pSR->spaces_left);

  ddumpbuf(__FILE__, dp, n * 18, 0);

  /* Pass 1: copy entries matching the caller's name-type filter into pRes
   * while there's still room in their result buffer.
   */
  while (pSR->spaces_left > 0 && n-- > 0) {
#ifdef DEBUG
    char namebuf[32];
    dprintf((__FILE__, "Found %s\n", debug_name_buf(dp, namebuf)));
#endif
    if (pSR->nt_search == ANY_NAME_TYPE || pSR->nt_search == dp[15]) {
      memcpy(&(pSR->pRes->name), dp, 16);
      pSR->pRes->type = (nametype_t)(dp[15]);
      flg = GetShort(dp + 16);
      pSR->pRes->flags = (flg & NBFLG_GROUP) ? FN_GROUPNAME : 0;
      pSR->spaces_left--;
      pSR->pRes++;
    }
    dp += 18;
  }

  /* Pass 2: any entries left over (either the filter rejected them or the
   * result buffer filled up) get logged but not stored.
   */
  while (n-- > 0) {
    vdebug("Found but ignoring %s\n", debug_name(dp));
    /* cppcheck-suppress unreadVariable */ // final-iteration write is dead but the loop body reads it
    dp += 18;
  }
}

/* ---------------------------- */
#ifdef SMB2_DEBUG_VERBOSE
static void debug_opc(struct NBNS_packet *p) {
  static const char *statuses[16] = {"OK", "FMT_ERR", "SRV_ERR", "NAM_ERR", "IMP_ERR", "RFS_ERR", "ACT_ERR", "CFT_ERR"};
  static const char *opcodes[16] = {"FIND", "1", "2", "3", "4", "REGISTER", "RELEASE", "WACK", "REFRESH", "9", "10"};
  static char flags[256];
  const char *opcode, *status, *reply;

  reply = (p->opcode & OPC_REPLY) ? "Reply" : "Query";
  *flags = '\0';

  if (p->opcode & OPC_AUTHORITY) {
    strcat(flags, "AUTH ");
  }
  if (p->opcode & OPC_TRUNCATED) {
    strcat(flags, "TRUNC ");
  }
  if (p->opcode & OPC_REC_DESIRED) {
    strcat(flags, "REC_DESIRED ");
  }
  if (p->opcode & OPC_REC_AVAIL) {
    strcat(flags, "REC_AVAIL ");
  }
  if (p->opcode & OPC_BROADCAST) {
    strcat(flags, "BROADCAST ");
  }

  opcode = opcodes[(p->opcode & OPC_OPCODE_MASK) >> 11];
  status = (p->opcode & OPC_REPLY) ? statuses[(p->opcode & OPC_STATUS_MASK)] : "";

  dprintf((__FILE__, "* %s ID:&%04x %s %s\n", reply, p->trn_id, opcode ? opcode : "<UNKNOWN>", status ? status : "<UNKNOWN>"));
  dprintf((__FILE__, "n_query: %d, n_answer: %d, n_auth: %d, n_add: %d\n", p->n_query, p->n_answer, p->n_auth, p->n_add));
}
#endif

static void NBNS_ProcessDatagram(struct sockaddr *pFrom, uint8_t *buf, int len) {
  struct NBNS_packet NBP;
  struct NBNS_resource_record NBRR;

#ifdef SMB2_DEBUG_VERBOSE
  {
    struct sockaddr_in *from2 = (struct sockaddr_in *)pFrom;
    vdebug("Datagram from inaddr %s, port %d, len %d\n", inet_ntoa(from2->sin_addr), ntohs(from2->sin_port), len);
  }
#endif

  if (len < 12) { // Too short for header
    return;
  }

  NBP.from = *pFrom;
  NBP.trn_id = GetShort(buf + 0); // Transaction ID
  NBP.opcode = GetShort(buf + 2); // Opcode, status & flags
  NBP.n_query = GetShort(buf + 4);
  NBP.n_answer = GetShort(buf + 6);
  NBP.n_auth = GetShort(buf + 8);
  NBP.n_add = GetShort(buf + 10);

  NBP.buf_start = buf;
  NBP.buf_end = buf + len;
  NBP.record_ptr = buf + 12;

#ifdef SMB2_DEBUG_VERBOSE
  debug_opc(&NBP);
#endif

  if (NBP.opcode & OPC_REPLY) {
    /* Response to one of our questions, either a name registration request, or a name query request */

    if (NBP.n_answer >= 1 && GetNBNSRecord(&NBP, &NBRR, GET_RESOURCE) && NBRR.pName != NULL) {
      if (NBRR.name_tag == INET_NAME_TAG) {
        switch (NBP.opcode & OPC_OPCODE_MASK) {
        case OPC_FIND: // Name find reply
          NameFindReply(&NBP, &NBRR);
          break;

        case OPC_REGISTER: // Name registration reply
          /* If this is a negative reply, & it's a local name, mark it as in-conflict */

          if ((NBP.opcode & OPC_STATUS_MASK) != ST_OK) {
            if (NBRR.pName->status == LCL_AWAIT_ADD || NBRR.pName->status == LCL_NAME_OK) {
              NBRR.pName->status = LCL_IN_CONFLICT;
            }
          }
          break;

        default:
          debug("Unknown reply\n");
          break;
        }
      } else if (NBRR.name_tag == INET_STATUS_TAG) {
        if ((NBP.opcode & OPC_OPCODE_MASK) == OPC_FIND && (NBP.opcode & OPC_STATUS_MASK) == ST_OK) {
          NameStatusReply(&NBP, &NBRR);
        }
      }
    }
  } else {
    /* Request to us from someone else  */

    if (NBP.n_query >= 1 && GetNBNSRecord(&NBP, &NBRR, GET_QUERY) && NBRR.pName != NULL) {
      if (NBRR.name_tag == INET_NAME_TAG) {
        switch (NBP.opcode & OPC_OPCODE_MASK) {
        case OPC_FIND: // Name find request
          NameFindRequest(&NBP, &NBRR);
          break;

        case OPC_REGISTER: // Name registration request
          NameRegisterRequest(&NBP, &NBRR);
          break;

        case OPC_RELEASE: // Name release request
          if (NBRR.pName->status == RMT_CACHED) {
            FreeNameEntry(NBRR.pName);
          }
          break;

        default:
          break;
        }
      }
    }
  }
}

/* Event and callback functions ==================================== */

/* Under RISCOS, background processing is done by having a system event - the Internet event - which gets called every time a
 * socket receives something (amongst other things).
 *
 * This lets us schedule a callback to pick up the data and process it.
 */

extern void EventFn(void); /* Provided by CMHG */
extern void NBIP_CallbackFn(void);

/* EventFn() ------------------------------------------ */

static bool EventsClaimed = false;
static bool CallbackSet = false;

/* ---------------- */

int EventFn_handler(_kernel_swi_regs *R, void *pw) {
  UNUSED(pw);

  if (R->r[0] == Internet_Event && R->r[1] == 1 && // ensure it was the data arrived event!
      R->r[2] == NBNS_Socket && NBNS_Socket != INVALID_SOCKET && !CallbackSet) {
    STAT(STA_IP_EVENTS);
    CallbackSet = true;
    _swix(OS_AddCallBack, _INR(0, 1), NBIP_CallbackFn, LM_pw);
  }

  return 1; // Don't claim, others may wish to know
}

static void RemoveCallbacks(void) {
  _swix(OS_RemoveCallBack, _INR(0, 1), NBIP_CallbackFn, LM_pw);
  CallbackSet = false;
}

/* -------------------------------- */

static int NBIP_CallbackFn_handler(void) {
  fd_set read_set;
  struct timeval tv;
  int len, flen;
  struct sockaddr sa;

  /* Re-arm: clear the "callback scheduled" flag now so that any new datagram
   * arriving mid-loop can schedule a fresh callback rather than being lost.
   */
  CallbackSet = false;

  /* Drain everything pending on the NBNS socket in one shot - a zero-timeout
   * select() lets us spin until the socket reports no more readable data.
   */
  while (NBNS_Socket != INVALID_SOCKET) {
    tv.tv_sec = 0;
    tv.tv_usec = 0;

    FD_ZERO(&read_set);
    FD_SET(NBNS_Socket, &read_set);

    if (select(NBNS_Socket + 1, &read_set, NULL, NULL, &tv) == 0) {
      break;
    }

    flen = sizeof(sa);
    len = recvfrom(NBNS_Socket, DatagramBuf, sizeof(DatagramBuf), 0, &sa, &flen);
    if (len > 0) {
      STAT(STA_IP_RXDGRAM);
      NBNS_ProcessDatagram(&sa, DatagramBuf, len);
    }
  }

  return 1;
}

int NBIP_CallbackFn_handler_ctrl(_kernel_swi_regs *r, void *pw) {
  UNUSED(r);
  UNUSED(pw);
  return NBIP_CallbackFn_handler();
}

/* Exported routines: name service & general =========================== */

/* -------------------- */

/* Find a remote name's table entry, marked RMT_FOUND until the caller sets it to RMT_CACHED; NULL if it cannot be found. */
static NAME_ENTRY *FindRemoteName(NETNAME *pnn) {
  int i;
  uint tstart;
  char plain_name[NAME_LIMIT];
  NAME_ENTRY *pNE;
  struct hostent *pHE;

  vdebug("Find remote name %s\n", debug_name(pnn));

  /* Cache check.  Expire stale entries first so a cached name whose time to
   * live has run out is queried again rather than returned.
   */
  CheckExpiredNames();

  pNE = FindNameEntry(pnn);

  if (pNE != NULL) {
    /* Hit: promote a cached entry to RMT_FOUND so it cannot be expired or
     * evicted while the caller uses it.
     */
    if (pNE->status == RMT_FOUND || pNE->status == RMT_CACHED) {
      pNE->status = RMT_FOUND;
      return pNE;
    }
    return NULL; // Local name - can't be found
  }

  /* No cached entry - allocate a fresh slot and attempt resolution. */

  pNE = AllocNameEntry(RMT_AWAIT_FIND);
  if (pNE == NULL) { // No spaces left
    return NULL;
  }

  pNE->nn = *pnn;        // Copy name
  pNE->pStatResp = NULL; // for safety

  /* Resolution attempts: three broadcast pings followed by one direct query
   * to the name server (if configured).  Each attempt waits up to 0.5s for
   * a reply via the callback handler.
   */
  for (i = 3; i >= 0; i--) {
    if (i > 0) // Send 3 broadcasts
    {
      vdebug("Broadcast find request\n");
      SendFindRequest(NBNS_Broadcast, pNE);
    } else // Ask name server
    {
      SetupNameServer();
      if (NBNS_NameServer == NULL) {
        break;
      }
      vdebug("Send find request to nameserver\n");
      SendFindRequest(NBNS_NameServer, pNE);
    }

    tstart = LM_Tick();
    do {
      usermode_donothing();
      NBIP_CallbackFn_handler();
      if (pNE->status == RMT_FOUND) {
        vdebug("Name found at %X\n", pNE->IPaddress.s_addr);
        return pNE;
      }
    } while ((LM_Tick() - tstart) < 50);
  }

  /* NetBIOS-side resolution failed - try DNS / hosts as a last resort.  We
   * keep the slot allocated and fill in details from the gethostbyname
   * result; the TTL is set to 1 tick so the entry doesn't linger and mask
   * a future NetBIOS-side answer.
   */
  _NB_DecodeName(pnn, plain_name);
  strcpyn_lower(plain_name, plain_name, NAME_LIMIT);

  vdebug("Looking up name in hosts file\n");

#ifdef SMB2_DEBUG_VERBOSE
  {
    uint t0 = LM_Tick();
    pHE = gethostbyname(plain_name);
    vdebug("NBIP: fallback gethostbyname returned %s after %u cs\n", pHE ? "OK" : "NULL", (unsigned)(LM_Tick() - t0));
  }
#else
  pHE = gethostbyname(plain_name);
#endif
  if (pHE != NULL && pHE->h_addr_list != NULL && pHE->h_addr_list[0] != NULL) {
    pNE->status = RMT_FOUND;
    pNE->nbflags = NBFLG_UNIQUE | NBFLG_BNODE; // Don't know - make it up
    pNE->TTL_StartTime = LM_Tick();
    pNE->TTL_Interval = 1; // Doesn't last for long
    pNE->IPaddress = GetIPAddr((uint8_t *)(pHE->h_addr_list[0]));
    vdebug("Name found in hosts at %X\n", pNE->IPaddress.s_addr);
    return pNE;
  }

  /* All resolution methods exhausted - release the slot and signal failure. */
  FreeNameEntry(pNE);
  return NULL;
}

/* ----------------------- */

static NAME_ENTRY *ValidatehName(hNAME hName) {
  NAME_ENTRY *pN = (NAME_ENTRY *)hName;
  if (pN != NULL) {
    vdebug("Status => %d\n", pN->status);
    if ((pN->status == LCL_NAME_OK) || (pN->status == LCL_IN_CONFLICT)) {
      return pN;
    }
  }

  return NULL;
}

/* ----------------- */

/* Register a local name by broadcast and with any name server, failing if another node objects. */
EXPORT err_t _NB_AddLocalName(nametype_t nt, char *name, hNAME *phName) {
  NAME_ENTRY *pNE;
  NETNAME netname;
  int i;
  uint tstart;

  debug("Add name \"%s\"\n", name);

  _NB_FormatName(nt, name, &netname);

  /* Already in the table?  Either we registered it ourselves or someone
   * else's claim is currently cached - either way, refuse the new attempt
   * rather than silently double up.
   */
  pNE = FindNameEntry(&netname);
  if (pNE != NULL) {
    return ENAMEEXISTS;
  }

  pNE = AllocNameEntry(LCL_AWAIT_ADD);
  if (pNE == NULL) {
    return ENOHANDLES;
  }

  /* Populate the new entry with our IP / flags so any incoming objections
   * have somewhere to set LCL_IN_CONFLICT against.
   */
  pNE->IPaddress = NB_IPAddress;
  pNE->nbflags = NBFLG_UNIQUE | NBFLG_BNODE;
  pNE->nn = netname;
  pNE->pStatResp = NULL;

  /* Defence-by-announcement: broadcast three name-register requests and then
   * fall through to the configured name server, waiting up to 0.5s after each
   * for someone to object.  An objection moves the entry to LCL_IN_CONFLICT
   * and the loop gives up; silence by the end of the loop counts as success.
   */
  for (i = 3; i >= 0; i--) {
    if (i > 0) {
      SendRegisterRequest(NBNS_Broadcast, pNE);
    } else {
      SetupNameServer();
      if (NBNS_NameServer == NULL) {
        break;
      }
      SendRegisterRequest(NBNS_NameServer, pNE);
    }

    tstart = LM_Tick();
    do {
      usermode_donothing();
      NBIP_CallbackFn_handler();
      if (pNE->status == LCL_IN_CONFLICT) {
        FreeNameEntry(pNE);
        return ENAMEEXISTS;
      }
    } while ((LM_Tick() - tstart) < 50);
  }

  /* Every announcement window passed without an objection. */
  pNE->status = LCL_NAME_OK;
  *phName = (hNAME)pNE;
  return OK;
}

/* ----------------------- */

/* Announce the release of a local name by broadcast and to any name server, then free its table entry. */
EXPORT err_t _NB_RemoveLocalName(hNAME hName) {
  NAME_ENTRY *pNE;
  int i;
  uint tstart;

  pNE = ValidatehName(hName);
  if (pNE == NULL) {
    return EBADPARAM;
  }

  /* Should vape all connections to this name */

  if (pNE->status != LCL_IN_CONFLICT) {
    for (i = 0; i < 3; i++) {
      SendReleaseRequest(NBNS_Broadcast, pNE);
      tstart = LM_Tick();
      do {
        usermode_donothing();
        NBIP_CallbackFn_handler();
      } while ((LM_Tick() - tstart) < 50);
    }

    /* Tell name server if we have one */
    if (NBNS_NameServer != NULL) {
      SendReleaseRequest(NBNS_NameServer, pNE);
    }
  }

  FreeNameEntry(pNE);
  return OK;
}

/* ----------------------- */

/* Collect the names a node reports in reply to a status query, by broadcast then from any name server; return the count. */
EXPORT int _NB_FindNames(NETNAME *pnnFind, nametype_t ntFind, struct FindName_res *pResults, int results_max, int timeout) {
  NAME_ENTRY *pNE;
  struct status_resp SR;
  uint tstart;

  pNE = AllocNameEntry(RMT_STATUS_Q);
  if (pNE == NULL) {
    return 0;
  }

  vdebug("Find name %s type %Xh\n", debug_name(pnnFind), ntFind);

  /* Wire up the collection state.  NameStatusReply finds it via
   * pNE->pStatResp and fills entries in pResults until spaces_left hits 0.
   */
  SR.nt_search = ntFind;
  SR.pRes = pResults;
  SR.spaces_left = results_max;

  pNE->nn = *pnnFind;
  pNE->pStatResp = &SR;

  /* Try broadcast first - cheapest and the usual success path. */
  SendStatusRequest(NBNS_Broadcast, pNE);

  tstart = LM_Tick();
  do {
    usermode_donothing();
    NBIP_CallbackFn_handler();
  } while (SR.spaces_left > 0 && (LM_Tick() - tstart) < timeout);

  /* Buffer full already?  Skip the name-server round-trip. */
  if (SR.spaces_left == 0) {
    goto search_done;
  }

  /* Still room for more results - ask the configured name server too. */
  SetupNameServer();
  if (NBNS_NameServer == NULL) {
    goto search_done;
  }

  SendStatusRequest(NBNS_NameServer, pNE);

  tstart = LM_Tick();
  do {
    usermode_donothing();
    NBIP_CallbackFn_handler();
  } while (SR.spaces_left > 0 && (LM_Tick() - tstart) < timeout);

search_done:
  FreeNameEntry(pNE);
  return results_max - SR.spaces_left;
}

/* Session service *************************************************** */

typedef struct {
  int status;
  int sid; // Socket ID
  bool LinkOK;
  NAME_ENTRY *lcl_name;
  struct sockaddr_in rmt_addr;
} NBIP_SESSION;

static NBIP_SESSION NB_Sessions[MAX_SESSIONS];

/* ------------------------ */

static NBIP_SESSION *AllocSession(void) {
  int i;
  for (i = 0; i < MAX_SESSIONS; i++) {
    if (NB_Sessions[i].status == SESS_FREE) {
      return &NB_Sessions[i];
    }
  }
  return NULL;
}

/* ------------------------ */

static void FreeSession(NBIP_SESSION *pNS) {
  pNS->status = SESS_FREE;
}

/* ----------------- */

static NBIP_SESSION *ValidatehSession(hSESSION hSess) {
  NBIP_SESSION *pN = (NBIP_SESSION *)hSess;
  if (pN != NULL && pN->status == SESS_CONNECTED) {
    return pN;
  }

  return NULL;
}

/* ------------------- */

/* Read len bytes from a session socket; return false if timeout centiseconds pass with no data, or at once when timeout is 0. */
static bool ReadData(int sid, uint8_t *where, int len, uint timeout, int flags) {
  uint tstart;
  fd_set read_set;
  struct timeval tv;
  int rdlen;

  tstart = LM_Tick();

  /* Pump until len bytes have arrived or the timeout fires.  Each pass first
   * gives the Internet module a chance to run and drains any pending
   * datagrams before testing readability on this socket; this prevents a
   * head-of-line stall when our NBNS socket is also receiving traffic.
   */
  while (len > 0) {
    usermode_donothing();      // Let IP do its thing
    NBIP_CallbackFn_handler(); // Process any datagrams

    tv.tv_sec = 0;
    tv.tv_usec = 0;

    FD_ZERO(&read_set);
    FD_SET(sid, &read_set);
    /* select() nfds is sid+1 rather than FD_SETSIZE so the Internet module does not search the whole fd array for set bits.
     */
    if (select(sid + 1, &read_set, NULL, NULL, &tv) != 0) {
      rdlen = recv(sid, where, len, flags);
      if (rdlen > 0) {
        /* MSG_PEEK callers only want to know data is queued, not to consume it. */
        if (flags & MSG_PEEK) {
          break;
        }
        len -= rdlen;
        where += rdlen;
        tstart = LM_Tick();
        continue;
      }

      /* Readable but nothing read: the peer has closed the connection or the socket has failed, so no data will come. */
      if (rdlen == 0 || (errno != EWOULDBLOCK && errno != EINTR)) {
        return false;
      }
    }

    /* Two timeout regimes: 0 polls once and fails as soon as nothing is waiting, so a peek costs no wait;
     * positive is a deadline relative to tstart, the last arrival.
     */
    if (timeout == 0) {
      return false;
    }
    if (LM_Tick() - tstart > timeout) {
      if (timeout > 0) {
        vdebug("Timeout after %dcs\n", timeout);
      }
      return false;
    }
  }

  return true;
}

