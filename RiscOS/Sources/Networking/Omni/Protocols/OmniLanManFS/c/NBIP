/* Find the remote name and open a session socket to it, making up to 10 attempts while the far end retargets it. */
EXPORT err_t _NB_OpenSession(hNAME hLocalName, NETNAME *pnnFarEnd, hSESSION *phSession) {
  NBIP_SESSION *pNS;
  NAME_ENTRY *lcl_end, *far_end;
  err_t res;
  int retargets = 0;

  /* Check parameters */
  debug("NBIP: OpenSession starting\n");
  vdebug("ValidatehName..\n");
  lcl_end = ValidatehName(hLocalName);
  if (lcl_end == NULL || lcl_end->status != LCL_NAME_OK) {
    /* Local NetBIOS name registration didn't complete - usually because NB_Startup failed earlier (no network
     * interface, or interface isn't named the way NB_Startup expects).  Return ELINKFAILED ("Connection to server
     * failed") rather than EBADPARAM; the underlying problem is the local network stack being unusable, and
     * "Bad parameters" would mislead the user. */
    debug("NBIP: ValidatehName failed - local NetBIOS not initialised\n");
    return ELINKFAILED;
  }

  /* Try to find remote end */
  debug("NBIP: FindRemoteName\n");
#ifdef SMB2_DEBUG_VERBOSE
  {
    uint t0 = LM_Tick();
    far_end = FindRemoteName(pnnFarEnd);
    vdebug("NBIP: FindRemoteName returned %s after %u cs\n", far_end ? "OK" : "NULL", (unsigned)(LM_Tick() - t0));
  }
#else
  far_end = FindRemoteName(pnnFarEnd);
#endif
  if (far_end == NULL) {
    return ECANTFINDNAME;
  }
  debug("NBIP: found server at %08X\n", far_end->IPaddress.s_addr);

  /* Alloc session details */

  pNS = AllocSession();
  if (pNS == NULL) {
    return ENOHANDLES;
  }

  pNS->lcl_name = lcl_end;
#ifndef COMPAT_INET4
  pNS->rmt_addr.sin_len = sizeof(pNS->rmt_addr);
#endif
  pNS->rmt_addr.sin_family = AF_INET;
  pNS->rmt_addr.sin_addr = far_end->IPaddress;
  pNS->rmt_addr.sin_port = htons(NBIP_SESSION_PORT);
  far_end->status = RMT_CACHED; // No longer needed

  /* Create socket for connection, with retries */
  do {
    pNS->sid = socket(PF_INET, SOCK_STREAM, 0);
    if (pNS->sid == INVALID_SOCKET) {
      res = ECREATESOCKET;
      break;
    }
    res = ConnectAttempt(pNS, pnnFarEnd);
    /* May return 'ERETARGET' - this isn't really an error */
    if (res == OK) {
      pNS->status = SESS_CONNECTED;
      pNS->LinkOK = true;
      *phSession = (hSESSION)pNS;
      return OK;
    }
    debug("ConnectAttempt, error %d\n", res);
    socketclose(pNS->sid);
  } while (res == ERETARGET && ++retargets < 10);

  /* Failed - don't even keep the remote name's IP address in cache */
  FreeSession(pNS);
  FreeNameEntry(far_end);
  debug("NB_OpenSession(IP) returning (res=%d)\n", res);
  return res;
}

