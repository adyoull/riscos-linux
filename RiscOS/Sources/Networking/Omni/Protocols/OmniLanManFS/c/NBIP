/* Bind and connect a session socket, then ask the far end for a NetBIOS session. */
static err_t ConnectAttempt(NBIP_SESSION *pNS, NETNAME *pnnFarEnd) {
  struct sockaddr_in sa;
  uint8_t *p;
  uint8_t reply[6]; // Session response header, then a retarget's address and port
  uint len;

  debug("Attempting to connect - addr=%Xh, port %d\n", pNS->rmt_addr.sin_addr.s_addr, ntohs(pNS->rmt_addr.sin_port));

  /* Entered with pNS->sid = a socket descriptor, and pNS->rmt_addr is a starting IP address & port number.
   *
   * This should attempt to bind(), connect(), then establish a session with the far end. Can return ERETARGET with pNS->rmt_addr
   * set to a new address, in which case it will get called again with a new socket
   */

#ifndef COMPAT_INET4
  sa.sin_len = sizeof(sa);
#endif
  sa.sin_family = AF_INET;
  sa.sin_port = 0; // Alloc a port
  sa.sin_addr.s_addr = INADDR_ANY;

  if (bind(pNS->sid, (struct sockaddr *)&sa, sizeof(sa)) != 0) {
    debug("NBIP: bind() failed\n");
    return ECREATESOCKET;
  }

  /* Non-blocking connect with a 5-second select() timer.
   *
   * SO_SNDTIMEO is a send-side option; it does not bound the TCP handshake on the RISC OS BSD stack, so a plain blocking
   * connect() can wait for the full kernel SYN-retransmit sequence (up to ~2 minutes) before failing.  Switch the socket to
   * non-blocking, issue connect(), then use select() as a real timer.
   */
  debug("NBIP: connect() to %08X port %d\n", pNS->rmt_addr.sin_addr.s_addr, ntohs(pNS->rmt_addr.sin_port));
  {
    int nonblock = 1, blocking = 0;
    int rc;
#ifdef SMB2_DEBUG_VERBOSE
    uint t0 = LM_Tick();
#endif

    if (socketioctl(pNS->sid, FIONBIO, (char *)&nonblock) != 0) {
      vdebug("NBIP: FIONBIO on failed\n");
      return ECONNECTSOCKET;
    }

    rc = connect(pNS->sid, (struct sockaddr *)(&pNS->rmt_addr), sizeof(pNS->rmt_addr));
    if (rc != 0 && errno != EINPROGRESS) {
      vdebug("NBIP: connect() immediate error %d\n", errno);
      (void)socketioctl(pNS->sid, FIONBIO, (char *)&blocking);
      return ECONNECTSOCKET;
    }

    if (rc != 0) {
      fd_set wr, ex;
      struct timeval tv;
      int nready;

      FD_ZERO(&wr);
      FD_ZERO(&ex);
      FD_SET(pNS->sid, &wr);
      FD_SET(pNS->sid, &ex);
      tv.tv_sec = 5;
      tv.tv_usec = 0;

      nready = select(pNS->sid + 1, NULL, &wr, &ex, &tv);
      if (nready <= 0) {
#ifdef SMB2_DEBUG_VERBOSE
        vdebug("NBIP: connect() timed out after 5s (select=%d, %u cs)\n", nready, (unsigned)(LM_Tick() - t0));
#endif
        (void)socketioctl(pNS->sid, FIONBIO, (char *)&blocking);
        return ECONNECTSOCKET;
      }

      {
        int err = 0;
        int optlen = sizeof(err);
        if (getsockopt(pNS->sid, SOL_SOCKET, SO_ERROR, (char *)&err, &optlen) != 0 || err != 0) {
          vdebug("NBIP: connect() deferred error %d\n", err);
          (void)socketioctl(pNS->sid, FIONBIO, (char *)&blocking);
          return ECONNECTSOCKET;
        }
      }
    }

    (void)socketioctl(pNS->sid, FIONBIO, (char *)&blocking);
#ifdef SMB2_DEBUG_VERBOSE
    vdebug("NBIP: connect() succeeded after %u cs\n", (unsigned)(LM_Tick() - t0));
#endif
  }
  debug("NBIP: connected, sending session request\n");

  /* OK, we're connected - try a 'session request' */

  p = DatagramBuf;
  *p++ = NBIP_SESS_REQUEST;
  *p++ = 0; /* Flags */
  p += 2;   // Skip length for now
  p = DatagramBuf + 4;
  p = PutNetname(p, pnnFarEnd);            // Called name
  p = PutNetname(p, &(pNS->lcl_name->nn)); // Calling name
  len = p - DatagramBuf;
  PutShort(DatagramBuf + 2, len - 4);

  if (send(pNS->sid, DatagramBuf, len, 0) != len) {
    return ECONNECTSOCKET;
  }
  vdebug("Sent session request: ");

  /* Now get reply, into a buffer of its own: ReadData handles name-service datagrams while it waits, and they arrive in
   * DatagramBuf.
   */
  if (!ReadData(pNS->sid, reply, 4, RECV_TIMEOUT, 0)) {
    return ETIMEOUT;
  }

  switch (reply[0]) {
  case NBIP_SESS_OK: // Well and good
    return OK;

  case NBIP_SESS_REJECT:
    return ECONNREJECT;

  case NBIP_SESS_RETARGET:
    if (!ReadData(pNS->sid, reply, 6, RECV_TIMEOUT, 0)) {
      return EDATALEN;
    }
    pNS->rmt_addr.sin_addr = GetIPAddr(reply);
    pNS->rmt_addr.sin_port = htons(GetShort(reply + 4));
    vdebug("Retargeted to %Xh, port %d\n", pNS->rmt_addr.sin_addr.s_addr, ntohs(pNS->rmt_addr.sin_port));
    return ERETARGET;
  }

  return ECONNECTSOCKET;
}

