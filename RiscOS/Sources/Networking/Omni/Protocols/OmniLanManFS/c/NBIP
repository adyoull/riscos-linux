EXPORT err_t _NB_SendData(hSESSION hS, BUFCHAIN Data) {
  NBIP_SESSION *pNS;
  uint8_t hdr[4];
  int i, len;
  struct GBP_in_out GBP;
  struct iovec iov[IOV_MAX];

  /* NBIP session payloads are 17-bit (per RFC 1002 section 4.3.1) - reject
   * anything that won't fit before we touch the chain.
   */
  len = ChainLen(Data);
  if (len >= 0x20000) {
    FreeChain(Data);
    return EDATALEN;
  }

  pNS = ValidatehSession(hS);
  if (pNS == NULL) {
    FreeChain(Data);
    return EBADPARAM;
  }

  PutLong(hdr, len | (NBIP_SESS_DATA << 24));

  /* Splice the 4-byte session header onto the front of the chain rather than
   * sending it separately.  One extra block per write is far cheaper than
   * the round-trip cost of a stand-alone 4-byte send.
   */
  GBP.pChain = Data = AddChain(Data, hdr, 4);
  if (Data == NULL) {
    return ENOBUFS;
  }

  /* Walk the chain in IOV_MAX-sized groups and feed each batch to writev.
   * The loop terminates when GetBlockPointer's queue drains (i < IOV_MAX
   * means we exhausted the chain before filling the iovec).
   */
  do {
    i = len = 0;
    while (i < IOV_MAX && GetBlockPointer(&GBP)) {
      iov[i].iov_base = (char *)GBP.pBlock;
      iov[i].iov_len = GBP.BlockLen;
      len += GBP.BlockLen;
      i++;
    }

    if (socketwritev(pNS->sid, iov, i) != len) {
      FreeChain(Data);
      pNS->LinkOK = false;
      return ELINKFAILED;
    }
  } while (i == IOV_MAX);

  usermode_donothing();
  FreeChain(Data);
  return OK;
}

/* ----------------------- */

EXPORT err_t _NB_SendBlockData(hSESSION hS, uint8_t *where, uint datalen) {
  NBIP_SESSION *pNS;
  uint8_t hdr[4];
  err_t res;
  struct iovec iov[2];

  /* Send a block over 64 KiB as several session messages of at most 64 KiB
   * each, which keeps within the 17-bit length field of the session header.
   * The only caller, SMB_WriteRaw, sends WRRAW_BLOCK_SIZE blocks, which are
   * smaller, so the split does not happen in practice.
   */
  while (datalen > 0x10000) {
    res = _NB_SendBlockData(hS, where, 0x10000);
    if (res != OK) {
      return res;
    }
    where += 0x10000;
    datalen -= 0x10000;
  }

  pNS = ValidatehSession(hS);
  if (pNS == NULL) {
    return EBADPARAM;
  }

  /* 4-byte session header followed by the data, in one writev so the kernel
   * combines them into a single TCP segment where it can.
   */
  PutLong(hdr, datalen | (NBIP_SESS_DATA << 24));
  iov[0].iov_base = (char *)hdr;
  iov[0].iov_len = 4;
  iov[1].iov_base = (char *)where;
  iov[1].iov_len = datalen;

  if (socketwritev(pNS->sid, iov, 2) != (datalen + 4)) {
    pNS->LinkOK = false;
    return ELINKFAILED;
  }

  usermode_donothing();
  return OK;
}

/* ----------------------- */

/* Report whether session data is already waiting before a request is sent.
 *
 * Despite the name, nothing is read or discarded: the socket is peeked once without waiting.
 *
 * Parameters:
 *   hS  session to check
 *
 * Returns: OK if nothing is waiting; ERXNOTREADY if data is queued; EBADPARAM if hS is not a connected session.
 */
EXPORT err_t _NB_ClearRxQueue(hSESSION hS) {
  NBIP_SESSION *pNS;
  uint8_t buf[4];

  pNS = ValidatehSession(hS);
  if (pNS == NULL) {
    return EBADPARAM;
  }
  if (!ReadData(pNS->sid, buf, 4, 0, MSG_PEEK)) {
    return OK;
  }
  return ERXNOTREADY;
}

/* ----------------------- */

EXPORT err_t _NB_GetData(hSESSION hS, BUFCHAIN *pOutData, int timeout) {
  BUFCHAIN Chain;
  struct GBP_in_out GBP;
  NBIP_SESSION *pNS;
  uint8_t hdr[4];
  uint len;

  vdebug(" Rd");

  pNS = ValidatehSession(hS);
  if (pNS == NULL) {
    return EBADPARAM;
  }

  /* Header retry loop: NBIP keepalive packets are interleaved with data and
   * arrive as 4-byte headers with a non-SESS_DATA type.  Skip past them and
   * wait for the next real header rather than passing junk up the stack.
   */
retry:
  if (!ReadData(pNS->sid, hdr, 4, timeout, 0)) {
    pNS->LinkOK = false;
    return ETIMEOUT;
  }

  len = GetLong(hdr);
  if ((len >> 24) != NBIP_SESS_DATA) {
    vdebug("  Packet header %Xh", len);
    goto retry;
  }

  /* Allocate a fresh chain and read the body into its blocks.  Allowing the
   * chain to dictate block boundaries means GetBlockPointer hands us each
   * destination chunk in turn without an intermediate copy.
   */
  len &= 0x1FFFF; // Max 128K of data
  Chain = AllocBlankChain(len);
  if (Chain == NULL) {
    pNS->LinkOK = false; // The unread body would be taken for the next header, so the session cannot continue
    return ENOBUFS;
  }

  GBP.pChain = Chain;

  while (GetBlockPointer(&GBP)) {
    if (!ReadData(pNS->sid, GBP.pBlock, GBP.BlockLen, timeout, 0)) {
      pNS->LinkOK = false;
      FreeChain(Chain);
      return ETIMEOUT;
    }
  }

  vdebug("=%d\n", len);

  *pOutData = Chain;
  return OK;
}

/* ----------------------- */

/* Read the next session message into a flat buffer, skipping keepalives, and store its length in *len_in_out. */
EXPORT err_t _NB_GetBlockData(hSESSION hS, uint8_t *where, uint *len_in_out, int timeout) {
  NBIP_SESSION *pNS;
  uint8_t hdr[4];
  uint len;

  vdebug(" RdB");

  pNS = ValidatehSession(hS);
  if (pNS == NULL) {
    return EBADPARAM;
  }

  /* Header retry: skip over NBIP keepalives (non-SESS_DATA types) until we
   * find a real data header.  Same pattern as _NB_GetData; this variant
   * reads into a caller-supplied flat buffer rather than a chain.
   */
retry:
  if (!ReadData(pNS->sid, hdr, 4, timeout, 0)) {
    pNS->LinkOK = false;
    return ETIMEOUT;
  }

  len = GetLong(hdr);
  if ((len >> 24) != NBIP_SESS_DATA) {
    vdebug("Packet header %Xh", len);
    goto retry;
  }

  /* Cap len at 128 KiB, then reject anything larger than the buffer the caller supplied (*len_in_out holds
   * that capacity on entry): a server claiming more would overrun `where`, and the stream cannot be resynced,
   * so fail the link rather than trust the header.
   */
  len &= 0x1FFFF;
  if (len > *len_in_out) {
    pNS->LinkOK = false;
    return EDATALEN;
  }
  if (!ReadData(pNS->sid, where, len, timeout, 0)) {
    pNS->LinkOK = false;
    return ETIMEOUT;
  }

  vdebug("=%d\n", len);
  *len_in_out = len;
  return OK;
}

