EXPORT err_t _NB_CloseSession(hSESSION hS) {
  NBIP_SESSION *pNS;

  debug("CloseSession()\n");

  pNS = ValidatehSession(hS);
  if (pNS != NULL) {
    /* Kill the connection, that's it */
    socketclose(pNS->sid);
    FreeSession(pNS);
  }
  return OK;
}

