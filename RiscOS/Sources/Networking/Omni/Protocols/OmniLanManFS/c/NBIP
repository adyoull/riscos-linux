EXPORT char *_NB_DescribeLink(hSESSION hS) {
  static char namebuf[40];
  NBIP_SESSION *pNS = ValidatehSession(hS);
  if (pNS == NULL) {
    return NULL;
  }

  sprintf(namebuf, "%s port %d", inet_ntoa(pNS->rmt_addr.sin_addr), htons(pNS->rmt_addr.sin_port));

  return namebuf;
