/* Convert a packed-binary DOS DD/MM/YY HH:MM:SS to Utime (seconds since 1-Jan-1970).
 *
 * Directory entries returned by the SMB1 'search' command carry timestamps in this packed form; other DOS calls use Utime, so this
 * routine bridges the two.
 *
 * Parameters:
 *   dtime  packed DOS time field (HH:MM:SS in 16 bits)
 *   ddate  packed DOS date field (DD/MM/YY since 1980 in 16 bits)
 *
 * Returns: the equivalent Utime value.
 */
static uint DMYtoUtime(int dtime, int ddate) {
  uint x, dd, mm, yy, hrs, min, sec;

  /* Unpack the DOS bitfields: date carries day (5) / month (4) / year-since-1980 (7);
   * time carries seconds/2 (5) / minutes (6) / hours (5).  The seconds field is doubled
   * because DOS only records even seconds.
   */
  dd = ddate & 31;
  mm = (ddate >> 5) & 15;
  yy = ((ddate >> 9) & 127);

  /* The DOS month is a 4-bit field, so a non-conformant server can encode 0 or 13-15.  Clamp to a valid
   * month before the daycount[] lookup below, which is only sized for indices 1..12, rather than reading
   * past the array on hostile wire data.
   */
  if (mm < 1) {
    mm = 1;
  } else if (mm > 12) {
    mm = 12;
  }
  sec = (dtime & 31) << 1;
  min = (dtime >> 5) & 63;
  hrs = (dtime >> 11) & 31;

  /* Day count since 1-Jan-1970: 3652 days from 1970 to 1980, then 365 * years-since-1980
   * with one extra day per completed 4-year leap cycle.  daycount[] holds the start-of-month
   * day-of-year for a non-leap year; the +1 below corrects March-onwards in the current leap year.
   */
  x = 3652 + (yy * 365) + ((yy + 3) / 4);
  x += daycount[mm] + (dd - 1);
  if (mm >= 3 && ((yy & 3) == 0)) {
    x++;
  }

  return ((x * 24 + hrs) * 60 + min) * 60 + sec;
}

void Xlt_CnvDOStoRO(DOS_ATTRIBS *pDA, RISCOS_ATTRIBS *pRA, int flags, hSHARE hS) {
  uint thi, tlo;

  if (flags & CNV_DATETIME) {
    /* RISC OS timestamp is 5-byte centisecond count since 1900; the 0x336E996A constant is the
     * centisecond offset from 1900 to the Unix epoch, split into hi/lo halves to avoid 32-bit
     * overflow during the multiply-by-100.
     */
    uint tm = pDA->utime + SMB_GetCurrentServerTimeZone(hS);
    thi = 0x336E99 + (tm >> 16) * 100;
    tlo = 0x6A00 + (tm & 0xFFFF) * 100;

    pRA->loadaddr = 0xFFF00000 + ((thi + (tlo >> 16)) >> 16) + (LM_Vars.default_type << 8);
    pRA->execaddr = (thi << 16) + tlo;
  }

  /* Map DOS read-only + dir bits to RISC OS permission flags.  Directories use only the LOCKED bit
   * (RISC OS files lack a separate "directory" permission); files always have read access,
   * write only if the DOS read-only bit is not set.
   */
  if (flags & CNV_ATTRIBS) {
    if (pDA->attr & ATTR_DIR) {
      pRA->flags = (pDA->attr & ATTR_RO) ? ROA_LOCKED : 0;
    } else {
      pRA->flags = (pDA->attr & ATTR_RO) ? ROA_READ | ROA_LOCKED : ROA_READ | ROA_WRITE;
    }
  }
}

void Xlt_CnvROtoDOS(RISCOS_ATTRIBS *pRA, DOS_ATTRIBS *pDA, int flags, hSHARE hS) {
  uint x, res;

  /* Datestamp: only meaningful when the load address actually carries one. */
  if (flags & CNV_DATETIME) {
    if (!IS_FILETYPED(pRA->loadaddr)) {
      /* No filetype stamped in the load address means there's no datestamp either: leave utime
       * zero so the caller knows not to overwrite the server's clock.
       */
      pDA->utime = 0;
    } else {
      /* Reassemble the centisecond count from the load/exec halves, subtract the 1900->1970 offset,
       * then divide by 100 to get seconds.  Clip both ends to the DOS-representable range.
       */
      x = ((pRA->loadaddr & 0xFF) << 24) + (pRA->execaddr >> 8);
      if (x < 0x336E996A) {
        x = 0;
      } else {
        x -= 0x336E996A;
      }
      if (x >= 100 * 0xFFFFFF) {
        x = 100 * 0xFFFFFF;
      }
      res = x / 100;
      x = ((x - res * 100) << 8) + (pRA->execaddr & 0xFF);
      res = (res << 8) + (x / 100);
      pDA->utime = res - SMB_GetCurrentServerTimeZone(hS);
    }
  }

  /* Attributes: only the R/O bit travels to DOS; ATTR_ARC is set unconditionally. */
  if (flags & CNV_ATTRIBS) {
    if ((pRA->flags & ROA_WRITE) == 0 && (pRA->flags & ROA_LOCKED) != 0) {
      pDA->attr = ATTR_ARC | ATTR_RO;
    } else {
      pDA->attr = ATTR_ARC;
    }
  }
}

uint32_t Xlt_NormaliseAttribs(uint32_t flags, bool is_dir, hSHARE hS) {
  DOS_ATTRIBS da;
  RISCOS_ATTRIBS ra;

  da.attr = ATTR_ARC;
  if (is_dir) {
    da.attr |= ATTR_DIR;
  }
  if ((flags & ROA_WRITE) == 0 && (flags & ROA_LOCKED) != 0) {
    da.attr |= ATTR_RO;
  }
  Xlt_CnvDOStoRO(&da, &ra, CNV_ATTRIBS, hS);
  return ra.flags;
}

void Xlt_Jumble(char *str) {
  int i;
  uint key = (uint)str | 0x40000;

  for (i = 0; i < PASSWORD_LIMIT; i++) {
    /* Shift-and-XOR key step: feed back 39 whenever bit 19 is set. */
    key <<= 1;
    if (key & 0x80000) {
      key ^= 39;
    }
    *str -= (key ^ 0x40);
    str++;
  }
}

/* ------------------- */

void Xlt_Unjumble(char *str) {
  int i;
  uint key = (uint)str | 0x40000;

  for (i = 0; i < PASSWORD_LIMIT; i++) {
    key <<= 1;
    if (key & 0x80000) {
      key ^= 39;
    }
    *str += (key ^ 0x40);
    str++;
  }
}

