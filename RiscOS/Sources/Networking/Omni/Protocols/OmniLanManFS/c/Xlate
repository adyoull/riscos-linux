/* The last RISC OS path an SMB2 mount resolved, against the server or a cached listing, and the DOS path it came out as.
 *
 * Programs name the same object in several consecutive calls (read its details, open it, read them again), and each would
 * otherwise search the parent directory afresh; a search also ends any directory listing left open between pages.  Only a
 * path that was found is remembered, never an absence and never any metadata, and Xlt_ForgetTranslation drops it whenever
 * this machine may be about to change a name.  Another machine can still rename the object unseen, so a caller
 * told "not found" for a remembered path forgets it and converts again.
 */
static struct {
  bool valid;
  char ro_path[DOS_NAME_LEN];  // RISC OS path as converted, from the "." that follows "$"
  char dos_path[DOS_NAME_LEN]; // what it resolved to, drive prefix included
} xlt_remembered;

