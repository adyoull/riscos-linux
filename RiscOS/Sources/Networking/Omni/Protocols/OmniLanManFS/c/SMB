/* Connection-path timing helper + macro.  TIMED_CALL(label, res_var, expr) issues `expr`, stores its return into `res_var`,
 * and under SMB2_DEBUG_VERBOSE prints "label returned N after M cs" via vdebug.  In non-verbose builds it collapses to a
 * plain assignment: no SWI call for the timer, no unused locals, no wasted work.  Used to attribute connection-path
 * delays to individual steps (DNS resolution, connect(), negotiate, session setup, etc.) when a user reports a hang.
 */
#ifdef SMB2_DEBUG_VERBOSE
#define TIMED_CALL(label, res_var, expr)                                                    \
  do {                                                                                      \
    uint32_t _tstart = LM_Tick();                                                           \
    (res_var) = (expr);                                                                     \
    vdebug(label " returned %d after %d cs\n", (int)(res_var), (int)(LM_Tick() - _tstart)); \
  } while (0)
#else
#define TIMED_CALL(label, res_var, expr) ((res_var) = (expr))
#endif

