/* The maximum read length is bound by MAX_RX_BLOCK_SIZE which dictates the largest SMB *MESSAGE* we can receive: we need to
 * remove the SMB header and response overheads.
 *
 * SMBHDR is the SMB header and the first byte of the parameter block (pair count). The parameter block has 5 shorts (10 bytes) in
 * it. 2 bytes for the data block length encoding.  3 bytes for the data block header.
 */
#define MAX_RECV_SIZE (MAX_RX_BLOCK_SIZE - SMBHDR_SIZE - 10 - 2 - 3)

/* The bytes an SMBwrite request carries besides its data, laid out as for MAX_RECV_SIZE.  The server's MaxBufferSize
 * bounds the whole message, so this much of it is not available for data.
 */
#define WRITE_OVERHEAD (SMBHDR_SIZE + 10 + 2 + 3)

/* SMBFind_* macros pack and unpack the directory position handed back to FileSwitch in the FSEntry_Func
 * dir_offset register.  SMBFind_SetOffset puts the count of entries delivered so far in both halves.
 * Wipe and Filer_Action decrement dir_offset once for each file they delete during an enumeration, which
 * makes the halves differ; SMBFind_EnumDir then restarts the search and skips entries up to the low half,
 * as it also does when the high half does not match the open search's position.
 */
#define SMBFind_GetOffsetHi(offset)  (((uint32_t)(offset)) >> 16)
#define SMBFind_GetOffsetLow(offset) ((offset)&0xffff)
#define SMBFind_SetOffset(offset)    (((offset) << 16) | ((offset)&0xffff))

