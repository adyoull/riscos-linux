/* Some Microsoft servers not sending them in the documented order */
static void swap_time_date(uint8_t *p) {
  uint8_t swp;

  swp = p[0];
  p[0] = p[2];
  p[2] = swp;

  swp = p[1];
  p[1] = p[3];
  p[3] = swp;
}

/* Query file attributes via TRANSACT2_QUERYPATHINFORMATION (long name path), or from the name cache.
 *
 * Used for name resolution and probing the server's date format.
 *
 * Parameters:
 *   hS        share handle
 *   filename  DOS path including drive letter prefix
 *   pAttr     receives file attributes
 *
 * Returns: OK on success, or an err_t error code
 */
static err_t SMB_GetAttribsX2(hSHARE hS, char *filename, DOS_ATTRIBS *pAttr) {
  err_t res;
  uint8_t *resb;
  static struct TransactParms tp;

  vdebug("SMB_GetAttribs: \"%s\"\n", filename);
  resb = NameCache_Locate(filename);
  if (resb != NULL) {
    Transact_init(&tp, 1 * 2); // need to initialise tp.data_out_buf!!
    memcpy(tp.data_out_buf, resb, 23);
    strcpy((char *)tp.data_out_buf + 23, (char *)resb + 23);
    return Xlt_ExpandSearchEntryX2(tp.data_out_buf, NULL, NULL, pAttr, NULL, hS);
  }

  if (!(hS->hServer->t2flags & T2FLAGS_TESTEDSWAP)) {
    /* Need to test whether we have to swap the date/time fields */
    char fnbuffer[8];
    DOS_ATTRIBS aattrbuf;
    DOS_ATTRIBS sattrbuf;

    hS->hServer->t2flags |= T2FLAGS_TESTEDSWAP;
    fnbuffer[0] = *filename;
    fnbuffer[1] = ':';
    fnbuffer[2] = '\\';
    fnbuffer[3] = '\0';
    debug("Looking up \"%s\" to test buffer format\n", fnbuffer);
    if (SMB_GetAttribsX2(hS, fnbuffer, &aattrbuf) == OK) {
      fnbuffer[3] = '\0';
      Transact_init(&tp, 6 * 2); // will accept 6 uint16_t return params
      Transact_addsetupword(&tp, TRANSACT2_FINDFIRST);
      if (LM_Vars.namemode & NM_HIDDEN) { // findfirst_Attribute
        Transact_addword(&tp, ATTR_DIR | ATTR_SYS | ATTR_HID);
      } else {
        Transact_addword(&tp, ATTR_DIR);
      }
      Transact_addword(&tp, 1);              // findfirst_SearchCount = 1 please
      Transact_addword(&tp, 1);              // findfirst_Flags = auto close after this query
      Transact_addword(&tp, 1);              // Search level = standard level
      Transact_addlong(&tp, 0L);             // reserved, MBZ
      Transact_addstring(&tp, fnbuffer + 2); // findfirst_FileName[]
      debug("Looking for \"%s\"\n", fnbuffer + 2);
      res = SMB_Transact2(hS, &tp);
      if (res == OK) {
        debug("SMB_Transact2 worked\n");
        SMB_TxWords[0] = Transact_getword(tp.parms_out_buf);
        if (Transact_getword(tp.parms_out_buf + 2) == 1) {
          debug("Filename was \"%s\"\n", tp.data_out_buf + 23);
          res = Xlt_ExpandSearchEntryX2(tp.data_out_buf, NULL, NULL, &sattrbuf, NULL, hS);
          if (res == OK) {
            if (sattrbuf.utime != aattrbuf.utime) {
              debug("Might need to swap date/time\n");
              swap_time_date(tp.data_out_buf + 0);
              swap_time_date(tp.data_out_buf + 4);
              swap_time_date(tp.data_out_buf + 8);
              Xlt_ExpandSearchEntryX2(tp.data_out_buf, NULL, NULL, &sattrbuf, NULL, hS);
              if (sattrbuf.utime != aattrbuf.utime) {
                debug("Even after swapping they don't match\n");
              } else {
                hS->hServer->t2flags |= T2FLAGS_SWAPDATETIME;
                debug("Tested and verified!\n");
              }
            } else {
              debug("Don't need to swap date/time!\n");
            }
          }
        }
      } else {
        debug("SMB_Transact2 failed\n");
      }
    }
  }

  Transact_init(&tp, 1 * 2);
  Transact_addsetupword(&tp, TRANSACT2_QUERYPATHINFORMATION);
  Transact_addword(&tp, 1);  // information level
  Transact_addlong(&tp, 0L); // Reserved
  Transact_addstring(&tp, filename + 2);
  res = SMB_Transact2(hS, &tp);
  if (res != OK) {
    return res;
  }
  /* QueryPathInfo returns the time and date fields in the opposite byte order to FindFirst/FindNext on
   * servers that set T2FLAGS_SWAPDATETIME; reverse them in place before Xlt_ExpandSearchEntryX2 sees them.
   */
  if (hS->hServer->t2flags & T2FLAGS_SWAPDATETIME) {
    swap_time_date(tp.data_out_buf);
    swap_time_date(tp.data_out_buf + 4);
    swap_time_date(tp.data_out_buf + 8);
  }
  strcpy((char *)tp.data_out_buf + 23, filename); // Xlt_ExpandSearchEntryX2 relies on this
  return Xlt_ExpandSearchEntryX2(tp.data_out_buf, NULL, NULL, pAttr, NULL, hS);
}

/* --------------------------- */

err_t SMB_GetLinkAttribs(char *filename, DOS_ATTRIBS *pAttr) {
  err_t res;
  hSHARE hS = GetShare(filename, &res);

  if (hS == NULL) {
    return res;
  }

  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    return SMB2_GetLinkAttribs(hS->smb2_share, filename + 2, pAttr);
  }

  /* An SMB1 server follows links itself and offers no way to open one as an object, so there is no link to read. */
  return EFILENOTFOUND;
}

/* --------------------------- */

err_t SMB_GetAttribs(char *filename, DOS_ATTRIBS *pAttr) {
  err_t res;
  BUFCHAIN pB, pBres;
  hSHARE hS;

  hS = GetShare(filename, &res);
  if (hS == NULL) {
    return res;
  }

  /* Modern protocols bypass the legacy SMBsearch path entirely. */
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    return SMB2_GetAttribs(hS->smb2_share, filename + 2, pAttr);
  }

  if (hS->hServer->t2flags & T2FLAGS_LONGNAMES) {
    return SMB_GetAttribsX2(hS, filename, pAttr);
  }

  pB = MkDataBlock(NULL, DATA_VARBLK, NULL, 0, false);
  if (pB != NULL) {
    pB = MkDataString(pB, DATA_ASCII, filename + 2);
  }

  if (pB == NULL) {
    return EOUTOFMEM;
  }

  SMB_TxWords[0] = 1; /* Count of entries to return */
  if (LM_Vars.namemode & NM_HIDDEN) {
    SMB_TxWords[1] = ATTR_DIR | ATTR_SYS | ATTR_HID;
  } else {
    SMB_TxWords[1] = ATTR_DIR; /* Return files & directories info */
  }

  res = Do_SMB(hS, SMBsearch, 2, pB, &pBres);

  if (res == ENOMOREFILES) {
    return EFILENOTFOUND;
  }

  if (res != OK) {
    return res;
  }

  /* Extract all data  */

  res = GetWorkBufData(pBres);
  if (res != OK) {
    return res;
  }

  if (SMB_RxWords[0] < 1) { // No files read
    return EFILENOTFOUND;
  }

  return Xlt_ExpandSearchEntry(SMB_WorkBuf + 3 + SEARCH_ST_SIZE, NULL, NULL, pAttr, NULL, hS);
}

