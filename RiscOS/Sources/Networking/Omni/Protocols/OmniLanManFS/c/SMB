/* Receive and decode the reply to an SMB1 command that has already been sent.
 *
 * Leaves the reply's parameter words in SMB_RxWords and their counts in SMB_RxWordCount and SMB_RxByteCount.  Do_SMB and
 * SMB_Transact2 share it, because a large SMB_Transact2 reply arrives in several packets.  A reply that turns out to answer an
 * earlier SMBchkpth keep-alive (one that arrived after its own wait gave up) has its bytes discarded.
 *
 * Parameters:
 *   hS       share whose session the reply arrives on (must already be validated)
 *   cmd      command byte of the request
 *   ppB_out  receives the reply's data bytes, which the caller must free; NULL discards them
 *
 * Returns: OK on success; the translated server error; EDATALEN for a truncated reply; or a transport error.
 */
static err_t Do_SMBResponse(hSHARE hS, int cmd, BUFCHAIN *ppB_out) {
  int wct_rx;
  err_t res;
  BUFCHAIN pB_rx;

  UNUSED(cmd); // Only the debug traces read it

  /* Get reply */
  res = NB_GetData(hS->hServer->hSession, &pB_rx, REPLY_TIMEOUT);
  if (res != OK) {
    /* A reply that turns up after the wait ends would be taken as the next command's, so drop the session; the next call
     * reconnects.
     */
    if (res == ETIMEOUT) {
      MarkServerDead(hS->hServer, "SMB1 reply timeout");
    }
    return res;
  }

  /* Extract received data */
  dprintf(("smb_2", "Do_SMB (cmd=0x%x) - NB_GetData => %d bytes\n", cmd, ChainLen(pB_rx)));

  SMB_RxHdr.wct = 0;
  SMB_RxByteCount = 0;
  SMB_RxWordCount = 0;

  pB_rx = GetData(pB_rx, &SMB_RxHdr, SMBHDR_SIZE);
  wct_rx = SMB_RxHdr.wct;

  /* Process errors back from server (must run before any wct_rx parsing below). */
  if (SMB_RxHdr.errclass != 0) {
    dprintf(("", "Do_SMB: errclass was %d\n", SMB_RxHdr.errclass));
    FreeChain(pB_rx);
    return Err_Translate(SMB_RxHdr.errclass, SMB_RxHdr.errlo + (SMB_RxHdr.errhi << 8));
  }

  if (wct_rx > MAX_WCT) // Dispose of extra word results
  {
    pB_rx = GetData(pB_rx, SMB_RxWords, MAX_WCT * 2);
    pB_rx = GetData(pB_rx, NULL, (wct_rx - MAX_WCT) * 2);
  } else if (wct_rx > 0) {
    pB_rx = GetData(pB_rx, SMB_RxWords, wct_rx * 2);
  }

  pB_rx = GetData(pB_rx, &SMB_RxByteCount, 2); // Get byte count

  if (pB_rx == NULL) { // It's all gone horribly wrong!
    return EDATALEN;
  }

  /* OK - all was well */
#ifdef DEBUG
  if (cmd == SMBnegprot) {
    debug("Protocol negotiation returned %d words and %d bytes\n", wct_rx, SMB_RxByteCount);
  }
#endif

  if (SMB_RxHdr.command == SMBchkpth) {
    /* Discard the 'ping' response */
    dprintf(("smb_1", "This response was actually to the previous chkpth call\n"));
    ppB_out = NULL;
  }

  SMB_RxWordCount = wct_rx;

  if (ppB_out != NULL) {
    *ppB_out = pB_rx; /* Hand over ownership */
  } else {
    FreeChain(pB_rx);
  }
  return OK;
}

/* Send an SMB1 command and receive the response.
 *
 * Blocks until the server responds or the connection fails.
 *
 * Parameters:
 *   hS       share handle
 *   cmd      SMB command code
 *   wct_in   number of parameter words
 *   pB_in    request data chain (freed on return)
 *   ppB_out  receives response data chain, or NULL if not needed
 *
 * Returns: OK on success, or an err_t error code
 */
static err_t Do_SMB_threadsafe(hSHARE hS, int cmd, int wct_in, BUFCHAIN pB_in, BUFCHAIN *ppB_out) {
  err_t res;
  hSESSION hSess;

  (void)time(&hS->hServer->last_xact);

  if (ppB_out != NULL) { // If early exit, leave NULL in result
    *ppB_out = NULL;
  }

  hSess = hS->hServer->hSession;

  /* Fill in parameters for this connection */

  SMB_TxHdr.tid = hS->Tid;
  SMB_TxHdr.uid = hS->hServer->Uid;
  SMB_TxHdr.flg = hS->hServer->SMB_flg;
  SMB_TxHdr.flg2 = hS->hServer->SMB_flg2;

  /* Add byte count */

  SMB_TxWords[wct_in] = ChainLen(pB_in);

  /* Add parameter words */

  pB_in = AddChain(pB_in, SMB_TxWords, (wct_in * 2) + 2);
  if (pB_in == NULL) {
    return EOUTOFMEM;
  }

  /* Prepare & add header */

  SMB_TxHdr.command = cmd;
  SMB_TxHdr.wct = wct_in;

  pB_in = AddChain(pB_in, &SMB_TxHdr, SMBHDR_SIZE);
  if (pB_in == NULL) {
    return EOUTOFMEM;
  }

  /* Send data */

  res = NB_ClearRxQueue(hSess);
  if (res != OK) {
    debug("****************** NB_ClearRxQueue says there was stuff pending!!!!!!!!\n");
  }

  res = NB_SendData(hSess, pB_in);
  if (res != OK) {
    return res;
  }

  /* Skip any late keep-alive reply queued ahead of this command's own; a keep-alive takes the first reply. */
  do {
    /* MUST avoid recursive calls to Do_SMBResponse */
    res = Do_SMBResponse(hS, cmd, ppB_out);
  } while (res == OK && cmd != SMBchkpth && SMB_RxHdr.command == SMBchkpth);

  return res;
}

/* Send an SMB1 command and receive the response.
 *
 * Wrapper around Do_SMB_threadsafe that refuses re-entrant calls.
 */
static err_t Do_SMB(hSHARE hS, int cmd, int wct_in, BUFCHAIN pB_in, BUFCHAIN *ppB_out) {
  static volatile int threaded = 0;

  if (threaded) {
    return ELANMANFSINUSE;
  } else {
    err_t res;
    ++threaded;
    res = Do_SMB_threadsafe(hS, cmd, wct_in, pB_in, ppB_out);
    --threaded;
    return res;
  }
}

/* Copy a reply's data block into SMB_WorkBuf and free the chain.
 *
 * SMB_RxByteCount comes from the wire and can exceed SMB_WorkBuf, so a larger reply is refused rather than copied.
 *
 * Parameters:
 *   pBres  reply data chain from Do_SMB (freed on return)
 *
 * Returns: OK, or EDATALEN if the byte count is larger than SMB_WorkBuf.
 */
static err_t GetWorkBufData(BUFCHAIN pBres) {
  if (SMB_RxByteCount > SMBWORKBUF_SIZE) {
    FreeChain(pBres);
    return EDATALEN;
  }

  FreeChain(GetData(pBres, SMB_WorkBuf, SMB_RxByteCount));
  return OK;
}

