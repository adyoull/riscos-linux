/* Read up to RDRAW_BLOCK_SIZE bytes from a file with SMBreadBraw.
 *
 * If there are any errors, or we're at end of file, it returns 0. Assume 'hS' etc. has been validated.
 */
static uint SMB_ReadRaw(hSHARE hS, int fid, uint offset, uint len, uint8_t *where) {
  err_t res;
  BUFCHAIN pB;
  hSESSION hSess = hS->hServer->hSession;

  /* A raw read is traffic on the session, so a stream of them does not count as idle for the keep-alive. */
  (void)time(&hS->hServer->last_xact);

  /* The reply has no SMB framing, so anything still queued from an earlier exchange (a keep-alive reply that
   * arrived late, say) would be read as the raw block.  Read and discard it first.
   */
  while (NB_ClearRxQueue(hSess) == ERXNOTREADY) {
    res = NB_GetData(hSess, &pB, REPLY_TIMEOUT);
    if (res != OK) {
      debug("SMB_ReadRaw: discarding a queued reply failed, %d\n", res);
      return 0;
    }
    FreeChain(pB);
  }

  /* SMBreadBraw response is a single raw block, no SMB header.  RDRAW_BLOCK_SIZE caps how much the
   * server is allowed to send back in one go.
   */
  if (len > RDRAW_BLOCK_SIZE) {
    len = RDRAW_BLOCK_SIZE;
  }

  /* SMBreadBraw parameter words: FID, 32-bit offset split into halves, requested length, min count = 0
   * (return whatever is available), 32-bit timeout = 0xFFFFFFFF (wait indefinitely), reserved, no
   * trailing data block.
   */
  SMB_TxWords[0] = fid;
  SMB_TxWords[1] = (offset & 0xFFFF);
  SMB_TxWords[2] = (offset >> 16);
  SMB_TxWords[3] = len;
  SMB_TxWords[4] = 0;

  SMB_TxWords[5] = 0xFFFF;
  SMB_TxWords[6] = 0xFFFF;

  SMB_TxWords[7] = 0;
  SMB_TxWords[8] = 0;

  pB = AddChain(NULL, SMB_TxWords, 18);
  if (pB == NULL) {
    return 0;
  }

  /* This path bypasses Do_SMB and builds the header by hand because the reply has no SMB framing: we
   * need to receive a raw block instead of routing through the normal parser.
   */
  SMB_TxHdr.tid = hS->Tid;
  SMB_TxHdr.uid = hS->hServer->Uid;

  SMB_TxHdr.command = SMBreadBraw;
  SMB_TxHdr.wct = 8;

  pB = AddChain(pB, &SMB_TxHdr, SMBHDR_SIZE);
  if (pB == NULL) {
    return 0;
  }

  res = NB_SendData(hSess, pB);
  if (res != OK) {
    debug("Send data failed, %d\n", res);
    return 0;
  }

  /* The reply is the raw payload itself; len is updated in-place to the actual byte count received. */
  res = NB_GetBlockData(hSess, where, &len, REPLY_TIMEOUT);
  if (res != OK) {
    /* The caller falls back to framed reads, which would take a late raw block for their reply, so drop the session. */
    if (res == ETIMEOUT) {
      MarkServerDead(hS->hServer, "SMB1 raw read timeout");
    }
    return 0;
  }

  return len;
}

/* ---------------------------- */

static err_t SMB_WriteRaw(hSHARE hS, int fid, uint offset, uint len, uint8_t *where) {
  err_t res;

  /* SMBwriteBraw is a two-step exchange: the parameter request advertises the byte count and offset,
   * then the data block is sent unframed straight after the OK reply.  Words: FID, total length,
   * reserved-MBZ, 32-bit offset (split), 32-bit infinite timeout, write mode 0 (no write-through), a
   * 32-bit reserved-MBZ field, then immediate-bytes count / offset = 0 (we're sending zero immediate
   * bytes; the whole payload follows via NB_SendBlockData).
   */
  SMB_TxWords[0] = fid;
  SMB_TxWords[1] = len;
  SMB_TxWords[2] = 0;
  SMB_TxWords[3] = (offset & 0xFFFF);
  SMB_TxWords[4] = (offset >> 16);
  SMB_TxWords[5] = 0xFFFF;
  SMB_TxWords[6] = 0xFFFF;

  SMB_TxWords[7] = 0;
  SMB_TxWords[8] = 0;
  SMB_TxWords[9] = 0;
  SMB_TxWords[10] = 0;
  SMB_TxWords[11] = 0;

  res = Do_SMB(hS, SMBwriteBraw, 12, NULL, NULL);
  if (res != OK) {
    return res;
  }

  /* Server accepted the setup; push the bulk payload as one raw NetBIOS block.  Any failure here
   * surfaces on the next conventional write or close (the server returns an error in its final write
   * complete response).
   */
  return NB_SendBlockData(hS->hServer->hSession, where, len);
}

/* Dialect strings sent during SMB1 NEGOTIATE.
 *
 * The server returns the index of the dialect it supports.  We offer LAN Manager 1.2 (for old NAS devices) and NT LM 0.12 (CIFS,
 * used by everything from Windows NT onwards).
 */
static const char *dialects[] = {"LM1.2X002", "NT LM 0.12"};
#define MAX_DIALECT        ((sizeof(dialects) / sizeof(*dialects)) - 1)
#define DIALECT_NT         1
#define LM12_NEGPROT_WORDS 13 // words in an LM1.2X002 NEGOTIATE response
#define NT_NEGPROT_WORDS   17 // words in an NT LM 0.12 NEGOTIATE response
/* Return the name of the negotiated SMB1 dialect by index. */
static const char *SMB_Dialect(unsigned int num) {
  if (num <= MAX_DIALECT) {
    return dialects[num];
  }
  return "";
}

/* ---------------------------- */

static err_t SMB_Negotiate(hSHARE hS) {
  err_t res;
  unsigned int dcount;
  BUFCHAIN pB;

  pB = NULL;

  /* Must be entered in reverse order */
  for (dcount = MAX_DIALECT;; --dcount) {
    pB = MkDataString(pB, DATA_DIALECT, SMB_Dialect(dcount));
    if (pB == NULL || dcount == 0) {
      break;
    }
  }

  if (pB == NULL) {
    return EOUTOFMEM;
  }

  res = Do_SMB(hS, SMBnegprot, 0, pB, &pB);
  if (res != OK) {
    return res;
  }

  /* A server that accepts none of our dialects answers 0xFFFF and nothing more.  Refuse that, or any reply too short for its
   * format, rather than read words left over from an earlier response.
   */
  if (SMB_RxWords[0] > MAX_DIALECT || SMB_RxWordCount < (SMB_RxWords[0] == DIALECT_NT ? NT_NEGPROT_WORDS : LM12_NEGPROT_WORDS)) {
    FreeChain(pB);
    return EPROTOCOLERR;
  }

  debug("Negotiated protocol \"%s\"\n", SMB_Dialect(SMB_RxWords[0]));
  if ((SMB_RxWords[1] & 1) == 0) {
    debug("Server reports share-level security; logging on at user level anyway\n");
  }

  hS->hServer->prot = SMB_RxWords[0];
  if (SMB_RxWords[0] >= DIALECT_NT) {
    /* NT LM 0.12 response format */
    hS->hServer->maxTxBufferSize = (SMB_RxWords[3] >> 8) | (SMB_RxWords[4] << 8) | (SMB_RxWords[5] << 24);
    hS->hServer->ProtFlags = PROT_RWMULTI + PROT_SETDATETIME + (SMB_RxWords[9] & 0x100 ? PROT_READRAW + PROT_WRITERAW : 0) +
                             (SMB_RxWords[1] & 2 ? PROT_ENCRYPT : 0);
    if (SMB_RxWords[11] & 0x80) {
      /* CAP_EXTENDED_SECURITY */
      hS->hServer->ProtFlags |= PROT_HAVE_GUID;
      pB = GetData(pB, hS->hServer->guid, 16);
      debug("Found a GUID block in the data section\n");
    } else {
      debug("No extended security - no GUID in the data block\n");
    }
    hS->hServer->bloblen = SMB_RxWords[16] >> 8;
    hS->hServer->Sesskey = (SMB_RxWords[7] >> 8) | (SMB_RxWords[8] << 8) | (SMB_RxWords[9] << 24);
    hS->hServer->serverTimeZone = (short)((SMB_RxWords[15] >> 8) | (SMB_RxWords[16] << 8));
    hS->hServer->serverTimeZone *= 60; // Convert to seconds
  } else {
    /* LM1.2X002 response format */
    hS->hServer->serverTimeZone = (short)SMB_RxWords[10];
    hS->hServer->serverTimeZone *= 60; // Convert to seconds
    hS->hServer->maxTxBufferSize = SMB_RxWords[2];
    hS->hServer->ProtFlags = PROT_RWMULTI + PROT_SETDATETIME + (SMB_RxWords[1] & 2 ? PROT_ENCRYPT : 0) +
                             (SMB_RxWords[5] & 1 ? PROT_READRAW : 0) + (SMB_RxWords[5] & 2 ? PROT_WRITERAW : 0);
    hS->hServer->bloblen = SMB_RxWords[11];
    hS->hServer->Sesskey = SMB_RxWords[6] | (SMB_RxWords[7] << 16);
  }
  hS->hServer->SMB_flg = SMB_CASELESS;
  debug("Enabling long filenames on this share\n");
  hS->hServer->SMB_flg2 = SMB_KNOWS_LONG_NAMES; /* | SMB_IS_LONG_NAME;*/
  hS->hServer->t2flags = T2FLAGS_LONGNAMES;

  /* Keep the challenge for SMB_SessSetup, dropping any left from an earlier connection.  A reply too short to hold the
   * challenge it announces is treated as having none.
   */
  free(hS->hServer->blob);
  hS->hServer->blob = NULL;
  if (hS->hServer->bloblen > 0 && ChainLen(pB) >= hS->hServer->bloblen) {
    hS->hServer->blob = malloc(hS->hServer->bloblen);
    if (hS->hServer->blob == NULL) {
      FreeChain(pB);
      return EOUTOFMEM;
    }
    pB = GetData(pB, hS->hServer->blob, hS->hServer->bloblen);
  } else {
    hS->hServer->bloblen = 0;
  }
  if (pB != NULL) {
    FreeChain(pB);
  }

  /* Without extended security, an encrypted logon answers an 8-byte challenge. */
  if (hS->hServer->prot >= DIALECT_NT && (hS->hServer->ProtFlags & (PROT_ENCRYPT | PROT_HAVE_GUID)) == PROT_ENCRYPT &&
      hS->hServer->bloblen < 8) {
    return EPROTOCOLERR;
  }

  debug("User-level security\n");
  return OK;
}

/* ------------------------------- */

/* Log the user on to the server with a given name and password. */
static err_t SMB_SessSetup(hSHARE hS, char *userid, char *passwd) {
  BUFCHAIN pB;
  err_t res;

  SMB_TxWords[0] = 0x00FF;            // No additional command
  SMB_TxWords[1] = 0;                 // Offset to next cmd
  SMB_TxWords[2] = MAX_RX_BLOCK_SIZE; // Maximum SMB message size we can receive
  SMB_TxWords[3] = 1;                 // Max pending requests
  SMB_TxWords[4] = 0;                 // First & only VC
  SMB_TxWords[5] = hS->hServer->Sesskey & 0xFFFF;
  SMB_TxWords[6] = hS->hServer->Sesskey >> 16;

  if (hS->hServer->prot < DIALECT_NT) {
    /* LANMAN servers taking a plaintext LM1.2X002 logon expect the username in upper case, so only this path sends an
     * upper-case copy; the LMv2 path below and SMB2 send the case as typed, which case-sensitive servers need.
     */
    char uc_userid[USERNAME_LIMIT];
    strcpyn_upper(uc_userid, userid, USERNAME_LIMIT);

    pB = AddChain(NULL, uc_userid, strlen(uc_userid) + 1);
    if (pB != NULL) {
      pB = AddChain(pB, passwd, strlen(passwd) + 1);
    }
    if (pB == NULL) {
      return EOUTOFMEM;
    }

    SMB_TxWords[7] = strlen(passwd) + 1;
    SMB_TxWords[8] = 0;
    SMB_TxWords[9] = 0;

    res = Do_SMB(hS, SMBsesssetup, 10, pB, NULL);
  } else if (hS->hServer->ProtFlags & PROT_HAVE_GUID) {
    /* CAP_EXTENDED_SECURITY is supported by the server - setup session accordingly */
    SMB_TxWords[7] = hS->hServer->bloblen;
    SMB_TxWords[8] = SMB_TxWords[9] = 0;   // Reserved
    SMB_TxWords[10] = SMB_TxWords[11] = 0; // Client capabilities
    pB = AddChain(NULL, "CIFS", sizeof("CIFS"));
    if (pB) {
      pB = AddChain(pB, "RISCOS", sizeof("RISCOS"));
    }
    if (pB) {
      pB = AddChain(pB, hS->hServer->blob, hS->hServer->bloblen);
    }
    if (pB == NULL) {
      return EOUTOFMEM;
    }
    res = Do_SMB(hS, SMBsesssetup, 12, pB, NULL);
  } else {
    /* Server does not support extended security */
    if (hS->hServer->ProtFlags & PROT_ENCRYPT) {
      unsigned char lmowfv2digest[16];
      unsigned char challengeResponse[24];

      if (strlen(passwd) != 0) {
        Auth_LMOWFv2((const char *)passwd, strlen(passwd), (const char *)userid, strlen(userid), (const char *)userid, 0, // no domain
                     lmowfv2digest);
        Auth_LMv2ChallengeResponse(lmowfv2digest, (void *)hS->hServer->blob, challengeResponse);
        SMB_TxWords[7] = sizeof(challengeResponse);
      } else {
        SMB_TxWords[7] = 0;
      }
      SMB_TxWords[8] = 0;
      SMB_TxWords[9] = SMB_TxWords[10] = 0;  // Reserved
      SMB_TxWords[11] = SMB_TxWords[12] = 0; // client capabilities
      pB = AddChain(NULL, "CIFS", sizeof("CIFS"));
      if (pB) {
        pB = AddChain(pB, "\0RISCOS", sizeof("\0RISCOS"));
      }
      if (pB) {
        pB = AddChain(pB, userid, strlen(userid) + 1);
      }
      if (pB && (SMB_TxWords[7] != 0)) {
        pB = AddChain(pB, challengeResponse, sizeof(challengeResponse));
      }
      if (pB == NULL) {
        return EOUTOFMEM;
      }
    } else {
      SMB_TxWords[7] = strlen(passwd);
      SMB_TxWords[8] = 0;
      SMB_TxWords[9] = SMB_TxWords[10] = 0;  // Reserved
      SMB_TxWords[11] = SMB_TxWords[12] = 0; // client capabilities
      pB = AddChain(NULL, "CIFS", sizeof("CIFS"));
      if (pB) {
        pB = AddChain(pB, "\0RISCOS", sizeof("\0RISCOS"));
      }
      if (pB) {
        pB = AddChain(pB, userid, strlen(userid) + 1);
      }
      if (pB) {
        pB = AddChain(pB, passwd, strlen(passwd));
      }
      if (pB == NULL) {
        return EOUTOFMEM;
      }
    }
    res = Do_SMB(hS, SMBsesssetup, 13, pB, NULL);
  }
  if (res != OK) {
    return res;
  }

  hS->hServer->Uid = SMB_RxHdr.uid;

  return OK;
}

/* ---------------------------- */

/* Keep in step with #defines in H.SMB ! */

static char *sharetype_str[4] = {"A:", "LPT1:", "COMM", "IPC"};

/* Tree-connect the share named in hS, whose server must already be connected. */
static err_t ConnectShare(hSHARE hS) {
  BUFCHAIN pB;
  err_t res;

  /* Mild sanity check */

  if (hS == NULL || hS->hServer == NULL || hS->sharetype < 0 || hS->sharetype > 3) {
    return EBADPARAM;
  }

  debug("Connect share %c to \"\\\\%s\\%s\"\n", hS->drvletter, hS->hServer->servname, hS->sharename);

  /* SMB2 path: use SMB2_TreeConnect */
  if (hS->hServer->protocol_version == 2 && hS->hServer->smb2_srv != NULL) {
    SMB2_Share *share2 = NULL;

    res = SMB2_TreeConnect(hS->hServer->smb2_srv, hS->sharename, hS->sharetype, &share2);
    if (res == OK) {
      hS->smb2_share = share2;
      share2->drvletter = hS->drvletter;
      hS->flags |= CONNECTED;

      /* Re-bind the cache to the new SMB2_Share.  After a DisconnectServer-driven reconnect the old
       * SMB2_Share slot has been freed (and may have been reused by another mount), so the cache's
       * wire.ctx must be rebound to share2.  Without this, the next enum on this share runs through the
       * cache against whatever now occupies the old slot.
       */
      if (hS->cache != NULL) {
        SMB2_InstallCacheWire(hS->cache, share2);
      }

      /* Arm a recursive CHANGE_NOTIFY on the share root, so that changes the server reports raise a Filer
       * refresh.  Only disk shares are watched, because IPC$ and printer shares can't be.
       */
      if (share2->share_type == SMB2_SHARE_TYPE_DISK) {
        SMB2_ChangeNotify(share2);

        /* Setting up the watch can find the connection dead, which frees the share, so report the link failure. */
        if (hS->smb2_share == NULL) {
          return ELINKFAILED;
        }
      }
    }
    return res;
  }

  /* SMB1 path */
  pB = MkDataString(NULL, DATA_ASCII, sharetype_str[hS->sharetype]);

  if (pB == NULL) {
    return EOUTOFMEM;
  }

  /* Authentication is always user-level (session setup handles credentials), so tree connect sends an empty password. */
  pB = MkDataString(pB, DATA_ASCII, "");

  if (pB == NULL) {
    return EOUTOFMEM;
  }

  /* Path name is of the form \\SERVER\SHARENAME */

  sprintf((char *)SMB_WorkBuf, "\\\\%s\\%s", hS->hServer->servname, hS->sharename);
  pB = MkDataString(pB, DATA_ASCII, (char *)SMB_WorkBuf);

  if (pB == NULL) {
    return EOUTOFMEM;
  }

  /* Do connection */

  res = Do_SMB(hS, SMBtcon, 0, pB, NULL);

  if (res == OK) {
    hS->Tid = SMB_RxWords[1];
    hS->flags |= CONNECTED;
  }

  return res;
}

/* ----------------------------- */

/* Tree-disconnect a share, marking it disconnected first. */
static err_t DisconnectShare(hSHARE hS) {
  if (hS == NULL) { // Shouldn't happen, but make sure
    return EBADPARAM;
  }

  debug("Disconnect share %c from \"\\\\%s\\%s\"\n", hS->drvletter, hS->hServer->servname, hS->sharename);

  /* Say connection has been broken; if the operation fails it's probably been broken already */

  hS->flags &= ~CONNECTED;

  /* Dead server: its transport is already closed, so there is nothing to send the disconnect on.  The server drops the tree
   * with the connection.
   */
  if (hS->hServer->dead) {
    debug("DisconnectShare: server dead, skipping wire TREE_DISCONNECT\n");
    return OK;
  }

  /* Dispatch by protocol: SMB2 has its own TREE_DISCONNECT wire format.  Without this the server-side tree handle would
   * leak - Do_SMB below builds an SMB1 frame, which the server would reject or ignore on an SMB2 connection.
   */
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    err_t res = SMB2_TreeDisconnect(hS->smb2_share);

    hS->smb2_share = NULL; // The share slot is freed, and another mount may claim it
    SMB2_InstallCacheWire(hS->cache, NULL);
    return res;
  }

  /* SMB1 tree disconnect */
  return Do_SMB(hS, SMBtdis, 0, NULL, NULL);
}

/* ------------------------------ */

/*
 * Open a session to hS's server, negotiate and log on, trying SMB2 on port 445 before SMB1 on port 139.
 *
 * SMB2 finds the server by DNS, then by a NetBIOS name query when the name fits NetBIOS.  A server that refuses the logon over SMB2
 * is not asked again over SMB1, and a name too long for NetBIOS is never tried there.  When SMB1 cannot open a session either, the
 * SMB2 error is the one reported, because it describes the transport failure more exactly.  An SMB2 connection records the server's
 * address so the background probe can reconnect it once it has been marked dead, and a connection over either protocol clears the
 * dead flag.  It takes an hSHARE rather than an hSERVER because the SMB1 negotiate and session setup it calls take one.
 *
 * Parameters:
 *   hS  share whose server is to be connected; hS->hServer must hold the server name, user name and password
 *
 * Returns: OK, EBADPARAM for a share with no server, or the error from the connection, negotiate or logon.
 */
static err_t ConnectServer(hSHARE hS) {
  NETNAME nnserver;
  hSERVER hSrv;
  err_t res;
  err_t smb2_err = OK;

  if (hS == NULL || (hSrv = hS->hServer, hSrv == NULL)) {
    return EBADPARAM;
  }

  debug("Connect server \"%s\"\n", hSrv->servname);

  /* Set initial values */

  hSrv->ProtFlags = 0;
  hSrv->SMB_flg = 0;
  hSrv->Uid = 0;
  hSrv->Sesskey = 0;
  hSrv->hSession = NULL;
  hSrv->protocol_version = 0;
  hSrv->smb2_srv = NULL;

  /* Try SMB2 on port 445 first, resolving the name by DNS and then by a NetBIOS broadcast query (which can return the wrong
   * address for a server with several adapters).  If SMB2 fails the connection is torn down and SMB1 on port 139 is tried, unless
   * the server refused the logon or the name is too long for NetBIOS.  Each connect() is non-blocking and timed by select(), so
   * that unreachable servers fail fast.
   */
  {
    SMB2_Server *srv2;
    int sock;

    /* Step 1: Try SMB2 via DNS name resolution */
    debug("ConnectServer: trying SMB2 (DNS) for \"%s\"\n", hSrv->servname);
    TIMED_CALL("ConnectServer: SMB2X_Connect", res, SMB2X_Connect(hSrv->servname, &sock));

    /* Step 2: If DNS failed, resolve via NetBIOS then try port 445 */
    if (res == ECANTFINDNAME && strlen(hSrv->servname) <= NETBIOS_NAME_MAX) {
      unsigned long resolved_ip;
      debug("ConnectServer: DNS failed, trying NetBIOS for \"%s\"\n", hSrv->servname);
      TIMED_CALL("ConnectServer: NBIP_ResolveServerName", res, NBIP_ResolveServerName(hSrv->servname, &resolved_ip));
      if (res == OK) {
        TIMED_CALL("ConnectServer: SMB2X_ConnectAddr", res, SMB2X_ConnectAddr(resolved_ip, &sock));
      }
    }

    /* Step 3: If we have a port 445 connection, try SMB2 negotiate */
    if (res == OK) {
      srv2 = smb2_alloc_server();
      if (srv2 != NULL) {
        srv2->raw_socket = sock;
        strcpy(srv2->servname, hSrv->servname);

        TIMED_CALL("ConnectServer: SMB2_Negotiate", res, SMB2_Negotiate(srv2));
        if (res == OK) {
          Xlt_Unjumble(hSrv->password);
          TIMED_CALL("ConnectServer: SMB2_SessionSetup", res, SMB2_SessionSetup(srv2, hSrv->username, hSrv->password, ""));
          Xlt_Jumble(hSrv->password);

          if (res == OK) {
            unsigned long ip;
            debug("ConnectServer: SMB2 connection to \"%s\" succeeded\n", hSrv->servname);
            hSrv->protocol_version = 2;
            hSrv->smb2_srv = srv2;
            hSrv->ProtFlags = 0;
            hSrv->serverTimeZone = 0; // SMB2 timestamps are UTC
            hSrv->dead = false;
            /* Stash the peer IP so the dead-mount recovery probe can reconnect via SMB2X_ConnectAddrTimed
             * without paying DNS / NetBIOS resolution on every probe.  Try inet_addr first (servname is a dotted
             * quad), fall back to gethostbyname (servname is a hostname).  Failure is benign: cached_ip
             * stays 0 and the recovery probe stays inert.
             */
            ip = (unsigned long)inet_addr(hSrv->servname);
            if (ip != (unsigned long)INADDR_NONE) {
              hSrv->cached_ip = ip;
            } else {
              struct hostent *hp = gethostbyname(hSrv->servname);
              if (hp != NULL && hp->h_addr_list != NULL && hp->h_addr_list[0] != NULL) {
                memcpy(&hSrv->cached_ip, hp->h_addr_list[0], sizeof(hSrv->cached_ip));
              }
            }
            debug("ConnectServer: cached_ip=%08lX for recovery probe\n", hSrv->cached_ip);
            return OK;
          }

          /* The server speaks SMB2 and has refused the logon.  SMB1 would only send the same credentials again, perhaps
           * in plain text, and count a second failure against the account.
           */
          debug("ConnectServer: SMB2 session setup failed (%d); not falling back to SMB1\n", res);
          smb2_free_server(srv2);
          return res;
        }

        debug("ConnectServer: SMB2 Negotiate failed (%d)\n", res);
        smb2_err = res;
        smb2_free_server(srv2);
      } else {
        SMB2X_Close(sock);
        smb2_err = EOUTOFMEM;
      }
    } else {
      debug("ConnectServer: port 445 connect failed (%d)\n", res);
      smb2_err = res;
    }
  }

  /* Step 4: Fall back to SMB1 via NetBIOS session on port 139.
   *
   * If both protocols fail, prefer the SMB2 error code where possible: SMB2's transport-level failures
   * ("Cannot make TCP/IP connection", ETIMEOUT) describe the actual problem more accurately than the SMB1
   * fallback's path can.  In particular, SMB1's NB_OpenSession returns ELINKFAILED when the local NetBIOS
   * stack isn't initialised, which is a generic-sounding error compared to SMB2's specific connect-refused
   * (51) or timeout from the original attempt.
   */

  if (strlen(hSrv->servname) > NETBIOS_NAME_MAX) {
    return smb2_err;
  }

  debug("ConnectServer: falling back to SMB1 for \"%s\"\n", hSrv->servname);
  TIMED_CALL("ConnectServer: NB_FormatName", res, NB_FormatName(ntSERVER, hSrv->servname, &nnserver));
  if (res != OK) {
    return (smb2_err != OK) ? smb2_err : res;
  }

  debug("ConnectServer: NB_OpenSession (port 139)\n");
  TIMED_CALL("ConnectServer: NB_OpenSession", res, NB_OpenSession(NB_MachineName, &nnserver, &(hSrv->hSession)));
  if (res != OK) {
    return (smb2_err != OK) ? smb2_err : res;
  }

  /* Establish protocol */

  debug("SMB_Negotiate..\n");
  TIMED_CALL("ConnectServer: SMB_Negotiate", res, SMB_Negotiate(hS));
  if (res != OK) {
    goto abort_server;
  }

  /* Logon user */
  Xlt_Unjumble(hSrv->password);
  debug("SMB_SessSetup..\n");
  TIMED_CALL("ConnectServer: SMB_SessSetup", res, SMB_SessSetup(hS, hSrv->username, hSrv->password));
  Xlt_Jumble(hSrv->password);

  if (res != OK) {
    goto abort_server;
  }

  hSrv->protocol_version = 1;
  hSrv->dead = false;
  debug("ConnectServer: SMB1 connection to \"%s\" succeeded\n", hSrv->servname);

  return OK;

abort_server:
  NB_CloseSession(hSrv->hSession);
  hSrv->hSession = NULL;
  return res;
}

/* ------------------------------ */

/* Drop the session to a server and mark every share on it disconnected. */
static err_t DisconnectServer(hSERVER hSrv) {
  int i;
  hSHARE hS;

  if (hSrv == NULL) {
    return EBADPARAM;
  }

  debug("Disconnect server \"%s\"\n", hSrv->servname);

  /* Disconnect Server implicity closes all shares using it; fortunately, the server will do all this if we drop the link.
   *
   * All we have to do is mark the relevant shares as being disconnected.
   */

  hS = SMB_Shares;
  for (i = 0; i < MAX_SHARES; i++) {
    if ((hS->flags & ALLOCATED) && (hS->hServer == hSrv)) {
      hS->flags &= ~CONNECTED;
      hS->smb2_share = NULL; // its SMB2 share slot goes with the server below, free for another mount to claim
      SMB2_InstallCacheWire(hS->cache, NULL);
    }

    hS++;
  }

  /* Close the transport session */
  if (hSrv->protocol_version == 2 && hSrv->smb2_srv != NULL) {
    smb2_free_server(hSrv->smb2_srv);
    hSrv->smb2_srv = NULL;
  } else if (hSrv->hSession != NULL) {
    NB_CloseSession(hSrv->hSession);
    hSrv->hSession = NULL;
  }
  hSrv->protocol_version = 0;
  return OK;
}

/* ------------------------------ */
/* Dead-mount handling: marking a lost connection dead, and the background probe that brings it back. */

/*
 * Tell the cache of every share on a server that has died that whatever it holds may be stale, since changes made while the connection
 * is down go unreported.
 */
/* cppcheck-suppress constParameter */
static void invalidate_caches_on_server(hSERVER hSrv) {
  int i;
  hSHARE hS = SMB_Shares;
  for (i = 0; i < MAX_SHARES; i++, hS++) {
    if ((hS->flags & ALLOCATED) && hS->hServer == hSrv && hS->cache != NULL) {
      Cache_NotifyConnectionLost(hS->cache);
    }
  }
}

/* Mark a server connection dead, marking its shares' caches stale, closing its transport and disconnecting its shares; a server
 * already dead is left alone.
 */
static void MarkServerDead(hSERVER hSrv, const char *reason) {
  if (hSrv->dead) {
    return;
  }

  debug("MOUNT DEAD: server=\"%s\" reason=\"%s\"\n", hSrv->servname, reason ? reason : "(unspecified)");
  (void)reason; // silences clang's -Wunused-parameter when the debug macro elides args

  /* Flip dead before tearing anything down so callers fail fast at the GetShare gate.
   * Stamp the recovery clock so the next anti-idle tick is eligible to probe immediately.
   */
  hSrv->dead = true;
  hSrv->recovery_next_attempt = LM_Tick();
  hSrv->recovery_interval = RECOVERY_INTERVAL_CS;
  hSrv->recovery_probes = 0u;
  invalidate_caches_on_server(hSrv);

  /* Close transport without sending LOGOFF / TREE_DISCONNECT, because the peer can't hear us. */
  if (hSrv->protocol_version == 2 && hSrv->smb2_srv != NULL) {
    smb2_free_server(hSrv->smb2_srv);
    hSrv->smb2_srv = NULL;
  } else if (hSrv->hSession != NULL) {
    NB_CloseSession(hSrv->hSession);
    hSrv->hSession = NULL;
  }
  hSrv->protocol_version = 0;

  /* Knock the CONNECTED flag off every share on this server so GetShare routes them through recovery.  Their SMB2 share
   * slots went with the server, and another mount may claim one, so a dismount must not find it here and disconnect it.
   */
  {
    int i;
    hSHARE hS = SMB_Shares;
    for (i = 0; i < MAX_SHARES; i++, hS++) {
      if ((hS->flags & ALLOCATED) && hS->hServer == hSrv) {
        hS->flags &= ~CONNECTED;
        hS->smb2_share = NULL;
        SMB2_InstallCacheWire(hS->cache, NULL);
      }
    }
  }
}

/* cppcheck-suppress constParameter */
void SMB_MarkServerDeadBySMB2(SMB2_Server *srv2, const char *reason) {
  int i;
  hSERVER hSrv;
  if (srv2 == NULL) {
    return;
  }
  for (hSrv = SMB_Servers, i = 0; i < MAX_SERVERS; hSrv++, i++) {
    if ((hSrv->flags & ALLOCATED) && hSrv->smb2_srv == srv2) {
      MarkServerDead(hSrv, reason);
      return;
    }
  }
}

void SMB_SetAggressiveRefreshBySMB2(const SMB2_Server *srv2) {
  int i;
  hSHARE hS;

  for (hS = SMB_Shares, i = 0; i < MAX_SHARES; hS++, i++) {
    if ((hS->flags & ALLOCATED) && hS->smb2_share != NULL && hS->smb2_share->server == srv2) {
      Cache_SetQuirks(hS->cache, LMCACHE_QUIRK_AGGRESSIVE_REFRESH);
    }
  }
}

/* Probe a dead server with a cached address, when its backoff allows, by reconnecting over SMB2 to that address. */
static void TryRecoverServer(hSERVER hSrv) {
  uint32_t now;
  SMB2_Server *srv2;
  unsigned long ip;
  int sock;
  err_t res;

  /* Rate-limit the probe, backing off after each failure so an unreachable server is not hammered and the desktop
   * is not stalled every few seconds.  The signed compare handles the centisecond timer wrap correctly.
   */
  now = LM_Tick();
  if ((int32_t)(now - hSrv->recovery_next_attempt) < 0) {
    return;
  }
  hSrv->recovery_next_attempt = now + hSrv->recovery_interval;
  hSrv->recovery_interval = (hSrv->recovery_interval < RECOVERY_MAX_INTERVAL_CS / 2) ? hSrv->recovery_interval * 2u
                                                                                     : RECOVERY_MAX_INTERVAL_CS;
  debug("RECOVERY PROBE: server=\"%s\" cached_ip=%08lX\n", hSrv->servname, hSrv->cached_ip);

  /* A probe that keeps failing may be aimed at an address the server has left, or at a logon it now refuses.  After
   * RECOVERY_PROBE_LIMIT probes the cached address is given up, so the next call reconnects from scratch, resolving the
   * name again and reporting the real error.
   */
  ip = hSrv->cached_ip;
  if (++hSrv->recovery_probes >= RECOVERY_PROBE_LIMIT) {
    hSrv->cached_ip = 0u;
  }

  /* Bounded TCP connect.  Failure here is the normal "still unreachable" outcome, so pass it up. */
  res = SMB2X_ConnectAddrTimed(ip, RECOVERY_PROBE_CS, &sock);
  if (res != OK) {
    debug("RECOVERY PROBE: connect failed (res=%d)\n", res);
    return;
  }

  /* Allocate an SMB2 server record for the new socket.  It needs only the server name; SMB2_Negotiate and
   * SMB2_SessionSetup fill in everything else.
   */
  srv2 = smb2_alloc_server();
  if (srv2 == NULL) {
    SMB2X_Close(sock);
    return;
  }
  srv2->raw_socket = sock;
  strcpy(srv2->servname, hSrv->servname);

  res = SMB2_Negotiate(srv2);
  if (res != OK) {
    debug("RECOVERY PROBE: negotiate failed (res=%d)\n", res);
    smb2_free_server(srv2);
    return;
  }

  /* Credentials are stored jumbled on the hSERVER; un-jumble around the SessionSetup call so the
   * cleartext lives in memory for as little time as possible.
   */
  Xlt_Unjumble(hSrv->password);
  res = SMB2_SessionSetup(srv2, hSrv->username, hSrv->password, "");
  Xlt_Jumble(hSrv->password);
  if (res != OK) {
    debug("RECOVERY PROBE: session setup failed (res=%d)\n", res);
    smb2_free_server(srv2);
    return;
  }

  /* All checks passed: attach the new SMB2 server record to the hSERVER and clear the dead flag.
   * Individual shares get their tree-connect lazily via GetShare's CONNECTED arm on the next FSEntry op.
   */
  hSrv->protocol_version = 2;
  hSrv->smb2_srv = srv2;
  hSrv->ProtFlags = 0;
  hSrv->cached_ip = ip;
  hSrv->dead = false;
  debug("MOUNT ALIVE: server=\"%s\" recovered after %ucs\n", hSrv->servname, (unsigned)(LM_Tick() - now));
}

/* As a general rule, the routines above don't perform any allocation/deallocation functions, only the network transactions
 * themselves.
 *
 * These are dealt with in the following bits.
 */

/* ==========================================  */

/* Allocate a server slot.  FreeServer memsets the slot to zero on release, so a fresh slot here is already
 * fully zero (NULL pointers, empty strings, zero ints).  We only need to mark it ALLOCATED; every other field
 * is populated by the connection-establishment code (SMB_Negotiate, SMB_SessSetup, etc.).  Initialising fields
 * one by one here instead would leave any field added later without an initialiser uninitialised.
 */
static hSERVER AllocServer(void) {
  hSERVER hS;
  int i;

  for (hS = SMB_Servers, i = 0; i < MAX_SERVERS; hS++, i++) {
    if ((hS->flags & ALLOCATED) == 0) {
      hS->flags = ALLOCATED;
      return hS;
    }
  }

  debug("MAX_SERVERS table full - bump limit (currently %d)\n", MAX_SERVERS);
  return NULL;
}

/* ----------------------------------- */

/* Allocate a free share slot, or return NULL if the table is full. */
static hSHARE AllocShare(void) {
  hSHARE hS;
  int i;

  for (hS = SMB_Shares, i = 0; i < MAX_SHARES; hS++, i++) {
    if ((hS->flags & ALLOCATED) == 0) {
      hS->flags = ALLOCATED;
      return hS;
    }
  }

  debug("MAX_SHARES table full - bump limit (currently %d)\n", MAX_SHARES);
  return NULL;
}

/* ----------------------------------- */

static bool ServerInUse(hSERVER hServ) {
  int i;
  hSHARE hS;

  for (hS = SMB_Shares, i = 0; i < MAX_SHARES; hS++, i++) {
    if (hS->hServer == hServ && (hS->flags & ALLOCATED)) {
      return true;
    }
  }

  return false;
}

/* ----------------------------------- */

static hSERVER FindServer(char *serv_name) {
  hSERVER hS;
  int i;

  for (hS = SMB_Servers, i = 0; i < MAX_SERVERS; hS++, i++) {
    if ((hS->flags & ALLOCATED) && stricmp(hS->servname, serv_name) == 0) {
      return hS;
    }
  }

  return NULL;
}

/* ----------------------------------- */

static hSHARE FindShare(hSERVER hServ, char *share_name) {
  hSHARE hS;
  int i;

  for (hS = SMB_Shares, i = 0; i < MAX_SHARES; hS++, i++) {
    if (hS->hServer == hServ && (hS->flags & ALLOCATED) && stricmp(hS->sharename, share_name) == 0) {
      return hS;
    }
  }

  return NULL;
}

/* ----------------------------------- */

/* Release a server slot.  In addition to freeing the negotiate blob (malloced in SMB_Negotiate), the whole struct is zeroed so
 * the slot we hand back to AllocServer is in a known-clean state on every reuse.  Without the full zero, stale
 * `protocol_version`, `smb2_srv`, `last_xact`, credentials, server name, etc. would survive in the slot, and any
 * code that walks the share/server tables (e.g. SMB_AntiIdle's keep-alive pass) during the next
 * AllocServer-but-not-yet-connected window could deref a stale pointer or trigger an inappropriate ECHO with
 * stale gating fields.  Symmetric with smb2_alloc_X / smb2_free_X in c/SMB2.  Zeroing also clears the password
 * buffer so credentials do not linger in freed slots indefinitely.
 */
static void FreeServer(hSERVER hS) {
  if (hS->flags != FREE) {
    free(hS->blob);
  }
  memset(hS, 0, sizeof(*hS));
}

/* ----------------------------------- */

/* Release a share slot, zeroed so AllocShare hands back a clean one and a reused slot cannot reach the previous SMB2_Share.
 * The slot's `drvletter` and `FH_base`, fixed by SMB_Init, survive: GetShare finds a slot by its letter, and each slot's
 * file handles must stay distinct from every other's.
 */
static void FreeShare(hSHARE hS) {
  char letter = hS->drvletter;
  uint fh_base = hS->FH_base;
  memset(hS, 0, sizeof(*hS));
  hS->drvletter = letter;
  hS->FH_base = fh_base;
}

/* True while a share slot is mounted; a search left on a share since dismounted is dropped without a wire call. */
static inline bool ShareSlotLive(hSHARE hS) {
  return hS != NULL && (hS->flags & ALLOCATED) != 0 && hS->hServer != NULL;
}

/* =======================================  */

/*
 * Look up a share by DOS filename, reconnecting it and its server if need be.
 *
 * An SMB1 server whose NetBIOS session has dropped is marked dead here.  A dead server with a cached address is probed by the call itself
 * when a probe is due, so a connection lost moments ago is back before the call goes on.  Otherwise the call fails at once with
 * ELINKFAILED and brings the background probe forward to no later than RECOVERY_INTERVAL_CS from now.  Any other unconnected server is
 * reconnected in full while the caller waits.  A share not yet attached to its server is attached on the way.
 *
 * Parameters:
 *   filename  DOS path whose first character is the share's drive letter
 *   pRes      receives OK, or the error on failure
 *
 * Returns: the connected share, or NULL on failure.
 */
static hSHARE GetShare(const char *filename, err_t *pRes) {
  uint tmp;
  hSHARE hS;
  err_t res;

  /* Drive letter in range and slot in use? */
  tmp = filename[0] - 'A';
  if (tmp >= MAX_SHARES || (hS = &SMB_Shares[tmp], (hS->flags & ALLOCATED) == 0)) {
    *pRes = EBADDRV;
    return NULL;
  }

  /* SMB1 only: probe the NetBIOS session.  SMB2's liveness comes from the AntiIdle ECHO and the per-op
   * failure path in SMB2_SendRecv, both of which set hServer->dead via MarkServerDead.
   */
  if (hS->hServer->protocol_version == 1) {
    if (!NB_LinkOK(hS->hServer->hSession)) {
      MarkServerDead(hS->hServer, "SMB1 NB_LinkOK fail");
    }
  }

  /*
   * A dead server the probe can reach (it has a cached address) is probed here when a probe is due, the first call after the
   * connection was lost included, so a program working through a tree loses one call to a dropped connection rather than every
   * call until the background probe comes round.  The probe is skipped while another exchange is suspended mid-call, since it
   * would be refused the socket.  The probe cannot reach a server with no cached address, so that one falls through to be
   * reconnected below.
   */
  if (hS->hServer->dead && hS->hServer->cached_ip != 0u && !SMB2_IsBusy()) {
    TryRecoverServer(hS->hServer);
  }

  /* Still dead: fail fast rather than holding up the caller with a full reconnect.  Someone wants the mount, though, so undo the
   * probe's backoff: the next probe comes no later than RECOVERY_INTERVAL_CS from now, and this call never brings it nearer than
   * that, so a program retrying in a loop cannot stall the desktop every tick.
   */
  if (hS->hServer->dead && hS->hServer->cached_ip != 0u) {
    hSERVER hSrv = hS->hServer;
    uint32_t soon = LM_Tick() + RECOVERY_INTERVAL_CS;

    hSrv->recovery_interval = RECOVERY_INTERVAL_CS;

    if ((int32_t)(hSrv->recovery_next_attempt - soon) > 0) {
      hSrv->recovery_next_attempt = soon;
    }

    *pRes = ELINKFAILED;
    return NULL;
  }

  /* protocol_version == 0 means a fresh mount, a manual disconnect or a dead server; the user expects to wait while we
   * negotiate.  Failure marks the server dead: one with a cached address then fails fast until the probe recovers it, and
   * one without is tried again by the next call.
   */
  if (hS->hServer->protocol_version == 0) {
    res = ConnectServer(hS);
    if (res != OK) {
      MarkServerDead(hS->hServer, "ConnectServer post-mount fail");
      *pRes = res;
      return NULL;
    }
  }

  /* Server is live; lazily attach the per-share tree on the first op after a disconnect. */
  if ((hS->flags & CONNECTED) == 0) {
    res = ConnectShare(hS);
    if (res != OK) {
      *pRes = res;
      return NULL;
    }
  }

  *pRes = OK;
  return hS;
}

/* ---------------------------- */

/* Validate a drive letter without caring whether its connection is lost (e.g. for the GetConnInfo or DisconnectShare calls). */
static hSHARE GetShareNoConn(uint letter) {
  letter -= 'A';
  if ((letter < MAX_SHARES) && (SMB_Shares[letter].flags & ALLOCATED)) {
    return &SMB_Shares[letter];
  }

  return NULL;
}

/* ---------------------------- */

bool SMB_IsLongNameFS(const char *path) {
  hSHARE hS;

  hS = GetShareNoConn(*path);
  if (hS == NULL) {
    return false;
  }
  /* SMB2 always supports long filenames.
   *
   * Without this check, Xlate falls through to the 8.3 short name path (nameROtoDOS) which truncates filenames like "!TestBASIC"
   * to "!TESTBAS.~IC" and sends that mangled name to the server, which doesn't recognise it.  The SMB1 code sets t2flags during
   * negotiate but SMB2 connections never set that field.
   */
  if (hS->hServer->protocol_version == 2) {
    return true;
  }
  if (hS->hServer->t2flags & T2FLAGS_LONGNAMES) {
    return true;
  }
  return false;
}

bool SMB_IsSMB2FS(const char *path) {
  hSHARE hS = GetShareNoConn(*path);

  return hS != NULL && hS->hServer->protocol_version == 2;
}

/* --------------------- */

/* Return the connected share that owns an SMB1 or SMB2 file handle, without reconnecting it. */
static hSHARE GetShareFromFH(uint FH, err_t *pRes) {
  /* SMB2: the handle's file entry names its share, whose drive letter finds the slot. */
  if (IS_SMB2_FH(FH)) {
    SMB2_FileEntry *fe = smb2_get_file(SMB2_FH_INDEX(FH));
    if (fe != NULL && fe->share != NULL) {
      hSHARE hS = GetShareNoConn(fe->share->drvletter);
      if (hS != NULL && (hS->flags & (ALLOCATED | CONNECTED)) == (ALLOCATED | CONNECTED)) {
        return hS;
      }
    }
    *pRes = EFILEHANDLE;
    return NULL;
  }

  /* SMB1: upper 16 bits index SMB_Shares[] directly. */
  FH = (FH >> 16);
  if (FH < MAX_SHARES) {
    hSHARE hS = &SMB_Shares[FH];

    if ((hS->flags & (ALLOCATED | CONNECTED)) == (ALLOCATED | CONNECTED)) {
      return hS;
    }
  }

  *pRes = EFILEHANDLE;
  return NULL;
}

/* ----------------------------- */

static err_t SMB_SingleOp(int op, char *path) {
  BUFCHAIN pB;
  hSHARE hS;
  err_t res;

  hS = GetShare(path, &res);
  if (hS == NULL) {
    return res;
  }

  pB = MkDataString(NULL, DATA_ASCII, path + 2);
  if (pB == NULL) {
    return EOUTOFMEM;
  }

  return Do_SMB(hS, op, 0, pB, NULL);
}

/* Public Connect/disconnect operations ====================== */

/* Check whether a string is empty or contains only spaces. */
static bool IsBlank(char *str) {
  while (isspace(*str)) {
    str++; // Skip leading spaces
  }

  if (iscntrl(*str)) { // If it's the end, it's blank
    return true;
  }

  return false;
}

/*
 * Report whether a server is logged on with a given user name and password, so that a new share on it need not log on again.
 *
 * Both are compared as ConnectServer stores them: cut to the length of their fields, and the user name, which carries any domain as
 * DOMAIN\user, in the case typed, since some servers refuse a logon in any other case.  The server's password is descrambled only while
 * it is compared, and the plain copy taken here is cleared before returning.
 *
 * Parameters:
 *   hServ     server to check
 *   username  user name a share is being connected with
 *   password  password a share is being connected with
 *
 * Returns: true if both match the server's; false if either differs.
 */
static bool server_logon_matches(hSERVER hServ, const char *username, const char *password) {
  char given[PASSWORD_LIMIT];
  int differ = 0;
  int i;

  if (strncmp(hServ->username, username, USERNAME_LIMIT - 1) != 0) {
    return false;
  }

  /* Compare every byte up to the given password's terminator rather than stop at the first difference, so the time taken says nothing
   * of the stored password.
   */
  strcpyn(given, password, PASSWORD_LIMIT);
  Xlt_Unjumble(hServ->password);
  for (i = 0; i < PASSWORD_LIMIT; i++) {
    differ |= given[i] ^ hServ->password[i];
    if (given[i] == '\0') {
      break;
    }
  }
  Xlt_Jumble(hServ->password);
  memset(given, 0, sizeof given);

  return differ == 0;
}

/*
 * Read the time now as the load and exec addresses of a dated directory, typed as a directory listed without a filetype suffix is.
 *
 * Parameters:
 *   load  returns the load address: the default filetype and the top byte of the time
 *   exec  returns the exec address: the low four bytes of the time
 */
static void dated_directory_now(uint32_t *load, uint32_t *exec) {
  uint8_t now[5];

  now[0] = 3u; // OS_Word 14 reason 3 reads the clock as five bytes of centiseconds since 1900
  _swix(OS_Word, _INR(0, 1), 14, now);
  *load = 0xFFF00000u | ((uint32_t)LM_Vars.default_type << 8) | now[4];
  *exec = (uint32_t)now[0] | ((uint32_t)now[1] << 8) | ((uint32_t)now[2] << 16) | ((uint32_t)now[3] << 24);
}

err_t SMB_CreateShare(int sharetype_in, int style, char *servname_in, char *sharename_in, char *username_in, char *password_in,
                      char *drv_letter_out, const char *mount_label) {
  hSHARE hShare;
  hSERVER hServ;
  char uc_sharename[SHARENAME_LEN];
  char uc_servname[SERVNAME_LEN];
  char plain_password[PASSWORD_LIMIT];
  int to_do, done;
  err_t res;

  /* Validate & format parameters */
  if (servname_in == NULL || sharename_in == NULL) {
    return EBADPARAM;
  }

  /* A name cut short would connect to a different share or server, so refuse it instead. */
  if (strlen(sharename_in) >= SHARENAME_LEN || strlen(servname_in) >= SERVNAME_LEN) {
    return EBADNAME;
  }

  strcpyn_upper(uc_sharename, sharename_in, SHARENAME_LEN);
  strcpyn_upper(uc_servname, servname_in, SERVNAME_LEN);

  if (username_in == NULL) {
    username_in = "";
  }
  if (password_in == NULL) {
    password_in = "";
  }

  /* Work out a list of what we have to do ------------ */

  to_do = 0;

  hServ = FindServer(uc_servname);

  if (hServ == NULL) // New server
  {
    hShare = NULL;
    to_do |= (ALLOC_SERVER | ALLOC_SHARE | CONN_SERVER);

    /* If both names are blank, use logon names */
    if (IsBlank(username_in) && IsBlank(password_in)) {
      username_in = LM_Vars.username;
      Xlt_Unjumble(LM_Vars.password_ptr);
      strcpyn(plain_password, LM_Vars.password_ptr, PASSWORD_LIMIT);
      Xlt_Jumble(LM_Vars.password_ptr);
      password_in = plain_password;
    }
  } else {
    /* Already have connection to server */
    hShare = FindShare(hServ, uc_sharename);

    if (hShare == NULL) { // New share on existing server
      to_do |= (ALLOC_SHARE);
    }

    /* A user name given with CREATE_NEW_USER logs on again as that user, disconnecting the server's other shares, unless the server is
     * already logged on with that user name and password.
     */
    if ((style & CREATE_NEW_USER) && !IsBlank(username_in) && !server_logon_matches(hServ, username_in, password_in)) {
      to_do |= (DISCONN_SERVER | CONN_SERVER);
    }
  }

  /* Check that's OK with the given style ----- */

  if ((style & CREATE_NEW_SHARE) && !(to_do & ALLOC_SHARE)) {
    /* If the share already exists, and the 'insist it's something new' bit is set,  we fail the call and say  which drive letter
     * it is.
     *
     * Otherwise, we drop through the rest of the code: the only thing that might happen is a disconnect/reconnect to change user
     * ID
     */
    *drv_letter_out = hShare->drvletter;
    return ECONNEXISTS;
  }

  /* Now do each bit ----------------------- */

  done = 0;

  /* Ensure hServ is allocated */
  if (to_do & ALLOC_SERVER) {
    hServ = AllocServer();
    if (hServ == NULL) {
      res = ECONNLIMIT;
      goto fail;
    }
    strcpy(hServ->servname, uc_servname);
    done |= ALLOC_SERVER;
  }

  /* Ensure hShare is allocated & set up */
  if (to_do & ALLOC_SHARE) {
    hShare = AllocShare();
    if (hShare == NULL) {
      res = ECONNLIMIT;
      goto fail;
    }

    /* Assume flags don't have CONNECTED set */
    hShare->hServer = hServ;
    hShare->sharetype = sharetype_in;
    strcpy(hShare->sharename, uc_sharename);
    done |= ALLOC_SHARE;
  }

  /* Clear attribute-file cache for the drive */

  Attr_InvalidateDrive(hShare->drvletter);

  /* Disconnect server if new user */

  if (to_do & DISCONN_SERVER) {
    /* For a change of user, disconnect the server.
     *
     * It will mark all attached shares as being disconnected
     */
    DisconnectServer(hServ);
    done |= DISCONN_SERVER;
  }

  /* (re)connect to server */

  if (to_do & CONN_SERVER) {
    /* Set up new server details.  The username keeps the case typed, because macOS and case-sensitive Samba servers
     * refuse a logon in any other case; the NTLMv2 hash upper-cases it itself (MS-NLMP 3.3.2), and SMB_SessSetup
     * upper-cases it for a plaintext LM1.2X002 logon.
     */
    strcpyn(hServ->username, username_in, USERNAME_LIMIT);
    strcpyn(hServ->password, password_in, PASSWORD_LIMIT);
    Xlt_Jumble(hServ->password);

    res = ConnectServer(hShare);
    if (res != OK) {
      goto fail;
    }

    done |= CONN_SERVER;
  }

  /* Connect to share ------------------- */

  /* Reconnect share, & reconnect link if it's down */
  if (GetShare(&(hShare->drvletter), &res) == NULL) {
    goto fail;
  }

  /* Allocate the per-mount cache substrate.  Failure is non-fatal: every cache primitive tolerates a NULL cache
   * pointer (degrading to "miss / no-op"), so the share remains usable without acceleration.  SMB1 and SMB2 mounts
   * alike hold a cache that populates from FSEntry-side notifications; an SMB2 mount's cache also lists directories
   * itself, through the wire callbacks bound here.
   *
   * Skipped entirely for non-disk shares (sharetype 0 == disk; 1 = printer LPT1, 2 = comm, 3 = IPC$).  Printer
   * spool writes go through SMB_OpenPrinter / SMB_WritePrinter / SMB_ClosePrinter, bypassing the FSEntry handlers
   * in c.CoreFn entirely, so the cache is unreachable on those handles and a per-mount Dynamic Area for them would
   * be wasted.  IPC$ is RPC traffic only; no cache value either.  *LMCache Off leaves every mount made afterwards without one.
   */
  if (hShare->sharetype == 0 && !LM_Vars.cache_off) {
    char root_path[4] = {hShare->drvletter, ':', '\\', '\0'};
    DOS_ATTRIBS root_da;
    RISCOS_ATTRIBS root_ra;
    uint32_t root_load;
    uint32_t root_exec;

    /* The cache never expires its root, so the root keeps the date read here.  A root the server gives no date for, or reports as
     * absent because it is hidden (a Windows drive's root is) while hidden files are not shown, is dated now.
     */
    if (SMB_GetAttribs(root_path, &root_da) == OK && root_da.utime != 0u) {
      Xlt_CnvDOStoRO(&root_da, &root_ra, CNV_DATETIME, hShare);
      root_load = (uint32_t)root_ra.loadaddr;
      root_exec = (uint32_t)root_ra.execaddr;
    } else {
      dated_directory_now(&root_load, &root_exec);
    }

    hShare->cache = Cache_MountCreate((mount_label != NULL && mount_label[0] != '\0') ? mount_label : NULL, root_load, root_exec);
    if (hShare->cache != NULL && hShare->smb2_share != NULL) {
      SMB2_InstallCacheWire(hShare->cache, hShare->smb2_share);
    }

    /* Only change notification tells the cache what other clients do, and an SMB1 mount has none, while a non-Windows server
     * (classified at SessionSetup) delivers it unreliably.  Either way the cache must revalidate on a short cadence instead.
     */
    if (hShare->smb2_share == NULL || (hShare->smb2_share->server != NULL && (hShare->smb2_share->server->flags & SMB2_SRV_NON_WINDOWS))) {
      Cache_SetQuirks(hShare->cache, LMCACHE_QUIRK_AGGRESSIVE_REFRESH);
    }
  }

  *drv_letter_out = hShare->drvletter;
  return OK;

  /* Back out if something goes wrong */

fail:
  if (done & ALLOC_SHARE) { // If it was a new share
    FreeShare(hShare);      //   free it
  }

  if (done & ALLOC_SERVER) // If it was a new server...
  {
    if (done & CONN_SERVER) {  // Disconnect it if it was
      DisconnectServer(hServ); // connected
    }

    FreeServer(hServ);
  }

  return res;
}

