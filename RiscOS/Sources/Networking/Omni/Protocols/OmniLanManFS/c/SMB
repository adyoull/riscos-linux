static BUFCHAIN MkDataBlock(BUFCHAIN pB, int type, uint8_t *ptr, int len, bool indirect) {
  uint8_t hdrblk[4];

  /* Add the payload before the header: AddChain prepends, so the header added afterwards goes in front of
   * it on the wire.  Indirect chains reference the caller's buffer in place (zero copy); the direct path
   * copies the bytes into chain storage.  Zero-length blocks are a header-only marker.
   */
  if (len > 0) {
    if (indirect) {
      pB = AddChainIndirect(pB, ptr, len);
    } else {
      pB = AddChain(pB, ptr, len);
    }

    if (pB == NULL) {
      return NULL;
    }
  }

  /* Three-byte SMB data-block header: type then little-endian length. */
  hdrblk[0] = type;
  hdrblk[1] = len & 0xFF;
  hdrblk[2] = len >> 8;

  return AddChain(pB, hdrblk, 3);
}

