static BUFCHAIN MkDataString(BUFCHAIN pB, int type, const char *ptr) {
  uint8_t hdrblk[4];

  pB = AddChain(pB, (void *)ptr, strlen(ptr) + 1);

  if (pB == NULL) {
    return NULL;
  }

  hdrblk[0] = type;

  return AddChain(pB, hdrblk, 1);
}

