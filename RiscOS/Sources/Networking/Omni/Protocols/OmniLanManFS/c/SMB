static err_t SMB_ChkPath(char *path) {
  return SMB_SingleOp(SMBchkpth, path);
}

/* ----------------------------- */

err_t SMB_MkDir(char *path, bool *created) {
  err_t res;
  hSHARE hS = GetShare(path, &res);
  *created = false;
  if (hS == NULL) {
    return res;
  }
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    /* path+2 skips the "X:" drive letter prefix, because SMB2 paths are relative to the share root, not drive-letter based. */
    return SMB2_MkDir(hS->smb2_share, path + 2, created);
  }
  res = SMB_SingleOp(SMBmkdir, path);
  *created = (res == OK);
  return res;
}

/* ----------------------------- */

err_t SMB_RmDir(char *path) {
  err_t res;
  hSHARE hS = GetShare(path, &res);
  if (hS == NULL) {
    return res;
  }
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    return SMB2_RmDir(hS->smb2_share, path + 2);
  }
  return SMB_SingleOp(SMBrmdir, path);
}

/* ----------------------------- */

err_t SMB_Delete(char *path, bool link_itself) {
  BUFCHAIN pB;
  hSHARE hS;
  err_t res;

  hS = GetShare(path, &res);
  if (hS == NULL) {
    return res;
  }

  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    /* The FSEntry layer's DeleteObject path filters hidden and system files: its FileGetAttribs call reports one as not
     * found unless hidden files are shown, so a second SMB2_GetAttribs here would only repeat that round trip.  The save
     * path does not filter, so on SMB2 it deletes a hidden or system file of the name it replaces, where SMB1's search
     * attributes spare one unless hidden files are shown.
     */
    return SMB2_Delete(hS->smb2_share, path + 2, link_itself);
  }

  pB = MkDataString(NULL, DATA_ASCII, path + 2);
  if (pB == NULL) {
    return EOUTOFMEM;
  }

  if (LM_Vars.namemode & NM_HIDDEN) {
    SMB_TxWords[0] = ATTR_NORM | ATTR_SYS | ATTR_HID;
  } else {
    SMB_TxWords[0] = ATTR_NORM;
  }

  return Do_SMB(hS, SMBunlink, 1, pB, NULL);
}

/* ----------------------------- */

err_t SMB_Rename(char *oldpath, char *newpath) {
  BUFCHAIN pB;
  hSHARE hS;
  err_t res;

  /* Cross-share rename has no protocol equivalent, so the caller must copy and delete. */
  if (oldpath[0] != newpath[0]) {
    return EBADRENAME;
  }

  /* A rename to the same name is a no-op; skip the wire trip entirely. */
  vdebug("SMB_Rename: \"%s\" \"%s\"\n", oldpath + 1, newpath + 1);
  if (strcmp(oldpath + 1, newpath + 1) == 0) {
    return OK;
  }

  hS = GetShare(oldpath, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMB2 has no search attributes: a hidden or system object is renamed even when hidden files are not shown, where SMBmv's
   * attribute mask below refuses one.
   */
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    return SMB2_Rename(hS->smb2_share, oldpath + 2, newpath + 2);
  }

  /* SMBmv carries the old name then the new name.  The chain prepends, so the new name is added first. */
  pB = MkDataString(NULL, DATA_ASCII, newpath + 2);
  if (pB != NULL) {
    pB = MkDataString(pB, DATA_ASCII, oldpath + 2);
  }

  if (pB == NULL) {
    return EOUTOFMEM;
  }

  /* Attribute mask gates what kinds of entries the rename may operate on.  In NM_HIDDEN mode we let
   * hidden / system files participate; otherwise we still permit ordinary files and directories.
   */
  if (LM_Vars.namemode & NM_HIDDEN) {
    SMB_TxWords[0] = ATTR_DIR | ATTR_SYS | ATTR_HID;
  } else {
    SMB_TxWords[0] = ATTR_NORM | ATTR_DIR;
  }

  return Do_SMB(hS, SMBmv, 1, pB, NULL);
}

