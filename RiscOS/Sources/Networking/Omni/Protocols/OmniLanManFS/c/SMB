static err_t Err_Translate(int class, int code) {
  int *p1;

  debug(" SMB-Err class %d number %d\n", class, code);

  /* Pick the right table for this error class.  Hardware errors and unrecognised classes have no per-code
   * mapping, so resolve them straight to a generic err_t.
   */
  if (class == 0) {
    return OK;
  } else if (class == ECLASS_DOS) {
    p1 = DOS_Errs;
  } else if (class == ECLASS_SRV) {
    p1 = SMB_Errs;
  } else if (class == ECLASS_HARD) {
    return EHARDERROR;
  } else {
    return EPROTOCOLERR;
  }

  /* Linear search for the code.  Tables are sentinel-terminated by -1; on overrun p1 lands on the sentinel
   * row whose p1[1] is the catch-all err_t for that class.
   */
  while (*p1 >= 0 && *p1 != code) {
    p1 += 2;
  }

  debug(" Unknown err code %d\n", code);
  return p1[1];
}

