static err_t SMB_GetFreeSpaceX2(hSHARE hS, struct disk_size_response *pDSR) {
  err_t res;
  static struct TransactParms tp;
  uint8_t *p;
  uint32_t sectors_per_alloc, total_allocs, total_avail_allocs;
  uint16_t bytes_per_sector;

  /* TRANSACT2_QUERYFSINFORMATION at info level 1 (SMB_INFO_ALLOCATION) returns the SMB1 long-name
   * filesystem geometry.  Setup buffer holds the single subcommand opcode; one parameter word selects
   * the info level.
   */
  Transact_init(&tp, 1 * 2);
  Transact_addsetupword(&tp, TRANSACT2_QUERYFSINFORMATION);
  Transact_addword(&tp, 1);
  res = SMB_Transact2(hS, &tp);
  if (res != OK) {
    return res;
  }

  /* Response layout (after a 4-byte filesystem ID we skip): sectors per allocation unit, total alloc
   * units, available alloc units, bytes per sector.  All little-endian; the Transact_get* accessors
   * unpack and bump the cursor.
   */
  p = tp.data_out_buf + 4;
  sectors_per_alloc = Transact_getlong(p), p += 4;
  total_allocs = Transact_getlong(p), p += 4;
  total_avail_allocs = Transact_getlong(p), p += 4;
  bytes_per_sector = Transact_getword(p);

  pDSR->blksize = bytes_per_sector * sectors_per_alloc;
  pDSR->freeblks = total_avail_allocs;
  pDSR->totalblks = total_allocs;

  return OK;
}

err_t SMB_GetFreeSpace(char lettr, struct disk_size_response *pDSR) {
  err_t res;
  hSHARE hS;

  hS = GetShare(&lettr, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMB2 and the SMB1 long-name path both have richer query commands that return per-cluster info; fall
   * through to the ancient SMBdskattr only for the bare-minimum SMB1 server.
   */
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    return SMB2_GetFreeSpace(hS->smb2_share, pDSR);
  }

  if (hS->hServer->t2flags & T2FLAGS_LONGNAMES) {
    return SMB_GetFreeSpaceX2(hS, pDSR);
  }

  res = Do_SMB(hS, SMBdskattr, 0, NULL, NULL);

  /* SMBdskattr response: total alloc units, blocks-per-unit, bytes-per-block, free alloc units.
   * blksize is the size of one allocation unit in bytes (block size * blocks per unit).
   */
  if (res == OK) {
    pDSR->blksize = SMB_RxWords[1] * SMB_RxWords[2];
    pDSR->freeblks = SMB_RxWords[3];
    pDSR->totalblks = SMB_RxWords[0];
  }

  return res;
}

/* ------------------------------- */

enum {
  ffirst_FORCE_CLOSE = 1,
  ffirst_CLOSE_IF_DONE = 2, // Note close_if_done doesn't seem to work (at least on NT 4.0 SP3)
  ffirst_RETURN_KEYS = 4,
  fnext_CONTINUE = 8, // This bit allows continuation without the need to use resume keys
  ffirst_BACKUP_INTENT = 16
};

static err_t SMB_AbandonFind2(hSHARE hS, uint16_t dir_handle) {
  vdebug("Terminating search op (dir_handle = %x)\n", dir_handle);
  SMB_TxWords[0] = dir_handle;
  return Do_SMB(hS, SMBfindclose2, 1, NULL, NULL);
}

/* Implement directory searching via TRANSACT2/FINDFIRST/FINDNEXT */
static err_t SMB_ReadDirEntriesX2(hSHARE hS, char *path, int count, ENUM_DIR_FN dirfn, void *private, Transact_SearchContext *con) {
  err_t res;
  uint8_t *p;
  int n_read = 0;
  int eos;
  int i;
  uint32_t actual_resume_key;
  const int first_flags = ffirst_RETURN_KEYS;
  const int next_flags = ffirst_RETURN_KEYS;
  bool path_changed = false;
  bool taken;
  uint8_t *data_end;

  /* Despite having a resume key it may be necessary to restart */
  if ((path != NULL) && (strcmp(path, con->dir_path) != 0)) {
    path_changed = true;
  }

  if (path_changed || (con->resume_key == 0)) {
    /* Path changed due to recursion or new search */
    if (con->dir_handle_valid) {
      vdebug("SMB_ReadDirEntriesX2 -> abandon old search of dir handle %x\n", con->dir_handle);
      (void)SMB_AbandonFind2(hS, con->dir_handle);
      con->dir_handle_valid = false;
    }
    strcpy(con->dir_path, path);
    con->resume_key_encountered = con->resume_key == 0;

    /* For a new search, ensure the request allows for "." and ".." which are always given and would therefore end up oscillating
     * with 0 useful files found and a resume key of 0 again
     */
    count = max(count, 3);

    /* Initial search: note we accept SIX return parameters, contrary to Microsoft's own document, because it doesn't work if
     * you only pass 5.
     *
     * Grr.
     */
    Transact_init(&con->tp, 6 * 2); // will accept 6 uint16_t return params
    Transact_addsetupword(&con->tp, TRANSACT2_FINDFIRST);
    if (LM_Vars.namemode & NM_HIDDEN) { // findfirst_Attribute
      Transact_addword(&con->tp, ATTR_DIR | ATTR_SYS | ATTR_HID);
    } else {
      Transact_addword(&con->tp, ATTR_DIR);
    }
    Transact_addword(&con->tp, count);       // findfirst_SearchCount
    Transact_addword(&con->tp, first_flags); // findfirst_flags
    Transact_addword(&con->tp, 1);           // Search level
    Transact_addlong(&con->tp, 0L);          // reserved, MBZ
    Transact_addstring(&con->tp, path + 2);  // findfirst_FileName[]
    res = SMB_Transact2(hS, &con->tp);
    if (res != OK) {
      return res;
    }
    p = con->tp.parms_out_buf;
    con->dir_handle = Transact_getword(p);
    p += 2;
    con->dir_handle_valid = true;
    con->resume_fake = 0;
    con->resume_key_stuck = false;
    con->resume_file_name[0] = 0;
    vdebug("SMB_ReadDirEntriesX2 -> new dir handle %x\n", con->dir_handle);
  } else {
    /* Continuation */
    Transact_init(&con->tp, 4 * 2); // will accept 4 uint16_t return params
    Transact_addsetupword(&con->tp, TRANSACT2_FINDNEXT);
    Transact_addword(&con->tp, con->dir_handle);        // findnext_DirHandle
    Transact_addword(&con->tp, count);                  // findnext_SearchCount
    Transact_addword(&con->tp, 1);                      // Search level
    Transact_addlong(&con->tp, con->actual_resume_key); // Resume key from previous
    Transact_addword(&con->tp, next_flags);             // Jump to place using the resume key
    Transact_addstring(&con->tp, con->resume_file_name);
    vdebug("SMB_ReadDirEntriesX2 -> continue with key %08x\n", con->resume_key);
    res = SMB_Transact2(hS, &con->tp);
    if (res != OK) {
      return res;
    }
    p = con->tp.parms_out_buf;
  }
  /* Remainder of response handling is common to both sub-commands */
  n_read = Transact_getword(p);
  p += 2;
  eos = Transact_getword(p);
  p += 2;
  if (eos) {
    vdebug(">> Server said it was the end of the search operation\n");
  }
  p = con->tp.data_out_buf;
  if (n_read == 0) {
    return ENOMOREFILES;
  }

  /* At this point, p is pointing to the start of the returned data buffer, n_read contains the number of files known to be in the
   * return buffer, eos is non-zero if the search is completed.
   */
  data_end = con->tp.data_out_buf + con->tp.data_out_len;

  for (i = 1; i <= n_read; i++) {
    int length;
    uint32_t next_resume_key;

    /* n_read and the per-record name length are wire-controlled; stop before walking past the received data.
     * Each record is a 4-byte resume key + a 23-byte header (name length at [22]) + the name. */
    if (p + 27 > data_end) {
      break;
    }

    /* Get next resume key */
    next_resume_key = Transact_getlong(p);
    p += 4;
    length = p[22];
    if (p + 23 + length + 1 > data_end) {
      break;
    }
    con->resume_fake++;

    /* Special case . and .. so the duff resume key detection doesn't see them */
    if (((p[22] == 1) && (p[23] == '.') && (p[24] == 0)) || ((p[22] == 2) && (p[24] == '.') && (p[25] == 0) && (p[23] == '.'))) {
      p += 23 + length + 1;
      continue;
    }

    actual_resume_key = next_resume_key;

    /* Workaround for NTFS always returning zero */
    con->resume_key_stuck = next_resume_key == 0;
    if (con->resume_key_stuck) {
      next_resume_key = con->resume_fake;
    }

    /* Either consume the name or keep waiting for sync */
    if (con->resume_key_encountered) {
      vdebug("SMB_ReadDirEntriesX2 -> call back with key %08x\n", next_resume_key);
      res = dirfn(p, 1, &taken, private, hS);

      if (taken) {
        con->resume_key = next_resume_key;
        con->actual_resume_key = actual_resume_key;
        memcpy(con->resume_file_name, p + 23, length + 1);
      } else {
        con->resume_fake--;
      }

      if (res != OK) {
        /* Entry expander must have run out of space! */
        vdebug("SMB_ReadDirEntriesX2 -> caller ran out of space (or could be name xlate code)\n");
        return EOUTOFMEM;
      }
    } else {
      vdebug("SMB_ReadDirEntriesX2 -> awaiting key %08x (got %08x)\n", con->resume_key, next_resume_key);
      con->actual_resume_key = actual_resume_key;
      memcpy(con->resume_file_name, p + 23, length + 1);
      if (next_resume_key == con->resume_key) {
        con->resume_key_encountered = true;
      }
    }
    p += 23 + length + 1;
  }

  if (eos) {
    vdebug(">> Server said it was the end of the search operation\n");
  }

  return eos ? ENOMOREFILES : OK;
}

err_t SMB_ReadDirEntries(char *path, int count, ENUM_DIR_FN dirfn, void *private, void *context) {
  err_t res;
  int i, n_read, eos;
  uint8_t *p;
  BUFCHAIN pB, pBres;
  Transact_SearchContext *con;
  bool path_changed = false;
  bool taken;
  uint8_t *data_end;

  /* Don't be silly */
  if (count < 0) {
    return ENOMOREFILES;
  }

  con = (Transact_SearchContext *)context;
  if (con->resume_key == 0) {
    /* Start search */
    con->search_drive = GetShare(path, &res);
    if (con->search_drive == NULL) {
      return res;
    }

    /* SMB2 dispatch.  The path arrives as "X:\subdir\*"; SMB2_ReadDirEntries wants the directory relative to the share root, so a
     * local copy drops the drive prefix, the "\*" wildcard and any leading backslash.  The copy is needed because the buffer is shared
     * with the caller.
     */
    vdebug("SMB_ReadDirEntries: protocol=%d smb2_share=%p\n", con->search_drive->hServer->protocol_version,
           (void *)con->search_drive->smb2_share);
    if (con->search_drive->hServer->protocol_version == 2 && con->search_drive->smb2_share != NULL) {
      char dirpath[256];
      const char *src = path + 2;
      int dirlen;

      strncpy(dirpath, src, sizeof(dirpath) - 1);
      dirpath[sizeof(dirpath) - 1] = '\0';
      dirlen = (int)strlen(dirpath);

      if (dirlen >= 2 && dirpath[dirlen - 1] == '*' && dirpath[dirlen - 2] == '\\') {
        dirpath[dirlen - 2] = '\0';
      }

      src = dirpath;
      while (*src == '\\') {
        src++;
      }

      vdebug("SMB_ReadDirEntries: dispatching to SMB2 for \"%s\"\n", src);
      res = SMB2_ReadDirEntries(con->search_drive->smb2_share, src, 0, dirfn, private, 0, NULL);
      /* SMB2 enumerates the entire directory in a single call, so there is no resume key to propagate and con->resume_key
       * stays at zero.  Xlate's match loop sets `inptr = NULL` on a second iteration and would re-enter with resume_key 0,
       * so OK is promoted to ENOMOREFILES to end the search.  Non-OK returns (callback abort with EOUTOFMEM, wire error)
       * propagate as-is.
       */
      if (res == OK) {
        res = ENOMOREFILES;
      }
      return res;
    }
  } else {
    /* Continue search */
    if (!ShareSlotLive(con->search_drive)) {
      return ENOMOREFILES;
    }
  }

  if (con->search_drive->hServer->t2flags & T2FLAGS_LONGNAMES) {
    /* Long names enabled */
    return SMB_ReadDirEntriesX2(con->search_drive, path, count, dirfn, private, con);
  }

  /* Despite having a resume key it may be necessary to restart */
  if ((path != NULL) && (strcmp(path, con->dir_path) != 0)) {
    path_changed = true;
  }

  if (con->resume_key == 0) {
    /* New search */
    strcpy(con->dir_path, path);
    con->resume_key_encountered = true;
    con->dir_handle_valid = false;

    /* For a new search, ensure the request allows for "." and ".." which are always given and would therefore end up oscillating
     * with 0 useful files found and a resume key of 0 again
     */
    count = max(count, 3);

    /* Initial search */
    pB = MkDataBlock(NULL, DATA_VARBLK, NULL, 0, false);
    if (pB != NULL) {
      pB = MkDataString(pB, DATA_ASCII, path + 2);
    }
    vdebug("SMB_ReadDirEntries -> new search of \"%s\"\n", path);
  } else {
    /* Continuation */
    vdebug("SMB_ReadDirEntries -> continue with key %08x\n", con->resume_key);

    if (!path_changed && con->dir_handle_valid && ((uint16_t)con->resume_key == con->dir_handle)) {
      /* Path is the same, search key non zero, state valid */
      vdebug("SMB_ReadDirEntries -> hyperspace\n");
      con->resume_key_encountered = true;
      pB = MkDataBlock(NULL, DATA_VARBLK, con->resume_state, SEARCH_ST_SIZE, false);
      if (pB != NULL) {
        pB = MkDataString(pB, DATA_ASCII, "");
      }
    } else {
      /* Emulate the state resumption, slow but infrequent */
      vdebug("SMB_ReadDirEntries -> emulation\n");

      con->resume_key_encountered = false;
      pB = MkDataBlock(NULL, DATA_VARBLK, NULL, 0, false);
      if (pB != NULL) {
        pB = MkDataString(pB, DATA_ASCII, path + 2);
      }

      while (!con->resume_key_encountered) {
        /* Do search */
        if (pB == NULL) {
          return EOUTOFMEM;
        }
        SMB_TxWords[0] = max(count, SEARCH_COUNT);
        SMB_TxWords[1] = ATTR_DIR /* | ATTR_SYS | ATTR_HID */;
        res = Do_SMB(con->search_drive, SMBsearch, 2, pB, &pBres);
        if (res != OK) {
          return res;
        }
        res = GetWorkBufData(pBres);
        if (res != OK) {
          return res;
        }

        /* Scan for a match */
        n_read = SMB_RxWords[0];
        eos = (n_read < count);
        if (eos) {
          vdebug(">> Server said it was the end of the search operation\n");
        }

        p = SMB_WorkBuf + 3;
        /* At this point, p is pointing to the start of the returned data buffer, n_read contains the number of files known to be
         * in the return buffer, eos is non-zero if the search is completed.
         */
        if (n_read == 0) {
          return ENOMOREFILES;
        }

        data_end = SMB_WorkBuf + SMB_RxByteCount;

        for (i = 1; i <= n_read; i++) {
          uint32_t next_resume_key;

          /* n_read is wire-controlled; stop before a fixed-size record would read past the received data.  With no
           * record read, the same search would come back again, so give up.
           */
          if (p + SEARCH_TOT_SIZE > data_end) {
            if (i == 1) {
              return EDATALEN;
            }
            break;
          }

          /* Prep resumption */
          memcpy(con->resume_state, p, SEARCH_ST_SIZE);

          /* Get next resume key */
          _swix(OS_CRC, _INR(0, 3) | _OUT(0), 0, p + 30, p + SEARCH_TOT_SIZE, 1, &next_resume_key);
          if (next_resume_key == con->resume_key) {
            strcpy(con->dir_path, path);
            con->resume_key_encountered = true;
            break;
          }

          p += SEARCH_TOT_SIZE;
        }

        /* Again again... */
        pB = MkDataBlock(NULL, DATA_VARBLK, con->resume_state, SEARCH_ST_SIZE, false);
        if (pB != NULL) {
          pB = MkDataString(pB, DATA_ASCII, "");
        }
      }
    }
  }

  /* Do search */
  if (pB == NULL) {
    return EOUTOFMEM;
  }
  count = min(count, SEARCH_COUNT);
  SMB_TxWords[0] = count;
  SMB_TxWords[1] = ATTR_DIR /* | ATTR_SYS | ATTR_HID */;
  res = Do_SMB(con->search_drive, SMBsearch, 2, pB, &pBres);
  if (res != OK) {
    return res;
  }
  res = GetWorkBufData(pBres);
  if (res != OK) {
    return res;
  }

  /* Remainder of response handling is common to both sub-commands */
  n_read = SMB_RxWords[0];
  eos = (n_read < count);
  if (eos) {
    vdebug(">> Server said it was the end of the search operation\n");
  }

  p = SMB_WorkBuf + 3;
  /* At this point, p is pointing to the start of the returned data buffer, n_read contains the number of files known to be in the
   * return buffer, eos is non-zero if the search is completed.
   */
  if (n_read == 0) {
    return ENOMOREFILES;
  }

  data_end = SMB_WorkBuf + SMB_RxByteCount;

  for (i = 1; i <= n_read; i++) {
    uint32_t next_resume_key;

    /* n_read is wire-controlled; stop before a fixed-size record would read or write past the received data.  With no
     * record read, the caller would ask for the same entries again, so give up.
     */
    if (p + SEARCH_TOT_SIZE > data_end) {
      if (i == 1) {
        return EDATALEN;
      }
      break;
    }

    /* Get next resume key */
    _swix(OS_CRC, _INR(0, 3) | _OUT(0), 0, p + 30, p + SEARCH_TOT_SIZE, 1, &next_resume_key);
    p[SEARCH_TOT_SIZE - 1] = 0;

    vdebug("SMB_ReadDirEntries -> call back with key %08x\n", next_resume_key);
    res = dirfn(p + SEARCH_ST_SIZE, 0, &taken, private, con->search_drive);
    if (taken) {
      con->resume_key = next_resume_key;
      memcpy(con->resume_state, p, SEARCH_ST_SIZE);
      con->dir_handle = (uint16_t)next_resume_key;
      con->dir_handle_valid = true;
    }
    if (res != OK) {
      /* Entry expander must have run out of space! */
      vdebug("SMB_ReadDirEntries -> caller ran out of space (or could be name xlate code)\n");
      return EOUTOFMEM;
    }

    p += SEARCH_TOT_SIZE;
  }

  if (eos) {
    vdebug(">> Server said it was the end of the search operation\n");
  }

  return eos ? ENOMOREFILES : OK;
}

/* Public file read/write operations ============================= */

err_t SMB_Create(char *filename, DOS_ATTRIBS *pInAttr, int *pOutFH) {
  err_t res;
  BUFCHAIN pB;
  hSHARE hS;

  hS = GetShare(filename, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMB2 path: create with the file's read-only, hidden, system and archive bits, or with FILE_ATTRIBUTE_NORMAL, the
   * explicit form of "no special attributes", when none is set.
   */
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    int fh_idx;

    res = SMB2_CreateFile(hS->smb2_share, filename + 2, dos_attribs_to_smb2(pInAttr->attr), &fh_idx);
    if (res == OK) {
      *pOutFH = MAKE_SMB2_FH(fh_idx);
    }
    return res;
  }

  /* SMB1 SMBcreate: ASCII pathname after the drive-letter prefix as the data block. */
  pB = MkDataString(NULL, DATA_ASCII, filename + 2);
  if (pB == NULL) {
    return EOUTOFMEM;
  }

  /* SMBcreate parameters: attribute mask (file-only bits; ATTR_DIR is rejected by the SMB1 create path),
   * then the modify time split into two little-endian halves.
   */
  SMB_TxWords[0] = (pInAttr->attr) & (ATTR_RO | ATTR_SYS | ATTR_HID);
  SMB_TxWords[1] = (pInAttr->utime) & 0xFFFF;
  SMB_TxWords[2] = (pInAttr->utime) >> 16;

  res = Do_SMB(hS, SMBcreate, 3, pB, NULL);
  if (res == OK) {
    *pOutFH = MakeFH(hS, SMB_RxWords[0]);
  }

  return res;
}

/* ---------------- */

static int ModeXlate[4] = {MODE_RD, MODE_WR, MODE_RDWR, 0};

err_t SMB_Open(int mode, char *filename, DOS_ATTRIBS *pOutAttr, int *pOutFH, int *pOutModes) {
  err_t res;
  BUFCHAIN pB;
  hSHARE hS;

  hS = GetShare(filename, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMB2 path: open through SMB2_OpenFile and translate the wire FILE_ATTRIBUTE_* bits back into the DOS ATTR_* shape
   * FileSwitch expects.  64-bit size is clamped to FileSwitch's 4 GiB ceiling rather than wrapping silently.
   */
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    uint64_t size = 0;
    uint32_t attr = 0;
    uint64_t write_time = 0;
    int fh_idx;

    res = SMB2_OpenFile(hS->smb2_share, filename + 2, mode, &fh_idx, &size, &attr, &write_time);
    if (res == OK) {
      *pOutFH = MAKE_SMB2_FH(fh_idx);
      if (pOutAttr != NULL) {
        pOutAttr->attr = 0;
        if (attr & FILE_ATTRIBUTE_READONLY) {
          pOutAttr->attr |= ATTR_RO;
        }
        if (attr & FILE_ATTRIBUTE_HIDDEN) {
          pOutAttr->attr |= ATTR_HID;
        }
        if (attr & FILE_ATTRIBUTE_SYSTEM) {
          pOutAttr->attr |= ATTR_SYS;
        }
        if (attr & FILE_ATTRIBUTE_DIRECTORY) {
          pOutAttr->attr |= ATTR_DIR;
        }
        if (attr & FILE_ATTRIBUTE_ARCHIVE) {
          pOutAttr->attr |= ATTR_ARC;
        }
        pOutAttr->length = (size > QWORD_OVERFLOW_32) ? (int)UINT32_CLAMP : (int)size;
        pOutAttr->utime = smb2_filetime_to_utime(write_time);
      }
      if (pOutModes != NULL) {
        *pOutModes = mode;
      }
    }
    return res;
  }

  /* SMB1 path: build the filename string buffer and issue the legacy SMBopen, asking the server to surface read-only,
   * hidden and system files as well as normal ones.
   */
  pB = MkDataString(NULL, DATA_ASCII, filename + 2);
  if (pB == NULL) {
    return EOUTOFMEM;
  }

  SMB_TxWords[0] = mode;                          // Exclusive access
  SMB_TxWords[1] = ATTR_RO | ATTR_HID | ATTR_SYS; // Attribute

  res = Do_SMB(hS, SMBopen, 2, pB, NULL);
  if (res == OK) {
    *pOutFH = MakeFH(hS, SMB_RxWords[0]);

    /* Word layout: 0 FID, 1 attr, 2-3 utime (32-bit split), 4-5 length (32-bit split), 6 granted modes. */
    if (pOutAttr != NULL) {
      pOutAttr->attr = SMB_RxWords[1];
      pOutAttr->utime = SMB_RxWords[2] + (SMB_RxWords[3] << 16);
      pOutAttr->length = SMB_RxWords[4] + (SMB_RxWords[5] << 16);
    }

    if (pOutModes != NULL) {
      *pOutModes = ModeXlate[SMB_RxWords[6] & 3];
    }
  }
  return res;
}

/* ---------------- */

err_t SMB_GetLength(int FH, uint *pOutLen) {
  err_t res;
  hSHARE hS;

  /* SMB2 asks the server for the real 64-bit size; clamp to FileSwitch's 32-bit ceiling so anything past 4 GiB looks
   * like 4 GiB rather than wrapping silently.
   */
  if (IS_SMB2_FH(FH)) {
    uint64_t size;
    res = SMB2_GetLength(SMB2_FH_INDEX(FH), &size);
    if (res == OK) {
      *pOutLen = (size > 0xFFFFFFFFULL) ? 0xFFFFFFFF : (uint)size;
    }
    return res;
  }

  hS = GetShareFromFH(FH, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMB1 has no dedicated "get size" command; seek to end-of-file with zero offset and the returned
   * position is the file length.  Words: FID, whence=2 (from end), 32-bit offset split as two halves.
   */
  SMB_TxWords[0] = GetFid(FH);
  SMB_TxWords[1] = 2;
  SMB_TxWords[2] = 0;
  SMB_TxWords[3] = 0;

  res = Do_SMB(hS, SMBlseek, 4, NULL, NULL);
  if (res == OK) {
    *pOutLen = SMB_RxWords[0] + (SMB_RxWords[1] << 16);
  }

  return res;
}

/* ---------------- */

err_t SMB_Read(int FH, uint offset, uint len, uint8_t *where, uint *pOutLen) {
  uint len_left, n_read;
  int fid;
  hSHARE hS;
  BUFCHAIN pB_res;
  err_t res = OK;

  /* SMB2 handles dispatch straight to the SMB2 reader. */
  if (IS_SMB2_FH(FH)) {
    uint32_t actual = 0;
    res = SMB2_Read(SMB2_FH_INDEX(FH), (uint64_t)offset, (uint32_t)len, where, &actual);
    if (pOutLen != NULL) {
      *pOutLen = (uint)actual;
    }
    return res;
  }

  len_left = len;
  hS = GetShareFromFH(FH, &res);
  if (hS == NULL) {
    return res;
  }

  fid = GetFid(FH);

  /* Raw read fast-path: peers that advertised PROT_READRAW accept a bulk transfer with a smaller per-packet
   * header overhead, so we use it to drain everything past one MAX_RECV_SIZE.  A zero return means the server
   * declined this request, so drop into the conventional path for the remainder.
   */
  if (hS->hServer->ProtFlags & PROT_READRAW) {
    while (len_left > MAX_RECV_SIZE) {
      n_read = SMB_ReadRaw(hS, fid, offset, len_left, where);
      if (n_read == 0) {
        break;
      }

      len_left -= n_read;
      where += n_read;
      offset += n_read;
    }
  }

  /* Conventional path: loop SMBread, chunked to MAX_RECV_SIZE, until either the request is satisfied or the
   * server returns a short read (signalling end-of-file).
   */
  while (len_left > 0) {
    uint chunk = min(len_left, MAX_RECV_SIZE);

    SMB_TxWords[0] = fid;
    SMB_TxWords[1] = chunk;
    SMB_TxWords[2] = offset & 0xFFFF;
    SMB_TxWords[3] = (offset >> 16);
    SMB_TxWords[4] = (len_left);

    res = Do_SMB(hS, SMBread, 5, NULL, &pB_res);
    if (res != OK) {
      break;
    }

    /* The count is the server's: one larger than was asked for would copy past the caller's buffer and wrap len_left, and a reply
     * with no words would leave the previous command's count in its place.
     */
    if (SMB_RxWordCount < 1 || SMB_RxWords[0] > chunk) {
      FreeChain(pB_res);
      res = EPROTOCOLERR;
      break;
    }

    n_read = SMB_RxWords[0];

    if (n_read > 0) {
      /* Skip the 3-byte data header that precedes the payload, then copy the payload itself. */
      pB_res = GetData(pB_res, NULL, 3);
      pB_res = GetData(pB_res, where, n_read);

      if (pB_res == NULL) {
        res = EDATALEN;
        break;
      }

      len_left -= n_read;
      where += n_read;
      offset += n_read;
    }

    FreeChain(pB_res);

    /* Short read => end of file, no point asking again. */
    if (n_read < MAX_RECV_SIZE) {
      break;
    }
  }

  if (pOutLen != NULL) {
    *pOutLen = len - len_left;
  }
  return res;
}

/* ---------------- */

err_t SMB_Truncate(int FH, uint length) {
  BUFCHAIN pB;
  err_t res;
  hSHARE hS;

  /* SMB2 has a dedicated SetInfo for end-of-file; SMB1 has to fake it with a zero-byte write at the
   * target offset (the side-effect is the truncate).
   */
  if (IS_SMB2_FH(FH)) {
    return SMB2_Truncate(SMB2_FH_INDEX(FH), (uint64_t)length);
  }

  hS = GetShareFromFH(FH, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMB1 has no truncate command, so a zero-byte write at the target offset does it.  SMBwrite parameters: FID, zero
   * byte count, 32-bit offset split across two words, then the estimate of bytes still to write (0).  Empty data block
   * keeps the framing valid.
   */
  SMB_TxWords[0] = GetFid(FH);
  SMB_TxWords[1] = 0;
  SMB_TxWords[2] = length & 0xFFFF;
  SMB_TxWords[3] = (length >> 16);
  SMB_TxWords[4] = 0;

  pB = MkDataBlock(NULL, DATA_BLOCK, NULL, 0, false);
  if (pB == NULL) {
    return EOUTOFMEM;
  }

  return Do_SMB(hS, SMBwrite, 5, pB, NULL);
}

/* ---------------- */

err_t SMB_Write(int FH, uint offset, uint len, uint8_t *where, uint *pOutLen) {
  BUFCHAIN pB;
  uint len_left, n_written, n_count;
  int fid;
  hSHARE hS;

  err_t res = OK;

  /* SMB2 handles do their own chunking in SMB2_Write. */
  if (IS_SMB2_FH(FH)) {
    uint32_t actual = 0;
    res = SMB2_Write(SMB2_FH_INDEX(FH), (uint64_t)offset, (uint32_t)len, (const uint8_t *)where, &actual);
    if (pOutLen != NULL) {
      *pOutLen = actual;
    }
    return res;
  }

  hS = GetShareFromFH(FH, &res);
  if (hS == NULL) {
    return res;
  }

  fid = GetFid(FH);
  len_left = len;

  /* Fast path: when the server advertised PROT_WRITERAW, fire off full-sized raw write blocks as long
   * as we have enough bytes to fill one.  Anything left over after the loop falls into the conventional
   * path below.
   */
  if (hS->hServer->ProtFlags & PROT_WRITERAW) {
    while (len_left >= WRRAW_BLOCK_SIZE) {
      n_written = WRRAW_BLOCK_SIZE;
      res = SMB_WriteRaw(hS, fid, offset, n_written, where);
      if (res != OK) {
        goto finish;
      }

      len_left -= n_written;
      where += n_written;
      offset += n_written;
    }
  }

  /* Conventional path: per-request chunk is capped at 64 KiB-1 (the 16-bit count field) and at what the server's
   * negotiated max-buffer size leaves for data.  Indirect data block keeps the payload pointing at the caller's buffer
   * (no extra copy).
   */
  if (len_left > 0 && hS->hServer->maxTxBufferSize <= WRITE_OVERHEAD) {
    res = EPROTOCOLERR; // No room for any data, so every request would be a truncating zero-length write
    goto finish;
  }

  while (len_left > 0) {
    n_count = min(0xFFFF, min(len_left, hS->hServer->maxTxBufferSize - WRITE_OVERHEAD));
    SMB_TxWords[0] = fid;
    SMB_TxWords[1] = n_count;
    SMB_TxWords[2] = (uint16_t)offset;
    SMB_TxWords[3] = (uint16_t)(offset >> 16);
    SMB_TxWords[4] = min(0xFFFF, len_left); // Estimate of remainder

    pB = MkDataBlock(NULL, DATA_BLOCK, where, n_count, true);
    if (pB == NULL) {
      res = EOUTOFMEM;
      break;
    }

    res = Do_SMB(hS, SMBwrite, 5, pB, NULL);
    if (res != OK) {
      break;
    }

    /* The count is the server's; one larger than was sent would wrap len_left and send from past the buffer. */
    n_written = min(SMB_RxWords[0], n_count);
    len_left -= n_written;
    where += n_written;
    offset += n_written;

    /* A short write is the server's signal that it doesn't have room for more: stop here rather than
     * retrying and reporting how much landed.
     */
    if (n_written < n_count) {
      break;
    }
  }

finish:
  if (pOutLen != NULL) {
    *pOutLen = len - len_left;
  }
  return res;
}

/* ---------------- */

err_t SMB_Flush(int FH) {
  err_t res;
  hSHARE hS;

  if (IS_SMB2_FH(FH)) {
    return SMB2_Flush(SMB2_FH_INDEX(FH));
  }

  hS = GetShareFromFH(FH, &res);
  if (hS == NULL) {
    return res;
  }

  SMB_TxWords[0] = GetFid(FH);
  return Do_SMB(hS, SMBflush, 1, NULL, NULL);
}

/* ---------------- */

err_t SMB_Close(int FH, DOS_ATTRIBS *pAttr) {
  err_t res;
  hSHARE hS;

  /* SMB2_Close sends a non-zero utime with SET_INFO before the close and writes the server's final attributes back
   * into pAttr; the SMB1 close command carries the time in its request words.
   */
  if (IS_SMB2_FH(FH)) {
    return SMB2_Close(SMB2_FH_INDEX(FH), pAttr);
  }

  hS = GetShareFromFH(FH, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMBclose: FID then little-endian last-modified time (utime is seconds since 1970 split across two
   * 16-bit words).  The server uses this to stamp the dir entry on close.
   */
  SMB_TxWords[0] = GetFid(FH);
  SMB_TxWords[1] = pAttr->utime & 0xFFFF;
  SMB_TxWords[2] = pAttr->utime >> 16;

  return Do_SMB(hS, SMBclose, 3, NULL, NULL);
}

/* Printing routines ================================== */

err_t SMB_OpenPrinter(char drvlettr, char *idstring, int *ph_out) {
  err_t res;
  BUFCHAIN pB;
  hSHARE hS;

  hS = GetShare(&drvlettr, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMB2 has no dedicated print-spool open: it's a plain CREATE on the printer share with an empty path,
   * letting the server pick the spool filename.  The idstring is an SMB1-only job-name hint and is
   * ignored here.
   */
  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    int fh_idx;

    UNUSED(idstring);
    res = SMB2_CreateFile(hS->smb2_share, "", FILE_ATTRIBUTE_NORMAL, &fh_idx);
    if (res == OK) {
      *ph_out = MAKE_SMB2_FH(fh_idx);
    }
    return res;
  }

  /* SMB1 SMBsplopen: data block carries the print job's identification string (banner page text). */
  pB = MkDataString(NULL, DATA_ASCII, idstring);
  if (pB == NULL) {
    return EOUTOFMEM;
  }

  /* Two SMB1 parameters: zero-length setup data block, graphics print mode (raw bytes, no server-side
   * text formatting).
   */
  SMB_TxWords[0] = 0;
  SMB_TxWords[1] = 1;

  res = Do_SMB(hS, SMBsplopen, 2, pB, NULL);

  if (res == OK) {
    *ph_out = MakeFH(hS, SMB_RxWords[0]);
  }

  return res;
}

/* -------------- */

err_t SMB_WritePrinter(int PH, uint8_t *data, int datalen) {
  BUFCHAIN pB;
  hSHARE hS;
  int len;
  err_t res = OK;

  /* SMB2 prints over plain SMB2_WRITE, which needs the explicit offset that SMBsplwr does without, so a running
   * per-handle offset on the SMB2_FileEntry makes each job's data land after what it has already sent.
   */
  if (IS_SMB2_FH(PH)) {
    int idx = SMB2_FH_INDEX(PH);
    SMB2_FileEntry *fe = smb2_get_file(idx);
    uint64_t offset;
    uint32_t actual = 0;
    err_t r;

    if (fe == NULL) {
      return EFILEHANDLE;
    }

    /* Norcroft can miscompile a uint64_t struct field passed straight as an argument, so pass a local copy. */
    offset = fe->print_offset;
    r = SMB2_Write(idx, offset, (uint32_t)datalen, (const uint8_t *)data, &actual);
    if (r == OK) {
      fe->print_offset += actual;
    }
    return r;
  }

  hS = GetShareFromFH(PH, &res);
  if (hS == NULL) {
    return res;
  }

  /* SMB1 SMBsplwr: server appends to the spool, no offset needed.  Chunk to PRN_BLOCK_SIZE per request. */
  while (datalen > 0) {
    len = (datalen > PRN_BLOCK_SIZE) ? PRN_BLOCK_SIZE : datalen;
    SMB_TxWords[0] = GetFid(PH);

    pB = MkDataBlock(NULL, DATA_BLOCK, data, len, true);
    if (pB == NULL) {
      res = EOUTOFMEM;
      break;
    }

    res = Do_SMB(hS, SMBsplwr, 1, pB, NULL);
    if (res != OK) {
      break;
    }

    datalen -= len;
    data += len;
  }

  return res;
}

/* ---------------- */

err_t SMB_ClosePrinter(int PH) {
  err_t res;
  hSHARE hS;

  /* An SMB2 print job is an ordinary file, so it is closed like one. */
  if (IS_SMB2_FH(PH)) {
    return SMB2_Close(SMB2_FH_INDEX(PH), NULL);
  }

  hS = GetShareFromFH(PH, &res);
  if (hS == NULL) {
    return res;
  }

  SMB_TxWords[0] = GetFid(PH);
  return Do_SMB(hS, SMBsplclose, 1, NULL, NULL);
}

/* "Transact" (Remote-procedure-call) operations =========== */

err_t SMB_Transact(char drvlettr, char *name, struct TransactParms *pT) {
  BUFCHAIN pB, pBres;
  err_t res;
  int a, padbytes; // Temp variable
  hSHARE hS;

  hS = GetShare(&drvlettr, &res);
  if (hS == NULL) {
    return res;
  }

  if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
    return SMB2_Transact(hS->smb2_share, name, pT);
  }

  a = SMBHDR_SIZE + (14 * 2) + 2 + strlen(name) + 1;
  /* Size of SMB header, 14 word params, 2 byte data length, plus the transaction name inc. zero terminator */

  SMB_TxWords[0] = pT->parms_in_len; // Total length
  SMB_TxWords[1] = pT->data_in_len;  // Total length
  SMB_TxWords[2] = pT->parms_out_maxlen;
  SMB_TxWords[3] = pT->data_out_maxlen;
  SMB_TxWords[4] = 0;                     // Setup words to return
  SMB_TxWords[5] = 0;                     // Flags - normal
  SMB_TxWords[6] = TRANSACT_TIMEOUT;      // Timeout LSW
  SMB_TxWords[7] = 0;                     // Timeout MSW
  SMB_TxWords[8] = 0;                     // Reserved
  SMB_TxWords[9] = pT->parms_in_len;      // Length this buffer
  SMB_TxWords[10] = a;                    // Offset from SMB header to parm bytes
  SMB_TxWords[11] = pT->data_in_len;      // Length this buffer
  SMB_TxWords[12] = a + pT->parms_in_len; // Offset to data bytes
  SMB_TxWords[13] = 0;                    // Setup words being sent

  pB = NULL;

  /* Make up data chain */

  if (pT->data_in_len != 0) {
    pB = AddChain(pB, pT->data_in, pT->data_in_len);
    if (pB == NULL) {
      return EOUTOFMEM;
    }
  }

  if (pT->parms_in_len != 0) {
    pB = AddChain(pB, pT->parms_in, pT->parms_in_len);
    if (pB == NULL) {
      return EOUTOFMEM;
    }
  }

  pB = AddChain(pB, name, strlen(name) + 1);

  res = Do_SMB(hS, SMBtransact, 14, pB, &pBres);

  if (res != OK) {
    return res;
  }

  /* Now extract results */

  if (SMB_RxWordCount < 10) {
    FreeChain(pBres);
    return EDATALEN;
  }

  a = SMBHDR_SIZE + (SMB_RxWordCount)*2 + 2;
  /* Size of SMBHDR plus returned rx words plus byte count = offset of data in pBres from start of header */

  pT->parms_out_len = min(SMB_RxWords[3], pT->parms_out_maxlen);
  /* Parm bytes being returned */
  pT->data_out_len = min(SMB_RxWords[6], pT->data_out_maxlen);
  /* Data bytes being returned */

  if (pT->parms_out_len > 0) // Get parms_out
  {
    padbytes = SMB_RxWords[4] - a; /* RxWords[4] is offset;
                                          Get number of pad bytes */

    if (padbytes > 0) {
      pBres = GetData(pBres, NULL, padbytes);
    }
    pBres = GetData(pBres, pT->parms_out_buf, pT->parms_out_len);
    a += padbytes + pT->parms_out_len; // New offset value
  }

  if (pT->data_out_len > 0) // Get data_out
  {
    padbytes = SMB_RxWords[7] - a; // Number of pad bytes

    if (padbytes > 0) {
      pBres = GetData(pBres, NULL, padbytes);
    }
    pBres = GetData(pBres, pT->data_out_buf, pT->data_out_len);
  }

  if (pBres == NULL) { // Oh no! Techo fear!
    return EDATALEN;
  }

  FreeChain(pBres);
  return OK;
}

/* Perform an SMB1 TRANSACT2 operation on a connected share.
 *
 * Used for FINDFIRST/FINDNEXT directory searches and other extended operations.  The setup words follow the 14 parameter
 * words common to all Transact2 commands in SMB_TxWords, and the word count passed to Do_SMB includes them, because Do_SMB
 * writes the byte count (smb_bcc) after that many words.  That is why the setup words cannot be added to the chain the way
 * the data and parameters are.
 *
 * Parameters:
 *   hS  share handle
 *   pT  transact parameters (in/out buffers and lengths)
 *
 * Returns: OK on success, or an err_t error code
 */
static err_t SMB_Transact2(hSHARE hS, struct TransactParms *pT) {
  BUFCHAIN pB, pBres;
  err_t res;
  int iter = 0; // Response iteration number
  int a = SMBHDR_SIZE + ((14 + pT->setup_in_len) * 2) + 2;
  int pda = ((a + 3) & ~3);
  /* SMB header size, 14 params + setup words + 2 byte data length */
  int padbytes; // Temp variable
  int sc;
  int retry = 3;
  int tot_data_rcvd = 0, tot_param_rcvd = 0;

retry_transact2:
  vdebug("SMB_Transact2: processing (Tid = %#04x, sub-cmd=%#04x)...\n", hS->Tid, pT->setup_in[0]);

  SMB_TxWords[0] = pT->parms_in_len; // Total length
  SMB_TxWords[1] = pT->data_in_len;  // Total length
  SMB_TxWords[2] = pT->parms_out_maxlen;
  SMB_TxWords[3] = pT->data_out_maxlen;
  SMB_TxWords[4] = 0;                       // Setup words to return
  SMB_TxWords[5] = 0;                       // Flags - normal
  SMB_TxWords[6] = TRANSACT2_TIMEOUT;       // Timeout LSW
  SMB_TxWords[7] = 0;                       // Timeout MSW
  SMB_TxWords[8] = 0;                       // Reserved
  SMB_TxWords[9] = pT->parms_in_len;        // Length this buffer
  SMB_TxWords[10] = pda;                    // Offset from SMB header to parm bytes
  SMB_TxWords[11] = pT->data_in_len;        // Length this buffer
  SMB_TxWords[12] = pda + pT->parms_in_len; // Offset to data bytes
  SMB_TxWords[13] = pT->setup_in_len;       // Setup words being sent

  vdebug("%d bytes of parameters at offset %#x\n", pT->parms_in_len, pda);
  vdebug("%d bytes of data at offset %#x\n", pT->data_in_len, SMB_TxWords[12]);

  for (sc = 0; sc < pT->setup_in_len; ++sc) {
    SMB_TxWords[14 + sc] = pT->setup_in[sc];
  }

  pB = NULL;

  /* Make up data chain */

  if (pT->data_in_len != 0) {
    pB = AddChain(pB, pT->data_in, pT->data_in_len);
    if (pB == NULL) {
      return EOUTOFMEM;
    }
  }

  if (pT->parms_in_len != 0) {
    pB = AddChain(pB, pT->parms_in, pT->parms_in_len);
    if (pB == NULL) {
      return EOUTOFMEM;
    }
  }

  /* Add the null string: pda-a must be 1 or 3.  "D " added because that's what SAMBA does (because that's what OS/2 does) */
  pB = AddChain(pB, "\0D ", pda - a);
  if (pB == NULL) {
    return EOUTOFMEM;
  }

  res = Do_SMB(hS, SMBtrans2, 14 + pT->setup_in_len, pB, &pBres);

  if (res != OK) {
    if (SMB_RxHdr.errclass == ERRSRV && SMB_RxHdr.errlo == 1 && SMB_RxHdr.errhi == 0 && retry) {
      --retry;
      vdebug("SMB_Transact2: retrying request\n");
      goto retry_transact2;
    }
    vdebug("SMB_Transact2: Do_SMB failed\n");
    return res;
  }

  /* Now extract results: note that there may be 1 of these.
   *
   * OTOH, there may be several if the data didn't fit into the negotiated buffer sizes ...
   */
  for (iter = 0;; ++iter) {

    if (SMB_RxWordCount < 10) {
      FreeChain(pBres);
      return EDATALEN;
    }

    a = SMBHDR_SIZE + (SMB_RxWordCount)*2 + 2;
    /* Size of SMBHDR plus returned rx words plus byte count = offset of data in pBres from start of header */

    if (iter == 0) {
      /* First response will tell us how much is coming */
      pT->parms_out_len = min(SMB_RxWords[0], pT->parms_out_maxlen);
      /* Parm bytes being returned */
      pT->data_out_len = min(SMB_RxWords[1], pT->data_out_maxlen);
      /* Data bytes being returned */
      pT->setup_out_len = min(SMB_RxWords[9] & 0xFF, pT->setup_out_maxlen);

      /* setup words must come in the first packet */
      if (pT->setup_out_len > 0) // Get setup_out
      {
        memcpy(pT->setup_out, &SMB_RxWords[14], 2 * pT->setup_out_len);
      }
    }

    /* Each fragment says where in the reply it belongs; refuse one that would land outside the caller's buffers. */
    if ((pT->parms_out_len > 0 && SMB_RxWords[5] + SMB_RxWords[3] > pT->parms_out_maxlen) ||
        (pT->data_out_len > 0 && SMB_RxWords[8] + SMB_RxWords[6] > pT->data_out_maxlen)) {
      FreeChain(pBres);
      return EDATALEN;
    }

    if (pT->parms_out_len > 0 && SMB_RxWords[3]) // Get parms_out
    {
      padbytes = SMB_RxWords[4] - a; /* RxWords[4] is offset;
                                            Get number of pad bytes */

      if (padbytes > 0) {
        pBres = GetData(pBres, NULL, padbytes);
      }
      pBres = GetData(pBres, pT->parms_out_buf + SMB_RxWords[5], SMB_RxWords[3]);
      a += padbytes + SMB_RxWords[3]; // New offset value
      tot_param_rcvd += SMB_RxWords[3];
    }

    if (pT->data_out_len > 0 && SMB_RxWords[6] > 0) // Get data_out
    {
      padbytes = SMB_RxWords[7] - a; // Number of pad bytes
      if (padbytes > 0) {
        pBres = GetData(pBres, NULL, padbytes);
      }
      pBres = GetData(pBres, pT->data_out_buf + SMB_RxWords[8], SMB_RxWords[6]);
      tot_data_rcvd += SMB_RxWords[6];
    }

    if (pBres == NULL) { // Oh no! Techo fear!
      vdebug("SMB_Transact2: pBres was NULL\n");
      return EDATALEN;
    }

    FreeChain(pBres);

    if (tot_data_rcvd < pT->data_out_len || tot_param_rcvd < pT->parms_out_len) {

      do {
        /* MUST avoid recursive calls to Do_SMBResponse */
        res = Do_SMBResponse(hS, SMBtrans2, &pBres);
      } while (res == OK && SMB_RxHdr.command == SMBchkpth);

      if (res != OK) {
        return res;
      }
      /* Extract received data */
      vdebug("Transact2 (2ndary response) - returned %d bytes\n", ChainLen(pBres));
    } else {
      break;
    }
  }

  return OK;
}

/* Utility routines ============================================ */

const char *SMB_GetConnInfo(char drvletter, int infotype) {
  static char sharetype[20];
  char token[8];
  hSHARE hS = GetShareNoConn(drvletter);

  if (hS == NULL) {
    return NULL;
  }

  /* All returned pointers reference internal storage (per-share state or the static sharetype buffer);
   * the caller must consume them before the next call that might overwrite the same memory.
   */
  switch (infotype) {
  case GCI_SERVER:
    return hS->hServer->servname;

  case GCI_USER:
    return hS->hServer->username;

  case GCI_SHARE:
    return hS->sharename;

  case GCI_LOGONTYPE:
    return "U"; // Always user-level authentication

  /* Share type is a small integer; map it to a localised label via the message file. */
  case GCI_SHARETYPE:
    sprintf(token, "Type%d", hS->sharetype);
    strcpyn(sharetype, MsgLookup(token), sizeof(sharetype));
    return sharetype;

  case GCI_SERVERINFO:
    return NB_DescribeLink(hS->hServer->hSession);

  case GCI_LIVENESS:
    return hS->hServer->dead ? "dead" : "alive";
  }

  return "";
}

/* Init routines ================================================ */

bool SMB_Init(void) {
  int i;

  /* Mark every server slot free. */
  for (i = 0; i < MAX_SHARES; i++) {
    SMB_Servers[i].flags = FREE;
  }

  /* Each share slot owns a fixed drive letter and a 16-bit-shifted FH base so SMB1 file handles can
   * pack (share_idx << 16) | fid without recomputation per call.
   */
  for (i = 0; i < MAX_SHARES; i++) {
    SMB_Shares[i].flags = FREE;
    SMB_Shares[i].drvletter = 'A' + i;
    SMB_Shares[i].FH_base = (i << 16);
  }

  /* Pre-fill the SMB1 transmit-header template: the four-byte protocol identifier never changes, and
   * the multiplex and process IDs stay fixed because we don't use multiplexing.  The tree ID is only a
   * starting value, since each request sets it from its own share.
   */
  SMB_TxHdr.id[0] = 0xFF;
  SMB_TxHdr.id[1] = 'S';
  SMB_TxHdr.id[2] = 'M';
  SMB_TxHdr.id[3] = 'B';

  SMB_TxHdr.mid = 0;
  SMB_TxHdr.pid = 1;
  SMB_TxHdr.tid = 0;
  SMB_TxHdr.flg2 = SMB_KNOWS_LONG_NAMES; /*| SMB_IS_LONG_NAME;*/
  NameCache_Init();
  return true;
}

/* ----------------------------------------- */

err_t SMB_Shutdown(void) {
  int i;
  for (i = 0; i < MAX_SHARES; i++) {
    SMB_DeleteShare('A' + i);
  }

  return OK;
}

/* ---------------------------- */

void SMB_AntiIdle(void) {
  static uint letter = -1;
  hSHARE hS;
  int i;

  /* Pass 1: offer every dead server a probe on each call, because a rotation would delay one mount's recovery by up to
   * MAX_SERVERS calls; TryRecoverServer limits how often each one is really probed.  A server with no cached address is left
   * dead, because probing it would mean resolving its name, which can block on DNS or NetBIOS for longer than the background
   * may wait; the next filing-system call reconnects it, with the user expecting to wait.
   */
  for (i = 0; i < MAX_SERVERS; i++) {
    hSERVER hSrv = &SMB_Servers[i];
    if ((hSrv->flags & ALLOCATED) && hSrv->dead && hSrv->cached_ip != 0u) {
      TryRecoverServer(hSrv);
    }
  }

  /* Pass 2: rotate through shares for the live-server keepalive. */
  ++letter;
  if (letter >= MAX_SHARES) {
    letter = 0;
  }
  hS = GetShareNoConn('A' + letter);
  if (hS == NULL || hS->hServer->dead) {
    return;
  }

  /* Ping the chosen share's server once its connection has been quiet for KEEPALIVE_IDLE_CS, so the peer keeps the
   * session open.  SMB2 sends an ECHO, whose failure marks the server dead so the probe takes over.
   */
  if (hS->hServer->protocol_version == 2 && hS->hServer->smb2_srv != NULL) {
    if (LM_Tick() - hS->hServer->smb2_srv->last_reply > KEEPALIVE_IDLE_CS) {
      err_t echo_res;
      dprintf(("idle_1", "Anti idle-out (SMB2 ECHO): share %c\n", 'A' + letter));
      echo_res = SMB2_Echo(hS->hServer->smb2_srv);
      if (echo_res != OK) {
        debug("Anti idle-out: SMB2 ECHO failed on share %c (err %d), marking server dead\n", 'A' + letter, echo_res);
        MarkServerDead(hS->hServer, "anti-idle ECHO fail");
      }
    }
  } else {
    time_t t;
    (void)time(&t);

    /* SMB1 checks the share root's path, its cheapest round trip, over a link that is still up.  A dropped link is marked
     * dead and left to the next filing-system call, because reconnecting it here would hold up the desktop through name
     * resolution and connect.
     */
    if (t > hS->hServer->last_xact + (time_t)(KEEPALIVE_IDLE_CS / 100u)) {
      if (!NB_LinkOK(hS->hServer->hSession)) {
        MarkServerDead(hS->hServer, "SMB1 NB_LinkOK fail");
      } else {
        char echodat[sizeof("A:\\")];
        (void)sprintf(echodat, "%c:\\", 'A' + letter);
        dprintf(("idle_1", "Anti idle-out measure: %s\n", echodat));
        if (ELANMANFSINUSE == SMB_ChkPath(echodat)) {
          dprintf(("idle_1", "Re-entrancy due to idle-out check prevented\n"));
        }
      }
    }
  }
}

/* Close an SMB1 FINDFIRST/FINDNEXT search handle. */
static err_t SMBFind_Close(SMBFind_t *fnd) {
  if (fnd == NULL) {
    return OK;
  }
  if (fnd->hS != NULL && fnd->SID != 0) {
    /* A share dismounted mid-search has no tree left to close the search on. */
    if (ShareSlotLive(fnd->hS)) {
      SMB_AbandonFind2(fnd->hS, fnd->SID);
    }
    fnd->hS = NULL;
    fnd->SID = 0;
  }
  return OK;
}

err_t SMBFind_EnumDir(SMBFind_t *fnd, int dir_offset, const char *ro_path, int count, ENUM_DIR_FN dirfn, void *dirfn_handle,
                      int *dir_offset_out) {
  static char DOSnamebuf[512];
  err_t err = OK;
  uint8_t *p;
  int SearchCount = 0;
  int EndOfSearch;
  int length, i;
  uint8_t *data_end;

  struct TransactParms tp;

  if (dir_offset < 0) {
    *dir_offset_out = -1;
    return OK;
  }

  /*
   *  Wipe and FilerAct reduce dir_offset by 1 for every file deleted during
   *  enumeration.
   *
   *  dir_offset is set to the offset into the directory of the next entry in the
   *  low 2 bytes (low_offset) and a copy of this in the high 2 bytes (hi_offset).
   *
   *  The directory enumeration can continue with the existing FIND_FIRST SID if:
   *     1) hi_offset is the same as the stored offset - ResumeKey is valid.
   *     2) hi_offset = low_offset - if they are different deletions have occurred.
   *     3) directory paths are the same.
   *     4) the search is still open.  The server's end of search closes it
   *        even when the caller's buffer had no room for the last entries,
   *        and a restart then fetches those.
   *
   *  Otherwise the find is restarted and files are skipped until the offset
   *  is low_offset.
   */

  if (dir_offset == 0 || !ShareSlotLive(fnd->hS) || SMBFind_GetOffsetHi(dir_offset) != fnd->Offset ||
      SMBFind_GetOffsetHi(dir_offset) != SMBFind_GetOffsetLow(dir_offset) || strcmp(fnd->ROPath, ro_path) != 0) {
    SMBFind_Close(fnd);

    err = Xlt_ConvertPath((char *)ro_path, DOSnamebuf);
    if (err != OK) {
      return err;
    }
    if (DOSnamebuf[strlen(DOSnamebuf) - 1] != '\\') {
      strcat(DOSnamebuf, "\\");
    }
    strcat(DOSnamebuf, "*");

    hSHARE hS = GetShare(DOSnamebuf, &err);
    if (err) {
      return err;
    }

    /* SMB2 dispatch, seldom reached: Func_ReadDir1 in CoreFn lists an SMB2 mount itself and falls through to here only when it could
     * not resolve the share up front.  The "\*" wildcard is stripped from a local copy, because DOSnamebuf is static.  SMB2 has no
     * resumable search, so dir_offset is a skip count and fnd->hS stays NULL, which brings every call for the mount back here.
     */
    if (hS->hServer->protocol_version == 2 && hS->smb2_share != NULL) {
      char dirpath[256];
      const char *src;
      int dirlen;

      strncpy(dirpath, DOSnamebuf + 2, sizeof(dirpath) - 1);
      dirpath[sizeof(dirpath) - 1] = '\0';
      dirlen = (int)strlen(dirpath);

      if (dirlen >= 2 && dirpath[dirlen - 1] == '*' && dirpath[dirlen - 2] == '\\') {
        dirpath[dirlen - 2] = '\0';
      }

      src = dirpath;
      while (*src == '\\') {
        src++;
      }

      vdebug("SMBFind_EnumDir: dispatching to SMB2 for \"%s\"\n", src);
      return SMB2_ReadDirEntries(hS->smb2_share, src, count, dirfn, dirfn_handle, dir_offset, dir_offset_out);
    }

    fnd->hS = hS;

    strcpy(fnd->ROPath, ro_path);

    count += 2; // include . and ..

    /* Initial search: note we accept SIX return parameters, contrary to Microsoft's own document, because it doesn't work if
     * you only pass 5.
     *
     * Grr.
     */
    Transact_init(&tp, 6 * 2); // sizeof response Trans2_Parameters - 6 WORDs
    Transact_addsetupword(&tp, TRANSACT2_FINDFIRST);
    /* Trans2_Parameters */
    if (LM_Vars.namemode & NM_HIDDEN) {
      Transact_addword(&tp, ATTR_DIR | ATTR_SYS | ATTR_HID); // SearchAttributes
    } else {
      Transact_addword(&tp, ATTR_DIR); // SearchAttributes
    }
    Transact_addword(&tp, count);              // SearchCount
    Transact_addword(&tp, ffirst_RETURN_KEYS); // Flags
    Transact_addword(&tp, 1);                  // InformationLevel
    Transact_addlong(&tp, 0L);                 // SearchStorageType -MBZ
    Transact_addstring(&tp, DOSnamebuf + 2);   // FileName[]
    err = SMB_Transact2(hS, &tp);
    if (err != OK) {
      return err;
    }
    p = tp.parms_out_buf;

    fnd->SID = Transact_getword(p);
    p += 2;

    fnd->Resume = dir_offset != 0 ? fnd->Resume = SMBFind_GetOffsetLow(dir_offset) : 0;

    fnd->Offset = 0;
  } else {
    /* Continuation */
    Transact_init(&tp, 4 * 2); // sizeof response Trans2_Parameters 4 Words
    Transact_addsetupword(&tp, TRANSACT2_FINDNEXT);
    Transact_addword(&tp, fnd->SID);           // SID
    Transact_addword(&tp, count);              // SearchCount
    Transact_addword(&tp, 1);                  // InformationLevel
    Transact_addlong(&tp, fnd->ResumeKey);     /* ResumeKey*/
    Transact_addword(&tp, ffirst_RETURN_KEYS); // Flags
    Transact_addstring(&tp, fnd->FileName);
    err = SMB_Transact2(fnd->hS, &tp);
    if (err != OK) {
      return err;
    }
    p = tp.parms_out_buf;
  }

  SearchCount = Transact_getword(p);
  p += 2;
  EndOfSearch = Transact_getword(p);
  p += 2;

  if (EndOfSearch) {
    vdebug(">> Server said it was the end of the search operation\n");
  }

  data_end = tp.data_out_buf + tp.data_out_len;

  for (i = 0, p = tp.data_out_buf; i < SearchCount; i++, p += 27 + length + 1) {
    uint8_t *fname;
    bool taken;

    /* SearchCount and the per-record name length are wire-controlled, so stop before walking past the data the
     * server actually returned: check the fixed 27-byte header (which carries the length at [26]) is present,
     * then that the whole variable-length record fits.  With no record read, the caller would ask for the same
     * entries again, so give up.
     */
    if (p + 27 > data_end || p + 27 + (int)p[26] + 1 > data_end) {
      if (i == 0) {
        SMBFind_Close(fnd);
        return EDATALEN;
      }
      break;
    }
    length = p[26];
    fname = p + 27;

    if (((length == 1) && (fname[0] == '.') && (fname[1] == 0)) ||
        ((length == 2) && (fname[0] == '.') && (fname[1] == '.') && (fname[2] == 0))) {
      continue;
    }

    taken = true; // Store resume info if skipping files
    if (fnd->Offset >= fnd->Resume) {
      err = dirfn(p + 4, 1, &taken, dirfn_handle, fnd->hS);
      if (err != OK) {
        /* Entry expander must have run out of space! */
        return EOUTOFMEM;
      }
    }

    if (taken) {
      fnd->Offset++;
      *dir_offset_out = SMBFind_SetOffset(fnd->Offset);
      fnd->ResumeKey = Transact_getlong(p);
      strncpy(fnd->FileName, (char *)fname, sizeof(fnd->FileName) - 1u);
      fnd->FileName[sizeof(fnd->FileName) - 1u] = '\0'; // a 255-byte name need not be terminated, and the next search sends it as a string
    }
  }

  if (EndOfSearch || SearchCount == 0) {
    SMBFind_Close(fnd);
    return ENOMOREFILES;
  }

  return OK;
}

int SMB_GetCurrentServerTimeZone(hSHARE hS) {
  return (hS != NULL && hS->hServer != NULL) ? hS->hServer->serverTimeZone : 0;
}

hSHARE SMB_GetShareFileHandle(uint SMB_FH) {
  err_t res;
  return GetShareFromFH(SMB_FH, &res);
}

hSHARE SMB_GetShareFileName(const char *dos_filename) {
  err_t res;
  return GetShare(dos_filename, &res);
}

struct LMCache *SMB_GetCache(hSHARE hS) {
  /* On a dead-marked server, return NULL so cache lookups in the FSEntry handlers all miss and nothing is served
   * from entries that may have gone stale while the server was unreachable.  The handler then falls through to
   * the wire, which goes through GetShare: that fails fast with ELINKFAILED while the recovery probe has a cached
   * address to try, and otherwise reconnects, so the user sees an error or fresh data rather than stale data.
   */
  if (hS == NULL || hS->hServer->dead) {
    return NULL;
  }
  return hS->cache;
}

struct LMCache *SMB_GetCacheFromDrv(char drvletter) {
  hSHARE hS = GetShareNoConn(drvletter);
  return (hS != NULL) ? hS->cache : NULL;
}

err_t SMB_CheckInertSymlink(hSHARE hS, const char *cache_key) {
  LMCache_t *cache;
  LMCacheNode_t *node;

  if (hS == NULL || cache_key == NULL) {
    return OK;
  }
  cache = SMB_GetCache(hS);
  if (cache == NULL) {
    return OK;
  }

  /* Cache keys are stored without the leading backslash, so trim any the key arrives with. */
  while (*cache_key == '\\') {
    cache_key++;
  }

  /* No cnode, not a file, or no inert-symlink flag -> nothing to retry; treat as success. */
  node = Cache_Lookup(cache, cache_key);
  if (node == NULL || node->obj_type != LMCACHE_OBJECT_FILE || ((node->flags & LMCACHE_FLAG_INERT_SYMLINK) == 0u)) {
    return OK;
  }

  /* Only an SMB2 listing marks a cnode inert, so the share is an SMB2 one. */
  return SMB2_RetryInertSymlink(hS->smb2_share, node, cache_key);
}

bool SMB_EnumerateSMB2Directory(hSHARE hS, const char *dir_path, const struct SMB2_ListingStart *from, Cache_EnumVisitor_t visitor,
                                void *user, err_t *err_out) {
  if (hS == NULL || hS->hServer == NULL || hS->hServer->protocol_version != 2 || hS->smb2_share == NULL) {
    return false;
  }

  *err_out = SMB2_EnumerateDirectory(hS->smb2_share, dir_path, from, visitor, user);
  return true;
}

bool SMB_FindLeafSMB2(const char *dir_path, const char *sought, const char *pattern, SMB2_LeafMatch_t equivalent, char *leaf_out,
                      err_t *err_out) {
  err_t res;
  hSHARE hS = GetShare(dir_path, &res);

  if (hS == NULL || hS->hServer->protocol_version != 2 || hS->smb2_share == NULL) {
    return false;
  }

  *err_out = SMB2_FindLeaf(hS->smb2_share, dir_path + 2, sought, pattern, equivalent, leaf_out);
  return true;
}

const char *SMB_GetPathFromFH(int FH) {
  if (IS_SMB2_FH(FH)) {
    SMB2_FileEntry *fe = smb2_get_file(SMB2_FH_INDEX(FH));
    if (fe != NULL && fe->dos_path[0] != '\0') {
      return fe->dos_path;
    }
  }
  return NULL;
}

hSHARE SMB_GetShareFromDrv(char drvletter) {
  return GetShareNoConn(drvletter);
}
