static uint32_t smb_disconnects; // shares disconnected so far; see SMB_DisconnectCount

uint32_t SMB_DisconnectCount(void) {
  return smb_disconnects;
}

err_t SMB_DeleteShare(char drvlettr) {
  hSHARE hS;
  hSERVER hSrv;

  hS = GetShareNoConn(drvlettr);
  if (hS == NULL) {
    return EBADDRV;
  }

  hSrv = hS->hServer;

  /* The drive letter may next name a different share, so a path remembered under it means nothing any more. */
  Xlt_ForgetTranslation();
  smb_disconnects++;

  /* Do Tree disconnect */

  DisconnectShare(hS);

  /* Tear down the per-mount cache before releasing the share slot.  Cache_MountDestroy walks the global handle
   * table and clears any FileSwitch handles bound to this cache, so a half-closed handle can't outlive the
   * substrate it referenced.
   */
  if (hS->cache != NULL) {
    Cache_MountDestroy(hS->cache);
    hS->cache = NULL;
  }

  FreeShare(hS);

  /* If there are no shares left on this server, drop link */

  if (!ServerInUse(hSrv)) {
    DisconnectServer(hSrv);
    FreeServer(hSrv);
  }

  return OK;
}

