/* Report whether a response may arrive unsigned on a signed session.
 *
 * Servers do not sign an interim STATUS_PENDING or an oplock break (whose message id is all ones), and cannot sign
 * STATUS_USER_SESSION_DELETED, because the session and its key are already gone.
 *
 * Parameters:
 *   hdr  parsed response header
 *
 * Returns: true if the response is one of those.
 */
static bool smb2_may_be_unsigned(const SMB2_HEADER *hdr) {
  return hdr->Status == STATUS_PENDING || hdr->Status == STATUS_USER_SESSION_DELETED || hdr->MessageId == SMB2_UNSOLICITED_MESSAGE_ID;
}

/* True for a command that sets up a session or closes a session or tree, whose failure says nothing about one in use. */
static bool smb2_sets_up_or_closes(uint16_t command) {
  return command == SMB2_NEGOTIATE || command == SMB2_SESSION_SETUP || command == SMB2_LOGOFF || command == SMB2_TREE_DISCONNECT;
}

/* Check a response's signature before anything acts on it.
 *
 * On a signed session an unsigned response is refused like a bad signature (MS-SMB2 3.2.5.1.3), or anyone on the path could clear
 * the flag and rewrite it; only the replies a server does not sign are let through.
 *
 * Parameters:
 *   srv  server the response came from
 *   buf  the received frame
 *   len  length of the frame in bytes
 *   hdr  its parsed header
 *
 * Returns: true if the response may be trusted.
 */
static bool smb2_response_signature_ok(SMB2_Server *srv, const uint8_t *buf, int len, const SMB2_HEADER *hdr) {
  /* An unsigned session has nothing to check. */
  if (!(srv->flags & SMB2_SRV_SIGNED)) {
    return true;
  }

  /* A signed response must verify; an unsigned one passes only if it is a reply the server never signs. */
  if (hdr->Flags & SMB2_FLAGS_SIGNED) {
    if (!smb2_verify_signature(srv, buf, len)) {
      debug("SMB2: signature verification failed\n");
      return false;
    }
  } else if (!smb2_may_be_unsigned(hdr)) {
    debug("SMB2: signature verification failed: unsigned response cmd=%04X status=0x%08X\n", hdr->Command, (unsigned)hdr->Status);
    return false;
  }

  return true;
}

/*
 * Spend the credits a request charges, before it is sent (MS-SMB2 3.2.4.1.5).
 *
 * The balance floors at zero rather than wrapping if the charge is more than is held.
 *
 * Parameters:
 *   srv      server connection whose balance pays
 *   req_buf  framed request, whose header carries the charge
 */
static void smb2_spend_credits(SMB2_Server *srv, const uint8_t *req_buf) {
  uint16_t charge = smb2_get_word(req_buf + SMB2_HEADER_CREDIT_CHARGE_OFFSET);

  if (charge > srv->credits_available) {
    debug("SMB2: credit underflow: charge=%d available=%d\n", (int)charge, (int)srv->credits_available);
    srv->credits_available = 0u;
  } else {
    srv->credits_available = (uint16_t)(srv->credits_available - charge);
  }
}

/*
 * Act on a CHANGE_NOTIFY completion: refresh the Filer windows it calls for and flag the watch it ends for re-arming.
 *
 * SMB2_SendRecv meets completions that arrive ahead of its own reply, and smb2_drain_pending_async collects the rest while the
 * connection is otherwise quiet.
 *
 * Parameters:
 *   srv        server connection the frame arrived on
 *   hdr        parsed header of the frame
 *   frame      the whole frame, header first
 *   frame_len  length of the frame in bytes
 *
 * Returns: true if the frame completes a share's outstanding watch; false if no share is waiting for its message id.
 */
static bool smb2_notify_completion(const SMB2_Server *srv, const SMB2_HEADER *hdr, const uint8_t *frame, int frame_len) {
  int i;

  /* Find the share whose outstanding watch this frame completes. */
  for (i = 0; i < SMB2_MAX_SHARES; i++) {
    SMB2_Share *share = &smb2_shares[i];
    const uint8_t *body = frame + SMB2_HEADER_SIZE;

    if (share->server != srv || !share->notify_pending || share->notify_msg_id != hdr->MessageId) {
      continue;
    }

    share->notify_pending = false;

    /* STATUS_NOTIFY_ENUM_DIR: the server's buffer overflowed and what changed cannot be known, so tell the cache and refresh every Filer
     * viewer.
     */
    if (hdr->Status == STATUS_NOTIFY_ENUM_DIR) {
      hSHARE hS_overflow = SMB_GetShareFromDrv(share->drvletter);
      LMCache_t *cache_overflow = (hS_overflow != NULL) ? SMB_GetCache(hS_overflow) : NULL;

      debug("SMB2: [%d] CHANGE_NOTIFY overflow on share %c \"%s\": full Filer refresh\n", smb2_tick(), share->drvletter, share->sharename);
      Cache_NotifyOverflow(cache_overflow);
      smb2_filer_upcall(share, NULL, upfsfile_Create);
    } else if (!NT_STATUS_IS_ERROR(hdr->Status) && frame_len > SMB2_HEADER_SIZE + SMB2_CHANGE_NOTIFY_RESP_MIN &&
               smb2_get_word(body + SMB2_CHANGE_NOTIFY_RESP_STRUCT_SIZE_OFFSET) == SMB2_CHANGE_NOTIFY_RESP_SIZE) {
      uint16_t out_offset = smb2_get_word(body + SMB2_CHANGE_NOTIFY_RESP_OUTPUT_POS_OFFSET);
      uint32_t out_length = smb2_get_dword(body + SMB2_CHANGE_NOTIFY_RESP_OUTPUT_LEN_OFFSET);

      /* A well-formed change list is walked once its region is checked to lie within the frame. */
      if (out_length > 0u && (uint32_t)out_offset <= (uint32_t)frame_len && out_length <= (uint32_t)frame_len - (uint32_t)out_offset) {
        smb2_process_notify_entries(share, frame + out_offset, out_length);
      }
    }

    smb2_notify_completed(share, hdr->Status);
    return true;
  }

  return false;
}

/*
 * Take in the reply to a CLOSE sent without waiting, if that is what a reply is.
 *
 * Parameters:
 *   srv     server the reply came from
 *   msg_id  message id of the reply
 *
 * Returns: true if it was such a reply, which then needs nothing more done with it.
 */
static bool smb2_take_unanswered_close(const SMB2_Server *srv, uint64_t msg_id) {
  int i;

  for (i = 0; i < SMB2_UNANSWERED_CLOSES; i++) {
    if (smb2_unanswered_closes[i].srv == srv && smb2_unanswered_closes[i].msg_id == msg_id) {
      smb2_unanswered_closes[i].srv = NULL;
      return true;
    }
  }

  return false;
}

uint32_t SMB2_SendRecv(SMB2_Server *srv, uint8_t *req_buf, int req_len, uint8_t *resp_buf, int resp_bufsize, int *resp_len_out) {
  /* Capture this request's message id and open a single deadline that every send and receive below shares. */
  SMB2_HEADER resp_hdr;
  err_t res;
  uint64_t sent_msg_id = smb2_get_qword(req_buf + SMB2_HEADER_MESSAGE_ID_OFFSET);
  uint32_t ret;

  uint32_t t_start = LM_Tick();
  uint deadline = t_start + smb2_deadline_cs();
#ifdef SMB2_DEBUG_VERBOSE
  uint16_t wire_cmd = smb2_get_word(req_buf + SMB2_HEADER_COMMAND_OFFSET);
#endif

  smb2_lookup.valid = false; // whatever comes of this request, the last lookup no longer describes the server's latest state

  /* Refuse re-entry: a TaskWindow can suspend an exchange mid-SWI, and nothing may start its own wire I/O until it resumes. */
  if (smb2_sendrecv_active) {
    debug("SMB2: SendRecv re-entrancy blocked\n");
    return STATUS_SMB2_REENTRANT;
  }

  /* Fast-fail a connection already marked dead rather than waiting out another timeout. */
  if (srv->flags & SMB2_SRV_DEAD) {
    debug("SMB2: SendRecv on dead server connection - fast-failing\n");
    return STATUS_NETWORK_NAME_DELETED;
  }

  /* Claim the busy flag for the whole exchange so the keep-alive callback stays off the socket, and show the hourglass if the
   * exchange runs long.
   */
  (void)_swix(Hourglass_Start, _IN(0), HOURGLASS_DELAY_CS);

  smb2_sendrecv_active = true;

  /* Sign last, once the header is final, so the MAC covers the frame as it goes on the wire. */
  if (srv->flags & SMB2_SRV_SIGNED) {
    smb2_sign_message(srv, req_buf, req_len);
  }

  smb2_spend_credits(srv, req_buf);

  res = SMB2X_Send(srv->raw_socket, req_buf, req_len, deadline);

  /* A send failure will not recover mid-exchange: mark the connection dead and give up. */
  if (res != OK) {
    if (res == ETIMEOUT) {
      debug("SMB2: send timed out cmd=%04X msgid=0x%08X waited=%dcs: marking connection dead\n",
            smb2_get_word(req_buf + SMB2_HEADER_COMMAND_OFFSET), (unsigned)sent_msg_id, (int)(LM_Tick() - t_start));
      SMB_MarkServerDeadBySMB2(srv, "send timeout");
    } else {
      debug("SMB2: send link failed cmd=%04X msgid=0x%08X waited=%dcs res=%d: marking connection dead\n",
            smb2_get_word(req_buf + SMB2_HEADER_COMMAND_OFFSET), (unsigned)sent_msg_id, (int)(LM_Tick() - t_start), res);
      SMB_MarkServerDeadBySMB2(srv, "send link failure");
    }

    ret = STATUS_NETWORK_NAME_DELETED;
    goto exit;
  }

  /* Read responses until this request's response arrives, acting on any notification or oplock break that comes first.  Each interim
   * acknowledgement of it restarts the deadline at the longer allowance for a pending answer.
   */
  for (;;) {
    res = SMB2X_Recv(srv->raw_socket, resp_buf, resp_bufsize, deadline, resp_len_out);

    /* A receive failure will not recover mid-exchange either: mark the connection dead and give up. */
    if (res != OK) {
      if (res == ETIMEOUT) {
        debug("SMB2: recv timed out cmd=%04X msgid=0x%08X waited=%dcs: marking connection dead\n",
              smb2_get_word(req_buf + SMB2_HEADER_COMMAND_OFFSET), (unsigned)sent_msg_id, (int)(LM_Tick() - t_start));
        SMB_MarkServerDeadBySMB2(srv, "recv timeout");
      } else {
        debug("SMB2: recv link failed cmd=%04X msgid=0x%08X waited=%dcs res=%d: marking connection dead\n",
              smb2_get_word(req_buf + SMB2_HEADER_COMMAND_OFFSET), (unsigned)sent_msg_id, (int)(LM_Tick() - t_start), res);
        SMB_MarkServerDeadBySMB2(srv, "recv link failure");
      }

      ret = STATUS_NETWORK_NAME_DELETED;
      goto exit;
    }

    /* Reject a runt or unparseable frame.  Our reply is still queued behind it, so every later exchange would read the wrong
     * frame: mark the connection dead, as the timeouts do.
     */
    if (*resp_len_out < SMB2_HEADER_SIZE || !smb2_parse_response_header(resp_buf, &resp_hdr)) {
      SMB_MarkServerDeadBySMB2(srv, "unparseable response");
      ret = STATUS_INVALID_PARAMETER;
      goto exit;
    }

    /* Fail the exchange as access denied on a bad signature, and drop the connection for the same reason. */
    if (!smb2_response_signature_ok(srv, resp_buf, *resp_len_out, &resp_hdr)) {
      SMB_MarkServerDeadBySMB2(srv, "signature check failed");
      ret = STATUS_ACCESS_DENIED;
      goto exit;
    }

    /* Fold granted credits back into the running balance. */
    if (resp_hdr.CreditReqResp > 0) {
      uint32_t new_balance = (uint32_t)srv->credits_available + (uint32_t)resp_hdr.CreditReqResp;

      /* Saturate rather than overflow the 16-bit balance. */
      if (new_balance > UINT16_MAX) {
        new_balance = UINT16_MAX;
      }

      srv->credits_available = (uint16_t)new_balance;
    }

    /* STATUS_PENDING is an interim ack, not the response: keep reading. */
    if (resp_hdr.Status == STATUS_PENDING) {
      vdebug("SMB2: [%d] interim STATUS_PENDING for cmd=%04X, reading next\n", smb2_tick(), resp_hdr.Command);

      /* The server is alive and working on this request, so a slow answer must not be taken for a dead connection.  The
       * background timer still cannot wait long for it.
       */
      if (resp_hdr.MessageId == sent_msg_id) {
        deadline = LM_Tick() + (smb2_background ? SMB2_BACKGROUND_DEADLINE_CS : SMB2_PENDING_DEADLINE_CS);
      }

      continue;
    }

    /* Message id matches: this is its response, hand back its status. */
    if (resp_hdr.MessageId == sent_msg_id) {
      srv->last_reply = LM_Tick(); // the keep-alive waits for the connection to be quiet for a while after this
      ret = resp_hdr.Status;

      /* The server has closed the session or the tree under us (an administrator closing it, say), and every later request on it
       * would fail the same way.  Mark the connection dead, so the recovery probe connects afresh.  Closing them ourselves, or
       * setting them up, can draw these statuses without anything being lost.
       */
      if ((ret == STATUS_USER_SESSION_DELETED || ret == STATUS_NETWORK_SESSION_EXPIRED || ret == STATUS_NETWORK_NAME_DELETED) &&
          !smb2_sets_up_or_closes(resp_hdr.Command)) {
        debug("SMB2: cmd=%04X status=0x%08X: session or tree closed by the server, marking connection dead\n", resp_hdr.Command,
              (unsigned)ret);
        SMB_MarkServerDeadBySMB2(srv, "session or tree closed by the server");
      }

      goto exit;
    }

    /* The reply to a CLOSE sent without waiting: keep waiting for the response. */
    if (smb2_take_unanswered_close(srv, resp_hdr.MessageId)) {
      continue;
    }

    /* An async CHANGE_NOTIFY completion interleaved ahead of the response: act on it, then keep waiting for the response. */
    if (resp_hdr.Command == SMB2_CHANGE_NOTIFY) {
      debug("SMB2 INTERLEAVED CHANGE_NOTIFY msgid=0x%08X%08X status=0x%08X len=%d while waiting for cmd=%04X"
            " sent_msgid=0x%08X%08X\n",
            (uint32_t)(resp_hdr.MessageId >> 32), (uint32_t)resp_hdr.MessageId, (unsigned)resp_hdr.Status, *resp_len_out,
            smb2_get_word(req_buf + SMB2_HEADER_COMMAND_OFFSET), (uint32_t)(sent_msg_id >> 32), (uint32_t)sent_msg_id);

      if (!smb2_notify_completion(srv, &resp_hdr, resp_buf, *resp_len_out)) {
        debug("SMB2 INTERLEAVED CHANGE_NOTIFY UNMATCHED msgid=0x%08X%08X (no share notify_msg_id matches)\n",
              (uint32_t)(resp_hdr.MessageId >> 32), (uint32_t)resp_hdr.MessageId);
      }

      continue;
    }

    /* No open ever asks for an oplock, so a break notification is unexpected; consume it and keep waiting for the response. */
    if (resp_hdr.Command == SMB2_OPLOCK_BREAK) {
      debug("SMB2: unsolicited oplock break ignored\n");
      continue;
    }

    /* Any other unmatched response is a protocol error that cannot be recovered from, and leaves the stream out of step. */
    debug("SMB2 UNEXPECTED resp cmd=%04X status=0x%08X len=%d msgid=0x%08X%08X"
          " (expected cmd=%04X msgid=0x%08X%08X)\n",
          resp_hdr.Command, (unsigned)resp_hdr.Status, *resp_len_out, (uint32_t)(resp_hdr.MessageId >> 32), (uint32_t)resp_hdr.MessageId,
          smb2_get_word(req_buf + SMB2_HEADER_COMMAND_OFFSET), (uint32_t)(sent_msg_id >> 32), (uint32_t)sent_msg_id);
    SMB_MarkServerDeadBySMB2(srv, "unexpected response");
    ret = STATUS_INVALID_PARAMETER;
    goto exit;
  }

exit:
  smb2_sendrecv_active = false;
  (void)_swix(Hourglass_Off, 0);

  vdebug("WIRE %-13s status=0x%08X time=%dcs\n", smb2_cmd_name(wire_cmd), (unsigned)ret, (int)(LM_Tick() - t_start));

  return ret;
}

/*
 * Translate an SMB2 NT STATUS code into the RISC OS filing-system error number.
 *
 * Parameters:
 *   status  NT STATUS from a response header
 *
 * Returns: OK for STATUS_SUCCESS, otherwise the error the status maps to (a generic server error for a status not listed).
 */
static err_t smb2_status_to_err(uint32_t status) {
  /* Translate each NT STATUS handled here into its RISC OS error.  Only STATUS_SUCCESS gives OK. */
  switch (status) {
  case STATUS_SUCCESS:
    return OK;

  case STATUS_NO_SUCH_FILE:
  case STATUS_OBJECT_NAME_NOT_FOUND:
    return EFILENOTFOUND;

  case STATUS_OBJECT_PATH_NOT_FOUND:
  case STATUS_OBJECT_PATH_INVALID:
  case STATUS_OBJECT_PATH_SYNTAX_BAD:
    return EPATHNOTFOUND;

  case STATUS_ACCESS_DENIED:
  case STATUS_MEDIA_WRITE_PROTECTED:
  case STATUS_CANNOT_DELETE: // a delete-on-close open of a read-only object
    return ENOACCESS;

  case STATUS_OBJECT_NAME_COLLISION:
    return EFILEEXISTS;

  case STATUS_SHARING_VIOLATION:
  case STATUS_DELETE_PENDING:     // another client has deleted the object but still holds it open
  case STATUS_FILE_LOCK_CONFLICT: // another client has locked the byte range
    return ESHARING;

  case STATUS_LOGON_FAILURE:
  case STATUS_ACCOUNT_DISABLED:
    return EBADPASSWD;

  case STATUS_BAD_NETWORK_NAME:
    return ENOSUCHSHARE;

  case STATUS_DISK_FULL:
    return EDISCFULL;

  case STATUS_DIRECTORY_NOT_EMPTY:
    return EDIRNOTEMPTY;

  case STATUS_NO_MORE_FILES:
    return ENOMOREFILES;

  case STATUS_INVALID_PARAMETER:
  case STATUS_OBJECT_NAME_INVALID:
    return EBADPARAM;

  case STATUS_NOT_A_DIRECTORY:
    return EPATHNOTFOUND;
  case STATUS_FILE_IS_A_DIRECTORY:
    return EBADPARAM;

  case STATUS_NETWORK_NAME_DELETED:
  case STATUS_USER_SESSION_DELETED:
  case STATUS_NETWORK_SESSION_EXPIRED:
    return ELINKFAILED;

  case STATUS_STOPPED_ON_SYMLINK:
    return ESYMLINKFAILED;

  case STATUS_SMB2_REENTRANT:
    return ELANMANFSINUSE;

  default:
    /* Unmapped status: log it and surface a generic server error. */
    debug("SMB2: unmapped NT STATUS 0x%08X\n", status);
    return ESERVERROR;
  }
}

SMB2_Server *smb2_alloc_server(void) {
  int i;

  /*
   * Take the first slot without the allocated flag; seed one credit (the channel is only ever granted a single credit before NEGOTIATE)
   * and mark the socket fd invalid.
   */
  for (i = 0; i < SMB2_MAX_SERVERS; i++) {
    if (!(smb2_servers[i].flags & SMB2_SRV_ALLOCATED)) {
      smb2_servers[i].flags = SMB2_SRV_ALLOCATED;
      smb2_servers[i].credits_available = 1;
      smb2_servers[i].raw_socket = -1;

      return &smb2_servers[i];
    }
  }

  /* Table exhausted: the safeguard names the limit so a ceiling hit is obvious in the log. */
  debug("SMB2: SMB2_MAX_SERVERS table full: bump limit (currently %d)\n", SMB2_MAX_SERVERS);

  return NULL;
}

/* Skip the separators a caller may have left in front of a share-relative path. */
static inline const char *smb2_skip_seps(const char *path) {
  while (*path == '\\') {
    path++;
  }

  return path;
}

/* Test whether the last directory lookup was of exactly this path and nothing has been sent to the server since. */
static bool smb2_lookup_covers(const SMB2_Share *share, const char *path) {
  return smb2_lookup.valid && smb2_lookup.share == share && stricmp(smb2_lookup.path, smb2_skip_seps(path)) == 0;
}

/*
 * Drop anything remembered about a share that is going away.
 *
 * The lookup result and the parked listing both point at a share slot; once that slot is freed it may be reused by another mount, so
 * neither may survive it. Nothing is sent, because the parked directory handle dies with the tree connection.
 *
 * Parameters:
 *   share  share being freed
 */
static void smb2_forget_share(const SMB2_Share *share) {
  if (smb2_lookup.share == share) {
    smb2_lookup.valid = false;
  }

  if (smb2_listing.share == share) {
    smb2_listing.parked = false;
  }
}

void smb2_free_server(SMB2_Server *srv) {
  int i;

  if (srv == NULL) {
    return;
  }

  /* Tear down the transport socket while the slot still points at it. */
  if (srv->raw_socket >= 0) {
    SMB2X_Close(srv->raw_socket);
  }

  /* Release any open file bound to a share on this server, because the share is about to go with it. */
  for (i = 0; i < SMB2_MAX_OPEN_FILES; i++) {
    if (smb2_files[i].in_use && smb2_files[i].share != NULL && smb2_files[i].share->server == srv) {
      smb2_free_file(i);
    }
  }

  /* Discard any deferred CLOSE queued for a share on this server: its handle dies with the connection, and a share slot reused
   * later must not receive it.
   */
  for (i = 0; i < SMB2_PENDING_CLOSE_QUEUE; i++) {
    if (smb2_pending_closes[i].in_use && smb2_pending_closes[i].share != NULL && smb2_pending_closes[i].share->server == srv) {
      smb2_pending_closes[i].in_use = false;
      smb2_pending_closes[i].share = NULL;
    }
  }

  /* Forget the CLOSEs still awaiting a reply from this server, so a server record reused later cannot take a reply meant for it. */
  for (i = 0; i < SMB2_UNANSWERED_CLOSES; i++) {
    if (smb2_unanswered_closes[i].srv == srv) {
      smb2_unanswered_closes[i].srv = NULL;
    }
  }

  /* Wipe every share owned by this server. */
  for (i = 0; i < SMB2_MAX_SHARES; i++) {
    if (smb2_shares[i].server == srv) {
      smb2_forget_share(&smb2_shares[i]);
      memset(&smb2_shares[i], 0, sizeof(SMB2_Share));
    }
  }

  /*
   * Clear the slot; the cleared allocated flag marks it free for reuse.  A caller part-way through an exchange still holds the pointer,
   * so leave it reading as a dead connection with no socket: anything it sends then fails at once instead of going out on socket 0.
   */
  memset(srv, 0, sizeof(SMB2_Server));
  srv->flags = SMB2_SRV_DEAD;
  srv->raw_socket = -1;
}

/*
 * Claim a free share slot bound to the given server.
 *
 * The change-notify directory handle is stamped invalid so a later CHANGE_NOTIFY registration sees that no directory is yet open on the
 * share.
 *
 * Parameters:
 *   srv  server the share will connect through
 *
 * Returns: the claimed share, or NULL when the table is full.
 */
static SMB2_Share *smb2_alloc_share(SMB2_Server *srv) {
  int i;

  /*
   * A NULL server marks a free share slot; claim it and set the notify directory id to the invalid sentinels so it reads as having no
   * CHANGE_NOTIFY registered yet.
   */
  for (i = 0; i < SMB2_MAX_SHARES; i++) {
    if (smb2_shares[i].server == NULL) {
      smb2_shares[i].server = srv;
      smb2_shares[i].notify_dir_id.Persistent = SMB2_FILEID_INVALID_PERSISTENT;
      smb2_shares[i].notify_dir_id.Volatile = SMB2_FILEID_INVALID_VOLATILE;

      return &smb2_shares[i];
    }
  }

  /* Table exhausted: the safeguard names the limit so a ceiling hit is obvious in the log. */
  debug("SMB2: SMB2_MAX_SHARES table full: bump limit (currently %d)\n", SMB2_MAX_SHARES);

  return NULL;
}

/*
 * Release a share slot, every open-file slot bound to it, and any deferred closes still queued against it.
 *
 * The directory lookup and the parked listing are forgotten if they belong to the share, since the slot may next serve another mount;
 * nothing is sent, because their handles die with the tree connection. Safe to call with NULL.
 *
 * Parameters:
 *   share  share to release; may be NULL
 */
static void smb2_free_share(SMB2_Share *share) {
  int i;

  if (share == NULL) {
    return;
  }

  /* Discard any deferred CLOSE still queued for this share: the handle is going away, so the close is moot. */
  for (i = 0; i < SMB2_PENDING_CLOSE_QUEUE; i++) {
    if (smb2_pending_closes[i].in_use && smb2_pending_closes[i].share == share) {
      smb2_pending_closes[i].in_use = false;
      smb2_pending_closes[i].share = NULL;
    }
  }

  /* Release any open file bound to the share.  Its handle dies with the tree connection, and once the slot is zeroed
   * smb2_free_server could no longer match the file to its server, so the entry would never be freed.
   */
  for (i = 0; i < SMB2_MAX_OPEN_FILES; i++) {
    if (smb2_files[i].in_use && smb2_files[i].share == share) {
      smb2_free_file(i);
    }
  }

  smb2_forget_share(share);

  /* Zero the slot; the cleared server pointer marks it free. */
  memset(share, 0, sizeof(SMB2_Share));
}

/*
 * Claim a free open-file slot to track a newly opened handle.
 *
 * The slot's generation moves on, so a handle value given out for an earlier claim of the slot no longer names it.
 *
 * Parameters:
 *   share    share the handle belongs to
 *   file_id  the SMB2 file id returned by CREATE
 *
 * Returns: the slot index, or -1 when the table is full.
 */
static int smb2_alloc_file(SMB2_Share *share, SMB2_FILEID file_id) {
  int i;

  /* Claim the first free entry and bind it to the server-issued handle and owning share; the print offset starts clean. */
  for (i = 0; i < SMB2_MAX_OPEN_FILES; i++) {
    if (!smb2_files[i].in_use) {
      smb2_files[i].in_use = true;
      smb2_files[i].generation = (uint16_t)((smb2_files[i].generation + 1u) & SMB2_FH_GENERATION_MASK);
      smb2_files[i].file_id = file_id;
      smb2_files[i].share = share;
      smb2_files[i].print_offset = 0;

      return i;
    }
  }

  /* Table exhausted: the safeguard names the limit so a ceiling hit is obvious in the log. */
  debug("SMB2: SMB2_MAX_OPEN_FILES table full: bump limit (currently %d)\n", SMB2_MAX_OPEN_FILES);

  return -1;
}

static void smb2_free_file(int index) {
  /* Zeroing clears in_use, freeing the entry; the generation survives so the next claim moves it on. */
  if (index >= 0 && index < SMB2_MAX_OPEN_FILES) {
    uint16_t generation = smb2_files[index].generation;

    memset(&smb2_files[index], 0, sizeof(SMB2_FileEntry));
    smb2_files[index].generation = generation;
  }
}

int SMB2_FileHandleValue(int index) {
  return ((int)smb2_files[index].generation << SMB2_FH_GENERATION_SHIFT) | index;
}

int SMB2_FileHandleIndex(int value) {
  int index = (int)((uint32_t)value & SMB2_FH_INDEX_MASK);

  if (smb2_get_file(index) == NULL || (uint32_t)(value >> SMB2_FH_GENERATION_SHIFT) != smb2_files[index].generation) {
    return -1;
  }

  return index;
}

SMB2_FileEntry *smb2_get_file(int index) {
  if (index < 0 || index >= SMB2_MAX_OPEN_FILES) {
    return NULL;
  }

  /* In range but not in use is not a live handle. */
  if (!smb2_files[index].in_use) {
    return NULL;
  }

  return &smb2_files[index];
}

/*
 * Generate a 16-byte SMB2 client GUID.
 *
 * The value only needs to be reasonably unique per client, not unpredictable, so it is produced by two mixed linear-congruential generators
 * rather than a cryptographic source. The generator state is seeded once from the system tick and the buffer address, then persists across
 * calls so successive GUIDs differ.
 *
 * Parameters:
 *   guid  16-byte buffer to receive the generated GUID.
 */
static void smb2_generate_guid(uint8_t *guid) {
  /* Generator state persists across calls so successive GUIDs never repeat; it is seeded once on first use. */
  static uint32_t s1 = 0u;
  static uint32_t s2 = 0u;
  int i;

  /* Seed once from the system tick and this buffer's address: unique enough for a client GUID, no entropy source needed. */
  if (s1 == 0u && s2 == 0u) {
    s1 = (uint32_t)LM_Tick();
    s2 = (uint32_t)(unsigned long)guid ^ 0xa5a5a5a5u;

    /* Keep the tick seed non-zero so a zero return from LM_Tick cannot leave the state reading as unseeded on a later call. */
    if (s1 == 0u) {
      s1 = 1u;
    }
  }

#define LCG1_MUL 1103515245u
#define LCG1_INC 12345u
#define LCG2_MUL 1664525u
#define LCG2_INC 1013904223u

  /*
   * Two independent linear-congruential generators are advanced and XORed, taking a middle byte each round to shed the low-bit
   * regularity of a single LCG.
   */
  for (i = 0; i < SMB2_GUID_SIZE; i++) {
    s1 = s1 * LCG1_MUL + LCG1_INC;
    s2 = s2 * LCG2_MUL + LCG2_INC;
    guid[i] = (uint8_t)((s1 ^ s2) >> 16);
  }

#undef LCG1_MUL
#undef LCG1_INC
#undef LCG2_MUL
#undef LCG2_INC
}

/* The dialects this client offers at NEGOTIATE, which VALIDATE_NEGOTIATE repeats. */
static const uint16_t dialects[] = {SMB2_DIALECT_0202, SMB2_DIALECT_0210, SMB2_DIALECT_0300, SMB2_DIALECT_0302};
#define DIALECT_COUNT (sizeof(dialects) / sizeof(dialects[0]))

err_t SMB2_Negotiate(SMB2_Server *srv) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  uint32_t status;

  int resp_len;
  uint16_t struct_size;
  int req_len;

  /*
   * Build the NEGOTIATE request: advertise this client's dialects (the server picks the highest it supports), signing enabled,
   * no capabilities, and a fresh client GUID.
   */
  debug("SMB2: Negotiate starting\n");
  smb2_init_header(tx, SMB2_NEGOTIATE, srv);

  body = tx + SMB2_HEADER_SIZE;

  smb2_put_word(body + SMB2_NEGOTIATE_REQ_STRUCT_SIZE_OFFSET, SMB2_NEGOTIATE_REQ_SIZE);
  smb2_put_word(body + SMB2_NEGOTIATE_REQ_DIALECT_COUNT_OFFSET, (uint16_t)DIALECT_COUNT);
  smb2_put_word(body + SMB2_NEGOTIATE_REQ_SECURITY_MODE_OFFSET, SMB2_NEGOTIATE_SIGNING_ENABLED);
  smb2_put_word(body + SMB2_NEGOTIATE_REQ_RESERVED_OFFSET, 0);

  smb2_put_dword(body + SMB2_NEGOTIATE_REQ_CAPABILITIES_OFFSET, 0u);
  smb2_generate_guid(srv->client_guid);
  memcpy(body + SMB2_NEGOTIATE_REQ_CLIENT_GUID_OFFSET, srv->client_guid, SMB2_GUID_SIZE);
  smb2_put_qword(body + SMB2_NEGOTIATE_REQ_CLIENT_START_OFFSET, 0);

  {
    int i;

    /* Append each dialect as a little-endian word after the fixed request body. */
    for (i = 0; i < (int)DIALECT_COUNT; i++) {
      smb2_put_word(body + SMB2_NEGOTIATE_REQ_DIALECTS_OFFSET + i * 2, dialects[i]);
    }
  }

  /* Length is the fixed body plus two bytes per dialect; send and await the reply. */
  req_len = SMB2_HEADER_SIZE + SMB2_NEGOTIATE_REQ_SIZE + (int)(DIALECT_COUNT * 2);

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  if (NT_STATUS_IS_ERROR(status)) {
    debug("SMB2 negotiate failed, status=0x%08X\n", status);
    return smb2_status_to_err(status);
  }

  /* Reject a reply too short to hold the fixed negotiate response. */
  if (resp_len < SMB2_HEADER_SIZE + SMB2_NEGOTIATE_RESP_MIN) {
    return EPROTOCOLERR;
  }

  body = rx + SMB2_HEADER_SIZE;
  struct_size = smb2_get_word(body + SMB2_NEGOTIATE_RESP_STRUCT_SIZE_OFFSET);

  /* MS-SMB2 fixes the negotiate response StructureSize at 65; any other value is malformed. */
  if (struct_size != SMB2_NEGOTIATE_RESP_SIZE) {
    debug("SMB2 negotiate: unexpected StructureSize %d\n", struct_size);
    return EPROTOCOLERR;
  }

  /*
   * Record the negotiated parameters: chosen dialect, security mode, server GUID, capabilities and the max transact/read/write sizes
   * that bound this client's I/O.
   */
  srv->security_mode = smb2_get_word(body + SMB2_NEGOTIATE_RESP_SECURITY_MODE_OFFSET);
  srv->dialect = smb2_get_word(body + SMB2_NEGOTIATE_RESP_DIALECT_OFFSET);
  memcpy(srv->server_guid, body + SMB2_NEGOTIATE_RESP_SERVER_GUID_OFFSET, SMB2_GUID_SIZE);
  srv->capabilities = smb2_get_dword(body + SMB2_NEGOTIATE_RESP_CAPABILITIES_OFFSET);
  srv->max_transact_size = smb2_get_dword(body + SMB2_NEGOTIATE_RESP_MAX_TRANSACT_OFFSET);
  srv->max_read_size = smb2_get_dword(body + SMB2_NEGOTIATE_RESP_MAX_READ_OFFSET);
  srv->max_write_size = smb2_get_dword(body + SMB2_NEGOTIATE_RESP_MAX_WRITE_OFFSET);

  srv->signing_required = (srv->security_mode & SMB2_NEGOTIATE_SIGNING_REQUIRED) != 0;

  srv->flags |= SMB2_SRV_CONNECTED;

  debug("SMB2: Negotiate OK, dialect=0x%04X caps=0x%08X\n", srv->dialect, srv->capabilities);
  debug("SMB2: maxRead=%u maxWrite=%u signing=%s\n", srv->max_read_size, srv->max_write_size,
        srv->signing_required ? "required" : "optional");

  return OK;
}

/*
 * Assemble an SMB2 SESSION_SETUP request carrying a SPNEGO/NTLMSSP security token.
 *
 * Parameters:
 *   tx       transmit buffer, with room for the SMB2 header reserved at the front
 *   srv      server state, used to stamp the request header
 *   sec_buf  SPNEGO token to append after the fixed request body
 *   sec_len  length of sec_buf in bytes
 *
 * Returns: the total request length (header, fixed body and appended token).
 */
static int smb2_build_session_setup(uint8_t *tx, SMB2_Server *srv, const uint8_t *sec_buf, int sec_len) {
  /* The SPNEGO token is appended immediately after the fixed request structure. */
  uint8_t *body = tx + SMB2_HEADER_SIZE;
  uint16_t sec_offset = SMB2_HEADER_SIZE + SMB2_SESSION_SETUP_REQ_SIZE;

  /*
   * Fill the fixed request: signing enabled, no channel or previous session, and point the security-buffer offset and length at the
   * appended token. StructureSize carries the customary +1 for the variable trailer.
   */
  smb2_init_header(tx, SMB2_SESSION_SETUP, srv);

  smb2_put_word(body + SMB2_SESSION_SETUP_REQ_STRUCT_SIZE_OFFSET, SMB2_SESSION_SETUP_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  body[SMB2_SESSION_SETUP_REQ_FLAGS_OFFSET] = 0;
  body[SMB2_SESSION_SETUP_REQ_SECURITY_MODE_OFFSET] = SMB2_NEGOTIATE_SIGNING_ENABLED;
  smb2_put_dword(body + SMB2_SESSION_SETUP_REQ_CAPABILITIES_OFFSET, 0);
  smb2_put_dword(body + SMB2_SESSION_SETUP_REQ_CHANNEL_OFFSET, 0);
  smb2_put_word(body + SMB2_SESSION_SETUP_REQ_SEC_BUF_POS_OFFSET, sec_offset);
  smb2_put_word(body + SMB2_SESSION_SETUP_REQ_SEC_BUF_LEN_OFFSET, (uint16_t)sec_len);
  smb2_put_qword(body + SMB2_SESSION_SETUP_REQ_PREV_SESSION_OFFSET, 0);

  memcpy(tx + sec_offset, sec_buf, (size_t)sec_len);

  return (int)sec_offset + sec_len;
}

/*
 * Validate an SMB2 SESSION_SETUP response and locate its SPNEGO security token.
 *
 * Parameters:
 *   rx           response buffer starting at the SMB2 header
 *   resp_len     length of rx in bytes
 *   sec_out      receives a pointer into rx at the returned token
 *   sec_len_out  receives the token length
 *
 * Returns: 0 on success, -1 if the response is too short or malformed.
 */
static int smb2_parse_session_setup_resp(const uint8_t *rx, int resp_len, const uint8_t **sec_out, size_t *sec_len_out) {
  const uint8_t *body = rx + SMB2_HEADER_SIZE;
  uint16_t struct_size;
  uint16_t sec_offset;
  uint16_t sec_length;

  /* Reject a response too short to hold the fixed reply body. */
  if (resp_len < SMB2_HEADER_SIZE + SMB2_SESSION_SETUP_RESP_MIN) {
    return -1;
  }

  struct_size = smb2_get_word(body + SMB2_SESSION_SETUP_RESP_STRUCT_SIZE_OFFSET);

  /* SMB2 fixes the StructureSize; a mismatch marks a malformed reply. */
  if (struct_size != SMB2_SESSION_SETUP_RESP_SIZE) {
    return -1;
  }

  /* Locate the returned SPNEGO token; the offset is measured from the SMB2 header. */
  sec_offset = smb2_get_word(body + SMB2_SESSION_SETUP_RESP_SEC_BUF_POS_OFFSET);
  sec_length = smb2_get_word(body + SMB2_SESSION_SETUP_RESP_SEC_BUF_LEN_OFFSET);

  /* Ensure the advertised token lies within the received response. */
  if (sec_offset + sec_length > (uint16_t)resp_len) {
    return -1;
  }

  /* Offset is header-relative and rx points at the header, so rx + sec_offset addresses the token. */
  *sec_out = rx + sec_offset;
  *sec_len_out = sec_length;

  return 0;
}

/*
 * Derive the NTLMv2 SessionBaseKey.
 *
 * Per MS-NLMP the key is HMAC-MD5 of the NT proof string keyed by the NTOWFv2 digest. Should MD5 be unavailable the proof string is copied
 * through unchanged as a last-resort fallback.
 *
 * Parameters:
 *   ntowfv2_digest  the NTOWFv2 key
 *   nt_response     the NT proof string (leading NTLMSSP_NTPROOFSTR_SIZE bytes of the NTLMv2 response)
 *   key_out         16-byte buffer receiving the session base key.
 */
static void smb2_compute_session_base_key(const unsigned char *ntowfv2_digest, const unsigned char *nt_response, unsigned char *key_out) {
  const mbedtls_md_info_t *md5_info = mbedtls_md_info_from_type(MBEDTLS_MD_MD5);

  /* SessionBaseKey is HMAC-MD5 of the NT proof string under the NTOWFv2 key; if MD5 is missing, fall back to the proof string itself. */
  if (md5_info != NULL) {
    mbedtls_md_hmac(md5_info, ntowfv2_digest, NTLMSSP_NTOWFV2_SIZE, nt_response, NTLMSSP_NTPROOFSTR_SIZE, key_out);
  } else {
    memcpy(key_out, nt_response, NTLMSSP_NTPROOFSTR_SIZE);
  }
}

/*
 * Return the server's MsvAvTimestamp from an NTLMSSP AV_PAIR list, or 0 if absent.
 *
 * MS-NLMP requires the client to echo this timestamp inside its NTLMv2 response, and macOS refuses a logon that does not, so it is
 * lifted from the challenge's target info. The list is a run of (2-byte id, 2-byte length, value) triples terminated by MsvAvEOL.
 *
 * Parameters:
 *   buf  the AV_PAIR list
 *   len  its length in bytes
 *
 * Returns: the timestamp as a little-endian FILETIME (100ns ticks since 1601), or 0 if not present or the list is malformed.
 */
static unsigned long long smb2_extract_av_timestamp(const unsigned char *buf, size_t len) {
  size_t i = 0u;

  /* Each AV pair is a 2-byte id and 2-byte length, both little-endian, followed by the value. */
  while (i + 4 <= len) {
    unsigned int id = buf[i] | ((unsigned int)buf[i + 1] << 8);
    unsigned int n = buf[i + 2] | ((unsigned int)buf[i + 3] << 8);

    /* MsvAvEOL (id and length both zero) ends the list with no timestamp seen. */
    if (id == 0 && n == 0) {
      return 0;
    }

    /* A value that overruns the buffer means a truncated or malformed list. */
    if (i + 4 + n > len) {
      return 0;
    }

    /* MsvAvTimestamp carries an 8-byte FILETIME value. */
    if (id == MSV_AV_TIMESTAMP && n == 8) {
      const unsigned char *v = buf + i + 4;
      unsigned long long ts = 0ull;
      int k;

      /* Reassemble the little-endian FILETIME, most-significant byte last. */
      for (k = 7; k >= 0; k--) {
        ts = (ts << 8) | v[k];
      }

      return ts;
    }

    i += 4 + n;
  }

  return 0;
}

/*
 * Rebuild the server's NTLMSSP target-info (AV_PAIR) block for the client's AUTHENTICATE message, adding the fields MS-NLMP asks for.
 *
 * Each pair from the CHALLENGE's target info is echoed unchanged except MsvAvFlags, into which bit 0x2 is set to signal that a MIC follows.
 * After the echoed list the routine appends an empty MsvAvChannelBindings pair (no channel binding asserted), an MsvAvTargetName SPN of
 * `cifs/<computer-name>` built from the captured NbComputerName, and the MsvAvEOL terminator.
 *
 * Parameters:
 *   in       server's target-info AV_PAIR list, taken from the CHALLENGE message
 *   in_len   length of `in`, in bytes
 *   out      buffer to receive the rebuilt AV_PAIR list
 *   out_max  capacity of `out`, in bytes
 *
 * Returns: number of bytes written to `out`, or 0 if the input was malformed or the result would not fit.
 */
static size_t smb2_build_client_target_info(const unsigned char *in, size_t in_len, unsigned char *out, size_t out_max) {
  /*
   * `i` and `o` are the read and write cursors; `nb_name_lower` captures the server's NetBIOS computer name for the SPN built at the
   * end.
   */
  size_t i = 0u;
  size_t o = 0u;
  int saw_flags = 0;

  unsigned char nb_name_lower[NTLM_NAME_BUF_BYTES];
  size_t nb_name_lower_len = 0u;

  /* Walk the AV_PAIR list: each entry is a little-endian 2-byte id, 2-byte value length, then that many value bytes. */
  while (i + 4 <= in_len) {
    unsigned int id = in[i] | ((unsigned int)in[i + 1] << 8);
    unsigned int n = in[i + 2] | ((unsigned int)in[i + 3] << 8);

    /* MsvAvEOL (id and length both zero) marks the end of the list. */
    if (id == 0 && n == 0) {
      break;
    }

    /* Reject a pair whose value overruns the input. */
    if (i + 4 + n > in_len) {
      return 0;
    }

    /* Reject if echoing this pair would overflow the output. */
    if (o + 4 + n > out_max) {
      return 0;
    }

    /* Capture the first MsvAvNbComputerName; its lower-cased form seeds the cifs/ SPN appended later. */
    if (id == MSV_AV_NB_COMPUTER_NAME && n > 0 && nb_name_lower_len == 0) {
      size_t copy_n = (n < sizeof(nb_name_lower)) ? n : sizeof(nb_name_lower);
      size_t k;

      /* The name is UTF-16LE: even byte positions hold the low byte of each character, odd positions the high byte. */
      for (k = 0; k < copy_n; k++) {
        unsigned char c = in[i + 4 + k];

        /* Fold A-Z to lower case in the low byte so the SPN host component is case-canonical. */
        if (k % 2 == 0 && c >= 'A' && c <= 'Z') {
          c = (unsigned char)(c - 'A' + 'a');
        }

        nb_name_lower[k] = c;
      }

      nb_name_lower_len = copy_n;
    }

    /* MsvAvFlags: OR in bit 0x2 to advertise that a MIC follows and re-emit; every other pair is copied through unchanged. */
    if (id == MSV_AV_FLAGS && n == 4) {
      unsigned int flags = in[i + 4] | ((unsigned int)in[i + 5] << 8) | ((unsigned int)in[i + 6] << 16) | ((unsigned int)in[i + 7] << 24);
      flags |= MSV_AV_FLAG_MIC_PRESENT;
      out[o] = 0x06;
      out[o + 1] = 0x00;
      out[o + 2] = 0x04;
      out[o + 3] = 0x00;
      out[o + 4] = (unsigned char)(flags & 0xFF);
      out[o + 5] = (unsigned char)((flags >> 8) & 0xFF);
      out[o + 6] = (unsigned char)((flags >> 16) & 0xFF);
      out[o + 7] = (unsigned char)((flags >> 24) & 0xFF);
      saw_flags = 1;
    } else {
      memcpy(out + o, in + i, 4 + n);
    }

    o += 4 + n;
    i += 4 + n;
  }

  /* The server sent no MsvAvFlags pair, so synthesise one carrying only the MIC-present bit. */
  if (!saw_flags) {
    if (o + 8 > out_max) {
      return 0;
    }

    /* MsvAvFlags pair: id 0x0006, four-byte value with only bit 0x2 set. */
    out[o] = 0x06;
    out[o + 1] = 0x00;
    out[o + 2] = 0x04;
    out[o + 3] = 0x00;
    out[o + 4] = 0x02;
    out[o + 5] = 0x00;
    out[o + 6] = 0x00;
    out[o + 7] = 0x00;
    o += 8;
  }

  /* Ensure room for the 20-byte MsvAvChannelBindings pair. */
  if (o + 20 > out_max) {
    return 0;
  }

  /* MsvAvChannelBindings (id 0x000A, 16 bytes): all-zero asserts no channel binding. */
  out[o] = 0x0a;
  out[o + 1] = 0x00;
  out[o + 2] = 0x10;
  out[o + 3] = 0x00;
  memset(out + o + 4, 0, 16);
  o += 20;

  /* When a computer name was captured, append an MsvAvTargetName SPN of cifs/<name>. */
  if (nb_name_lower_len > 0) {
    static const unsigned char prefix[10] = {'c', 0, 'i', 0, 'f', 0, 's', 0, '/', 0};
    size_t spn_len = sizeof(prefix) + nb_name_lower_len;

    /* Refuse if the SPN length exceeds the AV_PAIR 16-bit length field or overflows the output. */
    if (spn_len > 0xFFFFu || o + 4u + spn_len > out_max) {
      return 0;
    }

    /* MsvAvTargetName (id 0x0009): UTF-16LE "cifs/" prefix followed by the lower-cased computer name. */
    out[o] = 0x09;
    out[o + 1] = 0x00;
    out[o + 2] = (unsigned char)(spn_len & 0xFF);
    out[o + 3] = (unsigned char)((spn_len >> 8) & 0xFF);
    memcpy(out + o + 4, prefix, sizeof(prefix));
    memcpy(out + o + 4 + sizeof(prefix), nb_name_lower, nb_name_lower_len);
    o += 4 + spn_len;
  }

  /* Ensure room for the terminating MsvAvEOL. */
  if (o + 4 > out_max) {
    return 0;
  }

  /* MsvAvEOL: four zero bytes closing the list. */
  out[o] = out[o + 1] = out[o + 2] = out[o + 3] = 0;
  o += 4;

  return o;
}

err_t SMB2_SessionSetup(SMB2_Server *srv, const char *username, const char *password, const char *domain) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  static uint8_t ntlmssp_buf[NTLMSSP_MAX_MSG_SIZE]; // Static to keep them off the SVC stack; nothing re-enters a logon
  static uint8_t spnego_buf[NTLMSSP_MAX_SPNEGO_SIZE];

  /* The raw NTLMSSP negotiate and challenge messages, kept because the Type 3 MIC is an HMAC over all three in order. */
  static uint8_t type1_saved[NTLMSSP_MAX_MSG_SIZE];
  int type1_saved_len;
  static uint8_t type2_saved[NTLMSSP_MAX_MSG_SIZE];
  int type2_saved_len = 0;

  int ntlmssp_len, spnego_len;
  int req_len, resp_len;
  uint32_t status;
  SMB2_HEADER resp_hdr;
  const uint8_t *sec_token;
  size_t sec_token_len;
  NTLMSSP_Challenge challenge;
  unsigned char ntowfv2_digest[NTLMSSP_NTOWFV2_SIZE];
  unsigned char lm_response[NTLMSSP_LMV2_RESPONSE_SIZE];
  static unsigned char nt_response[NTLMSSP_MAX_NT_RESPONSE];
  unsigned short nt_resp_len;
  char eff_user_buf[NTLM_NAME_BUF_BYTES];
  char eff_domain_buf[NTLM_NAME_BUF_BYTES];
  const char *eff_user = username;
  const char *eff_domain = domain;
  int use_mic = 0;
  mbedtls_md_context_t mic_ctx;

  /* Round one: build the NTLMSSP Type 1 (negotiate) token. */
  debug("SMB2: SessionSetup user=\"%s\" domain=\"%s\"\n", username, domain);
  ntlmssp_len = ntlmssp_build_negotiate(ntlmssp_buf, sizeof(ntlmssp_buf));

  if (ntlmssp_len < 0) {
    return EPROTOCOLERR;
  }

  vdebug("SMB2: Type 1 (negotiate) built, %d bytes\n", ntlmssp_len);

  /* Keep a copy of the Type 1 message for the later MIC; it was built in a buffer the same size. */
  memcpy(type1_saved, ntlmssp_buf, (size_t)ntlmssp_len);
  type1_saved_len = ntlmssp_len;

  /* Wrap the Type 1 token in a SPNEGO NegTokenInit. */
  spnego_len = spnego_wrap_init(spnego_buf, sizeof(spnego_buf), ntlmssp_buf, ntlmssp_len);

  if (spnego_len < 0) {
    return EPROTOCOLERR;
  }

  /* Send round-one SESSION_SETUP; the server replies with its challenge. */
  req_len = smb2_build_session_setup(tx, srv, spnego_buf, spnego_len);

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  /* Round one succeeds with STATUS_MORE_PROCESSING_REQUIRED, not STATUS_SUCCESS; anything else is a genuine failure.  An
   * NTLMSSP logon cannot finish in one round, so a success here is not a logon either.
   */
  if (status != STATUS_MORE_PROCESSING_REQUIRED) {
    debug("SMB2 session setup round 1 failed, status=0x%08X\n", status);
    return (status == STATUS_SUCCESS) ? EPROTOCOLERR : smb2_status_to_err(status);
  }

  /* Capture the SessionId the server assigned, because round two must echo it; without one there is no session. */
  smb2_parse_response_header(rx, &resp_hdr);
  srv->session_id = resp_hdr.SessionId;
  if (srv->session_id == 0) {
    debug("SMB2 session setup round 1 gave no session id\n");
    return EPROTOCOLERR;
  }

  /* Extract the SPNEGO security blob from the response. */
  if (smb2_parse_session_setup_resp(rx, resp_len, &sec_token, &sec_token_len) < 0) {
    return EPROTOCOLERR;
  }

  {
    const unsigned char *ntlmssp_token;
    size_t ntlmssp_token_len;

    /* Unwrap the SPNEGO NegTokenResp to reach the NTLMSSP Type 2 challenge. */
    if (spnego_unwrap(sec_token, sec_token_len, &ntlmssp_token, &ntlmssp_token_len) < 0) {
      return EPROTOCOLERR;
    }

    vdebug("SMB2: Type 2 (challenge) received, %d bytes\n", (int)ntlmssp_token_len);

    /* Save the raw Type 2 challenge for the MIC. */
    if (ntlmssp_token_len <= sizeof(type2_saved)) {
      memcpy(type2_saved, ntlmssp_token, ntlmssp_token_len);
      type2_saved_len = (int)ntlmssp_token_len;
    }

    /* Parse the challenge into server nonce, negotiated flags and target info. */
    if (ntlmssp_parse_challenge(ntlmssp_token, ntlmssp_token_len, &challenge) < 0) {
      return EPROTOCOLERR;
    }

    /*
     * Classify the server as Windows or not from the NTLMSSP Version field; non-Windows servers have their directory removals checked,
     * a directory open that reports not found asked again, and their mounts' caches refreshed aggressively, since they do not deliver
     * CHANGE_NOTIFY reliably.
     */
    if (ntlmssp_token_len >= NTLM_CHALLENGE_VERSION_OFFSET + NTLM_VERSION_SIZE && (challenge.flags & NTLMSSP_NEGOTIATE_VERSION) != 0u) {
      const unsigned char *version = ntlmssp_token + NTLM_CHALLENGE_VERSION_OFFSET;
      unsigned major = version[0];
      unsigned minor = version[1];
      unsigned build = (unsigned)version[2] | ((unsigned)version[3] << 8);
      uint16_t dialect = srv->dialect;
      uint16_t max_dialect_for_version;

      /* Map the reported OS version to the newest SMB dialect that Windows release could have offered; before 6.1 counts as 2.0.2. */
      if (major >= 10u) {
        max_dialect_for_version = SMB2_DIALECT_0311;
      } else if (major == 6u && minor == 3u) {
        max_dialect_for_version = SMB2_DIALECT_0302;
      } else if (major == 6u && minor == 2u) {
        max_dialect_for_version = SMB2_DIALECT_0300;
      } else if (major == 6u && minor == 1u) {
        max_dialect_for_version = SMB2_DIALECT_0210;
      } else {
        max_dialect_for_version = SMB2_DIALECT_0202;
      }

      /* A real Windows server would not have negotiated a dialect beyond what its OS version supports; a mismatch marks it non-Windows. */
      if (major >= 5u && minor < NTLM_VERSION_MINOR_LIMIT && build > 0u && dialect <= max_dialect_for_version) {
        debug("SMB2: server OS classified Windows (NTLM Version %u.%u build %u, dialect 0x%04X)\n", major, minor, build, (unsigned)dialect);
      } else {
        srv->flags |= SMB2_SRV_NON_WINDOWS;
        debug("SMB2: server OS classified non-Windows (NTLM Version %u.%u build %u vs dialect 0x%04X, max for that NT "
              "= 0x%04X)\n",
              major, minor, build, (unsigned)dialect, (unsigned)max_dialect_for_version);
      }
    } else {
      srv->flags |= SMB2_SRV_NON_WINDOWS;
      debug("SMB2: server OS classified non-Windows (no NTLM Version field)\n");
    }
  }

  /* Log the challenge; verbose builds additionally decode its TargetName. */
  debug("SMB2 session setup: received server challenge\n");
  debug("SMB2: challenge flags=0x%08X, target_info_len=%d\n", (unsigned int)challenge.flags, challenge.target_info_len);
#ifdef SMB2_DEBUG_VERBOSE
  if (challenge.target_name_len > 0) {
    char tn[64];
    size_t k, out = 0u;
    for (k = 0; k + 1 < challenge.target_name_len && out + 1 < sizeof(tn); k += 2) {
      tn[out++] = (char)challenge.target_name[k];
    }
    tn[out] = 0;
    vdebug("SMB2: challenge TargetName=\"%s\"\n", tn);
  } else {
    vdebug("SMB2: challenge has no TargetName\n");
  }
#endif

  /* With no separate domain supplied, split a DOMAIN\\user username into its two parts. */
  if ((domain == NULL || domain[0] == '\0') && username != NULL) {
    const char *bs = strchr(username, '\\');

    /* Only split on a backslash separating a non-empty domain and user. */
    if (bs != NULL && bs > username && bs[1] != '\0') {
      size_t dom_len = (size_t)(bs - username);
      size_t user_len = strlen(bs + 1);

      /* Copy the split domain and user into local buffers, bounds-checked. */
      if (dom_len < sizeof(eff_domain_buf) && user_len < sizeof(eff_user_buf)) {
        memcpy(eff_domain_buf, username, dom_len);
        eff_domain_buf[dom_len] = '\0';
        memcpy(eff_user_buf, bs + 1, user_len + 1);
        eff_user = eff_user_buf;
        eff_domain = eff_domain_buf;
      }
    }
  }

  /* Derive the NTLMv2 one-way hash from the password and identity, then the LMv2 response over the server challenge. */
  debug("SMB2: Auth_LMOWFv2 user=\"%s\" domain=\"%s\"\n", eff_user, eff_domain);
  Auth_LMOWFv2(password, strlen(password), eff_user, strlen(eff_user), eff_domain, strlen(eff_domain), ntowfv2_digest);

  Auth_LMv2ChallengeResponse(ntowfv2_digest, challenge.challenge, lm_response);

  mbedtls_md_init(&mic_ctx);

  {
    unsigned long long server_ts = smb2_extract_av_timestamp(challenge.target_info, challenge.target_info_len);
    static unsigned char client_ti[NTLMSSP_MAX_MSG_SIZE];
    const unsigned char *ti_for_ntlmv2 = challenge.target_info;
    unsigned short ti_for_ntlmv2_len = challenge.target_info_len;

    /*
     * When the server sent a timestamp, MS-NLMP calls for an all-zero LMv2 response (3.3.2) and for this client's own target info carrying
     * MsvAvFlags with a MIC (3.1.5.1.2); both are SHOULDs.
     */
    if (server_ts != 0) {
      size_t client_ti_len = smb2_build_client_target_info(challenge.target_info, challenge.target_info_len, client_ti, sizeof(client_ti));
      const mbedtls_md_info_t *md5_info = mbedtls_md_info_from_type(MBEDTLS_MD_MD5);
      vdebug("SMB2: server supplied MsvAvTimestamp; zeroing LMv2 response per MS-NLMP 3.3.2\n");
      memset(lm_response, 0, sizeof(lm_response));

      /*
       * Claim a MIC, by sending the client-built target info, only when the MIC can be computed: the saved Type 1 and Type 2 copies
       * exist and the HMAC context is ready.  Otherwise take the no-MIC path.
       */
      if (client_ti_len == 0 || client_ti_len > 0xFFFFu) {
        debug("SMB2: client target_info build failed; falling back to no-MIC path\n");
      } else if (type2_saved_len == 0 || md5_info == NULL || mbedtls_md_setup(&mic_ctx, md5_info, 1) != 0) {
        debug("SMB2: MIC cannot be computed; falling back to no-MIC path\n");
      } else {
        ti_for_ntlmv2 = client_ti;
        ti_for_ntlmv2_len = (unsigned short)client_ti_len;
        use_mic = 1;
        vdebug("SMB2: client target_info built with MsvAvFlags bit 0x2 set, %d bytes\n", (int)client_ti_len);
      }
    } else {
      vdebug("SMB2: no server MsvAvTimestamp; using local time in NTLMv2 blob, no MIC\n");
    }

    /* Produce the NTLMv2 response (NTProofStr plus blob) echoing the chosen target info and timestamp. */
    debug("SMB2: Auth_NTv2ChallengeResponseEx target_info=%d bytes\n", ti_for_ntlmv2_len);
    Auth_NTv2ChallengeResponseEx(ntowfv2_digest, challenge.challenge, ti_for_ntlmv2, ti_for_ntlmv2_len, server_ts, nt_response,
                                 (int)sizeof(nt_response), &nt_resp_len);
  }

  if (nt_resp_len == 0) {
    debug("SMB2: NTv2 response length is 0!\n");
    mbedtls_md_free(&mic_ctx);
    return EPROTOCOLERR;
  }

  /* Derive the session base key from the NT proof, then build the NTLMSSP Type 3 (authenticate) message. */
  debug("SMB2: NTv2 response length=%d\n", nt_resp_len);

  smb2_compute_session_base_key(ntowfv2_digest, nt_response, srv->session_base_key);

  ntlmssp_len = ntlmssp_build_auth(ntlmssp_buf, sizeof(ntlmssp_buf), eff_domain, eff_user, LM_Vars.machinename, lm_response,
                                   sizeof(lm_response), nt_response, (size_t)nt_resp_len, NULL, 0, use_mic);

  if (ntlmssp_len < 0) {
    debug("SMB2: ntlmssp_build_auth failed\n");
    mbedtls_md_free(&mic_ctx);
    return EPROTOCOLERR;
  }

  vdebug("SMB2: Type 3 (authenticate) built, %d bytes (MIC=%d)\n", ntlmssp_len, use_mic);

  /* Stamp the MIC: an HMAC-MD5 keyed by the session base key over the Type 1, Type 2 and Type 3 messages in order. */
  if (use_mic) {
    unsigned char mic[NTLMSSP_MIC_SIZE];
    mbedtls_md_hmac_starts(&mic_ctx, srv->session_base_key, SMB2_SIGNING_KEY_SIZE);
    mbedtls_md_hmac_update(&mic_ctx, type1_saved, (size_t)type1_saved_len);
    mbedtls_md_hmac_update(&mic_ctx, type2_saved, (size_t)type2_saved_len);
    mbedtls_md_hmac_update(&mic_ctx, ntlmssp_buf, (size_t)ntlmssp_len);
    mbedtls_md_hmac_finish(&mic_ctx, mic);
    memcpy(ntlmssp_buf + NTLMSSP_TYPE3_MIC_OFFSET, mic, NTLMSSP_MIC_SIZE);
  }

  mbedtls_md_free(&mic_ctx);

  /* Wrap the finished Type 3 in a SPNEGO NegTokenResp. */
  spnego_len = spnego_wrap_response(spnego_buf, sizeof(spnego_buf), ntlmssp_buf, ntlmssp_len);

  if (spnego_len < 0) {
    debug("SMB2: spnego_wrap_response failed\n");
    return EPROTOCOLERR;
  }

  /* Derive the signing key before the final round-trip so the successful response can be signature-checked: SMB 3.x
   * runs the session base key through the SP800-108 KDF, SMB 2.x uses it directly. */
  if (srv->dialect >= SMB2_DIALECT_0300) {
    static const char kdf_label[] = "SMB2AESCMAC";
    static const char kdf_context[] = "SmbSign";

    sp800_108_counter_hmac_sha256(srv->session_base_key, SMB2_SIGNING_KEY_SIZE, kdf_label, sizeof(kdf_label), kdf_context,
                                  sizeof(kdf_context), srv->signing_key, SMB2_SIGNING_KEY_SIZE);
    debug("SMB2: signing key derived via KDF (SMB3)\n");
  } else {
    memcpy(srv->signing_key, srv->session_base_key, SMB2_SIGNING_KEY_SIZE);
    debug("SMB2: signing key = session base key (SMB2)\n");
  }

  /* Send round-two SESSION_SETUP carrying the authenticate token.  Signing is not latched yet, so this establishing
   * request goes unsigned and SMB2_SendRecv runs neither its request-signing nor its verify/status-mask over the
   * reply: the session key the request carries is bound only once the server accepts it, and a signed final
   * SESSION_SETUP request is rejected outright (STATUS_INVALID_PARAMETER) by some servers. */
  debug("SMB2: SPNEGO wrapped length=%d\n", spnego_len);

  req_len = smb2_build_session_setup(tx, srv, spnego_buf, spnego_len);

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  /* Only STATUS_SUCCESS completes the logon: a server asking for a third round, or a warning, has not logged this client on. */
  if (status != STATUS_SUCCESS) {
    debug("SMB2 session setup round 2 failed, status=0x%08X\n", status);
    return smb2_status_to_err(status);
  }

  /* Verify the signature on the successful response (the message that binds the freshly derived session key,
   * MS-SMB2 3.2.5.3.1), then latch signing so every later command is signed.  Only the success reply is reliably
   * signed, so the check lives here rather than on the error path above.  When the server requires signing, an
   * unsigned success (which is all a guest or anonymous logon gets) is refused: nothing on that session could be
   * signed.
   */
  if (resp_len >= SMB2_HEADER_SIZE + SMB2_SESSION_SETUP_RESP_SESSION_FLAGS_OFFSET + 2 &&
      (smb2_get_word(rx + SMB2_HEADER_SIZE + SMB2_SESSION_SETUP_RESP_SESSION_FLAGS_OFFSET) &
       (SMB2_SESSION_FLAG_IS_GUEST | SMB2_SESSION_FLAG_IS_NULL)) != 0u) {
    srv->flags |= SMB2_SRV_GUEST;
  }

  if (srv->signing_required) {
    if (!(smb2_get_dword(rx + SMB2_HEADER_FLAGS_OFFSET) & SMB2_FLAGS_SIGNED) || !smb2_verify_signature(srv, rx, resp_len)) {
      debug("SMB2: final SESSION_SETUP response signature verification failed\n");
      return smb2_status_to_err(STATUS_ACCESS_DENIED);
    }

    srv->flags |= SMB2_SRV_SIGNED;
  }

  debug("SMB2: SessionSetup OK, session_id=0x%08X%08X\n", (unsigned int)(srv->session_id >> 32),
        (unsigned int)(srv->session_id & 0xFFFFFFFFu));
  debug("SMB2 session setup: authenticated as \"%s\"\n", eff_user);

  return OK;
}

/*
 * Stamp a tree connect's TreeId into the header of an outgoing SMB2 request.
 */
static void smb2_set_tree_id(uint8_t *tx, SMB2_Share *share) {
  smb2_put_dword(tx + SMB2_HEADER_TREE_ID_OFFSET, share->tree_id);
}

/*
 * Have the server confirm what it agreed at NEGOTIATE (FSCTL_VALIDATE_NEGOTIATE_INFO, MS-SMB2 3.2.5.5), on a tree just connected.
 *
 * NEGOTIATE goes unsigned, so anyone on the path could rewrite it to talk the connection down to an older dialect or to optional
 * signing.  This request and its answer are signed with the session's key, which no one on the path holds.  Only SMB 3.0 and 3.0.2 have
 * the check, and a guest or anonymous session has no key to sign with, so otherwise nothing is sent.  A server too old to know the
 * request says it is not supported, which is accepted, as other clients do.
 *
 * Parameters:
 *   share  share just connected
 *
 * Returns: OK if the server confirmed, or the check does not apply; EBADNEGOTIATE if the answer is unsigned, wrongly signed or differs
 * from NEGOTIATE; otherwise the error from the exchange.
 */
static err_t smb2_validate_negotiate(SMB2_Share *share) {
  SMB2_Server *srv = share->server;
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  uint8_t *input;
  const uint8_t *out;
  uint32_t input_offset = SMB2_HEADER_SIZE + SMB2_IOCTL_REQ_SIZE;
  uint32_t input_len = VNEG_REQ_DIALECTS_OFFSET + 2u * (uint32_t)DIALECT_COUNT;
  uint32_t status, out_offset, out_count;
  int req_len, resp_len, i;

  if ((srv->dialect != SMB2_DIALECT_0300 && srv->dialect != SMB2_DIALECT_0302) || (srv->flags & SMB2_SRV_GUEST)) {
    return OK;
  }

  /* An IOCTL addressed to no file, carrying what this client sent in NEGOTIATE. */
  smb2_init_header(tx, SMB2_IOCTL, srv);
  smb2_set_tree_id(tx, share);

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_IOCTL_REQ_SIZE);
  smb2_put_word(body + SMB2_IOCTL_REQ_STRUCT_SIZE_OFFSET, SMB2_IOCTL_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  smb2_put_dword(body + SMB2_IOCTL_REQ_CTL_CODE_OFFSET, FSCTL_VALIDATE_NEGOTIATE_INFO);
  smb2_put_qword(body + SMB2_IOCTL_REQ_FILEID_OFFSET, 0xFFFFFFFFFFFFFFFFULL);
  smb2_put_qword(body + SMB2_IOCTL_REQ_FILEID_VOL_OFFSET, 0xFFFFFFFFFFFFFFFFULL);
  smb2_put_dword(body + SMB2_IOCTL_REQ_INPUT_POS_OFFSET, input_offset);
  smb2_put_dword(body + SMB2_IOCTL_REQ_INPUT_LEN_OFFSET, input_len);
  smb2_put_dword(body + SMB2_IOCTL_REQ_MAX_OUTPUT_OFFSET, VNEG_RESP_SIZE);
  smb2_put_dword(body + SMB2_IOCTL_REQ_FLAGS_OFFSET, SMB2_0_IOCTL_IS_FSCTL);

  input = tx + input_offset;
  smb2_put_dword(input + VNEG_REQ_CAPABILITIES_OFFSET, 0u);
  memcpy(input + VNEG_REQ_GUID_OFFSET, srv->client_guid, SMB2_GUID_SIZE);
  smb2_put_word(input + VNEG_REQ_SECURITY_MODE_OFFSET, SMB2_NEGOTIATE_SIGNING_ENABLED);
  smb2_put_word(input + VNEG_REQ_DIALECT_COUNT_OFFSET, (uint16_t)DIALECT_COUNT);

  for (i = 0; i < (int)DIALECT_COUNT; i++) {
    smb2_put_word(input + VNEG_REQ_DIALECTS_OFFSET + i * 2, dialects[i]);
  }

  req_len = (int)(input_offset + input_len);

  /* SMB2_SendRecv signs only on a session that signs everything, but this request is signed on any session. */
  if (!(srv->flags & SMB2_SRV_SIGNED)) {
    smb2_sign_message(srv, tx, req_len);
  }

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  if (status == STATUS_NOT_SUPPORTED || status == STATUS_INVALID_DEVICE_REQUEST || status == STATUS_FILE_CLOSED) {
    debug("SMB2: VALIDATE_NEGOTIATE not supported by the server (status=0x%08X)\n", (unsigned)status);
    return OK;
  }

  if (NT_STATUS_IS_ERROR(status)) {
    debug("SMB2: VALIDATE_NEGOTIATE failed, status=0x%08X\n", (unsigned)status);
    return smb2_status_to_err(status);
  }

  /* On a session that does not sign everything, SMB2_SendRecv has not checked the answer, so check it here. */
  if (!(srv->flags & SMB2_SRV_SIGNED) &&
      (!(smb2_get_dword(rx + SMB2_HEADER_FLAGS_OFFSET) & SMB2_FLAGS_SIGNED) || !smb2_verify_signature(srv, rx, resp_len))) {
    debug("SMB2: VALIDATE_NEGOTIATE answer unsigned or wrongly signed\n");
    return EBADNEGOTIATE;
  }

  if (resp_len < SMB2_HEADER_SIZE + (int)SMB2_IOCTL_RESP_SIZE ||
      smb2_get_word(rx + SMB2_HEADER_SIZE + SMB2_IOCTL_RESP_STRUCT_SIZE_OFFSET) != SMB2_IOCTL_RESP_SIZE) {
    return EPROTOCOLERR;
  }

  out_offset = smb2_get_dword(rx + SMB2_HEADER_SIZE + SMB2_IOCTL_RESP_OUTPUT_POS_OFFSET);
  out_count = smb2_get_dword(rx + SMB2_HEADER_SIZE + SMB2_IOCTL_RESP_OUTPUT_LEN_OFFSET);

  if (out_offset > (uint32_t)resp_len || out_count > (uint32_t)resp_len - out_offset || out_count < VNEG_RESP_SIZE) {
    return EPROTOCOLERR;
  }

  /* Every field must be what the server said at NEGOTIATE. */
  out = rx + out_offset;
  if (smb2_get_dword(out + VNEG_RESP_CAPABILITIES_OFFSET) != srv->capabilities ||
      memcmp(out + VNEG_RESP_GUID_OFFSET, srv->server_guid, SMB2_GUID_SIZE) != 0 ||
      smb2_get_word(out + VNEG_RESP_SECURITY_MODE_OFFSET) != srv->security_mode ||
      smb2_get_word(out + VNEG_RESP_DIALECT_OFFSET) != srv->dialect) {
    debug("SMB2: VALIDATE_NEGOTIATE answer differs from NEGOTIATE\n");
    return EBADNEGOTIATE;
  }

  debug("SMB2: VALIDATE_NEGOTIATE confirmed dialect 0x%04X\n", srv->dialect);

  return OK;
}

err_t SMB2_TreeConnect(SMB2_Server *srv, const char *sharename, int sharetype, SMB2_Share **share_out) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  char unc_path[SMB2_NAME_LIMIT + SMB2_SHARENAME_LEN + 4];

  int unc_len, path_bytes;
  uint16_t path_offset;
  int req_len, resp_len;
  uint32_t status;
  SMB2_HEADER resp_hdr;
  SMB2_Share *share;
  err_t res;

  UNUSED(sharetype);

  /* Build TREE_CONNECT for the share: the UNC path is written as UTF-16LE immediately after the fixed request body, then sent. */
  debug("SMB2: TreeConnect \"\\\\%s\\%s\"\n", srv->servname, sharename);

  /* Claim a share slot before sending, so a full table never leaves a tree connected on the server with nothing to
   * disconnect it.
   */
  share = smb2_alloc_share(srv);

  if (share == NULL) {
    return ENOHANDLES;
  }

  unc_len = sprintf(unc_path, "\\\\%s\\%s", srv->servname, sharename);

  path_offset = SMB2_HEADER_SIZE + SMB2_TREE_CONNECT_REQ_SIZE;

  path_bytes = smb2_latin1_to_utf16le(tx + path_offset, SMB2_WORKBUF_SIZE - path_offset, unc_path, unc_len);

  smb2_init_header(tx, SMB2_TREE_CONNECT, srv);

  body = tx + SMB2_HEADER_SIZE;
  smb2_put_word(body + SMB2_TREE_CONNECT_REQ_STRUCT_SIZE_OFFSET, SMB2_TREE_CONNECT_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  smb2_put_word(body + SMB2_TREE_CONNECT_REQ_FLAGS_OFFSET, 0);
  smb2_put_word(body + SMB2_TREE_CONNECT_REQ_PATH_POS_OFFSET, path_offset);
  smb2_put_word(body + SMB2_TREE_CONNECT_REQ_PATH_LEN_OFFSET, (uint16_t)path_bytes);

  req_len = (int)path_offset + path_bytes;

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  if (NT_STATUS_IS_ERROR(status)) {
    debug("SMB2 tree connect failed, status=0x%08X\n", status);
    smb2_free_share(share);
    return smb2_status_to_err(status);
  }

  /* Reject a reply too short to hold the fixed tree-connect response. */
  if (resp_len < SMB2_HEADER_SIZE + SMB2_TREE_CONNECT_RESP_MIN) {
    smb2_free_share(share);
    return EPROTOCOLERR;
  }

  smb2_parse_response_header(rx, &resp_hdr);

  body = rx + SMB2_HEADER_SIZE;

  if (smb2_get_word(body + SMB2_TREE_CONNECT_RESP_STRUCT_SIZE_OFFSET) != SMB2_TREE_CONNECT_RESP_SIZE) {
    smb2_free_share(share);
    return EPROTOCOLERR;
  }

  /* The tree id goes in the header of every later request on this share. */
  share->tree_id = resp_hdr.TreeId;
  share->share_type = body[SMB2_TREE_CONNECT_RESP_SHARE_TYPE_OFFSET];

  {
    int copy_len = (int)strlen(sharename);

    /* Clamp the stored share name to the field width. */
    if (copy_len >= SMB2_SHARENAME_LEN) {
      copy_len = SMB2_SHARENAME_LEN - 1;
    }

    memcpy(share->sharename, sharename, (size_t)copy_len);
    share->sharename[copy_len] = '\0';
  }

  /*
   * A connection whose NEGOTIATE the server does not confirm may have been tampered with, so the tree goes again.  The connection is left
   * up rather than dropped: every tree connected on it is checked, so nothing can use it, while dropping it would start a reconnect that
   * fails the same way after every recovery.
   */
  res = smb2_validate_negotiate(share);

  if (res != OK) {
    (void)SMB2_TreeDisconnect(share);
    return res;
  }

  debug("SMB2 tree connect: \"\\\\%s\\%s\" OK\n", srv->servname, sharename);
  debug("SMB2 tree connect: type=%d, tree_id=%u\n", share->share_type, share->tree_id);

  *share_out = share;

  return OK;
}

err_t SMB2_TreeDisconnect(SMB2_Share *share) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  int req_len, resp_len;
  uint32_t status;
  SMB2_Server *srv;

  if (share == NULL || share->server == NULL) {
    return EBADPARAM;
  }

  /* Cancel any outstanding CHANGE_NOTIFY on this tree first, then build and send TREE_DISCONNECT. */
  srv = share->server;

  SMB2_CancelNotify(share);

  smb2_init_header(tx, SMB2_TREE_DISCONNECT, srv);
  smb2_put_dword(tx + SMB2_HEADER_TREE_ID_OFFSET, share->tree_id);

  body = tx + SMB2_HEADER_SIZE;
  smb2_put_word(body + SMB2_TREE_DISCONNECT_REQ_STRUCT_SIZE_OFFSET, SMB2_TREE_DISCONNECT_REQ_SIZE);
  smb2_put_word(body + SMB2_TREE_DISCONNECT_REQ_RESERVED_OFFSET, 0);

  req_len = SMB2_HEADER_SIZE + SMB2_TREE_DISCONNECT_REQ_SIZE;

  /* Send it and log the outcome; a failure does not stop the local clean-up below. */
  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  if (NT_STATUS_IS_ERROR(status)) {
    debug("SMB2 tree disconnect failed, status=0x%08X\n", status);
  } else {
    debug("SMB2 tree disconnect: \"%s\"\n", share->sharename);
  }

  /* Free the share slot whatever the result: the tree handle is gone either way. */
  smb2_free_share(share);

  return NT_STATUS_IS_ERROR(status) ? smb2_status_to_err(status) : OK;
}

/*
 * Canonicalise a backslash-separated SMB path in place, collapsing empty and "." segments and resolving ".." against earlier ones.
 *
 * Splits the path into segments, drops empty and "." components, and pops the preceding segment for each "..". The survivors are
 * rejoined with single backslashes. An over-long path that will not fit the scratch buffer is left untouched.
 *
 * Parameters:
 *   path  NUL-terminated backslash-separated path, rewritten in place
 *
 * Returns: false, with `path` unchanged, if a ".." would climb above the share root to name something outside the share, or if the
 * walk ever holds more than SMB2_PATH_MAX_SEGMENTS segments.
 */
static bool smb2_path_normalise(char *path) {
  /* `tmp` holds a private copy to tokenise in place; `segs` points at the surviving segments within it. */
  char tmp[SMB2_NAME_LIMIT];
  char *segs[SMB2_PATH_MAX_SEGMENTS];
  int n_segs = 0;
  char *p, *q, *out;
  size_t path_len;
  int i;

  path_len = strlen(path);

  /* Leave an over-long path untouched rather than truncate it. */
  if (path_len >= sizeof tmp) {
    return true;
  }

  /* Tokenise a copy so the segment pointers stay valid while `path` itself is rewritten. */
  memcpy(tmp, path, path_len + 1u);

  p = tmp;

  /* Split the copy into backslash-separated segments. */
  while (*p) {
    char *seg = p;
    size_t seg_len;

    q = strchr(p, '\\');

    /* Terminate this segment and advance; the last segment has no trailing separator. */
    if (q != NULL) {
      *q = '\0';
      p = q + 1;
    } else {
      p += strlen(p);
    }

    seg_len = strlen(seg);

    /* Skip empty segments left by doubled or trailing separators. */
    if (seg_len == 0u) {
      continue;
    }

    /* Skip ".", the current directory. */
    if (seg_len == 1u && seg[0] == '.') {
      continue;
    }

    /* ".." pops the previous segment; at the root there is none, and the path leads out of the share. */
    if (seg_len == 2u && seg[0] == '.' && seg[1] == '.') {
      if (n_segs == 0) {
        return false;
      }

      n_segs--;
      continue;
    }

    /* Keep the segment; a path too deep to hold is refused, because dropping segments would name another object. */
    if (n_segs == SMB2_PATH_MAX_SEGMENTS) {
      debug("SMB2 symlink: refusing \"%s\", which has too many segments\n", path);
      return false;
    }

    segs[n_segs++] = seg;
  }

  out = path;

  /* Rejoin the surviving segments back into `path`. */
  for (i = 0; i < n_segs; i++) {
    size_t seg_len = strlen(segs[i]);

    /* A separator precedes every segment but the first. */
    if (i > 0) {
      *out++ = '\\';
    }

    memcpy(out, segs[i], seg_len);
    out += seg_len;
  }

  *out = '\0';

  return true;
}

/*
 * Issue an SMB2 IOCTL (as an FSCTL) with no input on an open handle and return the server's output buffer.
 *
 * The response is validated for structure size and for output bounds lying inside the received frame before at most `output_max` bytes
 * are copied back to the caller.
 *
 * Parameters:
 *   share           connected share carrying the server session
 *   file_id         open handle the control code acts on
 *   ctl_code        FSCTL control code
 *   output          buffer to receive the FSCTL output
 *   output_max      capacity of `output`, in bytes
 *   output_len_out  receives the number of output bytes written
 *
 * Returns: OK on success, or an err_t mapped from the NT status or from a response-validation failure.
 */
static err_t smb2_ioctl(SMB2_Share *share, SMB2_FILEID file_id, uint32_t ctl_code, uint8_t *output, uint32_t output_max,
                        uint32_t *output_len_out) {
  /* `tx` and `rx` alias the shared module send and receive work buffers. */
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  int req_len, resp_len;
  uint32_t status;
  uint16_t resp_struct_size;
  uint32_t out_offset, out_count;

  if (share == NULL || share->server == NULL || output == NULL || output_len_out == NULL) {
    return EBADPARAM;
  }

  /* Build the IOCTL request: FSCTL flag set, target file id, and no input (its offset and length stay zero). */
  smb2_init_header(tx, SMB2_IOCTL, share->server);
  smb2_set_tree_id(tx, share);

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_IOCTL_REQ_SIZE);
  smb2_put_word(body + SMB2_IOCTL_REQ_STRUCT_SIZE_OFFSET, SMB2_IOCTL_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  smb2_put_dword(body + SMB2_IOCTL_REQ_CTL_CODE_OFFSET, ctl_code);
  smb2_put_qword(body + SMB2_IOCTL_REQ_FILEID_OFFSET, file_id.Persistent);
  smb2_put_qword(body + SMB2_IOCTL_REQ_FILEID_VOL_OFFSET, file_id.Volatile);
  smb2_put_dword(body + SMB2_IOCTL_REQ_MAX_OUTPUT_OFFSET, output_max);
  smb2_put_dword(body + SMB2_IOCTL_REQ_FLAGS_OFFSET, SMB2_0_IOCTL_IS_FSCTL);

  vdebug("SMB2: Ioctl ctl=0x%08X fid=0x%08X%08X max_output=%u\n", (unsigned)ctl_code, (uint32_t)(file_id.Persistent >> 32),
         (uint32_t)file_id.Persistent, (unsigned)output_max);

  req_len = SMB2_HEADER_SIZE + SMB2_IOCTL_REQ_SIZE;
  status = SMB2_SendRecv(share->server, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  if (NT_STATUS_IS_ERROR(status)) {
    debug("SMB2: Ioctl ctl=0x%08X status=0x%08X (failed)\n", (unsigned)ctl_code, (unsigned)status);
    return smb2_status_to_err(status);
  }

  /* Response must be long enough to hold the fixed IOCTL response structure. */
  if (resp_len < SMB2_HEADER_SIZE + (int)SMB2_IOCTL_RESP_SIZE) {
    debug("SMB2: Ioctl ctl=0x%08X resp_len=%d too short for response header\n", (unsigned)ctl_code, resp_len);
    return EBADPARAM;
  }

  body = rx + SMB2_HEADER_SIZE;
  resp_struct_size = smb2_get_word(body + SMB2_IOCTL_RESP_STRUCT_SIZE_OFFSET);

  /* StructureSize must equal the spec's fixed value or the frame is malformed. */
  if (resp_struct_size != SMB2_IOCTL_RESP_SIZE) {
    debug("SMB2: Ioctl ctl=0x%08X bad StructureSize %u (expected %u)\n", (unsigned)ctl_code, (unsigned)resp_struct_size,
          (unsigned)SMB2_IOCTL_RESP_SIZE);
    return EBADPARAM;
  }

  out_offset = smb2_get_dword(body + SMB2_IOCTL_RESP_OUTPUT_POS_OFFSET);
  out_count = smb2_get_dword(body + SMB2_IOCTL_RESP_OUTPUT_LEN_OFFSET);

  /* Reject output bounds that fall outside the received frame. */
  if (out_offset > (uint32_t)resp_len || out_count > (uint32_t)resp_len - out_offset) {
    debug("SMB2: Ioctl ctl=0x%08X bad output bounds offset=%u count=%u resp_len=%d\n", (unsigned)ctl_code, (unsigned)out_offset,
          (unsigned)out_count, resp_len);
    return EBADPARAM;
  }

  /* Clamp to the caller's buffer; server output beyond it is discarded. */
  if (out_count > output_max) {
    out_count = output_max;
  }

  /* OutputOffset is measured from the start of the frame, so copy from `rx`, not from `body`. */
  if (out_count > 0u) {
    memcpy(output, rx + out_offset, out_count);
  }

  *output_len_out = out_count;
  vdebug("SMB2: Ioctl ctl=0x%08X OK output=%u bytes\n", (unsigned)ctl_code, (unsigned)out_count);

  return OK;
}

/*
 * Resolve an NTFS symlink reparse point to its substitute name without following the link.
 *
 * Opens the path with FILE_OPEN_REPARSE_POINT so the server returns the link itself, then reads its symlink substitute name via
 * FSCTL_GET_REPARSE_POINT. A STATUS_STOPPED_ON_SYMLINK reply means an intermediate component is itself a link, so the final component is
 * stripped and the shorter path retried, until the link is found or no component is left. The substitute name is decoded from UTF-16LE
 * and the caller told whether it is relative and how much of the original path the link consumed.
 *
 * Parameters:
 *   share             connected share
 *   filename          DOS path that is, or contains, a symlink
 *   substitute_out    buffer to receive the decoded substitute name
 *   substitute_size   capacity of `substitute_out`, in bytes
 *   sub_chars_out     receives the substitute name length, in characters
 *   is_relative_out   receives true when the substitute name is relative
 *   link_end_pos_out  receives the offset in `filename` at which the resolved link ended
 *
 * Returns: OK when a symlink was resolved, or EBADPARAM / ESYMLINKFAILED on failure.
 */
static err_t smb2_resolve_symlink_via_ioctl(SMB2_Share *share, const char *filename, char *substitute_out, size_t substitute_size,
                                            int *sub_chars_out, bool *is_relative_out, size_t *link_end_pos_out) {
  char candidate[SMB2_NAME_LIMIT];
  size_t candidate_len;

  if (share == NULL || share->server == NULL || filename == NULL || substitute_out == NULL || sub_chars_out == NULL ||
      is_relative_out == NULL || link_end_pos_out == NULL) {
    return EBADPARAM;
  }

  candidate_len = strlen(filename);

  /* Refuse a path too long to buffer. */
  if (candidate_len >= sizeof candidate) {
    return EBADPARAM;
  }

  /* `candidate` is the working path, stripped one component shorter each time an intermediate link is met. */
  memcpy(candidate, filename, candidate_len + 1u);

  debug("SMB2 symlink IOCTL resolver: entering for \"%s\"\n", filename);

  /* Each try that stops on a link nearer the root drops the final component, so the search ends by the time the path is used up. */
  for (;;) {
    uint8_t *tx = smb2_txbuf;
    uint8_t *rx = smb2_rxbuf;
    uint8_t *body;
    SMB2_FILEID link_fid;
    uint16_t name_offset;
    int name_bytes, req_len, resp_len;
    uint32_t status;
    uint8_t reparse_buf[REPARSE_DATA_PATH_BUFFER_OFFSET + 2u * (SMB2_NAME_LIMIT + SMB2_NAME_LIMIT)];
    uint32_t reparse_len = 0u;
    uint32_t reparse_tag, reparse_flags;
    uint16_t sub_offset, sub_length;
    uint8_t *path_buf;
    int chars;
    err_t res;

    /* Open with FILE_OPEN_REPARSE_POINT so the server returns the link itself rather than following it. */
    smb2_init_header(tx, SMB2_CREATE, share->server);
    smb2_set_tree_id(tx, share);
    body = tx + SMB2_HEADER_SIZE;
    name_offset = SMB2_HEADER_SIZE + SMB2_CREATE_REQ_SIZE;
    name_bytes = smb2_latin1_to_utf16le(tx + name_offset, SMB2_WORKBUF_SIZE - name_offset, candidate, (int)candidate_len);

    memset(body, 0, SMB2_CREATE_REQ_SIZE);
    smb2_put_word(body + SMB2_CREATE_REQ_STRUCT_SIZE_OFFSET, SMB2_CREATE_REQ_SIZE + SMB2_VARIABLE_TRAILER);
    body[SMB2_CREATE_REQ_OPLOCK_OFFSET] = SMB2_OPLOCK_LEVEL_NONE;
    smb2_put_dword(body + SMB2_CREATE_REQ_IMPERSONATION_OFFSET, SMB2_IMPERSONATION_IMPERSONATION);
    smb2_put_dword(body + SMB2_CREATE_REQ_ACCESS_OFFSET, FILE_READ_ATTRIBUTES);
    smb2_put_dword(body + SMB2_CREATE_REQ_SHARE_ACCESS_OFFSET, FILE_SHARE_READ | FILE_SHARE_WRITE);
    smb2_put_dword(body + SMB2_CREATE_REQ_DISPOSITION_OFFSET, FILE_OPEN);
    smb2_put_dword(body + SMB2_CREATE_REQ_OPTIONS_OFFSET, FILE_OPEN_REPARSE_POINT);
    smb2_put_word(body + SMB2_CREATE_REQ_NAME_POS_OFFSET, name_offset);
    smb2_put_word(body + SMB2_CREATE_REQ_NAME_LEN_OFFSET, (uint16_t)name_bytes);

    req_len = (int)name_offset + (name_bytes > 0 ? name_bytes : 2);
    vdebug("SMB2 symlink IOCTL resolver: probing \"%s\" with FILE_OPEN_REPARSE_POINT\n", candidate);
    status = SMB2_SendRecv(share->server, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

    /* An intermediate component is a symlink; find the start of the final path component. */
    if (status == STATUS_STOPPED_ON_SYMLINK) {
      size_t i = candidate_len;

      while (i > 0u && candidate[i - 1u] != '\\') {
        i--;
      }

      if (i == 0u) {
        /* No separator left means the link sat at the root; give up. */
        debug("SMB2 symlink IOCTL resolver: walked back past root without finding a leaf symlink in \"%s\"\n", filename);
        return ESYMLINKFAILED;
      }

      /* Drop the final component and retry the shorter path. */
      candidate[i - 1u] = '\0';
      candidate_len = i - 1u;
      vdebug("SMB2 symlink IOCTL resolver: intermediate symlink, stripped to \"%s\"\n", candidate);
      continue;
    }

    if (NT_STATUS_IS_ERROR(status)) {
      debug("SMB2 symlink IOCTL resolver: CREATE failed status=0x%08X at \"%s\"\n", (unsigned)status, candidate);
      return ESYMLINKFAILED;
    }

    if (resp_len < SMB2_HEADER_SIZE + SMB2_CREATE_RESP_MIN) {
      debug("SMB2 symlink IOCTL resolver: CREATE response too short (%d bytes) at \"%s\"\n", resp_len, candidate);
      return ESYMLINKFAILED;
    }

    /* Read the link's file id, fetch its reparse data, then close the handle whatever the outcome. */
    body = rx + SMB2_HEADER_SIZE;
    link_fid.Persistent = smb2_get_qword(body + SMB2_CREATE_RESP_FILEID_OFFSET);
    link_fid.Volatile = smb2_get_qword(body + SMB2_CREATE_RESP_FILEID_VOL_OFFSET);
    vdebug("SMB2 symlink IOCTL resolver: \"%s\" opened as reparse point (fid=0x%08X%08X)\n", candidate,
           (uint32_t)(link_fid.Persistent >> 32), (uint32_t)link_fid.Persistent);

    res = smb2_ioctl(share, link_fid, FSCTL_GET_REPARSE_POINT, reparse_buf, sizeof reparse_buf, &reparse_len);
    smb2_close_fileid(share, &link_fid);

    if (res != OK) {
      debug("SMB2 symlink IOCTL resolver: FSCTL_GET_REPARSE_POINT failed res=%d at \"%s\"\n", res, candidate);
      return ESYMLINKFAILED;
    }

    if (reparse_len < REPARSE_DATA_MIN_LEN) {
      debug("SMB2 symlink IOCTL resolver: reparse data too short (%u bytes) at \"%s\"\n", (unsigned)reparse_len, candidate);
      return ESYMLINKFAILED;
    }

    reparse_tag = smb2_get_dword(reparse_buf + REPARSE_DATA_TAG_OFFSET);

    /* Only IO_REPARSE_TAG_SYMLINK carries a substitute name to follow. */
    if (reparse_tag != IO_REPARSE_TAG_SYMLINK) {
      debug("SMB2 symlink IOCTL resolver: reparse tag 0x%08X is not a symlink at \"%s\"\n", (unsigned)reparse_tag, candidate);
      return ESYMLINKFAILED;
    }

    /* Substitute name offset and length are relative to the reparse buffer's path area. */
    sub_offset = smb2_get_word(reparse_buf + REPARSE_DATA_SUB_NAME_OFF_OFFSET);
    sub_length = smb2_get_word(reparse_buf + REPARSE_DATA_SUB_NAME_LEN_OFFSET);
    reparse_flags = smb2_get_dword(reparse_buf + REPARSE_DATA_FLAGS_OFFSET);
    path_buf = reparse_buf + REPARSE_DATA_PATH_BUFFER_OFFSET;

    /* Reject a substitute name whose bytes fall outside the reparse data. */
    if (sub_length == 0u || (uint32_t)REPARSE_DATA_PATH_BUFFER_OFFSET + (uint32_t)sub_offset + (uint32_t)sub_length > reparse_len) {
      debug("SMB2 symlink IOCTL resolver: substitute name bounds invalid (offset=%u len=%u, reparse_len=%u) at \"%s\"\n",
            (unsigned)sub_offset, (unsigned)sub_length, (unsigned)reparse_len, candidate);
      return ESYMLINKFAILED;
    }

    /* Decode the UTF-16LE substitute name to Latin-1. */
    chars = smb2_utf16le_to_latin1(substitute_out, (int)substitute_size, path_buf + sub_offset, sub_length, false);

    if (chars <= 0) {
      debug("SMB2 symlink IOCTL resolver: substitute name failed to decode at \"%s\"\n", candidate);
      return ESYMLINKFAILED;
    }

    /* Hand back the substitute name, its relative flag, and how much of the original path the link consumed. */
    *sub_chars_out = chars;
    *is_relative_out = reparse_flags & SYMLINK_FLAG_RELATIVE;
    *link_end_pos_out = candidate_len;
    debug("SMB2 symlink IOCTL resolver: \"%s\" -> \"%s\" (%s, link_end=%u of %u)\n", candidate, substitute_out,
          *is_relative_out ? "relative" : "absolute", (unsigned)candidate_len, (unsigned)strlen(filename));

    return OK;
  }
}

/*
 * Compose the effective target path from a symlink reparse point.
 *
 * The reparse data supplies a substitute name plus the length of the original path that the symlink consumed; anything beyond
 * `link_end_pos` is the still-unparsed tail and must be re-appended. The target is resolved against the link's own parent directory, so
 * the link path up to its last backslash is prepended and "."/".." segments are collapsed afterwards. An absolute target cannot be
 * followed: in the NT namespace (\??\C:\...) or not, it names a path on the server's own disc rather than one inside the share.
 *
 * Parameters:
 *   link_path     original DOS path that resolved to the symlink
 *   substitute    substitute name from the reparse buffer (already in Latin-1)
 *   sub_chars     length of substitute, in bytes
 *   is_relative   true for a relative-target symlink (SYMLINK_FLAG_RELATIVE)
 *   link_end_pos  byte offset in link_path that the symlink consumed
 *   out           buffer to receive the composed target
 *   out_size      size of out, in bytes
 *
 * Returns: OK, ESYMLINKFAILED for an absolute target, one whose ".." climbs out of the share or one too deep to normalise, or EBADPARAM
 * if the composed path would not fit in out.
 */
static err_t smb2_compose_symlink_target(const char *link_path, const char *substitute, int sub_chars, bool is_relative,
                                         size_t link_end_pos, char *out, size_t out_size) {
  /* Locate the path tail the symlink did not consume; it is re-appended after the substitute name. */
  size_t orig_len = strlen(link_path);
  const char *unparsed = link_path + link_end_pos;
  size_t unparsed_chars = orig_len - link_end_pos;
  size_t prefix_len = link_end_pos;
  size_t total;

  if (!is_relative) {
    debug("SMB2 symlink: refusing absolute target \"%s\"\n", substitute);
    return ESYMLINKFAILED;
  }

  /* Resolve against the link's own parent: scan back to the last backslash to find where that parent directory ends. */
  while (prefix_len > 0u && link_path[prefix_len - 1u] != '\\') {
    prefix_len--;
  }

  /* Prefix + substitute + tail, plus the terminating NUL. */
  total = prefix_len + (size_t)sub_chars + unparsed_chars + 1u;

  /* Refuse rather than truncate if the result would not fit. */
  if (total > out_size) {
    return EBADPARAM;
  }

  /* Lay down the retained parent-directory prefix first. */
  if (prefix_len > 0u) {
    memcpy(out, link_path, prefix_len);
  }

  /* Then the substitute name from the reparse buffer. */
  memcpy(out + prefix_len, substitute, (size_t)sub_chars);

  /* Finally the unresolved tail. */
  if (unparsed_chars > 0u) {
    memcpy(out + prefix_len + (size_t)sub_chars, unparsed, unparsed_chars);
  }

  out[prefix_len + (size_t)sub_chars + unparsed_chars] = '\0';

  /* The target can climb out of the link's directory with "..", so collapse those and any "." segments; above the share root is refused. */
  if (!smb2_path_normalise(out)) {
    debug("SMB2 symlink: refusing target \"%s\", which climbs out of the share or is too deep\n", substitute);
    return ESYMLINKFAILED;
  }

  return OK;
}

/* Metadata of a symlink chain's final target, reported by smb2_resolve_symlink_target. */
typedef struct {
  uint32_t file_attr;
  uint64_t size;
  uint64_t write_time; // FILETIME of the target's last write
} SMB2_SymlinkResolution;

/*
 * Chase a reparse-point symlink chain to its final non-symlink target and report the target's metadata.
 *
 * Each hop reads the link's substitute name with the FSCTL reparse-point IOCTL and opens the target with FILE_OPEN_REPARSE_POINT, so a
 * target that is itself a link is opened rather than followed; the loop continues while the opened object is still a symlink, and any
 * other kind of reparse point (a junction, a deduplicated file) is reported as the target. A relative link is composed against the
 * link's parent directory; an absolute link, or one whose ".." climbs out of the share, is refused. At most SMB2_SYMLINK_MAX_HOPS links
 * are followed, which stops symlink loops.
 *
 * Parameters:
 *   share      the connected share holding the link
 *   link_path  DOS path of the symlink to resolve
 *   out        receives the final target's attributes, size, and write time
 *
 * Returns: OK when a non-symlink target is reached, ESYMLINKFAILED on any resolution failure or when the hop limit is reached, EBADPARAM
 * for bad arguments or a share whose server has gone.
 */
static err_t smb2_resolve_symlink_target(SMB2_Share *share, const char *link_path, SMB2_SymlinkResolution *out) {
  char current[SMB2_NAME_LIMIT];
  int hops;

  if (share == NULL || share->server == NULL || link_path == NULL || out == NULL) {
    return EBADPARAM;
  }

  /* Strip leading backslashes so the path is share-relative. */
  while (*link_path == '\\') {
    link_path++;
  }

  if (strlen(link_path) >= sizeof current) {
    return EBADPARAM;
  }

  strcpy(current, link_path);

  /* Follow the reparse chain up to the hop limit. */
  for (hops = 0; hops < SMB2_SYMLINK_MAX_HOPS; hops++) {
    char substitute[SMB2_NAME_LIMIT];
    char target_path[SMB2_NAME_LIMIT];
    int sub_chars = 0;
    bool is_relative = false;
    size_t link_end_pos = 0u;
    err_t r;
    SMB2_FILEID fid;
    uint64_t target_size = 0u;
    uint32_t target_attribs = 0u;
    uint64_t target_write_time = 0u;
    bool target_is_link = false;

    /* Read this link's substitute-name target via the reparse-point IOCTL. */
    r = smb2_resolve_symlink_via_ioctl(share, current, substitute, sizeof substitute, &sub_chars, &is_relative, &link_end_pos);

    if (r != OK) {
      return ESYMLINKFAILED;
    }

    /* Splice the substitute name onto the unparsed remainder to form the next path; an absolute target or one leaving the share fails. */
    r = smb2_compose_symlink_target(current, substitute, sub_chars, is_relative, link_end_pos, target_path, sizeof target_path);

    if (r != OK) {
      return ESYMLINKFAILED;
    }

    /* Open the target itself, not through it (FILE_OPEN_REPARSE_POINT), to inspect its attributes. */
    r = SMB2_Create(share, target_path, FILE_READ_ATTRIBUTES, 0u, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN,
                    FILE_OPEN_REPARSE_POINT, &fid, &target_size, &target_attribs, &target_write_time);

    if (r != OK) {
      return ESYMLINKFAILED;
    }

    /* A reparse point is another hop only when its tag says symlink; any other kind (a junction, a deduplicated file) is the target. */
    if ((target_attribs & FILE_ATTRIBUTE_REPARSE_POINT) != 0u) {
      uint8_t tag_info[FILEATTRTAG_SIZE];
      int tag_len = 0;

      r = smb2_query_info(share, &fid, SMB2_0_INFO_FILE, FileAttributeTagInformation, tag_info, (int)sizeof tag_info, &tag_len);

      if (r != OK || tag_len < (int)sizeof tag_info) {
        smb2_close_fileid(share, &fid);
        return ESYMLINKFAILED;
      }

      target_is_link = smb2_get_dword(tag_info + FILEATTRTAG_REPARSE_TAG_OFFSET) == IO_REPARSE_TAG_SYMLINK;
    }

    smb2_close_fileid(share, &fid);

    /* Target is another symlink: take one more hop. */
    if (target_is_link) {
      if (strlen(target_path) >= sizeof current) {
        return ESYMLINKFAILED;
      }

      strcpy(current, target_path);
      continue;
    }

    /* Reached a non-symlink: record the resolved object's attributes, size and write time. */
    out->file_attr = target_attribs;
    out->size = target_size;
    out->write_time = target_write_time;
    debug("smb2_resolve_symlink_target: link=\"%s\" -> target=\"%s\" attr=0x%08X size=%u hops=%d\n", link_path, target_path,
          (unsigned)target_attribs, (unsigned)target_size, hops + 1);

    return OK;
  }

  debug("smb2_resolve_symlink_target: hop limit reached, original link=\"%s\"\n", link_path);

  return ESYMLINKFAILED;
}

err_t SMB2_RetryInertSymlink(SMB2_Share *share, LMCacheNode_t *cnode, const char *link_path) {
  SMB2_SymlinkResolution resolution;
  DOS_ATTRIBS da;
  RISCOS_ATTRIBS ra;
  char ro_namebuf[SMB2_NAME_LIMIT];
  hSHARE hS;
  LMCache_t *cache;
  uint32_t gen;
  uint8_t healed_obj_type;
  uint64_t healed_length;

  if (share == NULL || cnode == NULL || link_path == NULL) {
    return EBADPARAM;
  }

  /* Only an unresolved (inert) symlink node is eligible for healing. */
  if (cnode->obj_type != LMCACHE_OBJECT_FILE || ((cnode->flags & LMCACHE_FLAG_INERT_SYMLINK) == 0u)) {
    return EBADPARAM;
  }

  /* Resolving goes to the server, during which the cache can free or reuse the node: note the generation to check it against. */
  cache = cnode->mount;
  gen = cache->mutation_gen;

  /* Try to resolve the link's ultimate target, following at most SMB2_SYMLINK_MAX_HOPS links. */
  if (smb2_resolve_symlink_target(share, link_path, &resolution) != OK) {
    return ESYMLINKFAILED;
  }

  /* The cache changed meanwhile: find the node afresh, and leave the server to answer for a link no longer cached as inert. */
  if (cache->mutation_gen != gen) {
    cnode = Cache_Lookup(cache, link_path);

    if (cnode == NULL || cnode->obj_type != LMCACHE_OBJECT_FILE || ((cnode->flags & LMCACHE_FLAG_INERT_SYMLINK) == 0u)) {
      return OK;
    }
  }

  healed_obj_type = (resolution.file_attr & FILE_ATTRIBUTE_DIRECTORY) ? (uint8_t)LMCACHE_OBJECT_DIRECTORY : (uint8_t)LMCACHE_OBJECT_FILE;

  /* Refuse to flip a cached file into a directory mid-life; defer to the next full enumeration instead. */
  if (healed_obj_type != cnode->obj_type) {
    debug("SMB2_RetryInertSymlink: kind would flip (was %u, target %u) for \"%s\" - deferring to next enum\n", (unsigned)cnode->obj_type,
          (unsigned)healed_obj_type, link_path);
    return ESYMLINKFAILED;
  }

  /* Map the drive letter to the share handle Xlt expects. */
  hS = SMB_GetShareFromDrv(share->drvletter);

  /* Translate the target's DOS metadata into RISC OS load/exec/attribute words. */
  if (Xlt_FillAttribsFromMeta(cnode->name, smb2_filetime_to_utime(resolution.write_time), (uint)resolution.size,
                              smb2_attribs_to_dos(resolution.file_attr), ro_namebuf, &da, &ra, hS) != OK) {
    return ESYMLINKFAILED;
  }

  /*
   * Overwrite the node with the resolved metadata, clear the inert flag and mark it resolved; a directory reports a nominal 4096-byte
   * length. Notify the Filer so the healed object appears.
   */
  healed_length = (resolution.file_attr & FILE_ATTRIBUTE_DIRECTORY) ? 4096u : resolution.size;

  cnode->length = healed_length;
  cnode->load_addr = (uint32_t)ra.loadaddr;
  cnode->exec_addr = (uint32_t)ra.execaddr;
  cnode->attrs = (uint32_t)ra.flags;
  cnode->flags &= (uint8_t)~LMCACHE_FLAG_INERT_SYMLINK;
  cnode->flags |= LMCACHE_FLAG_RESOLVED_SYMLINK;

  smb2_filer_upcall(share, link_path, upfsfile_Create);
  debug("SMB2_RetryInertSymlink: healed \"%s\" length=%u\n", link_path, (unsigned)healed_length);

  /* Report the object changed so the caller re-reads the node. */
  return EOBJECTCHANGED;
}

/*
 * Find where the unparsed tail of a path the server stopped on begins, given the tail's length on the wire.
 *
 * The server counts the tail in UTF-16 bytes, but a "<xxxx" escape in the path is five Latin-1 characters and one UTF-16 unit, so the
 * split cannot be worked out by halving the count.  Each separator from the end is tried in turn instead, and the tail from it is
 * encoded as it went on the wire until one matches the count.
 *
 * Parameters:
 *   path            DOS path sent in the CREATE
 *   path_len        length of path, in characters
 *   unparsed_bytes  UnparsedPathLength from the symbolic link error payload
 *   pos_out         receives the offset in path where the tail begins
 *
 * Returns: true if a tail of that length starts at a separator, or is empty; false if the count matches no tail of the path.
 */
static bool smb2_unparsed_tail_start(const char *path, size_t path_len, uint16_t unparsed_bytes, size_t *pos_out) {
  uint8_t wire[2u * SMB2_NAME_LIMIT];
  size_t pos = path_len;

  /* An empty tail means the link is the final component. */
  if (unparsed_bytes == 0u) {
    *pos_out = path_len;
    return true;
  }

  /* A separator cannot sit inside an escape, so every tail starting at one encodes exactly as that part of the wire name did. */
  while (pos > 0u) {
    pos--;

    if (path[pos] == '\\' && smb2_latin1_to_utf16le(wire, (int)sizeof wire, path + pos, (int)(path_len - pos)) == (int)unparsed_bytes) {
      *pos_out = pos;
      return true;
    }
  }

  return false;
}

static err_t SMB2_Create(SMB2_Share *share, const char *filename, uint32_t desired_access, uint32_t file_attributes, uint32_t share_access,
                         uint32_t create_disposition, uint32_t create_options, SMB2_FILEID *file_id_out, uint64_t *size_out,
                         uint32_t *attributes_out, uint64_t *write_time_out) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  SMB2_Server *srv;
  uint16_t name_offset;
  int name_bytes, req_len, resp_len;
  uint32_t status;
  char resolved_path[SMB2_NAME_LIMIT];
  int symlink_depth = 0;

  if (share == NULL || share->server == NULL) {
    return EBADPARAM;
  }

  srv = share->server;

  /* Strip leading backslashes: SMB2 names are share-relative with no leading separator. */
  while (*filename == '\\') {
    filename++;
  }

  /* The lookup that resolved this name found no such entry and nothing has been sent since, so the server could only say the same. */
  if (create_disposition == FILE_OPEN && smb2_lookup_covers(share, filename) && !smb2_lookup.present) {
    debug("SMB2: Create \"%s\" not sent - the directory lookup found no such entry\n", filename);
    return EFILENOTFOUND;
  }

retry_after_symlink:
  vdebug("SMB2: Create \"%s\"\n", filename);

  /* Start the CREATE; the filename goes on the wire immediately after the fixed request body. */
  smb2_init_header(tx, SMB2_CREATE, srv);
  smb2_set_tree_id(tx, share);

  body = tx + SMB2_HEADER_SIZE;
  name_offset = SMB2_HEADER_SIZE + SMB2_CREATE_REQ_SIZE;

  /* An empty name opens the share root, but SMB2 still needs a two-byte placeholder where the name would be. */
  if (filename[0] == '\0') {
    name_bytes = 0;
    tx[name_offset] = 0;
    tx[name_offset + 1] = 0;
  } else {
    name_bytes = smb2_latin1_to_utf16le(tx + name_offset, SMB2_WORKBUF_SIZE - name_offset, filename, (int)strlen(filename));
  }

  /*
   * Fill the fixed CREATE fields: impersonation, the requested access/attributes/share mode/disposition/options, and the name's offset
   * and length.
   */
  memset(body, 0, SMB2_CREATE_REQ_SIZE);
  smb2_put_word(body + SMB2_CREATE_REQ_STRUCT_SIZE_OFFSET, SMB2_CREATE_REQ_SIZE + SMB2_VARIABLE_TRAILER);

  body[SMB2_CREATE_REQ_OPLOCK_OFFSET] = SMB2_OPLOCK_LEVEL_NONE;
  smb2_put_dword(body + SMB2_CREATE_REQ_IMPERSONATION_OFFSET, SMB2_IMPERSONATION_IMPERSONATION);
  smb2_put_dword(body + SMB2_CREATE_REQ_ACCESS_OFFSET, desired_access);
  smb2_put_dword(body + SMB2_CREATE_REQ_ATTRS_OFFSET, file_attributes);
  smb2_put_dword(body + SMB2_CREATE_REQ_SHARE_ACCESS_OFFSET, share_access);
  smb2_put_dword(body + SMB2_CREATE_REQ_DISPOSITION_OFFSET, create_disposition);
  smb2_put_dword(body + SMB2_CREATE_REQ_OPTIONS_OFFSET, create_options);
  smb2_put_word(body + SMB2_CREATE_REQ_NAME_POS_OFFSET, name_offset);
  smb2_put_word(body + SMB2_CREATE_REQ_NAME_LEN_OFFSET, (uint16_t)name_bytes);

  req_len = (int)name_offset + (name_bytes > 0 ? name_bytes : 2);

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  /* Server refused to traverse a symlink: resolve it here and retry, up to the hop limit. */
  if (status == STATUS_STOPPED_ON_SYMLINK && symlink_depth < SMB2_SYMLINK_MAX_HOPS) {
    char substitute[SMB2_NAME_LIMIT];
    char new_path[SMB2_NAME_LIMIT];
    int sub_chars = 0;
    bool is_relative = false;
    size_t orig_len = strlen(filename);
    size_t link_end_pos = orig_len;
    bool resolved = false;
    err_t r;

    debug("SMB2 create: STATUS_STOPPED_ON_SYMLINK on \"%s\" (depth=%d, resp_len=%d, inline payload %s)\n", filename, symlink_depth,
          resp_len, (resp_len >= SMB2_HEADER_SIZE + SMB2_SYMLINK_ERR_DATA_OFFSET + SMB2_SYMLINK_ERR_MIN_LEN) ? "present" : "absent");

    /* Prefer the substitute name the server returned inline in the error, saving a separate IOCTL round trip. */
    if (resp_len >= SMB2_HEADER_SIZE + SMB2_SYMLINK_ERR_DATA_OFFSET + SMB2_SYMLINK_ERR_MIN_LEN) {
      uint8_t *errdata = rx + SMB2_HEADER_SIZE + SMB2_SYMLINK_ERR_DATA_OFFSET;
      uint16_t unparsed_bytes = smb2_get_word(errdata + SYMLINK_UNPARSED_PATH_LEN_OFFSET);
      uint16_t sub_offset = smb2_get_word(errdata + SYMLINK_SUBSTITUTE_NAME_OFFSET);
      uint16_t sub_length = smb2_get_word(errdata + SYMLINK_SUBSTITUTE_NAME_LEN_OFFSET);
      uint32_t inline_flags = smb2_get_dword(errdata + SYMLINK_FLAGS_OFFSET);
      uint8_t *path_buf = errdata + SYMLINK_PATH_BUFFER_OFFSET;
      int path_buf_max = (int)resp_len - (int)(path_buf - rx);

      /* Trust the inline data only when its offsets fit the buffer and the unparsed tail matches the end of the path sent. */
      if (sub_length > 0u && path_buf_max > 0 && (int)sub_offset + (int)sub_length <= path_buf_max &&
          smb2_unparsed_tail_start(filename, orig_len, unparsed_bytes, &link_end_pos)) {
        /* Decode the substitute name; link_end_pos marks the end of the link's own component, where the unparsed remainder begins. */
        int chars = smb2_utf16le_to_latin1(substitute, sizeof substitute, path_buf + sub_offset, sub_length, false);

        if (chars > 0) {
          sub_chars = chars;
          is_relative = inline_flags & SYMLINK_FLAG_RELATIVE;
          resolved = true;
        }
      }
    }

    /* No usable inline data: fall back to an explicit reparse-point IOCTL. */
    if (!resolved) {
      r = smb2_resolve_symlink_via_ioctl(share, filename, substitute, sizeof substitute, &sub_chars, &is_relative, &link_end_pos);

      if (r != OK) {
        return r;
      }

      debug("SMB2 create: symlink resolved via IOCTL fallback (link at offset %u of %u)\n", (unsigned)link_end_pos, (unsigned)orig_len);
    }

    /*
     * Splice the substitute in place of the link to form the next path, failing for an absolute target or one leaving the share.  It is
     * composed apart and then copied, because from the second redirection on `filename` is `resolved_path` itself.
     */
    r = smb2_compose_symlink_target(filename, substitute, sub_chars, is_relative, link_end_pos, new_path, sizeof new_path);

    if (r != OK) {
      return r;
    }

    memcpy(resolved_path, new_path, strlen(new_path) + 1u);

    /* Retry the CREATE against the resolved path, one redirection deeper. */
    filename = resolved_path;
    symlink_depth++;
    goto retry_after_symlink;
  }

  /*
   * Any other error ends the operation, as does a symlink still unfollowed at the hop limit (a warning status, so the error test
   * alone would let its error body be parsed as a CREATE reply); OBJECT_PATH_NOT_FOUND is routine enough to skip the verbose dump.
   */
  if (NT_STATUS_IS_ERROR(status) || status == STATUS_STOPPED_ON_SYMLINK) {
#ifdef SMB2_DEBUG_VERBOSE
    if (status != STATUS_OBJECT_PATH_NOT_FOUND) {
      uint64_t sent_id = smb2_get_qword(tx + SMB2_HEADER_MESSAGE_ID_OFFSET);
      uint64_t resp_id = smb2_get_qword(rx + SMB2_HEADER_MESSAGE_ID_OFFSET);
      debug("SMB2 create failed: status=0x%08X path=\"%s\" name_bytes=%d\n", status, filename, name_bytes);
      debug("  share=%c tree_id=0x%08X\n", share->drvletter, share->tree_id);
      debug("  sent_msgid=0x%08X%08X\n", (uint32_t)(sent_id >> 32), (uint32_t)sent_id);
      debug("  resp_msgid=0x%08X%08X\n", (uint32_t)(resp_id >> 32), (uint32_t)resp_id);
    }
#else
    debug("SMB2 create failed: status=0x%08X path=\"%s\"\n", status, filename);
#endif
    return smb2_status_to_err(status);
  }

  if (resp_len < SMB2_HEADER_SIZE + SMB2_CREATE_RESP_MIN) {
    return EPROTOCOLERR;
  }

  body = rx + SMB2_HEADER_SIZE;

  if (smb2_get_word(body + SMB2_CREATE_RESP_STRUCT_SIZE_OFFSET) != SMB2_CREATE_RESP_SIZE) {
    return EPROTOCOLERR;
  }

  /* Return the server's file id: both halves identify the open for later operations. */
  file_id_out->Persistent = smb2_get_qword(body + SMB2_CREATE_RESP_FILEID_OFFSET);
  file_id_out->Volatile = smb2_get_qword(body + SMB2_CREATE_RESP_FILEID_VOL_OFFSET);

  if (size_out != NULL) {
    *size_out = smb2_get_qword(body + SMB2_CREATE_RESP_END_OF_FILE_OFFSET);
  }

  if (attributes_out != NULL) {
    *attributes_out = smb2_get_dword(body + SMB2_CREATE_RESP_FILE_ATTRS_OFFSET);
  }

  if (write_time_out != NULL) {
    *write_time_out = smb2_get_qword(body + SMB2_CREATE_RESP_WRITE_TIME_OFFSET);
  }

  return OK;
}

err_t SMB2_OpenFile(SMB2_Share *share, const char *filename, int mode, int *fh_out, uint64_t *size_out, uint32_t *attribs_out,
                    uint64_t *write_time_out) {
  SMB2_FILEID file_id;
  uint32_t access;
  uint64_t create_size = 0u;
  uint32_t create_attribs = 0u;
  uint64_t create_write_time = 0u;
  err_t res;
  int idx;

  /* Map the RISC OS open mode to the SMB2 desired-access mask. */
  switch (mode) {
  case MODE_WR:
    access = SMB2_ACCESS_WRITE;
    break;
  case MODE_RDWR:
    access = SMB2_ACCESS_READ | SMB2_ACCESS_WRITE;
    break;
  default:
    access = SMB2_ACCESS_READ;
    break;
  }

  /* Open an existing file only (FILE_NON_DIRECTORY_FILE), shared for read/write/delete. */
  res = SMB2_Create(share, filename, access, FILE_ATTRIBUTE_NORMAL, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN,
                    FILE_NON_DIRECTORY_FILE, &file_id, &create_size, &create_attribs, &create_write_time);

  if (res != OK) {
    return res;
  }

  idx = smb2_alloc_file(share, file_id);

  if (idx < 0) {
    /* No free handle slot: close the server-side handle so it does not leak. */
    smb2_close_fileid(share, &file_id);
    return ENOFHANDLES;
  }

  /* Remember the DOS path against this handle, for diagnostics and so a lookup can tell the file is open. */
  strncpy(smb2_files[idx].dos_path, filename, sizeof(smb2_files[idx].dos_path) - 1);
  smb2_files[idx].dos_path[sizeof(smb2_files[idx].dos_path) - 1] = '\0';

  if (size_out != NULL) {
    *size_out = create_size;
  }

  if (attribs_out != NULL) {
    *attribs_out = create_attribs;
  }

  if (write_time_out != NULL) {
    *write_time_out = create_write_time;
  }

  *fh_out = idx;

  return OK;
}

err_t SMB2_CreateFile(SMB2_Share *share, const char *filename, uint32_t file_attributes, int *fh_out) {
  SMB2_FILEID file_id;
  err_t res;
  int idx;
  size_t nlen;

  vdebug("SMB2_CreateFile: \"%s\"\n", filename);

  nlen = strlen(filename);

  /* Reject a trailing dot: Windows silently strips it, so the name requested would not round-trip. */
  if (nlen > 0 && filename[nlen - 1] == '.') {
    return EBADNAME;
  }

  /*
   * Open for read/write, creating the file or truncating an existing one (overwrite-if), with full sharing so as not to lock other
   * clients out.
   */
  res = SMB2_Create(share, filename, SMB2_ACCESS_READ | SMB2_ACCESS_WRITE, file_attributes,
                    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OVERWRITE_IF, FILE_NON_DIRECTORY_FILE, &file_id, NULL,
                    NULL, NULL);

  if (res != OK) {
    return res;
  }

  idx = smb2_alloc_file(share, file_id);

  if (idx < 0) {
    /* No free handle slot: close the server-side handle so it does not leak. */
    smb2_close_fileid(share, &file_id);
    return ENOFHANDLES;
  }

  /* Remember the DOS path against this handle, for diagnostics and so a lookup can tell the file is open; strncpy won't terminate a
   * fully-filled buffer, so cap it by hand.
   */
  strncpy(smb2_files[idx].dos_path, filename, sizeof(smb2_files[idx].dos_path) - 1);
  smb2_files[idx].dos_path[sizeof(smb2_files[idx].dos_path) - 1] = '\0';

  *fh_out = idx;

  return OK;
}

err_t SMB2_Close(int fh, DOS_ATTRIBS *pAttr) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  SMB2_FileEntry *fe;
  SMB2_Server *srv;
  int req_len, resp_len;
  uint32_t status;

  fe = smb2_get_file(fh);

  if (fe == NULL || fe->share == NULL || fe->share->server == NULL) {
    return EFILEHANDLE;
  }

  srv = fe->share->server;

  /* If the caller supplied a modification time, push it with SET_INFO before closing, because CLOSE itself carries no timestamp. */
  if (pAttr != NULL && pAttr->utime != 0) {
    uint8_t info_buf[FILEBASIC_SIZE];
    uint64_t write_time = utime_to_filetime(pAttr->utime);

    /* Zero the FILE_BASIC_INFORMATION and set only last-write-time; the zeroed fields tell the server to leave the rest untouched. */
    memset(info_buf, 0, FILEBASIC_SIZE);
    smb2_put_qword(info_buf + FILEBASIC_LAST_WRITE_TIME_OFFSET, write_time);

    /* A refused timestamp still leaves the handle to close, so the SET_INFO's own error is not reported. */
    (void)smb2_set_info(fe->share, &fe->file_id, SMB2_0_INFO_FILE, FileBasicInformation, info_buf, FILEBASIC_SIZE);

    /* A SET_INFO that loses the connection frees this slot along with every other open file on the server. */
    if (!fe->in_use) {
      return ELINKFAILED;
    }
  }

  /*
   * Build and send CLOSE. POSTQUERY_ATTRIB asks the server to report the file's final size, times and attributes in the reply. Free the
   * local slot unconditionally: the server drops its handle whether or not it reports an error.
   */
  smb2_init_header(tx, SMB2_CLOSE, srv);
  smb2_set_tree_id(tx, fe->share);

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_CLOSE_REQ_SIZE);
  smb2_put_word(body + SMB2_CLOSE_REQ_STRUCT_SIZE_OFFSET, SMB2_CLOSE_REQ_SIZE);
  smb2_put_word(body + SMB2_CLOSE_REQ_FLAGS_OFFSET, SMB2_CLOSE_FLAG_POSTQUERY_ATTRIB);
  smb2_put_qword(body + SMB2_CLOSE_REQ_FILEID_OFFSET, fe->file_id.Persistent);
  smb2_put_qword(body + SMB2_CLOSE_REQ_FILEID_VOL_OFFSET, fe->file_id.Volatile);

  req_len = SMB2_HEADER_SIZE + SMB2_CLOSE_REQ_SIZE;

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  smb2_free_file(fh);

  if (NT_STATUS_IS_ERROR(status)) {
    debug("SMB2 close failed, status=0x%08X\n", status);
    return smb2_status_to_err(status);
  }

  /* If the server honoured POSTQUERY_ATTRIB, copy the final metadata back into the caller's block. */
  if (pAttr != NULL && resp_len >= SMB2_HEADER_SIZE + SMB2_CLOSE_RESP_SIZE) {
    uint8_t *resp_body = rx + SMB2_HEADER_SIZE;

    /* Only trust the fields once the fixed structure size matches: guards against a short or malformed reply. */
    if (smb2_get_word(resp_body + SMB2_CLOSE_RESP_STRUCT_SIZE_OFFSET) == SMB2_CLOSE_RESP_SIZE) {
      uint64_t srv_write_time = smb2_get_qword(resp_body + SMB2_CLOSE_RESP_LAST_WRITE_OFFSET);
      uint64_t srv_eof = smb2_get_qword(resp_body + SMB2_CLOSE_RESP_EOF_OFFSET);
      uint32_t srv_attribs = smb2_get_dword(resp_body + SMB2_CLOSE_RESP_ATTRIBS_OFFSET);

      /* A zero write-time means 'unset'; leave the caller's value alone in that case. */
      if (srv_write_time != 0u) {
        pAttr->utime = smb2_filetime_to_utime(srv_write_time);
      }

      /* FileSwitch lengths are 32-bit, so only take the server's EOF when it fits in 32 bits. */
      if (srv_eof <= 0xFFFFFFFFu) {
        pAttr->length = (uint)srv_eof;
      }

      pAttr->attr = (uint)srv_attribs;
    }
  }

  return OK;
}

err_t SMB2_Read(int fh, uint64_t offset, uint32_t len, uint8_t *where, uint32_t *actual_out) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  SMB2_FileEntry *fe;
  SMB2_Server *srv;
  uint32_t total_read = 0u;
  uint32_t max_read;
  int resp_len;

  fe = smb2_get_file(fh);

  if (fe == NULL || fe->share == NULL || fe->share->server == NULL) {
    return EFILEHANDLE;
  }

  srv = fe->share->server;
  max_read = srv->max_read_size;

  /* Cap the per-request read to what fits the work buffer, falling back to that limit if the server advertised no maximum. */
  if (max_read == 0 || max_read > (uint32_t)(SMB2_WORKBUF_SIZE - SMB2_HEADER_SIZE - SMB2_READ_RESP_MIN)) {
    max_read = SMB2_WORKBUF_SIZE - SMB2_HEADER_SIZE - SMB2_READ_RESP_MIN;
  }

  /* Loop issuing READs until the whole request is satisfied or the server returns a short read or EOF. */
  while (len > 0) {
    uint8_t *body;
    uint16_t charge;
    uint32_t chunk;
    uint32_t data_len;
    uint16_t data_offset;
    int req_len;
    uint32_t status;

    /*
     * Size this chunk to the credits in hand (the helper reduces it when the balance is short), then build and send one READ. MinCount
     * is 0 so the server may legitimately return fewer bytes than asked.
     */
    chunk = (len > max_read) ? max_read : len;
    charge = smb2_charge_and_scale(&chunk, len, srv->credits_available);

    smb2_init_header(tx, SMB2_READ, srv);

    smb2_set_credit_charge(tx, srv, charge);
    smb2_set_tree_id(tx, fe->share);

    body = tx + SMB2_HEADER_SIZE;
    memset(body, 0, SMB2_READ_REQ_SIZE + SMB2_VARIABLE_TRAILER);
    smb2_put_word(body + SMB2_READ_REQ_STRUCT_SIZE_OFFSET, SMB2_READ_REQ_SIZE + SMB2_VARIABLE_TRAILER);
    body[SMB2_READ_REQ_PADDING_OFFSET] = SMB2_READ_REQ_PADDING;
    body[SMB2_READ_REQ_FLAGS_OFFSET] = 0;
    smb2_put_dword(body + SMB2_READ_REQ_LENGTH_OFFSET, chunk);
    smb2_put_qword(body + SMB2_READ_REQ_FILE_POS_OFFSET, offset);
    smb2_put_qword(body + SMB2_READ_REQ_FILEID_OFFSET, fe->file_id.Persistent);
    smb2_put_qword(body + SMB2_READ_REQ_FILEID_VOL_OFFSET, fe->file_id.Volatile);
    smb2_put_dword(body + SMB2_READ_REQ_MIN_COUNT_OFFSET, 0);

    req_len = SMB2_HEADER_SIZE + SMB2_READ_REQ_SIZE + SMB2_VARIABLE_TRAILER;

    status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

    /* Reading at or past EOF is not an error: stop and report what has already been read. */
    if (status == STATUS_END_OF_FILE) {
      break;
    }

    if (NT_STATUS_IS_ERROR(status)) {
      return smb2_status_to_err(status);
    }

    /* Reply too short to hold a READ response header. */
    if (resp_len < SMB2_HEADER_SIZE + SMB2_READ_RESP_MIN) {
      return EPROTOCOLERR;
    }

    body = rx + SMB2_HEADER_SIZE;

    /* Wrong fixed structure size: the offsets below would be meaningless. */
    if (smb2_get_word(body + SMB2_READ_RESP_STRUCT_SIZE_OFFSET) != SMB2_READ_RESP_SIZE) {
      return EPROTOCOLERR;
    }

    data_offset = (uint16_t)(body[SMB2_READ_RESP_DATA_POS_OFFSET] | (body[SMB2_READ_RESP_DATA_POS_OFFSET + 1] << 8));
    data_len = smb2_get_dword(body + SMB2_READ_RESP_DATA_LEN_OFFSET);

    /* Bounds-check the server's offset and length against what was actually received before copying.  Use the
     * subtraction form so a wire-controlled data_len near UINT32_MAX cannot wrap the sum past the check.
     */
    if (data_offset > (uint32_t)resp_len || data_len > (uint32_t)resp_len - data_offset) {
      return EPROTOCOLERR;
    }

    /* Never accept more than was asked for. */
    if (data_len > chunk) {
      data_len = chunk;
    }

    /* Data offset is measured from the start of the SMB2 message, so copy from rx (not the body pointer). */
    memcpy(where, rx + data_offset, data_len);

    where += data_len;
    offset += data_len;
    total_read += data_len;
    len -= data_len;

    /* A short read means no more data is available: stop looping. */
    if (data_len < chunk) {
      break;
    }
  }

  if (actual_out != NULL) {
    *actual_out = total_read;
  }

  return OK;
}

err_t SMB2_Write(int fh, uint64_t offset, uint32_t len, const uint8_t *where, uint32_t *actual_out) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  SMB2_FileEntry *fe;
  SMB2_Server *srv;
  uint32_t total_written = 0u;
  uint32_t max_write;
  int resp_len;

  fe = smb2_get_file(fh);

  if (fe == NULL || fe->share == NULL || fe->share->server == NULL) {
    return EFILEHANDLE;
  }

  srv = fe->share->server;
  max_write = srv->max_write_size;

  /* Cap the per-request write to what fits the work buffer, falling back to that limit if the server advertised no maximum. */
  if (max_write == 0 || max_write > (uint32_t)(SMB2_WORKBUF_SIZE - SMB2_HEADER_SIZE - SMB2_WRITE_REQ_SIZE - SMB2_VARIABLE_TRAILER)) {
    max_write = SMB2_WORKBUF_SIZE - SMB2_HEADER_SIZE - SMB2_WRITE_REQ_SIZE - SMB2_VARIABLE_TRAILER;
  }

  /* Loop writing chunks until every byte is sent or the server accepts fewer than offered. */
  while (len > 0) {
    uint8_t *body;
    uint16_t charge;
    uint32_t chunk;
    uint32_t written;
    uint16_t data_offset;
    int req_len;
    uint32_t status;

    /* Payload sits immediately after the fixed WRITE request structure. */
    chunk = (len > max_write) ? max_write : len;

    data_offset = SMB2_HEADER_SIZE + SMB2_WRITE_REQ_SIZE;

    /* Also cap so the fixed request plus payload fit within the transmit buffer. */
    if (chunk > (uint32_t)(SMB2_WORKBUF_SIZE - data_offset)) {
      chunk = (uint32_t)(SMB2_WORKBUF_SIZE - data_offset);
    }

    /* Scale the chunk to available credits, build the WRITE with the payload copied in at DataOffset, and send it. */
    charge = smb2_charge_and_scale(&chunk, len, srv->credits_available);

    smb2_init_header(tx, SMB2_WRITE, srv);
    smb2_set_credit_charge(tx, srv, charge);
    smb2_set_tree_id(tx, fe->share);

    body = tx + SMB2_HEADER_SIZE;
    memset(body, 0, SMB2_WRITE_REQ_SIZE);
    smb2_put_word(body + SMB2_WRITE_REQ_STRUCT_SIZE_OFFSET, SMB2_WRITE_REQ_SIZE + SMB2_VARIABLE_TRAILER);
    smb2_put_word(body + SMB2_WRITE_REQ_DATA_POS_OFFSET, data_offset);
    smb2_put_dword(body + SMB2_WRITE_REQ_LENGTH_OFFSET, chunk);
    smb2_put_qword(body + SMB2_WRITE_REQ_FILE_POS_OFFSET, offset);
    smb2_put_qword(body + SMB2_WRITE_REQ_FILEID_OFFSET, fe->file_id.Persistent);
    smb2_put_qword(body + SMB2_WRITE_REQ_FILEID_VOL_OFFSET, fe->file_id.Volatile);

    memcpy(tx + data_offset, where, chunk);

    req_len = (int)data_offset + (int)chunk;

    status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

    if (NT_STATUS_IS_ERROR(status)) {
      return smb2_status_to_err(status);
    }

    /* Reject a reply too short to hold a WRITE response. */
    if (resp_len < SMB2_HEADER_SIZE + SMB2_WRITE_RESP_MIN) {
      return EPROTOCOLERR;
    }

    body = rx + SMB2_HEADER_SIZE;

    /* Reject a reply with the wrong fixed structure size rather than trust its count field. */
    if (smb2_get_word(body + SMB2_WRITE_RESP_STRUCT_SIZE_OFFSET) != SMB2_WRITE_RESP_SIZE) {
      return EPROTOCOLERR;
    }

    /* Advance by the byte count the server actually wrote, which may be short of the chunk offered. */
    written = smb2_get_dword(body + SMB2_WRITE_RESP_COUNT_OFFSET);

    /*
     * Never trust a Count larger than the chunk sent: an inflated value would underflow the unsigned len below and advance where past
     * the caller's source buffer on the next iteration.
     */
    if (written > chunk) {
      written = chunk;
    }

    where += written;
    offset += written;
    total_written += written;
    len -= written;

    /* Server took fewer bytes than offered: stop rather than spin. */
    if (written < chunk) {
      break;
    }
  }

  if (actual_out != NULL) {
    *actual_out = total_written;
  }

  return OK;
}

err_t SMB2_Flush(int fh) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  SMB2_FileEntry *fe;
  SMB2_Server *srv;
  int resp_len;
  uint32_t status;

  /* A handle that is not open, or whose share has gone, cannot be flushed. */
  fe = smb2_get_file(fh);

  if (fe == NULL || fe->share == NULL || fe->share->server == NULL) {
    return EFILEHANDLE;
  }

  /* Build and send FLUSH so the server commits this file's buffered data to stable storage. */
  srv = fe->share->server;

  smb2_init_header(tx, SMB2_FLUSH, srv);
  smb2_set_tree_id(tx, fe->share);

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_FLUSH_REQ_SIZE);
  smb2_put_word(body + SMB2_FLUSH_REQ_STRUCT_SIZE_OFFSET, SMB2_FLUSH_REQ_SIZE);
  smb2_put_qword(body + SMB2_FLUSH_REQ_FILEID_OFFSET, fe->file_id.Persistent);
  smb2_put_qword(body + SMB2_FLUSH_REQ_FILEID_VOL_OFFSET, fe->file_id.Volatile);

  /* Only an error status fails the flush. */
  status = SMB2_SendRecv(srv, tx, SMB2_HEADER_SIZE + SMB2_FLUSH_REQ_SIZE, rx, SMB2_WORKBUF_SIZE, &resp_len);

  if (NT_STATUS_IS_ERROR(status)) {
    return smb2_status_to_err(status);
  }

  return OK;
}

uint smb2_filetime_to_utime(uint64_t ft) {
  uint64_t secs;

  /* A zero FILETIME means 'no time set': map straight to zero. */
  if (ft == 0) {
    return 0;
  }

  /* FILETIME counts 100ns ticks; reduce to whole seconds first. */
  secs = ft / FILETIME_TICKS_PER_SECOND;

  /* Anything before the 1970 Unix epoch can't be represented: clamp to zero. */
  if (secs <= FILETIME_EPOCH_OFFSET) {
    return 0;
  }

  /* Rebase from the 1601 FILETIME epoch onto the 1970 epoch. */
  secs -= FILETIME_EPOCH_OFFSET;

  /* RISC OS time is 32-bit seconds: saturate rather than wrap. */
  if (secs > (uint64_t)UINT32_CLAMP) {
    return (uint)UINT32_CLAMP;
  }

  return (uint)secs;
}

static uint64_t utime_to_filetime(uint utime) {
  /* Zero means 'no time set'; preserve it as a zero FILETIME. */
  if (utime == 0) {
    return 0;
  }

  /* Shift onto the 1601 epoch and scale seconds up to 100ns FILETIME ticks. */
  return ((uint64_t)utime + FILETIME_EPOCH_OFFSET) * FILETIME_TICKS_PER_SECOND;
}

static int smb2_attribs_to_dos(uint32_t smb2_attr) {
  int dos = 0;

  if (smb2_attr & FILE_ATTRIBUTE_READONLY) {
    dos |= ATTR_RO;
  }

  if (smb2_attr & FILE_ATTRIBUTE_HIDDEN) {
    dos |= ATTR_HID;
  }

  if (smb2_attr & FILE_ATTRIBUTE_SYSTEM) {
    dos |= ATTR_SYS;
  }

  if (smb2_attr & FILE_ATTRIBUTE_DIRECTORY) {
    dos |= ATTR_DIR;
  }

  if (smb2_attr & FILE_ATTRIBUTE_ARCHIVE) {
    dos |= ATTR_ARC;
  }

  return dos;
}

uint32_t dos_attribs_to_smb2(int dos_attr) {
  uint32_t attr = 0u;

  /* Map each DOS attribute bit to its SMB2 equivalent. */
  if (dos_attr & ATTR_RO) {
    attr |= FILE_ATTRIBUTE_READONLY;
  }

  if (dos_attr & ATTR_HID) {
    attr |= FILE_ATTRIBUTE_HIDDEN;
  }

  if (dos_attr & ATTR_SYS) {
    attr |= FILE_ATTRIBUTE_SYSTEM;
  }

  if (dos_attr & ATTR_DIR) {
    attr |= FILE_ATTRIBUTE_DIRECTORY;
  }

  if (dos_attr & ATTR_ARC) {
    attr |= FILE_ATTRIBUTE_ARCHIVE;
  }

  /* A zero mask would leave the server's attributes unchanged, so a file with none set is sent as NORMAL. */
  if (attr == 0) {
    attr = FILE_ATTRIBUTE_NORMAL;
  }

  return attr;
}

/*
 * Issue an SMB2 QUERY_INFO request and copy the returned information blob to the caller.
 *
 * Parameters:
 *   share        connected share whose session carries the request
 *   file_id      open handle to query
 *   info_type    info type (SMB2_0_INFO_FILE / _FILESYSTEM / ...)
 *   file_class   information class within that type
 *   out_buf      buffer to receive the returned blob
 *   out_bufsize  size of out_buf; also sent as the server's output-length cap
 *   out_len      receives the number of bytes copied
 *
 * Returns: OK, a mapped filing-system error from the server status, or EPROTOCOLERR on a malformed reply.
 */
static err_t smb2_query_info(SMB2_Share *share, SMB2_FILEID *file_id, uint8_t info_type, uint8_t file_class, uint8_t *out_buf,
                             int out_bufsize, int *out_len) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  SMB2_Server *srv = share->server;
  int req_len, resp_len;
  uint32_t status;
  uint16_t buf_offset;
  uint32_t buf_length;

  /*
   * Build the fixed QUERY_INFO request (info type/class, an output-length cap, and the target FileId), then send. StructureSize counts
   * one byte of the variable input section even though none is sent.
   */
  smb2_init_header(tx, SMB2_QUERY_INFO, srv);
  smb2_set_tree_id(tx, share);

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_QUERY_INFO_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  smb2_put_word(body + SMB2_QUERY_INFO_REQ_STRUCT_SIZE_OFFSET, SMB2_QUERY_INFO_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  body[SMB2_QUERY_INFO_REQ_INFO_TYPE_OFFSET] = info_type;
  body[SMB2_QUERY_INFO_REQ_FILE_CLASS_OFFSET] = file_class;
  smb2_put_dword(body + SMB2_QUERY_INFO_REQ_OUTPUT_LEN_OFFSET, (uint32_t)out_bufsize);
  smb2_put_qword(body + SMB2_QUERY_INFO_REQ_FILEID_OFFSET, file_id->Persistent);
  smb2_put_qword(body + SMB2_QUERY_INFO_REQ_FILEID_VOL_OFFSET, file_id->Volatile);

  req_len = SMB2_HEADER_SIZE + SMB2_QUERY_INFO_REQ_SIZE + SMB2_VARIABLE_TRAILER;

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  /* Map a server error status to a filing-system error. */
  if (NT_STATUS_IS_ERROR(status)) {
    return smb2_status_to_err(status);
  }

  /* Too short even for the fixed reply header. */
  if (resp_len < SMB2_HEADER_SIZE + SMB2_QUERY_INFO_RESP_MIN) {
    return EPROTOCOLERR;
  }

  body = rx + SMB2_HEADER_SIZE;

  /* Reject a reply whose StructureSize is not the value MS-SMB2 fixes for this response. */
  if (smb2_get_word(body + SMB2_QUERY_INFO_RESP_STRUCT_SIZE_OFFSET) != SMB2_QUERY_INFO_RESP_SIZE) {
    return EPROTOCOLERR;
  }

  /* Read where the returned blob sits within the response and how long it is. */
  buf_offset = smb2_get_word(body + SMB2_QUERY_INFO_RESP_OUTPUT_POS_OFFSET);
  buf_length = smb2_get_dword(body + SMB2_QUERY_INFO_RESP_OUTPUT_LEN_OFFSET);

  /* Reject an offset or length that runs past the bytes actually received. */
  if ((uint32_t)buf_offset > (uint32_t)resp_len || buf_length > (uint32_t)resp_len - (uint32_t)buf_offset) {
    return EPROTOCOLERR;
  }

  /* Clamp to the caller's buffer; the server may return more than fits. */
  if ((int)buf_length > out_bufsize) {
    buf_length = (uint32_t)out_bufsize;
  }

  /* OutputBufferOffset is measured from the SMB2 header start, so copy from rx rather than body. */
  memcpy(out_buf, rx + buf_offset, buf_length);
  *out_len = (int)buf_length;

  return OK;
}

static err_t smb2_set_info(SMB2_Share *share, SMB2_FILEID *file_id, uint8_t info_type, uint8_t file_class, const uint8_t *in_buf,
                           int in_len) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  SMB2_Server *srv = share->server;
  uint16_t buf_offset;
  int req_len, resp_len;
  uint32_t status;

  /*
   * Assemble the SET_INFO request, whose fixed structure names the info type and class and points BufferOffset at the trailing
   * blob that follows immediately, then send it.
   */
  smb2_init_header(tx, SMB2_SET_INFO, srv);
  smb2_set_tree_id(tx, share);

  buf_offset = SMB2_HEADER_SIZE + SMB2_SET_INFO_REQ_SIZE;

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_SET_INFO_REQ_SIZE);
  smb2_put_word(body + SMB2_SET_INFO_REQ_STRUCT_SIZE_OFFSET, SMB2_SET_INFO_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  body[SMB2_SET_INFO_REQ_INFO_TYPE_OFFSET] = info_type;
  body[SMB2_SET_INFO_REQ_FILE_CLASS_OFFSET] = file_class;
  smb2_put_dword(body + SMB2_SET_INFO_REQ_BUFFER_LEN_OFFSET, (uint32_t)in_len);
  smb2_put_word(body + SMB2_SET_INFO_REQ_BUFFER_POS_OFFSET, buf_offset);
  smb2_put_qword(body + SMB2_SET_INFO_REQ_FILEID_OFFSET, file_id->Persistent);
  smb2_put_qword(body + SMB2_SET_INFO_REQ_FILEID_VOL_OFFSET, file_id->Volatile);

  memcpy(tx + buf_offset, in_buf, (size_t)in_len);

  req_len = (int)buf_offset + in_len;

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  /* A genuine error status maps straight back to a RISC OS error. */
  if (NT_STATUS_IS_ERROR(status)) {
    return smb2_status_to_err(status);
  }

  /*
   * STATUS_STOPPED_ON_SYMLINK carries only warning severity so it slips past the error test above, yet the change never applied, so treat
   * it as a failure too.
   */
  if (status == STATUS_STOPPED_ON_SYMLINK) {
    return smb2_status_to_err(status);
  }

  return OK;
}

/*
 * Fetch an object's length, timestamp and DOS attributes by name, opening it with the given create options.
 *
 * Parameters:
 *   share           connected share the object lives on
 *   filename        DOS-form path within the share
 *   create_options  FILE_OPEN_REPARSE_POINT to read a symbolic link at the end of the path rather than its target, else 0
 *   pAttr           receives the RISC OS time, attribute byte and clamped length
 *
 * Returns: OK, EFILENOTFOUND for a suppressed hidden/system object, or an err_t from the create.
 */
static err_t smb2_get_attribs(SMB2_Share *share, const char *filename, uint32_t create_options, DOS_ATTRIBS *pAttr) {
  SMB2_FILEID file_id;
  uint64_t size;
  uint32_t smb2_attr;
  uint64_t write_time;
  err_t res;

  /*
   * The directory lookup that has just resolved this name can answer for a directory, and for a file when the caller has no use for its
   * length: the length a listing reports for a file can lag while another client is writing it, and FileSwitch sizes a load by the figure
   * it is given. Otherwise open purely for the attributes, sharing all modes so this never blocks another opener.
   */
  if (smb2_lookup_covers(share, filename) && smb2_lookup.present && smb2_lookup.trusted_meta &&
      ((smb2_lookup.attr & FILE_ATTRIBUTE_DIRECTORY) != 0u || smb2_length_not_needed)) {
    size = smb2_lookup.size;
    smb2_attr = smb2_lookup.attr;
    write_time = smb2_lookup.write_time;
    vdebug("SMB2_GetAttribs: LOOKUP \"%s\"\n", filename);
  } else {
    res = SMB2_Create(share, filename, FILE_READ_ATTRIBUTES, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN,
                      create_options, &file_id, &size, &smb2_attr, &write_time);

    if (res != OK) {
      return res;
    }

    smb2_close_fileid(share, &file_id);
    vdebug("SMB2_GetAttribs: SERVER \"%s\"\n", filename);
  }

  /* Translate the wire metadata into RISC OS form; a length above 4 GiB is clamped because FileSwitch sizes are 32-bit. */
  pAttr->utime = smb2_filetime_to_utime(write_time);
  pAttr->attr = smb2_attribs_to_dos(smb2_attr);
  pAttr->length = (size > QWORD_OVERFLOW_32) ? (int)UINT32_CLAMP : (int)size;

  /* When the caller has not opted to see hidden files, report a hidden or system file as if it were absent. */
  if (!(LM_Vars.namemode & NM_HIDDEN) && (pAttr->attr & (ATTR_HID | ATTR_SYS))) {
#ifdef SMB2_DEBUG_VERBOSE
    debug("SMB2_GetAttribs: SERVER synthesised EFILENOTFOUND path=\"%s\" attr=0x%02X smb2_attr=0x%08X\n", filename, (unsigned)pAttr->attr,
          (unsigned)smb2_attr);
#endif
    return EFILENOTFOUND;
  }

  return OK;
}

err_t SMB2_GetAttribs(SMB2_Share *share, const char *filename, DOS_ATTRIBS *pAttr) {
  return smb2_get_attribs(share, filename, 0u, pAttr);
}

err_t SMB2_GetLinkAttribs(SMB2_Share *share, const char *filename, DOS_ATTRIBS *pAttr) {
  return smb2_get_attribs(share, filename, FILE_OPEN_REPARSE_POINT, pAttr);
}

err_t SMB2_SetAttribs(SMB2_Share *share, const char *filename, DOS_ATTRIBS *pAttr) {
  SMB2_FILEID file_id;
  uint8_t info_buf[FILEBASIC_SIZE];
  err_t res;

  /* Open for attribute writes only, sharing all modes. */
  res = SMB2_Create(share, filename, FILE_WRITE_ATTRIBUTES, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN, 0,
                    &file_id, NULL, NULL, NULL);

  if (res != OK) {
    return res;
  }

  /*
   * Zero the block first: a zero timestamp tells the server to leave that time untouched.  The attribute field is always written,
   * because dos_attribs_to_smb2 never returns zero.
   */
  memset(info_buf, 0, FILEBASIC_SIZE);

  /* Only stamp a write time when the caller supplied one; zero means keep the server's existing timestamp. */
  if (pAttr->utime != 0) {
    uint64_t write_time = utime_to_filetime(pAttr->utime);
    smb2_put_qword(info_buf + FILEBASIC_LAST_WRITE_TIME_OFFSET, write_time);
  }

  /* Set the DOS attributes and apply the whole basic-info block in a single SET_INFO. */
  smb2_put_dword(info_buf + FILEBASIC_FILE_ATTRIBUTES_OFFSET, dos_attribs_to_smb2(pAttr->attr));

  res = smb2_set_info(share, &file_id, SMB2_0_INFO_FILE, FileBasicInformation, info_buf, FILEBASIC_SIZE);

  smb2_close_fileid(share, &file_id);

  return res;
}

err_t SMB2_GetLength(int fh, uint64_t *size_out) {
  SMB2_FileEntry *fe;
  uint8_t info_buf[FILESTD_SIZE];
  int info_len;
  err_t res;

  fe = smb2_get_file(fh);

  if (fe == NULL || fe->share == NULL || fe->share->server == NULL) {
    return EFILEHANDLE;
  }

  /* FILE_STANDARD_INFORMATION carries the current end-of-file position. */
  res = smb2_query_info(fe->share, &fe->file_id, SMB2_0_INFO_FILE, FileStandardInformation, info_buf, (int)sizeof(info_buf), &info_len);

  if (res != OK) {
    return res;
  }

  /* Reject a short reply before reading the 8-byte end-of-file field. */
  if (info_len < FILESTD_END_OF_FILE_OFFSET + 8) {
    return EPROTOCOLERR;
  }

  /* EndOfFile is the logical length, not the (larger) allocated size. */
  *size_out = smb2_get_qword(info_buf + FILESTD_END_OF_FILE_OFFSET);

  return OK;
}

err_t SMB2_Truncate(int fh, uint64_t length) {
  SMB2_FileEntry *fe;
  uint8_t info_buf[FILEEOF_SIZE];

  fe = smb2_get_file(fh);

  if (fe == NULL || fe->share == NULL || fe->share->server == NULL) {
    return EFILEHANDLE;
  }

  /* The new logical length; a SET_INFO with this both extends and shrinks the file. */
  smb2_put_qword(info_buf, length);

  return smb2_set_info(fe->share, &fe->file_id, SMB2_0_INFO_FILE, FileEndOfFileInformation, info_buf, FILEEOF_SIZE);
}

/* Build a CLOSE of a handle in the transmit buffer, SMB2_HEADER_SIZE + SMB2_CLOSE_REQ_SIZE bytes long. */
static void smb2_build_close(SMB2_Share *share, const SMB2_FILEID *fid) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *b = tx + SMB2_HEADER_SIZE;

  smb2_init_header(tx, SMB2_CLOSE, share->server);
  smb2_set_tree_id(tx, share);

  /* Zero flags: POSTQUERY_ATTRIB is not asked for, so the reply carries no attributes. */
  memset(b, 0, SMB2_CLOSE_REQ_SIZE);
  smb2_put_word(b + SMB2_CLOSE_REQ_STRUCT_SIZE_OFFSET, SMB2_CLOSE_REQ_SIZE);
  smb2_put_qword(b + SMB2_CLOSE_REQ_FILEID_OFFSET, fid->Persistent);
  smb2_put_qword(b + SMB2_CLOSE_REQ_FILEID_VOL_OFFSET, fid->Volatile);
}

static err_t smb2_close_fileid(SMB2_Share *share, SMB2_FILEID *fid) {
  int rlen;
  uint32_t status;

  if (share == NULL || share->server == NULL) {
    return ELINKFAILED;
  }

  smb2_build_close(share, fid);
  status = SMB2_SendRecv(share->server, smb2_txbuf, SMB2_HEADER_SIZE + SMB2_CLOSE_REQ_SIZE, smb2_rxbuf, SMB2_WORKBUF_SIZE, &rlen);

  /* A failed CLOSE is reported to the caller, which decides whether it matters. */
  if (NT_STATUS_IS_ERROR(status)) {
    return smb2_status_to_err(status);
  }

  return OK;
}

/*
 * Close a directory a listing has finished with, without waiting for the reply; see smb2_unanswered_closes.  Falls back to waiting when
 * no slot is free or another exchange holds the socket.  The request is sent as SMB2_SendRecv would send it, signed and with its credits
 * spent, and a failure to send marks the connection dead as it would there.
 *
 * Parameters:
 *   share  the share the handle belongs to
 *   fid    the directory handle
 */
static void smb2_close_listing(SMB2_Share *share, SMB2_FILEID *fid) {
  SMB2_Server *srv;
  int slot;
  err_t res;

  if (share == NULL || share->server == NULL) {
    return;
  }
  srv = share->server;

  for (slot = 0; slot < SMB2_UNANSWERED_CLOSES && smb2_unanswered_closes[slot].srv != NULL; slot++) {
  }
  if (slot == SMB2_UNANSWERED_CLOSES || smb2_sendrecv_active || (srv->flags & SMB2_SRV_DEAD)) {
    (void)smb2_close_fileid(share, fid);
    return;
  }

  smb2_build_close(share, fid);
  smb2_lookup.valid = false; // as for any request, so the lookup rules stay those SMB2_SendRecv keeps

  if (srv->flags & SMB2_SRV_SIGNED) {
    smb2_sign_message(srv, smb2_txbuf, SMB2_HEADER_SIZE + SMB2_CLOSE_REQ_SIZE);
  }
  smb2_spend_credits(srv, smb2_txbuf);

  smb2_sendrecv_active = true;
  res = SMB2X_Send(srv->raw_socket, smb2_txbuf, SMB2_HEADER_SIZE + SMB2_CLOSE_REQ_SIZE, LM_Tick() + smb2_deadline_cs());
  smb2_sendrecv_active = false;

  if (res != OK) {
    debug("SMB2: unanswered CLOSE send failed res=%d: marking connection dead\n", res);
    SMB_MarkServerDeadBySMB2(srv, "send failure");
    return;
  }

  smb2_unanswered_closes[slot].srv = srv;
  smb2_unanswered_closes[slot].msg_id = smb2_get_qword(smb2_txbuf + SMB2_HEADER_MESSAGE_ID_OFFSET);
  vdebug("SMB2: CLOSE msgid=0x%08X sent, reply not awaited\n", (unsigned)smb2_unanswered_closes[slot].msg_id);
}

err_t SMB2_MkDir(SMB2_Share *share, const char *path, bool *created) {
  SMB2_FILEID file_id;
  err_t res;
  size_t plen;

  *created = false;
  plen = strlen(path);

  /* Reject a trailing dot: Windows silently strips it, so the directory would be made under another name. */
  if (plen > 0 && path[plen - 1] == '.') {
    return EBADNAME;
  }

  /* FILE_CREATE fails if anything already exists at the path. */
  res = SMB2_Create(share, path, FILE_READ_ATTRIBUTES, FILE_ATTRIBUTE_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_CREATE,
                    FILE_DIRECTORY_FILE, &file_id, NULL, NULL, NULL);

  if (res == OK) {
    /* Created cleanly: release the handle the create left open. */
    smb2_close_fileid(share, &file_id);
    *created = true;
    return OK;
  }

  /* Already exists: re-open demanding a directory, so an existing directory counts as success but a same-named file still fails. */
  if (res == EFILEEXISTS) {
    err_t probe;
    probe = SMB2_Create(share, path, FILE_READ_ATTRIBUTES, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN, FILE_DIRECTORY_FILE, &file_id,
                        NULL, NULL, NULL);

    if (probe == OK) {
      /* The directory was already there: release the handle the probe left open. */
      smb2_close_fileid(share, &file_id);
      return OK;
    }
  }

  return res;
}

err_t SMB2_RmDir(SMB2_Share *share, const char *path) {
  SMB2_FILEID file_id;
  err_t res;
  bool verify;

  /*
   * Open with delete-on-close; the CLOSE below is what actually removes the directory.  Share read/write/delete, as Windows' own
   * RemoveDirectory does, so another client listing or watching the directory with delete sharing allowed does not make the open fail.
   * A symbolic link at the end of the path is opened as itself, so the link goes and the directory it points to stays.
   */
  res = SMB2_Create(share, path, SMB2_DELETE, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN,
                    FILE_DIRECTORY_FILE | FILE_DELETE_ON_CLOSE | FILE_OPEN_REPARSE_POINT, &file_id, NULL, NULL, NULL);

  if (res != OK) {
    return res;
  }

  /*
   * Some non-Windows servers report delete-on-close success even for a non-empty directory, so verify the removal.  Decide before the
   * close, which can lose the link and the server record with it.
   */
  verify = (share->server->flags & SMB2_SRV_NON_WINDOWS) != 0u;

  /* Closing the handle triggers the delete, so a server that refuses it, such as for a directory that is not empty, says so here. */
  res = smb2_close_fileid(share, &file_id);

  if (res != OK) {
    return res;
  }

  if (verify) {
    SMB2_FILEID probe_id;
    err_t probe;

    /* Re-open the same object to check whether it really went. */
    probe = SMB2_Create(share, path, FILE_READ_ATTRIBUTES, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN,
                        FILE_DIRECTORY_FILE | FILE_OPEN_REPARSE_POINT, &probe_id, NULL, NULL, NULL);

    /* Still openable: the delete silently failed, so report it as not empty. */
    if (probe == OK) {
      smb2_close_fileid(share, &probe_id);
      debug("SMB2_RmDir: server lied about delete-on-close success on \"%s\" - directory still present, surfacing EDIRNOTEMPTY\n", path);

      return EDIRNOTEMPTY;
    }

    /* Only "not found" confirms the removal; any other failure leaves the outcome unknown, so report it. */
    if (probe != EFILENOTFOUND && probe != EPATHNOTFOUND) {
      return probe;
    }
  }

  return OK;
}

err_t SMB2_Delete(SMB2_Share *share, const char *path, bool link_itself) {
  SMB2_FILEID file_id;
  uint32_t options = FILE_NON_DIRECTORY_FILE | FILE_DELETE_ON_CLOSE;
  err_t res;

  /* Opening a symbolic link as itself makes the link the object deleted; otherwise the open follows it to its target. */
  if (link_itself) {
    options |= FILE_OPEN_REPARSE_POINT;
  }

  /*
   * SMB2 has no standalone delete; open the file requesting delete access with FILE_DELETE_ON_CLOSE so it is removed when the handle
   * closes.  Share read/write/delete so an open elsewhere that allows deletion does not make this open fail with a sharing violation.
   */
  res = SMB2_Create(share, path, SMB2_DELETE, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN, options, &file_id, NULL,
                    NULL, NULL);

  if (res != OK) {
    return res;
  }

  /* Closing the handle is what actually removes the file, honouring the delete-on-close flag set at open. */
  smb2_close_fileid(share, &file_id);

  return OK;
}

/*
 * Rename an open file via SMB2 SET_INFO with FileRenameInformation.
 *
 * The handle must already be open with DELETE access, and the new path is share-relative in DOS form.
 *
 * Parameters:
 *   share    connected share
 *   file_id  open handle to the file being renamed
 *   newpath  new share-relative DOS path
 *
 * Returns: OK or a mapped error from the SET_INFO exchange.
 */
static err_t smb2_send_rename(SMB2_Share *share, SMB2_FILEID *file_id, const char *newpath) {
  uint8_t info_buf[FILERENAME_MAX_BUFFER];
  int newname_bytes;

  /*
   * Zero the FileRenameInformation header, which leaves ReplaceIfExists clear so an existing target fails the rename, then add the
   * UTF-16LE new name and its byte length.
   */
  memset(info_buf, 0, FILERENAME_HDR_SIZE);

  newname_bytes = smb2_latin1_to_utf16le(info_buf + FILERENAME_NAME_OFFSET, (int)sizeof(info_buf) - FILERENAME_NAME_OFFSET, newpath,
                                         (int)strlen(newpath));
  smb2_put_dword(info_buf + FILERENAME_NAME_LEN_OFFSET, (uint32_t)newname_bytes);

  return smb2_set_info(share, file_id, SMB2_0_INFO_FILE, FileRenameInformation, info_buf, FILERENAME_HDR_SIZE + newname_bytes);
}

err_t SMB2_Rename(SMB2_Share *share, const char *oldpath, const char *newpath) {
  SMB2_FILEID file_id;
  uint32_t attribs;
  err_t res;

  /*
   * Renaming needs DELETE access on the source handle.  Sharing read/write/delete keeps this open from conflicting with other opens;
   * one that does not itself share delete still blocks the rename.  A symbolic link at the end of the source path is opened as
   * itself, so the link is renamed rather than the object it points to.
   */
  res = SMB2_Create(share, oldpath, SMB2_DELETE, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN,
                    FILE_OPEN_REPARSE_POINT, &file_id, NULL, &attribs, NULL);

  if (res != OK) {
    return res;
  }

  /* As SMB1's rename does, treat a hidden or system object as absent unless hidden files are being shown. */
  if (!(LM_Vars.namemode & NM_HIDDEN) && (attribs & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM)) != 0u) {
    smb2_close_fileid(share, &file_id);
    return EFILENOTFOUND;
  }

  /* The rename target must be share-relative, so drop any leading backslash before sending. */
  if (newpath[0] == '\\') {
    newpath++;
  }

  /* First attempt at the destination as given; if the path crosses a symlink the server fails it and the loop below resolves the link. */
  res = smb2_send_rename(share, &file_id, newpath);

  /*
   * A destination whose path crosses a symlink fails with ESYMLINKFAILED; follow the reparse points by hand, up to the hop limit to
   * bound loops.
   */
  {
    int hops;
    char resolved[SMB2_NAME_LIMIT];
    const char *current = newpath;

    for (hops = 0; res == ESYMLINKFAILED && hops < SMB2_SYMLINK_MAX_HOPS; hops++) {
      char substitute[SMB2_NAME_LIMIT];
      char next[SMB2_NAME_LIMIT];
      int sub_chars;
      bool is_relative;
      size_t link_end_pos;
      err_t r;

      /* Ask the server for the symlink's substitute name via an FSCTL reparse query. */
      r = smb2_resolve_symlink_via_ioctl(share, current, substitute, sizeof substitute, &sub_chars, &is_relative, &link_end_pos);

      if (r != OK) {
        res = r;
        break;
      }

      /*
       * Splice the substitute in place of the symlink prefix to form the next candidate path, failing for an absolute target or one
       * leaving the share.  It is composed apart and then copied, because from the second hop on `current` is `resolved` itself.
       */
      r = smb2_compose_symlink_target(current, substitute, sub_chars, is_relative, link_end_pos, next, sizeof next);

      if (r != OK) {
        res = r;
        break;
      }

      memcpy(resolved, next, strlen(next) + 1u);

      /* Retry the rename at the resolved path; the loop continues from here if it too crosses a symlink. */
      res = smb2_send_rename(share, &file_id, resolved);
      current = resolved;
    }

    /* Hop budget spent without resolving; leave the symlink error to propagate. */
    if (res == ESYMLINKFAILED && hops >= SMB2_SYMLINK_MAX_HOPS) {
      debug("SMB2_Rename: hop budget exhausted resolving newpath \"%s\"\n", newpath);
    }
  }

  smb2_close_fileid(share, &file_id);

  /*
   * On success, give the new path to every open handle on the object or, for a directory, beneath it, so that diagnostics and the
   * lookup's open-file test see the names as they now are.  A stored path may or may not start with a separator, so the paths are
   * compared without one.
   */
  if (res == OK) {
    const char *old_rel = smb2_skip_seps(oldpath);
    size_t oldlen = strlen(old_rel);
    size_t newlen = strlen(newpath);
    int i;

    for (i = 0; i < SMB2_MAX_OPEN_FILES; i++) {
      char *open_path = smb2_files[i].dos_path;
      const char *open_rel = smb2_skip_seps(open_path);
      size_t open_len = strlen(open_rel);
      size_t j = 0u;

      /* Only the renamed object itself, or something inside it, carries the old path as a whole leading component run. */
      if (!smb2_files[i].in_use || smb2_files[i].share != share || oldlen == 0u || open_len < oldlen ||
          (open_rel[oldlen] != '\0' && open_rel[oldlen] != '\\')) {
        continue;
      }

      while (j < oldlen && tolower((unsigned char)open_rel[j]) == tolower((unsigned char)old_rel[j])) {
        j++;
      }

      if (j < oldlen) {
        continue;
      }

      /* Put the new path in front of whatever lay beneath the old one; if that will not fit, blank it rather than leave a truncated,
       * misleading name.
       */
      if (newlen + (open_len - oldlen) < sizeof(smb2_files[i].dos_path)) {
        memmove(open_path + newlen, open_rel + oldlen, open_len - oldlen + 1u);
        memcpy(open_path, newpath, newlen);
      } else {
        open_path[0] = '\0';
      }
    }
  }

  return res;
}

/*
 * Convert a Windows FILETIME to packed FAT (DOS) date and time words.
 *
 * The X2 directory-entry format carries SMB_INFO_STANDARD FAT date/time fields, so an SMB2 FILETIME must be re-encoded into them. A zero
 * FILETIME yields a zero date and time, the wire convention for "not set". The FAT date packs year-since-1980, month and day; the FAT time
 * packs hours, minutes and two-second ticks.
 *
 * Parameters:
 *   ft        Windows FILETIME (100ns intervals since 1601), or 0 for unset
 *   date_out  receives the packed FAT date word
 *   time_out  receives the packed FAT time word
 */
static void filetime_to_smbdatetime(uint64_t ft, uint16_t *date_out, uint16_t *time_out) {
  uint utime;
  uint days, secs;
  int y, m, d, h, mi, s;

  /* A zero FILETIME means unset; emit zero date and time. */
  if (ft == 0) {
    *date_out = 0;
    *time_out = 0;

    return;
  }

  /* Reduce to Unix seconds, then split into whole days and the H:M:S within the day. */
  utime = smb2_filetime_to_utime(ft);

  days = utime / 86400;
  secs = utime % 86400;

  h = (int)(secs / 3600);
  mi = (int)((secs % 3600) / 60);
  s = (int)(secs % 60);

  y = 1970;

  /* Walk forward year by year, subtracting each year's length (leap-aware) until the days fall inside a single year. */
  while (1) {
    int yd = (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) ? 366 : 365;

    if (days < (uint)yd) {
      break;
    }

    days -= (uint)yd;
    y++;
  }

  /* Cumulative day-of-year at each month's start, for a non-leap year. */
  {
    static const int mdays[] = {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};
    int leap = (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) ? 1 : 0;

    m = 12;

    /* Step the month down until the remaining days reach its start, adding the leap day from March onward. */
    while (m > 1 && days < (uint)(mdays[m - 1] + ((m > 2) ? leap : 0))) {
      m--;
    }

    /* Day-of-month is the days left past the month start, made 1-based. */
    d = (int)(days - (uint)mdays[m - 1] - (uint)((m > 2) ? leap : 0)) + 1;
  }

  /* Pack the FAT fields: date = (year-1980)<<9 | month<<5 | day, time = hour<<11 | min<<5 | seconds/2. */
  *date_out = (uint16_t)(((y - 1980) << 9) | (m << 5) | d);

  *time_out = (uint16_t)((h << 11) | (mi << 5) | (s >> 1));
}

/*
 * Synthesise an SMB1-style X2 directory entry (SMB_INFO_STANDARD) from SMB2 metadata.
 *
 * SMB2_ReadDirEntries hands each QUERY_DIRECTORY result to the same directory callbacks as SMB1 Trans2 FindFirst, and those read the
 * X2 layout (Dir_CallbackFn through Xlt_ExpandSearchEntryX2), so each result is re-encoded into that layout first.
 *
 * Parameters:
 *   out         buffer for the entry (at least X2_HEADER_SIZE + name_len + 1 bytes)
 *   write_time  last-write FILETIME
 *   size        file size, in bytes
 *   attr        SMB2 FILE_ATTRIBUTE_* mask
 *   name        entry filename (Latin-1)
 *   name_len    length of name, in bytes
 */
static void smb2_build_x2_entry(uint8_t *out, uint64_t write_time, uint64_t size, uint32_t attr, const char *name, int name_len) {
  /* Clear the fixed header, then write the last-write date and time as little-endian FAT words. */
  uint16_t sdate, stime;

  memset(out, 0, X2_HEADER_SIZE);

  filetime_to_smbdatetime(write_time, &sdate, &stime);

  out[X2_LAST_WRITE_DATE_OFFSET + 0] = (uint8_t)(sdate & 0xFF);
  out[X2_LAST_WRITE_DATE_OFFSET + 1] = (uint8_t)(sdate >> 8);
  out[X2_LAST_WRITE_TIME_OFFSET + 0] = (uint8_t)(stime & 0xFF);
  out[X2_LAST_WRITE_TIME_OFFSET + 1] = (uint8_t)(stime >> 8);

  /* The X2 size field is 32-bit; clamp a size above 4 GiB to 0xFFFFFFFF. */
  {
    uint32_t sz32 = (size > QWORD_OVERFLOW_32) ? UINT32_CLAMP : (uint32_t)size;
    out[X2_DATA_SIZE_OFFSET + 0] = (uint8_t)(sz32 & 0xFF);
    out[X2_DATA_SIZE_OFFSET + 1] = (uint8_t)((sz32 >> 8) & 0xFF);
    out[X2_DATA_SIZE_OFFSET + 2] = (uint8_t)((sz32 >> 16) & 0xFF);
    out[X2_DATA_SIZE_OFFSET + 3] = (uint8_t)((sz32 >> 24) & 0xFF);
  }

  /* Store DOS attributes and the name length, then the NUL-terminated filename. */
  out[X2_ATTRIBUTES_OFFSET] = (uint8_t)smb2_attribs_to_dos(attr);
  out[X2_FILENAME_LEN_OFFSET] = (uint8_t)name_len;

  memcpy(out + X2_FILENAME_OFFSET, name, (size_t)name_len);
  out[X2_FILENAME_OFFSET + name_len] = '\0';
}

/* Park an open directory FileId in the wire state's scratch words. */
static inline void smb2_qd_state_set_fileid(LMCacheWireState_t *state, SMB2_FILEID id) {
  /* Split each 64-bit half of the FileId into two little scratch words. */
  state->scratch[0] = (uint32_t)(id.Persistent & 0xFFFFFFFFu);
  state->scratch[1] = (uint32_t)(id.Persistent >> 32);
  state->scratch[2] = (uint32_t)(id.Volatile & 0xFFFFFFFFu);
  state->scratch[3] = (uint32_t)(id.Volatile >> 32);
}

/* Recover the open directory FileId parked in the wire state's scratch words. */
static inline SMB2_FILEID smb2_qd_state_get_fileid(const LMCacheWireState_t *state) {
  /* Reassemble each 64-bit half from its two scratch words. */
  SMB2_FILEID id;
  id.Persistent = (uint64_t)state->scratch[0] | ((uint64_t)state->scratch[1] << 32);
  id.Volatile = (uint64_t)state->scratch[2] | ((uint64_t)state->scratch[3] << 32);

  return id;
}

/*
 * Validate a freshly received QUERY_DIRECTORY output buffer and arm the iterator cursor on its first entry.
 *
 * The FileIdBothDirectoryInformation records form a singly-linked list chained by NextEntryOffset. Every offset and length is
 * bounds-checked before it is trusted so a malformed or hostile server reply cannot drive the iterator off the end of the buffer or into a
 * backward loop.
 *
 * Parameters:
 *   state      wire state whose opaque[1] cursor is set to the first entry (NULL for an empty chunk)
 *   chunk      start of the directory-information blob within the receive buffer
 *   chunk_len  length of that blob in bytes
 *
 * Returns: true iff every entry lies wholly within the buffer; false on any malformed link.
 */
static bool smb2_qd_install_chunk(LMCacheWireState_t *state, uint8_t *chunk, uint32_t chunk_len) {
  uint32_t pos = 0u;

  /* Walk the entry chain, bounds-checking each record before advancing to the next. */
  while (pos < chunk_len) {
    uint8_t *e = chunk + pos;
    uint32_t next_offset, name_len_bytes;

    /* Reject an entry whose fixed header would run past the end of the buffer. */
    if ((uint32_t)FILEBOTH_FILE_NAME_OFFSET > chunk_len - pos) {
      return false;
    }

    next_offset = smb2_get_dword(e + FILEBOTH_NEXT_ENTRY_OFFSET);
    name_len_bytes = smb2_get_dword(e + FILEBOTH_FILE_NAME_LEN_OFFSET);

    /* Reject a name length that would overrun the buffer. */
    if (name_len_bytes > chunk_len - pos - (uint32_t)FILEBOTH_FILE_NAME_OFFSET) {
      return false;
    }

    /* A zero NextEntryOffset marks the final entry. */
    if (next_offset == 0) {
      break;
    }

    /* A forward link must clear this entry's own bytes and leave room for at least the next entry's fixed header. */
    if (next_offset < (uint32_t)FILEBOTH_FILE_NAME_OFFSET + name_len_bytes ||
        next_offset > chunk_len - pos - (uint32_t)FILEBOTH_FILE_NAME_OFFSET) {
      return false;
    }

    pos += next_offset;
  }

  /* Arm the iterator at the first entry; an empty chunk leaves the cursor NULL. */
  state->opaque[1] = (chunk_len > 0u) ? (void *)chunk : NULL;

  return true;
}

/*
 * Issue one QUERY_DIRECTORY on the open directory, receiving into smb2_dirbuf, and arm the iterator on the reply's entries.
 *
 * The request asks for a whole work buffer of entries, or as much as the credits in hand and the server's transact limit allow.  The first
 * request of a scan closes any listing parked in smb2_dirbuf, because the scan takes the buffer over.  When the scan ends or fails, the
 * directory handle is closed and the state emptied.
 *
 * Parameters:
 *   share    connected share holding the directory
 *   state    scan state carrying the open directory's file id; armed on the reply's entries
 *   first    true for the first request of a scan, which restarts it on the server
 *   pattern  search pattern
 *
 * Returns: LMCACHE_WIRE_OK with entries to iterate, LMCACHE_WIRE_NO_MORE_ENTRIES at the end of the scan, or LMCACHE_WIRE_TRANSIENT_ERROR
 * with state->error set.
 */
static LMCacheWireResult_t smb2_qd_round_trip(SMB2_Share *share, LMCacheWireState_t *state, bool first, const char *pattern) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_dirbuf; // not the shared receive buffer: the entries must survive requests made while they are walked
  uint8_t *body;
  SMB2_Server *srv = share->server;
  SMB2_FILEID dir_id = smb2_qd_state_get_fileid(state);
  uint16_t pattern_len;
  uint16_t buf_offset;
  int req_len, resp_len;
  uint32_t status;
  uint32_t output_buf_len = (uint32_t)(SMB2_WORKBUF_SIZE - SMB2_HEADER_SIZE - SMB2_READ_RESP_MIN);
  uint16_t charge;
  uint16_t out_offset_w;
  uint32_t out_length;

  /* This scan is about to take over the directory buffer, so a listing parked in it has to be closed first. */
  if (first) {
    SMB2_EndListing();
  }

  /* Ask for a whole work buffer of entries, or as much of one as the credits in hand pay for. */
  charge = smb2_charge_and_scale(&output_buf_len, output_buf_len, srv->credits_available);

  /* A server refuses more listing data than its MaxTransactSize, so clamp last and charge only for what is asked. */
  if (srv->max_transact_size != 0u && output_buf_len > srv->max_transact_size) {
    output_buf_len = srv->max_transact_size;
    charge = (uint16_t)((output_buf_len + SMB2_CREDIT_UNIT - 1u) / SMB2_CREDIT_UNIT);
  }

  /* Build the request: FileIdBothDirectoryInformation, the search pattern, RESTART_SCANS only on the first call. */
  smb2_init_header(tx, SMB2_QUERY_DIRECTORY, srv);
  smb2_set_credit_charge(tx, srv, charge);
  smb2_set_tree_id(tx, share);

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_QUERY_DIR_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  smb2_put_word(body + SMB2_QUERY_DIR_REQ_STRUCT_SIZE_OFFSET, SMB2_QUERY_DIR_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  body[SMB2_QUERY_DIR_REQ_FILE_CLASS_OFFSET] = (uint8_t)FileIdBothDirectoryInformation;
  body[SMB2_QUERY_DIR_REQ_FLAGS_OFFSET] = first ? SMB2_RESTART_SCANS : 0;
  smb2_put_qword(body + SMB2_QUERY_DIR_REQ_FILEID_OFFSET, dir_id.Persistent);
  smb2_put_qword(body + SMB2_QUERY_DIR_REQ_FILEID_VOL_OFFSET, dir_id.Volatile);

  buf_offset = SMB2_HEADER_SIZE + SMB2_QUERY_DIR_REQ_SIZE;
  pattern_len = (uint16_t)smb2_latin1_to_utf16le(tx + buf_offset, (int)(SMB2_WORKBUF_SIZE - buf_offset), pattern, (int)strlen(pattern));
  smb2_put_word(body + SMB2_QUERY_DIR_REQ_NAME_POS_OFFSET, buf_offset);
  smb2_put_word(body + SMB2_QUERY_DIR_REQ_NAME_LEN_OFFSET, pattern_len);
  smb2_put_dword(body + SMB2_QUERY_DIR_REQ_OUTPUT_LEN_OFFSET, output_buf_len);

  req_len = (int)buf_offset + (int)pattern_len;
  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  /* Scan exhausted, which the server reports as "no such file" when the very first request matched nothing: release the handle. */
  if (status == STATUS_NO_MORE_FILES || status == STATUS_NO_SUCH_FILE) {
    smb2_close_listing(share, &dir_id);
    state->opaque[0] = NULL;
    state->opaque[1] = NULL;

    return LMCACHE_WIRE_NO_MORE_ENTRIES;
  }

  /* Any error status: abandon the handle. */
  if (NT_STATUS_IS_ERROR(status)) {
    smb2_close_fileid(share, &dir_id);
    state->opaque[0] = NULL;
    state->opaque[1] = NULL;
    state->error = smb2_status_to_err(status);

    return LMCACHE_WIRE_TRANSIENT_ERROR;
  }

  /* A runt response cannot hold a valid reply structure. */
  if (resp_len < SMB2_HEADER_SIZE + SMB2_QUERY_INFO_RESP_MIN) {
    smb2_close_fileid(share, &dir_id);
    state->opaque[0] = NULL;
    state->opaque[1] = NULL;
    state->error = EPROTOCOLERR;

    return LMCACHE_WIRE_TRANSIENT_ERROR;
  }

  body = rx + SMB2_HEADER_SIZE;

  /* A mismatched fixed StructureSize means the reply is malformed. */
  if (smb2_get_word(body + SMB2_QUERY_DIR_RESP_STRUCT_SIZE_OFFSET) != SMB2_QUERY_DIR_RESP_SIZE) {
    smb2_close_fileid(share, &dir_id);
    state->opaque[0] = NULL;
    state->opaque[1] = NULL;
    state->error = EPROTOCOLERR;

    return LMCACHE_WIRE_TRANSIENT_ERROR;
  }

  out_offset_w = smb2_get_word(body + SMB2_QUERY_DIR_RESP_OUTPUT_POS_OFFSET);
  out_length = smb2_get_dword(body + SMB2_QUERY_DIR_RESP_OUTPUT_LEN_OFFSET);

  /* The output blob must lie wholly within the bytes actually received.  A success carrying no entries would have the next
   * query asked at once, for ever, so it is refused too.
   */
  if (out_length == 0u || (uint32_t)out_offset_w > (uint32_t)resp_len || out_length > (uint32_t)resp_len - (uint32_t)out_offset_w) {
    smb2_close_fileid(share, &dir_id);
    state->opaque[0] = NULL;
    state->opaque[1] = NULL;
    state->error = EPROTOCOLERR;

    return LMCACHE_WIRE_TRANSIENT_ERROR;
  }

  /* Hand the chunk to the iterator, rejecting it if its internal links fail to validate. */
  if (!smb2_qd_install_chunk(state, rx + out_offset_w, out_length)) {
    smb2_close_fileid(share, &dir_id);
    state->opaque[0] = NULL;
    state->opaque[1] = NULL;
    state->error = EPROTOCOLERR;

    return LMCACHE_WIRE_TRANSIENT_ERROR;
  }

  return LMCACHE_WIRE_OK;
}

/*
 * Open a directory ready for a QUERY_DIRECTORY scan.
 *
 * Some non-Windows servers momentarily report a just-touched directory as missing, so a single NOT_FOUND retry guards against that before
 * a real absence is reported. Shared by the cache's wire callback and the cache-less enumerator so both get the same retry.
 *
 * Parameters:
 *   share         connected share
 *   dir_path      DOS path of the directory; an empty string denotes the share root
 *   share_access  FILE_SHARE_* modes other openers are to be allowed while the handle is held
 *   dir_id_out    receives the open directory's FileId on success
 *   is_file_out   optional; set true when the path names a file rather than a directory
 *
 * Returns: OK with the handle open, EPATHNOTFOUND for a file at the path, or the error from the final CREATE attempt.
 */
static err_t smb2_qd_open_dir(SMB2_Share *share, const char *dir_path, uint32_t share_access, SMB2_FILEID *dir_id_out, bool *is_file_out) {
  uint32_t attrs = 0u;
  err_t res;

  res = SMB2_Create(share, dir_path, FILE_READ_DATA | FILE_READ_ATTRIBUTES, 0, share_access, FILE_OPEN, 0u, dir_id_out, NULL, &attrs, NULL);

  /* Some non-Windows servers momentarily report a directory as missing; retry the open once. */
  if ((res == EFILENOTFOUND || res == EPATHNOTFOUND) && (share->server->flags & SMB2_SRV_NON_WINDOWS) != 0u) {
    err_t retry_res;

    /* The retry exists to ask the server again, so it must not be answered by a lookup that found the directory absent. */
    smb2_lookup.valid = false;
    retry_res = SMB2_Create(share, dir_path, FILE_READ_DATA | FILE_READ_ATTRIBUTES, 0, share_access, FILE_OPEN, 0u, dir_id_out, NULL,
                            &attrs, NULL);
    debug("SMB2: NOT_FOUND retry path=\"%s\" first=%d retry=%d\n", dir_path, (int)res, (int)retry_res);

    /* The retry's result stands, so a link lost in the meantime is reported as that rather than as "not found". */
    res = retry_res;
  }

  /* A file at the path opens as readily as a directory but cannot be listed, so it is reported as no directory, as a lookup reports it. */
  if (res == OK && dir_path[0] != '\0' && (attrs & FILE_ATTRIBUTE_DIRECTORY) == 0u) {
    debug("SMB2: listing refused, \"%s\" is a file\n", dir_path);
    smb2_close_fileid(share, dir_id_out);
    res = EPATHNOTFOUND;

    if (is_file_out != NULL) {
      *is_file_out = true;
    }
  }

  return res;
}

/*
 * Open a directory for enumeration and fetch its first batch of entries.
 *
 * On success the open handle is recorded in the wire state and the first QUERY_DIRECTORY is issued with the scan rewound.
 *
 * Parameters:
 *   ctx        the SMB2_Share, passed opaquely as the cache's wire handle
 *   dir_path   DOS path of the directory; an empty string denotes the share root
 *   state_out  wire state seeded here for the iterator and continuation calls
 *
 * Returns: LMCACHE_WIRE_OK, LMCACHE_WIRE_OBJECT_NOT_FOUND for a genuine absence, or LMCACHE_WIRE_TRANSIENT_ERROR (a file at the path
 * among them, with EPATHNOTFOUND as the state's error).
 */
static LMCacheWireResult_t smb2_qd_first(void *ctx, const char *dir_path, LMCacheWireState_t *state_out) {
  SMB2_Share *share = (SMB2_Share *)ctx;
  SMB2_FILEID dir_id;
  bool is_file = false;
  err_t res;

  if (share == NULL || share->server == NULL || dir_path == NULL || state_out == NULL) {
    return LMCACHE_WIRE_TRANSIENT_ERROR;
  }

  /* Nothing is open yet, so there is nothing for an abandoned scan to close. */
  state_out->opaque[0] = NULL;
  state_out->opaque[1] = NULL;

  res = smb2_qd_open_dir(share, dir_path, FILE_SHARE_READ | FILE_SHARE_WRITE, &dir_id, &is_file);

  /* Still missing after the retry: report a real absence to the cache.  A file at the path is not absent, so the cache must not be told
   * it is; its "not found" is passed on as an error instead.
   */
  if ((res == EFILENOTFOUND || res == EPATHNOTFOUND) && !is_file) {
    return LMCACHE_WIRE_OBJECT_NOT_FOUND;
  }

  if (res != OK) {
    state_out->error = res;
    return LMCACHE_WIRE_TRANSIENT_ERROR;
  }

  /* Stash the share and the open directory handle in the wire state for the iterator. */
  state_out->opaque[0] = (void *)share;
  state_out->opaque[1] = NULL;
  smb2_qd_state_set_fileid(state_out, dir_id);

  /* An empty path means the share root is being scanned; flag it so the listing looks for a .DS_Store. */
  share->root_enum_in_progress = dir_path[0] == '\0';

  return smb2_qd_round_trip(share, state_out, true, "*");
}

/*
 * Fetch the next batch of entries in an in-progress directory enumeration.
 *
 * Parameters:
 *   ctx    the SMB2_Share, passed opaquely as the cache's wire handle
 *   state  wire state carrying the open handle and iterator cursor
 *
 * Returns: the LMCACHE_WIRE_* result of the underlying round trip.
 */
static LMCacheWireResult_t smb2_qd_next(void *ctx, LMCacheWireState_t *state) {
  SMB2_Share *share = (SMB2_Share *)ctx;
  LMCacheWireResult_t res;

  if (share == NULL || share->server == NULL || state == NULL) {
    return LMCACHE_WIRE_TRANSIENT_ERROR;
  }

  /* Continue the scan without rewinding (first=false). */
  res = smb2_qd_round_trip(share, state, false, "*");

  /* End of scan or a fault closes the root-enumeration window. */
  if (res != LMCACHE_WIRE_OK) {
    share->root_enum_in_progress = false;
  }

  return res;
}

/* Report whether an entry is kept out of sight: hidden and system entries are, unless the user has asked to be shown such files. */
static inline bool smb2_entry_is_hidden(uint32_t attr) {
  return !(LM_Vars.namemode & NM_HIDDEN) && (attr & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM)) != 0u;
}

/*
 * Report whether a listed length needs re-verifying: one exactly equal to the space allocated can be reported for a file still being
 * written.
 */
static inline bool smb2_size_is_suspect(uint64_t size, uint64_t alloc_size, uint32_t attr) {
  return size == alloc_size && size > SMB2_SUSPECT_SIZE_FLOOR && (attr & FILE_ATTRIBUTE_DIRECTORY) == 0u;
}

/*
 * Step to the next real entry of the current QUERY_DIRECTORY chunk and decode its name and fixed fields.
 *
 * The '.' and '..' entries and any empty name are passed over, as is a name too long to hold, which is counted as unlisted. Hidden and
 * system entries are returned like any other, because callers differ in what they do with them. A .DS_Store met while the share root is
 * being scanned is taken as proof of a macOS server and switches on the quirks that needs.
 *
 * Parameters:
 *   share    share being scanned
 *   state    wire state whose opaque[1] cursor walks the chunk; left just past the entry returned
 *   raw      receives the entry's times, sizes, attributes and reparse tag
 *   namebuf  receives the leafname in Latin-1; SMB2_NAME_LIMIT bytes
 *
 * Returns: true with an entry, false once the chunk is exhausted.
 */
static bool smb2_qd_next_raw(SMB2_Share *share, LMCacheWireState_t *state, SMB2_RawDirEntry *raw, char *namebuf) {
  uint8_t *entry;

  while ((entry = (uint8_t *)state->opaque[1]) != NULL) {
    uint32_t next_offset = smb2_get_dword(entry + FILEBOTH_NEXT_ENTRY_OFFSET);
    uint64_t write_time = smb2_get_qword(entry + FILEBOTH_WRITE_TIME_OFFSET);
    uint64_t file_size = smb2_get_qword(entry + FILEBOTH_END_OF_FILE_OFFSET);
    uint64_t alloc_size = smb2_get_qword(entry + FILEBOTH_ALLOC_SIZE_OFFSET);
    uint32_t file_attr = smb2_get_dword(entry + FILEBOTH_FILE_ATTRIBUTES_OFFSET);
    uint32_t reparse_tag = smb2_get_dword(entry + FILEBOTH_EA_SIZE_OFFSET);
    uint32_t name_len_bytes = smb2_get_dword(entry + FILEBOTH_FILE_NAME_LEN_OFFSET);
    int name_chars = (int)(name_len_bytes / 2u);

    /* Advance the cursor before any 'continue' below, so an early-out entry cannot stall the walk. */
    state->opaque[1] = (next_offset == 0u) ? NULL : (void *)(entry + next_offset);

    /* Convert the UTF-16LE wire name to Latin-1, passing over a name too long for the buffer: no shortened form of it names the object. */
    if (smb2_utf16le_to_latin1(namebuf, SMB2_NAME_LIMIT, entry + FILEBOTH_FILE_NAME_OFFSET, name_chars * 2, SMB2_ESCAPE_RESERVED) < 0) {
      vdebug("QD_RAW dropped entry with a name too long to hold (%u bytes)\n", (unsigned)name_len_bytes);
      state->unlisted++;
      continue;
    }

    vdebug("QD_RAW name=\"%s\" attr=%08X file_size=%u write_time=%08X%08X\n", namebuf, (unsigned)file_attr, (unsigned)file_size,
           (uint32_t)(write_time >> 32), (uint32_t)write_time);

    /* Skip the synthetic current- and parent-directory entries (and any empty name). */
    if (namebuf[0] == '\0' || (namebuf[0] == '.' && (namebuf[1] == '\0' || (namebuf[1] == '.' && namebuf[2] == '\0')))) {
      vdebug("QD_RAW dropped synthetic entry \"%s\"\n", namebuf);
      continue;
    }

    /* A .DS_Store in the share root shows a macOS server; enable the RmDir check, the not-found retry and, on every mount of the server,
     * aggressive cache refresh.
     */
    if (share->root_enum_in_progress && share->server != NULL && (share->server->flags & SMB2_SRV_MACOS) == 0u &&
        stricmp(namebuf, ".DS_Store") == 0) {
      share->server->flags |= SMB2_SRV_NON_WINDOWS | SMB2_SRV_MACOS;
      SMB_SetAggressiveRefreshBySMB2(share->server);
      debug("SMB2: .DS_Store seen in share root -> server reclassified macOS, AGGRESSIVE_REFRESH + RmDir-verify applied\n");
      share->root_enum_in_progress = false;
    }

    raw->write_time = write_time;
    raw->size = file_size;
    raw->alloc_size = alloc_size;
    raw->attr = file_attr;
    raw->reparse_tag = reparse_tag;

    return true;
  }

  return false;
}

/*
 * Yield the next usable directory entry from the current QUERY_DIRECTORY chunk as a cache record.
 *
 * Takes each real entry in turn, dropping hidden and system entries (unless the name mode asks for them), resolving symbolic links to
 * their targets' metadata, and translating the DOS name, attributes and timestamp into RISC OS form.  Each entry dropped is counted in
 * the state.  A file whose listed length may lag the data being written to it is flagged, so the cache can recheck it soon.
 *
 * Parameters:
 *   ctx      the SMB2_Share, passed opaquely as the cache's wire handle
 *   state    wire state whose opaque[1] cursor walks the current chunk
 *   rec_out  filled with the produced record when the return value is true
 *
 * Returns: true and a filled rec_out when an entry is produced, false once the chunk is exhausted.
 */
static bool smb2_qd_iter(void *ctx, LMCacheWireState_t *state, LMCacheWireRecord_t *rec_out) {
  /* Latin-1 leaf name and its RISC OS-translated form; static and reused across calls, safe because RISC OS is single-threaded. */
  static char namebuf[SMB2_NAME_LIMIT];

  static char ro_namebuf[SMB2_NAME_LIMIT];
  SMB2_Share *share = (SMB2_Share *)ctx;
  SMB2_RawDirEntry raw;
  hSHARE hS;

  if (share == NULL || state == NULL || rec_out == NULL) {
    return false;
  }

  /* Resolve the FileSwitch share handle used to translate the entries' times. */
  hS = SMB_GetShareFromDrv(share->drvletter);

  while (smb2_qd_next_raw(share, state, &raw, namebuf)) {
    uint64_t write_time = raw.write_time;
    uint64_t file_size = raw.size;
    uint64_t alloc_size = raw.alloc_size;
    uint32_t file_attr = raw.attr;
    DOS_ATTRIBS da;
    RISCOS_ATTRIBS ra;
    int leaf_len;
    bool size_suspect = smb2_size_is_suspect(file_size, alloc_size, file_attr);

    /* Honour the hidden-file name mode: drop hidden and system entries unless the user wants them shown. */
    if (smb2_entry_is_hidden(file_attr)) {
      vdebug("QD_RAW dropped hidden/system entry \"%s\" (attr=%08X)\n", namebuf, (unsigned)file_attr);
      state->unlisted++;
      continue;
    }

    rec_out->is_resolved_symlink = false;
    rec_out->is_inert_symlink = false;

    /* Symlink: build the entry's full DOS path so its target can be resolved; any other reparse point (a junction) lists as it is. */
    if ((file_attr & FILE_ATTRIBUTE_REPARSE_POINT) != 0u && raw.reparse_tag == IO_REPARSE_TAG_SYMLINK) {
      char link_full[SMB2_NAME_LIMIT];
      SMB2_SymlinkResolution resolution;
      const char *parent = (state->dir_path != NULL) ? state->dir_path : "";
      size_t parent_len = strlen(parent);
      size_t leaf_chars = strlen(namebuf);
      size_t total = parent_len + (parent_len > 0u ? 1u : 0u) + leaf_chars + 1u;

      /* Skip a symlink whose full path will not fit the scratch buffer. */
      if (total > sizeof link_full) {
        vdebug("QD_RAW symlink path overflow parent_len=%u leaf_len=%u \"%s\"\n", (unsigned)parent_len, (unsigned)leaf_chars, namebuf);
        state->unlisted++;
        continue;
      }

      /* Join parent and leaf with a DOS separator (no separator at the share root). */
      if (parent_len > 0u) {
        memcpy(link_full, parent, parent_len);
        link_full[parent_len] = '\\';
        memcpy(link_full + parent_len + 1u, namebuf, leaf_chars + 1u);
      } else {
        memcpy(link_full, namebuf, leaf_chars + 1u);
      }

      /* Resolve the link: adopt the target's metadata, or present an inert entry when resolution fails. */
      if (smb2_resolve_symlink_target(share, link_full, &resolution) == OK) {
        file_attr = resolution.file_attr;
        file_size = resolution.size;
        write_time = resolution.write_time;
        size_suspect = false;
        rec_out->is_resolved_symlink = true;
      } else {
        file_attr = 0u;
        file_size = 0u;
        write_time = 0u;
        size_suspect = false;
        rec_out->is_inert_symlink = true;
        debug("QD_RAW symlink resolve FAILED for \"%s\" - presenting inert\n", link_full);
      }

      /* The server died while the link was followed, taking the directory handle with it: end the scan as a lost link. */
      if (share->server == NULL) {
        state->opaque[1] = NULL;
        state->error = ELINKFAILED;
        debug("QD_RAW server lost while following symlink \"%s\"\n", link_full);
        return false;
      }
    }

    leaf_len = (int)strlen(namebuf);

    /* Translate DOS metadata to RISC OS attributes; drop the entry if its name cannot be translated. */
    if (Xlt_FillAttribsFromMeta(namebuf, smb2_filetime_to_utime(write_time), (uint)file_size, smb2_attribs_to_dos(file_attr), ro_namebuf,
                                &da, &ra, hS) != OK) {
      vdebug("QD_RAW dropped untranslatable entry \"%s\" (Xlt_FillAttribsFromMeta refused)\n", namebuf);
      state->unlisted++;
      continue;
    }

    /* Fill in the record: directories report a nominal 4 KiB length, files their real size. */
    rec_out->name = namebuf;
    rec_out->name_len = (uint16_t)leaf_len;

    /* An if/else rather than a ternary: Norcroft miscompiles a ternary stored into a uint64_t field. */
    if ((file_attr & FILE_ATTRIBUTE_DIRECTORY) != 0u) {
      rec_out->obj_type = (uint8_t)LMCACHE_OBJECT_DIRECTORY;
      rec_out->length = 4096u;
    } else {
      rec_out->obj_type = (uint8_t)LMCACHE_OBJECT_FILE;
      rec_out->length = file_size;
    }

    rec_out->size_suspect = size_suspect;
    rec_out->load_addr = (uint32_t)ra.loadaddr;
    rec_out->exec_addr = (uint32_t)ra.execaddr;
    rec_out->attrs = (uint32_t)ra.flags;

    vdebug("QD_ITER name=\"%s\" attr=%08X file_size=%u rec.length=%u rec.obj_type=%u\n", namebuf, (unsigned)file_attr, (unsigned)file_size,
           (unsigned)rec_out->length, (unsigned)rec_out->obj_type);

    return true;
  }

  return false;
}

/*
 * Close the directory handle of an abandoned parked listing, deferring the close if a wire exchange is in flight.
 *
 * Closing while smb2_sendrecv_active is set would re-enter the transport, so such a close is queued for the next background pass
 * (SMB2_PollNotifications) to send.
 *
 * Parameters:
 *   share  share the handle belongs to
 *   fid    the file identifier to close
 */
static void smb2_release_held_fid(SMB2_Share *share, SMB2_FILEID fid) {
  if (share == NULL || share->server == NULL) {
    return;
  }

  /* A close mid-exchange would re-enter the transport; queue it to run later instead. */
  if (smb2_sendrecv_active) {
    smb2_enqueue_pending_close(share, fid);
    return;
  }

  smb2_close_fileid(share, &fid);
}

/*
 * Abandon a directory scan, closing its handle if the scan still holds it open.
 *
 * Called when an enumeration stops before the end of the listing; closing the FILEID stops the server-side handle from leaking.  The
 * scan's own round trips mark the handle closed in the state once they close it, so a scan that already ran to the end or failed is left
 * alone.
 *
 * Parameters:
 *   ctx    the SMB2_Share, passed opaquely as the cache's wire handle
 *   state  wire state of the scan being abandoned
 */
static void smb2_discard_state(void *ctx, LMCacheWireState_t *state) {
  SMB2_Share *share = (SMB2_Share *)ctx;
  SMB2_FILEID fid;

  if (state == NULL || state->opaque[0] == NULL) {
    return;
  }

  fid = smb2_qd_state_get_fileid(state);

  if (share != NULL && share->server != NULL) {
    smb2_close_fileid(share, &fid);
  }

  debug("SMB2: directory scan abandoned\n");
  state->opaque[0] = NULL;
  state->opaque[1] = NULL;
}

void SMB2_InstallCacheWire(LMCache_t *cache, SMB2_Share *share) {
  if (cache == NULL) {
    return;
  }

  /* Point the cache's wire vtable at the SMB2 implementations, with the share as the context the callbacks reach the connection through. */
  cache->wire.first = smb2_qd_first;
  cache->wire.next = smb2_qd_next;
  cache->wire.iter = smb2_qd_iter;
  cache->wire.discard_state = smb2_discard_state;
  cache->wire.ctx = share;
}

/*
 * Prepare a wire state for scanning a directory that has just been opened.
 *
 * Parameters:
 *   state     wire state to fill in
 *   share     share the directory is on
 *   dir_id    the open directory handle
 *   dir_path  DOS path of the directory; borrowed, so it must outlive the scan
 */
static void smb2_qd_seed_state(LMCacheWireState_t *state, SMB2_Share *share, SMB2_FILEID dir_id, const char *dir_path) {
  state->opaque[0] = (void *)share;
  state->opaque[1] = NULL;
  smb2_qd_state_set_fileid(state, dir_id);
  state->dir_path = dir_path;
  state->error = 0;
  state->unlisted = 0u;
}

/* ---- Lookup hand-off ---- */

/* Test whether this client holds the object open; a server may not show writes through an open handle in the directory listing yet. */
static bool smb2_path_is_open(const SMB2_Share *share, const char *path) {
  int i;

  for (i = 0; i < SMB2_MAX_OPEN_FILES; i++) {
    if (smb2_files[i].in_use && smb2_files[i].share == share && stricmp(smb2_skip_seps(smb2_files[i].dos_path), path) == 0) {
      return true;
    }
  }

  return false;
}

/*
 * Test whether a leafname can only ever denote the directory entry spelt exactly that way.
 *
 * A server resolves some names by other means: an 8.3 alias ("~"), a named stream (":"), a trailing dot or space that it strips, or its
 * own case folding of characters outside ASCII.  It also rejects names holding a reserved character with a different error.  For any of
 * these, finding no such entry in a listing does not say what opening the name would do, so the question has to go to the server.
 *
 * Parameters:
 *   leaf  DOS-form leafname
 *
 * Returns: true if the absence of a matching directory entry settles that the name does not exist.
 */
static bool smb2_leaf_is_plain(const char *leaf) {
  size_t len = strlen(leaf);
  size_t i;

  if (len == 0u || leaf[len - 1u] == '.' || leaf[len - 1u] == ' ') {
    return false;
  }

  for (i = 0u; i < len; i++) {
    if ((leaf[i] & 0x80) != 0) {
      return false;
    }
  }

  return strpbrk(leaf, "~:?\"|<>*") == NULL;
}

/*
 * Record what a directory lookup found, for the request that follows it.
 *
 * Must be called after the lookup's last exchange with the server, since any exchange discards the record. A match is always recorded,
 * though its metadata is only marked usable when the listing can be relied on for it: not for a reparse point (for a symbolic link the
 * listing describes the link, an open describes its target) and not for a file this client has open. An absence is recorded only where it
 * is conclusive.
 *
 * Parameters:
 *   share     share the lookup was on
 *   dir_path  DOS path of the directory searched, no leading separator
 *   leaf      the leafname found, or the one sought when nothing matched
 *   scan      the scan's findings
 *   present   true if a match was found
 */
static void smb2_lookup_note(SMB2_Share *share, const char *dir_path, const char *leaf, const SMB2_LeafScan *scan, bool present) {
  size_t dir_len = strlen(dir_path);
  size_t leaf_len = strlen(leaf);

  /* An absence proves nothing when the name is hidden from view or may be resolved some other way. */
  if (!present && (scan->hidden_match || !smb2_leaf_is_plain(leaf))) {
    return;
  }

  /* A path too long for the record cannot be remembered, so no answer is kept. */
  if (dir_len + 1u + leaf_len + 1u > sizeof smb2_lookup.path) {
    return;
  }

  /* Join directory and leaf the way a caller will later quote the path (no separator at the share root). */
  if (dir_len > 0u) {
    memcpy(smb2_lookup.path, dir_path, dir_len);
    smb2_lookup.path[dir_len] = '\\';
    memcpy(smb2_lookup.path + dir_len + 1u, leaf, leaf_len + 1u);
  } else {
    memcpy(smb2_lookup.path, leaf, leaf_len + 1u);
  }

  smb2_lookup.share = share;
  smb2_lookup.present = present;
  smb2_lookup.trusted_meta = false;

  /* A present entry also records the listed details, trusted only for a name that is not a reparse point and is not open here. */
  if (present) {
    uint32_t attr = scan->raw.attr;

    smb2_lookup.write_time = scan->raw.write_time;
    smb2_lookup.size = scan->raw.size;
    smb2_lookup.attr = attr;
    smb2_lookup.trusted_meta = (attr & FILE_ATTRIBUTE_REPARSE_POINT) == 0u && !smb2_path_is_open(share, smb2_lookup.path);
  }

  smb2_lookup.valid = true;
}

void SMB2_ForgetLookup(void) {
  smb2_lookup.valid = false;
  smb2_length_not_needed = false;
}

void SMB2_LengthNotNeeded(void) {
  smb2_length_not_needed = true;
}

/*
 * Scan one directory for an entry whose name the caller's comparison accepts.
 *
 * Parameters:
 *   share       connected share
 *   dir_path    DOS path of the directory, no leading separator
 *   sought      leafname being looked for, handed to `equivalent` alongside each candidate
 *   pattern     search pattern for the server to filter by
 *   equivalent  the caller's rule for whether a server leafname answers to the sought one
 *   scan        receives the matching entry, and whether a hidden entry of that name was passed over
 *
 * Returns: OK with scan filled in, EFILENOTFOUND when the directory was read to its end without a match, EPATHNOTFOUND if the directory
 * itself does not exist, any other CREATE error if it could not be opened, or ELINKFAILED if the scan broke part-way.
 */
static err_t smb2_find_leaf_scan(SMB2_Share *share, const char *dir_path, const char *sought, const char *pattern,
                                 SMB2_LeafMatch_t equivalent, SMB2_LeafScan *scan) {
  LMCacheWireState_t state;
  LMCacheWireResult_t wire_rc;
  SMB2_FILEID dir_id;
  err_t res;

  scan->hidden_match = false;

  res = SMB2_Create(share, dir_path, FILE_READ_DATA | FILE_READ_ATTRIBUTES, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN,
                    FILE_DIRECTORY_FILE, &dir_id, NULL, NULL, NULL);

  /* A missing directory must not read as "searched, and the leaf is not there": callers act on that, and nothing was searched. */
  if (res == EFILENOTFOUND) {
    return EPATHNOTFOUND;
  }

  if (res != OK) {
    return res;
  }

  smb2_qd_seed_state(&state, share, dir_id, dir_path);

  /* One QUERY_DIRECTORY round trip per pass; the round trip closes the directory handle itself when the scan ends or fails. */
  for (wire_rc = smb2_qd_round_trip(share, &state, true, pattern); wire_rc == LMCACHE_WIRE_OK;
       wire_rc = smb2_qd_round_trip(share, &state, false, pattern)) {
    while (smb2_qd_next_raw(share, &state, &scan->raw, scan->name)) {
      if (!equivalent(scan->name, sought)) {
        continue;
      }

      /* An entry hidden from listings is never offered as a match, but it is noted: the name is taken all the same. */
      if (smb2_entry_is_hidden(scan->raw.attr)) {
        scan->hidden_match = true;
        continue;
      }

      smb2_close_fileid(share, &dir_id);

      return OK;
    }
  }

  return (wire_rc == LMCACHE_WIRE_NO_MORE_ENTRIES) ? EFILENOTFOUND : ELINKFAILED;
}

err_t SMB2_FindLeaf(SMB2_Share *share, const char *dir_path, const char *sought, const char *pattern, SMB2_LeafMatch_t equivalent,
                    char *leaf_out) {
  static SMB2_LeafScan scan; // static to spare the stack; safe because lookups never nest
  SMB2_Server *srv;
  bool filtered;
  err_t res;

  /* Every argument is needed, so a missing one is the caller's mistake and not an absent name. */
  if (share == NULL || share->server == NULL || dir_path == NULL || sought == NULL || pattern == NULL || equivalent == NULL) {
    return EBADPARAM;
  }

  srv = share->server;
  dir_path = smb2_skip_seps(dir_path);

  /* A server once caught mishandling a search pattern is always asked for the whole directory. */
  filtered = strcmp(pattern, "*") != 0 && (srv->flags & SMB2_SRV_PATTERN_BAD) == 0;
  res = smb2_find_leaf_scan(share, dir_path, sought, filtered ? pattern : "*", equivalent, &scan);

  /*
   * A filtered search that finds its entry shows the server applies the pattern usefully. Until that has been seen once, a miss is not
   * taken on trust: the whole directory is read to confirm it, and a server that then turns out to have had the entry is never sent a
   * pattern again.
   */
  if (filtered && res == OK) {
    srv->flags |= SMB2_SRV_PATTERN_OK;
  } else if (filtered && res == EFILENOTFOUND && (srv->flags & SMB2_SRV_PATTERN_OK) == 0) {
    res = smb2_find_leaf_scan(share, dir_path, sought, "*", equivalent, &scan);

    if (res == OK) {
      srv->flags |= SMB2_SRV_PATTERN_BAD;
      debug("SMB2: server missed \"%s\" with search pattern \"%s\" but lists it - patterns disabled for this connection\n", scan.name,
            pattern);
    }
  }

  /* Note the answer, found or absent, for the request that follows this lookup. */
  if (res == OK) {
    strcpy(leaf_out, scan.name);
    smb2_lookup_note(share, dir_path, scan.name, &scan, true);
  } else if (res == EFILENOTFOUND) {
    smb2_lookup_note(share, dir_path, sought, &scan, false);
  }

  vdebug("SMB2: find leaf \"%s\" in \"%s\" pattern=\"%s\" res=%d\n", sought, dir_path, filtered ? pattern : "*", (int)res);

  return res;
}

/* ---- Directory listing for a mount with no cache ---- */

/*
 * Pause the listing where it stands, or close it if it cannot be resumed.
 *
 * A listing started without a tag has no name a later call could ask for it by, so there is nothing to be gained from keeping its
 * directory handle open.
 */
static void smb2_listing_pause(void) {
  SMB2_FILEID dir_id;

  smb2_listing.share->root_enum_in_progress = false;

  if (smb2_listing.tag[0] != '\0') {
    smb2_listing.parked = true;
    smb2_listing.parked_at = LM_Tick();
    return;
  }

  dir_id = smb2_qd_state_get_fileid(&smb2_listing.state);
  smb2_close_fileid(smb2_listing.share, &dir_id);
}

/*
 * Hand entries of the open listing to a visitor until it declines one, the directory ends or the scan fails.
 *
 * An entry the visitor declines has not been delivered, so the scan position is put back to it before the listing is paused; the next
 * call then starts with that same entry.
 *
 * Parameters:
 *   wire_rc      result of the round trip that fetched the entries now waiting; LMCACHE_WIRE_OK when resuming a parked listing
 *   start_index  index of the first entry the caller wants; earlier entries are stepped over without being shown to the visitor
 *   visitor      called once per entry from start_index on; returning false declines the entry and pauses the listing
 *   user         opaque pointer passed through to the visitor
 *
 * Returns: OK when the listing completed or was paused; if the scan failed part-way, the error that stopped it, or ELINKFAILED when none
 * was recorded.
 */
static err_t smb2_listing_deliver(LMCacheWireResult_t wire_rc, uint32_t start_index, Cache_EnumVisitor_t visitor, void *user) {
  SMB2_Share *share = smb2_listing.share;
  LMCacheWireState_t *state = &smb2_listing.state;
  LMCacheWireRecord_t rec;
  LMCacheNode_t child;
  char leaf[SMB2_NAME_LIMIT];

  /* An empty path means the share root is being scanned; flag it so the server-quirk detection runs. */
  share->root_enum_in_progress = smb2_listing.dir_path[0] == '\0';

  /* The node handed to the visitor is a throwaway carrying one entry's name and metadata; it belongs to no cache. */
  child.parent = NULL;
  child.mount = NULL;
  child.flags = 0u;
  child.name = leaf;

  /* One QUERY_DIRECTORY round trip per pass; every failure path inside the round trip closes the directory handle itself. */
  for (; wire_rc == LMCACHE_WIRE_OK; wire_rc = smb2_qd_next(share, state)) {
    for (;;) {
      void *undelivered = state->opaque[1]; // where the scan must restart if the visitor turns the next entry down

      if (!smb2_qd_iter(share, state, &rec)) {
        break;
      }

      /* Skip an entry whose name is empty or will not fit the scratch buffer. */
      if (rec.name == NULL || rec.name_len == 0u || rec.name_len >= sizeof leaf) {
        continue;
      }

      /* Entries before the caller's starting point went out on an earlier call. */
      if (smb2_listing.next_index < start_index) {
        smb2_listing.next_index++;
        continue;
      }

      /* Copy the name out of the wire layer's scratch so the visitor sees a stable, writable string. */
      memcpy(leaf, rec.name, (size_t)rec.name_len + 1u);
      child.name_len = rec.name_len;
      child.obj_type = rec.obj_type;
      child.load_addr = rec.load_addr;
      child.exec_addr = rec.exec_addr;
      child.length = rec.length;
      child.attrs = rec.attrs;

      /* The visitor has halted delivery for now: stop here rather than fetch entries it will not take. */
      if (!visitor(&child, user)) {
        state->opaque[1] = undelivered;
        smb2_listing_pause();
        debug("SMB2: direct enumerate \"%s\" paused at entry %u\n", smb2_listing.dir_path, (unsigned)smb2_listing.next_index);
        return OK;
      }

      smb2_listing.next_index++;
    }
  }

  share->root_enum_in_progress = false;

  /* Anything but a clean end of listing means the scan broke part-way: report why, or the link when nothing recorded a reason. */
  if (wire_rc != LMCACHE_WIRE_NO_MORE_ENTRIES) {
    debug("SMB2: direct enumerate \"%s\" failed mid-scan at entry %u\n", smb2_listing.dir_path, (unsigned)smb2_listing.next_index);
    return (state->error != OK) ? (err_t)state->error : ELINKFAILED;
  }

  debug("SMB2: direct enumerate \"%s\" complete, %u entries\n", smb2_listing.dir_path, (unsigned)smb2_listing.next_index);
  return OK;
}

err_t SMB2_EnumerateDirectory(SMB2_Share *share, const char *dir_path, const SMB2_ListingStart *from, Cache_EnumVisitor_t visitor,
                              void *user) {
  SMB2_FILEID dir_id;
  size_t path_len;
  err_t res;

  if (share == NULL || share->server == NULL || dir_path == NULL || from == NULL || visitor == NULL) {
    return EBADPARAM;
  }

  /* SMB2 names are share-relative, so accept a path with or without its leading separator. */
  dir_path = smb2_skip_seps(dir_path);
  path_len = strlen(dir_path);

  if (path_len >= sizeof smb2_listing.dir_path) {
    return EBADPARAM;
  }

  /* Only one listing is ever open: whatever was parked is finished with now. */
  SMB2_EndListing();

  /* The handle may be left open between the caller's reads, so it must not stand in the way of the directory being renamed or deleted. */
  res = smb2_qd_open_dir(share, dir_path, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, &dir_id, NULL);

  if (res != OK) {
    debug("SMB2: direct enumerate \"%s\" open failed err=%d\n", dir_path, (int)res);
    return res;
  }

  /* Set the listing up in the one slot it can later be parked in. */
  smb2_listing.share = share;
  smb2_listing.next_index = 0u;
  memcpy(smb2_listing.dir_path, dir_path, path_len + 1u);
  smb2_qd_seed_state(&smb2_listing.state, share, dir_id, smb2_listing.dir_path);

  /* A tag too long to remember leaves the listing unresumable, which costs speed but nothing else. */
  smb2_listing.tag[0] = '\0';

  if (strlen(from->tag) < sizeof smb2_listing.tag) {
    strcpy(smb2_listing.tag, from->tag);
  }

  return smb2_listing_deliver(smb2_qd_round_trip(share, &smb2_listing.state, true, "*"), from->index, visitor, user);
}

bool SMB2_ResumeListing(const SMB2_ListingStart *from, Cache_EnumVisitor_t visitor, void *user, err_t *err_out) {
  if (!smb2_listing.parked || from == NULL || visitor == NULL) {
    return false;
  }

  if (smb2_listing.next_index != from->index || strcmp(smb2_listing.tag, from->tag) != 0) {
    return false;
  }

  /* The listing is live again from here: if the scan now fails, nothing must be left looking resumable. */
  smb2_listing.parked = false;
  debug("SMB2: direct enumerate \"%s\" resumed at entry %u\n", smb2_listing.dir_path, (unsigned)smb2_listing.next_index);
  *err_out = smb2_listing_deliver(LMCACHE_WIRE_OK, from->index, visitor, user);

  return true;
}

void SMB2_EndListing(void) {
  SMB2_FILEID dir_id;

  if (!smb2_listing.parked) {
    return;
  }

  /* Clear the flag before the close goes out, so nothing on the way can mistake the listing for still being there. */
  smb2_listing.parked = false;
  dir_id = smb2_qd_state_get_fileid(&smb2_listing.state);
  debug("SMB2: direct enumerate \"%s\" abandoned at entry %u\n", smb2_listing.dir_path, (unsigned)smb2_listing.next_index);
  smb2_release_held_fid(smb2_listing.share, dir_id);
}

err_t SMB2_ReadDirEntries(SMB2_Share *share, const char *path, int max_count, ENUM_DIR_FN dirfn, void *private, int skip,
                          int *next_offset_out) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  SMB2_FILEID dir_id;
  SMB2_Server *srv;
  int resp_len;
  int count = 0;
  bool first = true;
  err_t res;
  uint32_t dir_pos = 0u;
  bool max_reached = false;

  if (share == NULL || share->server == NULL) {
    return EBADPARAM;
  }

  /* Open the directory itself for reading so its contents can be enumerated. */
  srv = share->server;

  res = SMB2_Create(share, path, FILE_READ_DATA | FILE_READ_ATTRIBUTES, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN,
                    FILE_DIRECTORY_FILE, &dir_id, NULL, NULL, NULL);

  if (res != OK) {
    return res;
  }

  /* Each pass issues one QUERY_DIRECTORY; size the output to the work buffer and charge enough credits to cover it. */
  while (1) {
    uint8_t pattern_utf16[4] = {'*', 0, 0, 0};
    uint16_t pattern_len;
    uint16_t buf_offset;
    uint8_t *body;
    int req_len;
    uint32_t status;

    uint32_t output_buf_len = (uint32_t)(SMB2_WORKBUF_SIZE - SMB2_HEADER_SIZE - SMB2_READ_RESP_MIN);
    uint16_t charge;

    /* Ask for a whole work buffer of entries, or as much of one as the credits in hand pay for. */
    charge = smb2_charge_and_scale(&output_buf_len, output_buf_len, srv->credits_available);

    /* A server refuses more listing data than its MaxTransactSize, so clamp last and charge only for what is asked. */
    if (srv->max_transact_size != 0u && output_buf_len > srv->max_transact_size) {
      output_buf_len = srv->max_transact_size;
      charge = (uint16_t)((output_buf_len + SMB2_CREDIT_UNIT - 1u) / SMB2_CREDIT_UNIT);
    }

    /*
     * Build and send the QUERY_DIRECTORY: wildcard '*', FileIdBothDirectoryInformation class, restarting the scan on the first pass
     * only.
     */
    smb2_init_header(tx, SMB2_QUERY_DIRECTORY, srv);
    smb2_set_credit_charge(tx, srv, charge);
    smb2_set_tree_id(tx, share);

    body = tx + SMB2_HEADER_SIZE;
    memset(body, 0, SMB2_QUERY_DIR_REQ_SIZE + SMB2_VARIABLE_TRAILER);
    smb2_put_word(body + SMB2_QUERY_DIR_REQ_STRUCT_SIZE_OFFSET, SMB2_QUERY_DIR_REQ_SIZE + SMB2_VARIABLE_TRAILER);
    body[SMB2_QUERY_DIR_REQ_FILE_CLASS_OFFSET] = (uint8_t)FileIdBothDirectoryInformation;
    body[SMB2_QUERY_DIR_REQ_FLAGS_OFFSET] = first ? SMB2_RESTART_SCANS : 0;
    smb2_put_qword(body + SMB2_QUERY_DIR_REQ_FILEID_OFFSET, dir_id.Persistent);
    smb2_put_qword(body + SMB2_QUERY_DIR_REQ_FILEID_VOL_OFFSET, dir_id.Volatile);

    buf_offset = SMB2_HEADER_SIZE + SMB2_QUERY_DIR_REQ_SIZE;
    pattern_len = 2;
    memcpy(tx + buf_offset, pattern_utf16, pattern_len);
    smb2_put_word(body + SMB2_QUERY_DIR_REQ_NAME_POS_OFFSET, buf_offset);
    smb2_put_word(body + SMB2_QUERY_DIR_REQ_NAME_LEN_OFFSET, pattern_len);

    smb2_put_dword(body + SMB2_QUERY_DIR_REQ_OUTPUT_LEN_OFFSET, output_buf_len);

    req_len = (int)buf_offset + (int)pattern_len;
    first = false;

    status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

    /* The server signals the end of the listing with STATUS_NO_MORE_FILES. */
    if (status == STATUS_NO_MORE_FILES) {
      break;
    }

    if (NT_STATUS_IS_ERROR(status)) {
      smb2_close_fileid(share, &dir_id);
      return smb2_status_to_err(status);
    }

    /* Reject a response too short to hold the fixed part of the QUERY_DIRECTORY reply. */
    if (resp_len < SMB2_HEADER_SIZE + SMB2_QUERY_INFO_RESP_MIN) {
      smb2_close_fileid(share, &dir_id);
      return EPROTOCOLERR;
    }

    body = rx + SMB2_HEADER_SIZE;

    /* The fixed StructureSize must match exactly, per the SMB2 spec, or the reply is malformed. */
    if (smb2_get_word(body + SMB2_QUERY_DIR_RESP_STRUCT_SIZE_OFFSET) != SMB2_QUERY_DIR_RESP_SIZE) {
      smb2_close_fileid(share, &dir_id);
      return EPROTOCOLERR;
    }

    /* Locate the packed entry buffer the reply points to. */
    {
      uint16_t out_offset = smb2_get_word(body + SMB2_QUERY_DIR_RESP_OUTPUT_POS_OFFSET);
      uint32_t out_length = smb2_get_dword(body + SMB2_QUERY_DIR_RESP_OUTPUT_LEN_OFFSET);
      uint8_t *entries = rx + out_offset;
      uint32_t pos = 0u;

      /* Ensure the advertised entry buffer lies wholly within the received data before walking it. */
      if ((uint32_t)out_offset > (uint32_t)resp_len || out_length > (uint32_t)resp_len - (uint32_t)out_offset) {
        smb2_close_fileid(share, &dir_id);
        return EPROTOCOLERR;
      }

      /* A success carrying no entries would have the next query asked at once, for ever, so give up on it. */
      if (out_length == 0u) {
        smb2_close_fileid(share, &dir_id);
        return EPROTOCOLERR;
      }

      /* Walk the packed, self-linked directory entries; NextEntryOffset chains one to the next. */
      while (pos < out_length) {
        uint8_t *e = entries + pos;
        uint32_t next_offset;
        uint64_t write_time;
        uint64_t file_size;
        uint32_t file_attr;
        uint32_t name_len_bytes;
        int name_chars;
        char namebuf[SMB2_NAME_LIMIT];
        uint8_t x2_entry[SMB2_NAME_LIMIT + 24];
        bool taken = false;

        /* Make sure the entry's fixed part fits before reading any of its fields. */
        if ((uint32_t)FILEBOTH_FILE_NAME_OFFSET > out_length - pos) {
          smb2_close_fileid(share, &dir_id);
          return EPROTOCOLERR;
        }

        /* Pull out the fields of interest from the entry's fixed part. */
        next_offset = smb2_get_dword(e + FILEBOTH_NEXT_ENTRY_OFFSET);
        write_time = smb2_get_qword(e + FILEBOTH_WRITE_TIME_OFFSET);
        file_size = smb2_get_qword(e + FILEBOTH_END_OF_FILE_OFFSET);
        file_attr = smb2_get_dword(e + FILEBOTH_FILE_ATTRIBUTES_OFFSET);
        name_len_bytes = smb2_get_dword(e + FILEBOTH_FILE_NAME_LEN_OFFSET);

        /* Guard against a name length that would run past the entry buffer. */
        if (name_len_bytes > out_length - pos - (uint32_t)FILEBOTH_FILE_NAME_OFFSET) {
          smb2_close_fileid(share, &dir_id);
          return EPROTOCOLERR;
        }

        /* A non-zero NextEntryOffset must skip past this entry's name yet stay inside the buffer. */
        if (next_offset != 0 && (next_offset < (uint32_t)FILEBOTH_FILE_NAME_OFFSET + name_len_bytes || next_offset > out_length - pos)) {
          smb2_close_fileid(share, &dir_id);
          return EPROTOCOLERR;
        }

        name_chars = (int)(name_len_bytes / 2);

        /* Convert the UTF-16LE wire name to Latin-1.  A name too long for the buffer is emptied, so it is passed over below: no shortened
         * form of it would name the object.
         */
        if (smb2_utf16le_to_latin1(namebuf, (int)sizeof(namebuf), e + FILEBOTH_FILE_NAME_OFFSET, name_chars * 2, SMB2_ESCAPE_RESERVED) <
            0) {
          namebuf[0] = '\0';
        }

        /* Skip the empty name and the '.' and '..' pseudo-entries; they are not real directory members. */
        if (namebuf[0] == '\0' || (namebuf[0] == '.' && (namebuf[1] == '\0' || (namebuf[1] == '.' && namebuf[2] == '\0')))) {
          if (next_offset == 0) {
            break;
          }

          pos += next_offset;
          continue;
        }

        /* Unless the mount is set to show hidden files, drop entries flagged hidden or system. */
        if (!(LM_Vars.namemode & NM_HIDDEN) && (file_attr & (ATTR_HID | ATTR_SYS))) {
          if (next_offset == 0) {
            break;
          }

          pos += next_offset;
          continue;
        }

        /* Count every listable entry so the caller's skip offset can be honoured. */
        dir_pos++;

        /* Skip entries the caller already consumed on an earlier partial read. */
        if (dir_pos <= (uint32_t)skip) {
          if (next_offset == 0) {
            break;
          }

          pos += next_offset;
          continue;
        }

        /* Pack the entry into the FileSwitch directory format and hand it to the caller's callback. */
        smb2_build_x2_entry(x2_entry, write_time, file_size, file_attr, namebuf, (int)strlen(namebuf));
        res = dirfn(x2_entry, 1, &taken, private, NULL);

        if (res != OK) {
          if (next_offset_out != NULL) {
            *next_offset_out = (int)dir_pos - 1;
          }

          smb2_close_fileid(share, &dir_id);

          return res;
        }

        /* The callback declined the entry (its buffer or budget is full): stop here and resume at this same entry next time. */
        if (!taken) {
          max_reached = true;

          if (next_offset_out != NULL) {
            *next_offset_out = (int)dir_pos - 1;
          }

          break;
        }

        count++;

        /* Stop once the caller's requested entry count is met. */
        if (max_count > 0 && count >= max_count) {
          max_reached = true;

          if (next_offset_out != NULL) {
            *next_offset_out = (int)dir_pos;
          }

          break;
        }

        if (next_offset == 0) {
          break;
        }

        pos += next_offset;
      }
    }

    if (max_reached) {
      break;
    }
  }

  /* Enumeration ran to completion, so tell the caller there is nothing left to resume. */
  if (!max_reached && next_offset_out != NULL) {
    *next_offset_out = -1;
  }

  smb2_close_listing(share, &dir_id);

  return OK;
}

err_t SMB2_GetFreeSpace(SMB2_Share *share, struct disk_size_response *pDSR) {
  SMB2_FILEID root_id;
  uint8_t info_buf[FSFULLSIZE_SIZE];
  int info_len;
  err_t res;
  uint64_t total_units, avail_units;
  uint32_t sectors_per_unit, bytes_per_sector;

  /* Filesystem information needs an open handle; the share root directory serves. */
  res = SMB2_Create(share, "", FILE_READ_ATTRIBUTES, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN, FILE_DIRECTORY_FILE, &root_id, NULL,
                    NULL, NULL);

  if (res != OK) {
    return res;
  }

  /* Query full filesystem size information, which reports space available to the caller's identity rather than the raw volume total. */
  res = smb2_query_info(share, &root_id, SMB2_0_INFO_FILESYSTEM, FileFsFullSizeInformation, info_buf, (int)sizeof(info_buf), &info_len);

  smb2_close_fileid(share, &root_id);

  if (res != OK) {
    return res;
  }

  /* Reject a truncated reply that cannot hold the full-size structure. */
  if (info_len < FSFULLSIZE_SIZE) {
    return EPROTOCOLERR;
  }

  /* Report allocation-unit size and counts; the 64-bit unit totals are clamped to 32 bits for the RISC OS free-space fields. */
  total_units = smb2_get_qword(info_buf + FSFULLSIZE_TOTAL_UNITS_OFFSET);
  avail_units = smb2_get_qword(info_buf + FSFULLSIZE_AVAIL_UNITS_OFFSET);
  sectors_per_unit = smb2_get_dword(info_buf + FSFULLSIZE_SECTORS_PER_UNIT_OFFSET);
  bytes_per_sector = smb2_get_dword(info_buf + FSFULLSIZE_BYTES_PER_SECTOR_OFFSET);

  pDSR->blksize = sectors_per_unit * bytes_per_sector;

  pDSR->freeblks = (avail_units > QWORD_OVERFLOW_32) ? UINT32_CLAMP : (uint)avail_units;
  pDSR->totalblks = (total_units > QWORD_OVERFLOW_32) ? UINT32_CLAMP : (uint)total_units;

  return OK;
}

err_t SMB2_Transact(SMB2_Share *share, const char *pipename, struct TransactParms *pT) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  SMB2_Server *srv;
  SMB2_FILEID pipe_id;
  uint32_t status;
  int req_len, resp_len;
  uint16_t input_offset;
  int input_len;
  err_t res;

  if (share == NULL || share->server == NULL) {
    return EBADPARAM;
  }

  srv = share->server;
  pT->parms_out_len = 0; // a reply that carries no parameters or data reports none, not the caller's old lengths
  pT->data_out_len = 0;

  /* The lengths come from the caller of the LanMan_Transact SWI.  The input is copied into the transmit buffer, and one
   * request charges one credit, so refuse any that would not fit, and a negative output maximum, which would leave the copy of the
   * reply unbounded.
   */
  input_offset = SMB2_HEADER_SIZE + SMB2_IOCTL_REQ_SIZE;
  if (pT->parms_in_len < 0 || pT->data_in_len < 0 || pT->parms_out_maxlen < 0 || pT->data_out_maxlen < 0 ||
      pT->parms_in_len > SMB2_CREDIT_UNIT || pT->data_in_len > SMB2_CREDIT_UNIT - pT->parms_in_len ||
      (size_t)input_offset + (size_t)pT->parms_in_len + (size_t)pT->data_in_len > SMB2_WORKBUF_SIZE) {
    return EDATALEN;
  }

  /* The SMB1 pipe name arrives as \PIPE\name; SMB2 CREATE wants the bare name, so step past the \PIPE\ prefix. */
  if (strncmp(pipename, "\\PIPE\\", 6) == 0) {
    pipename += 6;
  }

  /* Open the named pipe on IPC$ for read and write. */
  res = SMB2_Create(share, pipename, FILE_READ_DATA | FILE_WRITE_DATA, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN, 0, &pipe_id, NULL,
                    NULL, NULL);

  if (res != OK) {
    return res;
  }

  /* The pipe input is the parameter block immediately followed by the data block, laid out just after the IOCTL request. */
  input_len = pT->parms_in_len + pT->data_in_len;

  if (pT->parms_in_len > 0 && pT->parms_in != NULL) {
    memcpy(tx + input_offset, pT->parms_in, (size_t)pT->parms_in_len);
  }

  if (pT->data_in_len > 0 && pT->data_in != NULL) {
    memcpy(tx + input_offset + pT->parms_in_len, pT->data_in, (size_t)pT->data_in_len);
  }

  /*
   * Build and send an FSCTL_PIPE_TRANSCEIVE IOCTL that writes the input and reads the pipe's reply, requesting room for the caller's
   * combined output.
   */
  smb2_init_header(tx, SMB2_IOCTL, srv);
  smb2_set_tree_id(tx, share);

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_IOCTL_REQ_SIZE);
  smb2_put_word(body + SMB2_IOCTL_REQ_STRUCT_SIZE_OFFSET, SMB2_IOCTL_REQ_SIZE + SMB2_VARIABLE_TRAILER);
  smb2_put_dword(body + SMB2_IOCTL_REQ_CTL_CODE_OFFSET, FSCTL_PIPE_TRANSCEIVE);
  smb2_put_qword(body + SMB2_IOCTL_REQ_FILEID_OFFSET, pipe_id.Persistent);
  smb2_put_qword(body + SMB2_IOCTL_REQ_FILEID_VOL_OFFSET, pipe_id.Volatile);
  smb2_put_dword(body + SMB2_IOCTL_REQ_INPUT_POS_OFFSET, (uint32_t)input_offset);
  smb2_put_dword(body + SMB2_IOCTL_REQ_INPUT_LEN_OFFSET, (uint32_t)input_len);
  smb2_put_dword(body + SMB2_IOCTL_REQ_MAX_INPUT_OFFSET, 0);
  smb2_put_dword(body + SMB2_IOCTL_REQ_OUTPUT_POS_OFFSET, 0);
  smb2_put_dword(body + SMB2_IOCTL_REQ_OUTPUT_LEN_OFFSET, 0);
  smb2_put_dword(body + SMB2_IOCTL_REQ_MAX_OUTPUT_OFFSET, (uint32_t)(pT->parms_out_maxlen + pT->data_out_maxlen));
  smb2_put_dword(body + SMB2_IOCTL_REQ_FLAGS_OFFSET, SMB2_0_IOCTL_IS_FSCTL);

  req_len = (int)input_offset + input_len;

  status = SMB2_SendRecv(srv, tx, req_len, rx, SMB2_WORKBUF_SIZE, &resp_len);

  if (NT_STATUS_IS_ERROR(status)) {
    smb2_close_fileid(share, &pipe_id);
    return smb2_status_to_err(status);
  }

  /* Only parse the output when the reply is long enough and its StructureSize matches the IOCTL response. */
  if (resp_len >= SMB2_HEADER_SIZE + SMB2_IOCTL_RESP_MIN &&
      smb2_get_word(rx + SMB2_HEADER_SIZE + SMB2_IOCTL_RESP_STRUCT_SIZE_OFFSET) == SMB2_IOCTL_RESP_SIZE) {
    uint32_t out_offset;
    uint32_t out_count;

    body = rx + SMB2_HEADER_SIZE;
    out_offset = smb2_get_dword(body + SMB2_IOCTL_RESP_OUTPUT_POS_OFFSET);
    out_count = smb2_get_dword(body + SMB2_IOCTL_RESP_OUTPUT_LEN_OFFSET);

    /* Within bounds, split the returned bytes into the caller's parameter portion first and the remainder as data. */
    if (out_count > 0 && out_offset <= (uint32_t)resp_len && out_count <= (uint32_t)resp_len - out_offset) {
      uint8_t *resp_data = rx + out_offset;
      int parms_len = (pT->parms_out_maxlen > 0) ? min((int)out_count, pT->parms_out_maxlen) : 0;
      int data_start = parms_len;
      int data_len = (int)out_count - data_start;

      if (parms_len > 0 && pT->parms_out_buf != NULL) {
        memcpy(pT->parms_out_buf, resp_data, (size_t)parms_len);
        pT->parms_out_len = parms_len;
      }

      /* Clamp the data portion to the caller's buffer before copying. */
      if (data_len > 0 && pT->data_out_buf != NULL) {
        if (data_len > pT->data_out_maxlen) {
          data_len = pT->data_out_maxlen;
        }

        memcpy(pT->data_out_buf, resp_data + data_start, (size_t)data_len);
        pT->data_out_len = data_len;
      }
    }
  }

  smb2_close_fileid(share, &pipe_id);

  return OK;
}

err_t SMB2_Echo(SMB2_Server *srv) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *rx = smb2_rxbuf;
  uint8_t *body;
  int resp_len;
  uint32_t status;

  /* Send an SMB2 ECHO, the keep-alive ping that confirms the connection is still live. */
  smb2_init_header(tx, SMB2_ECHO, srv);

  body = tx + SMB2_HEADER_SIZE;
  smb2_put_word(body + SMB2_ECHO_REQ_STRUCT_SIZE_OFFSET, SMB2_ECHO_REQ_SIZE);
  smb2_put_word(body + SMB2_ECHO_REQ_RESERVED_OFFSET, 0);

  status = SMB2_SendRecv(srv, tx, SMB2_HEADER_SIZE + SMB2_ECHO_REQ_SIZE, rx, SMB2_WORKBUF_SIZE, &resp_len);

  if (NT_STATUS_IS_ERROR(status)) {
    return smb2_status_to_err(status);
  }

  return OK;
}

/* Bytes the server may buffer for one CHANGE_NOTIFY; when changes overflow it the response says so and the client must rescan. */
#define NOTIFY_OUTPUT_SIZE 4096

void SMB2_ChangeNotify(SMB2_Share *share) {
  uint8_t *tx = smb2_txbuf;
  uint8_t *body;
  SMB2_Server *srv;
  int req_len;
  err_t res;
  bool have_handle;

  if (share == NULL || share->server == NULL) {
    return;
  }

  debug("SMB2: [%d] ChangeNotify registering on share %c\n", smb2_tick(), share->drvletter);

  srv = share->server;

  /* Reuse the existing watch handle if one is open; the sentinel FILEID values mark an unopened directory. */
  have_handle = (share->notify_dir_id.Persistent != SMB2_FILEID_INVALID_PERSISTENT ||
                 share->notify_dir_id.Volatile != SMB2_FILEID_INVALID_VOLATILE)
                    ? true
                    : false;

  /* First time round, open the directory to be watched and keep its handle for repeated rearming. */
  if (!have_handle) {
    res = SMB2_Create(share, "", FILE_READ_DATA, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN, FILE_DIRECTORY_FILE,
                      &share->notify_dir_id, NULL, NULL, NULL);

    /* On failure, restore the sentinel so a later attempt sees the handle is not open, and have the poll try again later. */
    if (res != OK) {
      debug("SMB2: ChangeNotify open dir failed, res=%d\n", res);

      /* A failure that killed the connection has freed the share, and its slot may be reused, so leave it alone. */
      if (share->server != srv) {
        return;
      }

      share->notify_dir_id.Persistent = SMB2_FILEID_INVALID_PERSISTENT;
      share->notify_dir_id.Volatile = SMB2_FILEID_INVALID_VOLATILE;
      smb2_notify_retry_later(share);

      return;
    }
  }

  /*
   * Build a recursive (SMB2_WATCH_TREE) CHANGE_NOTIFY over the whole subtree for every change class except last access, so the server can
   * report changes and the Filer re-read them; the active flag blocks callback socket I/O while framing.
   */
  smb2_sendrecv_active = true;

  smb2_init_header(tx, SMB2_CHANGE_NOTIFY, srv);
  smb2_set_tree_id(tx, share);

  body = tx + SMB2_HEADER_SIZE;
  memset(body, 0, SMB2_CHANGE_NOTIFY_REQ_SIZE);
  smb2_put_word(body + SMB2_CHANGE_NOTIFY_REQ_STRUCT_SIZE_OFFSET, SMB2_CHANGE_NOTIFY_REQ_SIZE);
  smb2_put_word(body + SMB2_CHANGE_NOTIFY_REQ_FLAGS_OFFSET, SMB2_WATCH_TREE);
  smb2_put_dword(body + SMB2_CHANGE_NOTIFY_REQ_OUTPUT_LEN_OFFSET, NOTIFY_OUTPUT_SIZE);
  smb2_put_qword(body + SMB2_CHANGE_NOTIFY_REQ_FILEID_OFFSET, share->notify_dir_id.Persistent);
  smb2_put_qword(body + SMB2_CHANGE_NOTIFY_REQ_FILEID_VOL_OFFSET, share->notify_dir_id.Volatile);

  smb2_put_dword(body + SMB2_CHANGE_NOTIFY_REQ_FILTER_OFFSET,
                 FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_DIR_NAME | FILE_NOTIFY_CHANGE_ATTRIBUTES | FILE_NOTIFY_CHANGE_SIZE |
                     FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_CREATION | FILE_NOTIFY_CHANGE_EA | FILE_NOTIFY_CHANGE_SECURITY |
                     FILE_NOTIFY_CHANGE_STREAM_NAME | FILE_NOTIFY_CHANGE_STREAM_SIZE | FILE_NOTIFY_CHANGE_STREAM_WRITE);

  req_len = SMB2_HEADER_SIZE + SMB2_CHANGE_NOTIFY_REQ_SIZE;

  share->notify_msg_id = smb2_get_qword(tx + SMB2_HEADER_MESSAGE_ID_OFFSET);

  /* Sign here because the request is sent raw, bypassing SMB2_SendRecv's own signing. */
  if (srv->flags & SMB2_SRV_SIGNED) {
    smb2_sign_message(srv, tx, req_len);
  }

  /* Spend this request's credits as SMB2_SendRecv would: the raw send below bypasses its accounting, yet the asynchronous completion is
   * still collected and banks the server's grant, so without this the local balance drifts upward on every rearm cycle.
   */
  smb2_spend_credits(srv, tx);

  /*
   * Fire and forget; the asynchronous notification response is collected later, by SMB2_SendRecv or SMB2_PollNotifications, so clear the
   * guard once the send is done.
   */
  res = SMB2X_Send(srv->raw_socket, tx, req_len, LM_Tick() + smb2_deadline_cs());

  smb2_sendrecv_active = false;

  /* A failed send leaves the connection unusable, so mark the server dead. */
  if (res != OK) {
    if (res == ETIMEOUT) {
      debug("SMB2: change_notify rearm send timed out on share %c\n", share->drvletter);
      SMB_MarkServerDeadBySMB2(srv, "change_notify rearm timeout");
    } else {
      debug("SMB2: change_notify rearm send failed (res=%d) on share %c\n", res, share->drvletter);
      SMB_MarkServerDeadBySMB2(srv, "change_notify rearm failure");
    }

    return;
  }

  /* Mark the notification outstanding so the response handler expects it. */
  share->notify_pending = true;
  share->notify_changed = false;
  debug("SMB2: [%d] change notify registered on share %c\n", smb2_tick(), share->drvletter);
}

static void SMB2_CancelNotify(SMB2_Share *share) {
  if (share == NULL) {
    return;
  }

  /* Clear the pending/changed state so the poll loop stops chasing this share. */
  share->notify_pending = false;
  share->notify_changed = false;

  /* Close the directory handle the notify was watching and mark the slot invalid. */
  if (share->notify_dir_id.Persistent != SMB2_FILEID_INVALID_PERSISTENT || share->notify_dir_id.Volatile != SMB2_FILEID_INVALID_VOLATILE) {
    smb2_close_fileid(share, &share->notify_dir_id);
    share->notify_dir_id.Persistent = SMB2_FILEID_INVALID_PERSISTENT;
    share->notify_dir_id.Volatile = SMB2_FILEID_INVALID_VOLATILE;
  }

  debug("SMB2: change notify cancelled\n");
}

/*
 * Ask the desktop Filer to re-read a directory affected by a server-side change.
 *
 * Translates the DOS path to a RISC OS path under the share's mount and issues OS_UpCall ModifyingFile with the given sub-reason.  A NULL
 * dos_path sends the bare name "!", which matches no viewer, so the Filer falls back to re-reading every viewer on the filing system.
 * Does nothing if the drive letter has no mount name.
 *
 * Parameters:
 *   share      the share whose mount the path belongs to
 *   dos_path   DOS path of the changed object, or NULL to refresh every viewer
 *   subreason  the OS_UpCall ModifyingFile sub-reason (upfsfile_Create, upfsfile_Delete, ...)
 */
static void smb2_filer_upcall(SMB2_Share *share, const char *dos_path, int subreason) {
  /* Reverse-map the drive letter to the mount name the Filer knows it by. */
  const char *mount_name = Omni_GetMountName(share->drvletter);
  char riscos_path[SMB2_NAME_LIMIT * 2];

  /* No mount for this drive means nothing the Filer would recognise, so drop the UpCall. */
  if (mount_name == NULL) {
    return;
  }

  /* A NULL path asks for every viewer: "!" matches none, so the Filer re-reads them all. */
  if (dos_path == NULL) {
    riscos_path[0] = '!';
    riscos_path[1] = '\0';
  } else {
    char ro_rel[SMB2_NAME_LIMIT];

    /* Translate the DOS relative path to RISC OS form; on failure fall back to the mount root. */
    if (Xlt_PathDOStoROX2(ro_rel, sizeof(ro_rel), dos_path) != OK) {
      debug("UpCall path-translation FAILED for dos_path=\"%s\"; falling back to mount-root\n", dos_path);
      ro_rel[0] = '\0';
    }

    /* Compose the full RISC OS path, dropping to the share root when no relative part survived. */
    if (ro_rel[0] != '\0') {
      sprintf(riscos_path, ":%s.$.%s", mount_name, ro_rel);
    } else {
      sprintf(riscos_path, ":%s.$", mount_name);
    }
  }

  /* Fire UpCall_ModifyingFile so an open Filer viewer reopens the affected directory. */
  vdebug("SMB2: [%d] UpCall R9=%d R8=%08X for \"%s\"\n", smb2_tick(), subreason, Information_Word, riscos_path);
  _swix(OS_UpCall, _INR(0, 1) | _IN(6) | _IN(8) | _IN(9), UpCall_ModifyingFile, riscos_path, 0, Information_Word, subreason);
}

static void smb2_process_notify_entries(SMB2_Share *share, const uint8_t *fni_data, uint32_t fni_len) {
  uint32_t pos = 0u;
  char last_parent[SMB2_NAME_LIMIT];
  bool have_last_parent = false;
  LMCache_t *cache = NULL;
  hSHARE hS;

  /* Look up the share's cache handle up front for the dispatch below. */
  last_parent[0] = '\0';
  hS = SMB_GetShareFromDrv(share->drvletter);

  if (hS != NULL) {
    cache = SMB_GetCache(hS);
  }

  /* Walk the packed information chain, one variable-length entry at a time. */
  while (pos < fni_len) {
    const uint8_t *entry = fni_data + pos;
    uint32_t next_offset;
    uint32_t action;
    uint32_t name_len;
    char namebuf[SMB2_NAME_LIMIT];
    char parentbuf[SMB2_NAME_LIMIT];
    char *last_bs;
    bool is_delete;
    bool name_fits = true;

    /* Stop on a runt entry that cannot hold even the fixed header. */
    if (fni_len - pos < NOTIFY_FILE_NAME_OFFSET) {
      break;
    }

    /* Read the chain link, the action code, and the name length. */
    next_offset = smb2_get_dword(entry + NOTIFY_NEXT_ENTRY_OFFSET);
    action = smb2_get_dword(entry + NOTIFY_ACTION_OFFSET);
    name_len = smb2_get_dword(entry + NOTIFY_FILE_NAME_LEN_OFFSET);

    /* Decode the UTF-16LE filename if it fits within the entry; otherwise treat it as empty. */
    if (name_len > 0 && name_len <= (fni_len - pos) - NOTIFY_FILE_NAME_OFFSET) {
      name_fits = smb2_utf16le_to_latin1(namebuf, (int)sizeof(namebuf), entry + NOTIFY_FILE_NAME_OFFSET, (int)name_len,
                                         SMB2_ESCAPE_RESERVED) >= 0;
    } else {
      namebuf[0] = '\0';
    }

    /* A path too long for the buffer names no object, so the change is taken as an overflow: the cache is told, and every viewer of the
     * share is refreshed.
     */
    if (!name_fits) {
      debug("SMB2: notify path too long (%u bytes): full Filer refresh\n", (unsigned)name_len);
      Cache_NotifyOverflow(cache);
      smb2_filer_upcall(share, NULL, upfsfile_Create);
      have_last_parent = false;

      if (next_offset == 0 || next_offset > fni_len - pos) {
        break;
      }

      pos += next_offset;
      continue;
    }

    /* Derive the parent path from the name by dropping the final backslash-delimited component. */
    strncpy(parentbuf, namebuf, sizeof(parentbuf) - 1);
    parentbuf[sizeof(parentbuf) - 1] = '\0';
    last_bs = strrchr(parentbuf, '\\');

    /* A name with no backslash sits at the watched root, so its parent is empty. */
    if (last_bs != NULL) {
      *last_bs = '\0';
    } else {
      parentbuf[0] = '\0';
    }

    /* Removes and rename-old-name both count as deletions. */
    is_delete = action == FILE_ACTION_REMOVED || action == FILE_ACTION_RENAMED_OLD_NAME;

    vdebug("SMB2: [%d] notify: action=%d file=\"%s\"\n", smb2_tick(), (int)action, namebuf);

    /* Skip the server echoing a change this client made: the cache and the Filer already reflect it. */
    if (Cache_IsEcho(cache, namebuf, is_delete)) {
      debug("SMB2: notify event DROPPED (parent suppressed) action=%d file=\"%s\"\n", (int)action, namebuf);

      if (next_offset == 0 || next_offset > fni_len - pos) {
        break;
      }

      pos += next_offset;
      continue;
    }

    /* Fold the change into the cache: deletes drop the node, adds and renames extend the parent's listing, modifies expire the node. */
    if (cache != NULL) {
      switch (action) {
      case FILE_ACTION_REMOVED:
      case FILE_ACTION_RENAMED_OLD_NAME:
        debug("SMB2: notify dispatch action=%d file=\"%s\" -> Cache_NotifyRemoved\n", (int)action, namebuf);
        Cache_NotifyRemoved(cache, namebuf);
        break;
      case FILE_ACTION_ADDED:
      case FILE_ACTION_RENAMED_NEW_NAME:
        debug("SMB2: notify dispatch action=%d file=\"%s\" -> Cache_NotifyAdded(parent=\"%s\")\n", (int)action, namebuf, parentbuf);
        Cache_NotifyAdded(cache, namebuf);
        break;
      case FILE_ACTION_MODIFIED:
        debug("SMB2: notify dispatch action=%d file=\"%s\" -> Cache_NotifyChange(node)\n", (int)action, namebuf);
        Cache_NotifyChange(cache, namebuf);
        break;
      default:
        debug("SMB2: notify dispatch action=%d file=\"%s\" -> UNHANDLED action\n", (int)action, namebuf);
        break;
      }
    }

    /* Nudge the Filer: one UpCall per delete, but coalesce runs of creates in the same parent into one refresh. */
    if (is_delete) {
      smb2_filer_upcall(share, namebuf, upfsfile_Delete);

      have_last_parent = false;
    } else if (action == FILE_ACTION_ADDED || action == FILE_ACTION_MODIFIED || action == FILE_ACTION_RENAMED_NEW_NAME) {
      if (!have_last_parent || stricmp(last_parent, parentbuf) != 0) {
        smb2_filer_upcall(share, namebuf, upfsfile_Create);
        strncpy(last_parent, parentbuf, sizeof(last_parent) - 1);
        last_parent[sizeof(last_parent) - 1] = '\0';
        have_last_parent = true;
      }
    }

    /* The last entry has a zero link; one that does not stay inside the buffer is malformed, and following it could loop forever. */
    if (next_offset == 0 || next_offset > fni_len - pos) {
      break;
    }

    pos += next_offset;
  }
}

/*
 * Consume unsolicited async SMB2 responses already waiting on the raw socket.
 *
 * Server-initiated frames (CHANGE_NOTIFY completions, oplock breaks, and interim STATUS_PENDING acks) arrive outside any
 * request/response exchange.  This drains whatever the socket currently holds, crediting the running balance from every frame and routing
 * each completion to its share.  A receive error is treated as a lost connection and marks the server dead.
 *
 * Parameters:
 *   srv  the server whose socket to drain; ignored when NULL, dead, or unconnected
 */
static void smb2_drain_pending_async(SMB2_Server *srv) {
  uint8_t *rx = smb2_rxbuf;

  /* Nothing to drain from a dead or disconnected server. */
  if (srv == NULL || (srv->flags & SMB2_SRV_DEAD) || srv->raw_socket < 0) {
    return;
  }

  /* Take each frame the socket already holds and stop once it drains. */
  while (SMB2X_DataReady(srv->raw_socket)) {
    SMB2_HEADER hdr;
    err_t res;
    int resp_len = 0;

    /* Short deadline: these frames are already buffered, not being awaited. */
    res = SMB2X_Recv(srv->raw_socket, rx, SMB2_WORKBUF_SIZE, LM_Tick() + SMB2_DRAIN_DEADLINE_CS, &resp_len);

    /* A read error here means the connection is gone. */
    if (res != OK) {
      debug("SMB2: drain recv failed res=%d on server \"%s\": marking dead\n", res, srv->servname);
      SMB_MarkServerDeadBySMB2(srv, "drain recv failure");

      return;
    }

    /* Drop runt frames too small to hold a header. */
    if (resp_len < SMB2_HEADER_SIZE) {
      debug("SMB2: drain dropping short frame len=%d\n", resp_len);
      continue;
    }

    /* Drop anything without a valid SMB2 header. */
    if (!smb2_parse_response_header(rx, &hdr)) {
      debug("SMB2: drain dropping non-SMB2 frame\n");
      continue;
    }

    /* Check the signature before crediting or acting on the frame, and treat a failure as SMB2_SendRecv does. */
    if (!smb2_response_signature_ok(srv, rx, resp_len, &hdr)) {
      SMB_MarkServerDeadBySMB2(srv, "drain signature check failed");

      return;
    }

    /* Credit the granted amount to the running balance (MS-SMB2 3.2.4.1.5). */
    if (hdr.CreditReqResp > 0u) {
      uint32_t new_balance = (uint32_t)srv->credits_available + (uint32_t)hdr.CreditReqResp;

      /* The balance is a 16-bit field; saturate rather than wrap. */
      if (new_balance > UINT16_MAX) {
        new_balance = UINT16_MAX;
      }

      srv->credits_available = (uint16_t)new_balance;
    }

    /* Interim ack only; the real completion follows, so wait for it. */
    if (hdr.Status == STATUS_PENDING) {
      vdebug("SMB2: drain interim STATUS_PENDING for cmd=%04X\n", hdr.Command);
      continue;
    }

    /* The reply to a CLOSE sent without waiting needs nothing more. */
    if (smb2_take_unanswered_close(srv, hdr.MessageId)) {
      continue;
    }

    /* No open ever asks for an oplock, so a break notification is unexpected; consume it and move on. */
    if (hdr.Command == SMB2_OPLOCK_BREAK) {
      debug("SMB2: drain unsolicited oplock break ignored\n");
      continue;
    }

    /* A pending CHANGE_NOTIFY has completed. */
    if (hdr.Command == SMB2_CHANGE_NOTIFY) {
      debug("SMB2: drain CHANGE_NOTIFY msgid=0x%08X%08X status=0x%08X len=%d\n", (uint32_t)(hdr.MessageId >> 32), (uint32_t)hdr.MessageId,
            (unsigned)hdr.Status, resp_len);

      if (!smb2_notify_completion(srv, &hdr, rx, resp_len)) {
        debug("SMB2: drain CHANGE_NOTIFY UNMATCHED msgid=0x%08X%08X (no share notify_msg_id matches)\n", (uint32_t)(hdr.MessageId >> 32),
              (uint32_t)hdr.MessageId);
      }

      continue;
    }

    debug("SMB2: drain UNEXPECTED cmd=%04X status=0x%08X len=%d msgid=0x%08X%08X\n", hdr.Command, (unsigned)hdr.Status, resp_len,
          (uint32_t)(hdr.MessageId >> 32), (uint32_t)hdr.MessageId);
  }
}

void SMB2_PollNotifications(void) {
  static uint32_t last_poll;
  uint32_t now;
  int i;

  /* Don't touch the sockets while a SendRecv is already in flight. */
  if (smb2_sendrecv_active) {
    return;
  }

  /*
   * Poll at most once a centisecond.  A program walking a tree makes thousands of calls a second, and asking the Internet module about
   * every socket on each one costs more than the rest of a call answered from memory.  Each exchange takes in whatever notification is
   * waiting anyway.
   */
  now = LM_Tick();
  if (now == last_poll) {
    return;
  }
  last_poll = now;

  /* Claim the socket-busy flag for the inline drain below. */
  smb2_sendrecv_active = true;

  /* Drain any queued async responses on each live server. */
  for (i = 0; i < SMB2_MAX_SERVERS; i++) {
    SMB2_Server *srv = &smb2_servers[i];

    /* Skip servers that are not alive with an open socket. */
    if (!(srv->flags & SMB2_SRV_ALLOCATED) || (srv->flags & SMB2_SRV_DEAD) || srv->raw_socket < 0) {
      continue;
    }

    smb2_drain_pending_async(srv);
  }

  /* Release the guard now the inline drain is done. */
  smb2_sendrecv_active = false;

  /* Re-arm CHANGE_NOTIFY on any share the drain flagged as changed. */
  for (i = 0; i < SMB2_MAX_SHARES; i++) {
    SMB2_Share *share = &smb2_shares[i];

    if (share->server == NULL || !share->notify_changed) {
      continue;
    }

    /* A watch that keeps failing waits longer each time. */
    if (share->notify_failures != 0u && (int32_t)(LM_Tick() - share->notify_retry_at) < 0) {
      continue;
    }

    /* Clear the flag before re-arming so a notification arriving mid-re-arm is not lost. */
    share->notify_changed = false;
    SMB2_ChangeNotify(share);
  }

  /* Finally close any handles whose close was deferred while the guard was held. */
  smb2_drain_pending_closes();

  /* A parked listing holds a directory open on the server; let it go if no call has continued it in a while. */
  if (smb2_listing.parked && LM_Tick() - smb2_listing.parked_at > SMB2_LISTING_IDLE_CS) {
    SMB2_EndListing();
  }
}

#undef NOTIFY_OUTPUT_SIZE
