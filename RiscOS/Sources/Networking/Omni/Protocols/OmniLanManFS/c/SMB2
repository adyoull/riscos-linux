static err_t smb2_query_info(SMB2_Share *share, SMB2_FILEID *file_id, uint8_t info_type, uint8_t file_class, uint8_t *out_buf,
                             int out_bufsize, int *out_len);

/*
 * Tear down a share's outstanding CHANGE_NOTIFY registration and release its directory handle.
 *
 * Clears the pending/changed flags and closes the notify handle if one is held. Safe to call with a NULL share or when no watch is active.
 *
 * Parameters:
 *   share  share whose notification watch is to be cancelled, or NULL
 */
static void SMB2_CancelNotify(SMB2_Share *share);

/*
 * Open or create an object on a share via SMB2 CREATE, following any symlinks it stops on.
 *
 * Leading backslashes in the path are stripped. If the path crosses a symlink the server answers STATUS_STOPPED_ON_SYMLINK; the link's
 * substitute name is spliced in over the part of the path already traversed and the request is retried, up to eight hops, so the caller
 * sees a transparent open of the final target. A relative link is resolved against the directory that contained it; an absolute link, or
 * one whose ".." climbs out of the share, is refused. An open of a name that the directory lookup made just before found absent fails at
 * once, without being sent, since nothing has gone to the server in between.
 *
 * Parameters:
 *   share               the connected share to open on
 *   filename            DOS path of the object, backslash-separated
 *   desired_access      requested access mask
 *   file_attributes     attributes to apply when the object is created
 *   share_access        sharing mode granted to other openers
 *   create_disposition  action taken when the object does or does not already exist
 *   create_options      CREATE option flags
 *   file_id_out         receives the persistent/volatile server file id
 *   size_out            optional, receives the end-of-file size
 *   attributes_out      optional, receives the file attributes
 *   write_time_out      optional, receives the last-write FILETIME
 *
 * Returns: OK on success; EBADPARAM for a share with no server or a resolved path that does not fit; EFILENOTFOUND for a name the
 * lookup found absent; ESYMLINKFAILED for a link that cannot be followed within eight hops or is refused; EPROTOCOLERR on a malformed
 * response; otherwise the mapped error from the server's status.
 */
static err_t SMB2_Create(SMB2_Share *share, const char *filename, uint32_t desired_access, uint32_t file_attributes, uint32_t share_access,
                         uint32_t create_disposition, uint32_t create_options, SMB2_FILEID *file_id_out, uint64_t *size_out,
                         uint32_t *attributes_out, uint64_t *write_time_out);

/*
 * Release the open-file table slot at `index`, zeroing its entry so it reads as free but keeping its generation.
 *
 * Bounds-checked and safe to call with an out-of-range index, in which case it does nothing.
 *
 * Parameters:
 *   index  slot in the SMB2 open-file table
 */
static void smb2_free_file(int index);

/*
 * Walk a CHANGE_NOTIFY response's FILE_NOTIFY_INFORMATION list and propagate each change.
 *
 * For every entry it updates the mount's cache (dropping a removed path, adding a name to its parent's listing, or expiring a modified
 * path) and raises a Filer UpCall so the desktop reflects the change.  Consecutive additions under the same parent are coalesced into a
 * single create UpCall.  An entry the cache recognises as the echo of a change this client made (Cache_IsEcho) is skipped.
 *
 * Parameters:
 *   share     the share the notification arrived on
 *   fni_data  start of the packed FILE_NOTIFY_INFORMATION list
 *   fni_len   length in bytes of that list
 */
static void smb2_process_notify_entries(SMB2_Share *share, const uint8_t *fni_data, uint32_t fni_len);
/*
 * Send an SMB2 CLOSE for the given file id and report the server's answer.
 *
 * Most callers ignore the result, because releasing a handle is best-effort and there is nothing useful to do when a close fails.  A
 * delete-on-close removal needs it, because a server may refuse the delete only when the handle closes.
 *
 * Parameters:
 *   share  the share the handle belongs to
 *   fid    persistent/volatile file id to close
 *
 * Returns: OK, ELINKFAILED when the share has no connection to send on, or the mapped error from the CLOSE.
 */
static err_t smb2_close_fileid(SMB2_Share *share, SMB2_FILEID *fid);
/*
 * Map an SMB2 FILE_ATTRIBUTE_* word to the DOS ATTR_* bit set.
 *
 * Parameters:
 *   smb2_attr  SMB2 attribute flags from a server response
 *
 * Returns: the equivalent DOS attribute bits.
 */
static int smb2_attribs_to_dos(uint32_t smb2_attr);

/*
 * Convert a Unix-epoch time in seconds to a Windows FILETIME.
 *
 * A FILETIME counts 100-nanosecond ticks since 1601-01-01, so the value is shifted forward by the 1601-to-1970 gap and scaled up. Zero is
 * passed through unchanged as the wire convention for "time not set".
 *
 * Parameters:
 *   utime  seconds since the Unix epoch, or 0 for unset
 *
 * Returns: the equivalent FILETIME in 100ns ticks, or 0 when utime is 0.
 */
static uint64_t utime_to_filetime(uint utime);

/*
 * Send an SMB2 SET_INFO request writing a metadata structure to an open file.
 *
 * The encoded structure is appended to the fixed request part and its offset and length are stamped into the header fields; the server
 * addresses the target by the persistent/volatile file id from a prior CREATE.
 *
 * Parameters:
 *   share       target share, carrying the server and session
 *   file_id     handle of the open file to modify
 *   info_type   SMB2 info-type group (file, filesystem, security, quota)
 *   file_class  information class within that group
 *   in_buf      encoded information structure to write
 *   in_len      its length in bytes
 *
 * Returns: OK on success, or a translated RISC OS error.
 */
static err_t smb2_set_info(SMB2_Share *share, SMB2_FILEID *file_id, uint8_t info_type, uint8_t file_class, const uint8_t *in_buf,
                           int in_len);

/*
 * Park a server file handle to be closed once the current wire exchange finishes.
 *
 * A handle can need closing while SMB2_SendRecv is still on the stack (a watch completion handled inline, say), and sending the CLOSE there
 * would re-enter the transport. The handle is queued here instead and issued for real by smb2_drain_pending_closes once the wire is idle.
 *
 * Parameters:
 *   share  share that owns the handle
 *   fid    server file id to close later
 */
static void smb2_enqueue_pending_close(SMB2_Share *share, SMB2_FILEID fid) {
  int i;

  /* Claim the first free slot and record which handle to close and on which share. */
  for (i = 0; i < SMB2_PENDING_CLOSE_QUEUE; i++) {
    if (!smb2_pending_closes[i].in_use) {
      smb2_pending_closes[i].in_use = true;
      smb2_pending_closes[i].share = share;
      smb2_pending_closes[i].fid = fid;

      return;
    }
  }

  debug("SMB2: pending-close queue full, FID leaked server-side until disconnect\n");
}

/*
 * Schedule another attempt at a share's watch after a failure, opening the directory afresh.
 *
 * A failure usually means the watch handle is no good any more (the server closed it, or refuses to watch through it), and re-arming on
 * the same handle would fail the same way every poll.  So the handle is let go, and each failure in a row doubles the wait.
 *
 * Parameters:
 *   share  share whose watch failed
 */
static void smb2_notify_retry_later(SMB2_Share *share) {
  uint32_t wait;
  uint32_t n;

  /* Queue the close of any directory handle the failed watch still holds, so that it is not leaked. */
  if (share->notify_dir_id.Persistent != SMB2_FILEID_INVALID_PERSISTENT || share->notify_dir_id.Volatile != SMB2_FILEID_INVALID_VOLATILE) {
    smb2_enqueue_pending_close(share, share->notify_dir_id);
    share->notify_dir_id.Persistent = SMB2_FILEID_INVALID_PERSISTENT;
    share->notify_dir_id.Volatile = SMB2_FILEID_INVALID_VOLATILE;
  }

  if (share->notify_failures < UINT8_MAX) {
    share->notify_failures++;
  }

  /* Double the wait with each failure in a row, up to the ceiling. */
  wait = SMB2_NOTIFY_RETRY_FIRST_CS;

  for (n = 1u; n < share->notify_failures && wait < SMB2_NOTIFY_RETRY_MAX_CS; n++) {
    wait <<= 1;
  }

  if (wait > SMB2_NOTIFY_RETRY_MAX_CS) {
    wait = SMB2_NOTIFY_RETRY_MAX_CS;
  }

  share->notify_retry_at = LM_Tick() + wait;
  share->notify_changed = true;

  debug("SMB2: CHANGE_NOTIFY on share %c failed (%u in a row): reopening in %ucs\n", share->drvletter, (unsigned)share->notify_failures,
        (unsigned)wait);
}

/*
 * Note the completion of a share's outstanding CHANGE_NOTIFY, so the next poll re-arms the watch.
 *
 * Parameters:
 *   share   share whose watch completed
 *   status  NT status of the completion
 */
static void smb2_notify_completed(SMB2_Share *share, uint32_t status) {
  share->notify_changed = true;

  /* A cancellation can only come from the server and says nothing about the handle; an overflow is the watch working. */
  if (status == STATUS_CANCELLED) {
    return;
  }

  if (!NT_STATUS_IS_ERROR(status)) {
    share->notify_failures = 0u;
    return;
  }

  smb2_notify_retry_later(share);
}

/*
 * Issue every parked CLOSE now that the transport is idle.
 *
 * Called by SMB2_PollNotifications once it has released smb2_sendrecv_active, so the closes deferred by smb2_enqueue_pending_close can go
 * out without re-entering the wire.
 */
static void smb2_drain_pending_closes(void) {
  int i;

  /* Walk every slot, skipping the ones holding no parked close. */
  for (i = 0; i < SMB2_PENDING_CLOSE_QUEUE; i++) {
    if (!smb2_pending_closes[i].in_use) {
      continue;
    }

    /* Only send the CLOSE if the share is still mounted; a dismount takes the server-side handle with it. */
    if (smb2_pending_closes[i].share->server != NULL) {
      smb2_close_fileid(smb2_pending_closes[i].share, &smb2_pending_closes[i].fid);
    }

    /* Free the slot whether or not the close was sent. */
    smb2_pending_closes[i].in_use = false;
    smb2_pending_closes[i].share = NULL;
  }
}

/* True while the background timer's pass runs, so every exchange it makes uses the background deadline. */
static bool smb2_background = false;

void SMB2_SetBackground(bool background) {
  smb2_background = background;
}

/* Return the deadline for an exchange starting now, in centiseconds from now. */
static uint smb2_deadline_cs(void) {
  return smb2_background ? SMB2_BACKGROUND_DEADLINE_CS : SMB2_DEADLINE_CS;
}

bool SMB2_IsBusy(void) {
  /* Busy while a wire exchange is mid-flight, or when the wider filing system has claimed the module. */
  return smb2_sendrecv_active || lanmanfs_in_use;
}

/* Server, share and open-file slot tables, carved from the module Dynamic Area by SMB2_SetWorkspace rather than held in module ZI. */
static SMB2_Server *smb2_servers;
static SMB2_Share *smb2_shares;
static SMB2_FileEntry *smb2_files;

/* Size of each work buffer (declared in SMB.h); Workspace_PickMemoryProfile lowers it on small machines before the workspace is carved. */
size_t smb2_workbuf_size = SMB2_WORKBUF_MAX;

size_t SMB2_WorkspaceBytes(void) {
  return (size_t)SMB2_WORKBUF_SIZE * 3u + (size_t)SMB2_MAX_OPEN_FILES * sizeof(SMB2_FileEntry) +
         (size_t)SMB2_MAX_SERVERS * sizeof(SMB2_Server) + (size_t)SMB2_MAX_SHARES * sizeof(SMB2_Share);
}

void SMB2_SetWorkspace(void *base) {
  char *p = (char *)base;

  smb2_txbuf = (uint8_t *)p;
  p += SMB2_WORKBUF_SIZE;

  smb2_rxbuf = (uint8_t *)p;
  p += SMB2_WORKBUF_SIZE;

  smb2_dirbuf = (uint8_t *)p;
  p += SMB2_WORKBUF_SIZE;

  smb2_files = (SMB2_FileEntry *)p;
  p += (size_t)SMB2_MAX_OPEN_FILES * sizeof(SMB2_FileEntry);

  smb2_servers = (SMB2_Server *)p;
  p += (size_t)SMB2_MAX_SERVERS * sizeof(SMB2_Server);

  smb2_shares = (SMB2_Share *)p;

  memset(smb2_files, 0, (size_t)SMB2_MAX_OPEN_FILES * sizeof(SMB2_FileEntry));
  memset(smb2_servers, 0, (size_t)SMB2_MAX_SERVERS * sizeof(SMB2_Server));
  memset(smb2_shares, 0, (size_t)SMB2_MAX_SHARES * sizeof(SMB2_Share));
}

/*
 * Little-endian: read a 16-bit value from the two bytes at `p`.
 */
/* cppcheck-suppress constParameter */
static inline uint16_t smb2_get_word(const uint8_t *p) {
  return (uint16_t)(p[0] | (p[1] << 8));
}

/*
 * Little-endian: read a 32-bit value from the four bytes at `p`.
 */
static inline uint32_t smb2_get_dword(const uint8_t *p) {
  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
}

/*
 * Little-endian: read a 64-bit value from the eight bytes at `p`.
 */
static inline uint64_t smb2_get_qword(const uint8_t *p) {
  return (uint64_t)smb2_get_dword(p) | ((uint64_t)smb2_get_dword(p + 4) << 32);
}

/*
 * Little-endian: store a 16-bit value in the two bytes at `p`.
 */
static inline void smb2_put_word(uint8_t *p, uint16_t val) {
  p[0] = (uint8_t)(val & 0xFF);
  p[1] = (uint8_t)((val >> 8) & 0xFF);
}

/*
 * Little-endian: store a 32-bit value in the four bytes at `p`.
 */
static inline void smb2_put_dword(uint8_t *p, uint32_t val) {
  /* Least significant byte first: SMB2 wire fields are little-endian whatever the host order. */
  p[0] = (uint8_t)(val & 0xFF);
  p[1] = (uint8_t)((val >> 8) & 0xFF);
  p[2] = (uint8_t)((val >> 16) & 0xFF);
  p[3] = (uint8_t)((val >> 24) & 0xFF);
}

/*
 * Little-endian: store a 64-bit value in the eight bytes at `p`.
 */
static inline void smb2_put_qword(uint8_t *p, uint64_t val) {
  /* Low half occupies the first four bytes; little-endian ordering carries across all eight. */
  smb2_put_dword(p, (uint32_t)(val & 0xFFFFFFFFu));
  smb2_put_dword(p + 4, (uint32_t)(val >> 32));
}

/*
 * Lay down the fixed 64-byte SMB2 header that fronts every request.
 *
 * The credit request is sized to top the running balance back up towards the target, with a floor of one so the channel is never asked for
 * zero credits; the message id is consumed monotonically. The caller fills in the command-specific body that follows the header.
 *
 * Parameters:
 *   buf      start of the send buffer, at least SMB2_HEADER_SIZE bytes
 *   command  SMB2 command opcode for this request
 *   srv      server connection; supplies the session id and the message-id counter, which is advanced by one
 */
static void smb2_init_header(uint8_t *buf, uint16_t command, SMB2_Server *srv) {
  uint16_t credit_request;

  /*
   * Zero the header, then stamp the protocol magic, structure size, command, a top-up credit request, the next monotonic message id and
   * the session id.
   */
  memset(buf, 0, SMB2_HEADER_SIZE);

  buf[0] = SMB2_MAGIC_0;
  buf[1] = SMB2_MAGIC_1;
  buf[2] = SMB2_MAGIC_2;
  buf[3] = SMB2_MAGIC_3;
  smb2_put_word(buf + SMB2_HEADER_STRUCT_SIZE_OFFSET, SMB2_HEADER_SIZE);

  smb2_put_word(buf + SMB2_HEADER_CREDIT_CHARGE_OFFSET, SMB2_CREDIT_CHARGE_NORMAL);

  smb2_put_word(buf + SMB2_HEADER_COMMAND_OFFSET, command);

  credit_request = (srv->credits_available < SMB2_CREDIT_TARGET) ? (uint16_t)(SMB2_CREDIT_TARGET - srv->credits_available) : 1u;
  smb2_put_word(buf + SMB2_HEADER_CREDIT_OFFSET, credit_request);

  smb2_put_qword(buf + SMB2_HEADER_MESSAGE_ID_OFFSET, srv->next_message_id);
  srv->next_message_id++;

  smb2_put_qword(buf + SMB2_HEADER_SESSION_ID_OFFSET, srv->session_id);
}

/*
 * Override the credit charge of an already-initialised request header.
 *
 * A request charging more than one credit consumes that many consecutive message ids (MS-SMB2 3.2.4.1.6), so the id counter must skip the
 * extras beyond the one already reserved by smb2_init_header.
 *
 * Parameters:
 *   buf     request buffer whose header has already been laid down
 *   srv     server connection whose message-id counter is advanced for a multi-credit charge
 *   charge  number of credits this request should charge
 */
static void smb2_set_credit_charge(uint8_t *buf, SMB2_Server *srv, uint16_t charge) {
  /* Replace the single-credit charge that smb2_init_header wrote by default. */
  smb2_put_word(buf + SMB2_HEADER_CREDIT_CHARGE_OFFSET, charge);

  /* A multi-credit command owns that many consecutive message ids; step the counter past the extra ones. */
  if (charge > 1u) {
    srv->next_message_id += (uint64_t)charge - 1u;
  }
}

/*
 * Work out the credit charge for a READ, WRITE or directory listing request, shrinking it to fit the credits in hand.
 *
 * Parameters:
 *   chunk             in/out desired transfer size in bytes; reduced when credits are short
 *   len_remaining     bytes still to transfer, so the chunk is never grown past the request
 *   credits_available current credit balance
 *
 * Returns: the credit charge to stamp into the header, at least one for the non-empty chunk every caller passes.
 */
static inline uint16_t smb2_charge_and_scale(uint32_t *chunk, uint32_t len_remaining, uint16_t credits_available) {
  uint16_t charge;

  /* Ideal charge is one credit per 64 KiB unit, rounded up. */
  charge = (uint16_t)((*chunk + SMB2_CREDIT_UNIT - 1u) / SMB2_CREDIT_UNIT);

  /* Charge exceeds the balance, so trim the transfer to what the credits allow. */
  if (charge > credits_available) {
    if (credits_available == 0u) {
      charge = 1u;

      /* With nothing banked, send a one-credit, one-unit request anyway rather than stall. */
      if (*chunk > SMB2_CREDIT_UNIT) {
        *chunk = SMB2_CREDIT_UNIT;
      }
    } else {
      charge = credits_available;
      *chunk = (uint32_t)charge * SMB2_CREDIT_UNIT;

      /* Otherwise spend the whole balance, but never read past what is left to transfer. */
      if (*chunk > len_remaining) {
        *chunk = len_remaining;
      }
    }
  }

  return charge;
}

/*
 * Validate the SMB2 protocol magic and unpack the 64-byte response header into `hdr`.
 *
 * Parameters:
 *   buf  received response, at least SMB2_HEADER_SIZE bytes
 *   hdr  header struct filled in on success
 *
 * Returns: true if the magic matched and the header was unpacked, false for a non-SMB2 reply.
 */
static bool smb2_parse_response_header(const uint8_t *buf, SMB2_HEADER *hdr) {
  /* Reject anything not fronted by the SMB2 protocol id (0xFE 'S' 'M' 'B') before touching the rest. */
  if (buf[0] != SMB2_MAGIC_0 || buf[1] != SMB2_MAGIC_1 || buf[2] != SMB2_MAGIC_2 || buf[3] != SMB2_MAGIC_3) {
    return false;
  }

  /* Read each field from its fixed little-endian offset within the header. */
  hdr->StructureSize = smb2_get_word(buf + SMB2_HEADER_STRUCT_SIZE_OFFSET);
  hdr->CreditCharge = smb2_get_word(buf + SMB2_HEADER_CREDIT_CHARGE_OFFSET);
  hdr->Status = smb2_get_dword(buf + SMB2_HEADER_STATUS_OFFSET);
  hdr->Command = smb2_get_word(buf + SMB2_HEADER_COMMAND_OFFSET);
  hdr->CreditReqResp = smb2_get_word(buf + SMB2_HEADER_CREDIT_OFFSET);
  hdr->Flags = smb2_get_dword(buf + SMB2_HEADER_FLAGS_OFFSET);
  hdr->NextCommand = smb2_get_dword(buf + SMB2_HEADER_NEXT_COMMAND_OFFSET);
  hdr->MessageId = smb2_get_qword(buf + SMB2_HEADER_MESSAGE_ID_OFFSET);
  hdr->Reserved = smb2_get_dword(buf + SMB2_HEADER_RESERVED_OFFSET);
  hdr->TreeId = smb2_get_dword(buf + SMB2_HEADER_TREE_ID_OFFSET);
  hdr->SessionId = smb2_get_qword(buf + SMB2_HEADER_SESSION_ID_OFFSET);
  memcpy(hdr->Signature, buf + SMB2_HEADER_SIGNATURE_OFFSET, SMB2_SIGNATURE_SIZE);

  return true;
}

/*
 * Compute the 16-byte signature MAC over a framed SMB2 message.
 *
 * The algorithm follows the negotiated dialect: SMB 3.x signs with AES-128-CMAC, SMB 2.x with HMAC-SHA256 truncated to 16 bytes.
 *
 * Parameters:
 *   srv      server connection; supplies the dialect and signing key
 *   msg      framed message with its signature field zeroed
 *   msg_len  length of msg in bytes
 *   mac_out  16-byte buffer to receive the signature
 *
 * Returns: 0 on success, -1 if the required cipher or hash is unavailable or the computation fails.
 */
static int smb2_compute_mac(SMB2_Server *srv, const uint8_t *msg, int msg_len, uint8_t *mac_out) {
  /* SMB 3.x signs with AES-128-CMAC; earlier dialects use HMAC-SHA256. */
  if (srv->dialect >= SMB2_DIALECT_0300) {
    const mbedtls_cipher_info_t *ci;
    uint8_t cmac_out[SMB2_SIGNATURE_SIZE];

    /* CMAC is built on the AES-128 block cipher, requested here in ECB form. */
    ci = mbedtls_cipher_info_from_type(MBEDTLS_CIPHER_AES_128_ECB);

    /* Absent if AES-CMAC was left out of the mbedTLS build. */
    if (ci == NULL) {
      return -1;
    }

    if (mbedtls_cipher_cmac(ci, srv->signing_key, SMB2_AES128_KEY_BITS, msg, (size_t)msg_len, cmac_out) != 0) {
      return -1;
    }

    /* CMAC output is already the full 16-byte signature width. */
    memcpy(mac_out, cmac_out, SMB2_SIGNATURE_SIZE);
  } else {
    const mbedtls_md_info_t *mi;
    uint8_t hmac_out[SMB2_HMAC_SHA256_SIZE];

    mi = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);

    if (mi == NULL) {
      return -1;
    }

    if (mbedtls_md_hmac(mi, srv->signing_key, SMB2_SIGNING_KEY_SIZE, msg, (size_t)msg_len, hmac_out) != 0) {
      return -1;
    }

    /* SHA-256 HMAC is 32 bytes wide; the signature keeps only the leading 16. */
    memcpy(mac_out, hmac_out, SMB2_SIGNATURE_SIZE);
  }

  return 0;
}

/*
 * Stamp an AES-CMAC signature into an outbound message, marking it signed.
 *
 * Per MS-SMB2 the signature is computed over the whole message with the SIGNED flag already set and the signature field zeroed, so both are
 * applied before the MAC is taken. If the MAC cannot be computed the field is left zeroed and the message goes out effectively unsigned.
 *
 * Parameters:
 *   srv      server whose signing key is used
 *   msg      framed message to sign in place
 *   msg_len  length of the message in bytes
 */
static void smb2_sign_message(SMB2_Server *srv, uint8_t *msg, int msg_len) {
  uint32_t flags;
  uint8_t mac[SMB2_SIGNATURE_SIZE];

  /* Set the SIGNED flag and zero the signature field: the MAC is computed over the frame in exactly this state. */
  flags = smb2_get_dword(msg + SMB2_HEADER_FLAGS_OFFSET);
  flags |= SMB2_FLAGS_SIGNED;
  smb2_put_dword(msg + SMB2_HEADER_FLAGS_OFFSET, flags);

  memset(msg + SMB2_HEADER_SIGNATURE_OFFSET, 0, SMB2_SIGNATURE_SIZE);

  /* Leave the field zeroed if the MAC could not be computed, sending unsigned rather than mis-signed. */
  if (smb2_compute_mac(srv, msg, msg_len, mac) == 0) {
    memcpy(msg + SMB2_HEADER_SIGNATURE_OFFSET, mac, SMB2_SIGNATURE_SIZE);
  }
}

/*
 * Verify the signature carried in a received SMB2 message, working on it in the receive buffer.
 *
 * The check zeroes the signature field while the MAC is recomputed, then puts it back, so the frame is left intact for parsing. A
 * frame held outside the receive buffers is copied into scratch first.
 *
 * Parameters:
 *   srv      server whose signing key is used
 *   msg      the received frame, header first
 *   msg_len  length of the frame in bytes
 *
 * Returns: true when the signature matches; false when it does not, or the frame is too short or too big to check.
 */
static bool smb2_verify_signature(SMB2_Server *srv, const uint8_t *msg, int msg_len) {
  uint8_t saved_sig[SMB2_SIGNATURE_SIZE];
  uint8_t computed_mac[SMB2_SIGNATURE_SIZE];
  uint8_t *work;

  /* A frame shorter than the header cannot carry a signature. */
  if (msg_len < SMB2_HEADER_SIZE) {
    return false;
  }

  /* Verification mutates the frame (zeroing the signature field).  Our own receive buffers are worked on in place; a frame held anywhere
   * else is copied into the scratch area first.
   */
  work = (msg == smb2_dirbuf) ? smb2_dirbuf : smb2_rxbuf;

  if (msg != work) {
    if ((size_t)msg_len > SMB2_WORKBUF_SIZE) {
      return false;
    }

    memcpy(work, msg, (size_t)msg_len);
  }

  /* Stash the received signature, then zero the field to reproduce the state the sender signed. */
  memcpy(saved_sig, work + SMB2_HEADER_SIGNATURE_OFFSET, SMB2_SIGNATURE_SIZE);
  memset(work + SMB2_HEADER_SIGNATURE_OFFSET, 0, SMB2_SIGNATURE_SIZE);

  /* Fail closed if the MAC cannot be recomputed. */
  if (smb2_compute_mac(srv, work, msg_len, computed_mac) != 0) {
    return false;
  }

  /* Restore the original signature so the frame is left intact for the caller to parse. */
  memcpy(work + SMB2_HEADER_SIGNATURE_OFFSET, saved_sig, SMB2_SIGNATURE_SIZE);

  return memcmp(saved_sig, computed_mac, SMB2_SIGNATURE_SIZE) == 0;
}

