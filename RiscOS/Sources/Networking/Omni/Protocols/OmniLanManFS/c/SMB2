/* Bound on each wire send and receive, so a dead or stalled server cannot hang the single-threaded desktop indefinitely. */
#define SMB2_DEADLINE_CS 2000u

/*
 * Time allowed for the final answer once the server has acknowledged a request as pending.  It may be waiting on another client, for
 * instance to give up an oplock, and Windows allows that client 35 seconds before breaking it regardless.
 */
#define SMB2_PENDING_DEADLINE_CS 6000u

/*
 * Bound on each send and receive made from the background timer, final answers included.  The whole desktop waits on these, so a server
 * slow to answer one is treated as gone rather than freezing the machine for the full foreground deadline.
 */
#define SMB2_BACKGROUND_DEADLINE_CS 500u

/* Delay before the hourglass appears during an exchange, so quick round trips never flash it up. */
#define HOURGLASS_DELAY_CS 100u

/* Bound on reading a frame the notification poll has found waiting on the socket; it has already arrived, so the wait is short. */
#define SMB2_DRAIN_DEADLINE_CS 100u

/* Private NT STATUS (outside the spec's ranges) returned when SMB2_SendRecv is entered re-entrantly; maps to ELANMANFSINUSE. */
#define STATUS_SMB2_REENTRANT 0xE0000001

/* Links followed in resolving one symbolic link before the chain is given up as a loop. */
#define SMB2_SYMLINK_MAX_HOPS 8

/* Most segments smb2_path_normalise keeps; a path with more is refused rather than cut short. */
#define SMB2_PATH_MAX_SEGMENTS 64

/* A name from the server shows '&', '@', '^', '%', '<', '>' and an ambiguous '$' as escapes (see smb2_utf16le_to_latin1), unless
 * *LMNameMode chose the SMB1 mapping.
 */
#define SMB2_ESCAPE_RESERVED ((LM_Vars.namemode & NM_LEGACYCHARS) == 0)

/* NTLMSSP AV_PAIR id and flag (MS-NLMP 2.2.2.1) not defined by SPNEGOLib: MsvAvFlags, and its bit saying a MIC follows. */
#define MSV_AV_FLAGS            0x0006
#define MSV_AV_FLAG_MIC_PRESENT 0x00000002u

/* The Version field of an NTLMSSP CHALLENGE (MS-NLMP 2.2.1.2, 2.2.2.10): major and minor bytes, then a two-byte build number. */
#define NTLM_CHALLENGE_VERSION_OFFSET 48u
#define NTLM_VERSION_SIZE             8u

/* A minor version this large is not one Windows has ever reported, so it marks a server that is not Windows. */
#define NTLM_VERSION_MINOR_LIMIT 100u

/* Bytes held for each name taken apart or captured at logon: the domain and user halves of DOMAIN\user, and the server's name. */
#define NTLM_NAME_BUF_BYTES 64

/* Listed lengths up to this many bytes are never taken as lagging: a small file filling its one allocation unit exactly is common. */
#define SMB2_SUSPECT_SIZE_FLOOR 4096u

/* First wait before re-arming a watch whose last completion failed, and the most it doubles up to. */
#define SMB2_NOTIFY_RETRY_FIRST_CS 100u
#define SMB2_NOTIFY_RETRY_MAX_CS   6000u

/* A FILETIME counts 100ns ticks from 1601-01-01; the offset is the 1601-to-1970 gap in seconds for converting to and from Unix time. */
#define FILETIME_EPOCH_OFFSET 11644473600ULL

#define FILETIME_TICKS_PER_SECOND 10000000ULL

/* Transmit and receive work buffers, smb2_workbuf_size bytes each, carved from the module Dynamic Area by SMB2_SetWorkspace. */
static uint8_t *smb2_txbuf;
static uint8_t *smb2_rxbuf;

/* Receive buffer reserved for QUERY_DIRECTORY replies, the same size again.  A directory scan decodes its entries in place and, part-way
 * through, issues further requests of its own (resolving a symlink), and a listing parked between calls keeps its unread entries here
 * while other requests come and go.  Those other replies land in smb2_rxbuf, so they cannot overwrite the entries still to be read.
 * One buffer suffices because only one scan is ever in progress.
 */
static uint8_t *smb2_dirbuf;

/* Re-entrancy guard: held for the whole of SMB2_SendRecv, and around the raw socket work of SMB2_ChangeNotify and SMB2_PollNotifications,
 * so a call made while a TaskWindow has suspended one of them cannot touch the socket.
 */
static bool smb2_sendrecv_active = false;

/*
 * Deferred-close queue.  A failed CHANGE_NOTIFY watch or an abandoned directory listing can give up its handle while an exchange is still
 * on the stack, where sending a CLOSE would re-enter the transport; such handles are parked here and issued by smb2_drain_pending_closes
 * once the wire is idle.  An overflow leaks the server-side handle until disconnect, which is tolerable but logged.
 */
#define SMB2_PENDING_CLOSE_QUEUE 16

typedef struct {
  bool in_use;
  SMB2_Share *share;
  SMB2_FILEID fid;
} SMB2_PendingClose;

static SMB2_PendingClose smb2_pending_closes[SMB2_PENDING_CLOSE_QUEUE];

/*
 * CLOSEs sent without waiting for the reply.  A listing closes its directory once it has read the last entry, and nothing after depends
 * on how the close went, so the request goes out and its reply is taken in by whichever exchange or poll meets it first.  A listing opens
 * its directory with every share mode, so the handle staying open a moment longer on the server stops nobody else.  With every slot
 * waiting, a close waits for its reply like any other request.
 */
#define SMB2_UNANSWERED_CLOSES 8

typedef struct {
  SMB2_Server *srv; // server the CLOSE went to; NULL when the slot is free
  uint64_t msg_id;  // message id its reply will carry
} SMB2_UnansweredClose;

static SMB2_UnansweredClose smb2_unanswered_closes[SMB2_UNANSWERED_CLOSES];

/*
 * What the most recent directory lookup learned about one path, so that the request which would fetch the same facts straight afterwards
 * need not be sent.  It is dropped the moment anything else goes to the server and at the start of every filing-system call, so it can
 * never describe a state the server has since moved on from.
 */
typedef struct {
  bool valid;
  bool present;               // false: the parent directory holds no entry of this name
  bool trusted_meta;          // the listing's time and attributes can stand in for opening the object
  SMB2_Share *share;          // share the path belongs to
  char path[SMB2_NAME_LIMIT]; // share-relative DOS path, no leading separator
  uint64_t write_time;        // last-write FILETIME from the listing
  uint64_t size;              // end-of-file from the listing
  uint32_t attr;              // FILE_ATTRIBUTE_* word from the listing
} SMB2_LookupResult;

static SMB2_LookupResult smb2_lookup;

/* Set by SMB2_LengthNotNeeded for the span of one filing-system call; see there. */
static bool smb2_length_not_needed;

/*
 * A directory listing left open between filing-system calls.  A caller reading a directory a few entries at a time would otherwise have
 * it rescanned from the start on every call; instead the open handle, the unread remainder of the last reply (still in smb2_dirbuf) and the
 * position reached are kept, and the next call carries straight on.  Nothing here is a copy of the directory: it is the server's own scan,
 * paused.  At most one is parked, and anything other than its continuation closes it.
 */
#define SMB2_LISTING_TAG_LIMIT 512  // longest caller tag a parked listing can be remembered under
#define SMB2_LISTING_IDLE_CS   500u // a parked listing no call has continued is closed after this long

typedef struct {
  bool parked;                      // a listing is paused here awaiting its continuation
  SMB2_Share *share;                // share the directory is on
  LMCacheWireState_t state;         // open directory handle and position within the reply held in smb2_dirbuf
  uint32_t next_index;              // number of entries delivered so far: the index the continuing call must quote
  uint32_t parked_at;               // LM_Tick() when it was parked, for the idle limit
  char dir_path[SMB2_NAME_LIMIT];   // DOS path of the directory; state.dir_path points here
  char tag[SMB2_LISTING_TAG_LIMIT]; // the caller's own name for the directory, matched exactly on resume
} SMB2_Listing;

static SMB2_Listing smb2_listing;

/* One directory entry as the server listed it, before any translation into RISC OS terms. */
typedef struct {
  uint64_t write_time;  // last-write FILETIME
  uint64_t size;        // end-of-file
  uint64_t alloc_size;  // space allocated to the file
  uint32_t attr;        // FILE_ATTRIBUTE_* word
  uint32_t reparse_tag; // what kind of reparse point the entry is, when attr says it is one
} SMB2_RawDirEntry;

/* What one scan of a directory for a single leafname found. */
typedef struct {
  SMB2_RawDirEntry raw;       // the matching entry's metadata, when there was a match
  char name[SMB2_NAME_LIMIT]; // the server's own spelling of the matching leafname
  bool hidden_match;          // an entry of that name exists but is hidden from view, so the name is neither usable nor free
} SMB2_LeafScan;

