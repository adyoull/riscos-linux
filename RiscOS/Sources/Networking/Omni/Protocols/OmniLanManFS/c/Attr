/* Attr.c - RISC OS file-type subsystem.
 *
 * On 8.3 shares the wire format has no place for RISC OS load/exec/type metadata, so we keep a
 * per-directory side-file called "RISCOS.EA" containing one record per leaf.  Reads and writes
 * here cache and update that file.
 *
 * On long-name shares the filetype is folded into the leaf's ",ttt" suffix and
 * Xlt_SplitLeafnameX2 handles encode/decode directly - the .EA mechanism is bypassed entirely.
 * Every external in this file therefore branches on SMB_IsLongNameFS() at the top, so on
 * long-name shares most of these functions are effectively no-ops.
 */

