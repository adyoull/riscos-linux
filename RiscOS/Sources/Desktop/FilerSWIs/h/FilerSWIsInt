/* This macro aligns a uint32_t up to the nearest 4-byte boundary */
#define U32_ROUND_UP(n) (((uint32_t)(n) + 3) & ~3)

#define DELETE 127
#define SPACE 32
#define MESSAGE_BLOCK_SIZE 256

#define FILER_ACTION_HEADER_SIZE (sizeof(uint32_t) * 2)
#define FILER_ACTION_OPERATION_INDEX 0
#define FILER_ACTION_OPTIONS_INDEX 1

