        GET     Hdr:ListOpts
        GET     Hdr:Macros
        GET     Hdr:System

        ; Call one of the installed territories

        EXPORT  subcall

        AREA    subcallasm, PIC, CODE

        ; _kernel_oserror *subcall(_kernel_swi_regs *r, void *fn, void *pw, uint32_t *flags)
subcall ROUT
        Push    "r4-r11, lr"
        MOV     r8, a4
        MOV     r12, a3
        MOV     r7, a2
        MOV     r6, a1
        LDMIA   r6, { r0-r5 }           ; Entries only use R0-R5 in/out max
        MOV     lr, pc
        MOV     pc, r7                  ; Call the fn
        SavePSR r7                      ; Grab the return flags in case we need them
        STMVCIA r6, { r0-r5 }           ; Out R0-R5
        MOVVC   a1, #0                  ; No error
        TEQ     r8, #0
        STRNE   r7, [r8]                ; Return flags too
        Pull    "r4-r11, pc"

        END
