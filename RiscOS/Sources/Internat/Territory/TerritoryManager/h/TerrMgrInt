#ifndef TERRMGRINT_H
#define TERRMGRINT_H

#define UNUSED(k)       (k)=(k)

/* This type can be used for territory or alphabet numbers. This number
 * space is rather full because there are over 200 countries in the world
 * yet there are some historical OS_Byte limitations (see Hdr:Countries).
 * Treat them internally as a signed quantity, with -1 meaning 'current'.
 */
typedef int tanumber_t;
#define CURRENT_TERRITORY -1

/* The list of loaded territories */
#define ENTRY_0TH_SWI   Territory_ReadTimeZones
#define ENTRY_POINTS    (Territory_DaylightRules - ENTRY_0TH_SWI + 1)
#include "sys/queue.h" /* For SLIST */
SLIST_HEAD(territorylist, territory);
typedef struct territory
{
	SLIST_ENTRY(territory) list;      /* Linked list */
	tanumber_t number;                /* Territory number */
	void      *pw;                    /* Module workspace */
	void      *entries[ENTRY_POINTS]; /* SWIs passed on */
} territory_t;

/* A return value to use internally to signal badness */
#define AN_ERROR        (_kernel_oserror *)-2

/* In support of the Squash module */
#define SQUASH_ID       0x48535153 /* "SQSH" */
typedef struct
{
	uint32_t id;
	uint32_t length;
	uint32_t load;
	uint32_t exec;
	uint32_t reserved;
} squashheader_t;

/* In support of the DrawFile module */
#ifndef DrawFile_Render
#define DrawFile_BBox   0x45541
#define DrawFile_Render 0x45540
#endif

/* Global variables */
extern int32_t     last_tzone_centis;
extern uint8_t     last_dst_bits;
extern tanumber_t  configured_territory;
extern void       *private_word;
extern char        message_custom[20];
extern struct territorylist territories;

extern void territory_selected(void);
extern _kernel_oserror *subcall(_kernel_swi_regs *, void *, void *, uint32_t *); /* In Subcall.s */
extern void *Resources(void); /* Generated by 'resgen' */

#endif
