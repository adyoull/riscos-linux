#ifndef TIME_H
#define TIME_H

typedef struct
{
	int centis;
	int secs;
	int mins;
	int hours; /* 0-23 */
	int day;   /* of month 1-31 */
	int month; /* 1-12 */
	int year;  /* verbatim */
} ordmin_t;

typedef struct
{
	int centis;
	int secs;
	int mins;
	int hours;     /* 0-23 */
	int day;       /* of month 1-31 */
	int month;     /* 1-12 */
	int year;      /* verbatim */
	int dayofweek; /* 1-7, with Sunday = 1 */
	int dayofyear; /* 1-366 */
} ordfull_t;

typedef union
{
	ordmin_t  min;
	ordfull_t full;
} ordinals_t;

/* Time factors to aid readability */
#define tickspersecond  100
#define ticksperminute  (tickspersecond * 60)
#define ticksperhour    (ticksperminute * 60)
#define ticksperday     (ticksperhour   * 24)
#define ticksperyear    (ticksperday    * 365)

/* Import a 40b time into a 64 bit variable */
#define IMPORT40b(v,b)  ((uint32_t *)&v)[1] = 0; /* Ensure top 24b clear */ \
                        memcpy(&v, b, 5) /* Import 40b from unknown alignment */

extern _kernel_oserror *time_setthehardway(const uint8_t *);
extern _kernel_oserror *time_set(const uint8_t *);
extern size_t which_timezone(int32_t *);
#define UNKNOWN_INDEX   (size_t)-1
extern bool time_configtimezone(const char *);
extern _kernel_oserror *time_currentzone(uint32_t, const char **, int32_t *, size_t *);
extern _kernel_oserror *time_convertformats(tanumber_t, void *, void *, uint32_t, size_t);
extern bool time_ordinals_40b(const ordmin_t *, uint8_t *);
extern void time_40b_ordinals(const uint8_t *, ordfull_t *);

#endif
