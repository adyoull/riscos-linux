/*!
 * \brief  Check the configured territory is loaded or prompt for it to be
 * \return Nothing
 */
static void load_the_territory(void)
{
	_kernel_oserror *err;
	const char *tfile, *mbase;
	territory_t *t;
	uint32_t     fsnumber;

	dprintf(("", "Post init service call received\n"));

	SLIST_FOREACH(t, &territories, list)
	{
		if (t->number == configured_territory)
		{
			return; /* Skip loading, it's already present */
		}
	}

	dprintf(("", "Configured territory %d not already loaded\n", configured_territory));

	fsnumber = fsnumber_none; /* In case of error */
	_swix(OS_Args, _INR(0,1) | _OUT(0), OSArgs_ReadPTR, 0, &fsnumber);
	fsnumber &= 0xFF; /* FileSwitch 1.70-2.74 return duff internal value 'Nowt' here */
	if (fsnumber == fsnumber_none)
	{
		/* If no selected filing system, go back to English! */
		configured_territory = TerritoryNum_UK;
		return;
	}
	dprintf(("", "Number of selected FS %u\n", fsnumber));

	if (fsnumber == fsnumber_net)
	{
		/* Special treament for NetFS */
		dprintf(("", "Logging on to Econet\n"));
		err = _swix(OS_CLI, _IN(0), "Logon Territory");
		tfile = "&.!Territory.Territory";
		mbase = "&.!Territory.Messages";
	}
	else
	{
		err = NULL;
		tfile = "$.!Territory.Territory";
		mbase = "$.!Territory.Messages";
	}
	while (1)
	{
		if (err != NULL)
		{
#ifndef EMBEDDED_UI
			uint32_t oldpointer, key, flags;

			if (show_prompt() != NULL)
			{
				break; /* Failed to show */
			}
			dprintf(("", "Waiting for user confirmation\n"));
			_swix(OS_Byte, _INR(0,1) | _OUT(1), OsByte_SelectPointer, 1,
			                                    &oldpointer);
			_swix(OS_Confirm, _OUT(0) | _OUT(_FLAGS), &key, &flags);
			_swix(OS_Byte, _INR(0,1), OsByte_SelectPointer, oldpointer);
			if (flags & _C)
			{
				dprintf(("", "Escape\n"));
				_swix(OS_Byte, _IN(0), OsByte_AcknowledgeEscape);
				break;
			}
			if ((flags & _Z) || (key == 13))
			{
				dprintf(("", "User confirms media inserted\n"));
				tfile = ":0.$.!Territory.Territory";
				mbase = ":0.$.!Territory.Messages";
			}
			else
			{
				dprintf(("", "User declined to insert media\n"));
				break;
			}
#else
			/* On NC/STB - no way should we be bringing up a media prompt.
			 * Instead, let's take the territory at the head of the
			 * chain (the most recently registered).
			 */
			t = SLIST_FIRST(&territories);
			configured_territory = t->number;
			return;
#endif
		}
		err = load_the_files(tfile, mbase);
		if (err == NULL) return; /* Success! */
	}

	/* Give up, clear the screen and fall back to UK */
	_swix(OS_WriteI + 4  /* Split cursor */, 0);
	_swix(OS_WriteI + 26 /* Default window */, 0);
	_swix(OS_WriteI + 12 /* CLS */, 0);
	configured_territory = TerritoryNum_UK;
}

/*!
 * \brief  Convert input text to a territory
 * \param  string Name or number to parse
 * \param  territory Territory number after conversion
 * \return Error block pointer
 */
static _kernel_oserror *parse_name_or_number(const char *string, uint32_t *territory)
{
	_kernel_oserror *err;
	uint32_t selected;
	const char *tail;

	/* Ask around if the name is recognised */
	err = _swix(Territory_NameToNumber, _INR(0,1) | _OUT(0),
	            -1, string, &selected);
	if (err != NULL) return err;
	if (selected == 0)
	{
		/* Allow numeric selection */
		err = _swix(OS_ReadUnsigned, _INR(0,1) | _OUTR(1,2),
		            0xC000000A, /* Base 10, check terminator, <= 255 */
		            string, &tail, &selected);
		if (err != NULL) return err;

		/* Check that nothing else follows */
		while (*tail == ' ') tail++; /* Skip trailing spaces */
		if (*tail > ' ') return configure_TOO_MANY_PARAMS;
	}
	*territory = selected;

	return NULL;
}

void territory_services(int service_number, _kernel_swi_regs *r, void *pw)
{
	switch (service_number)
	{
		case Service_UKConfig:
			/* Unknown option, is it configuring the time zone? */
			if (time_configtimezone((const char *)r->r[0]))
			{
				r->r[0] = -1; /* No error */
				r->r[1] = Service_Serviced;
			}
			break;

		case Service_PostInit:
			load_the_territory();

			/* By this stage the configured territory is in memory */
			territory_selected();
			break;

		case Service_UKWord:
			if (r->r[2] == OsWord_WriteRealTimeClock)
			{
				const uint8_t *block = (const uint8_t *)r->r[3];
				_kernel_oserror *err;

				if (block[0] == OWWriteRTC_5ByteInt)
				{
					/* Kernel didn't deal with OS_Word 15,5 so we will */
					err = time_setthehardway(block);
					if (err == NULL) r->r[1] = Service_Serviced;
				}
			}
			break;

		case Service_RTCSynchronised:
			/* Do an AutoDST check */
			daylight_switch_check();
			break;
	}
	UNUSED(pw);
}

_kernel_oserror *territory_commands(const char *arg_string, int argc, int cmd_no, void *pw)
{
	_kernel_oserror *err;
	territory_t *t;
	char    name[32];
	uint8_t andmask, eormask;

	switch (cmd_no)
	{
		case CMD_Territory:
			if (argc == 0)
			{
				/* Print current territory to screen */
				if (_swix(Territory_NumberToName, _INR(0,2),
				          configured_territory, name, sizeof(name)) != NULL)
				{
					/* No name given, show numeric */
					sprintf(name, "%u", configured_territory);
				}
				printf("%s\n", name);
			}
			else
			{
				uint32_t selected;

				err = parse_name_or_number(arg_string, &selected);
				if (err != NULL) return err;

				/* Set the territory */
				return _swix(Territory_Select, _IN(0), selected);
			}
			break;

		case CMD_Territories:
			/* Print numbers and names of loaded territories */
			SLIST_FOREACH(t, &territories, list)
			{
				if (_swix(Territory_NumberToName, _INR(0,2),
				          t->number, name, sizeof(name)) != NULL)
				{
					/* No name given, use default */
					messages_lookup("Unused", name, sizeof(name));
				}
				printf("%u %s\n", t->number, name);
			}
			break;

		case CMDCFG_Territory:
			if (arg_string == arg_STATUS)
			{
				uint32_t config;

				err = _swix(OS_Byte, _INR(0,1) | _OUT(2), OsByte_ReadCMOS,
				            TerritoryCMOS, &config);
				if (err != NULL) return err;
				printf("Territory  %u\n", config ^ 1);
			}
			else if (arg_string == arg_CONFIGURE_SYNTAX)
			{
				messages_writenl("CTSynt");
			}
			else
			{
				uint32_t selected;

				err = parse_name_or_number(arg_string, &selected);
				if (err != NULL) return err;

				/* Write the CMOS RAM! */
				return _swix(OS_Byte, _INR(0,2), OsByte_WriteCMOS,
				             TerritoryCMOS, selected ^ 1);
			}
			break;

		case CMD_NoDST:
			/* Manual 'off' implicitly clears the auto flag */
			andmask = 0, eormask = 0;
			goto set_dst_bits;

		case CMD_AutoDST:
			/* Leave the DST bit alone and set the auto bit */
			andmask = DSTCMOSBit, eormask = AutoDSTCMOSBit;
			goto set_dst_bits;

		case CMD_DST:
			if (arg_string == arg_STATUS)
			{
				uint32_t saving;

				saving = daylight_modify_cmos(DSTCMOSBit | AutoDSTCMOSBit, 0);
				printf("%sDST\n", (saving & AutoDSTCMOSBit) ? "Auto" :
				                  (saving & DSTCMOSBit) ? "" : "No");
			}
			else if (arg_string == arg_CONFIGURE_SYNTAX)
			{
				messages_writenl("CDSTSyn");
			}
			else
			{
				/* Manual 'on' implicitly clears the auto flag */
				andmask = 0, eormask = DSTCMOSBit;
			}
set_dst_bits:
			/* Shared handling of daylight saving update */
			if ((arg_string != arg_STATUS) && (arg_string != arg_CONFIGURE_SYNTAX))
			{
				daylight_modify_cmos(andmask, eormask);
				daylight_switch_check();
			}
			break;

		case CMD_TimeZone:
			if (arg_string == arg_STATUS)
			{
				int32_t offset;

				err = _swix(OS_Byte, _INR(0,1) | _OUT(2), OsByte_ReadCMOS,
				            TimeZoneCMOS, &offset);
				if (err != NULL) return err;

				/* Sign extend, units are quarter hours */
				offset = 15 * ((offset << 24) >> 24);
				printf("TimeZone   %+d:%02u\n", offset / 60, abs(offset % 60));
			}
			else if (arg_string == arg_CONFIGURE_SYNTAX)
			{
				messages_writenl("TZSynt");
			}
			else
			{
				bool negative = arg_string[0] == '-';
				const char *tail;
				int32_t offset, hours, mins = 0;

				if (negative || (arg_string[0] == '+')) arg_string++;

				/* Read hours 0-13 */
				err = _swix(OS_ReadUnsigned, _INR(0,2) | _OUTR(1,2),
				            0x2000000A, /* Base 10, <= R2 */
				            arg_string, 13, &tail, &hours);
				if (err != NULL) return err;

				if (*tail == ':')
				{
					/* Read minutes 0-59 */
					err = _swix(OS_ReadUnsigned, _INR(0,2) | _OUT(2),
					            0x2000000A, /* Base 10, <= R2 */
					            tail + 1, 59, &mins);
					if (err != NULL) return err;
				}

				/* Combine to signed quarter hours */
				offset = (hours << 2) | (mins / 15);
				if (negative) offset = -offset;

				/* Write out and reassess daylight saving */
				_swix(OS_Byte, _INR(0,2), OsByte_WriteCMOS,
				      TimeZoneCMOS, offset);
				daylight_switch_check();
			}
			break;
	}

	UNUSED(pw);

	return NULL;
}
