int32_t     last_tzone_centis;    /* To check for changes */
uint8_t     last_dst_bits;        /* To check for changes */
tanumber_t  configured_territory; /* Configured territory */
void       *private_word;         /* Copy of pw */
char        message_custom[20];   /* Cache of unknown timezone text */
struct territorylist territories; /* Head of list */

/*!
 * \brief  A new territory was selected
 * \return Nothing
 */
void territory_selected(void)
{
	/* Reassess the situation */
	daylight_switch_check();

	/* Announce the selection */
	_swix(OS_ServiceCall, _IN(1), Service_TerritoryStarted);
}

_kernel_oserror *tmloaded_callback_handler(_kernel_swi_regs *r, void *pw)
{
	_swix(OS_ServiceCall, _IN(1), Service_TerritoryManagerLoaded);
	dprintf(("", "Service call issued: TerritoryManager loaded\n"));

	UNUSED(r);
	UNUSED(pw);

	return NULL;
}

_kernel_oserror *territory_init(const char *cmd_tail, int podule_base, void *pw)
{
	static const char *const defaultpath = "Resources:$.Resources.TerrMgr.";
	uint32_t config;

	/* Initialise Territory path if not already done */
	if (osvarlen("TerritoryManager$Path", VarType_Expanded) == -1)
	{
		_swix(OS_SetVarVal, _INR(0,4), "TerritoryManager$Path",
		      defaultpath, strlen(defaultpath), 0, VarType_String);
	}

	/* Clear the territories list */
	SLIST_INIT(&territories);

	/* Set up tracing */
	debug_initialise(Module_Title, "Ram::0.$.TerrMgr", "");
	debug_set_device(FILE_OUTPUT);

	/* Read configured territory from CMOS */
	config = TerritoryNum_Default; /* In case of error */
	_swix(OS_Byte, _INR(0,1) | _OUT(2), OsByte_ReadCMOS, TerritoryCMOS, &config);
	static_assert((TerritoryNum_Default ^ 1) == TerritoryNum_UK, "UK should be 1");
	configured_territory = (tanumber_t)config ^ 1; /* Stored value has b0 toggled */
	dprintf(("", "Configured territory is %d\n", configured_territory));

	/* Important flags */
	last_tzone_centis = -1;
	last_dst_bits = -1; /* Ensures a service call */
	private_word = pw;

	/* Read the static string 'Custom' for Territory_ReadCurrentTimeZone */
	if (messages_lookup("Custom", message_custom, sizeof(message_custom)) == NULL)
	{
		strcpy(message_custom, "Custom"); /* Fallback to English */
	}

	/* Set a callback to issue the TerritoryManagerLoaded service call */
	_swix(OS_AddCallBack, _INR(0,1), tmloaded_callback, pw);

	UNUSED(podule_base);
	UNUSED(cmd_tail);

	return NULL;
}

_kernel_oserror *territory_final(int fatal, int podule, void *pw)
{
	territory_t *t;

	/* Cancel any pending DST switch */
	_swix(OS_RemoveTickerEvent, _INR(0,1), daylight_switchover, pw);

	/* Close the message file if open */
	messages_destroy();

	/* Free all module blocks */
	while (!SLIST_EMPTY(&territories))
	{
		t = SLIST_FIRST(&territories);
		SLIST_REMOVE_HEAD(&territories, list);
		free(t);
	}

	UNUSED(fatal);
	UNUSED(podule);

	return NULL; /* Don't refuse to die */
}

/*!
 * \brief  Load the territory module and any found messages modules
 * \param  tfile Where to look for the territory module
 * \param  mbase Directory to seek for messages modules
 * \return Error block pointer
 */
static _kernel_oserror *load_the_files(const char *tfile, const char *mbase)
{
	_kernel_oserror *err;
	territory_t *t;
	int32_t continuation;
	size_t  len, count;
	char    mfile[100];

	/* First load the territory module */
	dprintf(("", "Load territory from file %s\n", tfile));
	err = _swix(OS_Module, _INR(0,1), ModHandReason_Load, tfile);
	if (err != NULL) return err;

	/* Now load any messages modules */
	continuation = 0;
	len = sprintf(mfile, "%s.", mbase);
	do
	{
		err = _swix(OS_GBPB, _INR(0,6) | _OUTR(3,4), OSGBPB_ReadDirEntries,
		            mbase, &mfile[len], 1, continuation, sizeof(mfile), 0,
		            &count, &continuation);
		if (err != NULL) return err;
		if (count == 1)
		{
			dprintf(("", "Loading messages module %s\n", mfile));
			err = _swix(OS_Module, _INR(0,1), ModHandReason_Load, mfile);
			if (err != NULL) return err;
		}
	} while (continuation != -1);

	/* Modules loaded, now check that configured territory exists */
	SLIST_FOREACH(t, &territories, list)
	{
		if (t->number == configured_territory)
		{
			return NULL; /* Success! */
		}
	}
	dprintf(("", "Configured territory still isn't loaded!\n"));

	return AN_ERROR;
}

#ifndef EMBEDDED_UI

/*!
 * \brief  Display a language agnostic media insertion prompt
 * \return Error block pointer
 */
static _kernel_oserror *show_prompt(void)
{
	_kernel_oserror *err;
	const squashheader_t *header;
	size_t   squashwksp;
	uint32_t squashedsize, type;
	uint8_t *wksp, *input, *output = NULL;
	int32_t  drwwidth, drwheight, scrwidth, scrheight, scalex, scaley;
	struct
	{
		uint32_t xeig, yeig;
		uint32_t width, height;
		int32_t  end;
	} vdustate = { VduExt_XEigFactor, VduExt_YEigFactor,
	               VduExt_XWindLimit, VduExt_YWindLimit,
	               -1
	             };
	struct
	{
		int32_t bl_x, bl_y, tr_x, tr_y;
	} bbox;
	struct
	{
		int32_t a, b, c, d, e, f;
	} matrix;

	/* Find size of file and workspace needs */
	err = _swix(OS_File, _INR(0,1) | _IN(4) | _OUT(0) | _OUT(4), OSFile_ReadPath,
	            "Prompt", "TerritoryManager:", &type, &squashedsize);
	if (err == NULL)
	{
		if (type != object_file) return AN_ERROR;
		err = _swix(Squash_Decompress, _INR(0,1) | _OUT(0), 8, -1, &squashwksp);
	}
	if (err != NULL) return err;

	/* Allocate and load the squashed file */
	err = AN_ERROR;
	input = malloc(squashwksp + squashedsize);
	if (input != NULL)
	{
		wksp = input;
		header = (const squashheader_t *)(input + squashwksp);
		err = _swix(OS_File, _INR(0,4), OSFile_LoadPath,
		            "Prompt", header, 0, "TerritoryManager:");
	}
	if (err != NULL) goto failed;

	/* Allocate and decompress the Draw file */
	err = AN_ERROR;
	if (header->id == SQUASH_ID)
	{
		output = malloc(header->length);
		if (output != NULL)
		{
			err = _swix(Squash_Decompress, _INR(0,5), 4, wksp,
			            header + 1, squashedsize - sizeof(squashheader_t),
			            output, header->length);
		}
	}
	if (err != NULL) goto failed;

	dprintf(("", "Expanded squashed Prompt from %u to %u\n", squashedsize, header->length));

	/* Get screen parameters and draw bounding box */
	err = _swix(OS_ReadVduVariables, _INR(0,1), &vdustate, &vdustate);
	if (err == NULL)
	{
		err = _swix(DrawFile_BBox, _INR(0,4), 0, output, header->length, 0, &bbox);
	}
	if (err != NULL) goto failed;

	/* Clear screen */
	_swix(OS_WriteI + 4  /* Split cursor */, 0);
	_swix(OS_WriteI + 26 /* Default window */, 0);
	_swix(OS_WriteI + 20 /* Default colours */, 0);
	_swix(OS_SetColour, _INR(0,1), (1<<4) | (1<<6), 0); /* Black text background */
	_swix(OS_WriteI + 12 /* CLS */, 0);

	/* Work out scale to 7/8 fill the screen. The source image has been designed
	 * for a 4:3 aspect, so on a widescreen it'll get scaled to fill the entire
	 * height but be left justified, which is safe.
	 */
	drwwidth  = bbox.tr_x - bbox.bl_x;
	drwheight = bbox.tr_y - bbox.bl_y; /* Draw units */
	scrwidth  = (vdustate.width + 1) << vdustate.xeig;
	scrheight = (vdustate.height + 1) << vdustate.yeig; /* OS units */
	dprintf(("", "Screen %ux%u DrawFile is %ux%u OSU\n", scrwidth, scrheight,
	                                                     drwwidth >> 8, drwheight >> 8));
	scalex = ((7 * 256 * 32 * scrwidth) / drwwidth);
	scaley = ((7 * 256 * 32 * scrheight) / drwheight); /* 256x scaled */
	if (scalex > scaley) scalex = scaley;
	dprintf(("", "Lowest common scaling factor %d/256th's\n", scalex));

	/* Vertically centre and plot */
	matrix.a = scalex << 8; /* 16.16 */
	matrix.b = matrix.c = 0;
	matrix.d = scalex << 8; /* 16.16 */
	matrix.e = 0;
	matrix.f = ((scrheight << 8) - ((drwheight >> 8) * scalex)) / 2; /* Draw units */
	err = _swix(DrawFile_Render, _INR(0,4), 0, output, header->length, &matrix, 0);
failed:
	free(input);
	free(output);
	return err;
}

