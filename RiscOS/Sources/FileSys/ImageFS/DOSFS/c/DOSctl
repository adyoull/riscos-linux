#include "DOSFSHdr.h"
#include "MsgTrans.h"
#include "Ops.h"

#define CHECK_SPARE_STACK_SPACE do                                     \
                                {                                      \
                                  uintptr_t base, sp = __current_sp(); \
                                  base = (sp >> 20) << 20; /* MB */    \
                                  if ((sp - base) < 0x400)             \
                                  {                                    \
                                    return global_error(err_nostack);  \
                                  }                                    \
                                } while (0)
#define RETURN_RESULT           return ((int)result == -1) ? _syserr : NULL

/*!
 * \param  r Register set from FileSwitch
 * \param  pw Private word
 * \return Error pointer
 */
_kernel_oserror *dosctl_fsentry_open_handler(_kernel_swi_regs *r, void *pw)
{
  FS_open_block *result;

  CHECK_SPARE_STACK_SPACE;
  UNUSED(pw);

  result = DOSFS_open_file(r->r[0], (char *)r->r[1], (DOSdisc *)r->r[6]);
  if ((int)result != -1)
  {
    r->r[0] = result->information;
    r->r[1] = (int)result->inhand;
    r->r[2] = result->buffsize;
    r->r[3] = result->fileext;
    r->r[4] = result->falloc;
  }

  RETURN_RESULT;
}

/*!
 * \param  r Register set from FileSwitch
 * \param  pw Private word
 * \return Error pointer
 */
_kernel_oserror *dosctl_fsentry_close_handler(_kernel_swi_regs *r, void *pw)
{
  int result;

  CHECK_SPARE_STACK_SPACE;
  UNUSED(pw);

  result = DOSFS_close_file((FILEhand *)r->r[1], r->r[2], r->r[3]);

  RETURN_RESULT;
}

