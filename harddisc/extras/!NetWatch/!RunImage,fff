REM >!RunImage
REM NetWatch: Linux brings the network up (rol-netd), and a wired link or
REM Wi-Fi can come up long after RISC OS has started, so RISC OS's
REM Resolver would have no name servers. This background task reads
REM Linux's network status (IXFS:$.riscos.net.status) every 5 seconds and,
REM when the name servers change, sets Inet$Resolvers and runs
REM *ResolverConfig so that the Resolver uses them. When Linux's address
REM changes (or there is one when it starts), it tells RISC OS's network
REM modules (Service_InternetStatus 0, "address changed", as RISC OS's own
REM network stack does), so Freeway (ShareFS's and Access's discovery)
REM finds the network that came up after RISC OS started. DHCP's domain
REM name goes in Inet$LocalDomain, as RISC OS's own DHCP puts it there:
REM the Resolver adds it to a name it can't find, and with none it adds
REM "localhost", which name servers answer with 127.0.0.1.
REM ShareFS starts its desktop task (the Discs icon) only if Freeway is
REM running when the desktop starts; with the network up later (a fast
REM start, a manual address, Wi-Fi) it never appeared. So once the network
REM is up, NetWatch starts it (*Desktop_ShareFSFiler) if it isn't running,
REM for half a minute after the address changes, as ShareFS can take a
REM moment to see the network.
REM Copyright (c) 2026 Andrew Youll. MIT licence.
ON ERROR SYS "XWimp_CloseDown" : END
DIM blk% 256, msgs% 4, stat% 1024, tl% 512 : msgs%!0=0
SYS "Wimp_Initialise",310,&4B534154,"NetWatch",msgs% TO ,task%
SYS "XOS_ReadVarVal","Inet$Resolvers",blk%,255,0,3 TO ,,len%;f%
IF f% AND 1 THEN cur$="" ELSE blk%?len%=13 : cur$=$blk%
addr$="?" : dom$="?" : share%=0
PROCcheck
REPEAT
  SYS "OS_ReadMonotonicTime" TO now%
  REM (null events wanted: bit 0 of the mask clear)
  SYS "Wimp_PollIdle",&3830,blk%,now%+500 TO reason%
  CASE reason% OF
    WHEN 0 : PROCcheck
    WHEN 17,18 : IF blk%!16=0 THEN SYS "Wimp_CloseDown" : END
  ENDCASE
UNTIL FALSE

DEF PROCcheck
REM the status file in one read (a few hundred bytes), not a byte at a time
LOCAL f%,n%,i%,j%,l$,dns$,a$,d$,new%
f%=OPENIN("IXFS:$.riscos.net.status")
IF f%=0 THEN ENDPROC
SYS "OS_GBPB",4,f%,stat%,1023 TO ,,,n%
CLOSE#f%
n%=1023-n% : stat%?n%=10
dns$="" : i%=0
WHILE i%<n%
  j%=i% : WHILE stat%?j%<>10 : j%+=1 : ENDWHILE
  stat%?j%=13 : l$=$(stat%+i%) : stat%?j%=10
  IF LEFT$(l$,4)="dns=" THEN dns$=MID$(l$,5)
  IF LEFT$(l$,8)="address=" THEN a$=MID$(l$,9)
  IF LEFT$(l$,7)="domain=" THEN d$=MID$(l$,8)
  i%=j%+1
ENDWHILE
IF dns$<>"" AND dns$<>cur$ THEN
  cur$=dns$
  OSCLI "Set Inet$Resolvers "+dns$
  new%=TRUE
ENDIF
REM (left alone until Linux has an address: a domain only comes with one;
REM one taken away by a later lease is taken away here too)
IF a$<>"" AND d$<>dom$ THEN
  IF d$<>"" THEN OSCLI "Set Inet$LocalDomain "+d$ ELSE IF dom$<>"?" THEN SYS "XOS_CLI","Unset Inet$LocalDomain"
  dom$=d$
  new%=TRUE
ENDIF
IF new% THEN SYS "XOS_CLI","ResolverConfig"
IF a$<>addr$ THEN
  addr$=a$
  IF a$<>"" THEN SYS "XOS_ServiceCall",0,&B0 : share%=7
ENDIF
REM (not on the first check after the address: ShareFS may be starting)
IF share%>0 THEN
  share%-=1
  IF share%<6 THEN PROCsharefs
ENDIF
ENDPROC

REM ShareFS's desktop task started, if ShareFS is there and it isn't running
DEF PROCsharefs
LOCAL f%,r%,e%,p%,q%,n$
SYS "XOS_Module",18,"ShareFS" TO ;f%
IF f% AND 1 THEN share%=0 : ENDPROC
r%=0
REPEAT
  SYS "XTaskManager_EnumerateTasks",r%,tl%,512 TO r%,e% ;f%
  IF f% AND 1 THEN ENDPROC
  p%=tl%
  WHILE p%<e%
    q%=p%!4 : n$=""
    WHILE q%?0>=32 AND LEN(n$)<20 : n$+=CHR$(q%?0) : q%+=1 : ENDWHILE
    IF n$="ShareFS" THEN share%=0 : ENDPROC
    p%+=16
  ENDWHILE
UNTIL r%<0
REM (an error: ShareFS hasn't seen the network yet; tried again in 5 s)
SYS "XWimp_StartTask","Desktop_ShareFSFiler" TO ;f%
IF (f% AND 1)=0 THEN share%=0
ENDPROC
