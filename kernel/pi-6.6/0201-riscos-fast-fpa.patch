+#ifdef CONFIG_COMPAT
+/*
+ * RISC OS on Linux's fast FPA entry (PR_RISCOS_UND, as its fast SWI entry
+ * in syscall.c). Old RISC OS programs use the FPA's floating point
+ * instructions (coprocessors 1 and 2), which no ARMv8 processor has: each
+ * is an undefined instruction that RISC OS's FPEmulator carries out. A
+ * task can ask for these to go straight to a handler of its own, with the
+ * registers written on its signal stack as for a SIGILL (r1 a siginfo, r2
+ * a ucontext with r0-r15 and the CPSR from +32), but without the signal
+ * delivery, the FP state and the sigreturn. One whose condition fails is
+ * skipped here (some processors trap those too). Other undefined
+ * instructions, and Thumb ones, are signalled as before. exec forgets it.
+ */
+static bool riscos_und(struct pt_regs *regs, u32 insn)
+{
+	struct thread_struct *t = &current->thread;
+	u32 pc = regs->pc, cp = (insn >> 8) & 15, f[29];
+	unsigned long sp, vcpu;
+	u8 vc = 0;
+	int i;
+
+	if (!compat_user_mode(regs) || compat_thumb_mode(regs))
+		return false;
+	/* LDC/STC (cond 110x), CDP/MRC/MCR (cond 1110) to coprocessor 1 or 2 */
+	if ((insn >> 28) == 15 || (insn & 0x0c000000) != 0x0c000000 ||
+	    (insn & 0x0f000000) == 0x0f000000 || (cp != 1 && cp != 2))
+		return false;
+	if (!aarch32_opcode_cond_checks[insn >> 28](regs->pstate)) {
+		arm64_skip_faulting_instruction(regs, 4);
+		return true;
+	}
+	/* RISC OS's virtual CPU (its block is the TLS value; byte 13 is the
+	   virtual CPSR's control byte): IRQs off, as an undefined instruction
+	   exception does, before the handler runs, so an interrupt signal
+	   reaching it is deferred by the port's handler instead of being taken
+	   while the handler still needs this frame and the mode's banked r13
+	   and r14. The old byte goes to the handler (si_errno). */
+	vcpu = (u32)t->uw.tp_value;
+	if (vcpu && get_user(vc, (u8 __user *)(vcpu + 13))) {
+		force_sig(SIGSEGV);
+		return true;
+	}
+	sp = regs->compat_sp;
+	if (current->sas_ss_size && !on_sig_stack(sp))
+		sp = current->sas_ss_sp + current->sas_ss_size;
+	sp = (sp - sizeof(f)) & ~7UL;
+	memset(f, 0, sizeof(f));
+	f[0] = SIGILL;				/* siginfo: si_signo */
+	f[1] = vc;				/* si_errno: the old CPSR byte */
+	f[2] = ILL_ILLOPC;			/* si_code */
+	f[3] = pc;				/* si_addr */
+	for (i = 0; i < 15; i++)		/* ucontext (+16): r0-r14 */
+		f[12 + i] = regs->regs[i];
+	f[27] = pc;
+	f[28] = pstate_to_compat_psr(regs->pstate);
+	if (copy_to_user((void __user *)sp, f, sizeof(f))) {
+		force_sig(SIGSEGV);
+		return true;
+	}
+	if (vcpu && put_user(vc | 0x80, (u8 __user *)(vcpu + 13))) {
+		force_sig(SIGSEGV);
+		return true;
+	}
+	regs->regs[0] = SIGILL;
+	regs->regs[1] = sp;
+	regs->regs[2] = sp + 16;
+	regs->compat_sp = sp;
+	regs->pc = t->riscos_und_handler;
+	regs->pstate &= ~(PSR_AA32_T_BIT | PSR_AA32_IT_MASK);
+	return true;
+}
+
+long riscos_und_prctl(unsigned long handler);
+
+long riscos_und_prctl(unsigned long handler)
+{
+	if (!is_compat_task() || handler >> 32 || handler & 3)
+		return -EINVAL;
+	current->thread.riscos_und_handler = handler;
+	return 0;
+}
+#endif
+
 void do_el0_undef(struct pt_regs *regs, unsigned long esr)
 {
 	u32 insn;
@@ -462,6 +545,11 @@ void do_el0_undef(struct pt_regs *regs, unsigned long esr)
 	if (user_insn_read(regs, &insn))
 		goto out_err;
 
+#ifdef CONFIG_COMPAT
+	if (unlikely(current->thread.riscos_und_handler) && riscos_und(regs, insn))
+		return;
+#endif
+
 	if (try_emulate_mrs(regs, insn))
 		return;
 
