@@ -141,8 +144,71 @@ void do_el0_svc(struct pt_regs *regs)
 }
 
 #ifdef CONFIG_COMPAT
+/*
+ * RISC OS on Linux's fast SWI entry.
+ *
+ * RISC OS (Timothy Baldwin's Linux port, as a 32-bit program) makes its
+ * own SWIs with SVC; a seccomp filter turns every SVC but its Linux
+ * system call gateway's into SIGSYS, and its SIGSYS handler enters the
+ * RISC OS kernel (never returning through sigreturn). A task can ask
+ * (prctl PR_RISCOS_SWI, handler, gateway) for those SVCs to go to the
+ * handler straight from here instead: with the registers it reads (r1 a
+ * siginfo with si_call_addr at +12, r2 a ucontext with r0-r15 and the
+ * CPSR from +32) written on its signal stack, as a SIGSYS from seccomp
+ * would be, but without seccomp, the signal delivery and the FP state.
+ * The gateway's SVCs (and the vectors page's) stay Linux system calls.
+ * The signal mask isn't touched (the port's handler has SA_NODEFER and an
+ * empty mask). exec forgets it; fork and clone keep it.
+ */
+static bool riscos_swi(struct pt_regs *regs)
+{
+	struct thread_struct *t = &current->thread;
+	u32 pc = regs->pc, f[29];
+	unsigned long sp;
+	int i;
+
+	if (pc == t->riscos_swi_gateway || pc - 0xffff0000u < 0x1000u)
+		return false;
+	sp = regs->compat_sp;
+	if (current->sas_ss_size && !on_sig_stack(sp))
+		sp = current->sas_ss_sp + current->sas_ss_size;
+	sp = (sp - sizeof(f)) & ~7UL;
+	memset(f, 0, sizeof(f));
+	f[0] = SIGSYS;				/* siginfo: si_signo */
+	f[3] = pc;				/* si_call_addr */
+	for (i = 0; i < 15; i++)		/* ucontext (+16): r0-r14 */
+		f[12 + i] = regs->regs[i];
+	f[27] = pc;
+	f[28] = pstate_to_compat_psr(regs->pstate);
+	regs->syscallno = NO_SYSCALL;
+	if (copy_to_user((void __user *)sp, f, sizeof(f))) {
+		force_sig(SIGSEGV);
+		return true;
+	}
+	regs->regs[0] = SIGSYS;
+	regs->regs[1] = sp;
+	regs->regs[2] = sp + 16;
+	regs->compat_sp = sp;
+	regs->pc = t->riscos_swi_handler;
+	regs->pstate &= ~(PSR_AA32_T_BIT | PSR_AA32_IT_MASK);
+	return true;
+}
+
+long riscos_swi_prctl(unsigned long handler, unsigned long gateway);
+
+long riscos_swi_prctl(unsigned long handler, unsigned long gateway)
+{
+	if (!is_compat_task() || handler >> 32 || gateway >> 32 || handler & 3)
+		return -EINVAL;
+	current->thread.riscos_swi_gateway = gateway;
+	current->thread.riscos_swi_handler = handler;
+	return 0;
+}
+
 void do_el0_svc_compat(struct pt_regs *regs)
 {
+	if (unlikely(current->thread.riscos_swi_handler) && riscos_swi(regs))
+		return;
 	el0_svc_common(regs, regs->regs[7], __NR_compat32_syscalls,
 		       compat_sys_call_table);
 }
