From adcc8f0bcfd65e86a2aeb51647cb21fe702e0ae2 Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Wed, 21 Oct 2026 12:37:11 +0100
Subject: [PATCH] arm64: dts: qcom: sc8280xp-blackrock: use the UEFI RTC offset

The SDAM offset is only written by Linux, so on a Windows Dev Kit 2023
that has only run Windows the clock reads 1970. Use the offset Windows
and the firmware keep in the RTCInfo UEFI variable instead, as the
ThinkPad X13s does.

---
 arch/arm64/boot/dts/qcom/sc8280xp-microsoft-blackrock.dts | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-microsoft-blackrock.dts b/arch/arm64/boot/dts/qcom/sc8280xp-microsoft-blackrock.dts
index 125af356..058db802 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-microsoft-blackrock.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-microsoft-blackrock.dts
@@ -763,8 +763,10 @@ &pmk8280_pon_resin {
 };
 
 &pmk8280_rtc {
-	nvmem-cells = <&rtc_offset>;
-	nvmem-cell-names = "offset";
+	/* the time Windows and the firmware keep (as the ThinkPad X13s does):
+	   the SDAM offset is only ever written by Linux, so it reads 1970 on a
+	   machine that has only run Windows */
+	qcom,uefi-rtc-info;
 
 	status = "okay";
 };
-- 
2.43.0

