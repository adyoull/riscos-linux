+/* the 3-regs-different-lengths ops, sizes 8 and 16 */
+static bool rol_long_3d(DisasContext *s, arg_3diff *a, int op, bool sgn)
+{
+    bool wide = op == ROLN_ADDW || op == ROLN_SUBW;
+
+    if (!arm_dc_feature(s, ARM_FEATURE_NEON)) {
+        return false;
+    }
+    if (!dc_isar_feature(aa32_simd_r32, s) &&
+        ((a->vd | a->vn | a->vm) & 0x10)) {
+        return false;
+    }
+    if ((a->vd & 1) || (wide && (a->vn & 1))) {
+        return false;
+    }
+    if (!vfp_access_check(s)) {
+        return true;
+    }
+    if (roln_long(op, a->size, sgn, a->vd, a->vn, a->vm)) {
+        return true;
+    }
+    gen_helper_rol_long(rol_reg_ptr(a->vd), rol_reg_ptr(a->vn),
+                        rol_reg_ptr(a->vm),
+                        tcg_constant_i32(op | a->size << 4 | sgn << 6));
+    return true;
+}
