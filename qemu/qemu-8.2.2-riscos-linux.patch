+#define ROL_LONG_OPS(TN, TW, N, TS)                                        \
+    switch (op) {                                                          \
+    case ROLN_ADDL: ROL_LONG(TN, TW, N, a + b); break;                     \
+    case ROLN_SUBL: ROL_LONG(TN, TW, N, a - b); break;                     \
+    case ROLN_ADDW: ROL_LONG(TN, TW, N, w + b); break;                     \
+    case ROLN_SUBW: ROL_LONG(TN, TW, N, w - b); break;                     \
+    case ROLN_ABDL: ROL_LONG(TN, TW, N, (TS)a > (TS)b ? a - b : b - a); break; \
+    case ROLN_ABAL: ROL_LONG(TN, TW, N, d + ((TS)a > (TS)b ? a - b : b - a)); break; \
+    case ROLN_MULL: ROL_LONG(TN, TW, N, a * b); break;                     \
+    case ROLN_MLAL: ROL_LONG(TN, TW, N, d + a * b); break;                 \
+    case ROLN_MLSL: ROL_LONG(TN, TW, N, d - a * b); break;                 \
