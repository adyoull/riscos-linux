+    sp = env->regs[13] - 24;
+    if (put_user_u32(env->regs[0], sp) || put_user_u32(env->regs[1], sp + 4) ||
+        put_user_u32(env->regs[2], sp + 8) || put_user_u32(env->regs[3], sp + 12) ||
+        put_user_u32(env->regs[12], sp + 16) || put_user_u32(env->regs[14], sp + 20)) {
+        return false;
+    }
+    env->regs[13] = sp;
+    env->regs[1] = r1;
+    env->regs[14] = pc;          /* the routine returns to lr + 4 */
+    env->regs[15] = entry;
+    return true;
+}
+
+/*
+ * The rest of the privileged instructions such code uses, emulated with
+ * the port's virtual CPU block (TLS value; its layout from the port's
+ * LinuxDefs: +13 CPSR control byte, +16 r13/r14/SPSR of SVC, +28 USR,
+ * +40 IRQ, +52 FIQ, +64 UND, +76 ABT; the current mode's r13 and r14 are
+ * the real registers), as the port's PVirt routines do:
+ *   MRS Rd, SPSR / MSR SPSR_<f>, ...    the current mode's SPSR
+ *   STM Rn, {...}^ / LDM Rn, {...}^     with the USR r13, r14
+ *   LDM Rn, {..., pc}^, MOVS pc, lr,    exception return: through the
+ *   SUBS/ADDS pc, Rn, #imm              port's LoadUsrRegisters routine
+ * These are UNDEF in Linux user mode anyway, so they reach here.
+ */
+extern uint32_t riscos_own_lo, riscos_own_hi;
+extern uint32_t riscos_emul_lo[16], riscos_emul_hi[16];
+extern int riscos_emul_n;
+bool riscos_pc_emulated(uint32_t pc);
+#define RISCOS_LOADUSRREGISTERS 0x2080071c      /* mov r9, lr; bl GetVCPU */
+
+static abi_ulong riscos_bank(unsigned mode)
+{
+    switch (mode & 0x1f) {
+    case 0x10: case 0x1f: return 28;
+    case 0x11: return 52;
+    case 0x12: return 40;
+    case 0x17: return 76;
+    case 0x1b: return 64;
+    default: return 16;
+    }
+}
+
+static bool riscos_exception_return(CPUARMState *env, abi_ulong vcpu, unsigned vmode,
+                                    const uint32_t *r, uint32_t newpc)
+{
+    /* r[0..14]: the registers in the current mode after the instruction */
+    uint32_t w, spsr, usr13, usr14;
+    abi_ulong blk;
+    abi_ulong b = vcpu + riscos_bank(vmode);
+    if (get_user_u32(w, RISCOS_LOADUSRREGISTERS) || w != 0xe1a0900e ||
+        get_user_u32(spsr, b + 8) || get_user_u32(usr13, vcpu + 28) ||
+        get_user_u32(usr14, vcpu + 32)) {
+        return false;
+    }
+    blk = ((r[13] < env->regs[13] ? r[13] : env->regs[13]) - 256) & ~7u;
+    for (int i = 0; i < 13; i++) {
+        if (put_user_u32(r[i], blk + 4 * i)) {
+            return false;
+        }
+    }
+    /* Returning to Thumb code (an abort or interrupt taken in it): the
+       routine can't set CPSR.T, but it loads pc with an interworking
+       load, so bit 0 of the address makes it Thumb. */
+    if (spsr & 0x20) {
+        newpc |= 1;
+    }
+    if (put_user_u32(usr13, blk + 52) || put_user_u32(usr14, blk + 56) ||
+        put_user_u32(newpc, blk + 60)) {
+        return false;
+    }
+    env->regs[1] = blk;
+    env->regs[2] = r[13];               /* the current mode's sp, to keep */
+    env->regs[3] = spsr & ~0x20u;       /* new CPSR (never Thumb) */
+    env->regs[14] = r[14];              /* the current mode's lr, to keep */
+    env->regs[13] = blk;                /* scratch stack, below the block */
+    env->regs[15] = RISCOS_LOADUSRREGISTERS;
+    return true;
+}
+
+/* The last data abort's address and status, for MRC p15 c6 and c5
+   (abort handlers read them: ARMEABISupport 1.08's does). */
+static uint32_t riscos_last_dfar, riscos_last_dfsr;
+
+static bool riscos_emulate_priv(CPUARMState *env, uint32_t insn)
+{
+    abi_ulong pc = env->regs[15], vcpu = cpu_get_tls(env);
+    uint8_t vmode;
+    unsigned mode;
+    uint32_t r[15];
+
+    if (env->thumb || !vcpu || !riscos_pc_emulated(pc) ||
+        get_user_u8(vmode, vcpu + 13)) {
+        return false;
+    }
+    mode = vmode & 0x1f;
+    if (mode == 0x10) {
+        return false;                   /* USR mode: really undefined */
+    }
+    abi_ulong bank = vcpu + riscos_bank(mode);
+    for (int i = 0; i < 15; i++) {
+        r[i] = env->regs[i];
+    }
+
+    if ((insn & 0x0f000f10) == 0x0e000f10) {            /* MRC/MCR p15 */
+        /* System control: what privileged code reads and writes here is
+           mostly SCTLR (alignment checking on or off: kept, but QEMU's
+           alignment doesn't change), the CPU's ID, and cache and TLB
+           maintenance (nothing to do in user mode emulation). */
+        static uint32_t sctlr = 0x00c5187d;             /* MMU, caches on; A off */
+        unsigned rt = (insn >> 12) & 15, crn = (insn >> 16) & 15, crm = insn & 15;
+        unsigned op1 = (insn >> 21) & 7, op2 = (insn >> 5) & 7;
+        if (rt == 15) {
+            return false;
+        }
+        if (insn & (1u << 20)) {                        /* MRC */
+            uint32_t v = 0;
+            if (crn == 1 && crm == 0 && op1 == 0 && op2 == 0) {
+                v = sctlr;
+            } else if (crn == 0 && crm == 0 && op1 == 0 && op2 == 0) {
+                v = ARM_CPU(env_cpu(env))->midr;
+            } else if (crn == 0 && crm == 0 && op1 == 0 && op2 == 1) {
+                v = ARM_CPU(env_cpu(env))->ctr;
+            } else if (crn == 0 && crm == 0 && op1 == 0 && op2 == 5) {
+                v = 0x80000000;                         /* MPIDR: CPU 0 */
+            } else if (crn == 6 && crm == 0 && op1 == 0 && op2 == 0) {
+                v = riscos_last_dfar;                   /* DFAR */
+            } else if (crn == 5 && crm == 0 && op1 == 0 && op2 == 0) {
+                v = riscos_last_dfsr;                   /* DFSR */
+            }
+            env->regs[rt] = v;
+        } else if (crn == 1 && crm == 0 && op1 == 0 && op2 == 0) {
+            sctlr = env->regs[rt];
+        }
+        env->regs[15] = pc + 4;
+        return true;
+    }
+    if ((insn & 0x0fff0fff) == 0x014f0000) {            /* MRS Rd, SPSR */
+        unsigned rd = (insn >> 12) & 15;
+        uint32_t v;
+        if (rd == 15 || get_user_u32(v, bank + 8)) {
+            return false;
+        }
+        env->regs[rd] = v;
+        env->regs[15] = pc + 4;
+        return true;
+    }
+    if ((insn & 0x0ff0fff0) == 0x0160f000 ||            /* MSR SPSR_<f>, Rm */
+        (insn & 0x0ff0f000) == 0x0360f000) {            /* MSR SPSR_<f>, #imm */
+        uint32_t val = insn & (1u << 25) ? ror32(insn & 0xff, ((insn >> 8) & 15) * 2)
+                                         : env->regs[insn & 15];
+        uint32_t mask = 0, old;
+        for (int f = 0; f < 4; f++) {
+            if (insn & (1u << (16 + f))) {
+                mask |= 0xffu << (8 * f);
+            }
+        }
+        if (get_user_u32(old, bank + 8) || put_user_u32((old & ~mask) | (val & mask), bank + 8)) {
+            return false;
+        }
+        env->regs[15] = pc + 4;
+        return true;
+    }
+    if ((insn & 0x0e400000) == 0x08400000) {            /* LDM/STM with ^ */
+        bool load = insn & (1u << 20), wb = insn & (1u << 21);
+        bool up = insn & (1u << 23), pre = insn & (1u << 24);
+        unsigned rn = (insn >> 16) & 15, list = insn & 0xffff, n = ctpop16(list);
+        bool user_bank = !(load && (list & 0x8000));
+        bool other_bank = user_bank && mode != 0x1f;
+        abi_ulong base = env->regs[rn], addr;
+        uint32_t newpc = 0;
+        if (rn == 15 || n == 0) {
+            return false;
+        }
+        addr = up ? base + (pre ? 4 : 0) : base - 4 * n + (pre ? 0 : 4);
+        for (int i = 0; i < 16; i++) {
+            if (!(list & (1u << i))) {
+                continue;
+            }
+            if (load) {
+                uint32_t v;
+                if (get_user_u32(v, addr)) {
+                    return false;
+                }
+                if (i == 15) {
+                    newpc = v;
+                } else if (other_bank && (i == 13 || i == 14)) {
+                    if (put_user_u32(v, vcpu + 28 + (i - 13) * 4)) {
+                        return false;
+                    }
+                } else {
+                    r[i] = v;
+                }
+            } else {
+                uint32_t v;
+                if (i == 15) {
+                    v = pc + 8;
+                } else if (other_bank && (i == 13 || i == 14)) {
+                    if (get_user_u32(v, vcpu + 28 + (i - 13) * 4)) {
+                        return false;
+                    }
+                } else {
+                    v = env->regs[i];
+                }
+                if (put_user_u32(v, addr)) {
+                    return false;
+                }
+            }
+            addr += 4;
+        }
+        if (wb && !(load && (list & (1u << rn)))) {
+            r[rn] = up ? base + 4 * n : base - 4 * n;
+        }
+        if (load && (list & 0x8000)) {
+            return riscos_exception_return(env, vcpu, mode, r, newpc);
+        }
+        for (int i = 0; i < 15; i++) {
+            env->regs[i] = r[i];
+        }
+        env->regs[15] = pc + 4;
+        return true;
+    }
+    if ((insn & 0x0c10f000) == 0x0010f000) {            /* <op>S pc, ... */
+        unsigned op = (insn >> 21) & 15, rn = (insn >> 16) & 15;
+        uint32_t op2, a, res;
+        if (insn & (1u << 25)) {
+            op2 = ror32(insn & 0xff, ((insn >> 8) & 15) * 2);
+        } else if ((insn & 0xff0) == 0) {
+            op2 = (insn & 15) == 15 ? pc + 8 : env->regs[insn & 15];
+        } else {
+            return false;
+        }
+        a = rn == 15 ? pc + 8 : env->regs[rn];
+        switch (op) {
+        case 13: res = op2; break;          /* MOVS */
+        case 2: res = a - op2; break;       /* SUBS */
+        case 4: res = a + op2; break;       /* ADDS */
+        default: return false;
+        }
+        return riscos_exception_return(env, vcpu, mode, r, res);
+    }
+    return false;
+}
+
+/*
+ * RISC OS for Linux: physically mapped (PMP) dynamic areas, for
+ * ARMEABISupport's page allocators (SOManager's shared library data). The
+ * port has no physical pages, so the module asks QEMU (SWI &C0002, from
+ * outside the port's ROM) to back an ordinary dynamic area's address range
+ * with a memfd: "physical" page P is the memfd's page P, and mapping it at
+ * logical page L is an mmap of that file page there. OS_DynamicArea 22
+ * (PMP map/unmap) on such an area is done here; other SWIs go to RISC OS.
+ *
+ * Data aborts in such an area go first to the abort handlers the module
+ * registered (ARMEABISupport_AbortOp, how SOManager maps a library's data
+ * in for the task touching it): the handler runs with r1 = the fault
+ * address, r11 = the registers at the abort, r12 = its data and returns
+ * (to SWI &C0003) r0 = 1 to retry the access, 0 to pass it on.
+ *
+ * SWI &C0002, r0 = operation:
+ *   0  add area: r1 DA number, r2 base, r3 size in pages -> r0 0 or -errno
+ *   1  remove area: r1 DA number
+ *   2  map: r1 DA, r2 logical page, r3 physical page, r4 count
+ *   3  unmap: r1 DA, r2 logical page, r3 count
+ *   4  release (free the memory of) physical pages: r1 DA, r2 page, r3 count
+ *   5  add abort handler: r1 routine, r2 r12 value, r3 17-word register
+ *      block, r4 address of a SWI &C0003 (the return)
+ *   6  remove abort handler: r1 routine, r2 r12 value
+ */
+#define RISCOS_PMP_MAX 16
+#define RISCOS_ABH_MAX 16
+static struct riscos_pmp {
+    int da, fd;
+    abi_ulong base;
+    uint32_t pages;
+} riscos_pmp[RISCOS_PMP_MAX];
+static struct riscos_abh {
+    abi_ulong routine, r12;
+} riscos_abh[RISCOS_ABH_MAX];
+static abi_ulong riscos_abh_regs, riscos_abh_return;
+static int riscos_abh_active = -1;     /* handler running, or -1 */
+static uint32_t riscos_abh_saved[16], riscos_abh_cpsr;
+static abi_ulong riscos_abh_fault;
+static int riscos_abh_signo, riscos_abh_code;
+
+static struct riscos_pmp *riscos_pmp_find(int da)
+{
+    for (int i = 0; i < RISCOS_PMP_MAX; i++) {
+        if (riscos_pmp[i].fd > 0 && riscos_pmp[i].da == da) {
+            return &riscos_pmp[i];
+        }
+    }
+    return NULL;
+}
+
+static struct riscos_pmp *riscos_pmp_at(abi_ulong addr)
+{
+    for (int i = 0; i < RISCOS_PMP_MAX; i++) {
+        if (riscos_pmp[i].fd > 0 && addr >= riscos_pmp[i].base &&
+            addr - riscos_pmp[i].base < (abi_ulong)riscos_pmp[i].pages << 12) {
+            return &riscos_pmp[i];
+        }
+    }
+    return NULL;
+}
+
+static int riscos_pmp_unmap(struct riscos_pmp *p, uint32_t l, uint32_t n)
+{
+    if (l >= p->pages || n > p->pages - l) {
+        return -EINVAL;
+    }
+    abi_ulong a = p->base + (l << 12);
+    abi_long r = target_mmap(a, n << 12, PROT_NONE,
+                             MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    return r == (abi_long)a ? 0 : -EINVAL;  /* (addresses can look negative) */
+}
+
+static int riscos_pmp_map(struct riscos_pmp *p, uint32_t l, uint32_t ph,
+                          uint32_t n)
+{
+    if (l >= p->pages || n > p->pages - l || ph >= p->pages ||
+        n > p->pages - ph) {
+        return -EINVAL;
+    }
+    abi_ulong a = p->base + (l << 12);
+    abi_long r = target_mmap(a, n << 12, PROT_READ | PROT_WRITE | PROT_EXEC,
+                             MAP_SHARED | MAP_FIXED, p->fd, (off_t)ph << 12);
+    return r == (abi_long)a ? 0 : -ENOMEM;  /* (addresses can look negative) */
+}
+
+static int riscos_pmp_op(CPUARMState *env)
+{
+    uint32_t *r = env->regs;
+    struct riscos_pmp *p;
+
+    switch (r[0]) {
+    case 0:
+        if (riscos_pmp_find(r[1]) || (r[2] & 0xfff) || !r[3]) {
+            return -EINVAL;
+        }
+        for (int i = 0; i < RISCOS_PMP_MAX; i++) {
+            if (riscos_pmp[i].fd <= 0) {
+                int fd = memfd_create("RISC OS PMP", MFD_CLOEXEC);
+                if (fd < 0) {
+                    return -errno;
+                }
+                if (ftruncate(fd, (off_t)r[3] << 12) < 0) {
+                    close(fd);
+                    return -errno;
+                }
+                riscos_pmp[i] = (struct riscos_pmp){ r[1], fd, r[2], r[3] };
+                return 0;
+            }
+        }
+        return -ENOSPC;
+    case 1:
+        p = riscos_pmp_find(r[1]);
+        if (!p) {
+            return -ENOENT;
+        }
+        riscos_pmp_unmap(p, 0, p->pages);
+        close(p->fd);
+        p->fd = 0;
+        return 0;
+    case 2:
+        p = riscos_pmp_find(r[1]);
+        return p ? riscos_pmp_map(p, r[2], r[3], r[4]) : -ENOENT;
+    case 3:
+        p = riscos_pmp_find(r[1]);
+        return p ? riscos_pmp_unmap(p, r[2], r[3]) : -ENOENT;
+    case 4:
+        p = riscos_pmp_find(r[1]);
+        if (!p) {
+            return -ENOENT;
+        }
+        if (r[2] >= p->pages || r[3] > p->pages - r[2]) {
+            return -EINVAL;
+        }
+        return fallocate(p->fd, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE,
+                         (off_t)r[2] << 12, (off_t)r[3] << 12) < 0 ? -errno : 0;
+    case 5:
+        for (int i = 0; i < RISCOS_ABH_MAX; i++) {
+            if (!riscos_abh[i].routine) {
+                riscos_abh[i].routine = r[1];
+                riscos_abh[i].r12 = r[2];
+                riscos_abh_regs = r[3];
+                riscos_abh_return = r[4];
+                return 0;
+            }
+        }
+        return -ENOSPC;
+    case 6:
+        for (int i = 0; i < RISCOS_ABH_MAX; i++) {
+            if (riscos_abh[i].routine == r[1] && riscos_abh[i].r12 == r[2]) {
+                riscos_abh[i].routine = 0;
+                return 0;
+            }
+        }
+        return -ENOENT;
+    }
+    return -ENOSYS;
+}
+
+/* OS_DynamicArea 22 on a PMP area: r2 -> entries {logical page, physical
+ * page or -1 to unmap, flags}, r3 count; exit r2 past them, r3 = 0. */
+static bool riscos_pmp_da22(CPUARMState *env)
+{
+    struct riscos_pmp *p = riscos_pmp_find(env->regs[1]);
+    if (!p) {
+        return false;
+    }
+    while (env->regs[3]) {
+        uint32_t l, ph;
+        if (get_user_u32(l, env->regs[2]) ||
+            get_user_u32(ph, env->regs[2] + 4)) {
+            break;
+        }
+        if (ph == 0xffffffff) {
+            riscos_pmp_unmap(p, l, 1);
+        } else {
+            riscos_pmp_map(p, l, ph, 1);
+        }
+        env->regs[2] += 12;
+        env->regs[3]--;
+    }
+    env->VF = 0;
+    return true;
+}
+
+/* Call the next abort handler from 'from', or end the dispatch. */
+static void riscos_abh_next(CPUARMState *env, int from)
+{
+    for (int i = from; i < RISCOS_ABH_MAX; i++) {
+        if (riscos_abh[i].routine) {
+            riscos_abh_active = i;
+            env->regs[1] = riscos_abh_fault;
+            env->regs[11] = riscos_abh_regs;
+            env->regs[12] = riscos_abh[i].r12;
+            env->regs[14] = riscos_abh_return;
+            env->regs[15] = riscos_abh[i].routine & ~3;
+            env->thumb = 0;
+            return;
+        }
+    }
+    /* Nobody claimed it: the abort goes to RISC OS after all. */
+    riscos_abh_active = -1;
+    memcpy(env->regs, riscos_abh_saved, sizeof(riscos_abh_saved));
+    cpsr_write(env, riscos_abh_cpsr, CPSR_USER | CPSR_EXEC, CPSRWriteByInstr);
+    force_sig_fault(riscos_abh_signo, riscos_abh_code, riscos_abh_fault);
+}
+
+static bool riscos_abh_start(CPUARMState *env, int signo, int code,
+                             abi_ulong addr)
+{
+    if (riscos_abh_active >= 0 || !riscos_abh_regs || !riscos_pmp_at(addr)) {
+        return false;
+    }
+    memcpy(riscos_abh_saved, env->regs, sizeof(riscos_abh_saved));
+    riscos_abh_cpsr = cpsr_read(env);
+    for (int i = 0; i < 16; i++) {
+        put_user_u32(env->regs[i], riscos_abh_regs + 4 * i);
+    }
+    put_user_u32(riscos_abh_cpsr, riscos_abh_regs + 64);
+    riscos_abh_fault = addr;
+    riscos_abh_signo = signo;
+    riscos_abh_code = code;
+    riscos_abh_next(env, 0);
+    return true;
+}
+
+/* SWI &C0003: an abort handler returned. */
+static void riscos_abh_return_swi(CPUARMState *env)
+{
+    if (riscos_abh_active < 0) {
+        return;
+    }
+    if ((env->regs[0] & 0xff) == 1) {
+        riscos_abh_active = -1;
+        memcpy(env->regs, riscos_abh_saved, sizeof(riscos_abh_saved));
+        cpsr_write(env, riscos_abh_cpsr, CPSR_USER | CPSR_EXEC,
+                   CPSRWriteByInstr);
+        return;
+    }
+    riscos_abh_next(env, riscos_abh_active + 1);
+}
+
+/*
+ * RISC OS for Linux: physical memory pool (PMP) dynamic areas. The port's
+ * kernel creates PMP areas (OS_DynamicArea 0, flag bit 20) but its
+ * DynArea_PMP_PhysOp, _LogOp, _Resize and _GetPages are stubs that print
+ * their name and stop on an undefined instruction. GCCSDK's ARMEABISupport
+ * 1.08 needs them, so they're done here: breakpoints on the stubs (found
+ * by their names in the ROM), the operation done on a memfd that holds the
+ * pool's pages (pool page n = file page n, given a made-up physical page
+ * number when it's claimed), and a return to the caller (lr). The area's
+ * base and size come from its kernel node (found in the system heap), and
+ * the node's size and pool size are kept up to date for OS_DynamicArea 24.
+ */
+#define KPMP_MAX 64
+#define KPMP_PHYS_BASE 0x00400000u      /* made-up physical page numbers */
+static struct riscos_kpmp {
+    int da;
+    abi_ulong node, base;
+    uint32_t lpages, pmax, claimed, mapped;
+    int fd;
+    int32_t *phys;                      /* per pool page: phys page or -1 */
+    int32_t *log;                       /* per pool page: DA page or -1 */
+    int32_t *pool;                      /* per DA page: pool page or -1 */
+    uint32_t *flags;                    /* per pool page: page flags */
+} riscos_kpmp[KPMP_MAX];
+static abi_ulong riscos_kpmp_stub[4];   /* PhysOp, LogOp, Resize, GetPages */
+static abi_ulong riscos_kpmp_err;       /* a "BadParm" error block */
+static uint32_t riscos_kpmp_nextphys = KPMP_PHYS_BASE;
+
+#define DANODE_NUMBER 4
+#define DANODE_BASE 8
+#define DANODE_FLAGS 12
+#define DANODE_SIZE 16
+#define DANODE_MAXSIZE 20
+#define DANODE_TITLE 32
+#define DANODE_PMPSIZE 52
+#define DANODE_PMPMAXSIZE 56
+#define SYSHEAP_BASE 0x20C00000u
+
+/* Find the stubs in the ROM [lo, hi): "push {lr}; bl debug; name\r\n..." */
+static void riscos_kpmp_init(CPUARMState *env, abi_ulong lo, abi_ulong hi)
+{
+    static const char *const names[4] = {
+        "DynArea_PMP_PhysOp\r\n", "DynArea_PMP_LogOp\r\n",
+        "DynArea_PMP_Resize\r\n", "DynArea_PMP_GetPages\r\n",
+    };
+    static const char bad[] = "\xea\x01\x00\x00" "BadParm";
+    if (getenv("RISCOS_NO_PMP")) {
+        return;
+    }
+    char *rom = g_malloc0(hi - lo);
+    for (abi_ulong a = 0; a < hi - lo; a += 4096) {
+        if (copy_from_user(rom + a, lo + a, 4096)) {
+            memset(rom + a, 0, 4096);
+        }
+    }
+    for (int n = 0; n < 4; n++) {
+        size_t len = strlen(names[n]);
+        for (abi_ulong a = 8; a + len <= hi - lo; a += 4) {
+            if (!memcmp(rom + a, names[n], len) &&
+                ldl_le_p(rom + a - 8) == 0xe52de004) {     /* push {lr} */
+                riscos_kpmp_stub[n] = lo + a - 8;
+                break;
+            }
+        }
+    }
+    for (abi_ulong a = 0; a + sizeof bad <= hi - lo; a += 4) {
+        if (!memcmp(rom + a, bad, sizeof bad)) {
+            riscos_kpmp_err = lo + a;
+            break;
+        }
+    }
+    g_free(rom);
+    if (getenv("RISCOS_PMP_DEBUG")) {
+        fprintf(stderr, "riscos: ROM %08x-%08x, PMP stubs %08x %08x %08x %08x,"
+                " error %08x\n", lo, hi, riscos_kpmp_stub[0],
+                riscos_kpmp_stub[1], riscos_kpmp_stub[2], riscos_kpmp_stub[3],
+                riscos_kpmp_err);
+    }
+    /* trapped when translated (target/arm/tcg/translate.c), not as
+       breakpoints: any breakpoint slows every jump between blocks */
+    for (int n = 0; n < 4; n++) {
+        riscos_stub_pc[n] = riscos_kpmp_stub[n] ? riscos_kpmp_stub[n]
+                                                : 0xffffffffu;
+    }
+    if (riscos_kpmp_stub[0] || riscos_kpmp_stub[1]) {
+        tb_flush(env_cpu(env));
+    }
+}
+
+/*
+ * The ROM modules whose MSR/MRS/CPS are emulated as disc code's are
+ * (RISCOS_PSR_ROM_MODULES, a comma-separated list of titles; "" for none):
+ * by default the sound modules, which the port never used (it has no
+ * sound) and which still change mode with plain MSRs, which Linux ignores.
+ * Found in the ROM's module chain (each module preceded by its length + 4).
+ */
+static void riscos_rom_modules_init(CPUARMState *env, abi_ulong lo, abi_ulong hi)
+{
+    const char *list = getenv("RISCOS_PSR_ROM_MODULES");
+    if (!list) {
+        list = "SoundDMA,SoundChannels,SoundScheduler,StringLib,Percussion";
+    }
+    if (!*list) {
+        return;
+    }
+    size_t n = hi - lo;
+    uint8_t *rom = g_malloc0(n);
+    for (abi_ulong a = 0; a < n; a += 4096) {
+        if (copy_from_user(rom + a, lo + a, 4096)) {
+            memset(rom + a, 0, 4096);
+        }
+    }
+    for (size_t p = 0; p + 8 < n && !riscos_emul_n; p += 4) {
+        size_t q = p;
+        int count = 0;
+        while (q + 64 <= n) {
+            uint32_t len = ldl_le_p(rom + q);
+            if (len <= 32 || len >= 0x100000 || (len & 3) || q + len > n) {
+                break;
+            }
+            uint32_t t = ldl_le_p(rom + q + 4 + 16);
+            if (t == 0 || t >= len - 4) {
+                break;
+            }
+            const char *title = (const char *)rom + q + 4 + t;
+            size_t tl = strnlen(title, 32);
+            if (!tl || tl == 32) {
+                break;
+            }
+            /* a listed title? */
+            const char *l = list;
+            while (*l) {
+                size_t ll = strcspn(l, ",");
+                if (ll == tl && !memcmp(l, title, tl) &&
+                    riscos_emul_n < 16) {
+                    riscos_emul_lo[riscos_emul_n] = lo + q + 4;
+                    riscos_emul_hi[riscos_emul_n] = lo + q + len;
+                    riscos_emul_n++;
+                }
+                l += ll + (l[ll] == ',');
+            }
+            count++;
+            q += len;
+        }
+        if (count < 30 || ldl_le_p(rom + q) != 0) {
+            riscos_emul_n = 0;      /* not the chain: keep looking */
+        } else if (!riscos_emul_n) {
+            break;                  /* the chain, but none listed */
+        }
+    }
+    g_free(rom);
+    if (getenv("RISCOS_PSR_DEBUG")) {
+        for (int i = 0; i < riscos_emul_n; i++) {
+            fprintf(stderr, "riscos: PSR emulation in ROM %08x-%08x\n",
+                    riscos_emul_lo[i], riscos_emul_hi[i]);
+        }
+    }
+    if (riscos_emul_n) {
+        tb_flush(env_cpu(env));
+    }
+}
+
+static uint32_t kpmp_rd(abi_ulong a)
+{
+    uint32_t v = 0;
+    get_user_u32(v, a);
+    return v;
+}
+
+static void kpmp_free(struct riscos_kpmp *p)
+{
+    if (p->fd > 0) {
+        close(p->fd);
+    }
+    g_free(p->phys);
+    g_free(p->log);
+    g_free(p->pool);
+    g_free(p->flags);
+    memset(p, 0, sizeof *p);
+}
+
+/* The kernel node of PMP area 'da', or 0. */
+static abi_ulong kpmp_find_node(int da)
+{
+    for (abi_ulong n = SYSHEAP_BASE; n < SYSHEAP_BASE + (16u << 20); n += 4) {
+        uint32_t w[15];
+        if (copy_from_user(w, n, sizeof w)) {
+            break;
+        }
+        if (w[1] == (uint32_t)da && (w[3] & (1u << 20)) && w[2] &&
+            !(w[2] & 0xfff) && w[5] && !(w[5] & 0xfff) && w[8]) {
+            return n;
+        }
+    }
+    return 0;
+}
+
+static struct riscos_kpmp *kpmp_get(int da)
+{
+    struct riscos_kpmp *p, *spare = NULL;
+    for (int i = 0; i < KPMP_MAX; i++) {
+        p = &riscos_kpmp[i];
+        if (!p->node) {
+            if (!spare) {
+                spare = p;
+            }
+            continue;
+        }
+        if (p->da != da) {
+            continue;
+        }
+        /* still the same area? (numbers are reused) */
+        if (kpmp_rd(p->node + DANODE_NUMBER) == (uint32_t)da &&
+            kpmp_rd(p->node + DANODE_BASE) == p->base &&
+            (kpmp_rd(p->node + DANODE_FLAGS) & (1u << 20))) {
+            return p;
+        }
+        kpmp_free(p);
+        if (!spare) {
+            spare = p;
+        }
+    }
+    if (!spare) {
+        return NULL;
+    }
+    abi_ulong node = kpmp_find_node(da);
+    if (!node) {
+        return NULL;
+    }
+    p = spare;
+    p->da = da;
+    p->node = node;
+    p->base = kpmp_rd(node + DANODE_BASE);
+    p->lpages = kpmp_rd(node + DANODE_MAXSIZE) >> 12;
+    p->pmax = kpmp_rd(node + DANODE_PMPMAXSIZE);
+    p->fd = memfd_create("RISC OS PMP", MFD_CLOEXEC);
+    if (p->fd < 0 || ftruncate(p->fd, (off_t)p->pmax << 12) < 0) {
+        kpmp_free(p);
+        return NULL;
+    }
+    p->phys = g_new(int32_t, p->pmax ? p->pmax : 1);
+    p->log = g_new(int32_t, p->pmax ? p->pmax : 1);
+    p->pool = g_new(int32_t, p->lpages ? p->lpages : 1);
+    p->flags = g_new0(uint32_t, p->pmax ? p->pmax : 1);
+    memset(p->phys, 0xff, sizeof(int32_t) * (p->pmax ? p->pmax : 1));
+    memset(p->log, 0xff, sizeof(int32_t) * (p->pmax ? p->pmax : 1));
+    memset(p->pool, 0xff, sizeof(int32_t) * (p->lpages ? p->lpages : 1));
+    if (getenv("RISCOS_PMP_DEBUG")) {
+        fprintf(stderr, "riscos: PMP area %d at %08x, %u pages, pool %u\n",
+                da, p->base, p->lpages, p->pmax);
+    }
+    return p;
+}
+
+static void kpmp_sync(struct riscos_kpmp *p)
+{
+    /* The port checks addresses in an area against base + size (it has
+       no sparse areas): give the whole area, or it refuses addresses in
+       pages mapped above the first 'mapped' pages (sprites plotted from
+       them, for one). RISCOS_PMP_TRUESIZE gives the mapped size. */
+    static int truesize = -1;
+    if (truesize < 0) {
+        truesize = getenv("RISCOS_PMP_TRUESIZE") != NULL;
+    }
+    put_user_u32((truesize ? p->mapped : p->lpages) << 12,
+                 p->node + DANODE_SIZE);
+    put_user_u32(p->claimed, p->node + DANODE_PMPSIZE);
+    put_user_u32(p->pmax, p->node + DANODE_PMPMAXSIZE);
+}
+
+static bool riscos_pmp_debug2(void);
+
+/*
+ * IOC (&3200000): AcornSSL reads timer 0 for entropy (STRB to the latch
+ * command register &4C, LDRB of the count at &40/&44), as on an Archimedes
+ * or RiscPC. The port has no IOC: the access faults. Emulate those
+ * registers here: timer 0 counting down at 2 MHz from 19999 (100 Hz), as
+ * RISC OS programs it. Returns true if the instruction was done.
+ */
+bool riscos_emulate_ioc(void *cpu_env, abi_ulong addr);
+bool riscos_emulate_ioc(void *cpu_env, abi_ulong addr)
+{
+    CPUARMState *env = cpu_env;
+    static uint32_t latched;
+    uint32_t insn;
+    if (addr < 0x03200000 || addr >= 0x03201000 || env->thumb ||
+        get_user_code_u32(insn, env->regs[15], env)) {
+        return false;
+    }
+    /* LDR/STR(B) immediate, pre-indexed, no write-back */
+    if ((insn & 0x0f200000) != 0x05000000) {
+        return false;
+    }
+    if ((insn >> 28) != 0xe) {
+        return false;
+    }
+    int rd = (insn >> 12) & 15, rn = (insn >> 16) & 15;
+    uint32_t off = insn & 0xfff;
+    uint32_t a = env->regs[rn] + ((insn & (1u << 23)) ? off : -off);
+    bool load = insn & (1u << 20), byte = insn & (1u << 22);
+    if (rd == 15 || rn == 15 || a != addr) {
+        return false;
+    }
+    uint32_t reg = a & 0xff;
+    if (!load) {
+        if (reg == 0x4c) {                      /* timer 0 latch command */
+            struct timespec ts;
+            clock_gettime(CLOCK_MONOTONIC, &ts);
+            uint64_t ticks = (uint64_t)ts.tv_sec * 2000000 + ts.tv_nsec / 500;
+            latched = 19999 - (uint32_t)(ticks % 20000);
+        }
+    } else {
+        uint32_t v = 0;
+        if (reg == 0x40) {
+            v = latched & 0xff;
+        } else if (reg == 0x44) {
+            v = (latched >> 8) & 0xff;
+        }
+        env->regs[rd] = byte ? v : v;
+    }
+    env->regs[15] += 4;
+    return true;
+}
+
+/* A fault signal is being delivered: its address is the DFAR (signal.c). */
+void riscos_note_fault_addr(abi_ulong addr);
+void riscos_note_fault_addr(abi_ulong addr)
+{
+    riscos_last_dfar = addr;
+}
+
+/*
+ * A signal frame couldn't be written to the guest stack (signal.c): for
+ * the RISC OS port that is a data abort at the first page of the frame
+ * that isn't writable, which is what DFAR must say to an abort handler
+ * that maps pages on demand (ARMEABISupport 1.08's stacks).
+ */
+void riscos_sigframe_fault(int sig, abi_ulong addr, abi_ulong size);
+void riscos_sigframe_fault(int sig, abi_ulong addr, abi_ulong size)
+{
+    abi_ulong a = addr;
+    while (a < addr + size &&
+           page_check_range(a, 1, PAGE_WRITE)) {
+        a = (a | (TARGET_PAGE_SIZE - 1)) + 1;
+    }
+    if (a >= addr + size) {
+        a = addr;
+    }
+    riscos_last_dfar = a;
+    riscos_last_dfsr = 0x80f;                  /* write, permission */
+    if (riscos_pmp_debug2()) {
+        fprintf(stderr, "riscos: signal %d frame at %08x+%x not writable at"
+                " %08x\n", sig, (uint32_t)addr, (unsigned)size, (uint32_t)a);
+    }
+}
+
+static bool riscos_pmp_debug2(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char *s = getenv("RISCOS_PMP_DEBUG");
+        v = s && atoi(s) >= 2;
+    }
+    return v;
+}
+
+static void kpmp_unmap_log(struct riscos_kpmp *p, uint32_t l)
+{
+    int32_t q = p->pool[l];
+    if (q < 0) {
+        return;
+    }
+    target_mmap(p->base + (l << 12), 4096, PROT_NONE,
+                MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    p->pool[l] = -1;
+    p->log[q] = -1;
+    p->mapped--;
+}
+
+static bool kpmp_physop(struct riscos_kpmp *p, uint32_t *e)
+{
+    uint32_t q = e[0];
+    if (riscos_pmp_debug2()) {
+        fprintf(stderr, "riscos: PhysOp area %d pool %u phys %08x flags %x (had %d)\n",
+                p->da, q, e[1], e[2], q < p->pmax ? p->phys[q] : -9);
+    }
+    if (q >= p->pmax) {
+        return false;
+    }
+    if (e[1] == 0xffffffff) {               /* release */
+        if (p->phys[q] >= 0) {
+            if (p->log[q] >= 0) {
+                kpmp_unmap_log(p, p->log[q]);
+            }
+            fallocate(p->fd, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE,
+                      (off_t)q << 12, 4096);
+            p->phys[q] = -1;
+            p->flags[q] = 0;
+            p->claimed--;
+        }
+    } else if (p->phys[q] < 0) {            /* claim (-2: any page) */
+        if (e[1] != 0xfffffffe && getenv("RISCOS_PMP_DEBUG")) {
+            fprintf(stderr, "riscos: PMP area %d page %u claims phys %08x\n",
+                    p->da, q, e[1]);
+        }
+        p->phys[q] = e[1] == 0xfffffffe ? riscos_kpmp_nextphys++ : e[1];
+        p->flags[q] = e[2];
+        p->claimed++;
+        if (e[2] && getenv("RISCOS_PMP_DEBUG")) {
+            static uint32_t seenp[16];
+            for (int i = 0; i < 16; i++) {
+                if (seenp[i] == e[2]) {
+                    break;
+                }
+                if (!seenp[i]) {
+                    seenp[i] = e[2];
+                    fprintf(stderr, "riscos: PMP area %d claims with flags"
+                            " %08x\n", p->da, e[2]);
+                    break;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static bool kpmp_logop(struct riscos_kpmp *p, uint32_t *e)
+{
+    uint32_t l = e[0], q = e[1];
+    if (riscos_pmp_debug2()) {
+        fprintf(stderr, "riscos: LogOp area %d page %u (%08x) pool %d flags %x\n",
+                p->da, l, p->base + (l << 12), (int)q, e[2]);
+    }
+    if (getenv("RISCOS_PMP_DEBUG") && (l >= p->lpages ||
+        (q != 0xffffffff && (q >= p->pmax || p->phys[q] < 0)))) {
+        fprintf(stderr, "riscos: PMP area %d LogOp page %u pool %u flags %x:"
+                " lpages %u pmax %u claimed %d\n", p->da, l, q, e[2],
+                p->lpages, p->pmax, q < p->pmax ? p->phys[q] : -9);
+    }
+    if (l >= p->lpages) {
+        return false;
+    }
+    if (q == 0xffffffff) {
+        kpmp_unmap_log(p, l);
+        return true;
+    }
+    if (q >= p->pmax || p->phys[q] < 0) {
+        return false;
+    }
+    if (p->pool[l] == (int32_t)q) {
+        return true;
+    }
+    if (p->log[q] >= 0) {
+        kpmp_unmap_log(p, p->log[q]);
+    }
+    kpmp_unmap_log(p, l);
+    int prot = (e[2] & (1u << 15)) ? PROT_NONE
+               : PROT_READ | PROT_WRITE | PROT_EXEC;
+    abi_long mr = target_mmap(p->base + (l << 12), 4096, prot,
+                              MAP_SHARED | MAP_FIXED, p->fd, (off_t)q << 12);
+    if (mr != (abi_long)(p->base + (l << 12))) {   /* not "< 0": high addresses */
+        if (getenv("RISCOS_PMP_DEBUG")) {
+            fprintf(stderr, "riscos: PMP area %d mmap at %08x failed: %d\n",
+                    p->da, p->base + (l << 12), (int)mr);
+        }
+        return false;
+    }
+    p->pool[l] = q;
+    p->log[q] = l;
+    p->flags[q] = e[2];
+    p->mapped++;
+    if (getenv("RISCOS_PMP_DEBUG") && e[2] != 0) {
+        static uint32_t seen[16];
+        for (int i = 0; i < 16; i++) {
+            if (seen[i] == e[2]) {
+                break;
+            }
+            if (!seen[i]) {
+                seen[i] = e[2];
+                fprintf(stderr, "riscos: PMP area %d maps with flags %08x\n",
+                        p->da, e[2]);
+                break;
+            }
+        }
+    }
+    return true;
+}
+
+static bool kpmp_resize(struct riscos_kpmp *p, int32_t change, uint32_t *done)
+{
+    int64_t n = (int64_t)p->pmax + change;
+    if (n < 0) {
+        n = 0;
+    }
+    /* can't drop claimed pages */
+    while (n < p->pmax && p->phys[p->pmax - 1] < 0 && p->pmax > n) {
+        p->pmax--;
+    }
+    if (n > p->pmax) {
+        uint32_t old = p->pmax;
+        if (ftruncate(p->fd, (off_t)n << 12) < 0) {
+            return false;
+        }
+        p->phys = g_renew(int32_t, p->phys, n);
+        p->log = g_renew(int32_t, p->log, n);
+        p->flags = g_renew(uint32_t, p->flags, n);
+        for (uint32_t i = old; i < n; i++) {
+            p->phys[i] = p->log[i] = -1;
+            p->flags[i] = 0;
+        }
+        p->pmax = n;
+        *done = n - old;
+    } else {
+        *done = 0;
+    }
+    return true;
+}
+
+static void kpmp_getpages(struct riscos_kpmp *p, uint32_t *e)
+{
+    int32_t q = -1;
+    if (e[0] != 0xffffffff) {
+        q = e[0] < p->pmax ? (int32_t)e[0] : -1;
+    } else if (e[2] != 0xffffffff) {
+        q = e[2] < p->lpages ? p->pool[e[2]] : -1;
+    } else if (e[1] != 0xffffffff) {
+        for (uint32_t i = 0; i < p->pmax; i++) {
+            if (p->phys[i] == (int32_t)e[1]) {
+                q = i;
+                break;
+            }
+        }
+    }
+    if (q < 0 || p->phys[q] < 0) {
+        if (q >= 0) {
+            e[0] = q;
+            e[1] = 0xffffffff;
+            e[2] = 0xffffffff;
+        }
+        e[3] = 0;
+        return;
+    }
+    e[0] = q;
+    e[1] = p->phys[q];
+    e[2] = p->log[q];
+    /* the kernel's CAM flags: the area's, plus the page's own */
+    e[3] = (kpmp_rd(p->node + DANODE_FLAGS) & 0xff) | (1u << 20);
+    if (getenv("RISCOS_PMP_FLAGS")) {
+        e[3] |= p->flags[q];
+    }
+}
+
+/* A breakpoint: one of the stubs? Then do it and return to the caller. */
+static bool riscos_kpmp_stub_hit(CPUARMState *env)
+{
+    int op;
+    for (op = 0; op < 4; op++) {
+        if (riscos_kpmp_stub[op] && env->regs[15] == riscos_kpmp_stub[op]) {
+            break;
+        }
+    }
+    if (op == 4) {
+        return false;
+    }
+    uint32_t *r = env->regs;
+    struct riscos_kpmp *p = kpmp_get(r[1]);
+    bool ok = p != NULL;
+    if (ok && op == 2) {
+        uint32_t done = 0;
+        ok = kpmp_resize(p, (int32_t)r[2], &done);
+        r[2] = done;
+    } else if (ok) {
+        int size = op == 3 ? 16 : 12;
+        uint32_t r2 = r[2], r3 = r[3];
+        while (r[3]) {
+            uint32_t e[4];
+            if (copy_from_user(e, r[2], size)) {
+                ok = false;
+                break;
+            }
+            if (op == 3) {
+                kpmp_getpages(p, e);
+                copy_to_user(r[2], e, 16);
+                r[2] += 16;
+                r[3]--;
+                continue;
+            }
+            if (!(op == 0 ? kpmp_physop(p, e) : kpmp_logop(p, e))) {
+                ok = false;
+                break;
+            }
+            r[2] += 12;
+            r[3]--;
+        }
+        if (op == 3) {                  /* GetPages: r2, r3 preserved */
+            r[2] = r2;
+            r[3] = r3;
+        }
+    }
+    if (p) {
+        kpmp_sync(p);
+    }
+    if (getenv("RISCOS_PMP_DEBUG")) {
+        fprintf(stderr, "riscos: PMP op %d area %d: %s\n", op, (int)r[1],
+                ok ? "ok" : "error");
+    }
+    if (ok) {
+        env->VF = 0;
+    } else {
+        r[0] = riscos_kpmp_err;
+        env->VF = 1u << 31;
+    }
+    env->regs[15] = env->regs[14];
+    return true;
+}
+
+/*
+ * OS_Memory 0 (convert addresses), for application space: the port has no
+ * physical pages and refuses it, but ARMEABISupport 1.08 tells programs
+ * apart by the "physical address" of the page at &8000. Each Wimp task's
+ * application space is its own file mapped at &8000, so the made-up
+ * address comes from that file (its device and inode), plus the offset.
+ */
+extern unsigned riscos_mmap_gen;
+
+static uint32_t riscos_app_phys(abi_ulong addr)
+{
+    static struct { dev_t dev; ino_t ino; } ids[256];
+    static int nids;
+    static unsigned cached_gen = ~0u;
+    static abi_ulong cached_page;
+    static uint32_t cached;
+    static int nocache = -1;
+    if (nocache < 0) {
+        nocache = getenv("RISCOS_NO_APPCACHE") != NULL;
+    }
+    if (!nocache && cached_gen == riscos_mmap_gen &&
+        cached_page == (addr & ~0xfffu)) {
+        return cached | (addr & 0xfff);
+    }
+    unsigned long h = (unsigned long)g2h_untagged(addr);
+    FILE *f = fopen("/proc/self/maps", "r");
+    char line[512];
+    unsigned long lo, hi, off, ino;
+    unsigned maj, min;
+    uint32_t id = 0;
+    while (f && fgets(line, sizeof line, f)) {
+        if (sscanf(line, "%lx-%lx %*s %lx %x:%x %lu", &lo, &hi, &off, &maj,
+                   &min, &ino) == 6 && h >= lo && h < hi) {
+            dev_t dev = makedev(maj, min);
+            int i;
+            for (i = 0; i < nids; i++) {
+                if (ids[i].dev == dev && ids[i].ino == ino) {
+                    break;
+                }
+            }
+            if (i == nids && nids < 256) {
+                ids[nids].dev = dev;
+                ids[nids].ino = ino;
+                nids++;
+            }
+            id = (uint32_t)(i + 1) << 24 | ((off + (h - lo)) & 0xfff000);
+            break;
+        }
+    }
+    if (f) {
+        fclose(f);
+    }
+    cached_gen = riscos_mmap_gen;       /* (fopen may have mapped memory) */
+    cached_page = addr & ~0xfffu;
+    cached = id;
+    return id | (addr & 0xfff);
+}
+
+static bool riscos_os_memory0(CPUARMState *env)
+{
+    uint32_t r0 = env->regs[0];
+    if ((r0 & 0xff) != 0 || (r0 & 0x700) != 0x200) {
+        return false;                   /* only "logical address given" */
+    }
+    abi_ulong list = env->regs[1];
+    for (uint32_t n = 0; n < env->regs[2]; n++, list += 12) {
+        uint32_t la;
+        if (get_user_u32(la, list + 4)) {
+            return false;
+        }
+    }
+    list = env->regs[1];
+    for (uint32_t n = 0; n < env->regs[2]; n++, list += 12) {
+        uint32_t la, pa;
+        get_user_u32(la, list + 4);
+        /* Outside application space (RISC OS's own workspace, such as
+           SoundDMA's buffers, which it looks up when it starts): the
+           port refuses, so give the logical address as the physical one.
+           Only DMA would use it, and the port has none. */
+        pa = la >= 0x8000 && la < 0x20000000 ? riscos_app_phys(la) : la;
+        if (r0 & 0x800) {
+            put_user_u32(pa >> 12, list);
+        }
+        if (r0 & 0x2000) {
+            put_user_u32(pa, list + 8);
+        }
+    }
+    env->VF = 0;
+    return true;
+}
+
+/*
+ * RISCOS_SWI_RESULT=<number>: report how that SWI (from outside the ROM)
+ * returns - V and r0 - with a breakpoint on the instruction after it
+ * (one at a time).
+ */
+static abi_ulong riscos_ret_bp;
+static uint32_t riscos_ret_swi, riscos_ret_in[3];
+
+static void riscos_swi_result_arm(CPUARMState *env, uint32_t swi)
+{
+    static int want = -2;
+    if (want == -2) {
+        const char *e = getenv("RISCOS_SWI_RESULT");
+        want = e ? (int)strtoul(e, NULL, 16) : -1;
+    }
+    if (want < 0 || (swi & 0xfdffff) != (uint32_t)want || riscos_ret_bp) {
+        return;
+    }
+    riscos_ret_bp = env->regs[15];
+    riscos_ret_swi = swi;
+    riscos_ret_in[0] = env->regs[0];
+    riscos_ret_in[1] = env->regs[1];
+    riscos_ret_in[2] = env->regs[2];
+    cpu_breakpoint_insert(env_cpu(env), riscos_ret_bp, BP_GDB, NULL);
+}
+
+static bool riscos_swi_result_hit(CPUARMState *env)
+{
+    if (!riscos_ret_bp || env->regs[15] != riscos_ret_bp) {
+        return false;
+    }
+    cpu_breakpoint_remove(env_cpu(env), riscos_ret_bp, BP_GDB);
+    riscos_ret_bp = 0;
+    char msg[64] = "";
+    if (env->VF & 0x80000000u) {
+        for (int i = 0; i < 60; i++) {
+            uint8_t c;
+            if (get_user_u8(c, env->regs[0] + 4 + i) || c < 32) {
+                break;
+            }
+            msg[i] = c;
+        }
+    }
+    fprintf(stderr, "swi %05x (r0 %08x r1 %08x r2 %08x) at %08x -> %s r0 %08x %s\n",
+            riscos_ret_swi, riscos_ret_in[0], riscos_ret_in[1], riscos_ret_in[2],
+            env->regs[15] - 4, (env->VF & 0x80000000u) ? "ERROR" : "ok",
+            env->regs[0], msg);
+    return true;
+}
+
+/*
+ * A RISC OS SWI without a host signal: what the port's SIGSYS handler
+ * does (HAL c/Main ENTER_EXCEPTION(SVC, 1, 0)), done here. The handler
+ * runs as guest code after QEMU has built a signal frame and blocked and
+ * unblocked signals (host system calls each time); this is the same
+ * change of virtual mode without any of that. struct vcpu (HAL h/header):
+ * +8 vectors, +13 cpsr byte, +16 SVC {r13, r14, spsr}, USR, IRQ, FIQ,
+ * UND, ABT. RISCOS_NO_FASTSWI goes back to the signal.
+ */
+static unsigned long riscos_excp_stats[256];
+static bool riscos_excp_stats_on;
+
+static void riscos_excp_stats_print(void)
+{
+    for (int i = 0; i < 256; i++) {
+        if (riscos_excp_stats[i]) {
+            fprintf(stderr, "riscos: exception %#x x %lu\n", i,
+                    riscos_excp_stats[i]);
+        }
+    }
+}
+
+static bool riscos_fast_swi(CPUARMState *env)
+{
+    static int on = -1;
+    if (on < 0) {
+        on = getenv("RISCOS_NO_FASTSWI") == NULL;
+    }
+    abi_ulong vcpu = cpu_get_tls(env);
+    if (!on || !vcpu) {
+        return false;
+    }
+    uint8_t vcpsr;
+    uint32_t vectors, svc_r13, vec;
+    if (get_user_u8(vcpsr, vcpu + 13) || get_user_u32(vectors, vcpu + 8)) {
+        return false;
+    }
+    int idx;
+    switch (vcpsr & 0x1f) {
+    case 0x13: idx = 0; break;              /* SVC */
+    case 0x10: case 0x1f: idx = 1; break;   /* USR, SYS */
+    case 0x12: idx = 2; break;              /* IRQ */
+    case 0x11: idx = 3; break;              /* FIQ */
+    case 0x1b: idx = 4; break;              /* UND */
+    case 0x17: idx = 5; break;              /* ABT */
+    default: return false;
+    }
+    if (get_user_u32(vec, vectors + 4)) {
+        return false;
+    }
+    /* save this mode's sp and lr first: from SVC mode they are the
+       values the SVC stack carries on from */
+    abi_ulong vm = vcpu + 16 + idx * 12;
+    uint32_t cpsr = cpsr_read(env);
+    if (put_user_u32(env->regs[13], vm) || put_user_u32(env->regs[14], vm + 4)
+        || get_user_u32(svc_r13, vcpu + 16)
+        || put_user_u32((cpsr & ~0xDFu) | vcpsr, vcpu + 16 + 8)
+        || put_user_u8(0x13 | 0x80, vcpu + 13)) {
+        return false;
+    }
+    /* E, T and IT bits cleared, as the handler's r[16] &= ~PSR_EIT_BITS */
+    if (cpsr & (CPSR_E | CPSR_IT)) {
+        cpsr_write(env, cpsr & ~(CPSR_E | CPSR_IT), CPSR_E | CPSR_IT,
+                   CPSRWriteRaw);
+    }
+    env->thumb = 0;
+    env->regs[13] = svc_r13;
+    env->regs[14] = env->regs[15];      /* the address after the SWI */
+    env->regs[15] = vec & ~1u;
+    arm_rebuild_hflags(env);
+    return true;
+}
+
+static bool riscos_host_swi(CPUARMState *env);
+/* RISC OS for Linux: the SWI intercept range (SWI &C0001, cpu_loop) */
+static abi_ulong sys_base = 0;
+static abi_ulong sys_limit = 0xFFFFFFFF;
+
+/*
+ * Called from the translated code for an SWI (target/arm/tcg/op_helper.c
+ * HELPER(riscos_swi)), PC already past it: 1 if it is done (a RISC OS SWI
+ * handled here or entered as the port does), 0 to raise EXCP_SWI as usual
+ * (Linux system calls, and anything else).
+ */
+uint32_t riscos_swi_inline(CPUARMState *env);
+uint32_t riscos_swi_inline(CPUARMState *env)
+{
+    if (env->regs[15] >= sys_base && env->regs[15] <= sys_limit) {
+        return 0;                       /* a Linux system call */
+    }
+    if (riscos_host_swi(env)) {
+        return 1;
+    }
+    return riscos_fast_swi(env);
+}
+
+/* An SWI from outside the port's ROM: true if handled here. */
+static bool riscos_host_swi(CPUARMState *env)
+{
+    uint32_t insn;
+    if (env->thumb || get_user_code_u32(insn, env->regs[15] - 4, env)) {
+        return false;
+    }
+    static int trace = -1;
+    if (trace < 0) {
+        trace = getenv("RISCOS_SWI_TRACE") != NULL;
+    }
+    if (trace) {
+        fprintf(stderr, "swi %05x at %08x: %08x %08x %08x %08x %08x %08x"
+                " r12 %08x\n", insn & 0xffffff, env->regs[15] - 4,
+                env->regs[0], env->regs[1], env->regs[2], env->regs[3],
+                env->regs[4], env->regs[5], env->regs[12]);
+    }
+    /* OS_CallASWIR12 / OS_CallASWI: the SWI number is in r12 / r10 (how
+       UnixLib's _swix calls SWIs) */
+    static int nocall = -1;
+    if (nocall < 0) {
+        nocall = getenv("RISCOS_NO_CALLASWI") != NULL;
+    }
+    if (nocall) {
+        /* leave OS_CallASWI(R12) to RISC OS */
+    } else if ((insn & 0xfdffff) == 0x71) {
+        insn = env->regs[12];
+    } else if ((insn & 0xfdffff) == 0x6f) {
+        insn = env->regs[10];
+    }
+    riscos_swi_result_arm(env, insn);
+    switch (insn & 0xfdffff) {         /* X bit ignored */
+    case 0xC0002:
+        env->regs[0] = riscos_pmp_op(env);
+        return true;
+    case 0xC0003:
+        riscos_abh_return_swi(env);
+        return true;
+    case 0x54c80:                       /* Report_Text0 */
+    case 0x54c81:                       /* Report_TextS (inline string) */
+        if (getenv("RISCOS_REPORT")) {
+            abi_ulong a = (insn & 0xfdffff) == 0x54c80 ? env->regs[0]
+                                                       : env->regs[15];
+            char buf[512];
+            int n = 0;
+            uint8_t ch;
+            while (n < 511 && !get_user_u8(ch, a + n) && ch >= 32) {
+                buf[n++] = ch;
+            }
+            buf[n] = 0;
+            fprintf(stderr, "report: %s\n", buf);
+            if ((insn & 0xfdffff) == 0x54c81) {
+                env->regs[15] = (a + n + 4) & ~3u;      /* past the string */
+            }
+            return true;
+        }
+        return false;
+    case 0x68:                          /* OS_Memory */
+        return riscos_os_memory0(env);
+    case 0x66:                          /* OS_DynamicArea */
+        return env->regs[0] == 22 && riscos_pmp_da22(env);
+    }
+    return false;
+}
