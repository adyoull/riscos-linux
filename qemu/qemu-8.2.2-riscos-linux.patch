+void HELPER(rol_nshift)(CPUARMState *env, void *vd, void *vm, uint32_t desc)
+{
+    int op = desc & 15, size = (desc >> 4) & 3, sh = (desc >> 8) & 63;
+    bool round = op & 1;
+
+    if (size == 1) {
+        switch (op >> 1) {
+        case 0:
+            ROL_NSHIFT_PLAIN(uint16_t, uint32_t, uint8_t, 8);
+            break;
+        case 1:
+            ROL_NSHIFT(int16_t, int32_t, uint8_t, 8, 0, 255);
+            break;
+        case 2:
+            ROL_NSHIFT(int16_t, int32_t, int8_t, 8, -128, 127);
+            break;
+        default:
+            ROL_NSHIFT(uint16_t, int32_t, uint8_t, 8, 0, 255);
+            break;
+        }
+    } else {
+        switch (op >> 1) {
+        case 0:
+            ROL_NSHIFT_PLAIN(uint32_t, uint64_t, uint16_t, 4);
+            break;
+        case 1:
+            ROL_NSHIFT(int32_t, int64_t, uint16_t, 4, 0, 65535);
+            break;
+        case 2:
+            ROL_NSHIFT(int32_t, int64_t, int16_t, 4, -32768, 32767);
+            break;
+        default:
+            ROL_NSHIFT(uint32_t, int64_t, uint16_t, 4, 0, 65535);
+            break;
+        }
+    }
+}
+
+/* VMUL, VMLA, VMLS .I16 by scalar: op 0, 1, 2; desc bit 4 = Q */
+void HELPER(rol_2sc16)(void *vd, void *vn, uint32_t scalar, uint32_t desc)
+{
+    int op = desc & 15;
+    uint16_t nn[8], dd[8], out[8], sc = scalar;
+    int n = (desc & 16) ? 8 : 4;
+
+    memcpy(nn, vn, 16);       /* the whole Q register is in env */
+    memcpy(dd, vd, 16);
+    for (int i = 0; i < 8; i++) {
+        uint16_t p = nn[i] * sc;
+        out[i] = op == 0 ? p : op == 1 ? (uint16_t)(dd[i] + p)
+                                       : (uint16_t)(dd[i] - p);
+    }
+    memcpy(vd, out, n * 2);
+}
+
+/* VSHLL / VMOVL, size 0 or 1: Qd = widen(Dm) << shift; desc bit 6 = signed */
+void HELPER(rol_shll)(void *vd, void *vm, uint32_t desc)
+{
+    int size = (desc >> 4) & 3, sgn = (desc >> 6) & 1, sh = (desc >> 8) & 63;
+
+    if (size == 0) {
+        uint8_t in[8];
+        uint16_t out[8];
+        memcpy(in, vm, 8);
+        for (int i = 0; i < 8; i++) {
+            out[i] = (uint16_t)(sgn ? (int8_t)in[i] : in[i]) << sh;
+        }
+        memcpy(vd, out, 16);
+    } else {
+        uint16_t in[4];
+        uint32_t out[4];
+        memcpy(in, vm, 8);
+        for (int i = 0; i < 4; i++) {
+            out[i] = (uint32_t)(sgn ? (int16_t)in[i] : in[i]) << sh;
+        }
+        memcpy(vd, out, 16);
+    }
+}
