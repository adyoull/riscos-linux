diff --git a/target/arm/tcg/riscos-fp.h b/target/arm/tcg/riscos-fp.h
new file mode 100644
index 0000000..2d2187a
--- /dev/null
+++ b/target/arm/tcg/riscos-fp.h
@@ -0,0 +1,1114 @@
+/*
+ * RISC OS testbed: VFP and Neon floating point done inline in the
+ * translated code with the host's FPU, instead of a call to a helper.
+ *
+ * The host instruction (tcg-opc.h's rof*_vec opcodes) gives the same
+ * result as the guest's whenever the result is a finite normal number
+ * above the smallest normal and the inputs are ones the guest uses as they
+ * are: IEEE 754 arithmetic is correctly rounded on both, and then the only
+ * flag the guest could raise is inexact. So the generated code:
+ *
+ *   - goes to the helper (the old code, which gets everything right) unless
+ *     the guest's inexact flag is already set, the rounding mode is round
+ *     to nearest and, for VFP, inputs aren't flushed to zero (FPSCR.FZ);
+ *     the flag is nearly always set after a program's first inexact result
+ *     (an FPSCR write sets it in both statuses: vfp_helper.c);
+ *   - runs the host instruction, then checks each result lane, and each
+ *     input lane where denormals would be flushed (Neon always flushes);
+ *   - stores the result if every lane passed, else goes to the helper,
+ *     which reads the untouched inputs again.
+ *
+ * Zero, infinite, NaN and denormal results, other rounding modes, flushed
+ * inputs and the first inexact result all take the helper as before.
+ * RISCOS_NO_INLINEFP=1 turns it off (to compare against).
+ */
+#ifndef RISCOS_FP_H
+#define RISCOS_FP_H
+
+#include "tcg/tcg-op-gvec.h"
+#include "tcg/tcg-temp-internal.h"
+
+/*
+ * Temps: extended-basic-block ones (the fast paths have no labels, only
+ * branches out), freed when each fast path is finished (rofp_finish): TB
+ * temps are never freed, and a few dozen inline instructions would use up
+ * TCG_MAX_TEMPS, making QEMU translate the TB again in smaller pieces.
+ */
+#define ROFP_MAXTMPS 96
+#define ROFP_TB_MAX 16       /* inline FP instructions per TB */
+/*
+ * One registry per thread (defined in translate.c), emptied without
+ * freeing at the start of each translation (arm_tr_init_disas_context):
+ * if TCG runs out of temps it abandons the translation by a longjmp and
+ * starts again, and the abandoned one's temps no longer exist.
+ */
+extern __thread TCGTemp *rofp_tmps[ROFP_MAXTMPS];
+extern __thread int rofp_ntmps;
+
+static inline void rofp_tmp_note(TCGTemp *t)
+{
+    g_assert(rofp_ntmps < ROFP_MAXTMPS);
+    rofp_tmps[rofp_ntmps++] = t;
+}
+
+static inline TCGv_vec rofp_tv(TCGType type)
+{
+    TCGv_vec v = tcg_temp_new_vec(type);
+    rofp_tmp_note(tcgv_vec_temp(v));
+    return v;
+}
+
+static inline TCGv_i64 rofp_t64(void)
+{
+    TCGv_i64 v = tcg_temp_ebb_new_i64();
+    rofp_tmp_note(tcgv_i64_temp(v));
+    return v;
+}
+
+static inline TCGv_i32 rofp_t32(void)
+{
+    TCGv_i32 v = tcg_temp_ebb_new_i32();
+    rofp_tmp_note(tcgv_i32_temp(v));
+    return v;
+}
+
+/* a float_status pointer (fpstatus_ptr's, as an EBB temp) */
+static inline TCGv_ptr rofp_fpst(ARMFPStatusFlavour flavour)
+{
+    TCGv_ptr p = tcg_temp_ebb_new_ptr();
+
+    rofp_tmp_note(tcgv_ptr_temp(p));
+    tcg_gen_addi_ptr(p, tcg_env, flavour == FPST_STD
+                     ? offsetof(CPUARMState, vfp.standard_fp_status)
+                     : offsetof(CPUARMState, vfp.fp_status));
+    return p;
+}
+
+static inline void rofp_memo_reset(void);
+
+static inline void rofp_tmps_free(void)
+{
+    while (rofp_ntmps > 0) {
+        tcg_temp_free_internal(rofp_tmps[--rofp_ntmps]);
+    }
+    rofp_memo_reset();
+}
+
+enum {
+    ROFP_NONE,
+    ROFP_ADD,           /* n + m */
+    ROFP_SUB,           /* n - m */
+    ROFP_MUL,           /* n * m */
+    ROFP_DIV,           /* n / m */
+    ROFP_MLA,           /* d + n * m (two roundings) */
+    ROFP_MLS,           /* d - n * m */
+    ROFP_NMLA,          /* -d - n * m */
+    ROFP_NMLS,          /* -d + n * m */
+    ROFP_NMUL,          /* -(n * m) */
+    ROFP_SQRT,          /* sqrt(m) */
+};
+
+static inline bool rofp_off(void)
+{
+    static int off = -1;
+
+    if (off < 0) {
+        off = getenv("RISCOS_NO_INLINEFP") != NULL;
+    }
+    return off;
+}
+
+/*
+ * Slow paths out of line: a fast path's branches go to a label emitted at
+ * the end of the translation block (arm_tr_tb_stop: rofp_emit_slow), where
+ * the old code runs and then goes on to the next instruction through a TB
+ * lookup. So the fast paths run straight through, one instruction into the
+ * next, and TCG's optimizer keeps what it knows (values loaded and stored)
+ * across them; a join after each would make it forget. Where that can't be
+ * done (Thumb IT blocks, single-stepping, CF_PCREL) the slow path goes
+ * inline, followed by a join, as before.
+ */
+typedef void RofpSlowFn(DisasContext *s, const void *arg);
+
+typedef struct RofpSlow {
+    struct RofpSlow *next;
+    TCGLabel *label;
+    RofpSlowFn *fn;
+    target_ulong pc_next;
+    uint64_t arg[8];
+} RofpSlow;
+
+/* the instruction being translated (arm_tr/thumb_tr_translate_insn) */
+extern __thread DisasContext *rofp_cur;
+
+/* slow paths can go to the end of the TB (else inline, with a join) */
+static inline bool rofp_can_defer(DisasContext *s)
+{
+    return s && !s->ss_active && s->condexec_mask == 0 &&
+           !(tb_cflags(s->base.tb) & CF_PCREL);
+}
+
+/* finishes a fast path: its slow path is fn(arg), branched to at slow */
+static inline void rofp_finish(TCGLabel *slow, RofpSlowFn *fn,
+                               const void *arg, size_t size)
+{
+    DisasContext *s = rofp_cur;
+    TCGLabel *done;
+
+    g_assert(size <= sizeof(((RofpSlow *)0)->arg));
+    if (rofp_can_defer(s) && !s->rofp_join) {
+        RofpSlow *r = tcg_malloc(sizeof(*r));
+
+        r->label = slow;
+        r->fn = fn;
+        r->pc_next = s->base.pc_next;
+        memcpy(r->arg, arg, size);
+        r->next = s->rofp_slow;
+        s->rofp_slow = r;
+    } else {
+        done = gen_new_label();
+        tcg_gen_br(done);
+        gen_set_label(slow);
+        fn(s, arg);
+        gen_set_label(done);
+    }
+    if (s) {
+        s->rofp_join = false;
+        s->rofp_n++;
+    }
+    rofp_tmps_free();
+}
+
+/* vector types: x86 has them only with AVX */
+static inline bool rofp_type_ok(TCGType type)
+{
+    return type == TCG_TYPE_V64 ? TCG_TARGET_HAS_v64 : TCG_TARGET_HAS_v128;
+}
+
+static const TCGOpcode rofp_vecops[] = {
+    INDEX_op_rofadd_vec, INDEX_op_rofsub_vec, INDEX_op_rofmul_vec,
+    INDEX_op_rofst32_vec, INDEX_op_sub_vec, INDEX_op_cmp_vec,
+    INDEX_op_andc_vec, INDEX_op_umin_vec, 0
+};
+static const TCGOpcode rofp_vecops_cat[] = { INDEX_op_rofcat_vec, 0 };
+
+/*
+ * Load a 128-bit Neon register (an operand, n or m) as two 64-bit halves
+ * joined in a register: QEMU's VLD1/VLDM store one as two 64-bit writes,
+ * which a 128-bit load straight after can't take from the store buffer (a
+ * stall of 10 or more cycles on x86 and Apple cores); 64-bit loads can.
+ * (Writing the Q register with one 128-bit store in VLD1 instead was
+ * slower: other instructions read the halves.) ROBench FIR: 1.7x. A 64-bit
+ * vector loads as it is.
+ */
+static inline void rofp_ld_neon(TCGType type, TCGv_vec v, uint32_t ofs)
+{
+    if (type == TCG_TYPE_V128 &&
+        tcg_can_emit_vecop_list(rofp_vecops_cat, TCG_TYPE_V128, MO_64)) {
+        TCGv_vec lo = rofp_tv(TCG_TYPE_V128);
+        TCGv_vec hi = rofp_tv(TCG_TYPE_V128);
+
+        /* 64-bit loads (into both lanes), then the low halves joined */
+        tcg_gen_dup_mem_vec(MO_64, lo, tcg_env, ofs);
+        tcg_gen_dup_mem_vec(MO_64, hi, tcg_env, ofs + 8);
+        tcg_gen_rof3_vec(INDEX_op_rofcat_vec, MO_64, v, lo, hi);
+    } else {
+        tcg_gen_ld_vec(v, tcg_env, ofs);
+    }
+}
+static const TCGOpcode rofp_vecops_div[] = {
+    INDEX_op_rofdiv_vec, INDEX_op_rofsqrt_vec, INDEX_op_rofst32_vec,
+    INDEX_op_sub_vec, INDEX_op_cmp_vec, INDEX_op_andc_vec,
+    INDEX_op_umin_vec, 0
+};
+
+/* 16 bytes of vfp.scratch (unused on A32), aligned: vector stores need it */
+#define ROFP_SCRATCH \
+    QEMU_ALIGN_UP(offsetof(CPUARMState, vfp.scratch), 16)
+QEMU_BUILD_BUG_ON(ROFP_SCRATCH + 16 > offsetof(CPUARMState, vfp.scratch) +
+                  sizeof(((CPUARMState *)0)->vfp.scratch));
+QEMU_BUILD_BUG_ON(offsetof(CPUARMState, vfp.zregs) % 16);
+
+/* the first 8 bytes of a float_status, as one 64-bit load */
+QEMU_BUILD_BUG_ON(offsetof(float_status, float_exception_flags) != 0);
+QEMU_BUILD_BUG_ON(offsetof(float_status, float_rounding_mode) != 2);
+QEMU_BUILD_BUG_ON(offsetof(float_status, flush_inputs_to_zero) != 6);
+QEMU_BUILD_BUG_ON(sizeof(FloatRoundMode) != 1);
+
+/*
+ * Branch to slow unless status (an offset in env) has inexact set, round to
+ * nearest, and (if inputs_ok) doesn't flush inputs to zero.
+ */
+static inline void rofp_gate(long status, bool check_flush, TCGLabel *slow)
+{
+    DisasContext *s = rofp_cur;
+    TCGv_i64 g;
+    uint64_t mask = float_flag_inexact | 0xff0000ull;
+    /*
+     * Once a gate has passed in a TB's straight-line code, the later ones
+     * would too: nothing in the TB can clear the inexact flag or change
+     * the rounding or flush mode (an FPSCR write ends the TB; helpers only
+     * add flags). So in the same TB the gate is generated once, when its
+     * failure leaves the TB (rofp_can_defer) and the instruction isn't
+     * conditional (else the later ones could run without it).
+     */
+    unsigned bit = status == offsetof(CPUARMState, vfp.standard_fp_status)
+                   ? 1 : check_flush ? 2 : 4;
+
+    bool ixc = !s || (bit == 1 ? s->rofp_ixc_std : s->rofp_ixc_vfp);
+
+    if (s && (s->rofp_gated & bit)) {
+        return;
+    }
+    if (check_flush) {
+        mask |= 0xffull << 48;
+    }
+    g = rofp_t64();
+    tcg_gen_ld_i64(g, tcg_env, status);
+    tcg_gen_andi_i64(g, g, mask);
+    tcg_gen_brcondi_i64(TCG_COND_NE, g, float_flag_inexact, slow);
+    if (!ixc) {
+        /* likely to fail (rofp_ixc_*): slow path inline, gate every time */
+        s->rofp_join = true;
+    } else if (rofp_can_defer(s) && !s->condjmp) {
+        s->rofp_gated |= bit | (bit == 2 ? 4 : 0);
+    }
+}
+
+static inline TCGv_vec rofp_k(TCGType type, unsigned vece, uint64_t v)
+{
+    return tcg_constant_vec(type, vece, v);
+}
+
+/* which exact zero results are the same as the guest's */
+enum {
+    ROFZ_NONE,          /* none (shouldn't happen without underflow) */
+    ROFZ_ANY,           /* any: x - x, 0 + 0, sqrt(0): exact, no flags */
+    ROFZ_IFZERO,        /* if za (or zb) is zero: 0 * x, 0 / x */
+};
+
+/*
+ * |x| and (|x| == 0), each generated once per operation (TCG has no common
+ * subexpression elimination): rofp_memo_reset() at the start of each.
+ */
+static __thread struct {
+    TCGv_vec x, ax, zx;
+} rofp_memo[8];
+static __thread int rofp_nmemo;
+
+static inline void rofp_memo_reset(void)
+{
+    rofp_nmemo = 0;
+}
+
+static inline int rofp_memo_find(TCGv_vec x)
+{
+    int i;
+
+    for (i = 0; i < rofp_nmemo; i++) {
+        if (rofp_memo[i].x == x) {
+            return i;
+        }
+    }
+    if (rofp_nmemo == ARRAY_SIZE(rofp_memo)) {
+        return -1;
+    }
+    rofp_memo[rofp_nmemo].x = x;
+    rofp_memo[rofp_nmemo].ax = NULL;
+    rofp_memo[rofp_nmemo].zx = NULL;
+    return rofp_nmemo++;
+}
+
+static inline TCGv_vec rofp_abs(TCGType type, unsigned vece, TCGv_vec x)
+{
+    int i = rofp_memo_find(x);
+    TCGv_vec t;
+
+    if (i >= 0 && rofp_memo[i].ax) {
+        return rofp_memo[i].ax;
+    }
+    t = rofp_tv(type);
+    tcg_gen_and_vec(vece, t, x, rofp_k(type, vece, vece == MO_64
+                                       ? INT64_MAX : 0x7fffffff));
+    if (i >= 0) {
+        rofp_memo[i].ax = t;
+    }
+    return t;
+}
+
+/* all ones in each lane of x that is +0 or -0 */
+static inline TCGv_vec rofp_iszero(TCGType type, unsigned vece, TCGv_vec x)
+{
+    int i = rofp_memo_find(x);
+    TCGv_vec t;
+
+    if (i >= 0 && rofp_memo[i].zx) {
+        return rofp_memo[i].zx;
+    }
+    t = rofp_tv(type);
+    tcg_gen_cmp_vec(TCG_COND_EQ, vece, t, rofp_abs(type, vece, x),
+                    rofp_k(type, vece, 0));
+    i = rofp_memo_find(x);
+    if (i >= 0) {
+        rofp_memo[i].zx = t;
+    }
+    return t;
+}
+
+/*
+ * All ones in each lane of r that isn't finite, normal and above FLT_MIN
+ * (or DBL_MIN), except zeros allowed by zrule (za, zb: the operands).
+ */
+static inline void rofp_bad_result(TCGType type, unsigned vece,
+                                   TCGv_vec bad, TCGv_vec r, bool first,
+                                   int zrule, TCGv_vec za, TCGv_vec zb)
+{
+    bool d = vece == MO_64;
+    TCGv_vec u = rofp_abs(type, vece, r);
+    TCGv_vec t = rofp_tv(type);
+
+    tcg_gen_sub_vec(vece, t, u,
+                    rofp_k(type, vece, d ? 0x0010000000000001ull : 0x00800001));
+    tcg_gen_cmp_vec(TCG_COND_GEU, vece, t, t,
+                    rofp_k(type, vece, d ? 0x7fdfffffffffffffull : 0x7effffff));
+    if (zrule != ROFZ_NONE) {
+        TCGv_vec z = rofp_iszero(type, vece, r);
+
+        if (zrule == ROFZ_IFZERO) {
+            TCGv_vec w = rofp_tv(type);
+
+            if (zb) {
+                tcg_gen_or_vec(vece, w, rofp_iszero(type, vece, za),
+                               rofp_iszero(type, vece, zb));
+            } else {
+                tcg_gen_mov_vec(w, rofp_iszero(type, vece, za));
+            }
+            tcg_gen_and_vec(vece, w, w, z);
+            z = w;
+        }
+        tcg_gen_andc_vec(vece, t, t, z);
+    }
+    if (first) {
+        tcg_gen_mov_vec(bad, t);
+    } else {
+        tcg_gen_or_vec(vece, bad, bad, t);
+    }
+}
+
+/* all ones in each lane of a that is a denormal (nonzero, exponent 0) */
+static inline void rofp_bad_input(TCGType type, unsigned vece,
+                                  TCGv_vec bad, TCGv_vec a, bool first)
+{
+    bool d = vece == MO_64;
+    TCGv_vec t = rofp_tv(type);
+
+    tcg_gen_sub_vec(vece, t, rofp_abs(type, vece, a), rofp_k(type, vece, 1));
+    tcg_gen_cmp_vec(TCG_COND_LTU, vece, t, t,
+                    rofp_k(type, vece, d ? 0x000fffffffffffffull : 0x007fffff));
+    if (first) {
+        tcg_gen_mov_vec(bad, t);
+    } else {
+        tcg_gen_or_vec(vece, bad, bad, t);
+    }
+}
+
+/*
+ * The same for up to three inputs (b, and a, c if not NULL), with one
+ * comparison: (|x| - 1) of a denormal is below 0x7fffff, of a zero it wraps
+ * to the top, so the unsigned minimum of them is below it if any is.
+ */
+static inline void rofp_bad_inputs(TCGType type, unsigned vece,
+                                   TCGv_vec bad, TCGv_vec b, TCGv_vec a,
+                                   TCGv_vec c, bool first)
+{
+    bool d = vece == MO_64;
+    TCGv_vec one = rofp_k(type, vece, 1), m = rofp_tv(type);
+    TCGv_vec t;
+
+    if (!a && !c) {
+        rofp_bad_input(type, vece, bad, b, first);
+        return;
+    }
+    tcg_gen_sub_vec(vece, m, rofp_abs(type, vece, b), one);
+    if (a) {
+        t = rofp_tv(type);
+        tcg_gen_sub_vec(vece, t, rofp_abs(type, vece, a), one);
+        tcg_gen_umin_vec(vece, m, m, t);
+    }
+    if (c) {
+        t = rofp_tv(type);
+        tcg_gen_sub_vec(vece, t, rofp_abs(type, vece, c), one);
+        tcg_gen_umin_vec(vece, m, m, t);
+    }
+    tcg_gen_cmp_vec(TCG_COND_LTU, vece, m, m,
+                    rofp_k(type, vece, d ? 0x000fffffffffffffull : 0x007fffff));
+    if (first) {
+        tcg_gen_mov_vec(bad, m);
+    } else {
+        tcg_gen_or_vec(vece, bad, bad, m);
+    }
+}
+
+/* branch to slow if any lane of bad is nonzero */
+static inline void rofp_branch_bad(TCGType type, TCGv_vec bad,
+                                   TCGLabel *slow)
+{
+    TCGv_i64 x = rofp_t64();
+
+    tcg_gen_st_vec(bad, tcg_env, ROFP_SCRATCH);
+    tcg_gen_ld_i64(x, tcg_env, ROFP_SCRATCH);
+    if (type == TCG_TYPE_V128) {
+        TCGv_i64 y = rofp_t64();
+        tcg_gen_ld_i64(y, tcg_env, ROFP_SCRATCH + 8);
+        tcg_gen_or_i64(x, x, y);
+    }
+    tcg_gen_brcondi_i64(TCG_COND_NE, x, 0, slow);
+}
+
+static inline void rofp_neg(TCGType type, unsigned vece, TCGv_vec r)
+{
+    tcg_gen_xor_vec(vece, r, r,
+                    rofp_k(type, vece, vece == MO_64 ? INT64_MIN : 0x80000000));
+}
+
+/*
+ * The operation itself on a, b (and d for the accumulating ones) into r;
+ * ORs the checks of its intermediate result (the product) into bad.
+ */
+static inline void rofp_compute(int op, TCGType type, unsigned vece,
+                                TCGv_vec r, TCGv_vec d, TCGv_vec a,
+                                TCGv_vec b, TCGv_vec bad, bool first)
+{
+    switch (op) {
+    case ROFP_ADD:
+        tcg_gen_rof3_vec(INDEX_op_rofadd_vec, vece, r, a, b);
+        break;
+    case ROFP_SUB:
+        tcg_gen_rof3_vec(INDEX_op_rofsub_vec, vece, r, a, b);
+        break;
+    case ROFP_MUL:
+        tcg_gen_rof3_vec(INDEX_op_rofmul_vec, vece, r, a, b);
+        break;
+    case ROFP_NMUL:
+        tcg_gen_rof3_vec(INDEX_op_rofmul_vec, vece, r, a, b);
+        rofp_neg(type, vece, r);
+        break;
+    case ROFP_DIV:
+        tcg_gen_rof3_vec(INDEX_op_rofdiv_vec, vece, r, a, b);
+        break;
+    case ROFP_SQRT:
+        tcg_gen_rof2_vec(INDEX_op_rofsqrt_vec, vece, r, b);
+        break;
+    case ROFP_MLA:
+    case ROFP_MLS:
+    case ROFP_NMLA:
+    case ROFP_NMLS:
+        {
+            TCGv_vec p = rofp_tv(type);
+            TCGv_vec dd = d;
+
+            tcg_gen_rof3_vec(INDEX_op_rofmul_vec, vece, p, a, b);
+            rofp_bad_result(type, vece, bad, p, first, ROFZ_IFZERO, a, b);
+            if (op == ROFP_NMLA || op == ROFP_NMLS) {
+                dd = rofp_tv(type);
+                tcg_gen_mov_vec(dd, d);
+                rofp_neg(type, vece, dd);
+            }
+            tcg_gen_rof3_vec(op == ROFP_MLA || op == ROFP_NMLS
+                             ? INDEX_op_rofadd_vec : INDEX_op_rofsub_vec,
+                             vece, r, dd, p);
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+/* the zero rule for an operation's final result */
+static inline int rofp_zrule(int op)
+{
+    switch (op) {
+    case ROFP_MUL:
+    case ROFP_NMUL:
+    case ROFP_DIV:
+        return ROFZ_IFZERO;
+    default:
+        return ROFZ_ANY;
+    }
+}
+
+static inline bool rofp_accumulates(int op)
+{
+    return op == ROFP_MLA || op == ROFP_MLS || op == ROFP_NMLA ||
+           op == ROFP_NMLS;
+}
+
+static inline bool rofp_supported(int op, TCGType type, unsigned vece)
+{
+    return op != ROFP_NONE && !rofp_off() && rofp_type_ok(type) &&
+           tcg_can_emit_vecop_list(op == ROFP_DIV || op == ROFP_SQRT
+                                   ? rofp_vecops_div : rofp_vecops,
+                                   type, vece);
+}
+
+typedef struct {
+    uint32_t rd, rn, rm, oprsz, maxsz;
+    int32_t data;
+    void *fn;
+    bool two;
+} RofpNeonSlow;
+
+static void rofp_neon_slow(DisasContext *s, const void *arg)
+{
+    const RofpNeonSlow *a = arg;
+
+    if (a->two) {
+        tcg_gen_gvec_2_ptr(a->rd, a->rm, rofp_fpst(FPST_STD), a->oprsz,
+                           a->maxsz, a->data, a->fn);
+    } else {
+        tcg_gen_gvec_3_ptr(a->rd, a->rn, a->rm, rofp_fpst(FPST_STD),
+                           a->oprsz, a->maxsz, a->data, a->fn);
+    }
+}
+
+/*
+ * Neon, single precision lanes, 8 or 16 bytes: Vd = op(Vn, Vm), or with
+ * mscalar_ofs >= 0, Vm is that one element repeated (by-scalar forms). The
+ * helper fn (a gvec_3_ptr one, with data) is the slow path. Returns false
+ * (nothing generated) when it can't be done here.
+ */
+static inline bool rofp_neon3(int op, uint32_t rd_ofs, uint32_t rn_ofs,
+                              uint32_t rm_ofs, long mscalar_ofs,
+                              uint32_t oprsz, uint32_t maxsz, int32_t data,
+                              gen_helper_gvec_3_ptr *fn)
+{
+    TCGType type = oprsz == 16 ? TCG_TYPE_V128 : TCG_TYPE_V64;
+    const unsigned vece = MO_32;
+    const TCGOpcode *hold;
+    TCGLabel *slow;
+    TCGv_vec a, b, d = NULL, r, bad;
+
+    if (oprsz != maxsz || (oprsz != 8 && oprsz != 16) ||
+        op == ROFP_DIV || op == ROFP_SQRT || !rofp_supported(op, type, vece)) {
+        return false;
+    }
+    hold = tcg_swap_vecop_list(rofp_vecops);
+    slow = gen_new_label();
+    rofp_memo_reset();
+
+    rofp_gate(offsetof(CPUARMState, vfp.standard_fp_status), false, slow);
+
+    a = rofp_tv(type);
+    b = rofp_tv(type);
+    r = rofp_tv(type);
+    bad = rofp_tv(type);
+    rofp_ld_neon(type, a, rn_ofs);
+    if (mscalar_ofs >= 0) {
+        tcg_gen_dup_mem_vec(vece, b, tcg_env, mscalar_ofs);
+    } else {
+        rofp_ld_neon(type, b, rm_ofs);
+    }
+    /* Neon always flushes denormal inputs (the standard FPSCR) */
+    if (rofp_accumulates(op)) {
+        d = rofp_tv(type);
+        tcg_gen_ld_vec(d, tcg_env, rd_ofs);
+    }
+    rofp_bad_inputs(type, vece, bad, b, a, d, true);
+    rofp_compute(op, type, vece, r, d, a, b, bad, false);
+    rofp_bad_result(type, vece, bad, r, false, rofp_zrule(op), a,
+                    op == ROFP_DIV ? NULL : b);
+    rofp_branch_bad(type, bad, slow);
+    tcg_gen_st_vec(r, tcg_env, rd_ofs);
+    {
+        RofpNeonSlow a = { rd_ofs, rn_ofs, rm_ofs, oprsz, maxsz, data, fn,
+                           false };
+        rofp_finish(slow, rofp_neon_slow, &a, sizeof(a));
+    }
+    tcg_swap_vecop_list(hold);
+    return true;
+}
+
+/*
+ * VFP scalar (vece MO_32 single, MO_64 double; not short vectors): the
+ * gate, the fast path and (rofp_finish) the slow path slowfn(arg), the old
+ * code. Returns false (nothing generated) when it can't be done here.
+ */
+static inline bool rofp_vfp(int op, unsigned vece, long vd_ofs,
+                            long vn_ofs, long vm_ofs, RofpSlowFn *slowfn,
+                            const void *arg, size_t size)
+{
+    TCGType type = TCG_TYPE_V64;
+    const TCGOpcode *hold;
+    TCGLabel *slow;
+    TCGv_vec a = NULL, b, d = NULL, r, bad;
+    bool first = true;
+
+    bool fz = rofp_cur && rofp_cur->rofp_vfp_fz;
+
+    if (!rofp_supported(op, type, vece) ||
+        (rofp_cur && !rofp_cur->rofp_vfp_rn)) {
+        return false;
+    }
+    hold = tcg_swap_vecop_list(op == ROFP_DIV || op == ROFP_SQRT
+                               ? rofp_vecops_div : rofp_vecops);
+    slow = gen_new_label();
+    rofp_memo_reset();
+
+    /*
+     * The TB is for one FZ setting (TBFLAG_A32 ROFP_FZ; an FPSCR write ends
+     * the TB). FZ clear: denormal inputs are used as they are, as the host
+     * does. FZ set ("RunFast" programs): denormal inputs go to the helper,
+     * which flushes them and sets IDC. The gate checks FZ is as expected.
+     */
+    rofp_gate(offsetof(CPUARMState, vfp.fp_status), !fz, slow);
+
+    /*
+     * Doubles are loaded and stored as whole 64-bit vectors, which TCG's
+     * optimizer can follow from one instruction to the next; singles are
+     * loaded into every lane and stored as 32 bits.
+     */
+    b = rofp_tv(type);
+    r = rofp_tv(type);
+    bad = rofp_tv(type);
+    if (op != ROFP_SQRT) {
+        a = rofp_tv(type);
+        if (vece == MO_64) {
+            tcg_gen_ld_vec(a, tcg_env, vn_ofs);
+        } else {
+            tcg_gen_dup_mem_vec(vece, a, tcg_env, vn_ofs);
+        }
+    }
+    if (vece == MO_64) {
+        tcg_gen_ld_vec(b, tcg_env, vm_ofs);
+    } else {
+        tcg_gen_dup_mem_vec(vece, b, tcg_env, vm_ofs);
+    }
+    if (rofp_accumulates(op)) {
+        d = rofp_tv(type);
+        if (vece == MO_64) {
+            tcg_gen_ld_vec(d, tcg_env, vd_ofs);
+        } else {
+            tcg_gen_dup_mem_vec(vece, d, tcg_env, vd_ofs);
+        }
+    }
+    if (fz) {
+        rofp_bad_inputs(type, vece, bad, b, a, d, true);
+        first = false;
+    }
+    rofp_compute(op, type, vece, r, d, a, b, bad, first);
+    if (rofp_accumulates(op)) {
+        first = false;
+    }
+    rofp_bad_result(type, vece, bad, r, first, rofp_zrule(op), a,
+                    op == ROFP_DIV ? NULL : b);
+    rofp_branch_bad(type, bad, slow);
+    if (vece == MO_64) {
+        tcg_gen_st_vec(r, tcg_env, vd_ofs);
+    } else {
+        tcg_gen_rofst32_vec(r, tcg_env, vd_ofs);
+    }
+    rofp_finish(slow, slowfn, arg, size);
+    tcg_swap_vecop_list(hold);
+    return true;
+}
+
+/*
+ * Conversions, done with integer instructions (the same on every host).
+ * Each generates the fast path and branches to slow for anything it
+ * doesn't do (the caller then emits the helper call, the old code).
+ */
+
+/* branch to slow unless the VFP status has inexact set and rounds to
+   nearest */
+static inline void rofp_gate_vfp(TCGLabel *slow, bool check_flush)
+{
+    rofp_gate(offsetof(CPUARMState, vfp.fp_status), check_flush, slow);
+}
+
+/* 32-bit integer (signed or not) to double: always exact, no flags */
+static inline void rofp_i32_to_f64(TCGv_i64 out, TCGv_i32 in, bool sgn)
+{
+    TCGv_i64 x = rofp_t64(), s = rofp_t64();
+    TCGv_i64 lz = rofp_t64(), e = rofp_t64();
+
+    if (sgn) {
+        tcg_gen_ext_i32_i64(x, in);
+        tcg_gen_shri_i64(s, x, 63);
+        tcg_gen_shli_i64(s, s, 63);
+        tcg_gen_abs_i64(x, x);
+    } else {
+        tcg_gen_extu_i32_i64(x, in);
+        tcg_gen_movi_i64(s, 0);
+    }
+    tcg_gen_clzi_i64(lz, x, 64);
+    /* exponent: 1023 + 63 - lz; mantissa: x with its top bit at bit 52 */
+    tcg_gen_subfi_i64(e, 1023 + 63, lz);
+    tcg_gen_shli_i64(e, e, 52);
+    tcg_gen_shl_i64(x, x, lz);
+    tcg_gen_shli_i64(x, x, 1);
+    tcg_gen_shri_i64(x, x, 12);
+    tcg_gen_or_i64(x, x, e);
+    tcg_gen_or_i64(x, x, s);
+    /* zero (lz == 64) is +0 */
+    tcg_gen_movcond_i64(TCG_COND_EQ, out, lz, tcg_constant_i64(64),
+                        tcg_constant_i64(0), x);
+}
+
+/* 32-bit integer to single: exact (fast) when it has at most 24 bits */
+static inline void rofp_i32_to_f32(TCGv_i32 out, TCGv_i32 in, bool sgn,
+                                   TCGLabel *slow)
+{
+    TCGv_i64 d = rofp_t64(), t = rofp_t64();
+    TCGv_i32 a = rofp_t32();
+
+    if (sgn) {
+        tcg_gen_abs_i32(a, in);
+    } else {
+        tcg_gen_mov_i32(a, in);
+    }
+    /* abs(INT_MIN) is INT_MIN: unsigned, >= 2^24 too */
+    tcg_gen_brcondi_i32(TCG_COND_GTU, a, 1 << 24, slow);
+    /* exact as a double, so exact as a single: narrow the bits */
+    rofp_i32_to_f64(d, in, sgn);
+    /* sign, exponent - 1023 + 127, top 23 mantissa bits (zero: 0) */
+    tcg_gen_shri_i64(t, d, 29);
+    tcg_gen_andi_i64(t, t, 0x7fffff);
+    tcg_gen_extrl_i64_i32(out, t);
+    tcg_gen_shri_i64(t, d, 52);
+    tcg_gen_andi_i64(t, t, 0x7ff);
+    tcg_gen_subi_i64(t, t, 1023 - 127);
+    tcg_gen_shli_i64(t, t, 23);
+    {
+        TCGv_i32 e = rofp_t32(), sg = rofp_t32();
+        tcg_gen_extrl_i64_i32(e, t);
+        tcg_gen_or_i32(out, out, e);
+        tcg_gen_extrh_i64_i32(sg, d);
+        tcg_gen_andi_i32(sg, sg, 0x80000000);
+        tcg_gen_or_i32(out, out, sg);
+        tcg_gen_movcond_i32(TCG_COND_EQ, out, a, tcg_constant_i32(0),
+                            tcg_constant_i32(0), out);
+    }
+}
+
+/*
+ * Single to double: exact for zeros, normals and infinities (no flags);
+ * denormals (flushed with FZ, or IDC) and NaNs go to slow.
+ */
+static inline void rofp_f32_to_f64(TCGv_i64 out, TCGv_i32 in, TCGLabel *slow)
+{
+    TCGv_i32 a = rofp_t32(), t = rofp_t32();
+    TCGv_i64 x = rofp_t64(), e = rofp_t64();
+    TCGv_i64 sg = rofp_t64(), r = rofp_t64();
+
+    tcg_gen_andi_i32(a, in, 0x7fffffff);
+    tcg_gen_brcondi_i32(TCG_COND_GTU, a, 0x7f800000, slow);     /* NaN */
+    tcg_gen_subi_i32(t, a, 1);
+    tcg_gen_brcondi_i32(TCG_COND_LTU, t, 0x007fffff, slow);     /* denormal */
+    tcg_gen_extu_i32_i64(x, a);
+    tcg_gen_shri_i64(e, x, 23);                 /* 0 (zero) to 255 (inf) */
+    tcg_gen_andi_i64(x, x, 0x7fffff);
+    tcg_gen_shli_i64(x, x, 29);
+    tcg_gen_addi_i64(r, e, 1023 - 127);
+    tcg_gen_movcond_i64(TCG_COND_EQ, r, e, tcg_constant_i64(255),
+                        tcg_constant_i64(0x7ff), r);
+    tcg_gen_movcond_i64(TCG_COND_EQ, r, e, tcg_constant_i64(0),
+                        tcg_constant_i64(0), r);
+    tcg_gen_shli_i64(r, r, 52);
+    tcg_gen_or_i64(r, r, x);
+    tcg_gen_extu_i32_i64(sg, in);
+    tcg_gen_shri_i64(sg, sg, 31);
+    tcg_gen_shli_i64(sg, sg, 63);
+    tcg_gen_or_i64(out, r, sg);
+}
+
+/*
+ * Double to single, round to nearest even: fast when the result is a
+ * normal single (or the input is a zero), and exact or inexact already
+ * set (gate: the caller's rofp_gate_vfp).
+ */
+static inline void rofp_f64_to_f32(TCGv_i32 out, TCGv_i64 in, TCGLabel *slow)
+{
+    TCGv_i64 a = rofp_t64(), e = rofp_t64(), z = rofp_t64();
+    TCGv_i64 rem = rofp_t64(), r = rofp_t64();
+    TCGv_i64 up = rofp_t64(), t = rofp_t64();
+    TCGv_i32 sg = rofp_t32();
+
+    tcg_gen_extrh_i64_i32(sg, in);
+    tcg_gen_andi_i32(sg, sg, 0x80000000);
+    tcg_gen_andi_i64(a, in, INT64_MAX);
+    tcg_gen_setcondi_i64(TCG_COND_EQ, z, a, 0);     /* +-0: result +-0 */
+    tcg_gen_shri_i64(e, a, 52);
+    /* single exponent 1..254 before rounding: double 897..1150 (or 0) */
+    tcg_gen_subi_i64(t, e, 897);
+    tcg_gen_setcondi_i64(TCG_COND_LEU, t, t, 1150 - 897);
+    tcg_gen_or_i64(t, t, z);
+    tcg_gen_brcondi_i64(TCG_COND_EQ, t, 0, slow);
+    tcg_gen_andi_i64(rem, a, 0x1fffffff);
+    tcg_gen_shri_i64(r, a, 29);                 /* exponent and 23 bits */
+    tcg_gen_subi_i64(r, r, (uint64_t)(1023 - 127) << 23);
+    /* round up: rem > half, or rem == half and r odd: rem > half - odd */
+    tcg_gen_andi_i64(t, r, 1);
+    tcg_gen_subfi_i64(t, 0x10000000, t);
+    tcg_gen_setcond_i64(TCG_COND_GTU, up, rem, t);
+    tcg_gen_add_i64(r, r, up);
+    /* rounded up to infinity (not for a zero): overflow, slow */
+    tcg_gen_setcondi_i64(TCG_COND_GEU, t, r, 0x7f800000);
+    tcg_gen_andc_i64(t, t, z);
+    tcg_gen_brcondi_i64(TCG_COND_NE, t, 0, slow);
+    tcg_gen_movcond_i64(TCG_COND_NE, r, z, tcg_constant_i64(0),
+                        tcg_constant_i64(0), r);
+    tcg_gen_extrl_i64_i32(out, r);
+    tcg_gen_or_i32(out, out, sg);
+}
+
+/*
+ * Double to 32-bit integer rounding toward zero (VCVT, not VCVTR): fast
+ * when it is in range, and exact or inexact already set. inexact_ok: the
+ * caller's gate showed the guest's inexact flag set.
+ */
+static inline void rofp_f64_to_i32_rz(TCGv_i32 out, TCGv_i64 in, bool sgn,
+                                      TCGv_i32 ixc, TCGLabel *slow)
+{
+    TCGv_i64 a = rofp_t64(), e = rofp_t64();
+    TCGv_i64 m = rofp_t64(), sh = rofp_t64();
+    TCGv_i64 f = rofp_t64(), v = rofp_t64();
+    TCGv_i64 t = rofp_t64(), neg = rofp_t64();
+    TCGv_i32 inex = rofp_t32();
+
+    tcg_gen_andi_i64(a, in, INT64_MAX);
+    tcg_gen_shri_i64(e, a, 52);
+    tcg_gen_shri_i64(neg, in, 63);
+    /* exponent 0 with a mantissa: denormal (IDC with FZ): slow */
+    tcg_gen_subi_i64(t, a, 1);
+    tcg_gen_brcondi_i64(TCG_COND_LTU, t, 0x000fffffffffffffull, slow);
+    /* |x| >= 2^31 (2^32 unsigned), or NaN or infinity: slow */
+    tcg_gen_brcondi_i64(TCG_COND_GEU, e, 1023 + (sgn ? 31 : 32), slow);
+    /* below 1: integer 0, inexact unless x is zero */
+    tcg_gen_andi_i64(m, a, 0x000fffffffffffffull);
+    tcg_gen_ori_i64(m, m, 1ull << 52);
+    tcg_gen_subfi_i64(sh, 1075, e);             /* 52 - (e - 1023) */
+    tcg_gen_movcond_i64(TCG_COND_GTU, sh, sh, tcg_constant_i64(63),
+                        tcg_constant_i64(63), sh);
+    tcg_gen_shr_i64(v, m, sh);
+    tcg_gen_shl_i64(t, v, sh);
+    tcg_gen_setcond_i64(TCG_COND_NE, f, t, m);  /* fraction bits lost */
+    /* below 2^-11 the shift of 63 still leaves m's top bit: drop it */
+    tcg_gen_movcond_i64(TCG_COND_LT, v, e, tcg_constant_i64(1023),
+                        tcg_constant_i64(0), v);
+    tcg_gen_movcond_i64(TCG_COND_LT, f, e, tcg_constant_i64(1023),
+                        tcg_constant_i64(1), f);
+    tcg_gen_movcond_i64(TCG_COND_EQ, f, a, tcg_constant_i64(0),
+                        tcg_constant_i64(0), f);
+    tcg_gen_movcond_i64(TCG_COND_EQ, v, a, tcg_constant_i64(0),
+                        tcg_constant_i64(0), v);
+    if (sgn) {
+        tcg_gen_neg_i64(t, v);
+        tcg_gen_movcond_i64(TCG_COND_NE, v, neg, tcg_constant_i64(0), t, v);
+    } else {
+        /* negative and nonzero: invalid, saturates to 0: slow */
+        tcg_gen_setcondi_i64(TCG_COND_NE, t, v, 0);
+        tcg_gen_and_i64(t, t, neg);
+        tcg_gen_brcondi_i64(TCG_COND_NE, t, 0, slow);
+    }
+    /* inexact and the guest's flag not set yet: slow (it sets it) */
+    tcg_gen_extrl_i64_i32(inex, f);
+    tcg_gen_andc_i32(inex, inex, ixc);
+    tcg_gen_brcondi_i32(TCG_COND_NE, inex, 0, slow);
+    tcg_gen_extrl_i64_i32(out, v);
+}
+
+/* the guest's inexact flag (VFP status), 1 or 0 */
+static inline TCGv_i32 rofp_ixc_vfp(void)
+{
+    TCGv_i32 f = rofp_t32();
+
+    tcg_gen_ld16u_i32(f, tcg_env,
+                      offsetof(CPUARMState, vfp.fp_status.float_exception_flags));
+    tcg_gen_extract_i32(f, f, ctz32(float_flag_inexact), 1);
+    return f;
+}
+
+/*
+ * Neon single precision operations done with integer vector instructions:
+ * compares, max/min (no NaN or denormal lane: then no flags at all) and the
+ * integer/float conversions (host convert instruction, range-checked).
+ */
+enum {
+    ROFN_CEQ, ROFN_CGE, ROFN_CGT,       /* n op m */
+    ROFN_ACGE, ROFN_ACGT,               /* |n| op |m| */
+    ROFN_CEQ0, ROFN_CGE0, ROFN_CGT0, ROFN_CLE0, ROFN_CLT0,  /* n op 0 */
+    ROFN_MAX, ROFN_MIN,
+    ROFN_ABD,                           /* |n - m| */
+    ROFN_SITOF, ROFN_UITOF,             /* int to float (exact ones) */
+    ROFN_FTOSI, ROFN_FTOUI,             /* float to int, toward zero */
+};
+
+/* lanes that are NaNs or denormals: all ones */
+static inline void rofp_bad_nan_denormal(TCGType type, TCGv_vec bad,
+                                         TCGv_vec x, bool first)
+{
+    TCGv_vec u = rofp_abs(type, MO_32, x);
+    TCGv_vec t = rofp_tv(type);
+
+    tcg_gen_cmp_vec(TCG_COND_GTU, MO_32, t, u, rofp_k(type, MO_32, 0x7f800000));
+    if (first) {
+        tcg_gen_mov_vec(bad, t);
+    } else {
+        tcg_gen_or_vec(MO_32, bad, bad, t);
+    }
+    rofp_bad_input(type, MO_32, bad, x, false);
+}
+
+/*
+ * A single's bits made to order as signed integers: -0 below +0 (as max
+ * and min order them), or with zeq +0 and -0 equal (as compares do).
+ */
+static inline TCGv_vec rofp_key(TCGType type, TCGv_vec x, bool zeq)
+{
+    TCGv_vec k = rofp_tv(type);
+
+    tcg_gen_sari_vec(MO_32, k, x, 31);
+    tcg_gen_shri_vec(MO_32, k, k, 1);
+    tcg_gen_xor_vec(MO_32, k, k, x);
+    if (zeq) {
+        tcg_gen_andc_vec(MO_32, k, k, rofp_iszero(type, MO_32, x));
+    }
+    return k;
+}
+
+static const TCGOpcode rofp_vecops_int[] = {
+    INDEX_op_sub_vec, INDEX_op_cmp_vec, INDEX_op_andc_vec, INDEX_op_abs_vec,
+    INDEX_op_sari_vec, INDEX_op_shri_vec, INDEX_op_rofsub_vec,
+    INDEX_op_rofitof_vec, INDEX_op_rofftoi_vec, 0
+};
+
+/*
+ * Vd = op(Vn, Vm) for the ROFN_* operations; one-operand ones use Vm
+ * (rn_ofs unused). The helper fn (gvec_2_ptr when two_op, else
+ * gvec_3_ptr) is the slow path. Returns false when nothing was generated.
+ */
+static inline bool rofp_neon_int(int op, uint32_t rd_ofs, uint32_t rn_ofs,
+                                 uint32_t rm_ofs, uint32_t oprsz,
+                                 uint32_t maxsz, void *fn)
+{
+    TCGType type = oprsz == 16 ? TCG_TYPE_V128 : TCG_TYPE_V64;
+    bool one = op >= ROFN_CEQ0 && op <= ROFN_CLT0;
+    bool cvt = op >= ROFN_SITOF;
+    const TCGOpcode *hold;
+    TCGLabel *slow;
+    TCGv_vec n = NULL, m, r, bad, t;
+
+    if (rofp_off() || oprsz != maxsz || (oprsz != 8 && oprsz != 16) ||
+        !rofp_type_ok(type) ||
+        !tcg_can_emit_vecop_list(rofp_vecops_int, type, MO_32)) {
+        return false;
+    }
+    hold = tcg_swap_vecop_list(rofp_vecops_int);
+    slow = gen_new_label();
+    rofp_memo_reset();
+    m = rofp_tv(type);
+    r = rofp_tv(type);
+    bad = rofp_tv(type);
+    t = rofp_tv(type);
+    /* the one-operand ones read Vm as their operand */
+    rofp_ld_neon(type, m, rm_ofs);
+    if (!one && !cvt) {
+        n = rofp_tv(type);
+        rofp_ld_neon(type, n, rn_ofs);
+    }
+
+    switch (op) {
+    case ROFN_CEQ:
+    case ROFN_CGE:
+    case ROFN_CGT:
+    case ROFN_MAX:
+    case ROFN_MIN:
+        rofp_bad_nan_denormal(type, bad, n, true);
+        rofp_bad_nan_denormal(type, bad, m, false);
+        {
+            bool mm = op == ROFN_MAX || op == ROFN_MIN;
+            TCGv_vec kn = rofp_key(type, n, !mm), km = rofp_key(type, m, !mm);
+            if (mm) {
+                /* the larger (smaller) key's operand: max(+0, -0) = +0 */
+                tcg_gen_cmp_vec(TCG_COND_GT, MO_32, t, kn, km);
+                if (op == ROFN_MAX) {
+                    tcg_gen_bitsel_vec(MO_32, r, t, n, m);
+                } else {
+                    tcg_gen_bitsel_vec(MO_32, r, t, m, n);
+                }
+            } else {
+                tcg_gen_cmp_vec(op == ROFN_CEQ ? TCG_COND_EQ
+                                : op == ROFN_CGE ? TCG_COND_GE : TCG_COND_GT,
+                                MO_32, r, kn, km);
+            }
+        }
+        break;
+    case ROFN_ACGE:
+    case ROFN_ACGT:
+        rofp_bad_nan_denormal(type, bad, n, true);
+        rofp_bad_nan_denormal(type, bad, m, false);
+        tcg_gen_cmp_vec(op == ROFN_ACGE ? TCG_COND_GEU : TCG_COND_GTU, MO_32,
+                        r, rofp_abs(type, MO_32, n), rofp_abs(type, MO_32, m));
+        break;
+    case ROFN_CEQ0:
+    case ROFN_CGE0:
+    case ROFN_CGT0:
+    case ROFN_CLE0:
+    case ROFN_CLT0:
+        {
+            static const TCGCond c[] = {
+                TCG_COND_EQ, TCG_COND_GE, TCG_COND_GT, TCG_COND_LE, TCG_COND_LT
+            };
+            rofp_bad_nan_denormal(type, bad, m, true);
+            tcg_gen_cmp_vec(c[op - ROFN_CEQ0], MO_32, r, rofp_key(type, m, true),
+                            rofp_k(type, MO_32, 0));
+        }
+        break;
+    case ROFN_ABD:
+        rofp_bad_input(type, MO_32, bad, n, true);
+        rofp_bad_input(type, MO_32, bad, m, false);
+        tcg_gen_rof3_vec(INDEX_op_rofsub_vec, MO_32, r, n, m);
+        rofp_bad_result(type, MO_32, bad, r, false, ROFZ_ANY, NULL, NULL);
+        tcg_gen_and_vec(MO_32, r, r, rofp_k(type, MO_32, 0x7fffffff));
+        break;
+    case ROFN_SITOF:
+    case ROFN_UITOF:
+        /* exact (at most 24 bits): no flags; else slow */
+        if (op == ROFN_SITOF) {
+            tcg_gen_abs_vec(MO_32, t, m);
+        } else {
+            tcg_gen_mov_vec(t, m);
+        }
+        tcg_gen_cmp_vec(TCG_COND_GTU, MO_32, bad, t,
+                        rofp_k(type, MO_32, 1 << 24));
+        tcg_gen_rof2_vec(INDEX_op_rofitof_vec, MO_32, r, m);
+        break;
+    case ROFN_FTOSI:
+    case ROFN_FTOUI:
+        /* |x| < 2^31 (unsigned: 0 <= x, sign clear), not denormal */
+        tcg_gen_cmp_vec(TCG_COND_GEU, MO_32, bad,
+                        op == ROFN_FTOSI ? rofp_abs(type, MO_32, m) : m,
+                        rofp_k(type, MO_32, 0x4f000000));
+        rofp_bad_input(type, MO_32, bad, m, false);
+        tcg_gen_rof2_vec(INDEX_op_rofftoi_vec, MO_32, r, m);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    rofp_branch_bad(type, bad, slow);
+    if (op == ROFN_FTOSI || op == ROFN_FTOUI || op == ROFN_ABD) {
+        /* these can be inexact: only with the flag already set */
+        rofp_gate(offsetof(CPUARMState, vfp.standard_fp_status), false, slow);
+    }
+    tcg_gen_st_vec(r, tcg_env, rd_ofs);
+    {
+        RofpNeonSlow a = { rd_ofs, rn_ofs, rm_ofs, oprsz, maxsz, 0, fn,
+                           one || cvt };
+        rofp_finish(slow, rofp_neon_slow, &a, sizeof(a));
+    }
+    tcg_swap_vecop_list(hold);
+    return true;
+}
+
+#endif
diff --git a/target/arm/tcg/riscos-neon.h b/target/arm/tcg/riscos-neon.h
new file mode 100644
index 0000000..1c5d3e8
--- /dev/null
+++ b/target/arm/tcg/riscos-neon.h
@@ -0,0 +1,535 @@
+/*
+ * RISC OS testbed: Neon integer long, narrowing and by-scalar instructions
+ * as host vector instructions in the translated code.
+ *
+ * These were single helper calls each (rol_long, rol_nshift, rol_shll,
+ * rol_2sc16 in neon_helper.c), which perf showed taking 30-55% of the time
+ * in Neon integer code (ROBench blend, yuv2rgb, sad): the call, the
+ * registers going through memory, and the stall when a helper reads 16
+ * bytes that the translated code wrote as two 8-byte halves. Here they are
+ * built from TCG's vector operations and four of ours that change the lane
+ * width (tcg-opc.h: rouxtl, rosxtl, rosqxtn, rosqxtun: x86 PMOVZX/PMOVSX/
+ * PACKSS/PACKUS, AArch64 UXTL/SXTL/SQXTN/SQXTUN). The results are the
+ * helpers' to the bit, and saturation sets QC as QEMU's own saturating
+ * vector operations do (a non-zero lane in vfp.qc). Where the host can't,
+ * the helpers run as before. RISCOS_NO_HOSTNEON=1 turns both off (QEMU's
+ * own code); RISCOS_NO_INLINENEON=1 keeps the helpers.
+ */
+
+#ifndef RISCOS_NEON_H
+#define RISCOS_NEON_H
+
+static bool rol_neon_off, roln_inline_off;
+
+static void __attribute__((constructor)) roln_init(void)
+{
+    rol_neon_off = getenv("RISCOS_NO_HOSTNEON") != NULL;
+    roln_inline_off = rol_neon_off ||
+                      getenv("RISCOS_NO_INLINENEON") != NULL;
+}
+
+/* 3 registers, different lengths: the operations (as neon_helper.c's) */
+enum { ROLN_ADDL, ROLN_SUBL, ROLN_ADDW, ROLN_SUBW, ROLN_ABDL, ROLN_ABAL,
+       ROLN_MULL, ROLN_MLAL, ROLN_MLSL };
+
+static const TCGOpcode roln_ops_long[] = {
+    INDEX_op_rouxtl_vec, INDEX_op_rosxtl_vec, INDEX_op_add_vec,
+    INDEX_op_sub_vec, INDEX_op_mul_vec, INDEX_op_umin_vec,
+    INDEX_op_umax_vec, INDEX_op_smin_vec, INDEX_op_smax_vec, 0
+};
+static const TCGOpcode roln_ops_narrow[] = {
+    INDEX_op_rouxtl_vec, INDEX_op_rosxtl_vec, INDEX_op_rosqxtn_vec,
+    INDEX_op_rosqxtun_vec, INDEX_op_shri_vec, INDEX_op_sari_vec,
+    INDEX_op_add_vec, INDEX_op_umin_vec, INDEX_op_cmp_vec, 0
+};
+static const TCGOpcode roln_ops_mul16[] = {
+    INDEX_op_mul_vec, INDEX_op_add_vec, INDEX_op_sub_vec, 0
+};
+static const TCGOpcode roln_ops_shll[] = {
+    INDEX_op_rouxtl_vec, INDEX_op_rosxtl_vec, INDEX_op_shli_vec, 0
+};
+
+/* Can this host do it? (vece: the lanes the operations work on) */
+static bool roln_ok(const TCGOpcode *ops, unsigned vece)
+{
+    return !roln_inline_off && TCG_TARGET_HAS_v128 &&
+           tcg_can_emit_vecop_list(ops, TCG_TYPE_V128, vece);
+}
+
+/* a D register's 64 bits, in the low half of a 128-bit vector */
+static TCGv_vec roln_ld_d(int reg)
+{
+    TCGv_vec v = rofp_tv(TCG_TYPE_V128);
+    tcg_gen_dup_mem_vec(MO_64, v, tcg_env, neon_full_reg_offset(reg));
+    return v;
+}
+
+/* a Q register (as two 64-bit loads: see rofp_ld_neon) */
+static TCGv_vec roln_ld_q(int reg)
+{
+    TCGv_vec v = rofp_tv(TCG_TYPE_V128);
+    rofp_ld_neon(TCG_TYPE_V128, v, neon_full_reg_offset(reg));
+    return v;
+}
+
+static TCGv_vec roln_xtl(TCGv_vec a, unsigned vece, bool sgn)
+{
+    TCGv_vec r = rofp_tv(TCG_TYPE_V128);
+    tcg_gen_rof2_vec(sgn ? INDEX_op_rosxtl_vec : INDEX_op_rouxtl_vec,
+                     vece, r, a);
+    return r;
+}
+
+static TCGv_vec roln_xtn(TCGv_vec a, unsigned vece, bool to_unsigned)
+{
+    TCGv_vec r = rofp_tv(TCG_TYPE_V128);
+    tcg_gen_rof2_vec(to_unsigned ? INDEX_op_rosqxtun_vec
+                                 : INDEX_op_rosqxtn_vec, vece, r, a);
+    return r;
+}
+
+/* QC |= lanes that are non-zero in sat */
+static void roln_set_qc(TCGv_vec sat)
+{
+    TCGv_vec qc = rofp_tv(TCG_TYPE_V128);
+    uint32_t ofs = offsetof(CPUARMState, vfp.qc);
+
+    tcg_gen_ld_vec(qc, tcg_env, ofs);
+    tcg_gen_or_vec(MO_64, qc, qc, sat);
+    tcg_gen_st_vec(qc, tcg_env, ofs);
+}
+
+/*
+ * 3 registers, different lengths (sizes 8 and 16): Qd = Dn op Dm, or
+ * Qn op Dm for the wide forms. op as in neon_helper.c (ROLN_*). The wide
+ * lanes are modular, so signedness only matters in widening and in the
+ * absolute difference (computed on the narrow lanes, where it fits
+ * unsigned, then zero-extended).
+ */
+static bool roln_long(int op, int size, bool sgn, int vd, int vn, int vm)
+{
+    unsigned w = size + 1;
+    TCGv_vec a, b, r;
+
+    if (!roln_ok(roln_ops_long, size) || !roln_ok(roln_ops_long, w)) {
+        return false;
+    }
+    if (op == ROLN_ABDL || op == ROLN_ABAL) {
+        TCGv_vec n = roln_ld_d(vn), m = roln_ld_d(vm);
+        TCGv_vec hi = rofp_tv(TCG_TYPE_V128);
+        TCGv_vec lo = rofp_tv(TCG_TYPE_V128);
+
+        if (sgn) {
+            tcg_gen_smax_vec(size, hi, n, m);
+            tcg_gen_smin_vec(size, lo, n, m);
+        } else {
+            tcg_gen_umax_vec(size, hi, n, m);
+            tcg_gen_umin_vec(size, lo, n, m);
+        }
+        tcg_gen_sub_vec(size, hi, hi, lo);
+        r = roln_xtl(hi, size, false);
+        if (op == ROLN_ABAL) {
+            tcg_gen_add_vec(w, r, r, roln_ld_q(vd));
+        }
+    } else {
+        if (op == ROLN_ADDW || op == ROLN_SUBW) {
+            a = roln_ld_q(vn);
+        } else {
+            a = roln_xtl(roln_ld_d(vn), size, sgn);
+        }
+        b = roln_xtl(roln_ld_d(vm), size, sgn);
+        r = rofp_tv(TCG_TYPE_V128);
+        switch (op) {
+        case ROLN_ADDL:
+        case ROLN_ADDW:
+            tcg_gen_add_vec(w, r, a, b);
+            break;
+        case ROLN_SUBL:
+        case ROLN_SUBW:
+            tcg_gen_sub_vec(w, r, a, b);
+            break;
+        case ROLN_MULL:
+            tcg_gen_mul_vec(w, r, a, b);
+            break;
+        case ROLN_MLAL:
+            tcg_gen_mul_vec(w, r, a, b);
+            tcg_gen_add_vec(w, r, roln_ld_q(vd), r);
+            break;
+        default: /* ROLN_MLSL */
+            tcg_gen_mul_vec(w, r, a, b);
+            tcg_gen_sub_vec(w, r, roln_ld_q(vd), r);
+            break;
+        }
+    }
+    tcg_gen_st_vec(r, tcg_env, neon_full_reg_offset(vd));
+    rofp_tmps_free();
+    return true;
+}
+
+/*
+ * Narrowing right shifts by an immediate: Dd = narrow(Qm >> sh), op as
+ * the ROL_NS_* numbers (0 VSHRN, 1 VRSHRN, 2 VQSHRUN, 3 VQRSHRUN,
+ * 4 VQSHRN.S, 5 VQRSHRN.S, 6 VQSHRN.U, 7 VQRSHRN.U; odd ones round).
+ * size: the source lanes (MO_16 or MO_32). Rounding is
+ * (x >> sh) + ((x >> (sh - 1)) & 1), which is (x + 2^(sh-1)) >> sh
+ * without the carry out of the lane.
+ */
+static bool roln_nshift(int op, int size, int sh, int vd, int vm)
+{
+    unsigned n = size - 1;          /* the narrow lanes */
+    int kind = op >> 1;             /* 0 plain, 1 S->U, 2 S->S, 3 U->U */
+    bool sgn = kind == 1 || kind == 2;
+    TCGv_vec x, t, r, back;
+
+    if (size < 1 || size > 2 || sh < 1 || sh > (8 << size) ||
+        !roln_ok(roln_ops_narrow, size) || !roln_ok(roln_ops_narrow, n)) {
+        return false;
+    }
+    x = roln_ld_q(vm);
+    t = rofp_tv(TCG_TYPE_V128);
+    if (op & 1) {
+        TCGv_vec bit = rofp_tv(TCG_TYPE_V128);
+        if (sh > 1) {
+            if (sgn) {
+                tcg_gen_sari_vec(size, bit, x, sh - 1);
+            } else {
+                tcg_gen_shri_vec(size, bit, x, sh - 1);
+            }
+        } else {
+            tcg_gen_mov_vec(bit, x);
+        }
+        tcg_gen_and_vec(size, bit, bit, tcg_constant_vec(TCG_TYPE_V128,
+                                                         size, 1));
+        if (sh == (8 << size)) {
+            /* a shift by the lane width: x >> sh is 0 (or -1 signed) */
+            if (sgn) {
+                tcg_gen_sari_vec(size, t, x, sh - 1);
+            } else {
+                tcg_gen_dupi_vec(size, t, 0);
+            }
+        } else if (sgn) {
+            tcg_gen_sari_vec(size, t, x, sh);
+        } else {
+            tcg_gen_shri_vec(size, t, x, sh);
+        }
+        tcg_gen_add_vec(size, t, t, bit);
+    } else if (sh == (8 << size)) {
+        if (sgn) {
+            tcg_gen_sari_vec(size, t, x, sh - 1);
+        } else {
+            tcg_gen_dupi_vec(size, t, 0);
+        }
+    } else if (sgn) {
+        tcg_gen_sari_vec(size, t, x, sh);
+    } else {
+        tcg_gen_shri_vec(size, t, x, sh);
+    }
+
+    switch (kind) {
+    case 0:
+        /* plain: the low half of each lane */
+        tcg_gen_and_vec(size, t, t, tcg_constant_vec(TCG_TYPE_V128, size,
+                                                     (1u << (8 << n)) - 1));
+        r = roln_xtn(t, n, true);
+        break;
+    case 1:
+        /* signed to unsigned, saturating */
+        r = roln_xtn(t, n, true);
+        back = roln_xtl(r, n, false);
+        tcg_gen_cmp_vec(TCG_COND_NE, size, back, back, t);
+        roln_set_qc(back);
+        break;
+    case 2:
+        /* signed to signed, saturating */
+        r = roln_xtn(t, n, false);
+        back = roln_xtl(r, n, true);
+        tcg_gen_cmp_vec(TCG_COND_NE, size, back, back, t);
+        roln_set_qc(back);
+        break;
+    default:
+        /* unsigned to unsigned, saturating: clamp, then the low half */
+        {
+            TCGv_vec c = rofp_tv(TCG_TYPE_V128);
+            tcg_gen_umin_vec(size, c, t,
+                             tcg_constant_vec(TCG_TYPE_V128, size,
+                                              (1u << (8 << n)) - 1));
+            r = roln_xtn(c, n, true);
+            tcg_gen_cmp_vec(TCG_COND_NE, size, c, c, t);
+            roln_set_qc(c);
+        }
+        break;
+    }
+    tcg_gen_stl_vec(r, tcg_env, neon_full_reg_offset(vd), TCG_TYPE_V64);
+    rofp_tmps_free();
+    return true;
+}
+
+/* VMUL, VMLA, VMLS .I16 by scalar (op 0, 1, 2), D or Q */
+static bool roln_2sc16(int op, bool q, int vd, int vn, TCGv_i32 scalar)
+{
+    TCGType type = q ? TCG_TYPE_V128 : TCG_TYPE_V64;
+    TCGv_vec n, s, d;
+
+    if (roln_inline_off || !(q ? TCG_TARGET_HAS_v128 : TCG_TARGET_HAS_v64) ||
+        !tcg_can_emit_vecop_list(roln_ops_mul16, type, MO_16)) {
+        return false;
+    }
+    n = rofp_tv(type);
+    if (q) {
+        rofp_ld_neon(type, n, neon_full_reg_offset(vn));
+    } else {
+        tcg_gen_ld_vec(n, tcg_env, neon_full_reg_offset(vn));
+    }
+    s = rofp_tv(type);
+    tcg_gen_dup_i32_vec(MO_16, s, scalar);
+    tcg_gen_mul_vec(MO_16, n, n, s);
+    if (op) {
+        d = rofp_tv(type);
+        if (q) {
+            rofp_ld_neon(type, d, neon_full_reg_offset(vd));
+        } else {
+            tcg_gen_ld_vec(d, tcg_env, neon_full_reg_offset(vd));
+        }
+        if (op == 1) {
+            tcg_gen_add_vec(MO_16, n, d, n);
+        } else {
+            tcg_gen_sub_vec(MO_16, n, d, n);
+        }
+    }
+    tcg_gen_st_vec(n, tcg_env, neon_full_reg_offset(vd));
+    rofp_tmps_free();
+    return true;
+}
+
+/* VSHLL / VMOVL, sizes 8 and 16: Qd = widen(Dm) << sh */
+static bool roln_shll(int size, bool sgn, int sh, int vd, int vm)
+{
+    unsigned w = size + 1;
+    TCGv_vec r;
+
+    if (!roln_ok(roln_ops_shll, size) || !roln_ok(roln_ops_shll, w)) {
+        return false;
+    }
+    r = roln_xtl(roln_ld_d(vm), size, sgn);
+    if (sh) {
+        tcg_gen_shli_vec(w, r, r, sh);
+    }
+    tcg_gen_st_vec(r, tcg_env, neon_full_reg_offset(vd));
+    rofp_tmps_free();
+    return true;
+}
+
+/* --- zips, unzips and the interleaving loads and stores ------------------ */
+
+static const TCGOpcode roln_ops_zip[] = {
+    INDEX_op_rozip1_vec, INDEX_op_rozip2_vec, 0
+};
+static const TCGOpcode roln_ops_pack[] = { INDEX_op_ropack_vec, 0 };
+/* (and, or: every vector host has them; TCG's debug build insists they
+   aren't listed) */
+static const TCGOpcode roln_ops_uzpw[] = { INDEX_op_shri_vec, 0 };
+
+static TCGv_vec roln_op3(TCGOpcode opc, unsigned vece, TCGv_vec a, TCGv_vec b)
+{
+    TCGv_vec r = rofp_tv(TCG_TYPE_V128);
+    tcg_gen_rof3_vec(opc, vece, r, a, b);
+    return r;
+}
+
+/* the high 64 bits of a, in the low 64 */
+static TCGv_vec roln_hi64(TCGv_vec a)
+{
+    return roln_op3(INDEX_op_rozip2_vec, MO_64, a, a);
+}
+
+/*
+ * Unzip: the even (odd = false) or odd lanes of size vece from a then b
+ * (lanes of twice the width, each truncated to its low or high half)
+ */
+static TCGv_vec roln_uzp(unsigned vece, TCGv_vec a, TCGv_vec b, bool odd)
+{
+    unsigned w = vece + 1;
+    TCGv_vec x = rofp_tv(TCG_TYPE_V128);
+    TCGv_vec y = rofp_tv(TCG_TYPE_V128);
+
+    if (odd) {
+        tcg_gen_shri_vec(w, x, a, 8 << vece);
+        tcg_gen_shri_vec(w, y, b, 8 << vece);
+    } else {
+        TCGv_vec m = tcg_constant_vec(TCG_TYPE_V128, w,
+                                      (1ull << (8 << vece)) - 1);
+        tcg_gen_and_vec(w, x, a, m);
+        tcg_gen_and_vec(w, y, b, m);
+    }
+    return roln_op3(INDEX_op_ropack_vec, vece, x, y);
+}
+
+/* unzipping lanes of vece: a pack to vece, masks and shifts on twice it */
+static bool roln_can_uzp(unsigned vece)
+{
+    return roln_ok(roln_ops_pack, vece) && roln_ok(roln_ops_uzpw, vece + 1);
+}
+
+/* VZIP: D registers sizes 8 and 16, Q registers 8, 16 and 32 */
+static bool roln_zip(bool q, int size, int vd, int vm)
+{
+    TCGv_vec d, m;
+
+    if (!roln_ok(roln_ops_zip, size) || !roln_ok(roln_ops_zip, MO_64)) {
+        return false;
+    }
+    if (q) {
+        d = roln_ld_q(vd);
+        m = roln_ld_q(vm);
+        TCGv_vec lo = roln_op3(INDEX_op_rozip1_vec, size, d, m);
+        TCGv_vec hi = roln_op3(INDEX_op_rozip2_vec, size, d, m);
+        tcg_gen_st_vec(lo, tcg_env, neon_full_reg_offset(vd));
+        tcg_gen_st_vec(hi, tcg_env, neon_full_reg_offset(vm));
+    } else {
+        d = roln_ld_d(vd);
+        m = roln_ld_d(vm);
+        TCGv_vec z = roln_op3(INDEX_op_rozip1_vec, size, d, m);
+        tcg_gen_stl_vec(z, tcg_env, neon_full_reg_offset(vd), TCG_TYPE_V64);
+        tcg_gen_stl_vec(roln_hi64(z), tcg_env, neon_full_reg_offset(vm),
+                        TCG_TYPE_V64);
+    }
+    rofp_tmps_free();
+    return true;
+}
+
+/* VUZP: D registers sizes 8 and 16, Q registers 8 and 16 */
+static bool roln_unzip(bool q, int size, int vd, int vm)
+{
+    TCGv_vec d, m, ev, od;
+
+    if (size > MO_16 || !roln_can_uzp(size) ||
+        !roln_ok(roln_ops_zip, MO_64) ||
+        !tcg_can_emit_vecop_list(rofp_vecops_cat, TCG_TYPE_V128, MO_64)) {
+        return false;
+    }
+    if (q) {
+        d = roln_ld_q(vd);
+        m = roln_ld_q(vm);
+        ev = roln_uzp(size, d, m, false);
+        od = roln_uzp(size, d, m, true);
+        tcg_gen_st_vec(ev, tcg_env, neon_full_reg_offset(vd));
+        tcg_gen_st_vec(od, tcg_env, neon_full_reg_offset(vm));
+    } else {
+        /* the 16 bytes d:m, unzipped; each half's result is in its low 64 */
+        TCGv_vec x = rofp_tv(TCG_TYPE_V128);
+        tcg_gen_rof3_vec(INDEX_op_rofcat_vec, MO_64, x, roln_ld_d(vd),
+                         roln_ld_d(vm));
+        ev = roln_uzp(size, x, x, false);
+        od = roln_uzp(size, x, x, true);
+        tcg_gen_stl_vec(ev, tcg_env, neon_full_reg_offset(vd), TCG_TYPE_V64);
+        tcg_gen_stl_vec(od, tcg_env, neon_full_reg_offset(vm), TCG_TYPE_V64);
+    }
+    rofp_tmps_free();
+    return true;
+}
+
+/*
+ * VLD2/VST2 and VLD4/VST4 (multiple structures), elements of 8 or 16 bits,
+ * little-endian: the interleaving done with zips and unzips, and memory
+ * accessed 64 bits at a time (QEMU: one access per element, 32 for a
+ * VST4.8). The first access carries the alignment the instruction asks
+ * for, as QEMU's first element access does; the rest are at 8-byte steps
+ * from it. Vectors go to and from the 64-bit accesses through 16 bytes of
+ * vfp.scratch (64-bit loads of what a 128-bit store wrote, and the other
+ * way as rofp_ld_neon does it, so the store buffer forwards them).
+ */
+static TCGv_vec roln_from_mem(DisasContext *s, TCGv_i32 addr, int mmu_idx,
+                              MemOp *mop)
+{
+    TCGv_i64 t = rofp_t64();
+    TCGv_vec v = rofp_tv(TCG_TYPE_V128);
+
+    for (int i = 0; i < 2; i++) {
+        gen_aa32_ld_internal_i64(s, t, addr, mmu_idx, *mop);
+        *mop &= ~MO_AMASK;
+        tcg_gen_addi_i32(addr, addr, 8);
+        tcg_gen_st_i64(t, tcg_env, ROFP_SCRATCH + 8 * i);
+    }
+    rofp_ld_neon(TCG_TYPE_V128, v, ROFP_SCRATCH);
+    return v;
+}
+
+static void roln_to_mem(DisasContext *s, TCGv_vec v, TCGv_i32 addr,
+                        int mmu_idx, MemOp *mop)
+{
+    TCGv_i64 t = rofp_t64();
+
+    tcg_gen_st_vec(v, tcg_env, ROFP_SCRATCH);
+    for (int i = 0; i < 2; i++) {
+        tcg_gen_ld_i64(t, tcg_env, ROFP_SCRATCH + 8 * i);
+        gen_aa32_st_internal_i64(s, t, addr, mmu_idx, *mop);
+        *mop &= ~MO_AMASK;
+        tcg_gen_addi_i32(addr, addr, 8);
+    }
+}
+
+static bool roln_ldst(DisasContext *s, bool load, int size, int nregs,
+                      int interleave, int spacing, int vd, TCGv_i32 addr,
+                      int mmu_idx, MemOp align)
+{
+    MemOp mop = MO_LEUQ | align;
+
+
+    if (roln_inline_off || size > MO_16 ||
+        (interleave != 2 && interleave != 4) ||
+        !roln_ok(roln_ops_zip, size) || !roln_ok(roln_ops_zip, size + 1) ||
+        (load && !roln_can_uzp(size)) ||
+        !tcg_can_emit_vecop_list(rofp_vecops_cat, TCG_TYPE_V128, MO_64)) {
+        return false;
+    }
+    for (int reg = 0; reg < nregs; reg++) {
+        int t[4];
+        for (int xs = 0; xs < interleave; xs++) {
+            t[xs] = vd + reg + spacing * xs;
+        }
+        if (load) {
+            TCGv_vec x0 = roln_from_mem(s, addr, mmu_idx, &mop);
+            if (interleave == 2) {
+                TCGv_vec a = roln_uzp(size, x0, x0, false);
+                TCGv_vec b = roln_uzp(size, x0, x0, true);
+                tcg_gen_stl_vec(a, tcg_env, neon_full_reg_offset(t[0]),
+                                TCG_TYPE_V64);
+                tcg_gen_stl_vec(b, tcg_env, neon_full_reg_offset(t[1]),
+                                TCG_TYPE_V64);
+            } else {
+                TCGv_vec x1 = roln_from_mem(s, addr, mmu_idx, &mop);
+                /* ev: lanes 0, 2 of each structure; od: 1, 3 */
+                TCGv_vec ev = roln_uzp(size, x0, x1, false);
+                TCGv_vec od = roln_uzp(size, x0, x1, true);
+                TCGv_vec r[4] = {
+                    roln_uzp(size, ev, ev, false), roln_uzp(size, od, od, false),
+                    roln_uzp(size, ev, ev, true), roln_uzp(size, od, od, true),
+                };
+                for (int xs = 0; xs < 4; xs++) {
+                    tcg_gen_stl_vec(r[xs], tcg_env,
+                                    neon_full_reg_offset(t[xs]),
+                                    TCG_TYPE_V64);
+                }
+            }
+        } else {
+            if (interleave == 2) {
+                TCGv_vec z = roln_op3(INDEX_op_rozip1_vec, size,
+                                      roln_ld_d(t[0]), roln_ld_d(t[1]));
+                roln_to_mem(s, z, addr, mmu_idx, &mop);
+            } else {
+                TCGv_vec z1 = roln_op3(INDEX_op_rozip1_vec, size,
+                                       roln_ld_d(t[0]), roln_ld_d(t[1]));
+                TCGv_vec z2 = roln_op3(INDEX_op_rozip1_vec, size,
+                                       roln_ld_d(t[2]), roln_ld_d(t[3]));
+                roln_to_mem(s, roln_op3(INDEX_op_rozip1_vec, size + 1, z1, z2),
+                            addr, mmu_idx, &mop);
+                roln_to_mem(s, roln_op3(INDEX_op_rozip2_vec, size + 1, z1, z2),
+                            addr, mmu_idx, &mop);
+            }
+        }
+    }
+    rofp_tmps_free();
+    return true;
+}
+
+#endif
