+/* 3 registers, different lengths: Qd = Dn op Dm (or Qn op Dm, "wide") */
+enum { ROLN_ADDL, ROLN_SUBL, ROLN_ADDW, ROLN_SUBW, ROLN_ABDL, ROLN_ABAL,
+       ROLN_MULL, ROLN_MLAL, ROLN_MLSL };
+#define ROL_LONG(TN, TW, N, EXPR)                                          \
+    do {                                                                   \
+        TN nn[N], mm[N];                                                   \
+        TW ww[N], dd[N], out[N];                                           \
+        memcpy(nn, vn, sizeof(nn));                                        \
+        memcpy(ww, vn, sizeof(ww));                                        \
+        memcpy(mm, vm, sizeof(mm));                                        \
+        memcpy(dd, vd, sizeof(dd));                                        \
+        for (int i = 0; i < N; i++) {                                      \
+            TW a = nn[i], w = ww[i], b = mm[i], d = dd[i];                 \
+            (void)a, (void)w, (void)d;                                     \
+            out[i] = (EXPR);                                               \
+        }                                                                  \
+        memcpy(vd, out, sizeof(out));                                      \
+    } while (0)
