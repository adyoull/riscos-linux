+/*
+ * RISC OS testbed: emit one host-vectorised helper for a whole NEON
+ * instruction instead of QEMU's chain of 32/64-bit helpers, or (where the
+ * host can) the instruction itself as host vector instructions
+ * (riscos-neon.h, included at the top, where rol_neon_off is:
+ * RISCOS_NO_HOSTNEON=1 turns both off, to compare against).
+ */
+static TCGv_ptr rol_reg_ptr(int reg)
+{
+    TCGv_ptr p = tcg_temp_new_ptr();
+    tcg_gen_addi_ptr(p, tcg_env, neon_full_reg_offset(reg));
+    return p;
+}
